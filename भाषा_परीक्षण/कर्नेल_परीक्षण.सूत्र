// भाषा_परीक्षण/कर्नेल_परीक्षण.सूत्र — सूत्र ऑपरेटिंग सिस्टम (SutraOS) परीक्षण सूट
// ==============================================================================
// सूत्र कर्नेल उपप्रणालियों का पूर्ण सत्यापन:
//   १. कंसोल एवं स्क्रीन बफर तर्क (VGA Cell Math, Scrolling, Attributes)
//   २. भौतिक स्मृति पृष्ठ-चौखट आवंटक (Bitmap Frame Allocator & Leak Checks)
//   ३. कार्य नियंत्रण खंड एवं क्रमक (TCB State Machine & Round-Robin Scheduler)
//   ४. अंतर्-प्रक्रिया संवाद (IPC Mailbox Ring Buffers & FIFO Integrity)
//   ५. तंत्र-आह्वान प्रेषक (Syscall Dispatch Table & State Queries)
//   ६. पूर्ण स्वायत्त कर्नेल जीवनचक्र (End-to-End Kernel Lifecycle Simulation)
// ==============================================================================

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        प्रक्षेपः "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

// ------------------------------------------------------------------------------
// परीक्षण १: कंसोल सेल गणित एवं स्क्रीन बफर
// ------------------------------------------------------------------------------
कार्य परीक्षण_कंसोल_तर्क() {
    लिखतु("--- परीक्षण १: कंसोल सेल गणित एवं रंग लक्षण ---");

    // पंक्ति और स्तंभ से VGA ऑफसेट की गणना (80x25 text mode)
    संख्या पंक्ति = 5;
    संख्या स्तंभ = 20;
    संख्या सेल_ऑफसेट = (पंक्ति * 80 + स्तंभ) * 2;
    सत्यापित_करो(सेल_ऑफसेट == 840, "सेल ऑफसेट गणना शुद्ध (पंक्ति ५, स्तंभ २० -> ८४०)");

    // स्क्रीन स्क्रोलिंग पंक्ति गणित
    संख्या कुल_पंक्तियाँ = 25;
    संख्या कुल_स्तंभ = 80;
    संख्या कुल_बाइट्स = कुल_पंक्तियाँ * कुल_स्तंभ * 2;
    सत्यापित_करो(कुल_बाइट्स == 4000, "VGA बफर कुल आकार ठीक 4000 बाइट्स");

    // रंग लक्षण संयोजन: अग्रभूमि (१० = हरा) + पृष्ठभूमि (० = काला)
    संख्या रंग = 10;
    संख्या अग्र = रंग % 16;
    संख्या पृष्ठ = रंग / 16;
    सत्यापित_करो(अग्र == 10 && पृष्ठ == 0, "VGA रंग लक्षण (हरा काले पर = १०)");

    लिखतु("  [सफल] कंसोल सेल गणित एवं रंग लक्षण शुद्ध।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण २: भौतिक पृष्ठ आवंटक (Bitmap Page Frame Allocator)
// ------------------------------------------------------------------------------
कार्य परीक्षण_स्मृति_आवंटक() {
    लिखतु("--- परीक्षण २: भौतिक पृष्ठ आवंटक एवं बिटमैप प्रबंधन ---");

    // ६४ पृष्ठों का बिटमैप अनुकरण (प्रत्येक बिट = ०: मुक्त, १: आवंटित)
    सूची बिटमैप = [0]; // ६४ बिट
    संख्या कुल_पृष्ठ = 64;
    संख्या आवंटित_पृष्ठ = 0;
    संख्या गतिशील_आधार = 2097152; // 2MB

    // पृष्ठ ० आवंटन
    संख्या शब्द० = बिटमैप[0];
    संख्या मास्क० = 1; // 1 << 0
    सत्यापित_करो((शब्द० % 2) == 0, "प्रारंभ में पृष्ठ ० मुक्त");
    बिटमैप[0] = शब्द० + मास्क०;
    आवंटित_पृष्ठ = आवंटित_पृष्ठ + 1;
    संख्या पता० = गतिशील_आधार + (0 * 4096);
    सत्यापित_करो(पता० == 2097152, "पृष्ठ ० का भौतिक पता 2MB (2097152)");

    // पृष्ठ १ आवंटन
    संख्या शब्द१ = बिटमैप[0];
    संख्या मास्क१ = 2; // 1 << 1
    सत्यापित_करो((शब्द१ / 2) % 2 == 0, "पृष्ठ १ मुक्त");
    बिटमैप[0] = शब्द१ + मास्क१;
    आवंटित_पृष्ठ = आवंटित_पृष्ठ + 1;
    संख्या पता१ = गतिशील_आधार + (1 * 4096);
    सत्यापित_करो(पता१ == 2101248, "पृष्ठ १ का भौतिक पता 2097152 + 4096 = 2101248");

    सत्यापित_करो(आवंटित_पृष्ठ == 2, "कुल आवंटित पृष्ठ = २");
    सत्यापित_करो(कुल_पृष्ठ - आवंटित_पृष्ठ == 62, "अवशेष मुक्त पृष्ठ = ६२");

    // पृष्ठ ० विमुक्ति (Deallocation)
    बिटमैप[0] = बिटमैप[0] - मास्क०;
    आवंटित_पृष्ठ = आवंटित_पृष्ठ - 1;
    सत्यापित_करो((बिटमैप[0] % 2) == 0, "पृष्ठ ० मुक्त हो गया");
    सत्यापित_करो(आवंटित_पृष्ठ == 1, "आवंटित पृष्ठ पुनः १");

    लिखतु("  [सफल] भौतिक पृष्ठ आवंटक बिटमैप संक्रियाएं एवं शोधन शुद्ध।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ३: कार्य नियंत्रण खंड (TCB) एवं बहुकार्यन क्रमक
// ------------------------------------------------------------------------------
कार्य परीक्षण_कार्य_प्रबंधक() {
    लिखतु("--- परीक्षण ३: कार्य नियंत्रण खंड (TCB) एवं अवस्था परिवर्तन ---");

    // कार्य नियंत्रण खंड सूची (८ कार्य)
    सूची कार्य_सूची = [];
    संख्या इ = 0;
    यावत् (इ < 8) {
        कार्य_सूची = जोड़ें(कार्य_सूची, {
            "आईडी": 0,
            "स्थिति": 0, // 0=शून्य, 1=सज्जित, 2=प्रतीक्षा, 3=पूर्ण
            "प्राथमिकता": 0,
            "चक्र": 0,
            "डेटा": 0,
            "पृष्ठ": 0
        });
        इ = इ + 1;
    }

    // कार्य १ सृजन (Watchdog Task)
    कार्य_सूची[0]["आईडी"] = 1;
    कार्य_सूची[0]["स्थिति"] = 1; // सज्जित
    कार्य_सूची[0]["प्राथमिकता"] = 10;
    कार्य_सूची[0]["डेटा"] = 100;
    कार्य_सूची[0]["पृष्ठ"] = 2097152;

    // कार्य २ सृजन (Sensor Task)
    कार्य_सूची[1]["आईडी"] = 2;
    कार्य_सूची[1]["स्थिति"] = 1;
    कार्य_सूची[1]["प्राथमिकता"] = 5;
    कार्य_सूची[1]["डेटा"] = 200;
    कार्य_सूची[1]["पृष्ठ"] = 2101248;

    सत्यापित_करो(कार्य_सूची[0]["स्थिति"] == 1, "कार्य १ सज्जित (Ready)");
    सत्यापित_करो(कार्य_सूची[1]["स्थिति"] == 1, "कार्य २ सज्जित (Ready)");
    सत्यापित_करो(कार्य_सूची[0]["प्राथमिकता"] == 10, "कार्य १ प्राथमिकता १० (उच्च)");

    // सहकारी क्रमक चक्र (Round-Robin Execution)
    संख्या क्रमक_सूचक = 0;
    संख्या निष्पादित_कार्य = 0;
    यावत् (क्रमक_सूचक < 2) {
        यदि (कार्य_सूची[क्रमक_सूचक]["स्थिति"] == 1) {
            कार्य_सूची[क्रमक_सूचक]["चक्र"] = कार्य_सूची[क्रमक_सूचक]["चक्र"] + 1;
            कार्य_सूची[क्रमक_सूचक]["डेटा"] = कार्य_सूची[क्रमक_सूचक]["डेटा"] + 50;
            निष्पादित_कार्य = निष्पादित_कार्य + 1;
        }
        क्रमक_सूचक = क्रमक_सूचक + 1;
    }

    सत्यापित_करो(निष्पादित_कार्य == 2, "क्रमक ने दोनों सज्जित कार्यों को निष्पादित किया");
    सत्यापित_करो(कार्य_सूची[0]["चक्र"] == 1, "कार्य १ ने १ चक्र पूरा किया");
    सत्यापित_करो(कार्य_सूची[0]["डेटा"] == 150, "कार्य १ डेटा मूल्य १०० + ५० = १५०");

    // कार्य समापन (Termination)
    कार्य_सूची[0]["स्थिति"] = 3; // पूर्ण
    सत्यापित_करो(कार्य_सूची[0]["स्थिति"] == 3, "कार्य १ पूर्ण/समाप्त अवस्था में पहुंचा");

    लिखतु("  [सफल] कार्य नियंत्रण खंड (TCB) अवस्था प्रबंधन एवं क्रमक शुद्ध।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ४: अंतर्-प्रक्रिया संवाद (IPC Mailbox Ring Buffers)
// ------------------------------------------------------------------------------
कार्य परीक्षण_अंतर्_प्रक्रिया_संवाद() {
    लिखतु("--- परीक्षण ४: अंतर्-प्रक्रिया संवाद (IPC Ring-Buffer Mailbox) ---");

    // डाकपेटी (४ कक्ष, FIFO)
    शब्दकोश डाकपेटी = {
        "सिर": 0,
        "पूंछ": 0,
        "गणना": 0,
        "संदेश": [{}, {}, {}, {}]
    };

    // संदेश १ प्रेषण (प्रेषक: २, प्रकार: २००, डेटा१: १०, डेटा२: २०)
    सत्यापित_करो(डाकपेटी["गणना"] < 4, "डाकपेटी में स्थान उपलब्ध");
    डाकपेटी["संदेश"][डाकपेटी["पूंछ"]] = {
        "प्रेषक": 2,
        "प्रकार": 200,
        "डेटा१": 10,
        "डेटा२": 20
    };
    डाकपेटी["पूंछ"] = (डाकपेटी["पूंछ"] + 1) % 4;
    डाकपेटी["गणना"] = डाकपेटी["गणना"] + 1;

    // संदेश २ प्रेषण (प्रेषक: २, प्रकार: २००, डेटा१: ३०, डेटा२: ४०)
    डाकपेटी["संदेश"][डाकपेटी["पूंछ"]] = {
        "प्रेषक": 2,
        "प्रकार": 200,
        "डेटा१": 30,
        "डेटा२": 40
    };
    डाकपेटी["पूंछ"] = (डाकपेटी["पूंछ"] + 1) % 4;
    डाकपेटी["गणना"] = डाकपेटी["गणना"] + 1;

    सत्यापित_करो(डाकपेटी["गणना"] == 2, "डाकपेटी में २ संदेश संचित");

    // संदेश १ ग्रहण (FIFO)
    संख्या सिर० = डाकपेटी["सिर"];
    शब्दकोश प्राप्त१ = डाकपेटी["संदेश"][सिर०];
    सत्यापित_करो(प्राप्त१["प्रेषक"] == 2 && प्राप्त१["डेटा१"] == 10, "प्रथम संदेश प्राप्त (प्रेषक २, डेटा १०)");
    डाकपेटी["सिर"] = (डाकपेटी["सिर"] + 1) % 4;
    डाकपेटी["गणना"] = डाकपेटी["गणना"] - 1;

    // संदेश २ ग्रहण
    संख्या सिर१ = डाकपेटी["सिर"];
    शब्दकोश प्राप्त२ = डाकपेटी["संदेश"][सिर१];
    सत्यापित_करो(प्राप्त२["प्रेषक"] == 2 && प्राप्त२["डेटा१"] == 30, "द्वितीय संदेश प्राप्त (प्रेषक २, डेटा ३०)");
    डाकपेटी["सिर"] = (डाकपेटी["सिर"] + 1) % 4;
    डाकपेटी["गणना"] = डाकपेटी["गणना"] - 1;

    सत्यापित_करो(डाकपेटी["गणना"] == 0, "डाकपेटी पूर्णतः रिक्त (गणना = ०)");

    लिखतु("  [सफल] अंतर्-प्रक्रिया संवाद FIFO वलय-बफर संक्रियाएं शत-प्रतिशत शुद्ध।\n");
}

// तंत्र-आह्वान अनुकरण
कार्य तंत्र_आह्वान_अनुकरण(शब्दकोश राज्य, संख्या कूट, संख्या तर्क१) {
    राज्य["तंत्र_आह्वान_गणना"] = राज्य["तंत्र_आह्वान_गणना"] + 1;
    यदि (कूट == 4) { // पृष्ठ आवंटन
        राज्य["आवंटित_पृष्ठ"] = राज्य["आवंटित_पृष्ठ"] + 1;
        परत् 2097152 + (राज्य["आवंटित_पृष्ठ"] * 4096);
    } अन्यथा यदि (कूट == 5) { // पृष्ठ मुक्त
        राज्य["आवंटित_पृष्ठ"] = राज्य["आवंटित_पृष्ठ"] - 1;
        परत् 1;
    } अन्यथा यदि (कूट == 10) { // स्थिति जाँच
        यदि (तर्क१ == 1) { परत् राज्य["टिक"]; }
        यदि (तर्क१ == 2) { परत् राज्य["आवंटित_पृष्ठ"]; }
        यदि (तर्क१ == 3) { परत् राज्य["सक्रिय_कार्य"]; }
    }
    परत् 0;
}

// ------------------------------------------------------------------------------
// परीक्षण ५: तंत्र-आह्वान प्रेषक एवं सांख्यिकी
// ------------------------------------------------------------------------------
कार्य परीक्षण_तंत्र_आह्वान() {
    लिखतु("--- परीक्षण ५: तंत्र-आह्वान (Syscall Dispatcher) एवं सांख्यिकी ---");

    शब्दकोश कर्नेल_राज्य = {
        "जादुई_संख्या": 1414417233,
        "टिक": 100,
        "कुल_पृष्ठ": 512,
        "आवंटित_पृष्ठ": 3,
        "सक्रिय_कार्य": 3,
        "तंत्र_आह्वान_गणना": 45
    };

    // आह्वान ४: पृष्ठ आवंटन
    संख्या नया_पृष्ठ = तंत्र_आह्वान_अनुकरण(कर्नेल_राज्य, 4, 0);
    सत्यापित_करो(नया_पृष्ठ > 2097152, "तंत्र-आह्वान ४: नया पृष्ठ आवंटित");
    सत्यापित_करो(कर्नेल_राज्य["आवंटित_पृष्ठ"] == 4, "आवंटित पृष्ठ गणना ४ हुई");

    // आह्वान ५: पृष्ठ मुक्त
    संख्या मुक्त_फल = तंत्र_आह्वान_अनुकरण(कर्नेल_राज्य, 5, नया_पृष्ठ);
    सत्यापित_करो(मुक्त_फल == 1, "तंत्र-आह्वान ५: पृष्ठ विमुक्ति सफल");
    सत्यापित_करो(कर्नेल_राज्य["आवंटित_पृष्ठ"] == 3, "आवंटित पृष्ठ पुनः ३");

    // आह्वान १०: स्थिति जाँच
    संख्या टिक_जाँच = तंत्र_आह्वान_अनुकरण(कर्नेल_राज्य, 10, 1);
    सत्यापित_करो(टिक_जाँच == 100, "तंत्र-आह्वान १०: टिक गणना १०० प्राप्त");

    सत्यापित_करो(कर्नेल_राज्य["तंत्र_आह्वान_गणना"] == 48, "तंत्र-आह्वान प्रेषक ने कुल ४८ आह्वान दर्ज किए");

    लिखतु("  [सफल] तंत्र-आह्वान प्रेषक एवं सांख्यिकी शुद्ध।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ६: पूर्ण स्वायत्त कर्नेल जीवनचक्र
// ------------------------------------------------------------------------------
कार्य परीक्षण_पूर्ण_जीवनचक्र() {
    लिखतु("--- परीक्षण ६: पूर्ण स्वायत्त कर्नेल जीवनचक्र (End-to-End Lifecycle) ---");

    // १. बूट क्रम
    संख्या कुल_पृष्ठ = 512;
    संख्या मुक्त_पृष्ठ = 512;
    संख्या सक्रिय_कार्य = 0;
    संख्या कुल_चक्र = 10;
    संख्या प्रेषित_संदेश = 0;
    संख्या प्राप्त_संदेश = 0;

    // २. कार्य सृजन (Tasks 1, 2, 3)
    मुक्त_पृष्ठ = मुक्त_पृष्ठ - 3; // प्रत्येक कार्य को १ निजी पृष्ठ
    सक्रिय_कार्य = 3;
    सत्यापित_करो(मुक्त_पृष्ठ == 509, "३ कार्य सृजित, ३ पृष्ठ आवंटित");

    // ३. १० चक्र बहुकार्यन
    संख्या चक्र_इ = 0;
    यावत् (चक्र_इ < कुल_चक्र) {
        // कार्य २ संवेदक संदेश भेजता है
        प्रेषित_संदेश = प्रेषित_संदेश + 1;
        // कार्य ३ संदेश ग्रहण करता है
        प्राप्त_संदेश = प्राप्त_संदेश + 1;
        चक्र_इ = चक्र_इ + 1;
    }

    सत्यापित_करो(प्रेषित_संदेश == 10, "संवेदक कार्य ने १० संदेश प्रेषित किए");
    सत्यापित_करो(प्राप्त_संदेश == 10, "विश्लेषक कार्य ने १० संदेश उपभोगित किए");

    // ४. कार्य समापन एवं सम्पूर्ण शोधन
    मुक्त_पृष्ठ = मुक्त_पृष्ठ + 3;
    सक्रिय_कार्य = 0;
    सत्यापित_करो(सक्रिय_कार्य == 0, "सभी कार्य सफलतापूर्वक समाप्त");
    सत्यापित_करो(मुक्त_पृष्ठ == 512, "शून्य स्मृति रिसाव (Zero Memory Leak) — सभी ५१२ पृष्ठ मुक्त!");

    लिखतु("  [सफल] पूर्ण कर्नेल जीवनचक्र (बूट -> क्रमक -> संवाद -> शोधन) १००% सफल।\n");
}

