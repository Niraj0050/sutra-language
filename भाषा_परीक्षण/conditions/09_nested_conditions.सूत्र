// Regression test: Deeply nested conditions
कार्य मुख्य() {
    मान अ = 1;
    मान ब = 2;
    मान स = 3;
    मान परिणाम = 0;

    अगर (अ == 1) {
        अगर (ब == 2) {
            अगर (स == 3) {
                परिणाम = 10;
            } अन्यथा {
                परिणाम = 20;
            }
        } अन्यथा {
            परिणाम = 30;
        }
    } अन्यथा {
        परिणाम = 40;
    }

    लिखतु(परिणाम); // Expected: 10

    अ = 1;
    ब = 5;
    अगर (अ == 1) {
        अगर (ब == 2) {
            परिणाम = 100;
        } अन्यथा {
            अगर (स == 3) {
                परिणाम = 200;
            } अन्यथा {
                परिणाम = 300;
            }
        }
    } अन्यथा {
        परिणाम = 400;
    }

    लिखतु(परिणाम); // Expected: 200
}
