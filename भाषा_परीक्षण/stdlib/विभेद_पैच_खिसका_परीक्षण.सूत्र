// patch लगाने का दूसरा भाग: खिसकी/बदली हुई फ़ाइल पर लगाना, उलटा लगाना, अस्पष्ट (दोहराई पंक्तियों) मिलान,
// और विफलताएँ। **अपेक्षित परिणाम, प्रति-hunk ऑफ़सेट और सफलता/विफलता असली `git apply --unidiff-zero -v [-R]`
// की चलाई से generate** — पास-पास खोज का क्रम (पहले आगे, फिर पीछे, बढ़ती दूरी से) और बिना-नई-पंक्ति की
// सख्ती git से हूबहू मिलाई गई।
// टिप्पणियाँ: (१) शून्य-गिनती वाले "केवल हटाना" hunk में git का ऑफ़सेट-अनुमान `newpos-1` से होने से एक अलग
// आता है — उन मामलों में ऑफ़सेट की तुलना छोड़ी गई, परिणाम-पाठ की तुलना नहीं। (२) `git apply -R` अपना
// ऑफ़सेट उलटे चिह्न से छापता है; हमारा ऑफ़सेट हर दिशा में "फ़ाइल में वास्तविक शुरू − घोषित शुरू" है, इसलिए
// उलटे मामलों में git का चिह्न पलटकर अपेक्षित बनाया गया।
आयात "पुस्तकालय/विभेद.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// ===== सहायक =====

// patch का परिणाम (पाठ या शून्यम्) जाँचो
कार्य जाँच_पैच(पाठ नाम, पाठ पुराना, पाठ पैच, मान अपेक्षित) {
    मान वास्तविक = विभेद_पैच_लगाओ(पुराना, पैच);
    जाँच(नाम, वास्तविक, अपेक्षित);
    परत् ०;
}

// उलटा patch का परिणाम (पाठ या शून्यम्) जाँचो
कार्य जाँच_उलटा_पैच(पाठ नाम, पाठ नया, पाठ पैच, मान अपेक्षित) {
    मान वास्तविक = विभेद_पैच_उलटा_लगाओ(नया, पैच);
    जाँच(नाम, वास्तविक, अपेक्षित);
    परत् ०;
}

// हर hunk का खिसकाव (वास्तविक − घोषित) "0,3,0" रूप में; patch न लगे तो "विफल", बिगड़ा हो तो "भ्रष्ट"
कार्य खिसकाव_सार(पाठ पुराना, पाठ पैच, संख्या उलटा) {
    मान फाइलें = विभेद_पैच_पार्स(पैच);
    यदि (प्रकार(फाइलें) == "शून्यम्") { परत् "भ्रष्ट"; }
    यदि (लंबाई(फाइलें) != १) { परत् "भ्रष्ट"; }
    शब्दकोश र = विभेद_पैच_फाइल_लगाओ(पुराना, फाइलें[०], उलटा);
    संख्या सफल = र["सफल"];
    यदि (सफल == ०) { परत् "विफल"; }
    सूची स्थान = र["स्थान"];
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(स्थान)) {
        सूची त = स्थान[इ];
        यदि (इ > ०) { फल = फल + ","; }
        फल = फल + त[२];
        इ = इ + १;
    }
    परत् फल;
}

