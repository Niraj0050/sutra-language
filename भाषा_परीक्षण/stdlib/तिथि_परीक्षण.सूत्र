// भाषा_परीक्षण/stdlib/तिथि_परीक्षण.सूत्र
आयात "पुस्तकालय/तिथि.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("युग-बिंदु + ज्ञात तिथियाँ");
    जाँच("युग = 0", समय_बनाओ(१९७०, १, १, ०, ०, ०), ०);
    जाँच("2000-01-01 = 946684800", तिथि_बनाओ(२०००, १, १), ९४६६८४८००);
    जाँच("2000-01-01 शनिवार (=6)", सप्ताह_दिन(९४६६८४८००), ६);
    जाँच("1970-01-01 गुरुवार (=4)", सप्ताह_दिन(०), ४);

    परीक्षण_समूह("अपघटन round-trip");
    संख्या प = समय_बनाओ(२०२६, ९, १०, १४, ३०, ४५);
    शब्दकोश स = तिथि_अंश(प);
    जाँच("वर्ष",   स["वर्ष"],   २०२६);
    जाँच("माह",    स["माह"],    ९);
    जाँच("दिन",    स["दिन"],    १०);
    जाँच("घंटा",   स["घंटा"],   १४);
    जाँच("मिनट",   स["मिनट"],   ३०);
    जाँच("सेकंड",  स["सेकंड"],  ४५);
    जाँच("वर्ष_का", वर्ष_का(प), २०२६);
    जाँच("दिन_का",  दिन_का(प),  १०);
    जाँच("घंटा_का", घंटा_का(प), १४);

    संख्या पुराना = समय_बनाओ(१९५३, ३, १, ६, ०, ०);
    शब्दकोश पुस = तिथि_अंश(पुराना);
    जाँच("युग-पूर्व वर्ष",  पुस["वर्ष"], १९५३);
    जाँच("युग-पूर्व माह",   पुस["माह"],  ३);
    जाँच("युग-पूर्व दिन",   पुस["दिन"],  १);
    जाँच("युग-पूर्व घंटा",  पुस["घंटा"], ६);

    परीक्षण_समूह("लीप वर्ष / माह-दिन");
    जाँच_सत्य("2000 लीप",  लीप_वर्ष(२०००));
    जाँच_असत्य("1900 लीप", लीप_वर्ष(१९००));
    जाँच_सत्य("2024 लीप",  लीप_वर्ष(२०२४));
    जाँच_असत्य("2026 लीप", लीप_वर्ष(२०२६));
    जाँच("फ़र 2024 = 29", माह_के_दिन(२०२४, २), २९);
    जाँच("फ़र 2023 = 28", माह_के_दिन(२०२३, २), २८);
    जाँच("अप्रैल = 30",   माह_के_दिन(२०२६, ४), ३०);
    जाँच("दिसंबर = 31",   माह_के_दिन(२०२६, १२), ३१);
    जाँच("29 फ़र 2024 वैध", वर्ष_का(समय_बनाओ(२०२४, २, २९, ०, ०, ०)), २०२४);

    परीक्षण_समूह("वर्ष-दिन");
    जाँच("1 जन = दिन 1",   वर्ष_दिन(तिथि_बनाओ(२०२६, १, १)), १);
    जाँच("31 दिस = दिन 365 (2026)", वर्ष_दिन(तिथि_बनाओ(२०२६, १२, ३१)), ३६५);
    जाँच("31 दिस = दिन 366 (2024)", वर्ष_दिन(तिथि_बनाओ(२०२४, १२, ३१)), ३६६);
    जाँच("1 मार्च 2024 = दिन 61", वर्ष_दिन(तिथि_बनाओ(२०२४, ३, १)), ६१);

    परीक्षण_समूह("अंकगणित — सरल");
    जाँच("जोड़_दिन 1", दिन_का(जोड़_दिन(प, १)), ११);
    जाँच("जोड़_दिन माह-पार", माह_का(जोड़_दिन(तिथि_बनाओ(२०२६, १, ३१), १)), २);
    जाँच("जोड़_दिन माह-पार दिन", दिन_का(जोड़_दिन(तिथि_बनाओ(२०२६, १, ३१), १)), १);
    जाँच("जोड़_घंटा 24 = अगला दिन", दिन_का(जोड़_घंटा(प, २४)), ११);
    जाँच("जोड़_सप्ताह 1", दिन_का(जोड़_सप्ताह(तिथि_बनाओ(२०२६, ९, ३), १)), १०);

    परीक्षण_समूह("अंकगणित — कैलेंडर-सजग माह/वर्ष");
    // ३१ जन + १ माह → २८ फ़र (clamp)
    संख्या जनवरी_अंत = तिथि_बनाओ(२०२६, १, ३१);
    जाँच("जन31 +1माह → माह 2", माह_का(जोड़_माह(जनवरी_अंत, १)), २);
    जाँच("जन31 +1माह → दिन 28", दिन_का(जोड़_माह(जनवरी_अंत, १)), २८);
    // लीप वर्ष में २९
    जाँच("जन31 2024 +1माह → दिन 29", दिन_का(जोड़_माह(तिथि_बनाओ(२०२४, १, ३१), १)), २९);
    // माह wrap
    जाँच("नव +3माह → फ़र अगले वर्ष", वर्ष_का(जोड़_माह(तिथि_बनाओ(२०२५, ११, १५), ३)), २०२६);
    जाँच("नव +3माह → माह 2", माह_का(जोड़_माह(तिथि_बनाओ(२०२५, ११, १५), ३)), २);
    // ऋणात्मक
    जाँच("मार्च -3माह → दिसंबर पिछले वर्ष", माह_का(जोड़_माह(तिथि_बनाओ(२०२६, ३, १५), ० - ३)), १२);
    जाँच("मार्च -3माह → वर्ष 2025", वर्ष_का(जोड़_माह(तिथि_बनाओ(२०२६, ३, १५), ० - ३)), २०२५);
    जाँच("जोड़_वर्ष 1", वर्ष_का(जोड़_वर्ष(प, १)), २०२७);
    // २९ फ़र २०२४ + १ वर्ष → २८ फ़र २०२५ (clamp)
    जाँच("29फ़र2024 +1वर्ष → दिन 28", दिन_का(जोड़_वर्ष(तिथि_बनाओ(२०२४, २, २९), १)), २८);

    परीक्षण_समूह("अंतर / तुलना");
    जाँच("अंतर_दिन", अंतर_दिन(तिथि_बनाओ(२०२६, ९, १०), तिथि_बनाओ(२०२६, ९, २०)), १०);
    जाँच("अंतर_दिन माह-पार", अंतर_दिन(तिथि_बनाओ(२०२६, १, १५), तिथि_बनाओ(२०२६, २, १५)), ३१);
    जाँच("अंतर_घंटा", अंतर_घंटा(प, जोड़_घंटा(प, ५)), ५);
    जाँच("अंतर_सेकंड", अंतर_सेकंड(प, प + ९०), ९०);
    जाँच_सत्य("तिथि_पूर्व", तिथि_पूर्व(तिथि_बनाओ(२०२६, १, १), तिथि_बनाओ(२०२६, ६, १)));
    जाँच_सत्य("तिथि_बाद",  तिथि_बाद(तिथि_बनाओ(२०२६, ६, १), तिथि_बनाओ(२०२६, १, १)));
    जाँच_सत्य("एक_दिन", एक_दिन(समय_बनाओ(२०२६, ९, १०, १, ०, ०), समय_बनाओ(२०२६, ९, १०, २३, ०, ०)));
    जाँच_असत्य("एक_दिन नहीं", एक_दिन(समय_बनाओ(२०२६, ९, १०, २३, ०, ०), समय_बनाओ(२०२६, ९, ११, १, ०, ०)));
    जाँच("दिन_आरंभ", सेकंड_का(दिन_आरंभ(प)) + मिनट_का(दिन_आरंभ(प)) + घंटा_का(दिन_आरंभ(प)), ०);

    परीक्षण_समूह("नाम");
    जाँच("सितंबर", माह_नाम(९), "सितंबर");
    जाँच("Sep", माह_संक्षेप(९), "Sep");
    जाँच("गुरुवार", सप्ताह_दिन_नाम(प), "गुरुवार");   // २०२६-०९-१० गुरुवार
    जाँच("Thu", सप्ताह_दिन_संक्षेप(प), "Thu");

    परीक्षण_समूह("प्रारूपण");
    जाँच("YYYY-MM-DD", तिथि_प्रारूप(प, "YYYY-MM-DD"), "2026-09-10");
    जाँच("DD/MM/YYYY", तिथि_प्रारूप(प, "DD/MM/YYYY"), "10/09/2026");
    जाँच("HH:mm:ss", तिथि_प्रारूप(प, "HH:mm:ss"), "14:30:45");
    जाँच("D M YY", तिथि_प्रारूप(तिथि_बनाओ(२०२६, १, ५), "D/M/YY"), "5/1/26");
    जाँच("MMMM D, YYYY", तिथि_प्रारूप(प, "MMMM D, YYYY"), "सितंबर 10, 2026");
    जाँच("ddd, DD MMM YYYY", तिथि_प्रारूप(प, "ddd, DD MMM YYYY"), "Thu, 10 Sep 2026");
    जाँच("साहित्य अक्षर", तिथि_प्रारूप(प, "वर्ष YYYY"), "वर्ष 2026");
    जाँच("आईएसओ", आईएसओ(प), "2026-09-10T14:30:45Z");
    जाँच("आईएसओ_तिथि", आईएसओ_तिथि(प), "2026-09-10");

    परीक्षण_समूह("पार्सिंग + round-trip");
    जाँच("पार्स तारीख", तिथि_पार्स("2026-09-10"), तिथि_बनाओ(२०२६, ९, १०));
    जाँच("पार्स T-समय", तिथि_पार्स("2026-09-10T14:30:45"), प);
    जाँच("पार्स space-समय", तिथि_पार्स("2026-09-10 14:30"), समय_बनाओ(२०२६, ९, १०, १४, ३०, ०));
    जाँच("पार्स Z", तिथि_पार्स("2026-09-10T14:30:45Z"), प);
    जाँच("पार्स गलत आकार", तिथि_पार्स("10/09/2026"), ० - १);
    जाँच("पार्स गलत माह", तिथि_पार्स("2026-13-01"), ० - १);
    जाँच("पार्स गलत दिन", तिथि_पार्स("2026-02-30"), ० - १);
    // full round-trip: पल → आईएसओ → पार्स → पल
    जाँच("round-trip आईएसओ", तिथि_पार्स(आईएसओ(प)), प);

    परत् परीक्षण_सारांश();
}
