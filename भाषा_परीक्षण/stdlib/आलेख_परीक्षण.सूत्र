// भाषा_परीक्षण/stdlib/आलेख_परीक्षण.सूत्र
आयात "पुस्तकालय/आलेख.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य स्थिति_खोजो(सूची स, पाठ नाम) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] == नाम) { परत् इ; }
        इ = इ + १;
    }
    परत् -१;
}

कार्य मुख्य() {
    परीक्षण_समूह("शीर्ष/किनारा प्रबंधन — मूल गुण");
    शब्दकोश ग1 = {};
    आलेख_किनारा_जोड़ो(ग1, "अ", "ब", १);
    जाँच("दोनों शीर्ष स्वतः बन जाते", लंबाई(आलेख_शीर्ष_सूची(ग1)), २);
    जाँच("स्रोत का पड़ोसी सही", लंबाई(आलेख_पड़ोसी(ग1, "अ")), १);
    जाँच("लक्ष्य का पड़ोसी रिक्त (दिशा-सहित)", लंबाई(आलेख_पड़ोसी(ग1, "ब")), ०);
    जाँच("अनुपस्थित शीर्ष का पड़ोसी रिक्त सूची", आलेख_पड़ोसी(ग1, "अज्ञात"), []);
    जाँच("शीर्ष_जोड़ो निष्क्रिय (पहले से मौजूद पर दोबारा)", लंबाई(आलेख_शीर्ष_सूची(ग1)) == २, सत्य);
    आलेख_शीर्ष_जोड़ो(ग1, "अ");
    जाँच("दोबारा शीर्ष_जोड़ो से नया शीर्ष नहीं बनता", लंबाई(आलेख_शीर्ष_सूची(ग1)), २);

    परीक्षण_समूह("अदिश (undirected) किनारा");
    शब्दकोश ग2 = {};
    आलेख_अदिश_किनारा_जोड़ो(ग2, "अ", "ब", १);
    जाँच("अ→ब मिलता", लंबाई(आलेख_पड़ोसी(ग2, "अ")), १);
    जाँच("ब→अ भी मिलता (दोनों दिशा)", लंबाई(आलेख_पड़ोसी(ग2, "ब")), १);
    जाँच("ब→अ का लक्ष्य सही", आलेख_पड़ोसी(ग2, "ब")[०]["लक्ष्य"], "अ");

    परीक्षण_समूह("बीएफएस — रेखीय शृंखला (अ→ब→स→द)");
    शब्दकोश ग3 = {};
    आलेख_किनारा_जोड़ो(ग3, "अ", "ब", १);
    आलेख_किनारा_जोड़ो(ग3, "ब", "स", १);
    आलेख_किनारा_जोड़ो(ग3, "स", "द", १);
    सूची बी3 = आलेख_बीएफएस(ग3, "अ");
    जाँच("पूरी शृंखला दौरी गई", लंबाई(बी3), ४);
    जाँच("पहला शीर्ष आरंभ ही है", बी3[०], "अ");
    जाँच("आखिरी शीर्ष द", बी3[३], "द");

    परीक्षण_समूह("बीएफएस/डीएफएस — शाखा वाला आलेख + असंबद्ध (disconnected) भाग");
    शब्दकोश ग4 = {};
    आलेख_किनारा_जोड़ो(ग4, "अ", "ब", १);
    आलेख_किनारा_जोड़ो(ग4, "अ", "स", १);
    आलेख_शीर्ष_जोड़ो(ग4, "पृथक");
    सूची बी4 = आलेख_बीएफएस(ग4, "अ");
    जाँच("असंबद्ध शीर्ष तक नहीं पहुँचता", लंबाई(बी4), ३);
    सूची डी4 = आलेख_डीएफएस(ग4, "अ");
    जाँच("डीएफएस भी असंबद्ध शीर्ष तक नहीं पहुँचता", लंबाई(डी4), ३);
    जाँच("डीएफएस भी आरंभ से शुरू होता", डी4[०], "अ");

    परीक्षण_समूह("आलेख_पथ_है — पहुँच-योग्यता");
    जाँच("अ से द तक पथ है (ग3 में)", आलेख_पथ_है(ग3, "अ", "द"), सत्य);
    जाँच("द से अ तक पथ नहीं (दिशा-सहित, उल्टा नहीं)", आलेख_पथ_है(ग3, "द", "अ"), असत्य);
    जाँच("अ से पृथक शीर्ष तक पथ नहीं", आलेख_पथ_है(ग4, "अ", "पृथक"), असत्य);
    जाँच("खुद तक हमेशा पथ है", आलेख_पथ_है(ग3, "अ", "अ"), सत्य);

    परीक्षण_समूह("डिज्क्स्ट्रा — सीधा किनारा बनाम छोटा वाया-पथ");
    // अ→स सीधा भार-५ किनारा, पर अ→ब(१)→स(२) = कुल ३ — छोटा वाया-मार्ग जीतना चाहिए
    शब्दकोश ग5 = {};
    आलेख_किनारा_जोड़ो(ग5, "अ", "ब", १);
    आलेख_किनारा_जोड़ो(ग5, "ब", "स", २);
    आलेख_किनारा_जोड़ो(ग5, "अ", "स", ५);
    शब्दकोश दू5 = आलेख_डिज्क्स्ट्रा(ग5, "अ");
    जाँच("अ से अ की दूरी 0", दू5["अ"], ०);
    जाँच("अ से ब की दूरी 1", दू5["ब"], १);
    जाँच("अ से स की दूरी 3 (सीधे 5 नहीं — छोटा वाया-मार्ग चुना)", दू5["स"], ३);
    सूची पथ5 = आलेख_लघुत्तम_पथ(ग5, "अ", "स");
    जाँच("लघुत्तम पथ वाया ब से गुज़रता", लंबाई(पथ5), ३);
    जाँच("पथ का दूसरा शीर्ष ब", पथ5[१], "ब");

    परीक्षण_समूह("डिज्क्स्ट्रा — अपहुँच्य शीर्ष");
    शब्दकोश ग6 = {};
    आलेख_किनारा_जोड़ो(ग6, "अ", "ब", १);
    आलेख_शीर्ष_जोड़ो(ग6, "पृथक");
    शब्दकोश दू6 = आलेख_डिज्क्स्ट्रा(ग6, "अ");
    जाँच("अपहुँच्य शीर्ष की दूरी -1", दू6["पृथक"], -१);
    जाँच("अपहुँच्य शीर्ष तक लघुत्तम_पथ रिक्त सूची", आलेख_लघुत्तम_पथ(ग6, "अ", "पृथक"), []);

    परीक्षण_समूह("डिज्क्स्ट्रा — एकल-शीर्ष आलेख");
    शब्दकोश ग7 = {};
    आलेख_शीर्ष_जोड़ो(ग7, "अकेला");
    शब्दकोश दू7 = आलेख_डिज्क्स्ट्रा(ग7, "अकेला");
    जाँच("खुद से खुद तक दूरी 0", दू7["अकेला"], ०);

    परीक्षण_समूह("डिज्क्स्ट्रा — त्रुटि-मामला");
    संख्या डिज्क्स्ट्रा_त्रुटि_गिनती = ०;
    प्रयत्न {
        आलेख_डिज्क्स्ट्रा(ग5, "अज्ञात_शीर्ष");
    } पकड़ो (त्रु1) {
        डिज्क्स्ट्रा_त्रुटि_गिनती = डिज्क्स्ट्रा_त्रुटि_गिनती + १;
    }
    जाँच("आलेख में न होने वाले आरंभ-शीर्ष पर त्रुटि", डिज्क्स्ट्रा_त्रुटि_गिनती, १);

    परीक्षण_समूह("सांस्थिति-क्रम — मान्य DAG");
    शब्दकोश ग8 = {};
    आलेख_किनारा_जोड़ो(ग8, "पहनो_मोज़े", "पहनो_जूते", १);
    आलेख_किनारा_जोड़ो(ग8, "पहनो_अंडरवियर", "पहनो_पैंट", १);
    आलेख_किनारा_जोड़ो(ग8, "पहनो_पैंट", "पहनो_जूते", १);
    सूची तो8 = आलेख_सांस्थिति_क्रम(ग8);
    जाँच("सभी शीर्ष शामिल", लंबाई(तो8), ४);
    // "पहनो_जूते" हमेशा अपने दोनों पूर्ववर्तियों के बाद आना चाहिए
    जाँच("मोज़े जूते से पहले", स्थिति_खोजो(तो8, "पहनो_मोज़े") < स्थिति_खोजो(तो8, "पहनो_जूते"), सत्य);
    जाँच("पैंट जूते से पहले", स्थिति_खोजो(तो8, "पहनो_पैंट") < स्थिति_खोजो(तो8, "पहनो_जूते"), सत्य);
    जाँच("अंडरवियर पैंट से पहले", स्थिति_खोजो(तो8, "पहनो_अंडरवियर") < स्थिति_खोजो(तो8, "पहनो_पैंट"), सत्य);

    परीक्षण_समूह("सांस्थिति-क्रम / चक्र-जाँच — चक्र वाला आलेख");
    शब्दकोश ग9 = {};
    आलेख_किनारा_जोड़ो(ग9, "अ", "ब", १);
    आलेख_किनारा_जोड़ो(ग9, "ब", "स", १);
    आलेख_किनारा_जोड़ो(ग9, "स", "अ", १);
    जाँच("चक्र सही पहचाना गया", आलेख_चक्र_है(ग9), सत्य);
    जाँच("DAG में चक्र नहीं", आलेख_चक्र_है(ग8), असत्य);
    संख्या सांस्थिति_त्रुटि_गिनती = ०;
    प्रयत्न {
        आलेख_सांस्थिति_क्रम(ग9);
    } पकड़ो (त्रु2) {
        सांस्थिति_त्रुटि_गिनती = सांस्थिति_त्रुटि_गिनती + १;
    }
    जाँच("चक्र वाले आलेख पर सांस्थिति_क्रम त्रुटि देता", सांस्थिति_त्रुटि_गिनती, १);

    परीक्षण_समूह("खाली आलेख — किनारे मामले");
    शब्दकोश ग10 = {};
    जाँच("खाली आलेख की शीर्ष-सूची रिक्त", आलेख_शीर्ष_सूची(ग10), []);
    जाँच("खाली आलेख का सांस्थिति-क्रम रिक्त सूची", आलेख_सांस्थिति_क्रम(ग10), []);
    जाँच("खाली आलेख में चक्र नहीं", आलेख_चक्र_है(ग10), असत्य);

    परत् परीक्षण_सारांश();
}
