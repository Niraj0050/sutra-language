// भाषा_परीक्षण/stdlib/महासंख्या_परीक्षण.सूत्र
आयात "पुस्तकालय/महासंख्या.सूत्र";
आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("निर्माण/रूपांतरण — महासंख्या_बनाओ + महासंख्या_से_संख्या राउंड-ट्रिप");
    जाँच("शून्य", महासंख्या_से_संख्या(महासंख्या_बनाओ(०)), ०);
    जाँच("छोटा धनात्मक", महासंख्या_से_संख्या(महासंख्या_बनाओ(१२३)), १२३);
    जाँच("छोटा ऋणात्मक", महासंख्या_से_संख्या(महासंख्या_बनाओ(-१२३)), -१२३);
    जाँच("अंक-समूह सीमा पर (10^9 - 1)", महासंख्या_से_संख्या(महासंख्या_बनाओ(९९९९९९९९९)), ९९९९९९९९९);
    जाँच("अंक-समूह सीमा पार (10^9)", महासंख्या_से_संख्या(महासंख्या_बनाओ(१०००००००००)), १०००००००००);
    // ⚠ स्रोत-साहित्य में २^३१ से बड़ा सीधा नहीं लिखा जा सकता (लेखक "बड़ा_पूर्णांक"
    // टैग करता, जो संख्या-पैरामीटर से सीधे मेल नहीं खाता) — इसलिए २-अंक-समूह
    // जाँच यहाँ २^३१ के नीचे रहती है; असली बड़ी-संख्या राउंड-ट्रिप अगले
    // समूह में महासंख्या_पाठ_से से होती है (वह लिखित-सीमा से बाहर है)
    जाँच("बहु-अंक-समूह धनात्मक", महासंख्या_से_संख्या(महासंख्या_बनाओ(२१००००००००)), २१००००००००);
    जाँच("बहु-अंक-समूह ऋणात्मक", महासंख्या_से_संख्या(महासंख्या_बनाओ(-२१००००००००)), -२१००००००००);

    परीक्षण_समूह("पाठ रूपांतरण — महासंख्या_पाठ_से + महासंख्या_से_पाठ राउंड-ट्रिप");
    जाँच("शून्य", महासंख्या_से_पाठ(महासंख्या_पाठ_से("०")), "०");
    जाँच("छोटा", महासंख्या_से_पाठ(महासंख्या_पाठ_से("१२३")), "१२३");
    जाँच("अगुआ शून्य वाला इनपुट सामान्य होता", महासंख्या_से_पाठ(महासंख्या_पाठ_से("००१२३")), "१२३");
    जाँच("ऋणात्मक", महासंख्या_से_पाठ(महासंख्या_पाठ_से("-१२३")), "-१२३");
    जाँच("देशी-सीमा से बड़ा (30 अंक)",
        महासंख्या_से_पाठ(महासंख्या_पाठ_से("१२३४५६७८९०१२३४५६७८९०१२३४५६७८९०")),
        "१२३४५६७८९०१२३४५६७८९०१२३४५६७८९०");
    जाँच("ऋणात्मक + देशी-सीमा से बड़ा",
        महासंख्या_से_पाठ(महासंख्या_पाठ_से("-९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९")),
        "-९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९");
    जाँच("गुणा-परिणाम पाठ (१२३४५ × ६७८९०)",
        महासंख्या_से_पाठ(महासंख्या_गुणा(महासंख्या_बनाओ(१२३४५), महासंख्या_बनाओ(६७८९०))),
        "८३८१०२०५०");

    परीक्षण_समूह("पाठ रूपांतरण — त्रुटि-मामले");
    संख्या पाठ_त्रुटि_गिनती = ०;
    प्रयत्न {
        महासंख्या_पाठ_से("");
    } पकड़ो (त्रु1) {
        पाठ_त्रुटि_गिनती = पाठ_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_पाठ_से("12a3");
    } पकड़ो (त्रु2) {
        पाठ_त्रुटि_गिनती = पाठ_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_पाठ_से("-");
    } पकड़ो (त्रु3) {
        पाठ_त्रुटि_गिनती = पाठ_त्रुटि_गिनती + १;
    }
    जाँच("रिक्त / Arabic-अंक / अकेला '-', तीनों त्रुटि देते", पाठ_त्रुटि_गिनती, ३);

    परीक्षण_समूह("तुलना — महासंख्या_तुलना / महासंख्या_बराबर");
    जाँच("बराबर धनात्मक", महासंख्या_तुलना(महासंख्या_बनाओ(५), महासंख्या_बनाओ(५)), ०);
    जाँच("छोटा < बड़ा (दोनों धनात्मक)", महासंख्या_तुलना(महासंख्या_बनाओ(३), महासंख्या_बनाओ(५)), -१);
    जाँच("बड़ा > छोटा (दोनों धनात्मक)", महासंख्या_तुलना(महासंख्या_बनाओ(५), महासंख्या_बनाओ(३)), १);
    जाँच("ऋणात्मक < धनात्मक", महासंख्या_तुलना(महासंख्या_बनाओ(-१), महासंख्या_बनाओ(१)), -१);
    जाँच("बड़ा-परिमाण ऋणात्मक < छोटा-परिमाण ऋणात्मक", महासंख्या_तुलना(महासंख्या_बनाओ(-१००), महासंख्या_बनाओ(-१)), -१);
    जाँच("शून्य == शून्य", महासंख्या_तुलना(महासंख्या_शून्य(), महासंख्या_बनाओ(०)), ०);
    जाँच("शून्य < धनात्मक", महासंख्या_तुलना(महासंख्या_शून्य(), महासंख्या_बनाओ(१)), -१);
    जाँच("शून्य > ऋणात्मक", महासंख्या_तुलना(महासंख्या_शून्य(), महासंख्या_बनाओ(-१)), १);
    जाँच("महासंख्या_बराबर सही", महासंख्या_बराबर(महासंख्या_बनाओ(४२), महासंख्या_बनाओ(४२)), सत्य);
    जाँच("महासंख्या_बराबर ग़लत जोड़ी पर असत्य", महासंख्या_बराबर(महासंख्या_बनाओ(४२), महासंख्या_बनाओ(४३)), असत्य);
    जाँच("महासंख्या_शून्य_है सही", महासंख्या_शून्य_है(महासंख्या_बनाओ(०)), सत्य);
    जाँच("महासंख्या_ऋणात्मक_है सही", महासंख्या_ऋणात्मक_है(महासंख्या_बनाओ(-५)), सत्य);
    जाँच("महासंख्या_सम_है", महासंख्या_सम_है(महासंख्या_बनाओ(८)), सत्य);
    जाँच("महासंख्या_विषम_है", महासंख्या_विषम_है(महासंख्या_बनाओ(७)), सत्य);

    परीक्षण_समूह("जोड़/घटाओ — देशी संख्या के विरुद्ध क्रॉस-चेक (चिह्न-संयोजन)");
    संख्या इ = -५०;
    यावत् (इ <= ५०) {
        संख्या ज = -३०;
        यावत् (ज <= ३०) {
            संख्या देशी_जोड़ = इ + ज;
            संख्या देशी_घटाओ = इ - ज;
            जाँच_सत्य("जोड़ मेल: " + इ + "+" + ज,
                महासंख्या_से_संख्या(महासंख्या_जोड़(महासंख्या_बनाओ(इ), महासंख्या_बनाओ(ज))) == देशी_जोड़);
            जाँच_सत्य("घटाव मेल: " + इ + "-" + ज,
                महासंख्या_से_संख्या(महासंख्या_घटाओ(महासंख्या_बनाओ(इ), महासंख्या_बनाओ(ज))) == देशी_घटाओ);
            ज = ज + १०;
        }
        इ = इ + १५;
    }

    परीक्षण_समूह("गुणा — देशी संख्या के विरुद्ध क्रॉस-चेक");
    जाँच("धनात्मक × धनात्मक", महासंख्या_से_संख्या(महासंख्या_गुणा(महासंख्या_बनाओ(१२३), महासंख्या_बनाओ(४५६))), १२३ * ४५६);
    जाँच("ऋणात्मक × धनात्मक", महासंख्या_से_संख्या(महासंख्या_गुणा(महासंख्या_बनाओ(-१२३), महासंख्या_बनाओ(४५६))), -१२३ * ४५६);
    जाँच("ऋणात्मक × ऋणात्मक", महासंख्या_से_संख्या(महासंख्या_गुणा(महासंख्या_बनाओ(-१२३), महासंख्या_बनाओ(-४५६))), १२३ * ४५६);
    जाँच("किसी से भी × शून्य", महासंख्या_से_संख्या(महासंख्या_गुणा(महासंख्या_बनाओ(१२३), महासंख्या_बनाओ(०))), ०);
    जाँच("बहु-अंक-समूह गुणा", महासंख्या_से_पाठ(महासंख्या_गुणा(महासंख्या_बनाओ(१२३४५), महासंख्या_बनाओ(६७८९०))), "८३८१०२०५०");

    परीक्षण_समूह("भाग/शेष — चिह्न-नियम देशी /% से बिल्कुल मेल खाता (सत्यापित)");
    // देशी सत्यापित: -७/३=-२ rem -१ ; ७/-३=-२ rem १ ; -७/-३=२ rem -१ ; ७/३=२ rem १
    शब्दकोश आ1 = महासंख्या_भाग_शेष(महासंख्या_बनाओ(-७), महासंख्या_बनाओ(३));
    जाँच("-7/3 भागफल", महासंख्या_से_संख्या(आ1["भागफल"]), -२);
    जाँच("-7/3 शेष", महासंख्या_से_संख्या(आ1["शेष"]), -१);
    शब्दकोश आ2 = महासंख्या_भाग_शेष(महासंख्या_बनाओ(७), महासंख्या_बनाओ(-३));
    जाँच("7/-3 भागफल", महासंख्या_से_संख्या(आ2["भागफल"]), -२);
    जाँच("7/-3 शेष", महासंख्या_से_संख्या(आ2["शेष"]), १);
    शब्दकोश आ3 = महासंख्या_भाग_शेष(महासंख्या_बनाओ(-७), महासंख्या_बनाओ(-३));
    जाँच("-7/-3 भागफल", महासंख्या_से_संख्या(आ3["भागफल"]), २);
    जाँच("-7/-3 शेष", महासंख्या_से_संख्या(आ3["शेष"]), -१);
    शब्दकोश आ4 = महासंख्या_भाग_शेष(महासंख्या_बनाओ(७), महासंख्या_बनाओ(३));
    जाँच("7/3 भागफल", महासंख्या_से_संख्या(आ4["भागफल"]), २);
    जाँच("7/3 शेष", महासंख्या_से_संख्या(आ4["शेष"]), १);
    जाँच("बड़ी संख्या भाग सही (838102050 / 67890)",
        महासंख्या_से_संख्या(महासंख्या_भाग(महासंख्या_बनाओ(८३८१०२०५०), महासंख्या_बनाओ(६७८९०))), १२३४५);
    जाँच("बड़ी संख्या शेष सही (838102051 % 67890)",
        महासंख्या_से_संख्या(महासंख्या_शेष(महासंख्या_बनाओ(८३८१०२०५१), महासंख्या_बनाओ(६७८९०))), १);

    परीक्षण_समूह("गुणनखंड — गणित.गुणनखंड के विरुद्ध क्रॉस-चेक + देशी-सीमा से आगे");
    // १८! ≈ ६.४×१०^१५ — देशी (int64) और महासंख्या_से_संख्या के २-अंक-समूह/
    // १०^१८ सीमा दोनों में सुरक्षित से समाता (२०! ≈ २.४३×१०^१८ पहले से बाहर,
    // इसलिए वह क्रॉस-चेक नीचे भागफल के ज़रिए अप्रत्यक्ष रूप से होता है)
    जाँच("18! देशी गुणनखंड से मेल", महासंख्या_से_संख्या(महासंख्या_गुणनखंड(१८)), गुणनखंड(१८));
    जाँच("0! = 1", महासंख्या_से_संख्या(महासंख्या_गुणनखंड(०)), १);
    जाँच("1! = 1", महासंख्या_से_संख्या(महासंख्या_गुणनखंड(१)), १);
    // २५! देशी संख्या में नहीं समाता — आंतरिक-संगति से जाँचा:
    // २५! / २०! == २१×२२×२३×२४×२५ (देशी-गणनीय), शेष ठीक ० होना चाहिए
    शब्दकोश फै२५_भाग_शेष = महासंख्या_भाग_शेष(महासंख्या_गुणनखंड(२५), महासंख्या_गुणनखंड(२०));
    जाँच("25!/20! शेष ठीक शून्य", महासंख्या_शून्य_है(फै२५_भाग_शेष["शेष"]), सत्य);
    जाँच("25!/20! == 21×22×23×24×25", महासंख्या_से_संख्या(फै२५_भाग_शेष["भागफल"]), २१ * २२ * २३ * २४ * २५);

    परीक्षण_समूह("घात — देशी घातांक के विरुद्ध क्रॉस-चेक + देशी-सीमा से आगे");
    जाँच("2^32 देशी घातांक से मेल", महासंख्या_से_संख्या(महासंख्या_घात(महासंख्या_बनाओ(२), ३२)), घातांक(२, ३२));
    जाँच("क^0 = 1", महासंख्या_से_संख्या(महासंख्या_घात(महासंख्या_बनाओ(९९), ०)), १);
    // २^६४ देशी संख्या में नहीं समाता — आंतरिक-संगति: २^६४ == २^३२ × २^३२
    शब्दकोश दो_घात_६४ = महासंख्या_घात(महासंख्या_बनाओ(२), ६४);
    शब्दकोश दो_घात_३२_वर्ग = महासंख्या_गुणा(महासंख्या_घात(महासंख्या_बनाओ(२), ३२), महासंख्या_घात(महासंख्या_बनाओ(२), ३२));
    जाँच("2^64 == 2^32 × 2^32", महासंख्या_बराबर(दो_घात_६४, दो_घात_३२_वर्ग), सत्य);

    परीक्षण_समूह("घात_मॉड — modular घातांक");
    जाँच("4^13 mod 497 देशी से मेल",
        महासंख्या_से_संख्या(महासंख्या_घात_मॉड(महासंख्या_बनाओ(४), महासंख्या_बनाओ(१३), महासंख्या_बनाओ(४९७))),
        घातांक(४, १३) % ४९७);
    जाँच("आधार^0 mod म = 1", महासंख्या_से_संख्या(महासंख्या_घात_मॉड(महासंख्या_बनाओ(५), महासंख्या_बनाओ(०), महासंख्या_बनाओ(१०००))), १);
    // फ़र्मा की छोटी प्रमेय (Fermat's Little Theorem): प अभाज्य (२^३१-१, Mersenne
    // अभाज्य, गणित.सूत्र के PRNG में भी प्रयुक्त), gcd(आधार, प) = १ ⟹
    // आधार^(प-१) mod प == १ — यह बिना असली modular-reduction के जाँचा ही
    // नहीं जा सकता (आधार^(प-१) खुद अरबों अंकों का होता)
    शब्दकोश फर्मा = महासंख्या_घात_मॉड(महासंख्या_बनाओ(३), महासंख्या_बनाओ(२१४७४८३६४६), महासंख्या_बनाओ(२१४७४८३६४७));
    जाँच("फ़र्मा की छोटी प्रमेय: 3^(p-1) mod p == 1", महासंख्या_से_संख्या(फर्मा), १);

    परीक्षण_समूह("त्रुटि-मामले — शून्य-भाग / ऋणात्मक गुणनखंड / ऋणात्मक घात / अमान्य मापांक");
    संख्या त्रुटि_गिनती = ०;
    प्रयत्न {
        महासंख्या_भाग_शेष(महासंख्या_बनाओ(१), महासंख्या_बनाओ(०));
    } पकड़ो (त्रु4) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_गुणनखंड(-१);
    } पकड़ो (त्रु5) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_घात(महासंख्या_बनाओ(२), -१);
    } पकड़ो (त्रु6) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_घात_मॉड(महासंख्या_बनाओ(२), महासंख्या_बनाओ(२), महासंख्या_बनाओ(०));
    } पकड़ो (त्रु7) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_घात_मॉड(महासंख्या_बनाओ(२), महासंख्या_बनाओ(-१), महासंख्या_बनाओ(५));
    } पकड़ो (त्रु8) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        महासंख्या_से_संख्या(महासंख्या_पाठ_से("९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९"));
    } पकड़ो (त्रु9) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    जाँच("सभी 6 त्रुटि-मामले सही से त्रुटि देते", त्रुटि_गिनती, ६);

    परत् परीक्षण_सारांश();
}
