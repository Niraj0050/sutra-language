// भाषा_परीक्षण/stdlib/यूआरएल_परीक्षण.सूत्र
आयात "पुस्तकालय/यूआरएल.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("यूआरएल_पार्स — पूर्ण URL (सभी भाग)");
    शब्दकोश भाग1 = यूआरएल_पार्स("https://ram:pass@example.com:8080/path/to/thing?a=1&b=2#top");
    जाँच("योजना", भाग1["योजना"], "https");
    जाँच("प्रयोक्ता", भाग1["प्रयोक्ता"], "ram:pass");
    जाँच("मेज़बान", भाग1["मेज़बान"], "example.com");
    जाँच("पोर्ट", भाग1["पोर्ट"], 8080);
    जाँच("पथ", भाग1["पथ"], "/path/to/thing");
    जाँच("प्रश्न (raw)", भाग1["प्रश्न"], "a=1&b=2");
    जाँच("खंड", भाग1["खंड"], "top");

    परीक्षण_समूह("यूआरएल_पार्स — वैकल्पिक भाग अनुपस्थित");
    शब्दकोश भाग2 = यूआरएल_पार्स("http://example.com");
    जाँच("प्रयोक्ता अनुपस्थित → शून्यम्", भाग2["प्रयोक्ता"], शून्यम्);
    जाँच("पोर्ट अनुपस्थित → शून्यम्", भाग2["पोर्ट"], शून्यम्);
    जाँच("पथ अनुपस्थित → रिक्त पाठ", भाग2["पथ"], "");
    जाँच("प्रश्न अनुपस्थित → रिक्त पाठ", भाग2["प्रश्न"], "");
    जाँच("खंड अनुपस्थित → रिक्त पाठ", भाग2["खंड"], "");
    जाँच("मेज़बान फिर भी सही", भाग2["मेज़बान"], "example.com");

    शब्दकोश भाग3 = यूआरएल_पार्स("http://example.com/");
    जाँच("सिर्फ़ रूट पथ", भाग3["पथ"], "/");

    शब्दकोश भाग4 = यूआरएल_पार्स("http://example.com/search?q=hello");
    जाँच("query है पर fragment नहीं", भाग4["प्रश्न"], "q=hello");
    जाँच("fragment रिक्त जब नहीं", भाग4["खंड"], "");

    शब्दकोश भाग5 = यूआरएल_पार्स("http://example.com/page#section");
    जाँच("fragment है पर query नहीं", भाग5["खंड"], "section");
    जाँच("query रिक्त जब नहीं", भाग5["प्रश्न"], "");

    शब्दकोश भाग6 = यूआरएल_पार्स("http://example.com?a=1");
    जाँच("query सीधे host के बाद (कोई पथ नहीं)", भाग6["प्रश्न"], "a=1");
    जाँच("पथ रिक्त इस केस में", भाग6["पथ"], "");

    परीक्षण_समूह("यूआरएल_पार्स — scheme-only (\"//\" रहित, v1 आंशिक-समर्थन)");
    शब्दकोश भाग7 = यूआरएल_पार्स("mailto:ram@example.com");
    जाँच("योजना निकलती", भाग7["योजना"], "mailto");
    जाँच("मेज़बान नहीं निकलता (दस्तावेज़ित सीमा)", भाग7["मेज़बान"], शून्यम्);
    जाँच("बाकी सब पथ में पड़ता", भाग7["पथ"], "ram@example.com");

    परीक्षण_समूह("यूआरएल_पार्स — त्रुटि-मामले");
    संख्या पार्स_त्रुटि_गिनती = ०;
    प्रयत्न {
        यूआरएल_पार्स("no-scheme-here");
    } पकड़ो (त्रु1) {
        पार्स_त्रुटि_गिनती = पार्स_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        यूआरएल_पार्स("http://example.com:abc/path");
    } पकड़ो (त्रु2) {
        पार्स_त्रुटि_गिनती = पार्स_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        यूआरएल_पार्स("http://example.com:/path");
    } पकड़ो (त्रु3) {
        पार्स_त्रुटि_गिनती = पार्स_त्रुटि_गिनती + १;
    }
    जाँच("scheme-रहित/अमान्य-पोर्ट/रिक्त-पोर्ट, तीनों त्रुटि देते", पार्स_त्रुटि_गिनती, ३);

    परीक्षण_समूह("यूआरएल_बनाओ — यूआरएल_पार्स का व्युत्क्रम (राउंड-ट्रिप)");
    जाँच("पूर्ण URL राउंड-ट्रिप",
        यूआरएल_बनाओ(यूआरएल_पार्स("https://ram:pass@example.com:8080/path/to/thing?a=1&b=2#top")),
        "https://ram:pass@example.com:8080/path/to/thing?a=1&b=2#top");
    जाँच("न्यूनतम URL राउंड-ट्रिप", यूआरएल_बनाओ(यूआरएल_पार्स("http://example.com")), "http://example.com");
    जाँच("रूट-पथ URL राउंड-ट्रिप", यूआरएल_बनाओ(यूआरएल_पार्स("http://example.com/")), "http://example.com/");
    जाँच("scheme-only URL राउंड-ट्रिप", यूआरएल_बनाओ(यूआरएल_पार्स("mailto:ram@example.com")), "mailto:ram@example.com");

    परीक्षण_समूह("यूआरएल_बनाओ — हाथ-से बनाई शब्दकोश से (यूआरएल_पार्स के बिना)");
    शब्दकोश हाथ_भाग = {};
    हाथ_भाग["योजना"] = "https";
    हाथ_भाग["प्रयोक्ता"] = शून्यम्;
    हाथ_भाग["मेज़बान"] = "api.example.com";
    हाथ_भाग["पोर्ट"] = 443;
    हाथ_भाग["पथ"] = "/v1/users";
    हाथ_भाग["प्रश्न"] = "";
    हाथ_भाग["खंड"] = "";
    जाँच("हाथ-निर्मित शब्दकोश से सही URL", यूआरएल_बनाओ(हाथ_भाग), "https://api.example.com:443/v1/users");

    परीक्षण_समूह("यूआरएल_प्रतिशत_एन्कोड — अनारक्षित वर्ण अपरिवर्तित");
    जाँच("अक्षर/अंक/- . _ ~ अपरिवर्तित", यूआरएल_प्रतिशत_एन्कोड("abcXYZ012-._~"), "abcXYZ012-._~");
    जाँच("space → %20", यूआरएल_प्रतिशत_एन्कोड(" "), "%20");
    जाँच("/ → %2f", यूआरएल_प्रतिशत_एन्कोड("/"), "%2f");
    जाँच("& → %26", यूआरएल_प्रतिशत_एन्कोड("&"), "%26");
    जाँच("= → %3d", यूआरएल_प्रतिशत_एन्कोड("="), "%3d");
    जाँच("+ → %2b (+ अनारक्षित नहीं)", यूआरएल_प्रतिशत_एन्कोड("+"), "%2b");
    जाँच("रिक्त पाठ → रिक्त पाठ", यूआरएल_प्रतिशत_एन्कोड(""), "");

    परीक्षण_समूह("यूआरएल_प्रतिशत_डिकोड — राउंड-ट्रिप + '+' शाब्दिक रहता (query-context नहीं)");
    जाँच("+ percent-decode में शाब्दिक रहता", यूआरएल_प्रतिशत_डिकोड("a+b"), "a+b");
    जाँच("बड़े/छोटे hex अक्षर दोनों मान्य", यूआरएल_प्रतिशत_डिकोड("%2F%2f"), "//");
    जाँच("सादा ASCII राउंड-ट्रिप", यूआरएल_प्रतिशत_डिकोड(यूआरएल_प्रतिशत_एन्कोड("hello world/path?a=1&b=2")), "hello world/path?a=1&b=2");
    जाँच("बहु-बाइट UTF-8 राउंड-ट्रिप (देवनागरी)", यूआरएल_प्रतिशत_डिकोड(यूआरएल_प्रतिशत_एन्कोड("नमस्ते सूत्र")), "नमस्ते सूत्र");
    जाँच("बहु-बाइट UTF-8 राउंड-ट्रिप (जापानी)", यूआरएल_प्रतिशत_डिकोड(यूआरएल_प्रतिशत_एन्कोड("こんにちは")), "こんにちは");

    परीक्षण_समूह("यूआरएल_प्रतिशत_डिकोड — त्रुटि-मामले");
    संख्या डिकोड_त्रुटि_गिनती = ०;
    प्रयत्न {
        यूआरएल_प्रतिशत_डिकोड("abc%2");
    } पकड़ो (त्रु4) {
        डिकोड_त्रुटि_गिनती = डिकोड_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        यूआरएल_प्रतिशत_डिकोड("%zz");
    } पकड़ो (त्रु5) {
        डिकोड_त्रुटि_गिनती = डिकोड_त्रुटि_गिनती + १;
    }
    जाँच("अधूरा-escape + अमान्य-hex, दोनों त्रुटि देते", डिकोड_त्रुटि_गिनती, २);

    परीक्षण_समूह("यूआरएल_प्रश्न_पार्स");
    शब्दकोश प्र1 = यूआरएल_प्रश्न_पार्स("a=1&b=2&c=hello");
    जाँच("a", प्र1["a"], "1");
    जाँच("b", प्र1["b"], "2");
    जाँच("c", प्र1["c"], "hello");
    जाँच("रिक्त query → रिक्त शब्दकोश", कुंजी_है(यूआरएल_प्रश्न_पार्स(""), "a"), असत्य);
    शब्दकोश प्र2 = यूआरएल_प्रश्न_पार्स("name=Ram+Sharma&city=New+Delhi");
    जाँच("'+' query में space बनता (नाम)", प्र2["name"], "Ram Sharma");
    जाँच("'+' query में space बनता (शहर)", प्र2["city"], "New Delhi");
    शब्दकोश प्र3 = यूआरएल_प्रश्न_पार्स("q=100%25+done");
    जाँच("percent-encoded + literal-plus-as-space मिश्रित", प्र3["q"], "100% done");
    शब्दकोश प्र4 = यूआरएल_प्रश्न_पार्स("flag");
    जाँच("बिना '=' वाली कुंजी → रिक्त मान", प्र4["flag"], "");
    शब्दकोश प्र5 = यूआरएल_प्रश्न_पार्स("a=1&&b=2");
    जाँच("दोहरा '&' नज़रअंदाज़ होता", प्र5["b"], "2");
    शब्दकोश प्र6 = यूआरएल_प्रश्न_पार्स("a=1&a=2");
    जाँच("दोहराई कुंजी — आख़िरी मान जीतता (दस्तावेज़ित v1 सीमा)", प्र6["a"], "2");

    परीक्षण_समूह("यूआरएल_प्रश्न_बनाओ");
    शब्दकोश बनाओ_प्र = {};
    बनाओ_प्र["b"] = "2";
    बनाओ_प्र["a"] = "1";
    जाँच("कुंजियाँ वर्णानुक्रम में (नियतात्मक)", यूआरएल_प्रश्न_बनाओ(बनाओ_प्र), "a=1&b=2");
    शब्दकोश बनाओ_प्र2 = {};
    बनाओ_प्र2["q"] = "hello world";
    जाँच("मान percent-encode होता", यूआरएल_प्रश्न_बनाओ(बनाओ_प्र2), "q=hello%20world");
    शब्दकोश रिक्त_प्र = {};
    जाँच("रिक्त शब्दकोश → रिक्त पाठ", यूआरएल_प्रश्न_बनाओ(रिक्त_प्र), "");

    परीक्षण_समूह("यूआरएल_प्रश्न_पार्स/बनाओ — राउंड-ट्रिप");
    शब्दकोश मूल_प्र = यूआरएल_प्रश्न_पार्स("city=New+Delhi&pin=110001");
    पाठ पुनः_प्र = यूआरएल_प्रश्न_बनाओ(मूल_प्र);
    शब्दकोश दोबारा_प्र = यूआरएल_प्रश्न_पार्स(पुनः_प्र);
    जाँच("राउंड-ट्रिप के बाद city वही", दोबारा_प्र["city"], मूल_प्र["city"]);
    जाँच("राउंड-ट्रिप के बाद pin वही", दोबारा_प्र["pin"], मूल_प्र["pin"]);

    परत् परीक्षण_सारांश();
}
