// भाषा_परीक्षण/stdlib/कैश_परीक्षण.सूत्र
आयात "पुस्तकालय/कैश.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("मूल — बनाओ/रखो/पाओ");
    शब्दकोश क1 = कैश_बनाओ(३);
    जाँच("नया कैश खाली", कैश_आकार(क1), ०);
    जाँच_सत्य("नया कैश खाली_है सत्य", कैश_खाली_है(क1));
    जाँच("न-मौजूद कुंजी शून्यम् लौटाती", कैश_पाओ(क1, "क"), शून्यम्);

    कैश_रखो(क1, "अ", "1");
    कैश_रखो(क1, "ब", "2");
    कैश_रखो(क1, "स", "3");
    जाँच("तीन प्रविष्टि के बाद आकार", कैश_आकार(क1), ३);
    जाँच("अ का मूल्य", कैश_पाओ(क1, "अ"), "1");
    जाँच("ब का मूल्य", कैश_पाओ(क1, "ब"), "2");
    जाँच("स का मूल्य", कैश_पाओ(क1, "स"), "3");
    जाँच_सत्य("अ मौजूद (है)", कैश_है(क1, "अ"));
    जाँच_असत्य("घ मौजूद नहीं", कैश_है(क1, "घ"));

    परीक्षण_समूह("क्रम — MRU→LRU सूची");
    सूची क्रम1 = कैश_कुंजियाँ_क्रम_में(क1);
    जाँच("डालने के उल्टे क्रम में — लंबाई", लंबाई(क्रम1), ३);
    जाँच("सबसे हाल पहले — स", क्रम1[०], "स");
    जाँच("दूसरा — ब", क्रम1[१], "ब");
    जाँच("सबसे पुराना अंत में — अ", क्रम1[२], "अ");

    परीक्षण_समूह("निष्कासन (eviction) — क्षमता पार होने पर सबसे पुराना हटे");
    शब्दकोश क2 = कैश_बनाओ(२);
    कैश_रखो(क2, "अ", "1");
    कैश_रखो(क2, "ब", "2");
    कैश_रखो(क2, "स", "3");
    जाँच("क्षमता 2 से बड़ा नहीं होता", कैश_आकार(क2), २);
    जाँच_असत्य("सबसे पुराना (अ) निकाला गया", कैश_है(क2, "अ"));
    जाँच_सत्य("ब अभी भी मौजूद", कैश_है(क2, "ब"));
    जाँच_सत्य("स (नया) मौजूद", कैश_है(क2, "स"));
    सूची क्रम2 = कैश_कुंजियाँ_क्रम_में(क2);
    जाँच("क्रम की लंबाई 2", लंबाई(क्रम2), २);
    जाँच("क्रम — स सबसे हाल", क्रम2[०], "स");
    जाँच("क्रम — फिर ब", क्रम2[१], "ब");

    परीक्षण_समूह("recency — पाओ() क्रम बदलता है");
    शब्दकोश क3 = कैश_बनाओ(२);
    कैश_रखो(क3, "अ", "1");
    कैश_रखो(क3, "ब", "2");
    कैश_पाओ(क3, "अ");                        // अ अब सबसे हाल-इस्तेमाल
    कैश_रखो(क3, "स", "3");                    // क्षमता पूरी — ब हटना चाहिए, अ नहीं
    जाँच_सत्य("पाओ() के बाद अ बचा रहा (recency refresh हुई)", कैश_है(क3, "अ"));
    जाँच_असत्य("ब हटाया गया (touch नहीं हुआ था)", कैश_है(क3, "ब"));
    जाँच_सत्य("स (नया) मौजूद", कैश_है(क3, "स"));

    परीक्षण_समूह("recency — है() (peek) क्रम नहीं बदलता");
    शब्दकोश क4 = कैश_बनाओ(२);
    कैश_रखो(क4, "अ", "1");
    कैश_रखो(क4, "ब", "2");
    कैश_है(क4, "अ");                          // सिर्फ़ जाँच — recency नहीं छूनी चाहिए
    कैश_रखो(क4, "स", "3");                     // अ अभी भी सबसे पुराना — इसे हटना चाहिए
    जाँच_असत्य("है()-peek के बावजूद अ हटा (कोई recency-प्रभाव नहीं)", कैश_है(क4, "अ"));
    जाँच_सत्य("ब बचा रहा", कैश_है(क4, "ब"));

    परीक्षण_समूह("अद्यतन (update) — मौजूदा कुंजी पर रखो() आकार नहीं बढ़ाता");
    शब्दकोश क5 = कैश_बनाओ(२);
    कैश_रखो(क5, "अ", "पुराना");
    कैश_रखो(क5, "अ", "नया");
    जाँच("अद्यतन के बाद आकार अब भी 1", कैश_आकार(क5), १);
    जाँच("मूल्य अद्यतन हुआ", कैश_पाओ(क5, "अ"), "नया");

    शब्दकोश क6 = कैश_बनाओ(२);
    कैश_रखो(क6, "अ", "1");
    कैश_रखो(क6, "ब", "2");
    कैश_रखो(क6, "अ", "1-नया");                 // अद्यतन — अ सबसे हाल बने
    कैश_रखो(क6, "स", "3");                     // ब सबसे पुराना — हटना चाहिए
    जाँच_असत्य("अद्यतन ने अ को recency दी, ब हटा", कैश_है(क6, "ब"));
    जाँच("अ का अद्यतन मूल्य बचा रहा", कैश_पाओ(क6, "अ"), "1-नया");

    परीक्षण_समूह("हटाओ — स्पष्ट निष्कासन");
    शब्दकोश क7 = कैश_बनाओ(३);
    कैश_रखो(क7, "अ", "1");
    कैश_रखो(क7, "ब", "2");
    जाँच_सत्य("मौजूद कुंजी हटाना सत्य लौटाता", कैश_हटाओ(क7, "अ"));
    जाँच_असत्य("अ अब मौजूद नहीं", कैश_है(क7, "अ"));
    जाँच("आकार घटा", कैश_आकार(क7), १);
    जाँच_असत्य("न-मौजूद कुंजी हटाना असत्य लौटाता", कैश_हटाओ(क7, "घ"));
    कैश_रखो(क7, "अ", "फिर-से");
    जाँच("हटाने के बाद फिर से वही कुंजी नई प्रविष्टि जैसे जुड़ सकती",
        कैश_पाओ(क7, "अ"), "फिर-से");

    परीक्षण_समूह("खाली_करो");
    शब्दकोश क8 = कैश_बनाओ(२);
    कैश_रखो(क8, "अ", "1");
    कैश_रखो(क8, "ब", "2");
    कैश_खाली_करो(क8);
    जाँच("खाली_करो के बाद आकार 0", कैश_आकार(क8), ०);
    जाँच_सत्य("खाली_करो के बाद खाली_है सत्य", कैश_खाली_है(क8));
    जाँच_असत्य("खाली_करो के बाद पुरानी कुंजी नहीं मिलती", कैश_है(क8, "अ"));
    कैश_रखो(क8, "स", "3");
    जाँच("खाली_करो के बाद क्षमता अब भी काम करती (नई प्रविष्टि जुड़ी)",
        कैश_आकार(क8), १);

    परीक्षण_समूह("किनारे के मामले — क्षमता 1");
    शब्दकोश क9 = कैश_बनाओ(१);
    कैश_रखो(क9, "अ", "1");
    कैश_रखो(क9, "ब", "2");
    जाँच("क्षमता-1 कैश में हमेशा सिर्फ़ 1 प्रविष्टि", कैश_आकार(क9), १);
    जाँच_असत्य("पुरानी कुंजी हट गई", कैश_है(क9, "अ"));
    जाँच_सत्य("नई कुंजी मौजूद", कैश_है(क9, "ब"));

    परीक्षण_समूह("किनारे के मामले — अमान्य क्षमता");
    संख्या क्षमता_त्रुटि_गिनती = ०;
    प्रयत्न {
        कैश_बनाओ(०);
    } पकड़ो (त्रु1) {
        क्षमता_त्रुटि_गिनती = क्षमता_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        कैश_बनाओ(-१);
    } पकड़ो (त्रु2) {
        क्षमता_त्रुटि_गिनती = क्षमता_त्रुटि_गिनती + १;
    }
    जाँच("क्षमता 0 और ऋणात्मक दोनों त्रुटि देते", क्षमता_त्रुटि_गिनती, २);

    परीक्षण_समूह("बहु-बाइट UTF-8 (देवनागरी) कुंजी/मूल्य + मिश्रित मान-प्रकार");
    शब्दकोश क10 = कैश_बनाओ(४);
    कैश_रखो(क10, "नमस्ते", "स्वागत है");
    कैश_रखो(क10, "संख्या", ४२);
    कैश_रखो(क10, "सत्य_मान", सत्य);
    जाँच("देवनागरी कुंजी/मूल्य दोनों सही", कैश_पाओ(क10, "नमस्ते"), "स्वागत है");
    जाँच("संख्या-प्रकार मूल्य सही", कैश_पाओ(क10, "संख्या"), ४२);
    जाँच_सत्य("बूल-प्रकार मूल्य सही", कैश_पाओ(क10, "सत्य_मान"));

    परीक्षण_समूह("बड़ा क्रम — कई निष्कासन एक-साथ सही रहें");
    शब्दकोश क11 = कैश_बनाओ(३);
    संख्या इ = ०;
    यावत् (इ < १०) {
        कैश_रखो(क11, "कुं" + इ, इ);
        इ = इ + १;
    }
    जाँच("10 प्रविष्टियों के बाद आकार अब भी क्षमता (3) पर बंधा", कैश_आकार(क11), ३);
    सूची क्रम11 = कैश_कुंजियाँ_क्रम_में(क11);
    जाँच("आखिरी तीन ही बचीं — लंबाई", लंबाई(क्रम11), ३);
    जाँच("सबसे हाल — कुं9", क्रम11[०], "कुं9");
    जाँच("बीच वाला — कुं8", क्रम11[१], "कुं8");
    जाँच("सबसे पुराना बचा — कुं7", क्रम11[२], "कुं7");
    जाँच_असत्य("पुरानी (कुं0) जा चुकी", कैश_है(क11, "कुं0"));
    जाँच_असत्य("पुरानी (कुं6) जा चुकी", कैश_है(क11, "कुं6"));

    परत् परीक्षण_सारांश();
}
