// भाषा_परीक्षण/stdlib/विभेद_पैच_परीक्षण.सूत्र
// patch पढ़ना और लगाना (विभेद.सूत्र का दूसरा भाग), पहली परीक्षण-फ़ाइल: पार्स, ताज़ा लगाना (आगे/उलटा),
// अपनी ही diff से round-trip, और API/किनारे के मामले। अपेक्षित मान बाहरी संदर्भों से generate किए गए:
//   • patch-पाठ असली `git diff --no-index -U<n>` से (शीर्ष सहित और बिना, नई-पंक्ति के सारे रूप, खाली
//     फ़ाइलें, CRLF, इमोजी); लगाने पर अपेक्षित पाठ = वही जिससे diff बना (आगे: पुराना → नया, उलटा: नया → पुराना);
//   • पार्स का ढाँचा एक स्वतंत्र (regex-आधारित, गिनती-चालित) PowerShell पार्सर से।
// खिसकी फ़ाइल पर लगाना / ऑफ़सेट / अस्पष्ट मिलान / विफलताएँ: `विभेद_पैच_खिसका_परीक्षण.सूत्र` (असली `git apply` से)।
आयात "पुस्तकालय/विभेद.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// ===== सहायक =====

// पार्स का संक्षिप्त पाठ-रूप: हर फाइल "F:पुराना->नया;", हर hunk "H<पु_शुरू>,<पु_गिन>,<न_शुरू>,<न_गिन>,<पु_बिना><न_बिना>:<ओप>|...;"
कार्य पैच_सार(पाठ पैच) {
    मान फाइलें = विभेद_पैच_पार्स(पैच);
    यदि (प्रकार(फाइलें) == "शून्यम्") { परत् "त्रुटि"; }
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(फाइलें)) {
        शब्दकोश फ = फाइलें[इ];
        फल = फल + "F:" + फ["पुराना_नाम"] + "->" + फ["नया_नाम"] + ";";
        सूची हंकें = फ["हंक"];
        संख्या ज = ०;
        यावत् (ज < लंबाई(हंकें)) {
            शब्दकोश ह = हंकें[ज];
            फल = फल + "H" + ह["पु_शुरू"] + "," + ह["पु_गिन"] + "," + ह["न_शुरू"] + "," + ह["न_गिन"] + "," + ह["पु_अंत_बिना"] + ह["न_अंत_बिना"] + ":";
            सूची ओप = ह["ओप"];
            संख्या क = ०;
            यावत् (क < लंबाई(ओप)) {
                सूची जोड़ी = ओप[क];
                फल = फल + जोड़ी[०] + जोड़ी[१] + "|";
                क = क + १;
            }
            फल = फल + ";";
            ज = ज + १;
        }
        इ = इ + १;
    }
    परत् फल;
}

// patch का परिणाम (पाठ या शून्यम्) जाँचो
कार्य जाँच_पैच(पाठ नाम, पाठ पुराना, पाठ पैच, मान अपेक्षित) {
    मान वास्तविक = विभेद_पैच_लगाओ(पुराना, पैच);
    जाँच(नाम, वास्तविक, अपेक्षित);
    परत् ०;
}

// आगे: पुराना → नया, और उलटा: नया → पुराना
कार्य जाँच_दोतरफा(पाठ नाम, पाठ पुराना, पाठ पैच, पाठ नया) {
    जाँच(नाम + " — आगे", विभेद_पैच_लगाओ(पुराना, पैच), नया);
    जाँच(नाम + " — उलटा", विभेद_पैच_उलटा_लगाओ(नया, पैच), पुराना);
    परत् ०;
}

// round-trip: पुराना → (अपनी diff) → लगाओ == नया, और उलटा लगाओ == पुराना
कार्य जाँच_चक्र(पाठ नाम, पाठ पुराना, पाठ नया, संख्या संदर्भ) {
    पाठ पैच = विभेद_एकीकृत("क.txt", "ख.txt", पुराना, नया, संदर्भ);
    जाँच(नाम + " — आगे", विभेद_पैच_लगाओ(पुराना, पैच), नया);
    जाँच(नाम + " — उलटा", विभेद_पैच_उलटा_लगाओ(नया, पैच), पुराना);
    परत् ०;
}

// बहु-फ़ाइल patch: हर अभिलेख अलग से लगे
कार्य जाँच_बहु(पाठ पैच) {
    सूची फाइलें = विभेद_पैच_पार्स(पैच);
    शब्दकोश फाइल_एक = फाइलें[०];
    शब्दकोश फाइल_दो = फाइलें[१];
    जाँच("बहु: नाम एक", फाइल_एक["पुराना_नाम"], "f1.txt");
    जाँच("बहु: नाम दो", फाइल_दो["पुराना_नाम"], "f2.txt");
    शब्दकोश फल_एक = विभेद_पैच_फाइल_लगाओ("एक\nदो\n", फाइल_एक, ०);
    शब्दकोश फल_दो = विभेद_पैच_फाइल_लगाओ("x\n", फाइल_दो, ०);
    जाँच("बहु: फाइल एक का परिणाम", फल_एक["पाठ"], "एक\nदो!\n");
    जाँच("बहु: फाइल दो का परिणाम", फल_दो["पाठ"], "x1\nx2\n");
    शब्दकोश फल_तीन = विभेद_पैच_फाइल_लगाओ("एक\nदो\n", फाइल_दो, ०);
    जाँच("बहु: गलत पाठ पर फाइल दो विफल", फल_तीन["सफल"], ०);
    परत् ०;
}

// विस्तृत परिणाम (सफल): सफल == १, त्रुटि "", पाठ अपेक्षित, स्थान में हर hunk का [क्रम, शुरू, खिसकाव]
कार्य जाँच_विस्तृत(पाठ पुराना, पाठ पैच, पाठ अपेक्षित) {
    सूची फाइलें = विभेद_पैच_पार्स(पैच);
    शब्दकोश फाइल = फाइलें[०];
    सूची हंकें = फाइल["हंक"];
    शब्दकोश पहला_हंक = हंकें[०];
    संख्या घोषित = पहला_हंक["पु_शुरू"];
    शब्दकोश र = विभेद_पैच_फाइल_लगाओ(पुराना, फाइल, ०);
    जाँच("विस्तृत: सफल", र["सफल"], १);
    जाँच("विस्तृत: त्रुटि खाली", र["त्रुटि"], "");
    जाँच("विस्तृत: पाठ", र["पाठ"], अपेक्षित);
    सूची स्थान = र["स्थान"];
    जाँच("विस्तृत: स्थान में हर hunk की प्रविष्टि", लंबाई(स्थान), लंबाई(हंकें));
    सूची पहला = स्थान[०];
    संख्या क्रम = पहला[०];
    संख्या शुरू = पहला[१];
    संख्या खिसकाव = पहला[२];
    जाँच("विस्तृत: पहला hunk क्रम १", क्रम, १);
    जाँच("विस्तृत: खिसकाव = २ (ऊपर दो पंक्तियाँ जुड़ीं)", खिसकाव, २);
    जाँच("विस्तृत: शुरू-पंक्ति = घोषित + खिसकाव", शुरू, घोषित + २);
    परत् ०;
}

// विस्तृत परिणाम (विफल): सफल == ०, पाठ "", त्रुटि में hunk-क्रम, स्थान में सिर्फ़ सफल hunk
कार्य जाँच_विस्तृत_विफल(पाठ पुराना, पाठ पैच, पाठ अपेक्षित_त्रुटि) {
    सूची फाइलें = विभेद_पैच_पार्स(पैच);
    शब्दकोश फाइल = फाइलें[०];
    शब्दकोश र = विभेद_पैच_फाइल_लगाओ(पुराना, फाइल, ०);
    जाँच("विफल: सफल ०", र["सफल"], ०);
    जाँच("विफल: पाठ खाली", र["पाठ"], "");
    जाँच("विफल: त्रुटि-संदेश (दूसरा hunk, घोषित पंक्ति)", र["त्रुटि"], अपेक्षित_त्रुटि);
    सूची स्थान = र["स्थान"];
    जाँच("विफल: सफल hunk की प्रविष्टि (सिर्फ़ पहला)", लंबाई(स्थान), १);
    जाँच("विफल: विभेद_पैच_लगाओ भी शून्यम्", विभेद_पैच_लगाओ(पुराना, पैच), शून्यम्);
    परत् ०;
}

// एक ही parse की हुई फाइल को दो बार लगाना — नतीजा वही, इनपुट (ओप) अपरिवर्तित
कार्य जाँच_अपरिवर्तनीय(पाठ पुराना, पाठ पैच) {
    सूची फाइलें = विभेद_पैच_पार्स(पैच);
    शब्दकोश फाइल = फाइलें[०];
    सूची हंकें = फाइल["हंक"];
    शब्दकोश पहला_हंक = हंकें[०];
    सूची ओप_पहले = पहला_हंक["ओप"];
    संख्या पहले = लंबाई(ओप_पहले);
    शब्दकोश फल_एक = विभेद_पैच_फाइल_लगाओ(पुराना, फाइल, ०);
    शब्दकोश फल_दो = विभेद_पैच_फाइल_लगाओ(पुराना, फाइल, ०);
    जाँच("अपरिवर्तनीय: दोनों बार वही पाठ", फल_एक["पाठ"], फल_दो["पाठ"]);
    सूची ओप_बाद = पहला_हंक["ओप"];
    जाँच("अपरिवर्तनीय: hunk की ओप-लंबाई वही", लंबाई(ओप_बाद), पहले);
    पाठ परिणाम = फल_एक["पाठ"];
    जाँच("अपरिवर्तनीय: उलटा-लगाकर-फिर-आगे वापस", विभेद_पैच_लगाओ(विभेद_पैच_उलटा_लगाओ(परिणाम, पैच), पैच), परिणाम);
    परत् ०;
}

कार्य मुख्य() {
    परीक्षण_समूह("पैच पार्स — असली git diff आउटपुट (शीर्ष सहित) और अन्य रूप");
    जाँच("git 1: एक पंक्ति बदली (संदर्भ ३)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex a1d7735..0c1b98e 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -12,7 +12,7 @@\n प12\n प13\n प14\n-प15\n+बदली-१\n प16\n प17\n प18\n"), "F:a/a/x.txt->b/b/x.txt;H12,7,12,7,00:=प12|=प13|=प14|-प15|+बदली-१|=प16|=प17|=प18|;");
    जाँच("git 2: दो अलग hunk (संदर्भ २)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex a1d7735..dd35a45 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1,5 +1,5 @@\n प1\n प2\n-प3\n+बदली-२\n प4\n प5\n@@ -24,5 +24,5 @@\n प24\n प25\n-प26\n+बदली-३\n प27\n प28\n"), "F:a/a/x.txt->b/b/x.txt;H1,5,1,5,00:=प1|=प2|-प3|+बदली-२|=प4|=प5|;H24,5,24,5,00:=प24|=प25|-प26|+बदली-३|=प27|=प28|;");
    जाँच("git 3: नई फ़ाइल (पुराना खाली)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex e69de29..0f82c15 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -0,0 +1,4 @@\n+न1\n+न2\n+न3\n+न4\n"), "F:a/a/x.txt->b/b/x.txt;H0,0,1,4,00:+न1|+न2|+न3|+न4|;");
    जाँच("git 4: मिटी फ़ाइल (नया खाली)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex 7f38854..e69de29 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1,4 +0,0 @@\n-म1\n-म2\n-म3\n-म4\n"), "F:a/a/x.txt->b/b/x.txt;H1,4,0,0,00:-म1|-म2|-म3|-म4|;");
    जाँच("git 5: दोनों में अंतिम नई-पंक्ति नहीं", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex 1c943a9..2704ba9 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1,3 +1,3 @@\n a\n b\n-c\n\\ No newline at end of file\n+d\n\\ No newline at end of file\n"), "F:a/a/x.txt->b/b/x.txt;H1,3,1,3,11:=a|=b|-c|+d|;");
    जाँच("git 6: पुराने में नई-पंक्ति, नए में नहीं (पंक्तियाँ वही)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex 422c2b7..0a207c0 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1,2 +1,2 @@\n a\n-b\n+b\n\\ No newline at end of file\n"), "F:a/a/x.txt->b/b/x.txt;H1,2,1,2,01:=a|-b|+b|;");
    जाँच("git 7: पुराने में नहीं, नए में नई-पंक्ति (पंक्तियाँ वही)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex 0a207c0..422c2b7 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+b\n"), "F:a/a/x.txt->b/b/x.txt;H1,2,1,2,10:=a|-b|+b|;");
    जाँच("git 8: एक-पंक्ति फ़ाइलें (गिनती छूटी @@ -1 +1 @@)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex 4a48285..00f007c 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1 +1 @@\n-पुरानी\n+नई\n"), "F:a/a/x.txt->b/b/x.txt;H1,1,1,1,00:-पुरानी|+नई|;");
    जाँच("git 9: शून्य-संदर्भ (डालना + हटाना)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex a1d7735..951eb4c 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -10,0 +11 @@\n+डाली-१\n@@ -21 +21,0 @@\n-प21\n"), "F:a/a/x.txt->b/b/x.txt;H10,0,11,1,00:+डाली-१|;H21,1,21,0,00:-प21|;");
    जाँच("git 10: पहली पंक्ति बदली (संदर्भ १)", पैच_सार("diff --git a/a/x.txt b/b/x.txt\nindex a1d7735..70eb494 100644\n--- a/a/x.txt\n+++ b/b/x.txt\n@@ -1,2 +1,2 @@\n-प1\n+पहली-बदली\n प2\n"), "F:a/a/x.txt->b/b/x.txt;H1,2,1,2,00:-प1|+पहली-बदली|=प2|;");
