// भाषा_परीक्षण/stdlib/एसएचए256_परीक्षण.सूत्र
// अपेक्षित मान .NET के System.Security.Cryptography.SHA256 (प्रमाणित सही
// कार्यान्वयन) से सीधे generate किए गए — किसी की याददाश्त/किताब से नहीं।
आयात "पुस्तकालय/एसएचए256.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य दोहराओ_एक्स(संख्या गिनती) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = फल + "x";
        इ = इ + १;
    }
    परत् फल;
}

कार्य मुख्य() {
    परीक्षण_समूह("मानक test vectors");
    जाँच("रिक्त पाठ", एसएचए256_हैश(""),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    जाँच("\"a\"", एसएचए256_हैश("a"),
        "ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb");
    जाँच("\"abc\"", एसएचए256_हैश("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    जाँच("\"hello world\"", एसएचए256_हैश("hello world"),
        "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9");
    जाँच("लंबा पाठ (56+ बाइट padding-सीमा जाँच)",
        एसएचए256_हैश("The quick brown fox jumps over the lazy dog"),
        "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592");

    परीक्षण_समूह("ब्लॉक-सीमा (padding edge cases)");
    जाँच("55 बाइट (एक ब्लॉक में ठीक फिट)", एसएचए256_हैश(दोहराओ_एक्स(५५)),
        "d5e285683cd4efc02d021a5c62014694958901005d6f71e89e0989fac77e4072");
    जाँच("56 बाइट (दूसरा ब्लॉक ज़रूरी)", एसएचए256_हैश(दोहराओ_एक्स(५६)),
        "04c26261370ee7541549d16dee320c723e3fd14671e66a099afe0a377c16888e");
    जाँच("64 बाइट (ठीक एक पूरा ब्लॉक)", एसएचए256_हैश(दोहराओ_एक्स(६४)),
        "7ce100971f64e7001e8fe5a51973ecdfe1ced42befe7ee8d5fd6219506b5393c");
    जाँच("65 बाइट (एक ब्लॉक से एक ज़्यादा)", एसएचए256_हैश(दोहराओ_एक्स(६५)),
        "9537c5fdf120482f7d58d25e9ed583f52c02b4e304ea814db1633ad565aed7e9");

    परीक्षण_समूह("बहु-बाइट UTF-8 (Devanagari)");
    जाँच("नमस्ते सूत्र", एसएचए256_हैश("नमस्ते सूत्र"),
        "37136894f4bf915a627441d229f543990b598a875d5baa6a6c804e82807308e1");

    // पहले `श256_पैड` इनपुट-सूची को साझा करके `जोड़ें()` से जगह पर बढ़ा देता था — caller की सूची
    // बदल जाती और उसी सूची पर दूसरी कॉल ग़लत हैश देती (interpreter में सूची ६४ लंबी, native में १६)
    परीक्षण_समूह("इनपुट-सूची अपरिवर्तित (बाइट्स-API) — एक ही सूची पर बार-बार हैश");
    सूची ब_इनपुट = [९७, ९८, ९९];
    जाँच("एसएचए256_हैश_बाइट्स — पहली कॉल (\"abc\")", एसएचए256_हैश_बाइट्स(ब_इनपुट),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    जाँच("पहली कॉल के बाद इनपुट-सूची की लंबाई ३ ही", लंबाई(ब_इनपुट), ३);
    जाँच("उसी सूची पर दूसरी कॉल — वही सही हैश", एसएचए256_हैश_बाइट्स(ब_इनपुट),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    जाँच("दूसरी कॉल के बाद भी लंबाई ३, तत्व वही", लंबाई(ब_इनपुट) == ३ && ब_इनपुट[०] == ९७ && ब_इनपुट[२] == ९९, सत्य);

    परीक्षण_समूह("गुण");
    जाँच("लंबाई हमेशा 64", लंबाई(एसएचए256_हैश("कुछ भी")), ६४);
    जाँच("नियतात्मक (deterministic)", एसएचए256_हैश("दोहराओ") == एसएचए256_हैश("दोहराओ"), सत्य);
    जाँच("अलग-अलग इनपुट अलग हैश", एसएचए256_हैश("अ") == एसएचए256_हैश("आ"), असत्य);

    परत् परीक्षण_सारांश();
}
