// दो सूचियाँ (लंबाई + तत्व-वार) बराबर हैं? — जाँच() में पूरी सूची भेजने की जगह
// (जोड़ें()-निर्मित सूची `मान`-पैरामीटर से तुलना पर compiled backends में ग़लत
// निकली थी — देखो कैश परीक्षण); यहाँ पैरामीटर `सूची`-typed हैं
कार्य सूची_बराबर(सूची अ, सूची ब) {
    यदि (लंबाई(अ) != लंबाई(ब)) { परत् असत्य; }
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        यदि (अ[इ] != ब[इ]) { परत् असत्य; }
        इ = इ + १;
    }
    परत् सत्य;
}

// Park–Miller छद्म-यादृच्छिक: [०, सीमा) का पूर्णांक
कार्य यादृ_अगला(शब्दकोश स्थिति, संख्या सीमा) {
    संख्या बीज = स्थिति["बीज"];
    बीज = (बीज * ४८२७१) % २१४७४८३६४७;
    स्थिति["बीज"] = बीज;
    परत् (बीज / ८) % सीमा;
}

