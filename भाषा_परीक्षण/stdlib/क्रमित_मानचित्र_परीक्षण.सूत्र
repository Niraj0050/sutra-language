    जाँच("सारे सम कुंजियाँ हटाने के बाद आकार ५०", क्रमित_आकार(म९), ५०);
    जाँच_सत्य("हटाने के बाद ऊँचाई <= ७ (५० नोड की AVL-सीमा)", क्रमित_ऊँचाई(म९) <= ७);
    जाँच_सत्य("हटाने के बाद क्रमित_जाँच", क्रमित_जाँच(म९));
    जाँच("पहली बची कुंजी १", क्रमित_चयन(म९, ०), १);
    जाँच("आखिरी बची कुंजी ९९", क्रमित_चयन(म९, ४९), ९९);
    जाँच("रैंक(५१) — २५ विषम कुंजियाँ (१..४९) छोटी", क्रमित_रैंक(म९, ५१), २५);

    परीक्षण_समूह("मूल्य किसी भी प्रकार के (पाठ / संख्या / बूल / सूची) — सटीक लौटें");
    शब्दकोश म१० = क्रमित_बनाओ();
    क्रमित_रखो(म१०, १, "पाठ-मूल्य");
    क्रमित_रखो(म१०, २, ४२);
    क्रमित_रखो(म१०, ३, सत्य);
    क्रमित_रखो(म१०, ४, [७, ८, ९]);
    जाँच("पाठ-मूल्य", क्रमित_पाओ(म१०, १), "पाठ-मूल्य");
    जाँच("संख्या-मूल्य", क्रमित_पाओ(म१०, २), ४२);
    जाँच_सत्य("बूल-मूल्य", क्रमित_पाओ(म१०, ३));
    सूची सू१० = क्रमित_पाओ(म१०, ४);
    जाँच("सूची-मूल्य — लंबाई", लंबाई(सू१०), ३);
    जाँच("सूची-मूल्य — तत्व ०", सू१०[०], ७);
    जाँच("सूची-मूल्य — तत्व २", सू१०[२], ९);

    परीक्षण_समूह("खाली_करो + पुनः-उपयोग");
    शब्दकोश म११ = क्रमित_बनाओ();
    क्रमित_रखो(म११, ५, "क");
    क्रमित_रखो(म११, ६, "ख");
    क्रमित_खाली_करो(म११);
    जाँच_सत्य("खाली_करो के बाद खाली_है", क्रमित_खाली_है(म११));
    जाँच("खाली_करो के बाद आकार", क्रमित_आकार(म११), ०);
    जाँच_असत्य("खाली_करो के बाद पुरानी कुंजी नहीं", क्रमित_है(म११, ५));
    क्रमित_रखो(म११, ९, "ग");
    जाँच("पुनः-उपयोग — आकार १", क्रमित_आकार(म११), १);
    जाँच("पुनः-उपयोग — पाओ", क्रमित_पाओ(म११, ९), "ग");
    जाँच_सत्य("पुनः-उपयोग — क्रमित_जाँच", क्रमित_जाँच(म११));

    परत् परीक्षण_सारांश();
