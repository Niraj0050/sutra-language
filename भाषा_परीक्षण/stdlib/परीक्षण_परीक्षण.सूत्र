आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("अंकगणित");
    जाँच("जोड़", २ + ३, ५);
    जाँच("गुणा", ४ * ५, २०);
    जाँच_सत्य("धनात्मक", ७ > ०);
    जाँच_असत्य("शून्य नहीं", ० > ५);

    परीक्षण_समूह("सूची");
    जाँच("गहरी समानता", [१, [२, ३]], [१, [२, ३]]);
    जाँच("लंबाई", लंबाई([१०, २०, ३०]), ३);

    परीक्षण_समूह("दशमलव");
    जाँच_निकट("भाग", १०.० / ३.०, ३.३३३, ०.०१);
    जाँच_निकट("वर्गमूल", वर्गमूल(२.०), १.४१४, ०.००१);

    परीक्षण_समूह("पाठ");
    जाँच("जोड़", "अ" + "ब", "अब");
    जाँच("उच्च", उच्च("abc"), "ABC");

    // सारांश — सब पास होना चाहिए → ०
    संख्या कोड = परीक्षण_सारांश();
    लिखतु("निकास कोड: " + कोड);   // ०
}
