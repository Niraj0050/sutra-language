// भाषा_परीक्षण/stdlib/यूआई_परीक्षण.सूत्र — यूआई मॉडल पुस्तकालय के परीक्षण
आयात "पुस्तकालय/यूआई.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// नोड का स्थान क्रिया-id से निकालो
कार्य स्थान_का(शब्दकोश जड़, पाठ क्रिया) {
    मान नोड = यूआई_खोजो_क्रिया(जड़, क्रिया);
    परत् नोड["स्थान"];
}

कार्य दृश्य_बनाओ() {
    परत् डिब्बा({"दिशा": "स्तंभ", "पैडिंग": १०, "अंतर": ८}, [
        डिब्बा({"दिशा": "पंक्ति", "अंतर": ६, "ऊँचाई": ४०}, [
            बटन("A", "क्रिया_अ", {"चौड़ाई": ८०}),
            बटन("B", "क्रिया_ब", {"चौड़ाई": ८०}),
            रिक्ति(१)
        ]),
        डिब्बा({"बढ़त": १, "पृष्ठ_रंग": "#111827", "क्रिया": "सामग्री_क्षेत्र"}, [])
    ]);
}

कार्य मुख्य() {
    परीक्षण_समूह("लेआउट — स्तंभ + पंक्ति + बढ़त + तनाव");

    शब्दकोश जड़ = दृश्य_बनाओ();
    लेआउट_करो(जड़, ४००, ३००);

    शब्दकोश जस = जड़["स्थान"];
    जाँच("जड़ चौड़ाई", जस["चौड़ाई"], ४००);
    जाँच("जड़ ऊँचाई", जस["ऊँचाई"], ३००);

    शब्दकोश अ_स = स्थान_का(जड़, "क्रिया_अ");
    जाँच("बटन A बाएँ",  अ_स["बाएँ"],  १०);
    जाँच("बटन A ऊपर",   अ_स["ऊपर"],   १०);
    जाँच("बटन A चौड़ाई", अ_स["चौड़ाई"], ८०);
    जाँच("बटन A ऊँचाई (तनाव → टूलबार-ऊँचाई)", अ_स["ऊँचाई"], ४०);

    शब्दकोश ब_स = स्थान_का(जड़, "क्रिया_ब");
    जाँच("बटन B बाएँ (A + चौड़ाई + अंतर)", ब_स["बाएँ"], ९६);

    शब्दकोश सा_स = स्थान_का(जड़, "सामग्री_क्षेत्र");
    जाँच("सामग्री बाएँ",   सा_स["बाएँ"],   १०);
    जाँच("सामग्री ऊपर (टूलबार-नीचे + अंतर)", सा_स["ऊपर"], ५८);
    जाँच("सामग्री चौड़ाई (तनाव → पूरी भीतरी)", सा_स["चौड़ाई"], ३८०);
    जाँच("सामग्री ऊँचाई (बढ़त → बचा स्थान)",  सा_स["ऊँचाई"], २३२);

    परीक्षण_समूह("चित्रण — आदेश-सूची");

    शब्दकोश अवस्था = यूआई_अवस्था_नई();
    सूची आदेश = चित्र_सूची(जड़, अवस्था);
    // २ बटन (आयत + पाठ हर एक) + १ सामग्री-आयत = ५
    जाँच("आदेश गिनती", लंबाई(आदेश), ५);
    जाँच("पहला आदेश = आयत (बटन A पृष्ठ)", आदेश[०]["आदेश"], "आयत");
    जाँच("बटन A आयत बाएँ",  आदेश[०]["क्ष"], १०);
    जाँच("बटन A आयत चौड़ाई", आदेश[०]["चौड़ाई"], ८०);
    जाँच("दूसरा आदेश = पाठ", आदेश[१]["आदेश"], "पाठ");
    जाँच("बटन A पाठ सामग्री", आदेश[१]["सामग्री"], "A");
    जाँच("अंतिम आदेश = सामग्री आयत", आदेश[४]["आदेश"], "आयत");
    जाँच("सामग्री आयत रंग", आदेश[४]["रंग"], "#111827");

    परीक्षण_समूह("घटना — hover / press / click → संदेश");

    // बटन A के ऊपर माउस
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", ५०, २५));
    जाँच("hover = बटन A", अवस्था["होवर"], "क्रिया_अ");

    // बटन A दबाओ
    घटना_भेजो(जड़, अवस्था, माउस_घटना("दबाव", ५०, २५));
    जाँच("दबा = बटन A", अवस्था["दबा"], "क्रिया_अ");
    जाँच("केंद्रित = बटन A", अवस्था["केंद्रित"], "क्रिया_अ");

    // बटन A पर छोड़ो → संदेश
    शब्दकोश फल1 = घटना_भेजो(जड़, अवस्था, माउस_घटना("छोड़", ५०, २५));
    जाँच("click संदेश", फल1["संदेश"], ["क्रिया_अ"]);
    जाँच("छोड़ के बाद दबा साफ़", अवस्था["दबा"], "");

    // बटन A दबाओ, बटन B पर छोड़ो → कोई संदेश नहीं (drag off)
    घटना_भेजो(जड़, अवस्था, माउस_घटना("दबाव", ५०, २५));
    शब्दकोश फल2 = घटना_भेजो(जड़, अवस्था, माउस_घटना("छोड़", १२०, २५));
    जाँच("drag-off → कोई संदेश नहीं", फल2["संदेश"], []);

    // रिक्ति के ऊपर (कोई क्रिया नहीं)
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", ३००, २५));
    जाँच("रिक्ति पर hover = सामग्री? नहीं — रिक्ति क्रिया-रहित", अवस्था["होवर"], "");

    // सामग्री-क्षेत्र के ऊपर (उसकी क्रिया है)
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", २००, २००));
    जाँच("सामग्री-क्षेत्र पर hover", अवस्था["होवर"], "सामग्री_क्षेत्र");

    // दायरे-बाहर
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", ९००, ९००));
    जाँच("बाहर → hover साफ़", अवस्था["होवर"], "");

    परीक्षण_समूह("hover चित्रण को बदलता");

    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", ५०, २५));   // बटन A hover
    सूची आदेश2 = चित्र_सूची(जड़, अवस्था);
    जाँच("बटन A अब hover-रंग", आदेश2[०]["रंग"], "#3b82f6");
    जाँच("बटन B अब भी सामान्य", आदेश2[२]["रंग"], "#334155");

    परत् परीक्षण_सारांश();
}
