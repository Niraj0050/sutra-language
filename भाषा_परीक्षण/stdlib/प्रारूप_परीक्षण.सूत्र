आयात "पुस्तकालय/प्रारूप.सूत्र";

कार्य मुख्य() {
    लिखतु(प्रारूप("{} + {} = {}", [२, ३, ५]));       // २ + ३ = ५
    लिखतु(प्रारूप("नाम: {}, आयु: {}", ["सूत्र", १])); // नाम: सूत्र, आयु: १
    लिखतु(प्रारूप("कोई तर्क नहीं", []));              // कोई तर्क नहीं
    लिखतु(प्रारूप("{} बचा", [१]));                    // १ बचा
    लिखतु(प्रारूप("{} {}", [१]));                     // १ {}  (कम तर्क)

    लिखतु("[" + बाएँ_संरेखित("अ", ५, ".") + "]");     // [अ....]
    लिखतु("[" + दाएँ_संरेखित("अ", ५, ".") + "]");     // [....अ]
    लिखतु("[" + मध्य_संरेखित("अ", ५, ".") + "]");     // [..अ..]

    लिखतु(हज़ार_विभाजक(१२३४५६७));                     // १,२३४,५६७
    लिखतु(हज़ार_विभाजक(-९८७६५));                      // -९८,७६५
    लिखतु(हज़ार_विभाजक(४२));                          // ४२

    लिखतु(संख्या_प्रारूप(३.१४१५९, २));                // ३.१४
    लिखतु(संख्या_प्रारूप(२.५, ०));                    // २  (गोल)
    लिखतु(संख्या_प्रारूप(०.००७, ३));                  // ०.००७
    लिखतु(प्रतिशत(०.२५, १));                          // २५.०%

    लिखतु(हेक्स(२५५));                                // ff
    लिखतु(हेक्स(४०९६));                               // १०००
    लिखतु(द्विआधारी(१०));                             // १०१०
    लिखतु(अष्टक(६४));                                 // १००
    लिखतु(आधार_में(-२५५, १६));                        // -ff

    लिखतु(आधार_से("ff", १६));                         // २५५
    लिखतु(आधार_से("1010", २));                        // १०
    लिखतु(आधार_से("-1f", १६));                        // -३१

    लिखतु(तालिका_पंक्ति(["नाम", "मान"], ६));          // "नाम    | मान   "

    लिखतु("प्रारूप परीक्षण पूरा");
}
