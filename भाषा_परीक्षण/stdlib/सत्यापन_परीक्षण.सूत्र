// भाषा_परीक्षण/stdlib/सत्यापन_परीक्षण.सूत्र
आयात "पुस्तकालय/सत्यापन.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("सत्यापन_आवश्यक");
    जाँच("रिक्त पाठ असत्य", सत्यापन_आवश्यक(""), असत्य);
    जाँच("शून्यम् असत्य", सत्यापन_आवश्यक(शून्यम्), असत्य);
    जाँच("गैर-रिक्त पाठ सत्य", सत्यापन_आवश्यक("राम"), सत्य);
    जाँच("सिर्फ़ खाली-जगह भी गैर-रिक्त गिना जाता (v1 — trim नहीं करता)", सत्यापन_आवश्यक(" "), सत्य);

    परीक्षण_समूह("सत्यापन_लंबाई_सीमा");
    जाँच("सीमा के भीतर", सत्यापन_लंबाई_सीमा("पासवर्ड१२", ३, १०), सत्य);
    जाँच("बहुत छोटा", सत्यापन_लंबाई_सीमा("अब", ३, १०), असत्य);
    जाँच("बहुत लंबा", सत्यापन_लंबाई_सीमा("बहुतलंबापाठयहाँहै", ३, ५), असत्य);
    जाँच("ठीक निचली सीमा पर", सत्यापन_लंबाई_सीमा("अबस", ३, १०), सत्य);
    जाँच("ठीक ऊपरी सीमा पर", सत्यापन_लंबाई_सीमा("अबसद", १, ४), सत्य);

    परीक्षण_समूह("सत्यापन_संख्या_सीमा");
    जाँच("सीमा के भीतर", सत्यापन_संख्या_सीमा(५०, १, १००), सत्य);
    जाँच("सीमा से बाहर (कम)", सत्यापन_संख्या_सीमा(०, १, १००), असत्य);
    जाँच("सीमा से बाहर (ज़्यादा)", सत्यापन_संख्या_सीमा(१०१, १, १००), असत्य);
    जाँच("ठीक निचली सीमा पर", सत्यापन_संख्या_सीमा(१, १, १००), सत्य);
    जाँच("ठीक ऊपरी सीमा पर", सत्यापन_संख्या_सीमा(१००, १, १००), सत्य);

    परीक्षण_समूह("सत्यापन_संख्यात्मक_है");
    जाँच("शुद्ध अंक", सत्यापन_संख्यात्मक_है("12345"), सत्य);
    जाँच("ऋणात्मक अंक", सत्यापन_संख्यात्मक_है("-42"), सत्य);
    जाँच("अक्षर-मिश्रित", सत्यापन_संख्यात्मक_है("12a45"), असत्य);
    जाँच("रिक्त पाठ", सत्यापन_संख्यात्मक_है(""), असत्य);
    जाँच("दशमलव-बिंदु वाला अस्वीकृत (सिर्फ़ पूर्णांक)", सत्यापन_संख्यात्मक_है("1.5"), असत्य);

    परीक्षण_समूह("सत्यापन_ईमेल_है");
    जाँच("मान्य साधारण ईमेल", सत्यापन_ईमेल_है("ram@example.com"), सत्य);
    जाँच("मान्य उप-डोमेन ईमेल", सत्यापन_ईमेल_है("ram.sharma@mail.example.co.in"), सत्य);
    जाँच("@ अनुपस्थित", सत्यापन_ईमेल_है("not-an-email"), असत्य);
    जाँच("डोमेन में बिंदु अनुपस्थित", सत्यापन_ईमेल_है("ram@example"), असत्य);
    जाँच("बीच में खाली-जगह", सत्यापन_ईमेल_है("ram sharma@example.com"), असत्य);
    जाँच("रिक्त पाठ", सत्यापन_ईमेल_है(""), असत्य);
    जाँच("शून्यम्", सत्यापन_ईमेल_है(शून्यम्), असत्य);

    परीक्षण_समूह("सत्यापन_भारतीय_फोन_है");
    जाँच("+91 उपसर्ग सहित", सत्यापन_भारतीय_फोन_है("+919876543210"), सत्य);
    जाँच("91 उपसर्ग सहित (बिना +)", सत्यापन_भारतीय_फोन_है("919876543210"), सत्य);
    जाँच("0 उपसर्ग सहित", सत्यापन_भारतीय_फोन_है("09876543210"), सत्य);
    जाँच("बिना उपसर्ग, 10 अंक", सत्यापन_भारतीय_फोन_है("9876543210"), सत्य);
    जाँच("6 से शुरू भी मान्य", सत्यापन_भारतीय_फोन_है("6123456789"), सत्य);
    जाँच("1 से शुरू अमान्य (6-9 नहीं)", सत्यापन_भारतीय_फोन_है("1234567890"), असत्य);
    जाँच("9 अंक — बहुत छोटा", सत्यापन_भारतीय_फोन_है("987654321"), असत्य);
    जाँच("11 अंक (उपसर्ग रहित) — बहुत लंबा", सत्यापन_भारतीय_फोन_है("98765432109"), असत्य);
    जाँच("अक्षर-मिश्रित", सत्यापन_भारतीय_फोन_है("98765abc10"), असत्य);

    परीक्षण_समूह("सत्यापन_यूआरएल_है");
    जाँच("मान्य HTTPS URL", सत्यापन_यूआरएल_है("https://example.com"), सत्य);
    जाँच("मान्य पथ/प्रश्न सहित URL", सत्यापन_यूआरएल_है("https://example.com/path?a=1"), सत्य);
    जाँच("योजना अनुपस्थित", सत्यापन_यूआरएल_है("example.com"), असत्य);
    जाँच("पूरी तरह अमान्य पाठ", सत्यापन_यूआरएल_है("यह URL नहीं है"), असत्य);

    परीक्षण_समूह("सत्यापन_पैटर्न_मेल — सामान्य escape-hatch");
    जाँच("कस्टम पैटर्न से मिलान", सत्यापन_पैटर्न_मेल("ABC-1234", "[A-Z]{3}-\\d{4}"), सत्य);
    जाँच("कस्टम पैटर्न से न मिलान", सत्यापन_पैटर्न_मेल("abc-1234", "[A-Z]{3}-\\d{4}"), असत्य);

    परीक्षण_समूह("सत्यापन_परिणाम_बनाओ / सत्यापन_त्रुटि_जोड़ो — बहु-फ़ील्ड संचयन");
    शब्दकोश फल1 = सत्यापन_परिणाम_बनाओ();
    जाँच("नया परिणाम शुरू में वैध", फल1["वैध"], सत्य);
    जाँच("नए परिणाम में कोई त्रुटि नहीं", लंबाई(फल1["त्रुटियाँ"]), ०);

    शब्दकोश फल2 = सत्यापन_परिणाम_बनाओ();
    यदि (न सत्यापन_आवश्यक("")) { सत्यापन_त्रुटि_जोड़ो(फल2, "नाम", "आवश्यक है"); }
    यदि (न सत्यापन_ईमेल_है("अमान्य")) { सत्यापन_त्रुटि_जोड़ो(फल2, "ईमेल", "प्रारूप ग़लत है"); }
    जाँच("2 त्रुटियों के बाद अवैध", फल2["वैध"], असत्य);
    जाँच("2 त्रुटियाँ जुड़ीं", लंबाई(फल2["त्रुटियाँ"]), २);
    जाँच("पहली त्रुटि का फ़ील्ड-नाम", फल2["त्रुटियाँ"][०]["फ़ील्ड"], "नाम");
    जाँच("दूसरी त्रुटि का फ़ील्ड-नाम", फल2["त्रुटियाँ"][१]["फ़ील्ड"], "ईमेल");
    जाँच("दूसरी त्रुटि का संदेश", फल2["त्रुटियाँ"][१]["संदेश"], "प्रारूप ग़लत है");

    शब्दकोश फल3 = सत्यापन_परिणाम_बनाओ();
    यदि (न सत्यापन_आवश्यक("राम")) { सत्यापन_त्रुटि_जोड़ो(फल3, "नाम", "आवश्यक है"); }
    जाँच("सभी जाँच पास होने पर वैध रहता", फल3["वैध"], सत्य);

    परत् परीक्षण_सारांश();
}
