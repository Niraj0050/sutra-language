// भाषा_परीक्षण/stdlib/क्रमित_मानचित्र_अंतर_परीक्षण.सूत्र
// यादृच्छिक अंतर-परीक्षण (differential): AVL क्रमित मानचित्र बनाम नाइव क्रमित सूची।
// अलग फ़ाइल इसलिए कि interpreter में एक ही process में heap जमा होकर धीमा पड़ता।
आयात "पुस्तकालय/क्रमित_मानचित्र.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// ===== सहायक =====

// सूची स में स्थान पर म डालकर नई सूची
कार्य सूची_में_डालो(सूची स, संख्या स्थान, मान म) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (इ == स्थान) { फल = जोड़ें(फल, म); }
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    यदि (स्थान >= लंबाई(स)) { फल = जोड़ें(फल, म); }
    परत् फल;
}

// सूची स से स्थान वाला तत्व हटाकर नई सूची
कार्य सूची_से_हटाओ(सूची स, संख्या स्थान) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (इ != स्थान) { फल = जोड़ें(फल, स[इ]); }
        इ = इ + १;
    }
    परत् फल;
}

// मॉडल: क्रमित कुंजी-सूची में पहला सूचकांक जहाँ कुं[इ] >= क (नहीं तो लंबाई)
कार्य मॉडल_स्थान(सूची कुं, मान क) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं) && कुं[इ] < क) { इ = इ + १; }
    परत् इ;
}

// Park–Miller छद्म-यादृच्छिक: [०, सीमा) का पूर्णांक
कार्य यादृ_अगला(शब्दकोश स्थिति, संख्या सीमा) {
    संख्या बीज = स्थिति["बीज"];
    बीज = (बीज * ४८२७१) % २१४७४८३६४७;
    स्थिति["बीज"] = बीज;
    परत् (बीज / ८) % सीमा;
}

// रूप ० = संख्या-कुंजी (१०००+सं), रूप १ = पाठ-कुंजी ("कुं"+सं)
कार्य कुंजी_बनाओ(संख्या रूप, संख्या सं) {
    यदि (रूप == ०) { परत् १००० + सं; }
    परत् "कुं" + सं;
}

// दो सूचियाँ (लंबाई + तत्व-वार) बराबर हैं?
कार्य सूची_बराबर(सूची अ, सूची ब) {
    यदि (लंबाई(अ) != लंबाई(ब)) { परत् असत्य; }
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        यदि (अ[इ] != ब[इ]) { परत् असत्य; }
        इ = इ + १;
    }
    परत् सत्य;
}

// ===== यादृच्छिक अंतर-परीक्षण (differential): AVL मानचित्र बनाम नाइव क्रमित सूची =====
// लौटाता: [रखो-भूल, हटाओ-भूल, फर्श/छत/पिछला/अगला-भूल, रैंक-भूल, चयन-भूल,
//          है/पाओ-भूल, जाँच-भूल, आकार-भूल, क्रम-भूल, अंतिम-आकार, अधिकतम-ऊँचाई,
//          श्रेणी-भूल]
कार्य यादृच्छिक_चलाओ(संख्या बीज, संख्या चरण_संख्या, संख्या कुंजी_सीमा, संख्या रूप) {
    शब्दकोश यादृ = {};
    यादृ["बीज"] = बीज;
    शब्दकोश म = क्रमित_बनाओ();
    सूची मकुं = [];
    सूची ममू = [];
    संख्या भूल_रखो = ०;
    संख्या भूल_हटाओ = ०;
    संख्या भूल_पड़ोसी = ०;
    संख्या भूल_रैंक = ०;
    संख्या भूल_चयन = ०;
    संख्या भूल_खोज = ०;
    संख्या भूल_जाँच = ०;
    संख्या भूल_आकार = ०;
    संख्या भूल_क्रम = ०;
    संख्या भूल_श्रेणी = ०;
    संख्या अधिकतम_ऊँचाई = ०;
    संख्या चरण = ०;
    यावत् (चरण < चरण_संख्या) {
        मान क = कुंजी_बनाओ(रूप, यादृ_अगला(यादृ, कुंजी_सीमा));
        संख्या क्रिया = यादृ_अगला(यादृ, १०);
        यदि (क्रिया < ५) {
            // रखो (नई या अद्यतन)
            संख्या स्थान = मॉडल_स्थान(मकुं, क);
            मान नई_अपेक्षित = सत्य;
            यदि (स्थान < लंबाई(मकुं)) {
                यदि (मकुं[स्थान] == क) { नई_अपेक्षित = असत्य; }
            }
            मान नई_वास्तविक = क्रमित_रखो(म, क, चरण);
            यदि (नई_वास्तविक != नई_अपेक्षित) { भूल_रखो = भूल_रखो + १; }
            यदि (नई_अपेक्षित) {
                मकुं = सूची_में_डालो(मकुं, स्थान, क);
                ममू = सूची_में_डालो(ममू, स्थान, चरण);
            } अन्यथा {
                ममू[स्थान] = चरण;
            }
        } अन्यथा यदि (क्रिया < ८) {
            // हटाओ
            संख्या ह_स्थान = मॉडल_स्थान(मकुं, क);
            मान था_अपेक्षित = असत्य;
            यदि (ह_स्थान < लंबाई(मकुं)) {
                यदि (मकुं[ह_स्थान] == क) { था_अपेक्षित = सत्य; }
            }
            मान था_वास्तविक = क्रमित_हटाओ(म, क);
            यदि (था_वास्तविक != था_अपेक्षित) { भूल_हटाओ = भूल_हटाओ + १; }
            यदि (था_अपेक्षित) {
                मकुं = सूची_से_हटाओ(मकुं, ह_स्थान);
                ममू = सूची_से_हटाओ(ममू, ह_स्थान);
            }
        } अन्यथा {
            // प्रश्न: है / पाओ / फर्श / छत / पिछला / अगला / रैंक / चयन
            मान प्र = कुंजी_बनाओ(रूप, यादृ_अगला(यादृ, कुंजी_सीमा + ८));
            मान अ_फ = शून्यम्;
            मान अ_छ = शून्यम्;
            मान अ_प = शून्यम्;
            मान अ_अ = शून्यम्;
            संख्या अ_र = ०;
            मान अ_मौजूद = असत्य;
            मान अ_मूल्य = शून्यम्;
            संख्या इ = ०;
            यावत् (इ < लंबाई(मकुं)) {
                मान कु = मकुं[इ];
                यदि (कु <= प्र) { अ_फ = कु; }
                यदि (कु < प्र) { अ_प = कु; अ_र = अ_र + १; }
                यदि (कु >= प्र && अ_छ == शून्यम्) { अ_छ = कु; }
                यदि (कु > प्र && अ_अ == शून्यम्) { अ_अ = कु; }
                यदि (कु == प्र) { अ_मौजूद = सत्य; अ_मूल्य = ममू[इ]; }
                इ = इ + १;
            }
            यदि (क्रमित_फर्श(म, प्र) != अ_फ) { भूल_पड़ोसी = भूल_पड़ोसी + १; }
            यदि (क्रमित_छत(म, प्र) != अ_छ) { भूल_पड़ोसी = भूल_पड़ोसी + १; }
            यदि (क्रमित_पिछला(म, प्र) != अ_प) { भूल_पड़ोसी = भूल_पड़ोसी + १; }
            यदि (क्रमित_अगला(म, प्र) != अ_अ) { भूल_पड़ोसी = भूल_पड़ोसी + १; }
            यदि (क्रमित_रैंक(म, प्र) != अ_र) { भूल_रैंक = भूल_रैंक + १; }
            यदि (क्रमित_है(म, प्र) != अ_मौजूद) { भूल_खोज = भूल_खोज + १; }
            यदि (क्रमित_पाओ(म, प्र) != अ_मूल्य) { भूल_खोज = भूल_खोज + १; }
            संख्या सू = यादृ_अगला(यादृ, लंबाई(मकुं) + १);
            मान अ_चयन = शून्यम्;
            यदि (सू < लंबाई(मकुं)) { अ_चयन = मकुं[सू]; }
            यदि (क्रमित_चयन(म, सू) != अ_चयन) { भूल_चयन = भूल_चयन + १; }
            // श्रेणी [प्र, प्र२] — प्र > प्र२ हो तो अपेक्षित खाली
            मान प्र२ = कुंजी_बनाओ(रूप, यादृ_अगला(यादृ, कुंजी_सीमा + ८));
            सूची अ_श्रे = [];
            संख्या इश = ०;
            यावत् (इश < लंबाई(मकुं)) {
                मान कुश = मकुं[इश];
                यदि (कुश >= प्र && कुश <= प्र२) { अ_श्रे = जोड़ें(अ_श्रे, कुश); }
                इश = इश + १;
            }
            सूची व_श्रे = क्रमित_श्रेणी(म, प्र, प्र२);
            यदि (न सूची_बराबर(व_श्रे, अ_श्रे)) { भूल_श्रेणी = भूल_श्रेणी + १; }
        }

        // हर चरण के बाद: अपरिवर्तनीयताएँ + आकार + ऊँचाई-सीमा
        यदि (न क्रमित_जाँच(म)) { भूल_जाँच = भूल_जाँच + १; }
        यदि (क्रमित_आकार(म) != लंबाई(मकुं)) { भूल_आकार = भूल_आकार + १; }
        संख्या ऊ = क्रमित_ऊँचाई(म);
        यदि (ऊ > अधिकतम_ऊँचाई) { अधिकतम_ऊँचाई = ऊ; }

        // हर २५ चरण पर: पूरा क्रम (कुंजियाँ + मूल्य) मॉडल से तत्व-वार
        यदि (चरण % २५ == ०) {
            सूची वक = क्रमित_कुंजियाँ(म);
            सूची वम = क्रमित_मूल्य(म);
            यदि (लंबाई(वक) != लंबाई(मकुं) || लंबाई(वम) != लंबाई(ममू)) {
                भूल_क्रम = भूल_क्रम + १;
            } अन्यथा {
                संख्या ज = ०;
                यावत् (ज < लंबाई(वक)) {
                    यदि (वक[ज] != मकुं[ज] || वम[ज] != ममू[ज]) { भूल_क्रम = भूल_क्रम + १; }
                    ज = ज + १;
                }
            }
        }
        चरण = चरण + १;
    }
    परत् [भूल_रखो, भूल_हटाओ, भूल_पड़ोसी, भूल_रैंक, भूल_चयन, भूल_खोज, भूल_जाँच,
          भूल_आकार, भूल_क्रम, लंबाई(मकुं), अधिकतम_ऊँचाई, भूल_श्रेणी];
}

// यादृच्छिक_चलाओ का परिणाम जाँचो (ऊँचाई-सीमा: n नोड के AVL में ऊँचाई <= सीमा)
कार्य यादृच्छिक_जाँचो(पाठ नाम, सूची र, संख्या ऊँचाई_सीमा) {
    जाँच(नाम + " — रखो-परिणाम मॉडल से मेल", र[०], ०);
    जाँच(नाम + " — हटाओ-परिणाम मॉडल से मेल", र[१], ०);
    जाँच(नाम + " — फर्श/छत/पिछला/अगला मॉडल से मेल", र[२], ०);
    जाँच(नाम + " — रैंक मॉडल से मेल", र[३], ०);
    जाँच(नाम + " — चयन मॉडल से मेल", र[४], ०);
    जाँच(नाम + " — है/पाओ मॉडल से मेल", र[५], ०);
    जाँच(नाम + " — हर चरण पर क्रमित_जाँच (BST + AVL) ठीक", र[६], ०);
    जाँच(नाम + " — आकार मॉडल से मेल", र[७], ०);
    जाँच(नाम + " — पूरा कुंजी/मूल्य क्रम मॉडल से मेल", र[८], ०);
    जाँच(नाम + " — श्रेणी [निम्न, उच्च] मॉडल से मेल", र[११], ०);
    जाँच_सत्य(नाम + " — अंतिम आकार ग़ैर-शून्य (परीक्षण सार्थक)", र[९] > ०);
    जाँच_सत्य(नाम + " — ऊँचाई AVL-सीमा के भीतर", र[१०] <= ऊँचाई_सीमा);
    परत् ०;
}

कार्य मुख्य() {
    // AVL में n नोड की ऊँचाई h हो सकती है केवल जब n >= N(h) (N: ०,१,२,४,७,१२,२०,३३,५४,८८,१४३ ...):
    // n <= ३० नोड पर h <= ६, n <= ५० पर h <= ७, n <= २४ पर h <= ६
    परीक्षण_समूह("यादृच्छिक अंतर-परीक्षण — संख्या-कुंजी, घना (३० कुंजियाँ, १२० चरण)");
    यादृच्छिक_जाँचो("संख्या-कुंजी घना (बीज १)", यादृच्छिक_चलाओ(१, १२०, ३०, ०), ६);

    परीक्षण_समूह("यादृच्छिक अंतर-परीक्षण — संख्या-कुंजी, विरल (५० कुंजियाँ, १०० चरण)");
    यादृच्छिक_जाँचो("संख्या-कुंजी विरल (बीज २)", यादृच्छिक_चलाओ(२, १००, ५०, ०), ७);

    परीक्षण_समूह("यादृच्छिक अंतर-परीक्षण — पाठ-कुंजी (२४ कुंजियाँ, ८० चरण)");
    यादृच्छिक_जाँचो("पाठ-कुंजी (बीज ३)", यादृच्छिक_चलाओ(३, ८०, २४, १), ६);

    परत् परीक्षण_सारांश();
}