// अपेक्षित मान .NET से सीधे generate किए गए (किसी की याददाश्त/किताब से नहीं):
//   MD5 / SHA-1 / HMAC-MD5 / HMAC-SHA1 — System.Security.Cryptography के वर्ग;
//   CRC-32 — .NET GZipStream का gzip-footer CRC, और एक स्वतंत्र सारणी-कार्यान्वयन (दोनों बराबर);
//   Adler-32 / FNV-1a — सूत्र की सीधी परिभाषा से, प्रकाशित vectors (Wikipedia, foobar, 123456789) से जाँची।
// RFC 2202 (HMAC) और RFC 1321 (MD5) के vectors भी शामिल; इनपुट पाठ और कच्चे बाइट्स दोनों रूप में।
आयात "पुस्तकालय/हैश.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// ===== सहायक =====

// उच्च × 65536 + निम्न — २^३१ से बड़े अपेक्षित मान बिना बड़े literal के बनाने को
कार्य स्थि(संख्या उच्च, संख्या निम्न) { परत् बाम_सरक(उच्च, १६) + निम्न; }

कार्य अक्षर_दोहराओ(पाठ अ, संख्या गिनती) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = फल + अ;
        इ = इ + १;
    }
    परत् फल;
}

// गिनती बार एक ही बाइट
कार्य बाइट_दोहराओ(संख्या बाइट_मान, संख्या गिनती) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = जोड़ें(फल, बाइट_मान);
        इ = इ + १;
    }
    परत् फल;
}

// ०, १, २, ... (मॉड २५६)
कार्य बाइट_क्रम(संख्या गिनती) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = जोड़ें(फल, इ % २५६);
        इ = इ + १;
    }
    परत् फल;
}

// (इ × ७ + ३) मॉड २५६
कार्य बाइट_पैटर्न(संख्या गिनती) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = जोड़ें(फल, (इ * ७ + ३) % २५६);
        इ = इ + १;
    }
    परत् फल;
}

// १, २, ३, ... गिनती तक
कार्य बाइट_एक_से(संख्या गिनती) {
    सूची फल = [];
    संख्या इ = १;
    यावत् (इ <= गिनती) {
        फल = जोड़ें(फल, इ);
        इ = इ + १;
    }
    परत् फल;
}

// शुद्ध-ASCII पाठ → बाइट्स (परीक्षण-स्वतंत्र; पुस्तकालय का UTF-8 एन्कोडर इस्तेमाल नहीं)
कार्य बाइट्स_पाठ_से(पाठ स) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        फल = जोड़ें(फल, अक्षर_मान(उपखंड(स, इ, इ + १)));
        इ = इ + १;
    }
    परत् फल;
}

// स[आरंभ .. अंत) की नई प्रति
कार्य सूची_खंड(सूची स, संख्या आरंभ, संख्या अंत) {
    सूची फल = [];
    संख्या इ = आरंभ;
    यावत् (इ < अंत) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    परत् फल;
}

