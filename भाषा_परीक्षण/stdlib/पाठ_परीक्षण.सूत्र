आयात "पुस्तकालय/पाठ.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    लिखतु(दोहराओ("अब", ३));             // अबअबअब
    लिखतु(बाएँ_भरो("7", ३, "0"));        // ००७
    लिखतु(दाएँ_भरो("7", ३, "-"));        // ७--
    लिखतु(उलटा_पाठ("सूत्र"));            // ्रतूस
    लिखतु(हन(है_रिक्त("   ")));          // हाँ
    लिखतु(हन(है_रिक्त("x")));            // नहीं
    लिखतु(हन(समाहित_पाठ("नमस्ते दुनिया", "दुनिया"))); // हाँ
    लिखतु(हन(समाहित_पाठ("नमस्ते", "xyz")));           // नहीं
    लिखतु(गिनो_पाठ("अ_ब_स_द", "_"));    // ३
    लिखतु(गिनो_पाठ("aaaa", "aa"));       // २
    लिखतु(बड़ा_प्रथम("hello"));          // Hello
    लिखतु(शीर्षक_रूप("hello world foo")); // Hello World Foo
    लिखतु(अक्षर_पर("सूत्र", १));          // ू  (2nd codepoint)
    लिखतु(अक्षर_पर("सूत्र", ९));          // (empty)

    सूची अल = अक्षर_सूची("abc");
    लिखतु(लंबाई(अल));                    // ३
    लिखतु(अल[१]);                        // b

    सूची पं = पंक्तियाँ("एक
दो
तीन");
    लिखतु(लंबाई(पं));                    // ३
    लिखतु(पं[२]);                        // तीन

    लिखतु(उपसर्ग_हटाओ("प्री_नाम", "प्री_")); // नाम
    लिखतु(उपसर्ग_हटाओ("नाम", "xxx"));         // नाम
    लिखतु(प्रत्यय_हटाओ("file.txt", ".txt"));  // file
    लिखतु(सब_बदलो("a.b.c.d", ".", "-"));      // a-b-c-d
    लिखतु(सब_बदलो("no change here", "z", "y")); // no change here

    लिखतु("पाठ परीक्षण पूरा");
}
