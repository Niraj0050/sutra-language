// भाषा_परीक्षण/stdlib/एचएमएसी_परीक्षण.सूत्र
आयात "पुस्तकालय/एचएमएसी.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    // सभी अपेक्षित मान .NET के System.Security.Cryptography.HMACSHA256 से
    // सीधे generate किए गए (PowerShell script), किसी की याददाश्त/RFC से
    // हाथ से टाइप नहीं — एसएचए256.सूत्र की अपनी सत्यापन-पद्धति जैसा ही।
    परीक्षण_समूह("एचएमएसी_एसएचए256 — .NET HMACSHA256 के विरुद्ध सत्यापित");

    जाँच("साधारण कुंजी + संदेश",
        एचएमएसी_एसएचए256("key", "The quick brown fox jumps over the lazy dog"),
        "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8");

    जाँच("रिक्त कुंजी + रिक्त संदेश",
        एचएमएसी_एसएचए256("", ""),
        "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad");

    जाँच("एक-अक्षर कुंजी + एक-अक्षर संदेश",
        एचएमएसी_एसएचए256("a", "b"),
        "08de329931e295683776aa9a43529bd0b275286df3160300c49ba4e841833013");

    परीक्षण_समूह("कुंजी-लंबाई की सीमाएँ (RFC 2104 §2 का key-adjustment)");

    पाठ कुंजी_64 = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    जाँच("ठीक ब्लॉक-आकार (64 बाइट) कुंजी — लंबाई सत्यापन", लंबाई(कुंजी_64), ६४);
    जाँच("ठीक ब्लॉक-आकार कुंजी",
        एचएमएसी_एसएचए256(कुंजी_64, "block-size key"),
        "583b57d21102022e06644b99c848dba9cdbc17806ac4923adc1016e91d3911e4");

    पाठ कुंजी_100 = "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy";
    जाँच("ब्लॉक-आकार से बड़ी (100 बाइट) कुंजी — लंबाई सत्यापन", लंबाई(कुंजी_100), १००);
    जाँच("ब्लॉक-आकार से बड़ी कुंजी (पहले हैश होती — अलग कोड-पथ)",
        एचएमएसी_एसएचए256(कुंजी_100, "over-block-size key gets hashed first"),
        "18547a021a0213a1f5ea83064931bff8f68bb67142a8594afc2360fdacb52eb4");

    परीक्षण_समूह("बहु-ब्लॉक संदेश (SHA-256 के 64-बाइट ब्लॉक से बड़ा)");
    जाँच("लंबा संदेश",
        एचएमएसी_एसएचए256("secret", "message spanning more than one 64-byte SHA-256 block to exercise multi-block hashing inside HMAC 0123456789 0123456789 0123456789 0123456789"),
        "1ea15be6acbe56fc60d71dc9e25e103de576063be5872f1df445429beee2f63a");

    परीक्षण_समूह("गुण (properties) — किसी बाहरी संदर्भ की ज़रूरत नहीं");
    जाँच("आउटपुट सदा 64 hex-अक्षर", लंबाई(एचएमएसी_एसएचए256("किसी भी लंबाई की कुंजी", "किसी भी लंबाई का संदेश")), ६४);
    जाँच("नियतात्मक — वही इनपुट = वही आउटपुट",
        एचएमएसी_एसएचए256("k", "m"), एचएमएसी_एसएचए256("k", "m"));
    जाँच("अलग कुंजी अलग परिणाम",
        एचएमएसी_एसएचए256("k1", "m") == एचएमएसी_एसएचए256("k2", "m"), असत्य);
    जाँच("अलग संदेश अलग परिणाम",
        एचएमएसी_एसएचए256("k", "m1") == एचएमएसी_एसएचए256("k", "m2"), असत्य);
    जाँच("HMAC(k,m) साधारण SHA-256(k+m) जैसा नहीं (असली construction चल रहा)",
        एचएमएसी_एसएचए256("k", "m") == एसएचए256_हैश("k" + "m"), असत्य);

    परीक्षण_समूह("बहु-बाइट UTF-8 (देवनागरी) कुंजी/संदेश — केवल क्रैश न होना जाँचा");
    पाठ देव_परिणाम = एचएमएसी_एसएचए256("गुप्त कुंजी", "नमस्ते सूत्र");
    जाँच("देवनागरी इनपुट पर भी 64 hex-अक्षर आउटपुट", लंबाई(देव_परिणाम), ६४);
    जाँच("नियतात्मक (देवनागरी इनपुट पर भी)", एचएमएसी_एसएचए256("गुप्त कुंजी", "नमस्ते सूत्र"), देव_परिणाम);

    परत् परीक्षण_सारांश();
}
