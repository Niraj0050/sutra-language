// भाषा_परीक्षण/stdlib/सीएसवी_परीक्षण.सूत्र
आयात "पुस्तकालय/सीएसवी.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("पार्स — सरल");
    जाँच("2×2", सीएसवी_पार्स("a,b\n1,2"), [["a", "b"], ["1", "2"]]);
    जाँच("trailing newline", सीएसवी_पार्स("a,b\n1,2\n"), [["a", "b"], ["1", "2"]]);
    जाँच("CRLF", सीएसवी_पार्स("a,b\r\n1,2\r\n"), [["a", "b"], ["1", "2"]]);
    जाँच("एक क्षेत्र", सीएसवी_पार्स("अकेला"), [["अकेला"]]);
    जाँच("खाली क्षेत्र", सीएसवी_पार्स("a,,c"), [["a", "", "c"]]);
    जाँच("अंत में खाली", सीएसवी_पार्स("a,b,"), [["a", "b", ""]]);
    जाँच("रिक्त स्रोत", सीएसवी_पार्स(""), []);

    परीक्षण_समूह("पार्स — उद्धृत क्षेत्र");
    जाँच("उद्धृत comma", सीएसवी_पार्स("\"अ, ब\",ग"), [["अ, ब", "ग"]]);
    जाँच("उद्धृत newline", सीएसवी_पार्स("\"पंक्ति1\nपंक्ति2\",x"), [["पंक्ति1\nपंक्ति2", "x"]]);
    जाँच("escaped quote", सीएसवी_पार्स("\"वह \"\"बड़ा\"\" है\""), [["वह \"बड़ा\" है"]]);
    जाँच("उद्धृत खाली", सीएसवी_पार्स("\"\",\"\""), [["", ""]]);
    जाँच("मिश्रित", सीएसवी_पार्स("नाम,टिप्पणी\nराम,\"अच्छा, बहुत\"\nश्याम,ठीक"),
        [["नाम", "टिप्पणी"], ["राम", "अच्छा, बहुत"], ["श्याम", "ठीक"]]);

    परीक्षण_समूह("पार्स — सीमांकक विकल्प");
    जाँच("TSV", सीएसवी_पार्स_सीमांकक("a\tb\n1\t2", "\t"), [["a", "b"], ["1", "2"]]);
    जाँच("semicolon", सीएसवी_पार्स_सीमांकक("a;b;c", ";"), [["a", "b", "c"]]);

    परीक्षण_समूह("शब्दकोश-पार्स");
    सूची लोग = सीएसवी_शब्दकोश_पार्स("नाम,आयु\nराम,30\nश्याम,25");
    जाँच("2 रो", लंबाई(लोग), २);
    जाँच("रो 0 नाम", लोग[०]["नाम"], "राम");
    जाँच("रो 0 आयु", लोग[०]["आयु"], "30");
    जाँच("रो 1 नाम", लोग[१]["नाम"], "श्याम");
    // कम क्षेत्र वाली पंक्ति → बचे हेडर "" पाते
    सूची छोटा = सीएसवी_शब्दकोश_पार्स("a,b,c\n1,2");
    जाँच("कम क्षेत्र → खाली", छोटा[०]["c"], "");
    जाँच("रिक्त → []", सीएसवी_शब्दकोश_पार्स(""), []);

    परीक्षण_समूह("बनाओ");
    जाँच("सरल", सीएसवी_बनाओ([["अ", "ब"], ["1", "2"]]), "अ,ब\r\n1,2\r\n");
    जाँच("comma quote", सीएसवी_बनाओ([["2,3"]]), "\"2,3\"\r\n");
    जाँच("quote escape", सीएसवी_बनाओ([["वह \"x\""]]), "\"वह \"\"x\"\"\"\r\n");
    जाँच("newline quote", सीएसवी_बनाओ([["a\nb"]]), "\"a\nb\"\r\n");
    जाँच("सादा नहीं उद्धृत", सीएसवी_बनाओ([["सादा"]]), "सादा\r\n");
    जाँच("TSV बनाओ", सीएसवी_बनाओ_सीमांकक([["a", "b"]], "\t"), "a\tb\r\n");

    परीक्षण_समूह("शब्दकोश-बनाओ");
    सूची रो_सूची = [];
    शब्दकोश र1 = {}; र1["नाम"] = "राम"; र1["आयु"] = "30";
    शब्दकोश र2 = {}; र2["नाम"] = "श्याम"; र2["आयु"] = "25";
    रो_सूची = जोड़ें(रो_सूची, र1);
    रो_सूची = जोड़ें(रो_सूची, र2);
    जाँच("शब्दकोश → CSV", सीएसवी_शब्दकोश_बनाओ(रो_सूची, ["नाम", "आयु"]),
        "नाम,आयु\r\nराम,30\r\nश्याम,25\r\n");

    परीक्षण_समूह("round-trip");
    पाठ मूल = "नाम,टिप्पणी\nराम,\"अच्छा, बहुत\"\nश्याम,\"रेखा1\nरेखा2\"";
    सूची पार्स1 = सीएसवी_पार्स(मूल);
    पाठ बना = सीएसवी_बनाओ(पार्स1);
    सूची पार्स2 = सीएसवी_पार्स(बना);
    जाँच("पार्स → बनाओ → पार्स स्थिर", पार्स2, पार्स1);

    परत् परीक्षण_सारांश();
}
