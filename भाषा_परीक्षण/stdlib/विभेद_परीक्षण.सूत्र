// दो सूचियाँ (लंबाई + तत्व-वार) बराबर हैं?
कार्य सूची_बराबर(सूची अ, सूची ब) {
    यदि (लंबाई(अ) != लंबाई(ब)) { परत् असत्य; }
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        यदि (अ[इ] != ब[इ]) { परत् असत्य; }
        इ = इ + १;
    }
    परत् सत्य;
}

// edit-script → "=१ -२ +३" जैसा संक्षिप्त पाठ (तुलना के लिए)
कार्य ओप_दिखाओ(सूची ओप) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(ओप)) {
        सूची जोड़ी = ओप[इ];
        यदि (इ > ०) { फल = फल + " "; }
        फल = फल + जोड़ी[०] + जोड़ी[१];
        इ = इ + १;
    }
    परत् फल;
}

// छोटा, बड़ा का (क्रम बनाए रखने वाला) उप-अनुक्रम है? (greedy)
कार्य है_उपअनुक्रम(सूची छोटा, सूची बड़ा) {
    संख्या ज = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(बड़ा)) {
        यदि (ज < लंबाई(छोटा) && बड़ा[इ] == छोटा[ज]) { ज = ज + १; }
        इ = इ + १;
    }
    परत् ज == लंबाई(छोटा);
}

// पाठ → कोडबिंदुओं की सूची (पुस्तकालय से स्वतंत्र)
कार्य कोड_सूची(पाठ स) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        फल = जोड़ें(फल, अक्षर_मान(उपखंड(स, इ, इ + १)));
        इ = इ + १;
    }
    परत् फल;
}

// LCS: लौटाया अनुक्रम दोनों का उप-अनुक्रम हो और लंबाई अपेक्षित (brute-force) के बराबर
कार्य जाँच_एलसीएस(पाठ नाम, सूची अ, सूची ब, संख्या अपेक्षित) {
    सूची एल = साझा_अनुक्रम_सूची(अ, ब);
    जाँच(नाम + " — लंबाई", लंबाई(एल), अपेक्षित);
    जाँच_सत्य(नाम + " — दोनों का उप-अनुक्रम", है_उपअनुक्रम(एल, अ) && है_उपअनुक्रम(एल, ब));
    जाँच(नाम + " — साझा_अनुक्रम_लंबाई_सूची", साझा_अनुक्रम_लंबाई_सूची(अ, ब), अपेक्षित);
    परत् ०;
}

कार्य जाँच_एलसीएस_पाठ(पाठ नाम, पाठ अ, पाठ ब, संख्या अपेक्षित) {
    पाठ एल = साझा_अनुक्रम(अ, ब);
    सूची एल_कोड = कोड_सूची(एल);
    जाँच(नाम + " — लंबाई (कोडबिंदु)", लंबाई(एल_कोड), अपेक्षित);
    जाँच_सत्य(नाम + " — दोनों का उप-अनुक्रम", है_उपअनुक्रम(एल_कोड, कोड_सूची(अ)) && है_उपअनुक्रम(एल_कोड, कोड_सूची(ब)));
    जाँच(नाम + " — साझा_अनुक्रम_लंबाई", साझा_अनुक्रम_लंबाई(अ, ब), अपेक्षित);
    परत् ०;
}

// diff के गुण: पुराना/नया फिर बनते, बदलाव-संख्या न्यूनतम, बदलाव-खंड में "+" के तुरंत बाद "-" नहीं
कार्य जाँच_ओप(पाठ नाम, सूची अ, सूची ब, संख्या न्यूनतम) {
    सूची ओप = विभेद_सूची(अ, ब);
    संख्या इ = १;
    संख्या क्रम_भंग = ०;
    यावत् (इ < लंबाई(ओप)) {
        सूची पिछला = ओप[इ - १];
        सूची अभी = ओप[इ];
        यदि (पिछला[०] == "+" && अभी[०] == "-") { क्रम_भंग = क्रम_भंग + १; }
        इ = इ + १;
    }
    जाँच_सत्य(नाम + " — पुराना/नया फिर बनते, बदलाव-संख्या न्यूनतम, हर खंड में − पहले",
        सूची_बराबर(विभेद_से_पुराना(ओप), अ) && सूची_बराबर(विभेद_से_नया(ओप), ब)
        && विभेद_बदलाव_गिनती(ओप) == न्यूनतम && क्रम_भंग == ०);
    परत् ०;
}

