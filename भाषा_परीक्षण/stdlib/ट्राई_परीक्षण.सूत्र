// भाषा_परीक्षण/stdlib/ट्राई_परीक्षण.सूत्र
आयात "पुस्तकालय/ट्राई.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("मूल जोड़ो/है — खाली ट्राई");
    शब्दकोश ज1 = ट्राई_बनाओ();
    जाँच("खाली ट्राई में कुछ नहीं", ट्राई_है(ज1, "कुछ"), असत्य);
    जाँच("खाली ट्राई का उपसर्ग भी नहीं", ट्राई_उपसर्ग_है(ज1, "क"), असत्य);
    जाँच("खाली ट्राई के सारे शब्द रिक्त सूची", ट्राई_सभी_शब्द(ज1), []);

    परीक्षण_समूह("जोड़ो/है — साधारण मामले (ASCII)");
    शब्दकोश ज2 = ट्राई_बनाओ();
    ट्राई_जोड़ो(ज2, "cat");
    ट्राई_जोड़ो(ज2, "car");
    ट्राई_जोड़ो(ज2, "card");
    ट्राई_जोड़ो(ज2, "care");
    ट्राई_जोड़ो(ज2, "dog");
    जाँच("पूरा शब्द मिलता (car)", ट्राई_है(ज2, "car"), सत्य);
    जाँच("पूरा शब्द मिलता (card)", ट्राई_है(ज2, "card"), सत्य);
    जाँच("पूरा शब्द मिलता (dog)", ट्राई_है(ज2, "dog"), सत्य);
    जाँच("सिर्फ़ उपसर्ग पूरा शब्द नहीं (ca)", ट्राई_है(ज2, "ca"), असत्य);
    जाँच("न जोड़ा गया शब्द नहीं मिलता", ट्राई_है(ज2, "cats"), असत्य);
    जाँच("पूरी तरह अलग शब्द नहीं मिलता", ट्राई_है(ज2, "xyz"), असत्य);
    जाँच("रिक्त पाठ नहीं मिलता", ट्राई_है(ज2, ""), असत्य);

    परीक्षण_समूह("उपसर्ग_है");
    जाँच("वैध उपसर्ग (ca)", ट्राई_उपसर्ग_है(ज2, "ca"), सत्य);
    जाँच("वैध उपसर्ग (car)", ट्राई_उपसर्ग_है(ज2, "car"), सत्य);
    जाँच("वैध उपसर्ग (d)", ट्राई_उपसर्ग_है(ज2, "d"), सत्य);
    जाँच("अवैध उपसर्ग (z)", ट्राई_उपसर्ग_है(ज2, "z"), असत्य);
    जाँच("पूरा शब्द भी उपसर्ग गिनता", ट्राई_उपसर्ग_है(ज2, "card"), सत्य);
    जाँच("रिक्त उपसर्ग हमेशा सत्य (ग़ैर-खाली ट्राई में)", ट्राई_उपसर्ग_है(ज2, ""), सत्य);

    परीक्षण_समूह("उपसर्ग_वाले — वर्णानुक्रम में");
    सूची कार_शब्द = ट्राई_उपसर्ग_वाले(ज2, "car");
    जाँच("तीन शब्द मिलते", लंबाई(कार_शब्द), ३);
    जाँच("पहला car (वर्णानुक्रम)", कार_शब्द[०], "car");
    जाँच("दूसरा card", कार_शब्द[१], "card");
    जाँच("तीसरा care", कार_शब्द[२], "care");
    जाँच("अवैध उपसर्ग रिक्त सूची देता", ट्राई_उपसर्ग_वाले(ज2, "xyz"), []);
    जाँच("रिक्त उपसर्ग = सारे शब्द", लंबाई(ट्राई_उपसर्ग_वाले(ज2, "")), ५);

    परीक्षण_समूह("सभी_शब्द — वर्णानुक्रम में पूरी सूची");
    सूची सब = ट्राई_सभी_शब्द(ज2);
    जाँच("पाँचों शब्द मिलते", लंबाई(सब), ५);
    जाँच("पूरी सूची सही क्रम में", सब[०], "car");
    जाँच("...", सब[१], "card");
    जाँच("...", सब[२], "care");
    जाँच("...", सब[३], "cat");
    जाँच("आखिरी dog", सब[४], "dog");

    परीक्षण_समूह("बहु-बाइट UTF-8 (देवनागरी) शब्द");
    शब्दकोश ज3 = ट्राई_बनाओ();
    ट्राई_जोड़ो(ज3, "नमस्ते");
    ट्राई_जोड़ो(ज3, "नमन");
    ट्राई_जोड़ो(ज3, "सूत्र");
    जाँच("देवनागरी शब्द मिलता", ट्राई_है(ज3, "नमस्ते"), सत्य);
    जाँच("देवनागरी उपसर्ग", ट्राई_उपसर्ग_है(ज3, "नम"), सत्य);
    जाँच("असंबंधित देवनागरी उपसर्ग नहीं", ट्राई_उपसर्ग_है(ज3, "समय"), असत्य);
    सूची नम_शब्द = ट्राई_उपसर्ग_वाले(ज3, "नम");
    जाँच("दोनों 'नम' वाले शब्द मिलते", लंबाई(नम_शब्द), २);
    जाँच("वर्णानुक्रम — नमन पहले", नम_शब्द[०], "नमन");
    जाँच("वर्णानुक्रम — नमस्ते बाद में", नम_शब्द[१], "नमस्ते");

    परीक्षण_समूह("हटाओ — बिना ज़रूरत के काटे (pruning) की जाँच");
    शब्दकोश ज4 = ट्राई_बनाओ();
    ट्राई_जोड़ो(ज4, "car");
    ट्राई_जोड़ो(ज4, "card");
    जाँच("हटाने से पहले car मौजूद", ट्राई_है(ज4, "car"), सत्य);
    जाँच("हटाओ लौटाता सत्य (मौजूद था)", ट्राई_हटाओ(ज4, "car"), सत्य);
    जाँच("हटाने के बाद car नहीं मिलता", ट्राई_है(ज4, "car"), असत्य);
    जाँच("card अछूता रहा (साझा उपसर्ग वाला दूसरा शब्द)", ट्राई_है(ज4, "card"), सत्य);
    जाँच("'ca' उपसर्ग अब भी मान्य (card अब भी मौजूद)", ट्राई_उपसर्ग_है(ज4, "ca"), सत्य);
    जाँच("न-मौजूद शब्द हटाने पर असत्य", ट्राई_हटाओ(ज4, "xyz"), असत्य);

    परीक्षण_समूह("हटाओ — असली छँटाई (कोई साझा उपसर्ग न हो तो)");
    शब्दकोश ज5 = ट्राई_बनाओ();
    ट्राई_जोड़ो(ज5, "अकेला");
    जाँच("हटाने से पहले उपसर्ग मान्य", ट्राई_उपसर्ग_है(ज5, "अके"), सत्य);
    ट्राई_हटाओ(ज5, "अकेला");
    जाँच("हटाने के बाद उपसर्ग भी अमान्य (कुछ और इस्तेमाल नहीं करता)", ट्राई_उपसर्ग_है(ज5, "अके"), असत्य);
    जाँच("हटाने के बाद ट्राई पूरी तरह खाली", ट्राई_सभी_शब्द(ज5), []);

    परीक्षण_समूह("दोहराव — एक ही शब्द दो बार जोड़ो");
    शब्दकोश ज6 = ट्राई_बनाओ();
    ट्राई_जोड़ो(ज6, "बार");
    ट्राई_जोड़ो(ज6, "बार");
    जाँच("दोहराव से सूची में सिर्फ़ एक बार गिना जाता", लंबाई(ट्राई_सभी_शब्द(ज6)), १);

    परत् परीक्षण_सारांश();
}
