आयात "पुस्तकालय/क्रमचय.सूत्र";
आयात "पुस्तकालय/ढेर_प्राथमिकता.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // क्रमचय
    सूची प = क्रमचय([१, २, ३]);
    लिखतु(लंबाई(प));                  // ६
    लिखतु(प[०][०]); लिखतु(प[०][१]); लिखतु(प[०][२]); // १ २ ३

    सूची पर = क्रमचय_र([१, २, ३], २);
    लिखतु(लंबाई(पर));                 // ६
    लिखतु(लंबाई(पर[०]));              // २

    // संचय
    सूची स = संचय([१, २, ३, ४], २);
    लिखतु(लंबाई(स));                  // ६
    लिखतु(संचय([१, २, ३], ३)[०][२]);  // ३
    लिखतु(लंबाई(संचय([१, २], ५)));    // ०

    // घात-समुच्चय
    सूची घ = घात_समुच्चय([१, २, ३]);
    लिखतु(लंबाई(घ));                  // ८
    लिखतु(लंबाई(घ[०]));               // ०  (रिक्त उपसमुच्चय)

    // कार्तीय गुणन
    सूची क = कार्तीय_गुणन([[१, २], [३, ४]]);
    लिखतु(लंबाई(क));                  // ४
    लिखतु(क[०][०]); लिखतु(क[०][१]);   // १ ३
    लिखतु(क[३][०]); लिखतु(क[३][१]);   // २ ४

    // विंडो / लगातार जोड़े
    सूची व = विंडो([१, २, ३, ४, ५], ३);
    लिखतु(लंबाई(व));                  // ३
    लिखतु(व[२][०]); लिखतु(व[२][२]);   // ३ ५
    सूची लज = लगातार_जोड़े([१०, २०, ३०]);
    लिखतु(लंबाई(लज));                 // २
    लिखतु(लज[१][०]); लिखतु(लज[१][१]); // २० ३०

    // गिनती सहित
    सूची ग = गिनती_सहित(["अ", "ब", "स"]);
    लिखतु(ग[१][०]); लिखतु(ग[१][१]);   // १ ब

    // ===== ढेर_प्राथमिकता =====
    मान पप = नवीन ढेर_प्राथमिकता();
    पप.डालो(५); पप.डालो(१); पप.डालो(९); पप.डालो(३); पप.डालो(७);
    लिखतु(पप.शिखर());               // १
    लिखतु(पप.आकार());               // ५
    लिखतु(पप.निकालो());             // १
    लिखतु(पप.निकालो());             // ३
    लिखतु(पप.निकालो());             // ५
    लिखतु(पप.आकार());               // २
    लिखतु(हन(पप.खाली_है()));         // नहीं

    // ढेर-सॉर्ट
    सूची हक = ढेर_क्रम([४, १, ८, २, ९, ३, ७]);
    लिखतु(हक[०]); लिखतु(हक[६]);       // १ ९
    लिखतु(लंबाई(हक));                // ७

    // पाठ पर भी (सामान्य_* से)
    सूची पक = ढेर_क्रम(["सेब", "आम", "केला"]);
    लिखतु(पक[०]);                    // आम

    लिखतु("क्रमचय परीक्षण पूरा");
}
