आयात "पुस्तकालय/गणित.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // पूर्णांक उपयोगिताएँ
    लिखतु(पूर्ण_निरपेक्ष(-७));       // ७
    लिखतु(चिह्न(-३)); लिखतु(चिह्न(०)); लिखतु(चिह्न(९)); // -१ ० १
    लिखतु(परिसीमन(१५, ०, १०));      // १०
    लिखतु(परिसीमन(-२, ०, १०));      // ०
    लिखतु(हन(सम_है(४))); लिखतु(हन(विषम_है(४))); // हाँ नहीं
    लिखतु(पूर्णांक_भाग(-७, २));      // -४
    लिखतु(गणित_शेष(-७, ३));         // २
    लिखतु(घातांक(२, १०));           // १०२४

    // संख्या-सिद्धांत
    लिखतु(गसो(४८, १८));            // ६
    लिखतु(लसो(४, ६));             // १२
    लिखतु(गुणनखंड(६));            // ७२०
    लिखतु(हन(अभाज्य_है(९७)));      // हाँ
    लिखतु(हन(अभाज्य_है(९१)));      // नहीं  (७×१३)
    सूची गु = अभाज्य_गुणनखंड(३६०);   // [२,२,२,३,३,५]
    लिखतु(लंबाई(गु));              // ६
    लिखतु(गु[०]); लिखतु(गु[५]);    // २ ५
    लिखतु(लंबाई(अभाज्य_तक(२०)));   // ८
    लिखतु(फिबोनाची(१०));          // ५५

    // सांख्यिकी
    सूची द = [४, ८, ६, ५, ३, ७];
    लिखतु(औसत(द));                // ५  (३३/६ पूर्णांक भाग)
    लिखतु(माध्यिका([१, ३, ३, ६, ७, ८, ९])); // ६
    लिखतु(माध्यिका([१, २, ३, ४])); // २  ((२+३)/२ पूर्णांक)
    लिखतु(बहुलक([१, २, २, ३, २, १])); // २
    लिखतु(परिसर([४, ८, ६, ५, ३, ७])); // ५

    // PRNG — नियतात्मक (बीज सेट)
    यादृच्छिक_बीज(४२);
    संख्या र1 = यादृच्छिक_अगला();
    यादृच्छिक_बीज(४२);
    संख्या र2 = यादृच्छिक_अगला();
    लिखतु(हन(र1 == र2));          // हाँ  (एक ही बीज → एक ही क्रम)

    यादृच्छिक_बीज(१);
    संख्या प = यादृच्छिक_परास(१, ६);
    लिखतु(हन(प >= १ && प <= ६));   // हाँ

    यादृच्छिक_बीज(७);
    सूची मूल = [१, २, ३, ४, ५];
    सूची फ = फेंटो(मूल);
    लिखतु(लंबाई(फ));              // ५
    लिखतु(लंबाई(मूल));            // ५  (मूल अछूती)
    // फेंटी सूची में वही तत्व (योग समान)
    मान य1 = ०; मान य2 = ०;
    संख्या इ = ०;
    यावत् (इ < ५) { य1 = य1 + मूल[इ]; य2 = य2 + फ[इ]; इ = इ + १; }
    लिखतु(हन(य1 == य2));          // हाँ

    लिखतु("गणित परीक्षण पूरा");
}
