// Standard Library test for Sutra

लिखतु("=== Standard Library Test ===");

// १. Math Functions
मान परिणाम_वर्ग = वर्गमूल(१६);
लिखतु("वर्गमूल(16):");
लिखतु(परिणाम_वर्ग);

मान पावर = घात(२, ३);
लिखतु("घात(2, 3):");
लिखतु(पावर);

मान निर = निरपेक्ष(-४२);
लिखतु("निरपेक्ष(-42):");
लिखतु(निर);

मान कम = न्यूनतम(१५, ८);
लिखतु("न्यूनतम(15, 8):");
लिखतु(कम);

मान अधिक = अधिकतम(१५, ८);
लिखतु("अधिकतम(15, 8):");
लिखतु(अधिक);

// २. String & List Functions
मान नाम = "Sutra";
मान ल = लंबाई(नाम);
लिखतु("लंबाई(Sutra):");
लिखतु(ल);

मान अप = उच्च(नाम);
लिखतु("उच्च(Sutra):");
लिखतु(अप);

मान डाउन = निम्न(नाम);
लिखतु("निम्न(Sutra):");
लिखतु(डाउन);

मान प्रकार_नाम = प्रकार(नाम);
लिखतु("प्रकार(Sutra):");
लिखतु(प्रकार_नाम);

// ३. List operations
मान सूची1 = [१०, २०];
मान सूची2 = जोड़ें(सूची1, ३०);
लिखतु("जोड़ें([10, 20], 30) लंबाई:");
लिखतु(लंबाई(सूची2));
