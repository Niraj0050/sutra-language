// भाषा_परीक्षण/परिसंस्था_परीक्षण.सूत्र
// ============================================================
// दशम चरण (Phase 10): सूत्र तंत्रज्ञान परिसंस्था (Sutra Technology Ecosystem)
// १. सूत्र_आधार (Sutra-Adhar NoSQL DB, Karaka Index, ACID Transactions)
// २. सूत्र_जाल (Sutra-Jal Semantic Web Router & API Engine)
// ३. सूत्र_भार (Sutra-Bhar Package Engine, SemVer, DAG Dependency Resolver)
// ============================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  सूत्र तंत्रज्ञान परिसंस्था (Phase 10 Technology Ecosystem) परीक्षण");
    लिखतु("============================================================\n");

    // ------------------------------------------------------------
    // परीक्षण १: सूत्र_आधार (NoSQL DB & CRUD)
    // ------------------------------------------------------------
    लिखतु("--- परीक्षण १: सूत्र_आधार (NoSQL DB & CRUD) ---");
    शब्दकोश आधार = आधार_बनाओ("ज्ञान_कोष");

    शब्दकोश दस्ता१ = {};
    दस्ता१["शीर्षक"] = "रामायण";
    दस्ता१["वाक्य"] = "पुस्तकेन रामः विद्यालये ज्ञानम् अर्जयति";
    दस्ता१["वर्ष"] = "प्राचीन";
    संख्या आईडी१ = आधार_डालो(आधार, "ग्रंथ", दस्ता१);

    सत्यापित_करो(आईडी१ == १, "दस्तावेज़ स्वतः आईडी आवंटन (१)");

    शब्दकोश प्राप्त१ = आधार_आईडी_से_पाओ(आधार, "ग्रंथ", १);
    सत्यापित_करो(प्राप्त१ != शून्यम्, "आईडी १ से दस्तावेज़ प्राप्ति");
    सत्यापित_करो(प्राप्त१["शीर्षक"] == "रामायण", "दस्तावेज़ शीर्षक सत्यापन");

    सूची खोज_फल = आधार_खोज(आधार, "ग्रंथ", "वर्ष", "प्राचीन");
    सत्यापित_करो(लंबाई(खोज_फल) == १, "गुणधर्म खोज परिणाम लंबाई १");
    लिखतु("  [सफल] सूत्र_आधार CRUD एवं दस्तावेज़ संग्रह सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण २: सूत्र_आधार पाणिनीय कारक अर्थगत अनुक्रमणिका
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण २: सूत्र_आधार पाणिनीय कारक अर्थगत अनुक्रमणिका ---");
    // "पुस्तकेन रामः विद्यालये ज्ञानम् अर्जयति" में कर्ता="रामः", कर्म="ज्ञानम्", अधिकरण="विद्यालये"
    सूची राम_आईडी_सूची = आधार_कारक_खोज(आधार, "कर्ता", "रामः");
    सत्यापित_करो(लंबाई(राम_आईडी_सूची) == १, "कारक अनुक्रमणिका कर्ता='रामः' खोज सफल");
    सत्यापित_करो(राम_आईडी_सूची[०] == १, "कारक अनुक्रमणिका से प्राप्त आईडी १");

    सूची अधिकरण_सूची = आधार_कारक_खोज(आधार, "अधिकरण", "विद्यालये");
    सत्यापित_करो(लंबाई(अधिकरण_सूची) == १, "कारक अनुक्रमणिका अधिकरण='विद्यालये' खोज सफल");
    लिखतु("  [सफल] पाणिनीय कारक अर्थगत अनुक्रमणिका १००% अचूक।");

    // ------------------------------------------------------------
    // परीक्षण ३: सूत्र_आधार ACID ट्रांजैक्शन एवं रोलबैक
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ३: सूत्र_आधार ACID ट्रांजैक्शन एवं रोलबैक ---");
    // सत्र १: रोलबैक (प्रत्यावर्तन) परीक्षण
    आधार_सत्र_शुरू(आधार);
    शब्दकोश अस्थायी_दस्ता = {};
    अस्थायी_दस्ता["शीर्षक"] = "अस्थायी_ग्रंथ";
    संख्या अस्थायी_आईडी = आधार_डालो(आधार, "ग्रंथ", अस्थायी_दस्ता);

    शब्दकोश जाँच_अस्थायी = आधार_आईडी_से_पाओ(आधार, "ग्रंथ", अस्थायी_आईडी);
    सत्यापित_करो(जाँच_अस्थायी != शून्यम्, "सत्र के दौरान अस्थायी दस्तावेज़ उपस्थित");

    // प्रत्यावर्तन (Rollback)
    आधार_सत्र_प्रत्यावर्तन(आधार);
    शब्दकोश जाँच_रोलबैक = आधार_आईडी_से_पाओ(आधार, "ग्रंथ", अस्थायी_आईडी);
    सत्यापित_करो(जाँच_रोलबैक == शून्यम्, "प्रत्यावर्तन (Rollback) पश्चात दस्तावेज़ विलोपित");

    // सत्र २: कमिट (प्रतिबद्ध) परीक्षण
    आधार_सत्र_शुरू(आधार);
    शब्दकोश स्थायी_दस्ता = {};
    स्थायी_दस्ता["शीर्षक"] = "महाभारत";
    स्थायी_दस्ता["वर्ष"] = "प्राचीन";
    संख्या स्थायी_आईडी = आधार_डालो(आधार, "ग्रंथ", स्थायी_दस्ता);
    आधार_सत्र_प्रतिबद्ध(आधार);

    शब्दकोश जाँच_स्थायी = आधार_आईडी_से_पाओ(आधार, "ग्रंथ", स्थायी_आईडी);
    सत्यापित_करो(जाँच_स्थायी != शून्यम्, "प्रतिबद्ध (Commit) पश्चात दस्तावेज़ सुरक्षित");
    लिखतु("  [सफल] सूत्र_आधार ACID ट्रांजैक्शन एवं रोलबैक सफल।");

    // ------------------------------------------------------------
    // परीक्षण ४: सूत्र_आधार जेसन संचयन एवं पुनर्भारण
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ४: सूत्र_आधार जेसन संचयन एवं पुनर्भारण ---");
    पाठ जेसन_डेटा = आधार_निर्यात_जेसन(आधार);
    सत्यापित_करो(लंबाई(जेसन_डेटा) > ०, "डेटाबेस जेसन निर्यात सफल");

    शब्दकोश पुनर्भारित_आधार = आधार_आयात_जेसन(जेसन_डेटा);
    सत्यापित_करो(पुनर्भारित_आधार["नाम"] == "ज्ञान_कोष", "पुनर्भारित आधार नाम सम्यक्");
    शब्दकोश पुनर्_दस्ता = आधार_आईडी_से_पाओ(पुनर्भारित_आधार, "ग्रंथ", १);
    सत्यापित_करो(पुनर्_दस्ता != शून्यम्, "पुनर्भारित आधार में आईडी १ उपलब्ध");
    सत्यापित_करो(पुनर्_दस्ता["शीर्षक"] == "रामायण", "पुनर्भारित डेटा अखंडता अक्षुण्ण");
    लिखतु("  [सफल] डेटाबेस जेसन स्थायी संचयन एवं पुनर्भारण सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण ५: सूत्र_जाल अर्थगत मार्गक एवं प्राचल निष्कर्षण
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ५: सूत्र_जाल अर्थगत मार्गक एवं प्राचल निष्कर्षण ---");
    शब्दकोश मार्गक = मार्गक_बनाओ();
    मार्गक_मध्यस्थ_हेडर(मार्गक, "सर्वर", "सूत्र_जाल_१.०");

    मार्ग_जोड़ें(मार्गक, "प्राप्त", "/छात्र/:आईडी", "छात्र_विवरण");
    मार्ग_जोड़ें(मार्गक, "भेजें", "/छात्र", "नवीन_छात्र");

    // अनुरोध १: GET /छात्र/१०८
    शब्दकोश अनु१ = अनुरोध_बनाओ("प्राप्त", "/छात्र/१०८", {}, "");
    शब्दकोश फल१ = मार्गक_प्रेषण(मार्गक, अनु१);

    सत्यापित_करो(फल१["स्थिति"] == २००, "अनुरोध १ स्थिति २००");
    सत्यापित_करो(फल१["क्रिया"] == "छात्र_विवरण", "अनुरोध १ क्रिया 'छात्र_विवरण'");
    सत्यापित_करो(फल१["प्राचल"]["आईडी"] == "१०८", "रूट प्राचल :आईडी निष्कर्षण ('१०८')");
    सत्यापित_करो(फल१["मध्यस्थ_हेडर"]["सर्वर"] == "सूत्र_जाल_१.०", "मध्यस्थ हेडर इंजेक्शन");

    // अनुरोध २: ४०४ अप्राप्त पथ
    शब्दकोश अनु२ = अनुरोध_बनाओ("प्राप्त", "/अज्ञात/पथ", {}, "");
    शब्दकोश फल२ = मार्गक_प्रेषण(मार्गक, अनु२);
    सत्यापित_करो(फल२["स्थिति"] == ४०४, "अनुरोध २ अज्ञात पथ पर स्थिति ४०४");
    लिखतु("  [सफल] सूत्र_जाल मार्गक एवं प्राचल प्रेषण सफल।");

    // ------------------------------------------------------------
    // परीक्षण ६: सूत्र_भार संवर्जन विश्लेषण एवं संगतता
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ६: सूत्र_भार संवर्जन विश्लेषण एवं संगतता ---");
    // तुलना: "२.१.०" > "१.९.५" -> १
    संख्या तुल१ = संवर्जन_तुलना("२.१.०", "१.९.५");
    सत्यापित_करो(तुल१ == १, "संवर्जन तुलना '२.१.०' > '१.९.५'");

    // तुलना: "१.२.३" == "१.२.३" -> ०
    संख्या तुल२ = संवर्जन_तुलना("१.२.३", "१.२.३");
    सत्यापित_करो(तुल२ == ०, "संवर्जन समानता '१.२.३' == '१.२.३'");

    // तुलना: "०.९.०" < "१.०.०" -> -१
    संख्या तुल३ = संवर्जन_तुलना("०.९.०", "१.०.०");
    सत्यापित_करो(तुल३ == -१, "संवर्जन लघुता '०.९.०' < '१.०.०'");

    // संवर्जन संगतता (^1.2.0 के साथ 1.3.1 संगत है, 2.0.0 असंगत है)
    मान संगत१ = संवर्जन_संगत("^१.२.०", "१.३.१");
    मान संगत२ = संवर्जन_संगत("^१.२.०", "२.०.०");
    सत्यापित_करो(संगत१ == सत्य, "संवर्जन संगतता '^१.२.०' एवं '१.३.१' सत्य");
    सत्यापित_करो(संगत२ == असत्य, "संवर्जन असंगतता '^१.२.०' एवं '२.०.०' असत्य");
    लिखतु("  [सफल] सूत्र_भार संवर्जन विश्लेषण एवं सेमांटिक वर्ज़निंग सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण ७: सूत्र_भार निर्भरता टोपोलॉजिकल क्रम एवं लॉकफाइल
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ७: सूत्र_भार निर्भरता टोपोलॉजिकल क्रम एवं लॉकफाइल ---");
    शब्दकोश रजिस्ट्री = {};

    शब्दकोश पैक_गणित = {};
    पैक_गणित["संवर्जन"] = "१.०.०";
    पैक_गणित["निर्भरता"] = {};
    रजिस्ट्री["गणित"] = पैक_गणित;

    शब्दकोश पैक_दिशक = {};
    पैक_दिशक["संवर्जन"] = "१.१.०";
    पैक_दिशक["निर्भरता"] = { "गणित": "^१.०.०" };
    रजिस्ट्री["दिशक"] = पैक_दिशक;

    शब्दकोश पैक_एआई = {};
    पैक_एआई["संवर्जन"] = "२.०.०";
    पैक_एआई["निर्भरता"] = { "दिशक": "^१.०.०" };
    रजिस्ट्री["एआई_कोर"] = पैक_एआई;

    // टोपोलॉजिकल निर्भरता क्रम: गणित -> दिशक -> एआई_कोर
    सूची संस्थापन_क्रम = निर्भरता_क्रम_सुलझाओ(रजिस्ट्री, "एआई_कोर");
    सत्यापित_करो(लंबाई(संस्थापन_क्रम) == ३, "संस्थापन क्रम में ३ पैकेज");
    सत्यापित_करो(संस्थापन_क्रम[०] == "गणित", "प्रथम निर्भरता: 'गणित'");
    सत्यापित_करो(संस्थापन_क्रम[१] == "दिशक", "द्वितीय निर्भरता: 'दिशक'");
    सत्यापित_करो(संस्थापन_क्रम[२] == "एआई_कोर", "तृतीय लक्ष्य: 'एआई_कोर'");

    // लॉकफाइल निर्माण
    पाठ लॉक_जेसन = पैकेज_कील_बनाओ(रजिस्ट्री, संस्थापन_क्रम);
    सत्यापित_करो(लंबाई(लॉक_जेसन) > ०, "सूत्र कील सञ्चिका (Lockfile) निर्माण सफल");
    लिखतु("  [सफल] सूत्र_भार निर्भरता टोपोलॉजिकल क्रम एवं कील सञ्चिका १००% सम्यक्।");

    लिखतु("\n============================================================");
    लिखतु("  [सर्वं सम्यक्] सूत्र तंत्रज्ञान परिसंस्था (Phase 10) १००% सत्यापितम्!");
    लिखतु("============================================================");
}

मुख्य();
