// 05_gc_mark_misaligned_root.सूत्र — GC के mark-phase (चिह्नित/चिह्नित_कच्चा, मूल_आवंटक.सूत्र) में
// पहले alignment-जाँच (सूत्र_ब्लॉक_प्रकार जैसी) ग़ायब थी — एक ग़ैर-१६-संरेखित "मान"-typed मान (जैसे
// किसी दशमलव का raw bit-pattern) जो संयोग से अखंड की सीमा में गिर जाए, उसे असली ब्लॉक-हैडर समझकर
// mark/recurse किया जा सकता था (संभावित crash/heap-corruption, सिर्फ़ ग़लत मान नहीं)। यह टेस्ट अपने
// ही एक सूची के payload के भीतर एक ऐसा नक़ली, ग़ैर-संरेखित "पॉइंटर" बनाता (कोई बाहरी/असुरक्षित
// मेमोरी नहीं छूता — पूरी तरह सुरक्षित चाहे fix मौजूद हो या न हो) और उसे एक शब्दकोश-मान (generic
// "मान" slot) में रखकर संग्रह_करो() से असली GC चलाता — जो शब्दकोश के अपने सामान्य scan के ज़रिए ही
// चिह्नित(नक़ली) बुलाता, बिना किसी internal फलन को सीधे बुलाए (जो user कोड से संभव भी नहीं)।
//
// सुरक्षा-डिज़ाइन: नक़ली पता (=प) जानबूझकर स[3] के ठीक ऊपर (तत्व्_पता+40) पड़ता, तो "tag" (आधार=प-१६)
// स[3] से पढ़ा जाता, पर बग्गी `चिह्नित` की recursion "गणना"/"तत्व" ख़ुद **प** से (आधार से नहीं) पढ़ती
// — यानी स[6]/स[7] से (प+8, प+16)। स[6] को ० रखा गया है, तो fix ग़ायब होने पर भी recursion loop
// तुरंत रुकता — कोई wild पता कभी नहीं पढ़ा जाता (पहली कोशिश में स[4]/स[5] मान लिया था, ग़लत — असल
// में एक near-NULL पते पर पढ़ने से सचमुच segfault हुआ; इससे ठीक हुआ, अब हमेशा सुरक्षित)। मतलब: bug
// मौजूद रहते भी यह परीक्षण अब क्रैश नहीं करता, सिर्फ़ symptom (ग़लत mark-write) साफ़-साफ़ दिखाता।
मान विफलताएँ = 0;

कार्य जाँच(पाठ नाम, संख्या मिला, संख्या अपेक्षित) {
    यदि (मिला == अपेक्षित) {
        लिखतु("  ठीक : " + नाम);
    } अन्यथा {
        लिखतु("  विफल: " + नाम + " — मिला " + मिला + ", अपेक्षित " + अपेक्षित);
        विफलताएँ = विफलताएँ + 1;
    }
    परत् 0;
}

कार्य मुख्य() {
    सूची स = [1, 2, 3, 4, 5, 6, 0, 8];   // स[6]=0 — buggy "गणना" यहीं से पढ़ी जाएगी (नीचे देखो)
    संख्या तत्व_पता = अंतर्_पढ़8(स, 16);   // तत्व-बफर का असली पता (हमेशा १६-संरेखित)

    // स[3] (तत्व_पता+24) पर एक "सही दिखने वाला" tag बाइट लिखो — प्रकार=२ ("सूची")
    अंतर्_लिख8(तत्व_पता, 24, 2);

    संख्या नक़ली = तत्व_पता + 40;   // नक़ली - १६ = तत्व_पता + २४, ठीक ऊपर लिखी जगह पर

    संख्या शेष = नक़ली - (नक़ली / 16) * 16;
    जाँच("परीक्षण-सैनिटी: नक़ली पता संरेखित नहीं (शेष != 0)", शेष, 8);

    शब्दकोश द = {};
    द["क"] = नक़ली;   // generic ("मान") slot — GC का सामान्य शब्दकोश-scan चिह्नित(नक़ली) बुलाएगा

    संग्रह_करो();   // असली GC पास — यहीं चिह्नित(नक़ली) चलता (अगर alignment-जाँच ग़ायब हो)

    जाँच("द GC के बाद भी जीवित (liveness बनी रही)", द["क"], नक़ली);

    संख्या पश्चात् = अंतर्_पढ़8(तत्व_पता, 24);
    जाँच("ग़ैर-संरेखित मान को ग़लत ब्लॉक-हैडर नहीं माना गया (mark-byte अछूता)", पश्चात्, 2);

    // बाक़ी सूची अभी भी ठीक है — GC ने असली डेटा ख़राब नहीं किया
    जाँच("सूची स[0] अछूता", स[0], 1);
    जाँच("सूची स[7] अछूता", स[7], 8);

    लिखतु("");
    यदि (विफलताएँ == 0) {
        लिखतु("सर्वे उत्तीर्णाः");
    } अन्यथा {
        लिखतु("विफलम् — " + विफलताएँ + " परीक्षण विफल");
    }
}
