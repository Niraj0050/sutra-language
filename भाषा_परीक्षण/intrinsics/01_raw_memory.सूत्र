// निम्न-स्तर स्मृति अंतर्निर्देश — स्व-सत्यापन परीक्षण।
// केवल मूल (native-asm) स्व-संकलक द्वारा संकलित; व्याख्याता/C++ host इन्हें नहीं जानते,
// अतः यह parity-सूट का भाग नहीं।
मान विफलताएँ = 0;

कार्य जाँच(पाठ नाम, संख्या मिला, संख्या अपेक्षित) {
    यदि (मिला == अपेक्षित) {
        लिखतु("  ठीक : " + नाम);
    } अन्यथा {
        लिखतु("  विफल: " + नाम + " — मिला " + मिला + ", अपेक्षित " + अपेक्षित);
        विफलताएँ = विफलताएँ + 1;
    }
}

कार्य मुख्य() {
    // 1. पाठ शीर्षलेख: ऑफसेट 8 पर बाइट-लंबाई
    पाठ स = "abcdef";
    जाँच("ASCII बाइट-लंबाई == लंबाई()", अंतर्_पढ़8(स, 8), लंबाई(स));

    // 2. payload ऑफसेट 16 से; पहला बाइट 'a' = 97
    जाँच("पहला बाइट 'a'", अंतर्_पढ़1(स, 16), 97);
    जाँच("तीसरा बाइट 'c'", अंतर्_पढ़1(स, 18), 99);

    // 3. सूची शीर्षलेख (स्थिर handle): ऑफसेट 0 = क्षमता, 8 = लंबाई, 16 = तत्व-बफर का पॉइंटर।
    // तत्व अलग बफर में रहते हैं ताकि बढ़ने पर handle न हिले और हर alias को नया बफर दिखे।
    सूची सू = [10, 20, 30, 40];
    जाँच("सूची लंबाई शीर्षलेख", अंतर्_पढ़8(सू, 8), 4);
    संख्या क्षमता_ठीक = 0;
    यदि (अंतर्_पढ़8(सू, 0) >= 4) { क्षमता_ठीक = 1; }
    जाँच("सूची क्षमता >= लंबाई", क्षमता_ठीक, 1);
    संख्या तत्व = अंतर्_पढ़8(सू, 16);
    जाँच("सूची तत्व[0] payload", अंतर्_पढ़8(तत्व, 0), 10);
    जाँच("सूची तत्व[2] payload", अंतर्_पढ़8(तत्व, 16), 30);

    // 4. लिखो-फिर-पढ़ो चक्र (सूची तत्व में, तत्व-बफर के ज़रिये)
    अंतर्_लिख8(तत्व, 0, 999);
    जाँच("लिख8 फिर पढ़8", अंतर्_पढ़8(तत्व, 0), 999);
    जाँच("लिख8 से सूची दृश्य बदला", सू[0], 999);

    // 5. बढ़ने पर handle वही रहता है (alias को नई लंबाई दिखती है), बफर बदल सकता है
    सूची उप = सू;
    संख्या क = 0;
    यावत् (क < 40) {
        सू = जोड़ें(सू, क);
        क = क + 1;
    }
    जाँच("बढ़ने के बाद alias की लंबाई", अंतर्_पढ़8(उप, 8), 44);
    जाँच("बढ़ने के बाद तत्व[0] बचा", उप[0], 999);
    जाँच("बढ़ने के बाद अंतिम तत्व", उप[43], 39);

    अंतर्_लिख1(स, 16, 122);   // 'a' -> 'z'
    जाँच("लिख1 बाइट बदला", अंतर्_पढ़1(स, 16), 122);

    लिखतु("");
    यदि (विफलताएँ == 0) {
        लिखतु("सर्वे उत्तीर्णाः");
    } अन्यथा {
        लिखतु("विफलम् — " + विफलताएँ + " परीक्षण विफल");
    }
}
