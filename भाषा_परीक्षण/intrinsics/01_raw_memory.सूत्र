// निम्न-स्तर स्मृति अंतर्निर्देश — स्व-सत्यापन परीक्षण।
// केवल मूल (native-asm) स्व-संकलक द्वारा संकलित; व्याख्याता/C++ host इन्हें नहीं जानते,
// अतः यह parity-सूट का भाग नहीं।
मान विफलताएँ = 0;

कार्य जाँच(पाठ नाम, संख्या मिला, संख्या अपेक्षित) {
    यदि (मिला == अपेक्षित) {
        लिखतु("  ठीक : " + नाम);
    } अन्यथा {
        लिखतु("  विफल: " + नाम + " — मिला " + मिला + ", अपेक्षित " + अपेक्षित);
        विफलताएँ = विफलताएँ + 1;
    }
}

कार्य मुख्य() {
    // 1. पाठ शीर्षलेख: ऑफसेट 8 पर बाइट-लंबाई
    पाठ स = "abcdef";
    जाँच("ASCII बाइट-लंबाई == लंबाई()", अंतर्_पढ़8(स, 8), लंबाई(स));

    // 2. payload ऑफसेट 16 से; पहला बाइट 'a' = 97
    जाँच("पहला बाइट 'a'", अंतर्_पढ़1(स, 16), 97);
    जाँच("तीसरा बाइट 'c'", अंतर्_पढ़1(स, 18), 99);

    // 3. सूची शीर्षलेख: ऑफसेट 0 = क्षमता, 8 = लंबाई
    सूची सू = [10, 20, 30, 40];
    जाँच("सूची लंबाई शीर्षलेख", अंतर्_पढ़8(सू, 8), 4);
    जाँच("सूची तत्व[0] payload", अंतर्_पढ़8(सू, 16), 10);
    जाँच("सूची तत्व[2] payload", अंतर्_पढ़8(सू, 32), 30);

    // 4. लिखो-फिर-पढ़ो चक्र (सूची तत्व में)
    अंतर्_लिख8(सू, 16, 999);
    जाँच("लिख8 फिर पढ़8", अंतर्_पढ़8(सू, 16), 999);
    जाँच("लिख8 से सूची दृश्य बदला", सू[0], 999);

    अंतर्_लिख1(स, 16, 122);   // 'a' -> 'z'
    जाँच("लिख1 बाइट बदला", अंतर्_पढ़1(स, 16), 122);

    लिखतु("");
    यदि (विफलताएँ == 0) {
        लिखतु("सर्वे उत्तीर्णाः");
    } अन्यथा {
        लिखतु("विफलम् — " + विफलताएँ + " परीक्षण विफल");
    }
}
