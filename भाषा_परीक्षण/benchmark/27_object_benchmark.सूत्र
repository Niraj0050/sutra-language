// OOP Object Allocation Performance Benchmark
वर्ग बिंदु {
    संख्या क्ष = 0;
    संख्या य = 0;
    कार्य रचना(संख्या क, संख्या ख) {
        स्व.क्ष = क;
        स्व.य = ख;
    }
}

कार्य मुख्य() {
    मान इ = 1;
    यावत् (इ <= 1000) {
        मान बि = नवीन बिंदु(इ, इ * 2);
        इ = इ + 1;
    }
    लिखतु(इ);
}
