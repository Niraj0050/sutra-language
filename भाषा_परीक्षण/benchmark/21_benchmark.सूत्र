// Performance Benchmark Test for Sutra

लिखतु("=== Sutra Performance Benchmark ===");

// 1. Large Loop Benchmark
मान योग = 0;
मान आई = 1;
यावत् (आई <= 1000) {
    योग = योग + आई;
    आई = आई + 1;
}
लिखतु("1000 संख्या योग:");
लिखतु(योग);

// 2. Nested Loop Benchmark
मान चक्र_योग = 0;
पुनरावृत्तिः (मान क्ष = 1; क्ष <= 20; क्ष = क्ष + 1) {
    पुनरावृत्तिः (मान य = 1; य <= 20; य = य + 1) {
        चक्र_योग = चक्र_योग + 1;
    }
}
लिखतु("20x20 चक्र गणना:");
लिखतु(चक्र_योग);

// 3. Array operations
मान सूची_अंक = [];
पुनरावृत्तिः (मान क = 1; क <= 50; क = क + 1) {
    सूची_अंक = जोड़ें(सूची_अंक, क * 2);
}
लिखतु("सूच्याः आकारः:");
लिखतु(लंबाई(सूची_अंक));
 लिखतु("अन्तिम अंक:");
लिखतु(सूची_अंक[49]);

लिखतु("=== Benchmark Complete ===");
