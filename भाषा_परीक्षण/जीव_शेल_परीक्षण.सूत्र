// भाषा_परीक्षण/जीव_शेल_परीक्षण.सूत्र
// ==============================================================================
// जीव-प्रणाली (Jiv-OS) संवादात्मक देवनागरी शेल परीक्षण सूट
//
// परीक्षण अनुक्रम:
//   १. शेल आरंभीकरण: 'जीव-ओएस> ' प्रॉम्प्ट एवं स्थिति
//   २. सहायता आदेश: आदेश निर्देशिका एवं उपयोगिता विवरण
//   ३. संज्ञान एवं स्मृति आदेश: हार्डवेयर इंद्रिय व भौतिक चौखटों का प्रदर्शन
//   ४. कार्य आदेश: क्रमक बहुकार्यन TCB सारणी एवं समय-खंड
//   ५. ट्यून आदेश: जीव G2 द्वारा स्वायत्त लाइव कर्नेल अनुकूलन
//   ६. न्याय आदेश: शून्य-भ्रान्ति पञ्चावयव प्रमाण औपचारिक सिद्धि
//   ७. सेक्टर_लिख एवं सेक्टर_पढ़: डिस्क स्टोरेज एकीकरण एवं पठन-लेखन
//   ८. पंक्ति संपादन: कीबोर्ड वर्ण प्रविष्टि, बैकस्पेस एवं न्यूलाइन निष्पादन
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("==============================================================================");
    लिखतु("  जीव-प्रणाली (Jiv-OS) संवादात्मक देवनागरी शेल परीक्षण");
    लिखतु("==============================================================================\n");

    // --------------------------------------------------------------------------
    // परीक्षण १: शेल आरंभीकरण एवं प्रॉम्प्ट
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण १: शेल आरंभीकरण एवं प्रॉम्प्ट ---");
    शब्दकोश हार्डवेयर = {};
    हार्डवेयर["सीपीयू"] = "x86-64";
    हार्डवेयर["स्मृति_एमबी"] = २५६;

    शब्दकोश जीव = जीव_जी२_प्रणाली_आरंभ("जीव_G2_शेल_पालक", हार्डवेयर);
    शब्दकोश शेल = जीव_शेल_आरंभ(जीव);

    सत्यापित_करो(शेल["प्रॉम्प्ट"] == "जीव-ओएस> ", "शेल प्रॉम्प्ट 'जीव-ओएस> '");
    सत्यापित_करो(शेल["सक्रिय"] == सत्य, "शेल प्रारंभिक स्थिति सक्रिय");
    सत्यापित_करो(शेल["निष्पादित_आदेश_संख्या"] == ०, "निष्पादित आदेश प्रारंभिक शून्य");
    लिखतु("  [सफल] शेल आरंभीकरण एवं प्रॉम्प्ट सम्यक्।\n");

    // --------------------------------------------------------------------------
    // परीक्षण २: सहायता आदेश
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण २: सहायता आदेश ---");
    पाठ फल_सहायता = शेल_आदेश_चलाओ(शेल, "सहायता");
    सत्यापित_करो(समाहित_पाठ(फल_सहायता, "संज्ञान"), "सहायता में 'संज्ञान' उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_सहायता, "स्मृति"), "सहायता में 'स्मृति' उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_सहायता, "ट्यून"), "सहायता में 'ट्यून' उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_सहायता, "न्याय"), "सहायता में 'न्याय' उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_सहायता, "सेक्टर_लिख"), "सहायता में 'सेक्टर_लिख' उपस्थित");
    सत्यापित_करो(शेल["निष्पादित_आदेश_संख्या"] == १, "निष्पादित आदेश संख्या = १");
    लिखतु("  [सफल] सहायता आदेश निर्देशिका परिपूर्ण।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ३: संज्ञान एवं स्मृति आदेश
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ३: संज्ञान एवं स्मृति आदेश ---");
    पाठ फल_संज्ञान = शेल_आदेश_चलाओ(शेल, "संज्ञान");
    सत्यापित_करो(समाहित_पाठ(फल_संज्ञान, "मस्तिष्क (CPU)"), "संज्ञान में मस्तिष्क (CPU) उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_संज्ञान, "२५६ एमबी"), "संज्ञान में २५६ एमबी स्मृति उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_संज्ञान, "VGA पाठ बफर"), "संज्ञान में VGA पाठ बफर उपस्थित");

    पाठ फल_स्मृति = शेल_आदेश_चलाओ(शेल, "स्मृति");
    सत्यापित_करो(समाहित_पाठ(फल_स्मृति, "५१२ चौखटें"), "स्मृति में ५१२ चौखटें उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_स्मृति, "४०९६ बाइट्स"), "स्मृति में पृष्ठ आकार ४०९६ बाइट्स उपस्थित");
    लिखतु("  [सफल] संज्ञान एवं स्मृति आदेश हार्डवेयर रिपोर्ट शुद्ध।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ४: कार्य एवं क्रमक आदेश
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ४: कार्य आदेश ---");
    पाठ फल_कार्य = शेल_आदेश_चलाओ(शेल, "कार्य");
    सत्यापित_करो(समाहित_पाठ(फल_कार्य, "स्मृति_रक्षक"), "कार्य में स्मृति_रक्षक कार्य");
    सत्यापित_करो(समाहित_पाठ(फल_कार्य, "संवेदक_उत्पादक"), "कार्य में संवेदक कार्य");
    सत्यापित_करो(समाहित_पाठ(फल_कार्य, "विश्लेषक_उपभोक्ता"), "कार्य में विश्लेषक कार्य");
    सत्यापित_करो(समाहित_पाठ(फल_कार्य, "समय-खंड"), "कार्य में समय-खंड (Quantum) सांख्यिकी");
    लिखतु("  [सफल] कार्य TCB सारणी रिपोर्ट सत्यापित।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ५: ट्यून — स्वायत्त लाइव कर्नेल अनुकूलन
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ५: ट्यून आदेश ---");
    पाठ फल_ट्यून = शेल_आदेश_चलाओ(शेल, "ट्यून");
    सत्यापित_करो(समाहित_पाठ(फल_ट्यून, "जीव G2 स्वायत्त कर्नेल लाइव ट्यूनिंग संपन्न"), "ट्यूनिंग शीर्षक");
    सत्यापित_करो(समाहित_पाठ(फल_ट्यून, "७६८ पृष्ठ"), "पृष्ठ-पूल ५०% बढ़कर ७६८ पृष्ठ");
    सत्यापित_करो(समाहित_पाठ(फल_ट्यून, "शून्य-भ्रान्ति १००% सत्यापित"), "शून्य-भ्रान्ति न्याय प्रमाण");
    लिखतु("  [सफल] ट्यून आदेश से स्वायत्त लाइव अनुकूलन सिद्ध।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ६: न्याय पञ्चावयव प्रमाण
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ६: न्याय आदेश ---");
    पाठ फल_न्याय = शेल_आदेश_चलाओ(शेल, "न्याय संपूर्ण_प्रणाली_सुरक्षा");
    सत्यापित_करो(समाहित_पाठ(फल_न्याय, "प्रतिज्ञा : संपूर्ण_प्रणाली_सुरक्षा"), "प्रतिज्ञा सत्यापन");
    सत्यापित_करो(समाहित_पाठ(फल_न्याय, "हेतु"), "हेतु अवयव उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_न्याय, "उदाहरण"), "उदाहरण व्याप्ति नियम उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_न्याय, "उपनय"), "उपनय अवयव उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_न्याय, "न्यायसिद्धम्"), "निगमन न्यायसिद्धम्");
    लिखतु("  [सफल] न्याय आदेश पञ्चावयव प्रमाण शून्य-भ्रान्ति की पुष्टि करता है।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ७: डिस्क स्टोरेज एकीकरण (सेक्टर_लिख एवं सेक्टर_पढ़)
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ७: सेक्टर_लिख एवं सेक्टर_पढ़ ---");
    पाठ फल_लिख = शेल_आदेश_चलाओ(शेल, "सेक्टर_लिख ५ सूत्र_स्वायत्त_ज्ञान");
    सत्यापित_करो(समाहित_पाठ(फल_लिख, "सफलतापूर्व लिखे गए"), "सेक्टर ५ लेखन सफल");

    पाठ फल_पढ़ = शेल_आदेश_चलाओ(शेल, "सेक्टर_पढ़ ५");
    सत्यापित_करो(समाहित_पाठ(फल_पढ़, "सूत्र_स्वायत्त_ज्ञान"), "सेक्टर ५ से लिखित डेटा शत-प्रतिशत प्राप्त");
    लिखतु("  [सफल] डिस्क सेक्टर संचयन एवं पठन सम्यक्।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ८: पंक्ति संपादन (Typing, Backspace, Newline)
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ८: वर्ण-दर-वर्ण पंक्ति संपादन ---");
    // वर्ण प्रविष्टि: 'स' 'म' 'ृ'
    शेल_वर्ण_प्रविष्ट(शेल, १०५); // काल्पनिक वर्ण
    शेल_वर्ण_प्रविष्ट(शेल, १०६);
    // बैकस्पेस (८)
    शेल_वर्ण_प्रविष्ट(शेल, ८);
    // न्यूलाइन पर आदेश आह्वान
    शेल["पंक्ति_बफर"] = "प्रतिवेदन";
    पाठ फल_संपादित = शेल_वर्ण_प्रविष्ट(शेल, १०); // Enter '\n'
    सत्यापित_करो(समाहित_पाठ(फल_संपादित, "जीव G2 समग्र स्वास्थ्य प्रतिवेदन"), "संपादित पंक्ति निष्पादन सफल");
    सत्यापित_करो(समाहित_पाठ(फल_संपादित, "जीव_G2_शेल_पालक"), "प्रतिवेदन में जीव नाम उपस्थित");
    लिखतु("  [सफल] वर्ण-दर-वर्ण पंक्ति संपादन एवं निष्पादन संपन्न।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ९: सञ्चिका-प्रणाली एकीकरण (SutraFS: लिखो, पढ़ो, सूची)
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ९: सञ्चिका-प्रणाली एकीकरण (SutraFS: लिखो, पढ़ो, सूची) ---");
    पाठ फल_रिक्त_सूची = शेल_आदेश_चलाओ(शेल, "सूची");
    सत्यापित_करो(समाहित_पाठ(फल_रिक्त_सूची, "सञ्चिका-प्रणाली रिक्त है"), "रिक्त सञ्चिका-प्रणाली संदेश");

    पाठ फल_लिखो = शेल_आदेश_चलाओ(शेल, "लिखो जीव_जी२_ज्ञान.सूत्र पाणिनीय_संज्ञान_प्रमाण_संहिता");
    सत्यापित_करो(समाहित_पाठ(फल_लिखो, "जीव_जी२_ज्ञान.सूत्र"), "सञ्चिका सृजन नाम पुष्टि");
    सत्यापित_करो(समाहित_पाठ(फल_लिखो, "निर्मित"), "सञ्चिका निर्माण सफल");

    पाठ फल_पढ़ो = शेल_आदेश_चलाओ(शेल, "पढ़ो जीव_जी२_ज्ञान.सूत्र");
    सत्यापित_करो(समाहित_पाठ(फल_पढ़ो, "पाणिनीय_संज्ञान_प्रमाण_संहिता"), "लिखित सामग्री पूर्ण प्राप्त");

    पाठ फल_भरी_सूची = शेल_आदेश_चलाओ(शेल, "सूची");
    सत्यापित_करो(समाहित_पाठ(फल_भरी_सूची, "जीव_जी२_ज्ञान.सूत्र"), "सूची में सञ्चिका उपस्थित");
    सत्यापित_करो(समाहित_पाठ(फल_भरी_सूची, "कुल सञ्चिकाएं: १"), "सञ्चिका गणना = १");
    लिखतु("  [सफल] सञ्चिका सृजन, पठन एवं सूचीकरण सम्यक्।\n");

    // --------------------------------------------------------------------------
    // परीक्षण १०: डिस्क स्वास्थ्य अखंडता एवं सञ्चिका विलोपन
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण १०: डिस्क स्वास्थ्य अखंडता एवं सञ्चिका विलोपन ---");
    पाठ फल_डिस्क = शेल_आदेश_चलाओ(शेल, "डिस्क");
    सत्यापित_करो(समाहित_पाठ(फल_डिस्क, "निर्दोष_अखंड"), "डिस्क स्वास्थ्य निर्दोष_अखंड");
    सत्यापित_करो(समाहित_पाठ(फल_डिस्क, "कुल सञ्चिकाएं: १"), "अखंडता प्रतिवेदन में १ सञ्चिका");

    पाठ फल_मिटाओ = शेल_आदेश_चलाओ(शेल, "मिटाओ जीव_जी२_ज्ञान.सूत्र");
    सत्यापित_करो(समाहित_पाठ(फल_मिटाओ, "विलोपित एवं सेक्टर विमुक्त"), "सञ्चिका विलोपन एवं सेक्टर विमुक्ति");

    पाठ फल_डिस्क२ = शेल_आदेश_चलाओ(शेल, "डिस्क");
    सत्यापित_करो(समाहित_पाठ(फल_डिस्क२, "कुल सञ्चिकाएं: ०"), "विलोपन के बाद सञ्चिकाएं = ०");
    सत्यापित_करो(समाहित_पाठ(फल_डिस्क२, "निर्दोष_अखंड"), "विलोपन के बाद भी शून्य-लीक अखंडता अक्षुण्ण");
    लिखतु("  [सफल] सञ्चिका विलोपन एवं शून्य-लीक अखंडता शत-प्रतिशत सिद्ध।\n");

    लिखतु("==============================================================================");
    लिखतु("  [सर्वं सम्यक्] जीव-प्रणाली संवादात्मक शेल परीक्षण १००% सफल!");
    लिखतु("  प्रॉम्प्ट, आदेश प्रेषक, हार्डवेयर संज्ञान, डिस्क एवं SutraFS सिद्ध।");
    लिखतु("==============================================================================");
}

मुख्य();
