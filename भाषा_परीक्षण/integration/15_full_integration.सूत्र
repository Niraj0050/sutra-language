// ========================================
// सूत्र भाषा - व्यापक परीक्षण
// ========================================

कार्य योगफल(संख्या क, संख्या ख) {
    परत् क + ख;
}

कार्य गुणनफल(संख्या क, संख्या ख) {
    परत् क * ख;
}

कार्य वर्गफल(संख्या संख्या_मान) {
    परत् संख्या_मान * संख्या_मान;
}

कार्य मुख्य() {

    लिखतु("========================================");
    लिखतु("       सूत्र भाषा व्यापक परीक्षण");
    लिखतु("========================================");


    // ----------------------------------------
    // 1. सामान्य चर
    // ----------------------------------------

    लिखतु("1. चर परीक्षण");

    मान नाम = "निरज";
    मान आयु = 22;
    मान ऊंचाई = 5.8;
    मान सक्रिय = सत्य;

    लिखतु(नाम);
    लिखतु(आयु);
    लिखतु(ऊंचाई);
    लिखतु(सक्रिय);

    आयु = 23;

    लिखतु("परिवर्तित आयु:");
    लिखतु(आयु);


    // ----------------------------------------
    // 2. Typed Variables
    // ----------------------------------------

    लिखतु("2. Typed Variable परीक्षण");

    संख्या अंक = 100;
    दशमलव मूल्य = 99.50;
    पाठ संदेश = "सूत्र";
    बूल स्थिति = सत्य;
    सूची वस्तुएं = [10, 20, 30, 40, 50];

    लिखतु(अंक);
    लिखतु(मूल्य);
    लिखतु(संदेश);
    लिखतु(स्थिति);


    // ----------------------------------------
    // 3. Arithmetic
    // ----------------------------------------

    लिखतु("3. गणितीय परीक्षण");

    मान पहला_अंक = 20;
    मान दूसरा_अंक = 6;

    लिखतु(पहला_अंक + दूसरा_अंक);
    लिखतु(पहला_अंक - दूसरा_अंक);
    लिखतु(पहला_अंक * दूसरा_अंक);
    लिखतु(पहला_अंक / दूसरा_अंक);
    लिखतु(पहला_अंक % दूसरा_अंक);
    लिखतु(-पहला_अंक);


    // ----------------------------------------
    // 4. String Concatenation
    // ----------------------------------------

    लिखतु("4. String परीक्षण");

    मान पहला_शब्द = "नमस्ते";
    मान दूसरा_शब्द = "सूत्र";

    लिखतु(पहला_शब्द + " " + दूसरा_शब्द);
    लिखतु("भाषा: " + दूसरा_शब्द);


    // ----------------------------------------
    // 5. Comparison
    // ----------------------------------------

    लिखतु("5. Comparison परीक्षण");

    मान संख्या_एक = 10;
    मान संख्या_दो = 20;

    लिखतु(संख्या_एक == संख्या_दो);
    लिखतु(संख्या_एक != संख्या_दो);
    लिखतु(संख्या_एक < संख्या_दो);
    लिखतु(संख्या_एक > संख्या_दो);
    लिखतु(संख्या_एक <= संख्या_दो);
    लिखतु(संख्या_एक >= संख्या_दो);


    // ----------------------------------------
    // 6. Logical Operators
    // ----------------------------------------

    लिखतु("6. Logical परीक्षण");

    मान सत्य_मान = सत्य;
    मान असत्य_मान = असत्य;

    लिखतु(सत्य_मान && असत्य_मान);
    लिखतु(सत्य_मान || असत्य_मान);
    लिखतु(!सत्य_मान);

    लिखतु(सत्य_मान तथा असत्य_मान);
    लिखतु(सत्य_मान अथवा असत्य_मान);
    लिखतु(न असत्य_मान);


    // ----------------------------------------
    // 7. If / Else
    // ----------------------------------------

    लिखतु("7. Condition परीक्षण");

    मान प्राप्त_अंक = 85;

    यदि (प्राप्त_अंक >= 80) {
        लिखतु("बहुत अच्छा");
    } अन्यथा {
        लिखतु("और प्रयास करें");
    }


    // ----------------------------------------
    // 8. Nested Condition
    // ----------------------------------------

    लिखतु("8. Nested Condition परीक्षण");

    मान वर्तमान_आयु = 23;

    अगर (वर्तमान_आयु >= 18) {

        अगर (वर्तमान_आयु >= 21) {
            लिखतु("वयस्क और 21 से अधिक");
        } अन्यथा {
            लिखतु("वयस्क");
        }

    } अन्यथा {
        लिखतु("नाबालिग");
    }


    // ----------------------------------------
    // 9. While Loop
    // ----------------------------------------

    लिखतु("9. While Loop परीक्षण");

    मान गणक = 1;

    यावत् (गणक <= 5) {
        लिखतु(गणक);
        गणक = गणक + 1;
    }


    // ----------------------------------------
    // 10. For Loop
    // ----------------------------------------

    लिखतु("10. For Loop परीक्षण");

    पुनरावृत्तिः (
        मान क्रमांक = 1;
        क्रमांक <= 5;
        क्रमांक = क्रमांक + 1
    ) {
        लिखतु(क्रमांक);
    }


    // ----------------------------------------
    // 11. Break
    // ----------------------------------------

    लिखतु("11. Break परीक्षण");

    पुनरावृत्तिः (
        मान संख्या_गणना = 1;
        संख्या_गणना <= 10;
        संख्या_गणना = संख्या_गणना + 1
    ) {

        अगर (संख्या_गणना == 6) {
            विरामः;
        }

        लिखतु(संख्या_गणना);
    }


    // ----------------------------------------
    // 12. Nested Loop
    // ----------------------------------------

    लिखतु("12. Nested Loop परीक्षण");

    पुनरावृत्तिः (
        मान बाहरी_गणना = 1;
        बाहरी_गणना <= 3;
        बाहरी_गणना = बाहरी_गणना + 1
    ) {

        लिखतु("बाहरी:");
        लिखतु(बाहरी_गणना);

        पुनरावृत्तिः (
            मान आंतरिक_गणना = 1;
            आंतरिक_गणना <= 3;
            आंतरिक_गणना = आंतरिक_गणना + 1
        ) {

            अगर (आंतरिक_गणना == 3) {
                विरामः;
            }

            लिखतु(आंतरिक_गणना);
        }
    }


    // ----------------------------------------
    // 13. Array
    // ----------------------------------------

    लिखतु("13. Array परीक्षण");

    मान संख्याएं = [10, 20, 30, 40, 50];

    लिखतु(संख्याएं[0]);
    लिखतु(संख्याएं[1]);
    लिखतु(संख्याएं[2]);
    लिखतु(संख्याएं[3]);
    लिखतु(संख्याएं[4]);


    // ----------------------------------------
    // 14. Array Assignment
    // ----------------------------------------

    लिखतु("14. Array Assignment परीक्षण");

    संख्याएं[2] = 300;

    लिखतु(संख्याएं[2]);


    // ----------------------------------------
    // 15. Array + For Loop
    // ----------------------------------------

    लिखतु("15. Array + Loop परीक्षण");

    पुनरावृत्तिः (
        मान सूची_क्रमांक = 0;
        सूची_क्रमांक < 5;
        सूची_क्रमांक = सूची_क्रमांक + 1
    ) {
        लिखतु(संख्याएं[सूची_क्रमांक]);
    }


    // ----------------------------------------
    // 16. Functions
    // ----------------------------------------

    लिखतु("16. Function परीक्षण");

    मान योग_परिणाम = योगफल(100, 50);

    लिखतु(योग_परिणाम);

    मान गुणन_परिणाम = गुणनफल(7, 8);

    लिखतु(गुणन_परिणाम);

    मान वर्ग_परिणाम = वर्गफल(7);

    लिखतु(वर्ग_परिणाम);


    // ----------------------------------------
    // 17. Function + Loop
    // ----------------------------------------

    लिखतु("17. Function + Loop परीक्षण");

    पुनरावृत्तिः (
        मान गणित_क्रमांक = 1;
        गणित_क्रमांक <= 5;
        गणित_क्रमांक = गणित_क्रमांक + 1
    ) {

        लिखतु(वर्गफल(गणित_क्रमांक));
    }


    // ----------------------------------------
    // 18. Devanagari Numbers
    // ----------------------------------------

    लिखतु("18. देवनागरी अंक परीक्षण");

    मान देवनागरी_संख्या = १२३;

    लिखतु(देवनागरी_संख्या);


    // ----------------------------------------
    // 19. Null
    // ----------------------------------------

    लिखतु("19. Null परीक्षण");

    मान खाली_मान = शून्यम्;

    लिखतु(खाली_मान);


    // ----------------------------------------
    // 20. Output Functions
    // ----------------------------------------

    लिखतु("20. Output परीक्षण");

    लिखतु("लिखतु सफल");
    दर्शयतु("दर्शयतु सफल");
    पंक्तिं("पंक्तिं सफल");


    // ----------------------------------------
    // 21. Mixed Calculation
    // ----------------------------------------

    लिखतु("21. Mixed Calculation परीक्षण");

    मान आधार = 10;
    मान वृद्धि = 5;

    मान परिणाम = योगफल(
        गुणनफल(आधार, वृद्धि),
        वर्गफल(3)
    );

    लिखतु(परिणाम);


    // ----------------------------------------
    // 22. Unicode
    // ----------------------------------------

    लिखतु("22. Unicode परीक्षण");

    मान अभिवादन = "नमस्ते दुनिया";
    मान भाषा_नाम = "सूत्र भाषा";
    मान संदेश_हिन्दी = "यह एक पूर्ण Unicode परीक्षण है।";

    लिखतु(अभिवादन);
    लिखतु(भाषा_नाम);
    लिखतु(संदेश_हिन्दी);


    // ----------------------------------------
    // समाप्त
    // ----------------------------------------

    लिखतु("========================================");
    लिखतु("       पूर्ण परीक्षण समाप्त");
    लिखतु("========================================");
}
