कार्य मुख्य() {
    लिखतु("=== 16. प्रयत्न - पकड़ो (Try - Catch) परीक्षण ===");

    // 1. Division by Zero Handling
    प्रयत्न {
        लिखतु("1. शून्येन विभाजन परीक्षण...");
        मान अ = 10 / 0;
        लिखतु("यह रेखा न चलनी चाहिए");
    } पकड़ो (त्रुटि) {
        लिखतु("त्रुटि गृहीता: " + त्रुटि);
    }

    // 2. Custom Throw Exception
    प्रयत्न {
        लिखतु("2. प्रक्षेपः (Throw) परीक्षण...");
        प्रक्षेपः "अमान्य आयु मानम्!";
        लिखतु("यह रेखा न चलनी चाहिए");
    } पकड़ो (त्रुटि) {
        लिखतु("प्रक्षिप्त त्रुटि गृहीता: " + त्रुटि);
    }

    // 3. Array Index Out of Bounds
    प्रयत्न {
        लिखतु("3. सूच्याः सीमा परीक्षण...");
        सूची अंक = [10, 20];
        मान विफल = अंक[5];
    } पकड़ो (त्रुटि) {
        लिखतु("सूची सीमा त्रुटि गृहीता: " + त्रुटि);
    }

    लिखतु("परीक्षणम् सफलम् (PASS)");
}
