कार्य मुख्य() {
    // निकालें रिक्त list
    प्रयत्न {
        निकालें([]);
        लिखतु("POP_EMPTY_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("POP_EMPTY_OK");
    }

    // डालें out of bounds
    प्रयत्न {
        डालें([1, 2], 5, 10);
        लिखतु("INSERT_OOB_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("INSERT_OOB_OK");
    }

    // हटाएं out of bounds
    प्रयत्न {
        हटाएं([1, 2], 5);
        लिखतु("REMOVE_OOB_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("REMOVE_OOB_OK");
    }
}
