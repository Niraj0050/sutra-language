// भाषा_परीक्षण/प्रकार_प्रणाली_परीक्षण.सूत्र — सूत्र प्रगत प्रकार प्रणाली एवं प्रतिरूप मिलान परीक्षण
// ==============================================================================
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";
आयात "पुस्तकालय/प्रकार_प्रणाली.सूत्र";

कार्य दो_का_घात(सूची तर्क) {
    संख्या घा = तर्क[०];
    संख्या फल = १;
    संख्या इ = ०;
    यावत् (इ < घा) {
        फल = फल * २;
        इ = इ + १;
    }
    परत् फल;
}

कार्य मुख्य() {
    परीक्षण_समूह("सूत्र प्रगत प्रकार प्रणाली — गणन, संरचना एवं प्रतिरूप मिलान");

    // ============================================================
    // १. गणन (Enums) परीक्षण
    // ============================================================
    शब्दकोश दिशा = गणन_रचना("दिशा", ["उत्तर", "दक्षिण", "पूर्व", "पश्चिम"]);
    जाँच("गणन नाम सत्यापन", दिशा["नाम"], "दिशा");
    जाँच("गणन विकल्प संख्या", लंबाई(दिशा["विकल्प"]), ४);
    जाँच_सत्य("गणन विकल्प 'उत्तर' उपस्थिति", कुंजी_है(दिशा, "उत्तर"));
    जाँच_सत्य("समान गणन तुल्यता", गणन_तुल्य(दिशा["उत्तर"], दिशा["उत्तर"]));
    जाँच_असत्य("भिन्न गणन अतुल्यता", गणन_तुल्य(दिशा["उत्तर"], दिशा["दक्षिण"]));

    // ============================================================
    // २. बीजगणितीय डेटा प्रकार (ADT) परीक्षण
    // ============================================================
    शब्दकोश परिणाम = एडिटी_रचना("परिणाम", [
        {"नाम": "सफल", "फ़ील्ड": ["डेटा"]},
        {"नाम": "विफल", "फ़ील्ड": ["संदेश", "कोड"]}
    ]);

    शब्दकोश सफल_उदाहरण = एडिटी_निर्माण(परिणाम, "सफल", ["आदेश_स्वीकृत"]);
    जाँच("एडिटी प्रकार सत्यापन", सफल_उदाहरण["_प्रकार"], "एडिटी");
    जाँच("एडिटी विकल्प सत्यापन", सफल_उदाहरण["_विकल्प"], "सफल");
    जाँच("एडिटी डेटा फ़ील्ड मान", सफल_उदाहरण["डेटा"]["डेटा"], "आदेश_स्वीकृत");

    शब्दकोश विफल_उदाहरण = एडिटी_निर्माण(परिणाम, "विफल", ["सर्वर_त्रुटि", ५००]);
    जाँच("विफल विकल्प", विफल_उदाहरण["_विकल्प"], "विफल");
    जाँच("विफल कोड", विफल_उदाहरण["डेटा"]["कोड"], ५००);

    // ============================================================
    // ३. प्रयोक्ता-परिभाषित संरचना (Typed Structs) परीक्षण
    // ============================================================
    शब्दकोश बिन्दु३_ढाँचा = संरचना_रचना("बिन्दु३", {
        "क्ष": "दशमलव",
        "य": "दशमलव",
        "ज्ञ": "दशमलव"
    });

    शब्दकोश ब = संरचना_नवीन(बिन्दु३_ढाँचा, {
        "क्ष": १०.५,
        "य": २०.५,
        "ज्ञ": ३०.५
    });

    जाँच("संरचना नाम सत्यापन", ब["_संरचना_नाम"], "बिन्दु३");
    जाँच("संरचना फ़ील्ड 'क्ष'", संरचना_प्राप्त(ब, "क्ष"), १०.५);
    जाँच("संरचना फ़ील्ड 'य'", संरचना_प्राप्त(ब, "य"), २०.५);
    जाँच("संरचना फ़ील्ड 'ज्ञ'", संरचना_प्राप्त(ब, "ज्ञ"), ३०.५);

    संरचना_निर्धारित(ब, बिन्दु३_ढाँचा, "क्ष", १५.५);
    जाँच("संरचना अद्यतन फ़ील्ड 'क्ष'", संरचना_प्राप्त(ब, "क्ष"), १५.५);

    // ============================================================
    // ४. प्रतिरूप मिलान (Pattern Matching) परीक्षण
    // ============================================================

    // परीक्षण ४.१: मूल्य मिलान
    पाठ फल_मूल्य = मिलान_करो(४२, [
        मिलान_मान(०, "शून्य"),
        मिलान_मान(४२, "बयालीस"),
        मिलान_अन्यथा("अन्य")
    ]);
    जाँच("प्रतिरूप मिलान — मूल्य", फल_मूल्य, "बयालीस");

    // परीक्षण ४.२: सीमा मिलान
    पाठ फल_सीमा = मिलान_करो(७५, [
        मिलान_सीमा(०, ५०, "निम्न"),
        मिलान_सीमा(५१, १००, "उच्च"),
        मिलान_अन्यथा("अज्ञात")
    ]);
    जाँच("प्रतिरूप मिलान — सीमा", फल_सीमा, "उच्च");

    // परीक्षण ४.३: गणन मिलान
    पाठ फल_गणन = मिलान_करो(दिशा["पूर्व"], [
        मिलान_गणन(दिशा["उत्तर"], "उत्तरम्"),
        मिलान_गणन(दिशा["पूर्व"], "पूर्वम्"),
        मिलान_अन्यथा("अन्य")
    ]);
    जाँच("प्रतिरूप मिलान — गणन", फल_गणन, "पूर्वम्");

    // परीक्षण ४.४: एडिटी मिलान
    पाठ फल_एडिटी = मिलान_करो(विफल_उदाहरण, [
        मिलान_एडिटी("सफल", "सफलता"),
        मिलान_एडिटी("विफल", "विफलता_५००"),
        मिलान_अन्यथा("अन्य")
    ]);
    जाँच("प्रतिरूप मिलान — एडिटी", फल_एडिटी, "विफलता_५००");

    // परीक्षण ४.५: संरचना मिलान
    पाठ फल_संरचना = मिलान_करो(ब, [
        मिलान_संरचना("बिन्दु२", "२डी बिन्दु"),
        मिलान_संरचना("बिन्दु३", "३डी बिन्दु"),
        मिलान_अन्यथा("अन्य")
    ]);
    जाँच("प्रतिरूप मिलान — संरचना", फल_संरचना, "३डी बिन्दु");

    // परीक्षण ४.६: प्रकार मिलान
    पाठ फल_प्रकार = मिलान_करो("नमस्ते", [
        मिलान_प्रकार("संख्या", "संख्या_प्रकार"),
        मिलान_प्रकार("पाठ", "पाठ_प्रकार"),
        मिलान_अन्यथा("अन्य")
    ]);
    जाँच("प्रतिरूप मिलान — प्रकार", फल_प्रकार, "पाठ_प्रकार");

    // परीक्षण ४.७: सूची लंबाई मिलान
    पाठ फल_सूची = मिलान_करो([१, २, ३], [
        मिलान_सूची_लंबाई(२, "युग्म"),
        मिलान_सूची_लंबाई(३, "त्रयी"),
        मिलान_अन्यथा("अन्य")
    ]);
    जाँच("प्रतिरूप मिलान — सूची लंबाई", फल_सूची, "त्रयी");

    // ============================================================
    // ५. संकलन-कालीन स्थिर गणना (Comptime Memoization) परीक्षण
    // ============================================================
    स्थिर_गणना_रिक्त_करो();
    जाँच("स्थिर गणना पूर्व अनुपस्थिति", स्थिर_गणना_प्राप्त("दो_का_घात_१०"), शून्यम्);

    स्थिर_गणना_रखो("दो_का_घात_१०", १०२४);
    जाँच("स्थिर गणना (२^१०)", स्थिर_गणना_प्राप्त("दो_का_घात_१०"), १०२४);

    परत् परीक्षण_सारांश();
}

मुख्य();
