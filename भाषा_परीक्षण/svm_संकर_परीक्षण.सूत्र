// svm_संकर_परीक्षण.सूत्र — सूत्र स्रोत → IR → अष्टक-संकेत (SVM Bytecode) → निष्पादन
// ============================================================
// वास्तविक सूत्र स्रोत कोड को पार्स, निम्नक (IR), अष्टक-उत्सर्जक (SVM Bytecode),
// और सूत्र आभासी यंत्र (SVM) में निष्पादित कर परिणाम सत्यापित करना।
// ============================================================

आयात "स्वसंकलक/विश्लेषक.सूत्र";
आयात "स्वसंकलक/सार्थक_विश्लेषक.सूत्र";
आयात "स्वसंकलक/मध्यम.सूत्र";
आयात "स्वसंकलक/मूल_निम्नक.सूत्र";
आयात "स्वसंकलक/अष्टक_संकेत.सूत्र";
आयात "स्वसंकलक/अष्टक_उत्सर्जक.सूत्र";
आयात "स्वसंकलक/आभासी_यंत्र.सूत्र";

कार्य स्रोत_से_एसवीएम_चलाओ(पाठ स्रोत_कोड) {
    // १. पद विच्छेदन
    सूची पद_सूची = पद_विच्छेदन(स्रोत_कोड);
    
    // २. विश्लेषण (AST)
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश आयातित = {};
    शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित, "परीक्षण.सूत्र");
    
    // २.५ सार्थक विश्लेषण
    मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
    
    // ३. IR Lowering
    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम_नोड);
    
    // ४. अष्टक-संकेत उत्सर्जक (Bytecode Emitter)
    शब्दकोश एसवीएम_प्रोग्राम = अष्टक_उत्सर्जक_एकक(एकक);
    
    // ५. आभासी यंत्र में निष्पादन (SVM Execution)
    शब्दकोश यंत्र = आभासी_यंत्र_नव(एसवीएम_प्रोग्राम);
    मान फल = आभासी_यंत्र_चलाओ(यंत्र);
    परत् फल;
}

कार्य मुख्य() {
    लिखतु("==================================================");
    लिखतु("  सूत्र स्रोत → IR → अष्टक-संकेत → SVM संपूर्ण परीक्षण");
    लिखतु("==================================================");
    
    // परीक्षण १: साधारण मुद्रण एवं अंकगणित
    लिखतु("\n--- परीक्षण १: अंकगणित एवं मुद्रण ---");
    पाठ कोड१ = "कार्य मुख्य() { मान क = १० + २०; लिखतु(क); परत् क; }";
    मान फल१ = स्रोत_से_एसवीएम_चलाओ(कोड१);
    लिखतु("परीक्षण १ परिणाम: " + फल१);
    यदि (फल१ != ३०) {
        फेको "त्रुटिः परीक्षण १ में अपेक्षित ३०, प्राप्त: " + फल१;
    }
    
    // परीक्षण २: चक्र (While loop)
    लिखतु("\n--- परीक्षण २: यावत् लूप संचायक (१ से ५ का योग) ---");
    पाठ कोड२ = "कार्य मुख्य() { संख्या स = ०; संख्या इ = १; यावत् (इ <= ५) { स = स + इ; इ = इ + १; } लिखतु(स); परत् स; }";
    मान फल२ = स्रोत_से_एसवीएम_चलाओ(कोड२);
    लिखतु("परीक्षण २ परिणाम: " + फल२);
    यदि (फल२ != १५) {
        फेको "त्रुटिः परीक्षण २ में अपेक्षित १५, प्राप्त: " + फल२;
    }
    
    // परीक्षण ३: फलन आह्वान (Function Call & Return)
    लिखतु("\n--- परीक्षण ३: फलन आह्वान एवं प्रत्यावर्तन ---");
    पाठ कोड३ = "कार्य दुगुना(संख्या मानः) { परत् मानः * २; } कार्य मुख्य() { संख्या उ = दुगुना(२१); लिखतु(उ); परत् उ; }";
    मान फल३ = स्रोत_से_एसवीएम_चलाओ(कोड३);
    लिखतु("परीक्षण ३ परिणाम: " + फल३);
    यदि (फल३ != ४२) {
        फेको "त्रुटिः परीक्षण ३ में अपेक्षित ४२, प्राप्त: " + फल३;
    }
    
    // परीक्षण ४: संस्कृत द्वि-अंक विच्छेदन दृश्य
    लिखतु("\n--- परीक्षण ४: अष्टक-संकेत विच्छेदन (Devanagari ०/१ Disassembly) ---");
    सूची पद_सूची = पद_विच्छेदन(कोड१);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश आयातित = {};
    शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित, "परीक्षण.सूत्र");
    मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम_नोड);
    शब्दकोश एसवीएम_प्रोग्राम = अष्टक_उत्सर्जक_एकक(एकक);
    
    सूची मुख्य_आज्ञा = एसवीएम_प्रोग्राम["फलन_मानचित्र"]["मुख्य"]["आज्ञा_सूची"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(मुख्य_आज्ञा)) {
        लिखतु("  " + अष्टक_आज्ञा_विच्छेद(इ, मुख्य_आज्ञा[इ]));
        इ = इ + १;
    }
    
    लिखतु("\n[सफलम्] संपूर्ण स्रोत-से-अष्टक-संकेत SVM निष्पादन सफलम्!");
}
