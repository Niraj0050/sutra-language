// भाषा_परीक्षण/व्याकरण_परीक्षण.सूत्र — पाणिनीय व्याकरण एवं संगणकीय प्रज्ञा परीक्षण
// ============================================================
// १. माहेश्वर-सूत्राणि एवं प्रत्याहार परीक्षण (अच्, इक्, यण्, अक्, जश् आदि)
// २. अच-संधि संयोजन परीक्षण (दीर्घ, गुण, वृद्धि, यण्, अयादि)
// ============================================================

आयात "पुस्तकालय/व्याकरण.सूत्र";

कार्य परीक्षण_माहेश्वर_एवं_प्रत्याहार() {
    लिखतु("=== १. माहेश्वर-सूत्राणि एवं प्रत्याहार परीक्षण ===");
    
    // अच् (समस्त स्वराः)
    सूची अच् = प्रत्याहार_वर्ण_सूची("अच्");
    लिखतु("प्रत्याहार 'अच्' (स्वराः): " + संयोजित(अच्, ", "));
    यदि (लंबाई(अच्) != ९) {
        फेको "त्रुटिः अच् प्रत्याहार में ९ वर्ण अपेक्षित, प्राप्त: " + लंबाई(अच्);
    }
    
    // इक्
    सूची इक् = प्रत्याहार_वर्ण_सूची("इक्");
    लिखतु("प्रत्याहार 'इक्': " + संयोजित(इक्, ", "));
    यदि (लंबाई(इक्) != ४) {
        फेको "त्रुटिः इक् प्रत्याहार में ४ वर्ण अपेक्षित, प्राप्त: " + लंबाई(इक्);
    }
    
    // यण् (अन्तःस्थाः — य, व, र, ल)
    सूची यण् = प्रत्याहार_वर्ण_सूची("यण्");
    लिखतु("प्रत्याहार 'यण्': " + संयोजित(यण्, ", "));
    यदि (लंबाई(यण्) != ४) {
        फेको "त्रुटिः यण् प्रत्याहार में ४ वर्ण अपेक्षित, प्राप्त: " + लंबाई(यण्);
    }
    
    // अक् (मूल स्वराः — अ, इ, उ, ऋ, ऌ)
    सूची अक् = प्रत्याहार_वर्ण_सूची("अक्");
    लिखतु("प्रत्याहार 'अक्': " + संयोजित(अक्, ", "));
    यदि (लंबाई(अक्) != ५) {
        फेको "त्रुटिः अक् प्रत्याहार में ५ वर्ण अपेक्षित, प्राप्त: " + लंबाई(अक्);
    }
    
    // जश् (तृतीय वर्णाः — ज, ब, ग, ड, द)
    सूची जश् = प्रत्याहार_वर्ण_सूची("जश्");
    लिखतु("प्रत्याहार 'जश्': " + संयोजित(जश्, ", "));
    यदि (लंबाई(जश्) != ५) {
        फेको "त्रुटिः जश् प्रत्याहार में ५ वर्ण अपेक्षित, प्राप्त: " + लंबाई(जश्);
    }
    
    // प्रत्याहारे_अस्ति जाँच
    यदि (न प्रत्याहारे_अस्ति("अच्", "इ")) { फेको "त्रुटिः 'इ' अच् में होना चाहिए।"; }
    यदि (न प्रत्याहारे_अस्ति("यण्", "य")) { फेको "त्रुटिः 'य' यण् में होना चाहिए।"; }
    यदि (प्रत्याहारे_अस्ति("अक्", "ए")) { फेको "त्रुटिः 'ए' अक् में नहीं होना चाहिए।"; }
    
    लिखतु("माहेश्वर-सूत्राणि एवं प्रत्याहार: [सफल]");
}

कार्य परीक्षण_संधि_संयोजन() {
    लिखतु("\n=== २. पाणिनीय अच-संधि संयोजन परीक्षण ===");
    
    // १. दीर्घ संधि (अकः सवर्णे दीर्घः)
    लिखतु("\n-- दीर्घ संधि (६.१.१०१) --");
    पाठ स१ = संधि_संयोजन("हिम", "आलय");
    लिखतु("  हिम + आलय = " + स१);
    यदि (स१ != "हिमालय") { फेको "त्रुटिः हिम + आलय != हिमालय, प्राप्त: " + स१; }
    
    पाठ स२ = संधि_संयोजन("विद्या", "अर्थी");
    लिखतु("  विद्या + अर्थी = " + स२);
    यदि (स२ != "विद्यार्थी") { फेको "त्रुटिः विद्या + अर्थी != विद्यार्थी, प्राप्त: " + स२; }
    
    पाठ स३ = संधि_संयोजन("कवि", "इन्द्र");
    लिखतु("  कवि + इन्द्र = " + स३);
    यदि (स३ != "कवीन्द्र") { फेको "त्रुटिः कवि + इन्द्र != कवीन्द्र, प्राप्त: " + स३; }
    
    पाठ स४ = संधि_संयोजन("भानु", "उदय");
    लिखतु("  भानु + उदय = " + स४);
    यदि (स४ != "भानूदय") { फेको "त्रुटिः भानु + उदय != भानूदय, प्राप्त: " + स४; }
    
    // २. गुण संधि (आद्गुणः)
    लिखतु("\n-- गुण संधि (६.१.८७) --");
    पाठ स५ = संधि_संयोजन("देव", "इन्द्र");
    लिखतु("  देव + इन्द्र = " + स५);
    यदि (स५ != "देवेन्द्र") { फेको "त्रुटिः देव + इन्द्र != देवेन्द्र, प्राप्त: " + स५; }
    
    पाठ स६ = संधि_संयोजन("सूर्य", "उदय");
    लिखतु("  सूर्य + उदय = " + स६);
    यदि (स६ != "सूर्योदय") { फेको "त्रुटिः सूर्य + उदय != सूर्योदय, प्राप्त: " + स६; }
    
    पाठ स७ = संधि_संयोजन("महा", "उत्सव");
    लिखतु("  महा + उत्सव = " + स७);
    यदि (स७ != "महोत्सव") { फेको "त्रुटिः महा + उत्सव != महोत्सव, प्राप्त: " + स७; }
    
    // ३. वृद्धि संधि (वृद्धिरेचि)
    लिखतु("\n-- वृद्धि संधि (६.१.८८) --");
    पाठ स८ = संधि_संयोजन("एक", "एकम्");
    लिखतु("  एक + एकम् = " + स८);
    यदि (स८ != "एकैकम्") { फेको "त्रुटिः एक + एकम् != एकैकम्, प्राप्त: " + स८; }
    
    पाठ स९ = संधि_संयोजन("सदा", "एव");
    लिखतु("  सदा + एव = " + स९);
    यदि (स९ != "सदैव") { फेको "त्रुटिः सदा + एव != सदैव, प्राप्त: " + स९; }
    
    पाठ स१० = संधि_संयोजन("महा", "औषधि");
    लिखतु("  महा + औषधि = " + स१०);
    यदि (स१० != "महौषधि") { फेको "त्रुटिः महा + औषधि != महौषधि, प्राप्त: " + स१०; }
    
    // ४. यण् संधि (इको यणचि)
    लिखतु("\n-- यण् संधि (६.१.७७) --");
    पाठ स११ = संधि_संयोजन("प्रति", "एक");
    लिखतु("  प्रति + एक = " + स११);
    यदि (स११ != "प्रत्येक") { फेको "त्रुटिः प्रति + एक != प्रत्येक, प्राप्त: " + स११; }
    
    पाठ स१२ = संधि_संयोजन("यदि", "अपि");
    लिखतु("  यदि + अपि = " + स१२);
    यदि (स१२ != "यद्यपि") { फेको "त्रुटिः यदि + अपि != यद्यपि, प्राप्त: " + स१२; }
    
    पाठ स१३ = संधि_संयोजन("सु", "आगतम्");
    लिखतु("  सु + आगतम् = " + स१३);
    यदि (स१३ != "स्वागतम्") { फेको "त्रुटिः सु + आगतम् != स्वागतम्, प्राप्त: " + स१३; }
    
    पाठ स१४ = संधि_संयोजन("इति", "आदि");
    लिखतु("  इति + आदि = " + स१४);
    यदि (स१४ != "इत्यादि") { फेको "त्रुटिः इति + आदि != इत्यादि, प्राप्त: " + स१४; }
    
    // ५. अयादि संधि (एचोऽयवायावः)
    लिखतु("\n-- अयादि संधि (६.१.७८) --");
    पाठ स१५ = संधि_संयोजन("ने", "अनम्");
    लिखतु("  ने + अनम् = " + स१५);
    यदि (स१५ != "नयनम्") { फेको "त्रुटिः ने + अनम् != नयनम्, प्राप्त: " + स१५; }
    
    पाठ स१६ = संधि_संयोजन("पो", "अनः");
    लिखतु("  पो + अनः = " + स१६);
    यदि (स१६ != "पवनः") { फेको "त्रुटिः पो + अनः != पवनः, प्राप्त: " + स१६; }
    
    पाठ स१७ = संधि_संयोजन("पौ", "अकः");
    लिखतु("  पौ + अकः = " + स१७);
    यदि (स१७ != "पावकः") { फेको "त्रुटिः पौ + अकः != पावकः, प्राप्त: " + स१७; }
    
    लिखतु("\nसंधि संयोजन: [समस्त अच-संधि सूत्राणि सफलाः]");
}

कार्य परीक्षण_हल्_विसर्ग_संधि() {
    लिखतु("\n=== ३. पाणिनीय हल् एवं विसर्ग संधि संयोजन परीक्षण ===");
    
    // १. विसर्ग संधि
    लिखतु("\n-- विसर्ग संधि (सत्व, उत्व, रुत्व) --");
    पाठ व१ = संधि_संयोजन("नमः", "ते");
    लिखतु("  नमः + ते = " + व१);
    यदि (व१ != "नमस्ते") { फेको "त्रुटिः नमः + ते != नमस्ते, प्राप्त: " + व१; }
    
    पाठ व२ = संधि_संयोजन("कः", "चित्");
    लिखतु("  कः + चित् = " + व२);
    यदि (व२ != "कश्चित्") { फेको "त्रुटिः कः + चित् != कश्चित्, प्राप्त: " + व२; }
    
    पाठ व३ = संधि_संयोजन("धनुः", "टंकारः");
    लिखतु("  धनुः + टंकारः = " + व३);
    यदि (व३ != "धनुष्टंकारः") { फेको "त्रुटिः धनुः + टंकारः != धनुष्टंकारः, प्राप्त: " + व३; }
    
    पाठ व४ = संधि_संयोजन("कः", "अपि");
    लिखतु("  कः + अपि = " + व४);
    यदि (व४ != "कोऽपि") { फेको "त्रुटिः कः + अपि != कोऽपि, प्राप्त: " + व४; }
    
    पाठ व५ = संधि_संयोजन("मनः", "हरः");
    लिखतु("  मनः + हरः = " + व५);
    यदि (व५ != "मनोहरः") { फेको "त्रुटिः मनः + हरः != मनोहरः, प्राप्त: " + व५; }
    
    पाठ व६ = संधि_संयोजन("मुनिः", "अयम्");
    लिखतु("  मुनिः + अयम् = " + व६);
    यदि (व६ != "मुनिरयम्") { फेको "त्रुटिः मुनिः + अयम् != मुनिरयम्, प्राप्त: " + व६; }

    // २. हल् संधि
    लिखतु("\n-- हल् (व्यंजन) संधि (श्चुत्व, ष्टुत्व, जश्त्व, चर्त्व, अनुस्वार, अनुनासिक) --");
    पाठ ह१ = संधि_संयोजन("सत्", "चित्");
    लिखतु("  सत् + चित् = " + ह१);
    यदि (ह१ != "सच्चित्") { फेको "त्रुटिः सत् + चित् != सच्चित्, प्राप्त: " + ह१; }
    
    पाठ ह२ = संधि_संयोजन("सत्", "जनः");
    लिखतु("  सत् + जनः = " + ह२);
    यदि (ह२ != "सज्जनः") { फेको "त्रुटिः सत् + जनः != सज्जनः, प्राप्त: " + ह२; }
    
    पाठ ह३ = संधि_संयोजन("तत्", "टीका");
    लिखतु("  तत् + टीका = " + ह३);
    यदि (ह३ != "तट्टीका") { फेको "त्रुटिः तत् + टीका != तट्टीका, प्राप्त: " + ह३; }
    
    पाठ ह४ = संधि_संयोजन("वाक्", "ईशः");
    लिखतु("  वाक् + ईशः = " + ह४);
    यदि (ह४ != "वागीशः") { फेको "त्रुटिः वाक् + ईशः != वागीशः, प्राप्त: " + ह४; }
    
    पाठ ह५ = संधि_संयोजन("जगत्", "ईशः");
    लिखतु("  जगत् + ईशः = " + ह५);
    यदि (ह५ != "जगदीशः") { फेको "त्रुटिः जगत् + ईशः != जगदीशः, प्राप्त: " + ह५; }
    
    पाठ ह६ = संधि_संयोजन("दिक्", "गजः");
    लिखतु("  दिक् + गजः = " + ह६);
    यदि (ह६ != "दिग्गजः") { फेको "त्रुटिः दिक् + गजः != दिग्गजः, प्राप्त: " + ह६; }
    
    पाठ ह७ = संधि_संयोजन("अच्", "अन्तः");
    लिखतु("  अच् + अन्तः = " + ह७);
    यदि (ह७ != "अजन्तः") { फेको "त्रुटिः अच् + अन्तः != अजन्तः, प्राप्त: " + ह७; }
    
    पाठ ह८ = संधि_संयोजन("सद्", "कारः");
    लिखतु("  सद् + कारः = " + ह८);
    यदि (ह८ != "सत्कारः") { फेको "त्रुटिः सद् + कारः != सत्कारः, प्राप्त: " + ह८; }
    
    पाठ ह९ = संधि_संयोजन("जगत्", "नाथः");
    लिखतु("  जगत् + नाथः = " + ह९);
    यदि (ह९ != "जगन्नाथः") { फेको "त्रुटिः जगत् + नाथः != जगन्नाथः, प्राप्त: " + ह९; }
    
    पाठ ह१० = संधि_संयोजन("सम्", "कल्पः");
    लिखतु("  सम् + कल्पः = " + ह१०);
    यदि (ह१० != "संकल्पः") { फेको "त्रुटिः सम् + कल्पः != संकल्पः, प्राप्त: " + ह१०; }
    
    लिखतु("\nहल् एवं विसर्ग संधि: [समस्त सूत्राणि सफलाः]");
}

कार्य परीक्षण_संधि_विच्छेद() {
    लिखतु("\n=== ४. पाणिनीय संधि-विच्छेद परीक्षण ===");
    
    // १. दीर्घ विच्छेद
    सूची वि१ = संधि_विच्छेद("हिमालय");
    मान मिला१ = असत्य;
    संख्या इ = ०;
    यावत् (इ < लंबाई(वि१)) {
        यदि (वि१[इ]["पूर्व"] == "हिम" && वि१[इ]["पर"] == "आलय") { मिला१ = सत्य; }
        इ = इ + १;
    }
    लिखतु("  हिमालय विच्छेद (हिम + आलय): " + मिला१);
    यदि (न मिला१) { फेको "त्रुटिः हिमालय का 'हिम + आलय' विच्छेद न लब्धम्"; }
    
    // २. यण् विच्छेद
    सूची वि२ = संधि_विच्छेद("प्रत्येक");
    मान मिला२ = असत्य;
    इ = ०;
    यावत् (इ < लंबाई(वि२)) {
        यदि (वि२[इ]["पूर्व"] == "प्रति" && वि२[इ]["पर"] == "एक") { मिला२ = सत्य; }
        इ = इ + १;
    }
    लिखतु("  प्रत्येक विच्छेद (प्रति + एक): " + मिला२);
    यदि (न मिला२) { फेको "त्रुटिः प्रत्येक का 'प्रति + एक' विच्छेद न लब्धम्"; }
    
    // ३. यण् (व) विच्छेद
