// भाषा_परीक्षण/सूत्रक_कंटेनर_परीक्षण.सूत्र
// ============================================================
// सूत्र अष्टक-संकेत संप्रभु बाइनरी पात्र (.सूत्रक) सत्यापन सूट
// १. बाइनरी पात्र संश्लेषण एवं पार्स राउंडट्रिप
// २. डिस्क सञ्चिका लेखन एवं पठन चक्र
// ३. आभासी यंत्र (SVM) में लोड किए गए .सूत्रक का प्रत्यक्ष निष्पादन
// ४. सूत्र स्रोत से .सूत्रक उत्सर्जन एवं निष्पादन
// ============================================================

आयात "स्वसंकलक/अष्टक_संकेत.सूत्र";
आयात "स्वसंकलक/आभासी_यंत्र.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  🕉️ सूत्र अष्टक-संकेत (.सूत्रक) बाइनरी पात्र सत्यापन");
    लिखतु("============================================================\n");

    संख्या कुल_सफल = ०;

    // --- परीक्षण १: संश्लेषण एवं पार्स राउंडट्रिप ---
    लिखतु("--- परीक्षण १: बाइनरी पात्र संश्लेषण एवं पार्स राउंडट्रिप ---");
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["जादुई_संकेत"] = "सूत्र";
    प्रोग्राम["संस्करण"] = "१.०";
    प्रोग्राम["लक्ष्य_यंत्र"] = "सार्वत्रिक";
    प्रोग्राम["प्रारंभ_फलन"] = "मुख्य";

    सूची आज्ञाएं = [];
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, १, -१, -१, ५००));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, २, -१, -१, २५०));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_योग, ३, १, २, शून्यम्));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, ३, -१, शून्यम्));

    शब्दकोश फलन_मानचित्र = {};
    शब्दकोश मुख्य_फलन = {};
    मुख्य_फलन["नाम"] = "मुख्य";
    मुख्य_फलन["पैरामीटर_गणना"] = ०;
    मुख्य_फलन["आज्ञा_सूची"] = आज्ञाएं;
    फलन_मानचित्र["मुख्य"] = मुख्य_फलन;
    प्रोग्राम["फलन_मानचित्र"] = फलन_मानचित्र;

    पाठ पात्र_पाठ = अष्टक_कंटेनर_संश्लेषण(प्रोग्राम);
    सत्यापित_करो(खोजें(पात्र_पाठ, "जादुई: सूत्र") >= ०, "जादुई संकेत उपस्थित");
    सत्यापित_करो(खोजें(पात्र_पाठ, "संस्करण: १.०") >= ०, "संस्करण देवनागरी १.०");
    सत्यापित_करो(खोजें(पात्र_पाठ, ".फलन: मुख्य | ०") >= ०, "फलन घोषणा देवनागरी ०");
    सत्यापित_करो(खोजें(पात्र_पाठ, "संख्या:५००") >= ०, "स्थिरांक ५०० देवनागरी रूप");

    शब्दकोश पार्स_प्रोग्राम = अष्टक_कंटेनर_पार्स(पात्र_पाठ);
    सत्यापित_करो(पार्स_प्रोग्राम["जादुई_संकेत"] == "सूत्र", "पार्स जादुई संकेत शुद्ध");
    सत्यापित_करो(पार्स_प्रोग्राम["संस्करण"] == "१.०", "पार्स संस्करण शुद्ध");
    सत्यापित_करो(पार्स_प्रोग्राम["प्रारंभ_फलन"] == "मुख्य", "पार्स प्रारंभ फलन शुद्ध");
    
    शब्दकोश पार्स_फलन_मानचित्र = पार्स_प्रोग्राम["फलन_मानचित्र"];
    शब्दकोश पार्स_मुख्य = पार्स_फलन_मानचित्र["मुख्य"];
    सत्यापित_करो(पार्स_मुख्य != शून्यम्, "मुख्य फलन उपस्थित");
    सूची पार्स_आज्ञा = पार्स_मुख्य["आज्ञा_सूची"];
    सत्यापित_करो(लंबाई(पार्स_आज्ञा) == ४, "आज्ञा गणना ४ शुद्ध");
    शब्दकोश जाँच_आज्ञा_० = पार्स_आज्ञा[०];
    सत्यापित_करो(जाँच_आज्ञा_०["कूट"] == आज्ञा_स्थिर, "आज्ञा ० कूट स्थिर");
    सत्यापित_करो(जाँच_आज्ञा_०["लक्ष्य"] == १, "आज्ञा ० लक्ष्य क१");
    सत्यापित_करो(जाँच_आज्ञा_०["स्थिरांक"] == ५००, "आज्ञा ० मान ५००");
    लिखतु("  [सफल] परीक्षण १ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण २: डिस्क सञ्चिका लेखन एवं पठन चक्र ---
    लिखतु("--- परीक्षण २: डिस्क सञ्चिका लेखन एवं पुनः लोड चक्र ---");
    पाठ मार्गः = "भाषा_परीक्षण/परीक्षण_अस्थायी.सूत्रक";
    अष्टक_सञ्चिका_सहेजें(पार्स_प्रोग्राम, मार्गः);
    सत्यापित_करो(सञ्चिका_अस्ति(मार्गः), "डिस्क पर .सूत्रक सञ्चिका निर्मित");

    शब्दकोश लोड_प्रोग्राम = अष्टक_सञ्चिका_लोड(मार्गः);
    सत्यापित_करो(लोड_प्रोग्राम["जादुई_संकेत"] == "सूत्र", "लोड जादुई संकेत शुद्ध");
    शब्दकोश लोड_फलन = लोड_प्रोग्राम["फलन_मानचित्र"]["मुख्य"];
    सत्यापित_करो(लंबाई(लोड_फलन["आज्ञा_सूची"]) == ४, "लोड की गई आज्ञा गणना ४");
    लिखतु("  [सफल] परीक्षण २ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ३: आभासी यंत्र (SVM) में लोड किए गए प्रोग्राम का निष्पादन ---
    लिखतु("--- परीक्षण ३: SVM में लोड किए गए प्रोग्राम का प्रत्यक्ष निष्पादन ---");
    शब्दकोश यंत्र = आभासी_यंत्र_नव(लोड_प्रोग्राम);
    मान फल = आभासी_यंत्र_चलाओ(यंत्र);
    सत्यापित_करो(फल == ७५०, "अंकगणित निष्पादन फल (५०० + २५० = ७५०)");
    लिखतु("  [सफल] परीक्षण ३ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ४: सूत्र स्रोत से .सूत्रक उत्सर्जन एवं निष्पादन ---
    लिखतु("--- परीक्षण ४: स्रोत से .सूत्रक उत्सर्जन एवं निष्पादन ---");
    पाठ स्रोत_मार्ग = "भाषा_परीक्षण/compiler/01_hello.सूत्र";
    पाठ हैलो_सूत्रक = "भाषा_परीक्षण/01_hello.सूत्रक";
    कमांड_चलाओ(".\\sutra_svm.exe --उत्सर्जन " + स्रोत_मार्ग + " " + हैलो_सूत्रक);
    सत्यापित_करो(सञ्चिका_अस्ति(हैलो_सूत्रक), "01_hello.सूत्रक सञ्चिका उपस्थित");
    शब्दकोश हैलो_प्रोग्राम = अष्टक_सञ्चिका_लोड(हैलो_सूत्रक);
    सत्यापित_करो(हैलो_प्रोग्राम["प्रारंभ_फलन"] == "मुख्य", "हैलो प्रारंभ फलन मुख्य");
    शब्दकोश हैलो_यंत्र = आभासी_यंत्र_नव(हैलो_प्रोग्राम);
    मान हैलो_फल = आभासी_यंत्र_चलाओ(हैलो_यंत्र);
    लिखतु("  ✓ हैलो .सूत्रक SVM में सफलतापूर्वक निष्पादित");
    लिखतु("  [सफल] परीक्षण ४ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    लिखतु("============================================================");
    लिखतु("  सकल परीक्षण: ४  |  सफल: " + अष्टक_संख्या_देवनागरी(कुल_सफल) + "  |  विफल: ०");
    लिखतु("  [सफल] सूत्र अष्टक-संकेत (.सूत्रक) बाइनरी पात्र पूर्णतः प्रमाणित!");
    लिखतु("============================================================");
}
