// भाषा_परीक्षण/दृश्यक_परीक्षण.सूत्र
// ============================================================
// सूत्र "दृश्यक" — एकीकृत द्वि-आयामी एवं त्रि-आयामी स्थानिक दृश्य परीक्षण
// (Unified 2D + 3D Spatial Engine Test Suite — Zero HTML/CSS/JS)
//
// १. २डी अर्थगत घटक एवं १-पास विश्लेषणात्मक लेआउट (2D UI Layout)
// २. ३डी स्थानिक गणित, ४x४ आव्यूह एवं रूपांतरण (3D Math & Matrix Transforms)
// ३. ३डी घन जाल निर्माण एवं सूचकांक (3D Mesh Geometry)
// ४. एकीकृत स्थानिक दृश्य-ग्राफ़ (Unified 2D + 3D Scene Graph)
// ५. प्रत्यक्ष स्क्रीन प्रक्षेपण एवं चित्रांकन आदेश प्रवाह (Draw Orders)
// ============================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  सूत्र 'दृश्यक' एकीकृत २डी + ३डी स्थानिक दृश्य परीक्षण");
    लिखतु("  (Eliminating Traditional HTML, CSS, and JS)");
    लिखतु("============================================================\n");

    // ------------------------------------------------------------
    // परीक्षण १: २डी अर्थगत घटक एवं १-पास लेआउट (No CSS Reflows)
    // ------------------------------------------------------------
    लिखतु("--- परीक्षण १: २डी अर्थगत घटक एवं १-पास लेआउट ---");
    शब्दकोश शीर्षक = दृश्यक_लेख("सूत्र वित्तीय डैशबोर्ड", { "आकार": २४.०, "रंग": "#ffffff" });
    शब्दकोश बटन१ = दृश्यक_बटन("सहेजें", "क्रिया_सहेजें", { "पृष्ठ_रंग": "#10b981" });
    शब्दकोश बटन२ = दृश्यक_बटन("रद्द", "क्रिया_रद्द", { "पृष्ठ_रंग": "#ef4444" });

    शब्दकोश बटन_पंक्ति = दृश्यक_डिब्बा({ "दिशा": "पंक्ति", "अंतर": १०.० }, [बटन१, बटन२]);
    शब्दकोश जड़ = दृश्यक_डिब्बा({ "दिशा": "स्तंभ", "पैडिंग": २०.०, "अंतर": १५.० }, [शीर्षक, बटन_पंक्ति]);

    // ८००x६०० स्क्रीन पर १-पास विश्लेषणात्मक लेआउट
    दृश्यक_२डी_लेआउट(जड़, ०.०, ०.०, ८००.०, ६००.०);

    सत्यापित_करो(जड़["स्थान"][२] == ८००.०, "जड़ डिब्बा चौड़ाई ८००.०");
    सत्यापित_करो(जड़["स्थान"][३] == ६००.०, "जड़ डिब्बा ऊँचाई ६००.०");
    सत्यापित_करो(शीर्षक["स्थान"][०] == २०.०, "शीर्षक बाएँ पैडिंग २०.०");
    सत्यापित_करो(शीर्षक["स्थान"][१] == २०.०, "शीर्षक ऊपर पैडिंग २०.०");
    सत्यापित_करो(बटन१["स्थान"][०] == २०.०, "बटन १ बाएँ स्थिति २०.०");
    सत्यापित_करो(बटन२["स्थान"][०] > बटन१["स्थान"][०], "बटन २ पंक्ति में बटन १ के दाईं ओर");
    लिखतु("  [सफल] २डी अर्थगत बॉक्स लेआउट बिना CSS कैस्केड के १००% सटीक।");

    // ------------------------------------------------------------
    // परीक्षण २: ३डी स्थानिक गणित, ४x४ आव्यूह एवं रूपांतरण
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण २: ३डी स्थानिक गणित एवं ४x४ आव्यूह रूपांतरण ---");
    // अनुवाद आव्यूह (Translation Matrix [10, 20, 30])
    सूची अनुवाद_म = दृश्यक_आव्यूह४_अनुवाद(१०.०, २०.०, ३०.०);
    सूची मूल_बिंदु = दृश्यक_सदिश३(१.०, २.०, ३.०);
    सूची रूपांतरित = दृश्यक_सदिश३_रूपांतरण(अनुवाद_म, मूल_बिंदु);

    सत्यापित_करो(रूपांतरित[०] == ११.०, "सदिश अनुवाद क्ष (१+१० = ११)");
    सत्यापित_करो(रूपांतरित[१] == २२.०, "सदिश अनुवाद य (२+२० = २२)");
    सत्यापित_करो(रूपांतरित[२] == ३३.०, "सदिश अनुवाद ज्ञ (३+३० = ३३)");

    // पैमाना आव्यूह (Scale Matrix [2, 3, 4])
    सूची पैमाना_म = दृश्यक_आव्यूह४_पैमाना(२.०, ३.०, ४.०);
    सूची पैमाना_बिंदु = दृश्यक_सदिश३_रूपांतरण(पैमाना_म, मूल_बिंदु);

    सत्यापित_करो(पैमाना_बिंदु[०] == २.०, "सदिश पैमाना क्ष (१*२ = २)");
    सत्यापित_करो(पैमाना_बिंदु[१] == ६.०, "सदिश पैमाना य (२*३ = ६)");
    सत्यापित_करो(पैमाना_बिंदु[२] == १२.०, "सदिश पैमाना ज्ञ (३*४ = १२)");

    // आव्यूह गुणन (संयुक्त रूपांतरण: पैमाना + अनुवाद)
    सूची संयुक्त_म = दृश्यक_आव्यूह४_गुणन(अनुवाद_म, पैमाना_म);
    सूची संयुक्त_बिंदु = दृश्यक_सदिश३_रूपांतरण(संयुक्त_म, मूल_बिंदु);

    // संयुक्त आव्यूह रूपांतरण बिंदु जांच
    सत्यापित_करो(संयुक्त_बिंदु[०] == १२.०, "संयुक्त आव्यूह रूपांतरण क्ष (१*२ + १० = १२)");
    सत्यापित_करो(संयुक्त_बिंदु[१] == २६.०, "संयुक्त आव्यूह रूपांतरण य (२*३ + २० = २६)");
    सत्यापित_करो(संयुक्त_बिंदु[२] == ४२.०, "संयुक्त आव्यूह रूपांतरण ज्ञ (३*४ + ३० = ४२)");
    लिखतु("  [सफल] ३डी ४x४ आव्यूह बीजगणित एवं संयुक्त रूपांतरण सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण ३: ३डी घन जाल निर्माण एवं ज्यामिति
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ३: ३डी घन जाल निर्माण एवं ज्यामिति ---");
    शब्दकोश घन = दृश्यक_घन_जाल(२.०);

    सत्यापित_करो(घन["कुल_शीर्ष"] == ८, "घन में ८ शीर्ष बिन्दु");
    सत्यापित_करो(घन["कुल_त्रिकोण"] == १२, "घन में १२ त्रिकोण फलक (६ फलक * २ त्रिकोण)");
    सत्यापित_करो(लंबाई(घन["सूचकांक"]) == ३६, "घन में कुल ३६ सूचकांक (12 * 3)");
    लिखतु("  [सफल] ३डी जाल ज्यामिति एवं सूचकांक बफर १००% प्रामाणिक।");

    // ------------------------------------------------------------
    // परीक्षण ४: एकीकृत स्थानिक दृश्य-ग्राफ़ (Unified 2D + 3D Scene)
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ४: एकीकृत स्थानिक दृश्य-ग्राफ़ ---");
    शब्दकोश दृश्य = दृश्यक_दृश्य_बनाओ();

    // ३डी घन को (०, ०, ५) पर दृश्य में जोड़ना
    सूची घन_रूपांतरण = दृश्यक_आव्यूह४_अनुवाद(०.०, ०.०, ५.०);
    शब्दकोश स्थानिक_वस्तु = दृश्यक_स्थानिक_वस्तु("केंद्रीय_घन", घन, घन_रूपांतरण, "#ff0055");
    दृश्यक_वस्तु_जोड़ो(दृश्य, स्थानिक_वस्तु);

    // २डी यूआई को ३डी दृश्य में ओवरले के रूप में जोड़ना
    दृश्यक_यूआई_जोड़ो(दृश्य, जड़);

    सत्यापित_करो(लंबाई(दृश्य["३डी_वस्तु_सूची"]) == १, "दृश्य में १ त्रि-आयामी वस्तु उपस्थित");
    सत्यापित_करो(दृश्य["२डी_यूआई_जड़"] != शून्यम्, "दृश्य में द्वि-आयामी यूआई ओवरले उपस्थित");
    लिखतु("  [सफल] एकीकृत २डी + ३डी स्थानिक दृश्य-ग्राफ़ संयोजन संपन्न।");

    // ------------------------------------------------------------
    // परीक्षण ५: प्रत्यक्ष स्क्रीन प्रक्षेपण एवं चित्रांकन आदेश
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ५: प्रत्यक्ष स्क्रीन प्रक्षेपण एवं चित्रांकन आदेश ---");
    सूची आदेश_सूची = दृश्यक_चौखटा_आदेश(दृश्य, ८००.०, ६००.०);

    सत्यापित_करो(लंबाई(आदेश_सूची) == २, "चौखटा आदेश में २ प्राथमिक स्तर (३डी जाल + २डी यूआई)");

    शब्दकोश आदेश_३डी = आदेश_सूची[०];
    सत्यापित_करो(आदेश_३डी["प्रकार"] == "३डी_जाल", "प्रथम आदेश: ३डी जाल चित्रांकन");
    सत्यापित_करो(लंबाई(आदेश_३डी["प्रक्षेपित_शीर्ष"]) == ८, "८ शीर्षों का २डी स्क्रीन पर प्रक्षेपण पूर्ण");
    सत्यापित_करो(आदेश_३डी["रंग"] == "#ff0055", "३डी जाल सामग्री रंग '#ff0055'");

    शब्दकोश आदेश_२डी = आदेश_सूची[१];
    सत्यापित_करो(आदेश_२डी["प्रकार"] == "२डी_यूआई", "द्वितीय आदेश: २डी यूआई चित्रांकन");
    सत्यापित_करो(आदेश_२डी["जड़"]["स्थान"][२] == ८००.०, "२डी यूआई व्यूपोर्ट चौड़ाई ८००.०");
    लिखतु("  [सफल] शून्य-डीओएम प्रत्यक्ष स्क्रीन चित्रांकन आदेश प्रवाह सफल।");

    लिखतु("\n============================================================");
    लिखतु("  [सर्वं सम्यक्] सूत्र 'दृश्यक' २डी + ३डी स्थानिक इंजन १००% सत्यापितम्!");
    लिखतु("  (HTML, CSS, JS Eliminating Unified Spatial Engine Complete)");
    लिखतु("============================================================");
}

मुख्य();
