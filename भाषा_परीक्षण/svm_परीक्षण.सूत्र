// svm_परीक्षण.सूत्र — सूत्र आभासी यंत्र (SVM) एवं अष्टक-संकेत परीक्षण
// ============================================================
// १. अष्टक-संकेत में ० और १ का द्वि-अंक प्रतिनिधित्व
// २. आभासी यंत्र (SVM) में अंकगणित, तुलना, लूप, और फलन निष्पादन
// ३. संकर निष्पादन (Hybrid Model) जाँच
// ============================================================

आयात "स्वसंकलक/अष्टक_संकेत.सूत्र";
आयात "स्वसंकलक/आभासी_यंत्र.सूत्र";

कार्य परीक्षण_द्विअंक_संस्कृत() {
    लिखतु("=== १. संस्कृत द्वि-अंक (० एवं १) परीक्षण ===");
    
    // ५ = ०००००१०१
    पाठ ब५ = संख्या_से_द्विअंक_अष्टक(५);
    लिखतु("संख्या ५ का अष्टक: " + ब५);
    यदि (ब५ != "०००००१०१") {
        फेको "त्रुटिः संख्या_से_द्विअंक_अष्टक(५) अपेक्षित ०००००१०१, प्राप्त: " + ब५;
    }
    
    // २५५ = ११११११११
    पाठ ब२५५ = संख्या_से_द्विअंक_अष्टक(२५५);
    लिखतु("संख्या २५५ का अष्टक: " + ब२५५);
    यदि (ब२५५ != "११११११११") {
        फेको "त्रुटिः संख्या_से_द्विअंक_अष्टक(२५५) अपेक्षित ११११११११, प्राप्त: " + ब२५५;
    }
    
    // द्विअंक से पुनः संख्या
    संख्या स५ = द्विअंक_अष्टक_से_संख्या(ब५);
    यदि (स५ != ५) {
        फेको "त्रुटिः द्विअंक_अष्टक_से_संख्या अपेक्षित ५, प्राप्त: " + स५;
    }
    
    संख्या स२५५ = द्विअंक_अष्टक_से_संख्या(ब२५५);
    यदि (स२५५ != २५५) {
        फेको "त्रुटिः द्विअंक_अष्टक_से_संख्या अपेक्षित २५५, प्राप्त: " + स२५५;
    }
    
    लिखतु("द्वि-अंक राउंड-ट्रिप: [सफल]");
}

कार्य परीक्षण_आभासी_यंत्र_अंकगणित() {
    लिखतु("\n=== २. सूत्र आभासी यंत्र (SVM) अंकगणित परीक्षण ===");
    
    // प्रोग्राम:
    // क१ = १०
    // क२ = २०
    // क३ = क१ + क२  (३०)
    // छापो(क३)
    // क४ = क३ * २   (६०)
    // छापो(क४)
    // वापस क४
    
    सूची आज्ञा_सूची = [];
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, १, -१, -१, १०));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, २, -१, -१, २०));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_योग, ३, १, २, शून्यम्));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_छापो, -१, ३, -१, शून्यम्));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, ४, -१, -१, २));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_गुणा, ५, ३, ४, शून्यम्));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_छापो, -१, ५, -१, शून्यम्));
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, ५, -१, शून्यम्));
    
    लिखतु("विच्छेदक दृश्य:");
    संख्या इ = ०;
    यावत् (इ < लंबाई(आज्ञा_सूची)) {
        लिखतु("  " + अष्टक_आज्ञा_विच्छेद(इ, आज्ञा_सूची[इ]));
        इ = इ + १;
    }
    
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["फलन_मानचित्र"] = {
        "मुख्य": { "आज्ञा_सूची": आज्ञा_सूची }
    };
    
    लिखतु("\nSVM निष्पादन परिणाम:");
    शब्दकोश यंत्र = आभासी_यंत्र_नव(प्रोग्राम);
    मान अंतिम = आभासी_यंत्र_चलाओ(यंत्र);
    लिखतु("अंतिम परत् मान: " + अष्टक_मान_देवनागरी(अंतिम));
    
    यदि (अंतिम != ६०) {
        फेको "त्रुटिः SVM अंकगणित अपेक्षित ६०, प्राप्त: " + अंतिम;
    }
    लिखतु("SVM अंकगणित: [सफल]");
}

कार्य परीक्षण_आभासी_यंत्र_लूप() {
    लिखतु("\n=== ३. सूत्र आभासी यंत्र (SVM) लूप एवं संचायक परीक्षण ===");
    
    // लूप: १ से ५ तक का योग (१+२+३+४+५ = १५)
    // क० (सूचक) = १
    // क१ (सीमा) = ५
    // क२ (योगफल) = ०
    // क३ (वृद्धि) = १
    //
    // पता ४: क४ = (क० <= क१)
    // पता ५: यदि_न_जाओ क४ -> पता १० (लूप बाहर)
    // पता ६: क२ = क२ + क०
    // पता ७: क० = क० + क३
    // पता ८: जाओ -> पता ४
    // पता ९: (अप्रयुक्त)
    // पता १०: छापो(क२)
    // पता ११: वापस क२
    
    सूची आज्ञा_सूची = [];
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, ०, -१, -१, १));  // क० = १
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, १, -१, -१, ५));  // क१ = ५
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, २, -१, -१, ०));  // क२ = ०
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, ३, -१, -१, १));  // क३ = १
    
    // लूप शीर्ष (पता ४)
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लघुसम, ४, ०, १, शून्यम्)); // क४ = क० <= क१
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_यदि_न_जाओ, -१, ४, ९, शून्यम्)); // यदि असत्य (०) तो पता ९ जाओ
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_योग, २, २, ०, शून्यम्));    // क२ = क२ + क०
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_योग, ०, ०, ३, शून्यम्));    // क० = क० + क३
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_जाओ, -१, ४, -१, शून्यम्));    // जाओ पता ४
    
    // लूप अंत (पता ९)
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_छापो, -१, २, -१, शून्यम्)); // छापो क२
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, २, -१, शून्यम्)); // वापस क२
    
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["फलन_मानचित्र"] = {
        "मुख्य": { "आज्ञा_सूची": आज्ञा_सूची }
    };
    
    शब्दकोश यंत्र = आभासी_यंत्र_नव(प्रोग्राम);
    मान कुल = आभासी_यंत्र_चलाओ(यंत्र);
    लिखतु("१ से ५ तक का योगफल: " + अष्टक_मान_देवनागरी(कुल));
    
    यदि (कुल != १५) {
        फेको "त्रुटिः SVM लूप अपेक्षित १५, प्राप्त: " + कुल;
    }
    लिखतु("SVM लूप निष्पादन: [सफल]");
}

कार्य परीक्षण_संकर_निर्णय() {
    लिखतु("\n=== ४. संकर निष्पादन (Hybrid Execution) निर्णय परीक्षण ===");
    
    // वर्तमान यंत्र का निर्धारण
    पाठ वर्तमान_यंत्र = "x86_64_windows";
    
    // केस १: कोड उसी यंत्र पर संकलित हुआ है (वर्तमान यंत्र == लक्ष्य यंत्र)
    पाठ लक्ष्य_यंत्र_१ = "x86_64_windows";
    लिखतु("परीक्षण १: लक्ष्य यंत्र = " + लक्ष्य_यंत्र_१ + ", वर्तमान = " + वर्तमान_यंत्र);
    यदि (लक्ष्य_यंत्र_१ == वर्तमान_यंत्र) {
        लिखतु("  → [निर्णय]: १ (एकम्) — प्रत्यक्ष मशीन निष्पादन (Direct Native Execution)!");
    } अन्यथा {
        लिखतु("  → [निर्णय]: ० (शून्यम्) — सूत्र आभासी यंत्र (SVM) निष्पादन!");
    }
    
    // केस २: कोड भिन्न यंत्र (उदा. arm64_linux) के लिए लिखा गया था
    पाठ लक्ष्य_यंत्र_२ = "arm64_linux";
    लिखतु("परीक्षण २: लक्ष्य यंत्र = " + लक्ष्य_यंत्र_२ + ", वर्तमान = " + वर्तमान_यंत्र);
    यदि (लक्ष्य_यंत्र_२ == वर्तमान_यंत्र) {
        लिखतु("  → [निर्णय]: १ (एकम्) — प्रत्यक्ष मशीन निष्पादन!");
    } अन्यथा {
        लिखतु("  → [निर्णय]: ० (शून्यम्) — भिन्न यंत्र! सूत्र आभासी यंत्र (SVM) द्वारा निष्पादन!");
    }
    
    // केस ३: सार्वत्रिक अष्टक-संकेत (Universal Bytecode)
    पाठ लक्ष्य_यंत्र_३ = "सार्वत्रिक";
    लिखतु("परीक्षण ३: लक्ष्य यंत्र = " + लक्ष्य_यंत्र_३ + ", वर्तमान = " + वर्तमान_यंत्र);
    यदि (लक्ष्य_यंत्र_३ == "सार्वत्रिक" || लक्ष्य_यंत्र_३ != वर्तमान_यंत्र) {
        लिखतु("  → [निर्णय]: ० (शून्यम्) — सार्वत्रिक कोड! सूत्र आभासी यंत्र (SVM) द्वारा निष्पादन!");
    }
    
    लिखतु("संकर निर्णय तर्क: [सफल]");
}

कार्य मुख्य() {
    लिखतु("==================================================");
    लिखतु("     सूत्र आभासी यंत्र (SVM) संकर परीक्षण सूट");
    लिखतु("==================================================");
    
    परीक्षण_द्विअंक_संस्कृत();
    परीक्षण_आभासी_यंत्र_अंकगणित();
    परीक्षण_आभासी_यंत्र_लूप();
    परीक्षण_संकर_निर्णय();
    
    लिखतु("\n[सर्वं सम्यक्] सूत्र आभासी यंत्र (SVM) एवं संकर निष्पादन पूर्णतः सत्यापितम्!");
}
