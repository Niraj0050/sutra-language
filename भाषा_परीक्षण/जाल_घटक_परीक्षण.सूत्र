// भाषा_परीक्षण/जाल_घटक_परीक्षण.सूत्र — सूत्र संप्रभु जाल-घटक एवं वेब इंजन परीक्षण
// ==============================================================================
// सूत्र जाल-घटक (Sutra Web Components & Reactive State) का पूर्ण सत्यापन:
//   १. प्रतिक्रियाशील अवस्था प्रबंधक (Reactive State & Signals)
//   २. घोषणात्मक जाल घटक (Navbar, Hero, Grid, Card, Input, Table)
//   ३. एकीकृत ३डी अंतःस्थापित कैनवास घटक (Embedded 3D Model Mesh Component)
//   ४. दृश्य संश्लेषण एवं विश्लेषणात्मक लेआउट (Analytical Layout Solving)
//   ५. संवादात्मक घटना प्रेषण (Cart Add, 3D Rotate, Order Confirm)
//   ६. पाणिनीय अर्थगत एसईओ एवं एआई मेटा-ग्राफ़ (Semantic Karaka /अर्थ API)
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "पुस्तकालय/जाल_घटक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        प्रक्षेपः "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

// ------------------------------------------------------------------------------
// परीक्षण १: प्रतिक्रियाशील अवस्था प्रबंधक
// ------------------------------------------------------------------------------
कार्य परीक्षण_प्रतिक्रियाशील_अवस्था() {
    लिखतु("--- परीक्षण १: प्रतिक्रियाशील अवस्था प्रबंधक (Reactive State Store) ---");

    शब्दकोश अवस्था = जाल_अवस्था_रचना({
        "कार्ट_गणना": ०,
        "३डी_कोण": ०,
        "उपयोक्ता": "आर्यभट्ट"
    });

    सत्यापित_करो(जाल_अवस्था_प्राप्त(अवस्था, "कार्ट_गणना", -१) == ०, "प्रारंभिक कार्ट गणना ०");
    सत्यापित_करो(जाल_अवस्था_प्राप्त(अवस्था, "उपयोक्ता", "") == "आर्यभट्ट", "प्रारंभिक उपयोक्ता 'आर्यभट्ट'");

    // अवस्था वृद्धि (Counter Increment)
    संख्या नया_कार्ट = जाल_अवस्था_वृद्धि(अवस्था, "कार्ट_गणना", १);
    सत्यापित_करो(नया_कार्ट == १, "कार्ट वृद्धि के बाद १ हुआ");
    सत्यापित_करो(अवस्था["संस्करण"] == २, "अवस्था संस्करण स्वतः अद्यतन (संस्करण २)");

    // सूचना निर्धारण (Alert / Notification)
    जाल_अवस्था_सूचना_रखो(अवस्था, "उत्पाद सफलतापूर्वक जोड़ा गया", "सफल");
    सत्यापित_करो(अवस्था["सूचना"] == "उत्पाद सफलतापूर्वक जोड़ा गया", "अवस्था सूचना संदेश सम्यक्");
    सत्यापित_करो(अवस्था["सूचना_प्रकार"] == "सफल", "सूचना प्रकार 'सफल'");

    लिखतु("  [सफल] प्रतिक्रियाशील अवस्था प्रबंधन शत-प्रतिशत शुद्ध।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण २: घोषणात्मक जाल घटक निर्माण
// ------------------------------------------------------------------------------
कार्य परीक्षण_घोषणात्मक_घटक() {
    लिखतु("--- परीक्षण २: घोषणात्मक जाल घटक (Navbar, Hero, Grid, Table) ---");

    // १. शीर्षक पट्टी (Navbar)
    शब्दकोश पट्टी = घटक_शीर्षक_पट्टी("सूत्र_हाट", ["मुखपृष्ठ", "उत्पादानि", "सम्पर्कः"], २);
    सत्यापित_करो(पट्टी["प्रकार"] == "डिब्बा", "शीर्षक पट्टी का प्रकार 'डिब्बा'");
    सत्यापित_करो(पट्टी["दिशा"] == "पंक्ति", "शीर्षक पट्टी क्षैतिज दिशा 'पंक्ति'");
    सत्यापित_करो(लंबाई(पट्टी["बच्चे"]) == ५, "शीर्षक पट्टी में लोगो + ३ लिंक + १ कार्ट बैज = ५ बच्चे");

    // २. हीरो खंड (Hero Banner)
    शब्दकोश हीरो = घटक_हीरो_खंड(
        "शून्य-HTML/CSS/JS संप्रभु वेब पोर्टल",
        "१००% शुद्ध सूत्र एवं स्थानिक दृश्य इंजन द्वारा संचालित",
        "अन्वेषणं कुरु",
        "अन्वेषण"
    );
    सत्यापित_करो(हीरो["प्रकार"] == "डिब्बा", "हीरो खंड डिब्बा निर्मित");
    सत्यापित_करो(लंबाई(हीरो["बच्चे"]) == ३, "हीरो खंड में शीर्षक + उपशीर्षक + बटन = ३ बच्चे");

    // ३. उत्पाद पत्र (Product Card)
    शब्दकोश उत्पाद_पत्र = घटक_उत्पाद_पत्र("उ_०१", "सूत्र स्थानिक चश्मा", ४९९९, "३डी होलोग्राफिक विजन", ३००.०);
    सत्यापित_करो(उत्पाद_पत्र["प्रकार"] == "डिब्बा", "उत्पाद पत्र निर्मित");
    सत्यापित_करो(उत्पाद_पत्र["चौड़ाई"] == ३००.०, "उत्पाद पत्र चौड़ाई ३००.०");

    // ४. ग्रिड (Multi-Column Grid)
    शब्दकोश उत्पाद_पत्र२ = घटक_उत्पाद_पत्र("उ_०२", "सूत्र तंत्रिका चिप", ९९९९, "त्रिमूल्य AI प्रोसेसर", ३००.०);
    शब्दकोश ग्रिड = घटक_ग्रिड(२, १६.०, [उत्पाद_पत्र, उत्पाद_पत्र२]);
    सत्यापित_करो(ग्रिड["प्रकार"] == "डिब्बा", "२-स्तंभ ग्रिड निर्मित");
    सत्यापित_करो(लंबाई(ग्रिड["बच्चे"]) == १, "२ उत्पादों की १ पंक्ति");

    // ५. डेटा तालिका (Data Table)
    सूची शीर्षक = ["आईडी", "उत्पाद", "मूल्य", "स्थिति"];
    सूची डेटा = [
        ["उ_०१", "स्थानिक चश्मा", "₹४९९९", "उपलब्ध"],
        ["उ_०२", "तंत्रिका चिप", "₹९९९९", "उपलब्ध"]
    ];
    शब्दकोश तालिका = घटक_डेटा_तालिका(शीर्षक, डेटा, ६००.०);
    सत्यापित_करो(तालिका["प्रकार"] == "डिब्बा", "डेटा तालिका निर्मित");
    सत्यापित_करो(लंबाई(तालिका["बच्चे"]) == ३, "१ शीर्षलेख + २ डेटा पंक्तियाँ = ३ पंक्तियाँ");

    लिखतु("  [सफल] सभी घोषणात्मक जाल घटक शुद्धता से निर्मित।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ३: एकीकृत ३डी स्थानिक जाल घटक
// ------------------------------------------------------------------------------
कार्य परीक्षण_३डी_कैनवास_घटक() {
    लिखतु("--- परीक्षण ३: एकीकृत ३डी अंतःस्थापित कैनवास घटक ---");

    शब्दकोश संकर = घटक_त्रिआयामी_उत्पाद_कैनवास("घन", ५०.०, "#38bdf8", ४५, ३५०.०, २५०.०);
    सत्यापित_करो(कुंजी_है(संकर, "२डी_नोड"), "संकर घटक में २डी नियंत्रक उपस्थित");
    सत्यापित_करो(कुंजी_है(संकर, "त्रिआयामी_वस्तु"), "संकर घटक में त्रि-आयामी वस्तु उपस्थित");

    शब्दकोश वस्तु = संकर["त्रिआयामी_वस्तु"];
    सत्यापित_करो(वस्तु["जाल"]["प्रकार"] == "घन", "३डी वस्तु का जाल प्रकार 'घन'");
    सत्यापित_करो(लंबाई(वस्तु["रूपांतरण"]) == ४, "४x४ रूपांतरण आव्यूह में ४ पंक्तियाँ");
    सत्यापित_करो(लंबाई(वस्तु["रूपांतरण"][०]) == ४, "प्रत्येक पंक्ति में ४ स्तंभ");
    सत्यापित_करो(लंबाई(वस्तु["जाल"]["शीर्ष"]) == ८, "घन जाल में ८ शीर्ष उपस्थित");

    लिखतु("  [सफल] एकीकृत ३डी स्थानिक कैनवास घटक पूर्णतः सज्जित।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ४: दृश्य संश्लेषण एवं विश्लेषणात्मक लेआउट
// ------------------------------------------------------------------------------
कार्य परीक्षण_दृश्य_संश्लेषण() {
    लिखतु("--- परीक्षण ४: दृश्य संश्लेषण एवं विश्लेषणात्मक लेआउट समाधान ---");

    शब्दकोश पट्टी = घटक_शीर्षक_पट्टी("सूत्र_हाट", ["उत्पाद"], ०);
    शब्दकोश उत्पाद = घटक_उत्पाद_पत्र("उ_०१", "स्थानिक चश्मा", ४९९९, "विवरण", ३००.०);
    शब्दकोश दृश्य = जाल_दृश्य_संश्लेषण([पट्टी, उत्पाद], [], १०००.०, ७००.०);

    सत्यापित_करो(कुंजी_है(दृश्य, "२डी_यूआई_जड़"), "संश्लेषित दृश्य में २डी_यूआई_जड़ उपस्थित");
    सत्यापित_करो(कुंजी_है(दृश्य, "३डी_वस्तु_सूची"), "संश्लेषित दृश्य में ३डी_वस्तु_सूची उपस्थित");

    // लेआउट गणना जाँच
    शब्दकोश जड़ = दृश्य["२डी_यूआई_जड़"];
    सत्यापित_करो(जड़["स्थान"][२] == १०००.०, "पटल चौड़ाई १०००.० विश्लेषणात्मक हल");

    लिखतु("  [सफल] विश्लेषणात्मक लेआउट समाधान (Zero-DOM CSS elimination) सफल।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ५: संवादात्मक घटना समाधान
// ------------------------------------------------------------------------------
कार्य परीक्षण_घटना_समाधान() {
    लिखतु("--- परीक्षण ५: संवादात्मक घटना समाधान (Interactive Event Dispatcher) ---");

    शब्दकोश अवस्था = जाल_अवस्था_रचना({
        "कार्ट_गणना": ०,
        "त्रिआयामी_कोण": ०
    });

    // घटना १: "जोड़ें_उ_०१"
    मान फल१ = जाल_घटना_समाधान(अवस्था, "जोड़ें_उ_०१", {});
    सत्यापित_करो(फल१ == सत्य, "कार्ट जोड़ें घटना स्वीकृत");
    सत्यापित_करो(अवस्था["डेटा"]["कार्ट_गणना"] == १, "कार्ट में १ उत्पाद जुड़ा");

    // घटना २: "त्रिआयामी_घुमाएँ"
    मान फल२ = जाल_घटना_समाधान(अवस्था, "त्रिआयामी_घुमाएँ", {});
    सत्यापित_करो(फल२ == सत्य, "३डी घूर्णन घटना स्वीकृत");
    सत्यापित_करो(अवस्था["डेटा"]["त्रिआयामी_कोण"] == १५, "घूर्णन कोण ०° -> १५°");

    // घटना ३: "ऑर्डर_पुष्टि"
    मान फल३ = जाल_घटना_समाधान(अवस्था, "ऑर्डर_पुष्टि", {});
    सत्यापित_करो(फल३ == सत्य, "ऑर्डर पुष्टि घटना स्वीकृत");
    सत्यापित_करो(अवस्था["डेटा"]["कार्ट_गणना"] == ०, "ऑर्डर के उपरांत कार्ट रिक्त (०)");
    सत्यापित_करो(अवस्था["सूचना_प्रकार"] == "सफल", "ऑर्डर पुष्टि सूचना 'सफल'");

    लिखतु("  [सफल] संवादात्मक घटना प्रवाह एवं प्रतिक्रियाशील स्थिति शुद्ध।\n");
}

// ------------------------------------------------------------------------------
// परीक्षण ६: पाणिनीय अर्थगत एसईओ एवं एआई मेटा-ग्राफ़
// ------------------------------------------------------------------------------
कार्य परीक्षण_अर्थगत_एसईओ_ग्राफ़() {
    लिखतु("--- परीक्षण ६: पाणिनीय अर्थगत एसईओ एवं एआई मेटा-ग्राफ़ (/अर्थ API) ---");

    सूची उत्पाद = [
        {"आईडी": "उ_०१", "नाम": "स्थानिक चश्मा", "मूल्य": ४९९९, "विवरण": "होलोग्राफिक विजन"}
    ];
    शब्दकोश ग्राफ़ = जाल_अर्थगत_ग्राफ़("सूत्र_हाट", उत्पाद, १);

    सत्यापित_करो(ग्राफ़["संस्थान_कर्ता"] == "सूत्र_हाट", "संस्थान कर्ता 'सूत्र_हाट'");
    सत्यापित_करो(ग्राफ़["वर्तमान_सत्र_कार्ट"] == १, "वर्तमान सत्र कार्ट १");
    सत्यापित_करो(लंबाई(ग्राफ़["उपलब्ध_कर्म_सामग्री"]) == १, "उपलब्ध कर्म सामग्री १ उत्पाद");
    सत्यापित_करो(लंबाई(ग्राफ़["क्रिया_संसाधन"]) == ४, "४ प्रमुख क्रिया संसाधन");

    लिखतु("  [सफल] पाणिनीय अर्थगत ज्ञान-ग्राफ़ (/अर्थ) एसईओ एवं एआई-सुलभता प्रामाणिक।\n");
}

