// Phase 5 Test: Multiple classes
वर्ग बिंदु {
    मान क;
    मान ख;

    कार्य रचना(मान अ, मान ब) {
        स्व.क = अ;
        स्व.ख = ब;
    }
}

वर्ग आयत {
    मान चौड़ाई;
    मान ऊँचाई;

    कार्य रचना(मान च, मान ऊ) {
        स्व.चौड़ाई = च;
        स्व.ऊँचाई = ऊ;
    }

    कार्य क्षेत्रफल() {
        परत् स्व.चौड़ाई * स्व.ऊँचाई;
    }
}

कार्य मुख्य() {
    मान ब = नवीन बिंदु(3, 4);
    लिखतु(ब.क);
    लिखतु(ब.ख);

    मान आ = नवीन आयत(5, 10);
    लिखतु(आ.क्षेत्रफल());
}
