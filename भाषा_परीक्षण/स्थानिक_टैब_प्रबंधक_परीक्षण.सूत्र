// भाषा_परीक्षण/स्थानिक_टैब_प्रबंधक_परीक्षण.सूत्र — संप्रभु स्थानिक दर्शक बहु-टैब एवं इतिहास सत्यापन
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला
//
// संप्रभु स्थानिक दर्शक के बहु-टैब (Multi-Tab) एवं इतिहास (History Stack)
// प्रबंधन की अंत-से-अंत पुष्टि:
//   १. बहु-टैब निर्माण एवं अवस्था पृथक्करण (३ संप्रभु टैब)
//   २. तात्कालिक शून्य-रिफ्लो टैब स्विचिंग (Instant Tab Switch)
//   ३. गहरा नेविगेशन एवं बैक स्टैक (Back Stack with State Restoration)
//   ४. अग्रिम नेविगेशन स्टैक (Forward Stack Navigation)
//   ५. टैब निष्कासन एवं २डी स्थानिक टैब-पट्टी यूआई संश्लेषण
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "पुस्तकालय/स्थानिक_टैब_प्रबंधक.सूत्र";

कार्य सत्यापित_करो(मान शर्त, पाठ संदेश) {
    यदि (न शर्त) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  🕉️ सूत्र संप्रभु स्थानिक दर्शक बहु-टैब एवं इतिहास सत्यापन");
    लिखतु("  शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला");
    लिखतु("============================================================\n");

    संख्या कुल_सफल = ०;

    // --- परीक्षण १: बहु-टैब प्रबंधक आरंभ एवं ३ संप्रभु टैब निर्माण ---
    लिखतु("--- परीक्षण १: बहु-टैब प्रबंधक आरंभ एवं ३ संप्रभु टैब निर्माण ---");
    शब्दकोश प्रबंधक = स्थानिक_टैब_प्रबंधक_रचना(१०००.०, ८००.०);

    शब्दकोश टैब_१ = स्थानिक_टैब_नया(प्रबंधक, "सूत्र://हाट");
    शब्दकोश टैब_२ = स्थानिक_टैब_नया(प्रबंधक, "सूत्र://कोश");
    शब्दकोश टैब_३ = स्थानिक_टैब_नया(प्रबंधक, "सूत्र://यंत्र");

    सत्यापित_करो(प्रबंधक["कुल_सक्रिय_टैब"] == ३, "सकल ३ संप्रभु टैब निर्मित");
    सत्यापित_करो(प्रबंधक["सक्रिय_टैब_आईडी"] == टैब_३["टैब_आईडी"], "सक्रिय टैब ३ ('सूत्र://यंत्र')");
    
    शब्दकोश सक्रिय = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    सत्यापित_करो(सक्रिय["शीर्षक"] == "सूत्र://यंत्र", "सक्रिय टैब शीर्षक शुद्ध");
    लिखतु("  [सफल] परीक्षण १ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण २: तात्कालिक शून्य-रिफ्लो टैब स्विचिंग ---
    लिखतु("--- परीक्षण २: तात्कालिक शून्य-रिफ्लो टैब स्विचिंग ---");
    मान स्विच_१ = स्थानिक_टैब_चुनें(प्रबंधक, टैब_१["टैब_आईडी"]);
    सत्यापित_करो(स्विच_१ == सत्य, "टैब १ ('सूत्र://हाट') पर स्विच सफल");
    
    शब्दकोश सक्रिय_१ = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    सत्यापित_करो(सक्रिय_१["शीर्षक"] == "सूत्र://हाट", "सक्रिय टैब १ सत्यापित");

    मान स्विच_२ = स्थानिक_टैब_चुनें(प्रबंधक, टैब_२["टैब_आईडी"]);
    सत्यापित_करो(स्विच_२ == सत्य, "टैब २ ('सूत्र://कोश') पर स्विच सफल");
    
    शब्दकोश सक्रिय_२ = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    सत्यापित_करो(सक्रिय_२["शीर्षक"] == "सूत्र://कोश", "सक्रिय टैब २ सत्यापित");
    लिखतु("  [सफल] परीक्षण २ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ३: नेविगेशन इतिहास एवं बैक स्टैक (Back Navigation) ---
    लिखतु("--- परीक्षण ३: नेविगेशन इतिहास एवं बैक स्टैक (Back Navigation) ---");
    // टैब १ पर वापस आएं
    स्थानिक_टैब_चुनें(प्रबंधक, टैब_१["टैब_आईडी"]);
    
    // १. नया नेविगेशन: सूत्र://हाट -> सूत्र://हाट/चिप
    स्थानिक_टैब_अभिगमन(प्रबंधक, "सूत्र://हाट/चिप");
    शब्दकोश दर्शक_१ = टैब_१["दर्शक"];
    दर्शक_१["स्क्रॉल_य"] = ८००.०; // स्क्रॉल स्थिति अनुकरण
    दर्शक_१["सक्रिय_अनुभाग"] = १;

    // २. नया नेविगेशन: सूत्र://हाट/चिप -> सूत्र://हाट/सर्वर
    स्थानिक_टैब_अभिगमन(प्रबंधक, "सूत्र://हाट/सर्वर");
    सत्यापित_करो(टैब_१["शीर्षक"] == "सूत्र://हाट/सर्वर", "वर्तमान पृष्ठ 'सूत्र://हाट/सर्वर'");
    सत्यापित_करो(लंबाई(टैब_१["इतिहास_सूची"]) == २, "इतिहास स्टैक में २ पृष्ठ संचित");

    // प्रथम बार 'वापस' (Back 1): सूत्र://हाट/चिप पर प्रत्यावर्तन
    मान वापस_१ = स्थानिक_टैब_वापस(प्रबंधक);
    सत्यापित_करो(वापस_१ == सत्य, "प्रथम वापस नेविगेशन सफल");
    सत्यापित_करो(टैब_१["शीर्षक"] == "सूत्र://हाट/चिप", "पुनर्स्थापित पृष्ठ 'सूत्र://हाट/चिप'");
    सत्यापित_करो(टैब_१["दर्शक"]["स्क्रॉल_य"] == ८००.०, "स्क्रॉल स्थिति (८०० पिक्सल) यथावत पुनर्स्थापित");
    सत्यापित_करो(टैब_१["दर्शक"]["सक्रिय_अनुभाग"] == १, "सक्रिय अनुभाग (१) पुनर्स्थापित");

    // द्वितीय बार 'वापस' (Back 2): सूत्र://हाट पर प्रत्यावर्तन
    मान वापस_२ = स्थानिक_टैब_वापस(प्रबंधक);
    सत्यापित_करो(वापस_२ == सत्य, "द्वितीय वापस नेविगेशन सफल");
    सत्यापित_करो(टैब_१["शीर्षक"] == "सूत्र://हाट", "मूल पृष्ठ 'सूत्र://हाट' पुनर्स्थापित");
    सत्यापित_करो(टैब_१["दर्शक"]["स्क्रॉल_य"] == ०.०, "मूल स्क्रॉल स्थिति (० पिक्सल) पुनर्स्थापित");
    सत्यापित_करो(लंबाई(टैब_१["इतिहास_सूची"]) == ०, "इतिहास स्टैक रिक्त (प्रारंभिक पृष्ठ)");
    लिखतु("  [सफल] परीक्षण ३ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ४: अग्रिम नेविगेशन स्टैक (Forward Navigation) ---
    लिखतु("--- परीक्षण ४: अग्रिम नेविगेशन स्टैक (Forward Navigation) ---");
    सत्यापित_करो(लंबाई(टैब_१["अग्रिम_सूची"]) == २, "फॉरवर्ड स्टैक में २ पृष्ठ उपस्थित");

    // प्रथम बार 'अग्रिम' (Forward 1): सूत्र://हाट/चिप पर गमन
    मान अग्रिम_१ = स्थानिक_टैब_अग्रिम(प्रबंधक);
    सत्यापित_करो(अग्रिम_१ == सत्य, "प्रथम अग्रिम नेविगेशन सफल");
    सत्यापित_करो(टैब_१["शीर्षक"] == "सूत्र://हाट/चिप", "अग्रिम पृष्ठ 'सूत्र://हाट/चिप' लोड");
    सत्यापित_करो(टैब_१["दर्शक"]["स्क्रॉल_य"] == ८००.०, "अग्रिम स्क्रॉल स्थिति (८०० पिक्सल) संरक्षित");

    // द्वितीय बार 'अग्रिम' (Forward 2): सूत्र://हाट/सर्वर पर गमन
    मान अग्रिम_२ = स्थानिक_टैब_अग्रिम(प्रबंधक);
    सत्यापित_करो(अग्रिम_२ == सत्य, "द्वितीय अग्रिम नेविगेशन सफल");
    सत्यापित_करो(टैब_१["शीर्षक"] == "सूत्र://हाट/सर्वर", "अग्रिम पृष्ठ 'सूत्र://हाट/सर्वर' लोड");
    सत्यापित_करो(लंबाई(टैब_१["अग्रिम_सूची"]) == ०, "फॉरवर्ड स्टैक समाप्त");
    लिखतु("  [सफल] परीक्षण ४ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ५: टैब निष्कासन एवं २डी स्थानिक टैब-पट्टी यूआई संश्लेषण ---
    लिखतु("--- परीक्षण ५: टैब निष्कासन एवं २डी स्थानिक टैब-पट्टी यूआई संश्लेषण ---");
    // टैब ३ ('सूत्र://यंत्र') बंद करें
    मान बंद_फल = स्थानिक_टैब_बंद(प्रबंधक, टैब_३["टैब_आईडी"]);
    सत्यापित_करो(बंद_फल == सत्य, "टैब ३ सफलतापूर्वक बंद");
    सत्यापित_करो(प्रबंधक["कुल_सक्रिय_टैब"] == २, "अवशिष्ट सक्रिय टैब २");

    // यूआई टैब पट्टी का संश्लेषण
    शब्दकोश टैब_पट्टी = स्थानिक_टैब_पट्टी_रचना(प्रबंधक);
    सत्यापित_करो(टैब_पट्टी["प्रकार"] == "डिब्बा", "टैब पट्टी डिब्बा नोड");
    सत्यापित_करो(टैब_पट्टी["पृष्ठ_रंग"] == "#020617", "पृष्ठ रंग गहरा श्याम (#020617)");
    
    सूची तत्व_सूची = टैब_पट्टी["बच्चे"];
    सत्यापित_करो(लंबाई(तत्व_सूची) >= ४, "यूआई तत्व (वापस, अग्रिम, २ टैब, नवीन+) उपस्थित");
    सत्यापित_करो(तत्व_सूची[०]["सामग्री"] == "⮜ वापस", "प्रथम तत्व 'वापस' बटन");
    सत्यापित_करो(तत्व_सूची[१]["सामग्री"] == "अग्रिम ⮞", "द्वितीय तत्व 'अग्रिम' बटन");
    लिखतु("  ✓ यूआई टैब १: " + तत्व_सूची[२]["सामग्री"]);
    लिखतु("  ✓ यूआई टैब २: " + तत्व_सूची[३]["सामग्री"]);
    लिखतु("  [सफल] परीक्षण ५ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    लिखतु("============================================================");
    लिखतु("  सकल परीक्षण: " + देवनागरी_अंकों_में("" + कुल_सफल) + "  |  सफल: " + देवनागरी_अंकों_में("" + कुल_सफल) + "  |  विफल: ०");
    लिखतु("  [सर्व-सफल] सूत्र संप्रभु स्थानिक दर्शक बहु-टैब प्रबंधक १००% प्रमाणित!");
    लिखतु("============================================================\n");
    परत् ०;
}
