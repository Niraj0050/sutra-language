// भाषा_परीक्षण/दृश्यक_द्विआधारी_परीक्षण.सूत्र
// ============================================================
// दृश्यक शून्य-JSON द्विआधारी संजाल प्रोटोकॉल परीक्षण
// १. १६-बिट एवं पाठ बाइट पैकिंग/अनपैकिंग
// २. ३डी जाल द्विआधारी एन्कोडिंग एवं डीकोडिंग
// ३. २डी यूआई (डिब्बा, लेख, बटन) द्विआधारी एन्कोडिंग एवं डीकोडिंग
// ४. द्विआधारी बनाम जेसन संपीड़न एवं बैंडविड्थ दक्षता
// ============================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "पुस्तकालय/दृश्यक_द्विआधारी.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  दृश्यक शून्य-JSON द्विआधारी संजाल प्रोटोकॉल परीक्षण");
    लिखतु("============================================================\n");

    // १. १६-बिट पूर्णांक एवं पाठ पैकिंग
    लिखतु("--- परीक्षण १: बाइट पैकिंग एवं अनपैकिंग मूलतत्व ---");
    सूची पैक१ = द्विआधारी_१६बिट_पैक(५००);
    संख्या मान१ = द्विआधारी_१६बिट_अनपैक(पैक१, ०);
    सत्यापित_करो(मान१ == ५००, "धनात्मक पूर्णांक (५००) राउंडट्रिप");

    सूची पैक२ = द्विआधारी_१६बिट_पैक(-२५०);
    संख्या मान२ = द्विआधारी_१६बिट_अनपैक(पैक२, ०);
    सत्यापित_करो(मान२ == -२५०, "ऋणात्मक पूर्णांक (-२५०) राउंडट्रिप");

    सूची पाठ_पैक = द्विआधारी_पाठ_पैक("सूत्र_स्थानिक");
    शब्दकोश पाठ_फल = द्विआधारी_पाठ_अनपैक(पाठ_पैक, ०);
    सत्यापित_करो(पाठ_फल["पाठ"] == "सूत्र_स्थानिक", "पाठ स्ट्रिंग राउंडट्रिप");
    लिखतु("  [सफल] बाइट पैकिंग एवं अनपैकिंग पूर्णतः सटीक।");

    // २. ३डी जाल एवं २डी यूआई आदेश संयोजन
    लिखतु("\n--- परीक्षण २: ३डी+२डी दृश्य आदेश निर्माण ---");
    शब्दकोश घन = दृश्यक_घन_जाल(२.०);
    शब्दकोश दृश्य = दृश्यक_दृश्य_बनाओ();
    सूची रूपांतरण = दृश्यक_आव्यूह४_अनुवाद(०.०, ०.०, ५.०);
    शब्दकोश वस्तु = दृश्यक_स्थानिक_वस्तु("सूत्र_घन", घन, रूपांतरण, "#00ffcc");
    दृश्यक_वस्तु_जोड़ो(दृश्य, वस्तु);

    शब्दकोश बटन = दृश्यक_बटन("सक्रिय", "क्रिया_प्रारंभ", {});
    दृश्यक_यूआई_जोड़ो(दृश्य, बटन);

    सूची मूल_आदेश = दृश्यक_चौखटा_आदेश(दृश्य, ८००.०, ६००.०);
    सत्यापित_करो(लंबाई(मूल_आदेश) == २, "मूल आदेश सूची लंबाई २ (३डी + २डी)");
    लिखतु("  [सफल] ३डी एवं २डी दृश्य आदेश संकलित।");

    // ३. द्विआधारी एन्कोडिंग एवं डीकोडिंग राउंडट्रिप
    लिखतु("\n--- परीक्षण ३: द्विआधारी एन्कोडिंग एवं डीकोडिंग राउंडट्रिप ---");
    सूची बाइट्स = दृश्यक_द्विआधारी_एन्कोड(मूल_आदेश);
    सत्यापित_करो(लंबाई(बाइट्स) > ८, "द्विआधारी पेलोड उत्पन्न (शीर्षलेख + आदेश)");
    सत्यापित_शीर्षलेख(बाइट्स);

    सूची डीकोड_आदेश = दृश्यक_द्विआधारी_डीकोड(बाइट्स);
    सत्यापित_करो(लंबाई(डीकोड_आदेश) == २, "डीकोड आदेश सूची लंबाई २");

    शब्दकोश डीकोड_३डी = डीकोड_आदेश[०];
    सत्यापित_करो(डीकोड_३डी["प्रकार"] == "३डी_जाल", "डीकोड ३डी प्रकार '३डी_जाल'");
    सत्यापित_करो(डीकोड_३डी["नाम"] == "सूत्र_घन", "डीकोड ३डी नाम 'सूत्र_घन'");
    सत्यापित_करो(लंबाई(डीकोड_३डी["प्रक्षेपित_शीर्ष"]) == ८, "डीकोड ३डी शीर्ष संख्या ८");
    सत्यापित_करो(लंबाई(डीकोड_३डी["सूचकांक"]) == ३६, "डीकोड ३डी सूचकांक संख्या ३६");

    शब्दकोश डीकोड_२डी = डीकोड_आदेश[१];
    सत्यापित_करो(डीकोड_२डी["प्रकार"] == "२डी_यूआई", "डीकोड २डी प्रकार '२डी_यूआई'");
    सत्यापित_करो(डीकोड_२डी["जड़"]["प्रकार"] == "बटन", "डीकोड २डी बटन नोड");
    सत्यापित_करो(डीकोड_२डी["जड़"]["सामग्री"] == "सक्रिय", "डीकोड २डी बटन सामग्री 'सक्रिय'");
    सत्यापित_करो(डीकोड_२डी["जड़"]["क्रिया_आईडी"] == "क्रिया_प्रारंभ", "डीकोड २डी बटन क्रिया");
    लिखतु("  [सफल] द्विआधारी राउंडट्रिप १००% दोषरहित।");

    // ४. द्विआधारी बनाम जेसन संपीड़न दक्षता
    लिखतु("\n--- परीक्षण ४: द्विआधारी बनाम JSON संपीड़न मेट्रिक ---");
    शब्दकोश तुलना = दृश्यक_द्विआधारी_तुलना(मूल_आदेश);
    लिखतु("  द्विआधारी आकार: " + देवनागरी_अंकों_में("" + तुलना["द्विआधारी_बाइट्स"]) + " बाइट्स");
    लिखतु("  JSON आकार:      " + देवनागरी_अंकों_में("" + तुलना["जेसन_बाइट्स"]) + " बाइट्स");
    लिखतु("  बैंडविड्थ बचत:   " + देवनागरी_अंकों_में("" + गोल(तुलना["बचत_प्रतिशत"])) + " %");
    सत्यापित_करो(तुलना["द्विआधारी_बाइट्स"] < तुलना["जेसन_बाइट्स"], "द्विआधारी प्रारूप JSON से लघुतर");
    सत्यापित_करो(तुलना["बचत_प्रतिशत"] > २०.०, "बैंडविड्थ बचत २०% से अधिक");
    लिखतु("  [सफल] द्विआधारी प्रोटोकॉल उच्च बैंडविड्थ संकुचन प्रमाणित।");

    लिखतु("\n============================================================");
    लिखतु("  [सर्वं सम्यक्] दृश्यक द्विआधारी प्रोटोकॉल १००% सत्यापितम्!");
    लिखतु("============================================================\n");
}

कार्य सत्यापित_शीर्षलेख(सूची बाइट्स) {
    यदि (बाइट्स[०] != ८३ || बाइट्स[१] != ८५ || बाइट्स[२] != ८४ || बाइट्स[३] != ८२) {
        फेको "त्रुटिः अमान्य SUTR शीर्षलेख";
    }
}
