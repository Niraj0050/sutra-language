// भाषा_परीक्षण/सूत्रकस_संपीड़न_परीक्षण.सूत्र — सूत्र अष्टक-संकेत (.सूत्रकस) डिस्क संपीड़न सत्यापन
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला
//
// महर्षि पाणिनि के माहेश्वर सूत्र एवं प्रत्याहार सिद्धांतों पर आधारित सूत्र अष्टक-संकेत
// (.सूत्रकस - Sutra Compressed Bytecode) डिस्क कंटेनर सत्यापन सूट:
//   १. बाइटकोड संश्लेषण एवं .सूत्रकस डिस्क लेखन (शीर्षलेख 'SUTR' + संस्करण १)
//   २. डिस्क आकार संकुचन एवं मेट्रिक्स विश्लेषण (>३५% संपीड़न बचत)
//   ३. प्रत्यक्ष .सूत्रकस लोड एवं शत-प्रतिशत दोषरहित राउंडट्रिप
//   ४. पारदर्शी स्वचालित लोडर (.सूत्रक एवं .सूत्रकस द्विविध समर्थन)
//   ५. सूत्र आभासी यंत्र (SVM) में संपीड़ित बाइटकोड का प्रत्यक्ष निष्पादन
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "स्वसंकलक/अष्टक_संकेत.सूत्र";
आयात "स्वसंकलक/आभासी_यंत्र.सूत्र";
आयात "पुस्तकालय/सूत्रक_संपीड़ित.सूत्र";

कार्य सत्यापित_करो(मान शर्त, पाठ संदेश) {
    यदि (न शर्त) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  🕉️ सूत्र अष्टक-संकेत (.सूत्रकस) डिस्क संपीड़न सत्यापन");
    लिखतु("  शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला");
    लिखतु("============================================================\n");

    संख्या कुल_सफल = ०;

    // --- परीक्षण १: बाइटकोड संश्लेषण एवं .सूत्रकस डिस्क लेखन ---
    लिखतु("--- परीक्षण १: बाइटकोड संश्लेषण एवं .सूत्रकस डिस्क लेखन ---");
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["जादुई_संकेत"] = "सूत्र";
    प्रोग्राम["संस्करण"] = "१.०";
    प्रोग्राम["लक्ष्य_यंत्र"] = "सार्वत्रिक";
    प्रोग्राम["प्रारंभ_फलन"] = "मुख्य";

    सूची आज्ञाएं = [];
    संख्या इ = ०;
    यावत् (इ < १०) {
        आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, १, -१, -१, १००० + इ));
        आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, २, -१, -१, ५०० + इ));
        आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_योग, ३, १, २, शून्यम्));
        इ = इ + १;
    }
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, ४, -१, -१, २००));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_अंतर, ५, ३, ४, शून्यम्));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, ५, -१, शून्यम्));

    शब्दकोश फलन_मानचित्र = {};
    शब्दकोश मुख्य_फलन = {};
    मुख्य_फलन["नाम"] = "मुख्य";
    मुख्य_फलन["पैरामीटर_गणना"] = ०;
    मुख्य_फलन["आज्ञा_सूची"] = आज्ञाएं;
    फलन_मानचित्र["मुख्य"] = मुख्य_फलन;
    प्रोग्राम["फलन_मानचित्र"] = फलन_मानचित्र;

    पाठ सादा_मार्ग = "भाषा_परीक्षण/सत्यापन_नमूना.सूत्रक";
    पाठ संपीड़ित_मार्ग = "भाषा_परीक्षण/सत्यापन_नमूना.सूत्रकस";

    अष्टक_सञ्चिका_सहेजें(प्रोग्राम, सादा_मार्ग);
    सत्यापित_करो(सञ्चिका_अस्ति(सादा_मार्ग), "सादा .सूत्रक डिस्क पर निर्मित");

    सूत्रकस_सञ्चिका_सहेजें(प्रोग्राम, संपीड़ित_मार्ग);
    सत्यापित_करो(सञ्चिका_अस्ति(संपीड़ित_मार्ग), "संपीड़ित .सूत्रकस डिस्क पर निर्मित");

    पाठ संपीड़ित_कच्चा = सञ्चिका_पठतु(संपीड़ित_मार्ग);
    सत्यापित_करो(लंबाई(संपीड़ित_कच्चा) >= ५, "संपीड़ित सञ्चिका में पर्याप्त शीर्षलेख बाइट्स");
    सत्यापित_करो(सूत्रकस_जाँच_संपीड़ित(संपीड़ित_कच्चा), "जादुई शीर्षलेख 'SUTR' (८३, ८५, ८४, ८२) प्रमाणित");
    सत्यापित_करो(अक्षर_मान(उपखंड(संपीड़ित_कच्चा, ४, ५)) == १, "प्रारूप संस्करण १ प्रमाणित");

    लिखतु("  [सफल] परीक्षण १ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण २: डिस्क आकार संकुचन एवं मेट्रिक्स विश्लेषण ---
    लिखतु("--- परीक्षण २: डिस्क आकार संकुचन एवं मेट्रिक्स विश्लेषण ---");
    शब्दकोश मेट्रिक्स = सूत्रकस_संपीड़न_विश्लेषण(सादा_मार्ग, संपीड़ित_मार्ग);

    लिखतु("  सादा .सूत्रक आकार:     " + मेट्रिक्स["सादा_आकार_देव"] + " बाइट्स");
    लिखतु("  संपीड़ित .सूत्रकस आकार: " + मेट्रिक्स["संपीड़ित_आकार_देव"] + " बाइट्स");
    लिखतु("  डिस्क आकार बचत:         " + मेट्रिक्स["बचत_प्रतिशत_देव"]);

    सत्यापित_करो(मेट्रिक्स["संपीड़ित_आकार"] < मेट्रिक्स["सादा_आकार"], "संपीड़ित आकार सादे आकार से न्यून");
    सत्यापित_करो(मेट्रिक्स["बचत_प्रतिशत"] >= ३५.०, "डिस्क आकार संकुचन बचत >= ३५%");

    लिखतु("  [सफल] परीक्षण २ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ३: प्रत्यक्ष .सूत्रकस लोड एवं दोषरहित राउंडट्रिप ---
    लिखतु("--- परीक्षण ३: प्रत्यक्ष .सूत्रकस लोड एवं दोषरहित राउंडट्रिप ---");
    शब्दकोश लोड_प्रोग्राम = सूत्रकस_सञ्चिका_लोड(संपीड़ित_मार्ग);

    सत्यापित_करो(लोड_प्रोग्राम["जादुई_संकेत"] == "सूत्र", "लोड जादुई संकेत 'सूत्र' शुद्ध");
    सत्यापित_करो(लोड_प्रोग्राम["संस्करण"] == "१.०", "लोड संस्करण '१.०' शुद्ध");
    सत्यापित_करो(लोड_प्रोग्राम["प्रारंभ_फलन"] == "मुख्य", "लोड प्रारंभ फलन 'मुख्य' शुद्ध");

    शब्दकोश लोड_फनक्शा = लोड_प्रोग्राम["फलन_मानचित्र"];
    सत्यापित_करो(समाहित(कुंजियाँ(लोड_फनक्शा), "मुख्य"), "लोड फलन मानचित्र में 'मुख्य' उपस्थित");

    शब्दकोश लोड_मुख्य = लोड_फनक्शा["मुख्य"];
    सूची लोड_आज्ञाएं = लोड_मुख्य["आज्ञा_सूची"];
    सत्यापित_करो(लंबाई(लोड_आज्ञाएं) == ३३, "आज्ञा गणना ३३ शुद्ध");

    // आज्ञा-दर-आज्ञा तुलना
    सत्यापित_करो(लोड_आज्ञाएं[०]["कूट"] == आज्ञा_स्थिर, "आज्ञा ०: स्थिर १०००");
    सत्यापित_करो(लोड_आज्ञाएं[०]["स्थिरांक"] == १०००, "आज्ञा ० मान: १०००");
    सत्यापित_करो(लोड_आज्ञाएं[२]["कूट"] == आज्ञा_योग, "आज्ञा २: योग");
    सत्यापित_करो(लोड_आज्ञाएं[३१]["कूट"] == आज्ञा_अंतर, "आज्ञा ३१: अंतर");
    सत्यापित_करो(लोड_आज्ञाएं[३२]["कूट"] == आज्ञा_वापस, "आज्ञा ३२: वापस");

    लिखतु("  [सफल] परीक्षण ३ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ४: पारदर्शी स्वचालित लोडर (.सूत्रक एवं .सूत्रकस) ---
    लिखतु("--- परीक्षण ४: पारदर्शी स्वचालित लोडर (.सूत्रक एवं .सूत्रकस) ---");
    शब्दकोश ऑटो_सादा = सूत्रक_स्वचालित_लोड(सादा_मार्ग);
    शब्दकोश ऑटो_संपीड़ित = सूत्रक_स्वचालित_लोड(संपीड़ित_मार्ग);

    सत्यापित_करो(ऑटो_सादा["प्रारंभ_फलन"] == "मुख्य", "स्वचालित लोडर द्वारा सादा .सूत्रक लोड सफल");
    सत्यापित_करो(ऑटो_संपीड़ित["प्रारंभ_फलन"] == "मुख्य", "स्वचालित लोडर द्वारा संपीड़ित .सूत्रकस लोड सफल");
    सत्यापित_करो(लंबाई(ऑटो_सादा["फलन_मानचित्र"]["मुख्य"]["आज्ञा_सूची"]) == ३३, "सादा कंटेनर आज्ञा गणना समान");
    सत्यापित_करो(लंबाई(ऑटो_संपीड़ित["फलन_मानचित्र"]["मुख्य"]["आज्ञा_सूची"]) == ३३, "संपीड़ित कंटेनर आज्ञा गणना समान");

    लिखतु("  [सफल] परीक्षण ४ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ५: सूत्र आभासी यंत्र (SVM) में प्रत्यक्ष निष्पादन ---
    लिखतु("--- परीक्षण ५: सूत्र आभासी यंत्र (SVM) में प्रत्यक्ष निष्पादन ---");
    शब्दकोश यंत्र = आभासी_यंत्र_नव(ऑटो_संपीड़ित);
    मान निष्पादन_परिणाम = आभासी_यंत्र_चलाओ(यंत्र);

    // गणित: (१००९ + ५०९) - २०० = १३१८
    सत्यापित_करो(निष्पादन_परिणाम == १३१८, "SVM निष्पादन परिणाम शुद्ध: (१००९ + ५०९) - २०० = १३१८");

    लिखतु("  [सफल] परीक्षण ५ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    लिखतु("============================================================");
    लिखतु("  सकल परीक्षण: " + देवनागरी_अंकों_में("" + कुल_सफल) + "  |  सफल: " + देवनागरी_अंकों_में("" + कुल_सफल) + "  |  विफल: ०");
    लिखतु("  [सर्व-सफल] सूत्र अष्टक-संकेत (.सूत्रकस) डिस्क संपीड़न १००% प्रमाणित!");
    लिखतु("============================================================");

    परत् ०;
}
