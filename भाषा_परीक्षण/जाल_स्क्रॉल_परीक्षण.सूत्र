// भाषा_परीक्षण/जाल_स्क्रॉल_परीक्षण.सूत्र — बहु-अनुभाग स्क्रॉल एवं त्रि-आयामी स्थानिक समन्वय परीक्षण
// ==============================================================================
// शून्य-DOM बहु-अनुभाग स्क्रॉलिंग एवं प्रत्येक अनुभाग हेतु विशिष्ट ३डी मॉडल संक्रमण
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/जाल_घटक.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("सूत्र जाल — बहु-अनुभाग स्क्रॉल एवं ३डी स्थानिक मॉडल समन्वय");

    // १. ३ विशिष्ट त्रि-आयामी मॉडलों की रचना
    शब्दकोश मॉडल_० = {
        "नाम": "स्थानिक_चश्मा_अष्टफलक",
        "जाल": दृश्यक_अष्टफलक_जाल(१.२),
        "रंग": "#38bdf8"
    };
    शब्दकोश मॉडल_१ = {
        "नाम": "तंत्रिका_चिप_घन",
        "जाल": दृश्यक_घन_जाल(१.५),
        "रंग": "#10b981"
    };
    शब्दकोश मॉडल_२ = {
        "नाम": "उद्यम_सर्वर_पिरामिड",
        "जाल": दृश्यक_पिरामिड_जाल(१.८, २.०),
        "रंग": "#f59e0b"
    };
    सूची मॉडल_सूची = [मॉडल_०, मॉडल_१, मॉडल_२];

    जाँच("३डी मॉडल ० अष्टफलक फलक संख्या", मॉडल_०["जाल"]["कुल_त्रिकोण"], ८);
    जाँच("३डी मॉडल १ घन फलक संख्या", मॉडल_१["जाल"]["कुल_त्रिकोण"], १२);
    जाँच("३डी मॉडल २ पिरामिड फलक संख्या", मॉडल_२["जाल"]["कुल_त्रिकोण"], ६);

    // २. ३ विशिष्ट २डी अनुभागों की रचना (Sections)
    शब्दकोश अनुभाग_० = घटक_अनुभाग(
        "अनुभाग_हीरो",
        "१. सूत्र स्थानिक विज़न (Spatial AR Glass)",
        "शून्य-DOM ३६०° स्थानिक विजुअलाइज़र",
        [दृश्यक_लेख("भविष्य का स्थानिक संगणकीय मंच", {"रंग": "#cbd5e1"})],
        १०००.०,
        ८००.०
    );
    शब्दकोश अनुभाग_१ = घटक_अनुभाग(
        "अनुभाग_चिप",
        "२. त्रिमूल्य न्यूरल कोर (Ternary AI Core)",
        "{-1, 0, +1} ऊर्जा-कुशल असंदिग्ध संगणना",
        [दृश्यक_लेख("१० गुना तीव्र शून्य-गुणा आव्यूह संक्रिया", {"रंग": "#a7f3d0"})],
        १०००.०,
        ८००.०
    );
    शब्दकोश अनुभाग_२ = घटक_अनुभाग(
        "अनुभाग_उद्यम",
        "३. संप्रभु उद्यम सर्वर (Sovereign Cloud)",
        "ACID नो-एसक्यूएल एवं पाणिनीय ज्ञान-ग्राफ़",
        [दृश्यक_लेख("शून्य-क्लाउड स्वायत्त डेटाबेस संचयन", {"रंग": "#fed7aa"})],
        १०००.०,
        ८००.०
    );
    सूची अनुभाग_सूची = [अनुभाग_०, अनुभाग_१, अनुभाग_२];

    शब्दकोश प्रबंधक = घटक_स्क्रॉल_प्रबंधक_रचना(अनुभाग_सूची, मॉडल_सूची, ८००.०);
    जाँच("कुल अनुभाग संख्या", प्रबंधक["कुल_अनुभाग"], ३);

    // ३. प्रावस्था १: स्क्रॉल_य = ० (Section 0 Hero active)
    शब्दकोश सं० = जाल_स्क्रॉल_संश्लेषण(प्रबंधक, ०.०, १०००.०, ८००.०);
    जाँच("स्क्रॉल ० पर सक्रिय अनुभाग", सं०["सक्रिय_अनुभाग"], ०);
    जाँच("स्क्रॉल ० पर सक्रिय ३डी मॉडल संख्या", सं०["सक्रिय_त्रिआयामी_मॉडल_संख्या"], १);
    जाँच("प्रथम ३डी वस्तु नाम", सं०["दृश्य"]["३डी_वस्तु_सूची"][०]["नाम"], "स्थानिक_चश्मा_अष्टफलक");

    // ४. प्रावस्था २: सतत संक्रमण स्क्रॉल_य = ४०० (Midpoint between Section 0 and Section 1)
    शब्दकोश सं_मध्य = जाल_स्क्रॉल_संश्लेषण(प्रबंधक, ४००.०, १०००.०, ८००.०);
    जाँच("मध्य स्क्रॉल पर दोनों मॉडल दृश्यमान (Smooth Transition)", सं_मध्य["सक्रिय_त्रिआयामी_मॉडल_संख्या"], २);
    जाँच("संक्रमण में प्रथम मॉडल", सं_मध्य["दृश्य"]["३डी_वस्तु_सूची"][०]["नाम"], "स्थानिक_चश्मा_अष्टफलक");
    जाँच("संक्रमण में द्वितीय मॉडल", सं_मध्य["दृश्य"]["३डी_वस्तु_सूची"][१]["नाम"], "तंत्रिका_चिप_घन");

    // ५. प्रावस्था ३: स्क्रॉल_य = ८०० (Section 1 Chip active)
    शब्दकोश सं१ = जाल_स्क्रॉल_संश्लेषण(प्रबंधक, ८००.०, १०००.०, ८००.०);
    जाँच("स्क्रॉल ८०० पर सक्रिय अनुभाग", सं१["सक्रिय_अनुभाग"], १);
    जाँच("स्क्रॉल ८०० पर सक्रिय मॉडल नाम", सं१["दृश्य"]["३डी_वस्तु_सूची"][०]["नाम"], "तंत्रिका_चिप_घन");

    // ६. प्रावस्था ४: स्क्रॉल_य = १६०० (Section 2 Cloud active)
    शब्दकोश सं२ = जाल_स्क्रॉल_संश्लेषण(प्रबंधक, १६००.०, १०००.०, ८००.०);
    जाँच("स्क्रॉल १६०० पर सक्रिय अनुभाग", सं२["सक्रिय_अनुभाग"], २);
    जाँच("स्क्रॉल १६०० पर सक्रिय मॉडल नाम", सं२["दृश्य"]["३डी_वस्तु_सूची"][०]["नाम"], "उद्यम_सर्वर_पिरामिड");

    // ७. संवादात्मक स्क्रॉल घटना प्रेषण (Scroll Event Dispatcher)
    शब्दकोश अवस्था = जाल_अवस्था_रचना({});
    जाल_स्क्रॉल_घटना_समाधान(अवस्था, २५०.०, ३, ८००.०);
    जाँच("घटना पश्चात स्क्रॉल_य (२५०)", जाल_अवस्था_प्राप्त(अवस्था, "स्क्रॉल_य", ०.०), २५०.०);
    जाँच_संख्या("घटना पश्चात सक्रिय अनुभाग (०)", जाल_अवस्था_प्राप्त(अवस्था, "सक्रिय_अनुभाग", -१), ०);

    स्क्रॉल_घटना_परीक्षण(अवस्था, ६००.०, ३, ८००.०); // कुल स्क्रॉल = ८५०.०
    जाँच_संख्या("स्क्रॉल ८५० पर सक्रिय अनुभाग १", जाल_अवस्था_प्राप्त(अवस्था, "सक्रिय_अनुभाग", -१), १);

    परत् परीक्षण_सारांश();
}

कार्य जाँच_संख्या(पाठ नाम, संख्या वा, संख्या अपे) {
    जाँच(नाम, वा, अपे);
}

कार्य स्क्रॉल_घटना_परीक्षण(शब्दकोश अवस्था, दशमलव डेल्टा, संख्या कुल, दशमलव ऊँचाई) {
    जाल_स्क्रॉल_घटना_समाधान(अवस्था, डेल्टा, कुल, ऊँचाई);
}

मुख्य();
