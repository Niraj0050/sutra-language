// भाषा_परीक्षण/सॉफ्टवेयर_साँचा_परीक्षण.सूत्र
// ============================================================
// सूत्र सॉफ्टवेयर परियोजना पाड़ एवं साँचा परीक्षण
// १. परियोजना पात्र JSON निर्माण एवं वैधता
// २. स्थानिक, उद्यम, एवं प्रज्ञा सॉफ्टवेयर कोड साँचा
// ३. स्वचालित परीक्षण सूट निर्माण
// ४. पूर्ण परियोजना सञ्चिका सृजन एवं पठन
// ============================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  सूत्र सॉफ्टवेयर परियोजना पाड़ (Scaffolder) परीक्षण");
    लिखतु("============================================================\n");

    // १. पात्र JSON विनिर्देश
    लिखतु("--- परीक्षण १: पात्र JSON विनिर्देश निर्माण ---");
    पाठ पात्र = साँचा_पात्र_जेसन("मेरी_परियोजना", "स्थानिक");
    सत्यापित_करो(समाहित_पाठ(पात्र, "मेरी_परियोजना"), "पात्र में नाम उपस्थित");
    सत्यापित_करो(समाहित_पाठ(पात्र, "१.०.०"), "पात्र में संस्करण १.०.०");
    लिखतु("  [सफल] परियोजना पात्र JSON विनिर्देश वैध।");

    // २. साँचे (स्थानिक, उद्यम, प्रज्ञा)
    लिखतु("\n--- परीक्षण २: विभिन्न सॉफ्टवेयर साँचे ---");
    पाठ कोड_स्थानिक = साँचा_मुख्य_कोड("स्थानिक_ऐप", "स्थानिक");
    सत्यापित_करो(समाहित_पाठ(कोड_स्थ_सहायक(कोड_स्थानिक), "दृश्यक_दृश्य_बनाओ"), "स्थानिक कोड में दृश्यक इंजन");

    पाठ कोड_उद्यम = साँचा_मुख्य_कोड("उद्यम_ऐप", "उद्यम");
    सत्यापित_करो(समाहित_पाठ(कोड_उद्यम, "आधार_सत्र_शुरू"), "उद्यम कोड में ACID संव्यवहार");

    पाठ कोड_प्रज्ञा = साँचा_मुख्य_कोड("प्रज्ञा_ऐप", "प्रज्ञा");
    सत्यापित_करो(समाहित_पाठ(कोड_प्रज्ञा, "त्रिमूल्य_सघन_स्तर_बनाओ"), "प्रज्ञा कोड में त्रिमूल्य स्तर");
    लिखतु("  [सफल] विविध प्रकार के सॉफ्टवेयर साँचे प्रामाणिक।");

    // ३. पूर्ण परियोजना सञ्चिका रचना
    लिखतु("\n--- परीक्षण ३: पूर्ण परियोजना सञ्चिका रचना ---");
    शब्दकोश फल = परियोजना_साँचा_रचना("अस्थायी_सॉफ्टवेयर", "उद्यम");
    सत्यापित_करो(फल["सफलता"], "परियोजना सृजन सफल");

    पाठ पठित = सञ्चिका_पठतु(फल["मुख्य_सञ्चिका"]);
    सत्यापित_करो(समाहित_पाठ(पठित, "उद्यम_ऐप") || समाहित_पाठ(पठित, "अस्थायी_सॉफ्टवेयर"), "सञ्चिका लेखन एवं पठन सम्यक्");

    // सफाई
    सञ्चिका_हटाओ_सहायक(फल["पात्र_सञ्चिका"]);
    सञ्चिका_हटाओ_सहायक(फल["मुख्य_सञ्चिका"]);
    सञ्चिका_हटाओ_सहायक(फल["परीक्षण_सञ्चिका"]);
    लिखतु("  [सफल] परियोजना सञ्चिका चक्र पूर्ण।");

    लिखतु("\n============================================================");
    लिखतु("  [सर्वं सम्यक्] सूत्र सॉफ्टवेयर साँचा तंत्र १००% सत्यापितम्!");
    लिखतु("============================================================\n");
}

कार्य कोड_स्थ_सहायक(पाठ क) {
    परत् क;
}

कार्य कोड_स्थानिक(पाठ क) {
    परत् क;
}

कार्य सञ्चिका_हटाओ_सहायक(पाठ पथ) {
    परत् ०;
}

मुख्य();
