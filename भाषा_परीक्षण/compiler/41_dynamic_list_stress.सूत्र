वर्ग नोड {
    मान मूल्य = ०;
    कार्य रचना(पूर्णांक व) {
        स्व.मूल्य = व;
    }
}

कार्य मुख्य() {
    लिखतु("=== A. append growth ===");
    // Create an रिक्त list
    सूची ल = [];
    लिखतु(लंबाई(ल)); // ०

    // Add elements
    ल = जोड़ें(ल, १०);
    ल = जोड़ें(ल, २०);
    ल = जोड़ें(ल, ३०);
    ल = जोड़ें(ल, ४०);
    ल = जोड़ें(ल, ५०);
    लिखतु(लंबाई(ल)); // ५
    लिखतु(ल[०]); // १०
    लिखतु(ल[४]); // ५०

    लिखतु("=== B. multiple growth operations ===");
    सूची ल२ = [];
    मान इ = ०;
    यावत् (इ < ५०) {
        ल२ = जोड़ें(ल२, इ * १०);
        इ = इ + १;
    }
    लिखतु(लंबाई(ल२)); // ५०
    लिखतु(ल२[४९]); // ४९०

    लिखतु("=== C. remove without shrink ===");
    // Capacity of ल२ is currently ६४ (grown from ० -> ४ -> ८ -> १६ -> ३२ -> ६४).
    // Pop ५ elements: size becomes ४५, which is > ६४/४ (१६), so no shrink should occur.
    मान ज = ०;
    यावत् (ज < ५) {
        ल२ = निकालें(ल२);
        ज = ज + १;
    }
    लिखतु(लंबाई(ल२)); // ४५

    लिखतु("=== D. remove with shrink ===");
    // Pop until size becomes १६ (which is <= ६४/४ = १६), triggering shrink to capacity ३२.
    // Pop further until size becomes ८ (which is <= ३२/४ = ८), triggering shrink to capacity १६.
    // Pop further until size becomes ४ (which is <= १६/४ = ४), triggering shrink to capacity ८.
    // Pop further until size becomes २ (which is <= ८/४ = २), triggering shrink to capacity ४.
    यावत् (लंबाई(ल२) > २) {
        ल२ = निकालें(ल२);
    }
    लिखतु(लंबाई(ल२)); // २
    लिखतु(ल२[०]); // ०
    लिखतु(ल२[१]); // १०

    लिखतु("=== E. repeated add/remove ===");
    मान क = ०;
    यावत् (क < २०) {
        ल२ = जोड़ें(ल२, ९९९);
        ल२ = निकालें(ल२);
        क = क + १;
    }
    लिखतु(लंबाई(ल२)); // २
    लिखतु(ल२[०]); // ०
    लिखतु(ल२[१]); // १०

    लिखतु("=== F. insert requiring growth ===");
    // Insert at index १
    ल२ = डालें(ल२, १, ५);
    // Insert at index ०
    ल२ = डालें(ल२, ०, -१०);
    // Current elements: [-१०, ०, ५, १०]
    लिखतु(लंबाई(ल२)); // ४
    लिखतु(ल२[०]); // -१०
    लिखतु(ल२[१]); // ०
    लिखतु(ल२[२]); // ५
    लिखतु(ल२[३]); // १०

    // Insert that forces growth (capacity is ४, size becomes ५)
    ल२ = डालें(ल२, २, ९९);
    लिखतु(लंबाई(ल२)); // ५
    लिखतु(ल२[२]); // ९९
    लिखतु(ल२[३]); // ५

    लिखतु("=== G. update without reallocation ===");
    ल२[२] = ८८८;
    लिखतु(ल२[२]); // ८८८

    लिखतु("=== H. रिक्त list ===");
    सूची खाली = [];
    लिखतु(लंबाई(खाली)); // ०

    लिखतु("=== I. single-element list ===");
    सूची एकल = [१];
    लिखतु(लंबाई(एकल)); // १
    लिखतु(एकल[०]); // १

    लिखतु("=== J. nested lists ===");
    सूची नेस्टेड = [[१००, २००]];
    नेस्टेड[०] = जोड़ें(नेस्टेड[०], ३००);
    लिखतु(लंबाई(नेस्टेड[०])); // ३
    लिखतु(नेस्टेड[०][२]); // ३००

    लिखतु("=== K. strings inside lists ===");
    सूची स्ट्रिंग्स = ["अ", "ब"];
    स्ट्रिंग्स = जोड़ें(स्ट्रिंग्स, "स");
    लिखतु(लंबाई(स्ट्रिंग्स)); // ३
    लिखतु(स्ट्रिंग्स[२]); // स

    लिखतु("=== L. objects inside lists ===");
    सूची ऑब्जेक्ट्स = [नवीन नोड(१००)];
    ऑब्जेक्ट्स = जोड़ें(ऑब्जेक्ट्स, नवीन नोड(२००));
    लिखतु(लंबाई(ऑब्जेक्ट्स)); // २
    मान वस्तु = ऑब्जेक्ट्स[१];
    लिखतु(वस्तु != शून्यम्); // सत्य

    लिखतु("=== M. GC + resize interaction ===");
    संग्रह_करो();
    // स्मृति_स्थिति() जानबूझकर नहीं — उसके सक्रिय/संग्रहित अंक interp
    // (conservative scope-rooting) बनाम native (precise liveness-rooting)
    // में collector-कार्यान्वयन के अनुसार अलग होते; देखें भाषा_परीक्षण/diagnostics/।
    // असली जाँच यही है: GC के बाद आगे की सूची-क्रियाएँ सही चलें (खंड N)।

    लिखतु("=== N. large list stress test ===");
    सूची विशाल = [];
    मान म = ०;
    यावत् (म < १०००) {
        विशाल = जोड़ें(विशाल, म);
        म = म + १;
    }
    लिखतु(लंबाई(विशाल)); // १०००
    लिखतु(विशाल[९९९]); // ९९९
}
