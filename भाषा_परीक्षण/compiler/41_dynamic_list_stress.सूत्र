वर्ग नोड {
    मान मूल्य = 0;
    कार्य रचना(पूर्णांक व) {
        स्व.मूल्य = व;
    }
}

कार्य मुख्य() {
    लिखतु("=== A. append growth ===");
    // Create an रिक्त list
    सूची ल = [];
    लिखतु(लंबाई(ल)); // 0

    // Add elements
    ल = जोड़ें(ल, 10);
    ल = जोड़ें(ल, 20);
    ल = जोड़ें(ल, 30);
    ल = जोड़ें(ल, 40);
    ल = जोड़ें(ल, 50);
    लिखतु(लंबाई(ल)); // 5
    लिखतु(ल[0]); // 10
    लिखतु(ल[4]); // 50

    लिखतु("=== B. multiple growth operations ===");
    सूची ल2 = [];
    मान इ = 0;
    यावत् (इ < 50) {
        ल2 = जोड़ें(ल2, इ * 10);
        इ = इ + 1;
    }
    लिखतु(लंबाई(ल2)); // 50
    लिखतु(ल2[49]); // 490

    लिखतु("=== C. remove without shrink ===");
    // Capacity of ल2 is currently 64 (grown from 0 -> 4 -> 8 -> 16 -> 32 -> 64).
    // Pop 5 elements: size becomes 45, which is > 64/4 (16), so no shrink should occur.
    मान ज = 0;
    यावत् (ज < 5) {
        ल2 = निकालें(ल2);
        ज = ज + 1;
    }
    लिखतु(लंबाई(ल2)); // 45

    लिखतु("=== D. remove with shrink ===");
    // Pop until size becomes 16 (which is <= 64/4 = 16), triggering shrink to capacity 32.
    // Pop further until size becomes 8 (which is <= 32/4 = 8), triggering shrink to capacity 16.
    // Pop further until size becomes 4 (which is <= 16/4 = 4), triggering shrink to capacity 8.
    // Pop further until size becomes 2 (which is <= 8/4 = 2), triggering shrink to capacity 4.
    यावत् (लंबाई(ल2) > 2) {
        ल2 = निकालें(ल2);
    }
    लिखतु(लंबाई(ल2)); // 2
    लिखतु(ल2[0]); // 0
    लिखतु(ल2[1]); // 10

    लिखतु("=== E. repeated add/remove ===");
    मान क = 0;
    यावत् (क < 20) {
        ल2 = जोड़ें(ल2, 999);
        ल2 = निकालें(ल2);
        क = क + 1;
    }
    लिखतु(लंबाई(ल2)); // 2
    लिखतु(ल2[0]); // 0
    लिखतु(ल2[1]); // 10

    लिखतु("=== F. insert requiring growth ===");
    // Insert at index 1
    ल2 = डालें(ल2, 1, 5);
    // Insert at index 0
    ल2 = डालें(ल2, 0, -10);
    // Current elements: [-10, 0, 5, 10]
    लिखतु(लंबाई(ल2)); // 4
    लिखतु(ल2[0]); // -10
    लिखतु(ल2[1]); // 0
    लिखतु(ल2[2]); // 5
    लिखतु(ल2[3]); // 10

    // Insert that forces growth (capacity is 4, size becomes 5)
    ल2 = डालें(ल2, 2, 99);
    लिखतु(लंबाई(ल2)); // 5
    लिखतु(ल2[2]); // 99
    लिखतु(ल2[3]); // 5

    लिखतु("=== G. update without reallocation ===");
    ल2[2] = 888;
    लिखतु(ल2[2]); // 888

    लिखतु("=== H. रिक्त list ===");
    सूची खाली = [];
    लिखतु(लंबाई(खाली)); // 0

    लिखतु("=== I. single-element list ===");
    सूची एकल = [1];
    लिखतु(लंबाई(एकल)); // 1
    लिखतु(एकल[0]); // 1

    लिखतु("=== J. nested lists ===");
    सूची नेस्टेड = [[100, 200]];
    नेस्टेड[0] = जोड़ें(नेस्टेड[0], 300);
    लिखतु(लंबाई(नेस्टेड[0])); // 3
    लिखतु(नेस्टेड[0][2]); // 300

    लिखतु("=== K. strings inside lists ===");
    सूची स्ट्रिंग्स = ["अ", "ब"];
    स्ट्रिंग्स = जोड़ें(स्ट्रिंग्स, "स");
    लिखतु(लंबाई(स्ट्रिंग्स)); // 3
    लिखतु(स्ट्रिंग्स[2]); // स

    लिखतु("=== L. objects inside lists ===");
    सूची ऑब्जेक्ट्स = [नवीन नोड(100)];
    ऑब्जेक्ट्स = जोड़ें(ऑब्जेक्ट्स, नवीन नोड(200));
    लिखतु(लंबाई(ऑब्जेक्ट्स)); // 2
    मान वस्तु = ऑब्जेक्ट्स[1];
    लिखतु(वस्तु != शून्यम्); // सत्य

    लिखतु("=== M. GC + resize interaction ===");
    संग्रह_करो();
    // स्मृति_स्थिति() जानबूझकर नहीं — उसके सक्रिय/संग्रहित अंक interp
    // (conservative scope-rooting) बनाम native (precise liveness-rooting)
    // में collector-कार्यान्वयन के अनुसार अलग होते; देखें भाषा_परीक्षण/diagnostics/।
    // असली जाँच यही है: GC के बाद आगे की सूची-क्रियाएँ सही चलें (खंड N)।

    लिखतु("=== N. large list stress test ===");
    सूची विशाल = [];
    मान म = 0;
    यावत् (म < 1000) {
        विशाल = जोड़ें(विशाल, म);
        म = म + 1;
    }
    लिखतु(लंबाई(विशाल)); // 1000
    लिखतु(विशाल[999]); // 999
}
