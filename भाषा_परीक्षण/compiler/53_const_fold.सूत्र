// संकलन-काल स्थिरांक-तह (§४a) — अंकगणित/बिटवार/एकल तह के बाद
// परिणाम interp == native रहना चाहिए। कई folded मान > २³¹ →
// उत्सर्जक का movabsq पथ (movq $imm, mem का imm केवल ३२-बिट)।
कार्य मुख्य() {
    // अंकगणित तह — गुणनफल २³¹ के पार
    लिखतु(१०००००० * १००००००);              // १००००००००००००
    लिखतु(२००००००००० + २०००००००००);        // ४०००००००००
    लिखतु(२ + ३ * ४ - १);                  // १३
    लिखतु(० - (५ * ५));                    // -२५

    // एकल तह
    लिखतु(-(७ * ६));                       // -४२

    // बिटवार तह
    लिखतु(बिट_या(बिट_और(२४०, ६०), बाम_सरक(१, ८)));   // ३०४
    लिखतु(बाम_सरक(१, ४०));                 // १०९९५११६२७७७६
    लिखतु(दक्षिण_सरक(बाम_सरक(१, ६२), १०)); // ४५०३५९९६२७३७०४९६
    लिखतु(बिट_उलट(०));                     // -१
    लिखतु(बिट_और(बाम_सरक(२५५, २४), २१४७४८३६४७));  // २१३०७०६४३२

    // मिश्रित — कुछ folded कुछ runtime
    संख्या क = १००००००;
    लिखतु(क * १००००००);                    // १००००००००००००  (runtime — क चर)
    संख्या ख = बाम_सरक(१, ४५);
    लिखतु(ख + १);                          // ३५१८४३७२०८८८३३
}
