// OOP test for Sutra (वर्ग, नवीन, स्व)
लिखतु("=== OOP Class & Object Test ===");

वर्ग छात्र {
    मान नाम = "अज्ञात";
    संख्या आयु = ०;

    कार्य रचना(पाठ नाम, संख्या अ) {
        स्व.नाम = नाम;
        स्व.आयु = अ;
    }

    कार्य विवरण() {
        लिखतु("छात्र नाम: " + स्व.नाम);
        लिखतु("छात्र आयु:");
        लिखतु(स्व.आयु);
    }
}

मान स१ = नवीन छात्र("राधा", २१);
स१.विवरण();

लिखतु("आयु परिवर्तन पश्चात्:");
स१.आयु = २२;
स१.विवरण();
