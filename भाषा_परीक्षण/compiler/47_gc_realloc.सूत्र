कार्य मुख्य() {
    लिखतु("प्रारम्भः");

    // 1. String growth (causes realloc)
    पाठ क = "क";
    मान इ = 0;
    जबतक (इ < 100) {
        क = क + "ख";
        इ = इ + 1;
    }
    
    // GC before shrink
    संग्रह_करो();
    लिखतु(क);

    // 2. List growth and shrink
    सूची सू = [];
    मान ज = 0;
    जबतक (ज < 50) {
        सू = जोड़ें(सू, ज);
        ज = ज + 1;
    }
    
    संग्रह_करो();
    लिखतु("सूची_लंबाई:");
    लिखतु(लंबाई(सू));

    // Pop/shrink
    जबतक (लंबाई(सू) > 5) {
        सू = निकालें(सू);
    }

    संग्रह_करो();
    लिखतु("सूची_संकुचित_लंबाई:");
    लिखतु(लंबाई(सू));
    
    // Verify remaining elements
    लिखतु(सू[0]);
    लिखतु(सू[4]);
    
    लिखतु("समाप्तम्");
}

मुख्य();
