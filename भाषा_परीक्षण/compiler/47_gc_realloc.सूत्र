कार्य मुख्य() {
    लिखतु("प्रारम्भः");

    // १. String growth (causes realloc)
    पाठ क = "क";
    मान इ = ०;
    जबतक (इ < १००) {
        क = क + "ख";
        इ = इ + १;
    }
    
    // GC before shrink
    संग्रह_करो();
    लिखतु(क);

    // २. List growth and shrink
    सूची सू = [];
    मान ज = ०;
    जबतक (ज < ५०) {
        सू = जोड़ें(सू, ज);
        ज = ज + १;
    }
    
    संग्रह_करो();
    लिखतु("सूची_लंबाई:");
    लिखतु(लंबाई(सू));

    // Pop/shrink
    जबतक (लंबाई(सू) > ५) {
        सू = निकालें(सू);
    }

    संग्रह_करो();
    लिखतु("सूची_संकुचित_लंबाई:");
    लिखतु(लंबाई(सू));
    
    // Verify remaining elements
    लिखतु(सू[०]);
    लिखतु(सू[४]);
    
    लिखतु("समाप्तम्");
}

मुख्य();
