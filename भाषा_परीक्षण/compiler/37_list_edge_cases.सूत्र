कार्य मुख्य() {
    // १. जोड़ें check null
    प्रयत्न {
        जोड़ें(शून्यम्, २०);
        लिखतु("APPEND_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("APPEND_NULL_OK");
    }

    // २. निकालें check null
    प्रयत्न {
        निकालें(शून्यम्);
        लिखतु("POP_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("POP_NULL_OK");
    }

    // ३. डालें check null
    प्रयत्न {
        डालें(शून्यम्, ०, १०);
        लिखतु("INSERT_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("INSERT_NULL_OK");
    }

    // ४. हटाएं check null
    प्रयत्न {
        हटाएं(शून्यम्, ०);
        लिखतु("REMOVE_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("REMOVE_NULL_OK");
    }

    // ५. Nested lists creation, access, and assignment
    सूची ल = [[१०, २०], [३०, ४०]];
    लिखतु(ल[०][०]);
    लिखतु(ल[०][१]);
    लिखतु(ल[१][०]);
    लिखतु(ल[१][१]);

    ल[०][१] = ९९;
    ल[१][०] = ८८;
    लिखतु(ल[०][१]);
    लिखतु(ल[१][०]);
}
