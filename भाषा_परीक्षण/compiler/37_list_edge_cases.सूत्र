कार्य मुख्य() {
    // 1. जोड़ें check null
    प्रयत्न {
        जोड़ें(शून्यम्, 20);
        लिखतु("APPEND_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("APPEND_NULL_OK");
    }

    // 2. निकालें check null
    प्रयत्न {
        निकालें(शून्यम्);
        लिखतु("POP_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("POP_NULL_OK");
    }

    // 3. डालें check null
    प्रयत्न {
        डालें(शून्यम्, 0, 10);
        लिखतु("INSERT_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("INSERT_NULL_OK");
    }

    // 4. हटाएं check null
    प्रयत्न {
        हटाएं(शून्यम्, 0);
        लिखतु("REMOVE_NULL_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("REMOVE_NULL_OK");
    }

    // 5. Nested lists creation, access, and assignment
    सूची ल = [[10, 20], [30, 40]];
    लिखतु(ल[0][0]);
    लिखतु(ल[0][1]);
    लिखतु(ल[1][0]);
    लिखतु(ल[1][1]);

    ल[0][1] = 99;
    ल[1][0] = 88;
    लिखतु(ल[0][1]);
    लिखतु(ल[1][0]);
}
