// ६४_float_context_arith.सूत्र — दशमलव-घोषित लक्ष्य में अज्ञात-प्रकार ("मान") operands
// का अंकगणित (task_५५५३a४be)। पहले native/--release पर `म_पाओ(..) + म_पाओ(..)`
// (दो कॉल जिनका प्रकार अज्ञात) dynamic पूर्णांक-योग बनता था — दो IEEE-७५४ bit-pattern
// पूर्णांक की तरह जुड़ते और चुपचाप ग़लत गणित (inf / ०) मिलता। interpreter सही था।
// अब लक्ष्य दशमलव-घोषित (चर-प्रारंभ, असाइनमेंट, दशमलव-पैरामीटर का तर्क) हो तो +,-,*,/
// और एकल ऋण float अंकगणित हैं। नीचे हर परिणाम interpreter से बराबर होना चाहिए।

कार्य म_बनाओ() {
    शब्दकोश आ = {};
    आ["स्तंभ"] = २;
    सूची डेटा = [];
    डेटा = जोड़ें(डेटा, १.०);
    डेटा = जोड़ें(डेटा, २.०);
    डेटा = जोड़ें(डेटा, ३.०);
    डेटा = जोड़ें(डेटा, ४.०);
    आ["डेटा"] = डेटा;
    परत् आ;
}

कार्य म_पाओ(शब्दकोश आ, संख्या पं, संख्या स्तं) {
    संख्या स्तं_गिनती = आ["स्तंभ"];
    सूची डेटा = आ["डेटा"];
    परत् डेटा[पं * स्तं_गिनती + स्तं];
}

कार्य ले(दशमलव म) {
    परत् म;
}

// दशमलव-घोषित पैरामीटर को फलन के भीतर दुबारा असाइन करना
कार्य पुनः(शब्दकोश अ, दशमलव प) {
    प = म_पाओ(अ, ०, ०) + म_पाओ(अ, १, १);
    परत् प;
}

// पूर्णांक-डेटा का समांतर संस्करण — पूर्णांक-संदर्भ अपरिवर्तित रहना चाहिए
कार्य पू_बनाओ() {
    शब्दकोश आ = {};
    सूची डेटा = [];
    डेटा = जोड़ें(डेटा, ३);
    डेटा = जोड़ें(डेटा, ४);
    आ["डेटा"] = डेटा;
    परत् आ;
}

कार्य पू_पाओ(शब्दकोश आ, संख्या इ) {
    सूची डेटा = आ["डेटा"];
    परत् डेटा[इ];
}

कार्य मुख्य() {
    शब्दकोश अ = म_बनाओ();

    // १: घोषणा-संदर्भ — दो कॉल का योग
    दशमलव य१ = म_पाओ(अ, ०, ०) + म_पाओ(अ, ०, १);
    लिखतु("" + य१);

    // २: असाइनमेंट-संदर्भ — गुणा
    दशमलव य२ = ०.०;
    य२ = म_पाओ(अ, १, ०) * म_पाओ(अ, १, १);
    लिखतु("" + य२);

    // ३: नेस्टेड अंकगणित
    दशमलव य३ = (म_पाओ(अ, ०, ०) + म_पाओ(अ, ०, १)) * म_पाओ(अ, १, १);
    लिखतु("" + य३);

    // ४: भाग
    दशमलव य४ = म_पाओ(अ, १, १) / म_पाओ(अ, ०, १);
    लिखतु("" + य४);

    // ५: दशमलव-पैरामीटर के तर्क में
    दशमलव य५ = ले(म_पाओ(अ, ०, ०) + म_पाओ(अ, १, १));
    लिखतु("" + य५);

    // ६: एकल ऋण
    दशमलव य६ = -म_पाओ(अ, १, ०);
    लिखतु("" + य६);

    // ७: पूर्णांक-लिटरल के साथ (पूर्ण operand float में बदलता)
    दशमलव य७ = म_पाओ(अ, १, १) - १;
    लिखतु("" + य७);

    // ८: बंधे-लोकल वाला (हमेशा सही रहा) — अपरिवर्तित
    दशमलव क१ = म_पाओ(अ, ०, ०);
    दशमलव क२ = म_पाओ(अ, ०, १);
    दशमलव य८ = क१ + क२;
    लिखतु("" + य८);

    // ९: सुदृढ़ता — पूर्णांक-संदर्भ (संख्या-घोषित लक्ष्य) अपरिवर्तित: dynamic पूर्णांक-योग
    शब्दकोश प = पू_बनाओ();
    संख्या य९ = पू_पाओ(प, ०) + पू_पाओ(प, १);
    लिखतु("" + य९);
    संख्या य१० = पू_पाओ(प, १) * पू_पाओ(प, ०);
    लिखतु("" + य१०);

    // १०: सुदृढ़ता — `मान`-घोषित (dynamic) लक्ष्य अपरिवर्तित: dynamic पूर्णांक-योग
    मान य११ = पू_पाओ(प, ०) + पू_पाओ(प, १);
    लिखतु("" + य११);

    // ११: दशमलव-घोषित पैरामीटर का पुनः-असाइनमेंट
    दशमलव य१२ = पुनः(अ, ०.०);
    लिखतु("" + य१२);

    // १२: लूप में डॉट-गुणनफल संचय (आव्यूह-गुणा का भीतरी लूप) — भीतरी गुणा भी float
    दशमलव डॉट = ०.०;
    संख्या क = ०;
    यावत् (क < २) {
        डॉट = डॉट + म_पाओ(अ, ०, क) * म_पाओ(अ, १, क);
        क = क + १;
    }
    लिखतु("" + डॉट);

    परत् ०;
}
