कार्य मुख्य() {
    // १. Literal and Assignment
    दशमलव क = १.५;
    दशमलव ख = २.५;
    लिखतु(क);
    लिखतु(ख);

    // २. Float Arithmetic
    लिखतु(क + ख); // ४.०
    लिखतु(ख - क); // १.०
    लिखतु(क * ख); // ३.७५
    लिखतु(ख / क); // १.६६६६७ (or close)

    // ३. Float Comparisons
    लिखतु(क == ख); // असत्य
    लिखतु(क != ख); // सत्य
    लिखतु(क < ख);  // सत्य
    लिखतु(क > ख);  // असत्य
    लिखतु(क <= ख); // सत्य
    लिखतु(क >= ख); // असत्य

    // ४. Type Promotion (Int <-> Float)
    लिखतु(१० + क); // ११.५
    लिखतु(ख * २);  // ५.०
    लिखतु(३.० > २); // सत्य

    // ५. Mathematical Built-ins
    लिखतु(वर्गमूल(२.२५)); // १.५
    लिखतु(घात(२.०, ३.०)); // ८
    लिखतु(निरपेक्ष(-५.५)); // ५.५
    लिखतु(न्यूनतम(क, ख)); // १.५
    लिखतु(अधिकतम(क, ख)); // २.५
    लिखतु(गोल(क)); // २ (rounds १.५ to २)

    // ६. String Implicit Concatenation
    लिखतु("दशमलव: " + क);

    // ७. Division by Zero Exception
    प्रयत्न {
        लिखतु(क / ०.०);
        लिखतु(क / ०);
        लिखतु("FLOAT_DIV_BY_ZERO_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("FLOAT_DIV_BY_ZERO_OK");
    }
}


