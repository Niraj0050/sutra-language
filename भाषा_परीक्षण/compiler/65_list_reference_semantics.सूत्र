// ६५_list_reference_semantics.सूत्र — सूची का reference-semantics: growth/shrink के बाद हर alias को
// अद्यतन दिखे। पहले native पर growth handle को ही move कर देता था, इसलिए
// `सूची ब = अ; ब = जोड़ें(ब, x);` के बाद `अ` पुराने, dangling पते पर रह जाता था (और GC उसे free
// कर सकता था); interpreter में हमेशा सही था। interpreter और compiled आउटपुट का एक-सा होना ही कसौटी।

// स में गिन मान (०, ३, ६, …) जोड़ता है — स का अपना handle कभी नहीं बदलता
कार्य भरो(सूची स, संख्या गिन) {
    संख्या इ = ०;
    यावत् (इ < गिन) {
        स = जोड़ें(स, इ * ३);
        इ = इ + १;
    }
    परत् ०;
}

कार्य सार(पाठ नाम, सूची स) {
    यदि (लंबाई(स) == ०) {
        लिखतु(नाम + ": खाली");
    } अन्यथा {
        लिखतु(नाम + ": गिनती=" + लंबाई(स) + " पहला=" + स[०] + " अंतिम=" + स[लंबाई(स) - १]);
    }
    परत् ०;
}

कार्य मुख्य() {
    // १. alias + कई बार growth (क्षमता ०→४→८→१६→३२→६४)
    सूची अ = [];
    सूची ब = अ;
    संख्या इ = ०;
    यावत् (इ < ४०) {
        ब = जोड़ें(ब, इ);
        इ = इ + १;
    }
    सार("१ अ", अ);
    सार("१ ब", ब);

    // २. callee का append caller को दिखे (हर growth के पार)
    सूची क = [];
    भरो(क, ३७);
    सार("२ क", क);

    // ३. शब्दकोश के अंदर की सूची
    सूची ख = [];
    शब्दकोश म = {"सू": ख};
    भरो(ख, २५);
    सार("३ म[सू]", म["सू"]);
    सूची ग = म["सू"];
    ग = जोड़ें(ग, १००);
    सार("३ ख", ख);

    // ४. सूची की सूची: भीतरी सूची बढ़े तो बाहरी के रास्ते दिखे
    सूची बाहर = [[], [], []];
    सूची भीतर = बाहर[१];
    भरो(भीतर, ३३);
    सार("४ बाहर[१]", बाहर[१]);
    सार("४ बाहर[०]", बाहर[०]);

    // ५. डालना / हटाना / निकालना alias के रास्ते
    सूची र = [१, २, ३];
    सूची र२ = र;
    र२ = डालें(र२, ०, ९);
    सार("५ डाला", र);
    र२ = हटाएं(र२, १);
    सार("५ हटाया", र);
    संख्या ज = ०;
    यावत् (ज < ३०) {
        र२ = डालें(र२, लंबाई(र२), ज);
        ज = ज + १;
    }
    सार("५ बढ़ाया", र);
    यावत् (लंबाई(र२) > २) {
        र२ = निकालें(र२);
    }
    सार("५ घटाया", र);

    // ६. मिलाएं का परिणाम एक सामान्य सूची है — उस पर भरो() alias के रास्ते दिखे।
    // (नोट: मूल पहली सूची `प` मिलाएं के बाद अपरिवर्तित रहती है या नहीं — interpreter उसे जगह पर बढ़ा
    //  देता है, native नई सूची बनाता; यह पुराना, अलिखित अंतर है, इसलिए `प` पर कुछ दावा नहीं।)
    सूची प = [१, २];
    सूची फ = मिलाएं(प, [३, ४]);
    सूची फ२ = फ;
    भरो(फ२, ५);
    सार("६ फ", फ);

    // ७. एक ही सूची कई जगह (दो शब्दकोश में), एक से भरो — दूसरे में दिखे
    सूची सा = [];
    शब्दकोश म१ = {"क": सा};
    शब्दकोश म२ = {"क": सा};
    भरो(म१["क"], १५);
    सार("७ म२[क]", म२["क"]);

    परत् ०;
}
