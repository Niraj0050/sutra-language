// else-if (अन्यथा यदि / अन्यथा अगर) chaining test

कार्य श्रेणी(संख्या अंक) {
    अगर (अंक >= ९०) {
        परत् "अ";
    } अन्यथा अगर (अंक >= ८०) {
        परत् "ब";
    } अन्यथा अगर (अंक >= ७०) {
        परत् "स";
    } अन्यथा अगर (अंक >= ६०) {
        परत् "द";
    } अन्यथा {
        परत् "फ";
    }
}

कार्य मुख्य() {
    लिखतु("=== अन्यथा-यदि/अगर (Else-If) परीक्षण ===");

    // Test १: Basic else-if chain with अगर
    मान श्र१ = श्रेणी(९५);
    अगर (श्र१ == "अ") {
        लिखतु("१. श्रेणी ९५ = अ: सफल (PASS)");
    } अन्यथा {
        लिखतु("१. श्रेणी ९५: विफल (FAIL)");
    }

    मान श्र२ = श्रेणी(८५);
    अगर (श्र२ == "ब") {
        लिखतु("२. श्रेणी ८५ = ब: सफल (PASS)");
    } अन्यथा {
        लिखतु("२. श्रेणी ८५: विफल (FAIL)");
    }

    मान श्र३ = श्रेणी(५५);
    अगर (श्र३ == "फ") {
        लिखतु("३. श्रेणी ५५ = फ: सफल (PASS)");
    } अन्यथा {
        लिखतु("३. श्रेणी ५५: विफल (FAIL)");
    }

    // Test २: Using यदि with अन्यथा यदि
    मान क्ष = २;
    मान परिणाम = "";
    यदि (क्ष == १) {
        परिणाम = "एक";
    } अन्यथा यदि (क्ष == २) {
        परिणाम = "दो";
    } अन्यथा यदि (क्ष == ३) {
        परिणाम = "तीन";
    } अन्यथा {
        परिणाम = "अन्य";
    }

    यदि (परिणाम == "दो") {
        लिखतु("४. यदि-अन्यथा यदि chain: सफल (PASS)");
    } अन्यथा {
        लिखतु("४. यदि-अन्यथा यदि chain: विफल (FAIL)");
    }

    // Test ३: Mixed chain with default fallback
    मान य = १००;
    मान स्थिति = "";
    यदि (य < ०) {
        स्थिति = "नकारात्मक";
    } अन्यथा अगर (य == ०) {
        स्थिति = "शून्य";
    } अन्यथा यदि (य > ५०) {
        स्थिति = "बड़ा";
    } अन्यथा {
        स्थिति = "छोटा";
    }

    अगर (स्थिति == "बड़ा") {
        लिखतु("५. मिश्रित अगर/यदि chain: सफल (PASS)");
    } अन्यथा {
        लिखतु("५. मिश्रित अगर/यदि chain: विफल (FAIL)");
    }
}
