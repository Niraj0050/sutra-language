// 62_nested_float_list.सूत्र — नेस्टेड दशमलव सूची-लिटरल पर चेन्ड इंडेक्सिंग
// (task_c5094048): पहले native/--release पर `अ[०][१]` दशमलव का raw IEEE-754
// bit-pattern पूर्णांक की तरह छापता था; interpreter सही था। interpreter और
// compiled आउटपुट का एक-सा होना ही इस परीक्षण की कसौटी है।
कार्य मुख्य() {
    सूची अ = [[१.०, २.०], [३.०, ४.०]];
    लिखतु("" + अ[०][१]);
    लिखतु("" + अ[१][०]);

    सूची ब = [[[५.५]]];
    लिखतु("" + ब[०][०][०]);

    // सुदृढ़ता-जाँच: मिश्रित (गैर-दशमलव तत्व वाली) नेस्टेड सूची का पाठ-तत्व
    // सही "x" छपना चाहिए — pass मिश्रित सूची को कभी दशमलव नहीं कहता।
    सूची स = [[१.०, "x"]];
    लिखतु("" + स[०][१]);

    परत् ०;
}
