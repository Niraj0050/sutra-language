// शब्दकोश-साहित्य {"क": मान, ...} — बहु-प्रविष्टि सामग्री सही होनी चाहिए
कार्य दिखाओ(शब्दकोश द) {
    परत् द["एक"] + द["दो"] + द["तीन"];
}

कार्य मुख्य() {
    शब्दकोश अ = {"एक": 1, "दो": 2, "तीन": 3};
    लिखतु(अ["एक"]);          // 1
    लिखतु(अ["दो"]);          // 2
    लिखतु(अ["तीन"]);         // 3
    लिखतु(लंबाई(कुंजियाँ(अ))); // 3

    // फलन-तर्क के रूप में
    लिखतु(दिखाओ({"एक": 10, "दो": 20, "तीन": 30})); // 60

    // नेस्टेड
    शब्दकोश ब = {"भीतर": {"मान": 42}};
    मान भ = ब["भीतर"];
    लिखतु(भ["मान"]);         // 42

    // पाठ मान
    शब्दकोश स = {"नाम": "सूत्र", "प्रकार": "भाषा"};
    लिखतु(स["नाम"]);         // सूत्र
    लिखतु(स["प्रकार"]);      // भाषा

    // एक-प्रविष्टि
    शब्दकोश ए = {"केवल": 99};
    लिखतु(ए["केवल"]);        // 99

    // अद्यतन बाद में
    अ["दो"] = 200;
    लिखतु(अ["दो"]);          // 200
    लिखतु(लंबाई(कुंजियाँ(अ))); // 3 (अब भी)
}
