// शब्दकोश-साहित्य {"क": मान, ...} — बहु-प्रविष्टि सामग्री सही होनी चाहिए
कार्य दिखाओ(शब्दकोश द) {
    परत् द["एक"] + द["दो"] + द["तीन"];
}

कार्य मुख्य() {
    शब्दकोश अ = {"एक": १, "दो": २, "तीन": ३};
    लिखतु(अ["एक"]);          // १
    लिखतु(अ["दो"]);          // २
    लिखतु(अ["तीन"]);         // ३
    लिखतु(लंबाई(कुंजियाँ(अ))); // ३

    // फलन-तर्क के रूप में
    लिखतु(दिखाओ({"एक": १०, "दो": २०, "तीन": ३०})); // ६०

    // नेस्टेड
    शब्दकोश ब = {"भीतर": {"मान": ४२}};
    मान भ = ब["भीतर"];
    लिखतु(भ["मान"]);         // ४२

    // पाठ मान
    शब्दकोश स = {"नाम": "सूत्र", "प्रकार": "भाषा"};
    लिखतु(स["नाम"]);         // सूत्र
    लिखतु(स["प्रकार"]);      // भाषा

    // एक-प्रविष्टि
    शब्दकोश ए = {"केवल": ९९};
    लिखतु(ए["केवल"]);        // ९९

    // अद्यतन बाद में
    अ["दो"] = २००;
    लिखतु(अ["दो"]);          // २००
    लिखतु(लंबाई(कुंजियाँ(अ))); // ३ (अब भी)
}
