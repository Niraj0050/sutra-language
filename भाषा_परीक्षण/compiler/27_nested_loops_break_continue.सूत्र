// Regression test: Nested loops with break and continue
कार्य मुख्य() {
    // Outer loop from १ to ३
    पुनरावृत्तिः (मान इ = १; इ <= ३; इ = इ + १) {
        // Inner loop from १ to ५
        पुनरावृत्तिः (मान ज = १; ज <= ५; ज = ज + १) {
            अगर (ज == २) {
                जारीरह; // skips ज = २
            }
            अगर (ज == ४) {
                विरामः; // breaks inner loop when ज = ४
            }
            लिखतु(इ * १० + ज);
        }
    }
}
