कार्य मुख्य() {
    // उपखंड (substring)
    अगर (उपखंड("Sutra", ०, २) == "Su" तथा उपखंड("नमस्ते", ०, २) == "नम" तथा उपखंड("AनB", १, २) == "न") {
        लिखतु("SUBSTR_OK");
    } अन्यथा {
        लिखतु("SUBSTR_FAIL");
    }

    अगर (उपखंड("hello", २, २) == "") {
        लिखतु("SUBSTR_EMPTY_OK");
    } अन्यथा {
        लिखतु("SUBSTR_EMPTY_FAIL");
    }


    // खोजें (find)
    अगर (खोजें("Sutra", "tr") == २ तथा खोजें("नमस्ते", "स") == २ तथा खोजें("hello", "ज्ञ") == -१) {
        लिखतु("FIND_OK");
    } अन्यथा {
        लिखतु("FIND_FAIL");
    }


    // बदलें (replace)
    अगर (बदलें("hello world", "world", "Sutra") == "hello Sutra" तथा बदलें("abcabc", "bc", "X") == "aXabc" तथा बदलें("abc", "ज्ञ", "Q") == "abc") {
        लिखतु("REPLACE_OK");
    } अन्यथा {
        लिखतु("REPLACE_FAIL");
    }

    अगर (बदलें("abcabc", "bc", "") == "aabc") {
        लिखतु("REPLACE_EMPTY_OK");
    } अन्यथा {
        लिखतु("REPLACE_EMPTY_FAIL");
    }


    // विभाजित (split)
    मान विभाजित_१ = विभाजित("अ,ब,स", ",");
    अगर (लंबाई(विभाजित_१) == ३ तथा विभाजित_१[०] == "अ" तथा विभाजित_१[१] == "ब" तथा विभाजित_१[२] == "स") {
        लिखतु("SPLIT_OK");
    } अन्यथा {
        लिखतु("SPLIT_FAIL");
    }

    मान विभाजित_२ = विभाजित("अ,,ब,", ",");
    अगर (लंबाई(विभाजित_२) == ४ तथा विभाजित_२[०] == "अ" तथा विभाजित_२[१] == "" तथा विभाजित_२[२] == "ब" तथा विभाजित_२[३] == "") {
        लिखतु("SPLIT_EMPTY_OK");
    } अन्यथा {
        लिखतु("SPLIT_EMPTY_FAIL");
    }

    अगर (विभाजित("नमस्ते", "म") [०] == "न" तथा विभाजित("नमस्ते", "म")[१] == "स्ते") {
        लिखतु("SPLIT_DEVA_OK");
    } अन्यथा {
        लिखतु("SPLIT_DEVA_FAIL");
    }


    // संयोजित (join)
    मान ल१ = ["अ", "ब", "स"];
    अगर (संयोजित(ल१, ",") == "अ,ब,स" तथा संयोजित(["क्ष"], "-") == "क्ष" तथा संयोजित([], "-") == "") {
        लिखतु("JOIN_OK");
    } अन्यथा {
        लिखतु("JOIN_FAIL");
    }


    // छाँटें (trim)
    अगर (छाँटें("  hello  ") == "hello" तथा छाँटें("\tनमस्ते\नाम") == "नमस्ते" तथा छाँटें("   ") == "") {
        लिखतु("TRIM_OK");
    } अन्यथा {
        लिखतु("TRIM_FAIL");
    }

    // आरंभिक / अंतिम (startswith/endswith)
    अगर (आरंभिक("नमस्ते", "नम") तथा आरंभिक("Sutra", "Su") तथा !(आरंभिक("Sutra", "su")) तथा अंतिम("नमस्ते", "स्ते") तथा अंतिम("hello", "lo") तथा !(अंतिम("hello", "LO"))) {
        लिखतु("PREFIX_SUFFIX_OK");
    } अन्यथा {
        लिखतु("PREFIX_SUFFIX_FAIL");
    }

    अगर (आरंभिक("abc", "") तथा अंतिम("abc", "")) {
        लिखतु("EMPTY_PREFIX_SUFFIX_OK");
    } अन्यथा {
        लिखतु("EMPTY_PREFIX_SUFFIX_FAIL");
    }
}
