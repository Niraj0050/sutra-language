कार्य संशोधित(सूची संख्याः) {
    संख्याः[०] = ९९;
    परत् संख्याः;
}

कार्य मुख्य() {
    सूची बाह्य = [[१०, २०], [३०, ४०]];
    बाह्य[१][०] = ९९;
    लिखतु(बाह्य[१][०]);
    लिखतु(बाह्य[०][१]);

    सूची मानानि = [१०, २०];
    सूची परिणाम = संशोधित(मानानि);
    लिखतु(लंबाई(परिणाम));
    लिखतु(परिणाम[०]);
}
