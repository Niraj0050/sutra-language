// Phase ५ Test: User-defined class type as function parameter type annotation
वर्ग व्यक्ति {
    मान नाम;
    
    कार्य रचना(मान नाम_तर्क) {
        स्व.नाम = नाम_तर्क;
    }
    
    कार्य बोलो() {
        लिखतु(स्व.नाम);
    }
}

कार्य प्रिंट_नाम(व्यक्ति प) {
    प.बोलो();
    लिखतु(प.नाम);
}

कार्य मुख्य() {
    मान व्य = नवीन व्यक्ति("श्याम");
    प्रिंट_नाम(व्य);
}
