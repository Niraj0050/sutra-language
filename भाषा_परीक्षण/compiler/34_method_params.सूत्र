// Phase 5 Test: Method with parameters
वर्ग गणक {
    मान मूल्य;

    कार्य रचना(मान प्रारंभ) {
        स्व.मूल्य = प्रारंभ;
    }

    कार्य जोड़ो(मान अ) {
        स्व.मूल्य = स्व.मूल्य + अ;
    }

    कार्य प्राप्त() {
        परत् स्व.मूल्य;
    }
}

कार्य मुख्य() {
    मान ग = नवीन गणक(0);
    ग.जोड़ो(5);
    ग.जोड़ो(10);
    लिखतु(ग.प्राप्त());
    लिखतु(ग.मूल्य);
}
