// Native Compiler Test ४८: प्रकार (Type Inquiry) Parity Test
कार्य जाँचे(मान प) {
    लिखतु(प्रकार(प));
}

कार्य मुख्य() {
    // १. literal types static checks
    लिखतु(प्रकार(१००));
    लिखतु(प्रकार(१०.५));
    लिखतु(प्रकार("नमस्ते"));
    लिखतु(प्रकार(सत्य));
    लिखतु(प्रकार(शून्यम्));
    लिखतु(प्रकार([१, २]));
    लिखतु(प्रकार({}));

    // २. variable types static checks
    संख्या क = २००;
    दशमलव ख = २०.५;
    पाठ ग = "शुभ";
    बूल घ = असत्य;
    सूची ङ = [१, २];
    शब्दकोश च = {};
    
    लिखतु(प्रकार(क));
    लिखतु(प्रकार(ख));
    लिखतु(प्रकार(ग));
    लिखतु(प्रकार(घ));
    लिखतु(प्रकार(ङ));
    लिखतु(प्रकार(च));

    // ३. dynamic/unknown checks via man/ajanaka
    मान छ = ३००;
    मान ज = "नमस्ते";
    मान झ = [१, २];
    मान ञ = {};
    मान ट = शून्यम्;

    लिखतु(प्रकार(छ));
    लिखतु(प्रकार(ज));
    लिखतु(प्रकार(झ));
    लिखतु(प्रकार(ञ));
    लिखतु(प्रकार(ट));

    // ४. function dynamic arguments checks
    जाँचे(५००);
    जाँचे("जाँच");
    जाँचे([१०]);
    जाँचे({"क": १});
    जाँचे(शून्यम्);
}
