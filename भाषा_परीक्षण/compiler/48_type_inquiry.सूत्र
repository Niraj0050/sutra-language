// Native Compiler Test 48: प्रकार (Type Inquiry) Parity Test
कार्य जाँचे(मान प) {
    लिखतु(प्रकार(प));
}

कार्य मुख्य() {
    // 1. literal types static checks
    लिखतु(प्रकार(100));
    लिखतु(प्रकार(10.5));
    लिखतु(प्रकार("नमस्ते"));
    लिखतु(प्रकार(सत्य));
    लिखतु(प्रकार(शून्यम्));
    लिखतु(प्रकार([1, 2]));
    लिखतु(प्रकार({}));

    // 2. variable types static checks
    संख्या क = 200;
    दशमलव ख = 20.5;
    पाठ ग = "शुभ";
    बूल घ = असत्य;
    सूची ङ = [1, 2];
    शब्दकोश च = {};
    
    लिखतु(प्रकार(क));
    लिखतु(प्रकार(ख));
    लिखतु(प्रकार(ग));
    लिखतु(प्रकार(घ));
    लिखतु(प्रकार(ङ));
    लिखतु(प्रकार(च));

    // 3. dynamic/unknown checks via man/ajanaka
    मान छ = 300;
    मान ज = "नमस्ते";
    मान झ = [1, 2];
    मान ञ = {};
    मान ट = शून्यम्;

    लिखतु(प्रकार(छ));
    लिखतु(प्रकार(ज));
    लिखतु(प्रकार(झ));
    लिखतु(प्रकार(ञ));
    लिखतु(प्रकार(ट));

    // 4. function dynamic arguments checks
    जाँचे(500);
    जाँचे("जाँच");
    जाँचे([10]);
    जाँचे({"क": 1});
    जाँचे(शून्यम्);
}
