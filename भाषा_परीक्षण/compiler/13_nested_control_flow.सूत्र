// Native Compiler Test १३: Nested Control Flow & Functions
कार्य गणना(संख्या सीमा) {
    मान कुल = ०;
    पुनरावृत्तिः (मान इ = १; इ <= सीमा; इ = इ + १) {
        अगर (इ % २ == ०) {
            कुल = कुल + इ;
        }
    }
    परत् कुल;
}

कार्य मुख्य() {
    मान परिणाम = गणना(१०);
    लिखतु(परिणाम); // Sum of even numbers <= १० = २+४+६+८+१० = ३०
}
