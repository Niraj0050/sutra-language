// Native Compiler Test १२: Break & Continue (विरामः, जारीरह)
कार्य मुख्य() {
    लिखतु(१००);

    // Loop with Break
    मान इ = १;
    जबतक (इ <= १०) {
        अगर (इ == ४) {
            विरामः;
        }
        लिखतु(इ);
        इ = इ + १;
    }

    लिखतु(२००);

    // Loop with Continue
    पुनरावृत्तिः (मान क = १; क <= ५; क = क + १) {
        अगर (क == ३) {
            जारीरह;
        }
        लिखतु(क);
    }
}
