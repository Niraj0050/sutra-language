// Regression test: Multi-branch else-if chaining
कार्य मूल्याङ्कनम्(संख्या अंक) {
    अगर (अंक >= ९०) {
        परत् "उत्कृष्टम्";
    } अन्यथा अगर (अंक >= ८०) {
        परत् "उत्तमम्";
    } अन्यथा यदि (अंक >= ७०) {
        परत् "मध्यमम्";
    } अन्यथा अगर (अंक >= ६०) {
        परत् "साधारणम्";
    } अन्यथा {
        परत् "अनुत्तीर्णम्";
    }
}

कार्य मुख्य() {
    लिखतु(मूल्याङ्कनम्(९५)); // Expected: उत्कृष्टम्
    लिखतु(मूल्याङ्कनम्(८२)); // Expected: उत्तमम्
    लिखतु(मूल्याङ्कनम्(७५)); // Expected: मध्यमम्
    लिखतु(मूल्याङ्कनम्(६४)); // Expected: साधारणम्
    लिखतु(मूल्याङ्कनम्(४५)); // Expected: अनुत्तीर्णम्
}
