// Regression test: Multi-branch else-if chaining
कार्य मूल्याङ्कनम्(संख्या अंक) {
    अगर (अंक >= 90) {
        परत् "उत्कृष्टम्";
    } अन्यथा अगर (अंक >= 80) {
        परत् "उत्तमम्";
    } अन्यथा यदि (अंक >= 70) {
        परत् "मध्यमम्";
    } अन्यथा अगर (अंक >= 60) {
        परत् "साधारणम्";
    } अन्यथा {
        परत् "अनुत्तीर्णम्";
    }
}

कार्य मुख्य() {
    लिखतु(मूल्याङ्कनम्(95)); // Expected: उत्कृष्टम्
    लिखतु(मूल्याङ्कनम्(82)); // Expected: उत्तमम्
    लिखतु(मूल्याङ्कनम्(75)); // Expected: मध्यमम्
    लिखतु(मूल्याङ्कनम्(64)); // Expected: साधारणम्
    लिखतु(मूल्याङ्कनम्(45)); // Expected: अनुत्तीर्णम्
}
