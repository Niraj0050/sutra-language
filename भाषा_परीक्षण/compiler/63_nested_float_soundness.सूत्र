// ६३_nested_float_soundness.सूत्र — नेस्टेड दशमलव सूची-लिटरल की सुदृढ़ता (soundness) जाँच।
// ६२_ का प्रकार-उन्नयन तभी सुरक्षित है जब संरचना "बंद" हो: कोई सदस्य-सूची (या उससे पढ़ी
// पंक्ति) लिखी/जोड़ी/कॉल को दी/लौटाई न जाए। नीचे हर मामला interpreter और compiled
// backends पर एक-सा आउटपुट देना चाहिए — विशेषकर वे जहाँ बाद में गैर-दशमलव मान रखा गया।

कार्य बदलो(सूची स) {
    सूची पंक्ति = स[०];
    पंक्ति[०] = "फलन-से";
    परत् ०;
}

कार्य मुख्य() {
    // १: सपाट (flat) दशमलव सूची में पाठ लिखकर पढ़ना — पुराना व्यवहार बना रहे
    सूची क = [१.०, २.०];
    क[०] = "स";
    लिखतु("" + क[०]);

    // २: नेस्टेड में चेन से पाठ लिखकर पढ़ना
    सूची अ = [[१.०, २.०]];
    अ[०][१] = "य";
    लिखतु("" + अ[०][१]);

    // ३: पूरी पंक्ति बदलना
    सूची ब = [[१.०, २.०]];
    ब[०] = ["प", "फ"];
    लिखतु("" + ब[०][०]);

    // ४: बाहरी सूची में जोड़ना — पंक्ति-पठन अब पंक्ति नहीं, पाठ है
    सूची ग = [[१.०]];
    ग = जोड़ें(ग, "ज");
    लिखतु("" + ग[१]);

    // ५: पंक्ति-उपनाम (alias) से पाठ लिखना
    सूची घ = [[१.०, २.०]];
    सूची र = घ[०];
    र[०] = "उ";
    लिखतु("" + घ[०][०]);

    // ६: कॉल को सौंपना — कॉल पंक्ति बदल देता है
    सूची च = [[१.०, २.०]];
    बदलो(च);
    लिखतु("" + च[०][०]);

    // ७: पूर्णांक नेस्टेड — अपरिवर्तित (दशमलव नहीं माना जाए)
    सूची छ = [[१, २], [३, ४]];
    लिखतु("" + छ[१][०]);

    // ८: मिश्रित पंक्तियाँ (एक दशमलव, एक पूर्णांक) — पूर्णांक पंक्ति का तत्व सही छपे
    सूची ज = [[१.०, २.०], [३, ४]];
    लिखतु("" + ज[१][०]);

    // ९: सकारात्मक — बंद संरचना, पंक्ति-उपनाम से पठन (दशमलव सही छपे)
    सूची झ = [[५.५, ६.५]];
    सूची पं = झ[०];
    लिखतु("" + पं[१]);

    // १०: सकारात्मक — चर-सूचकांक से पठन, लूप में
    सूची ट = [[१.५, २.५], [३.५, ४.५]];
    संख्या इ = ०;
    यावत् (इ < २) {
        लिखतु("" + ट[इ][१]);
        इ = इ + १;
    }

    परत् ०;
}
