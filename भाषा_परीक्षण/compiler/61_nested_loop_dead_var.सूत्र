// प्रत्यावर्तन: भीतरी लूप का चर (मान च) जो header में merge होता पर लूप के
// बाहर मृत — दो अन्योन्याश्रित मृत फाई बनाता। पुराना use-गणना DCE इन्हें नहीं
// हटाता → अमान्य SSA चक्र (%a=phi[%b,pre], %b=phi[%a,hdr]) → --release में
// llvm-link "does not dominate all uses" से विफल। mark-sweep DCE इसे पकड़ता।
कार्य स्कैनर(शब्दकोश अ) {
    यावत् (अ["इ"] < अ["ल"]) {
        मान क = अगला(अ);
        यदि ( क == 47 ) {
            यदि (अ["इ"] + 1 < अ["ल"]) {
                यदि (झलक(अ) == 42) {
                    अगला(अ);
                    अगला(अ);
                    यावत् (अ["इ"] < अ["ल"]) {
                        मान च = अगला(अ);
                        यदि (च == 42 && झलक(अ) == 47) {
                            अगला(अ);
                            विरामः;
                        }
                    }
                    जारीरह;
                }
            }
        }
        विरामः;
    }
    परत् अ["इ"];
}
कार्य अगला(शब्दकोश अ) { अ["इ"] = अ["इ"] + 1; परत् 47; }
कार्य झलक(शब्दकोश अ) { परत् 42; }
कार्य मुख्य() {
    शब्दकोश अ = {};
    अ["इ"] = 0;
    अ["ल"] = 8;
    लिखतु(स्कैनर(अ));
}
