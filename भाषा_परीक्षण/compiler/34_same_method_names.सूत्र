वर्ग आयत {
    संख्या चौड़ाई;
    संख्या ऊँचाई;
    
    कार्य रचना(संख्या च, संख्या ऊ) {
        स्व.चौड़ाई = च;
        स्व.ऊँचाई = ऊ;
    }
    
    कार्य क्षेत्रफल() {
        परत् स्व.चौड़ाई * स्व.ऊँचाई;
    }
    
    कार्य विवरण() {
        लिखतु("आयत: " + स्व.चौड़ाई + ", " + स्व.ऊँचाई);
    }
}

वर्ग वृत्त {
    संख्या त्रिज्या;
    
    कार्य रचना(संख्या त्र) {
        स्व.त्रिज्या = त्र;
    }
    
    कार्य क्षेत्रफल() {
        परत् ३ * स्व.त्रिज्या * स्व.त्रिज्या;
    }
    
    कार्य विवरण() {
        लिखतु("वृत्त: " + स्व.त्रिज्या);
    }
}

कार्य मुख्य() {
    मान आ = नवीन आयत(५, १०);
    मान वृ = नवीन वृत्त(४);
    
    आ.विवरण();
    लिखतु(आ.क्षेत्रफल());
    
    वृ.विवरण();
    लिखतु(वृ.क्षेत्रफल());
}
