// Functions (कार्य) Test — Typed, Untyped, Mixed, and Recursive

// 1. Recursive function with typed parameter
कार्य क्रमगुणित(संख्या अ) {
    अगर (अ <= 1) {
        परत् 1;
    }
    परत् अ * क्रमगुणित(अ - 1);
}

// 2. Recursive function with untyped parameter
कार्य फिबोनाची(अ) {
    अगर (अ <= 0) {
        परत् 0;
    }
    अगर (अ == 1) {
        परत् 1;
    }
    परत् फिबोनाची(अ - 1) + फिबोनाची(अ - 2);
}

// 3. Mixed parameter types (typed and untyped)
कार्य मिश्रित(संख्या अ, ब) {
    परत् अ + ब;
}

// 4. Multiple untyped parameters
कार्य बहु_अमानक(अ, ब, स) {
    परत् अ * ब * स;
}

// 5. Multiple typed parameters
कार्य बहु_मानक(संख्या अ, संख्या ब, संख्या स) {
    परत् अ + ब + स;
}

कार्य मुख्य() {
    लिखतु("=== कार्य एवं पुनरावर्तन (Functions & Recursion) परीक्षण ===");

    // Test 1: Recursive typed
    मान फ5 = क्रमगुणित(5);
    अगर (फ5 == 120) {
        लिखतु("1. क्रमगुणित(5) = 120 (Typed Recursion): सफल (PASS)");
    } अन्यथा {
        लिखतु("1. क्रमगुणित(5): विफल (FAIL)");
    }

    // Test 2: Recursive untyped
    मान फिब6 = फिबोनाची(6);
    अगर (फिब6 == 8) {
        लिखतु("2. फिबोनाची(6) = 8 (Untyped Recursion): सफल (PASS)");
    } अन्यथा {
        लिखतु("2. फिबोनाची(6): विफल (FAIL)");
    }

    // Test 3: Mixed parameters
    मान योग = मिश्रित(10, 20);
    अगर (योग == 30) {
        लिखतु("3. मिश्रित(10, 20) (Mixed Typed/Untyped): सफल (PASS)");
    } अन्यथा {
        लिखतु("3. मिश्रित(10, 20): विफल (FAIL)");
    }

    // Test 4: Multiple untyped parameters
    मान गुणन = बहु_अमानक(2, 3, 4);
    अगर (गुणन == 24) {
        लिखतु("4. बहु_अमानक(2, 3, 4) (Multiple Untyped): सफल (PASS)");
    } अन्यथा {
        लिखतु("4. बहु_अमानक(2, 3, 4): विफल (FAIL)");
    }

    // Test 5: Multiple typed parameters
    मान योग3 = बहु_मानक(10, 20, 30);
    अगर (योग3 == 60) {
        लिखतु("5. बहु_मानक(10, 20, 30) (Multiple Typed): सफल (PASS)");
    } अन्यथा {
        लिखतु("5. बहु_मानक(10, 20, 30): विफल (FAIL)");
    }

    लिखतु("=== कार्य परीक्षण सम्पन्न ===");
}
