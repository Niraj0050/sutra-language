// बिटवार बिल्टिन — बिट_और(&) बिट_या(|) बिट_भेद(^) बिट_उलट(~)
// बाम_सरक(<<) दक्षिण_सरक(>> तार्किक/unsigned)। §3a
कार्य मुख्य() {
    लिखतु(बिट_और(61680, 4080));
    लिखतु(बिट_या(61680, 4080));
    लिखतु(बिट_भेद(61680, 4080));
    लिखतु(बिट_उलट(0));
    लिखतु(बिट_उलट(255));
    लिखतु(बाम_सरक(1, 40));
    लिखतु(दक्षिण_सरक(बाम_सरक(1, 40), 20));
    लिखतु(दक्षिण_सरक(0 - 1, 61));
    लिखतु(बिट_और(दक्षिण_सरक(बाम_सरक(171, 16), 16), 255));
    संख्या ह = 40503;
    ह = बिट_भेद(ह, बाम_सरक(ह, 7));
    ह = बिट_और(ह, 2147483647);
    लिखतु(ह);
    // xorshift एक चक्कर (सब मान < 2³¹)
    संख्या स = 123456789;
    स = बिट_भेद(स, बाम_सरक(स, 3));
    स = बिट_और(स, 2147483647);
    स = बिट_भेद(स, दक्षिण_सरक(स, 5));
    लिखतु(स);
}
