// बिटवार बिल्टिन — बिट_और(&) बिट_या(|) बिट_भेद(^) बिट_उलट(~)
// बाम_सरक(<<) दक्षिण_सरक(>> तार्किक/unsigned)। §३a
कार्य मुख्य() {
    लिखतु(बिट_और(६१६८०, ४०८०));
    लिखतु(बिट_या(६१६८०, ४०८०));
    लिखतु(बिट_भेद(६१६८०, ४०८०));
    लिखतु(बिट_उलट(०));
    लिखतु(बिट_उलट(२५५));
    लिखतु(बाम_सरक(१, ४०));
    लिखतु(दक्षिण_सरक(बाम_सरक(१, ४०), २०));
    लिखतु(दक्षिण_सरक(० - १, ६१));
    लिखतु(बिट_और(दक्षिण_सरक(बाम_सरक(१७१, १६), १६), २५५));
    संख्या ह = ४०५०३;
    ह = बिट_भेद(ह, बाम_सरक(ह, ७));
    ह = बिट_और(ह, २१४७४८३६४७);
    लिखतु(ह);
    // xorshift एक चक्कर (सब मान < २³¹)
    संख्या स = १२३४५६७८९;
    स = बिट_भेद(स, बाम_सरक(स, ३));
    स = बिट_और(स, २१४७४८३६४७);
    स = बिट_भेद(स, दक्षिण_सरक(स, ५));
    लिखतु(स);
}
