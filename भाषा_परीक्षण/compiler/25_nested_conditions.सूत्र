// Regression test: Deeply nested conditions
कार्य मुख्य() {
    मान अ = १;
    मान ब = २;
    मान स = ३;
    मान परिणाम = ०;

    अगर (अ == १) {
        अगर (ब == २) {
            अगर (स == ३) {
                परिणाम = १०;
            } अन्यथा {
                परिणाम = २०;
            }
        } अन्यथा {
            परिणाम = ३०;
        }
    } अन्यथा {
        परिणाम = ४०;
    }

    लिखतु(परिणाम); // Expected: १०

    अ = १;
    ब = ५;
    अगर (अ == १) {
        अगर (ब == २) {
            परिणाम = १००;
        } अन्यथा {
            अगर (स == ३) {
                परिणाम = २००;
            } अन्यथा {
                परिणाम = ३००;
            }
        }
    } अन्यथा {
        परिणाम = ४००;
    }

    लिखतु(परिणाम); // Expected: २००
}
