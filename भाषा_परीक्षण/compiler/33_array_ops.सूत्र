कार्य मुख्य() {
    सूची ल = [10, 20];
    लिखतु(ल[0]);
    लिखतु(ल[1]);
    लिखतु(लंबाई(ल));

    // जोड़ें
    ल = जोड़ें(ल, 30);
    लिखतु(ल[2]);
    लिखतु(लंबाई(ल));

    // निकालें
    ल = निकालें(ल);
    लिखतु(लंबाई(ल));
    लिखतु(ल[1]);

    // डालें
    ल = डालें(ल, 1, 15);
    लिखतु(ल[0]);
    लिखतु(ल[1]);
    लिखतु(ल[2]);
    लिखतु(लंबाई(ल));

    // हटाएं
    ल = हटाएं(ल, 1);
    लिखतु(ल[0]);
    लिखतु(ल[1]);
    लिखतु(लंबाई(ल));

    // मिलाएं
    सूची ल2 = [40, 50];
    सूची ल3 = मिलाएं(ल, ल2);
    लिखतु(ल3[0]);
    लिखतु(ल3[1]);
    लिखतु(ल3[2]);
    लिखतु(ल3[3]);
    लिखतु(लंबाई(ल3));

    // खोजें (Polymorphic search)
    लिखतु(खोजें(ल3, 10));
    लिखतु(खोजें(ल3, 20));
    लिखतु(खोजें(ल3, 50));
    लिखतु(खोजें(ल3, 99)); // Not found: -1
}
