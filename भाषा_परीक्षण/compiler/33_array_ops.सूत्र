कार्य मुख्य() {
    सूची ल = [१०, २०];
    लिखतु(ल[०]);
    लिखतु(ल[१]);
    लिखतु(लंबाई(ल));

    // जोड़ें
    ल = जोड़ें(ल, ३०);
    लिखतु(ल[२]);
    लिखतु(लंबाई(ल));

    // निकालें
    ल = निकालें(ल);
    लिखतु(लंबाई(ल));
    लिखतु(ल[१]);

    // डालें
    ल = डालें(ल, १, १५);
    लिखतु(ल[०]);
    लिखतु(ल[१]);
    लिखतु(ल[२]);
    लिखतु(लंबाई(ल));

    // हटाएं
    ल = हटाएं(ल, १);
    लिखतु(ल[०]);
    लिखतु(ल[१]);
    लिखतु(लंबाई(ल));

    // मिलाएं
    सूची ल२ = [४०, ५०];
    सूची ल३ = मिलाएं(ल, ल२);
    लिखतु(ल३[०]);
    लिखतु(ल३[१]);
    लिखतु(ल३[२]);
    लिखतु(ल३[३]);
    लिखतु(लंबाई(ल३));

    // खोजें (Polymorphic search)
    लिखतु(खोजें(ल३, १०));
    लिखतु(खोजें(ल३, २०));
    लिखतु(खोजें(ल३, ५०));
    लिखतु(खोजें(ल३, ९९)); // Not found: -१
}
