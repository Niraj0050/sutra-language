// 66_list_zero_size_neighbors.सूत्र — रिग्रेशन ("bug 7"): खाली सूची का तत्व-बफर शून्य-आकार होता था; ऐसे
// ब्लॉक को free करने पर allocator का free-list "next" लेखन (payload+०) पड़ोसी ब्लॉक का header-टैग मिटा
// देता था — जीवित शब्दकोश/सूची "मुक्त" (टैग ०) बन जाते और type-dispatch ग़लत रास्ता लेता
// ("सूच्याः सीमा अतिक्रान्ता")। अब हर आवंटन का payload कम से कम १६ बाइट है। कसौटी: खाली सूचियों के
// ठीक बाद बने ऑब्जेक्ट (शब्दकोश, पाठ, सूचियाँ) बढ़ने/घटने/GC के बाद भी सही रहें।

कार्य जाँचो(पाठ नाम, संख्या गलत) {
    यदि (गलत == ०) {
        लिखतु(नाम + ": ठीक");
    } अन्यथा {
        लिखतु(नाम + ": गलत=" + गलत);
    }
    परत् ०;
}

// धारक की हर प्रविष्टि जाँचो: शब्दकोश {"क्रम": इ, "नाम": "आ<इ>"} और पाठ "प<इ>"
कार्य सत्यापन(सूची धारक, सूची पाठ_धारक) {
    संख्या गलत = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(धारक)) {
        शब्दकोश ड = धारक[इ];
        यदि (ड["क्रम"] != इ) { गलत = गलत + १; }
        यदि (ड["नाम"] != "आ" + इ) { गलत = गलत + १; }
        पाठ प = पाठ_धारक[इ];
        यदि (प != "प" + इ) { गलत = गलत + १; }
        इ = इ + १;
    }
    परत् गलत;
}

कार्य मुख्य() {
    // १. हर चक्र: खाली सूची → ठीक बाद नए ऑब्जेक्ट → खाली सूची बढ़ी (पुराना शून्य-आकार बफर free)
    सूची धारक = [];
    सूची पाठ_धारक = [];
    संख्या गलत१ = ०;
    संख्या इ = ०;
    यावत् (इ < ३००) {
        सूची खाली = [];
        शब्दकोश ड = {"क्रम": इ, "नाम": "आ" + इ};
        पाठ प = "प" + इ;
        खाली = जोड़ें(खाली, इ);
        सूची दूसरी = [];
        दूसरी = डालें(दूसरी, ०, इ);
        दूसरी = हटाएं(दूसरी, ०);
        सूची तीसरी = [];
        तीसरी = जोड़ें(तीसरी, "अ");
        तीसरी = निकालें(तीसरी);
        धारक = जोड़ें(धारक, ड);
        पाठ_धारक = जोड़ें(पाठ_धारक, प);
        यदि (खाली[०] != इ) { गलत१ = गलत१ + १; }
        यदि (लंबाई(दूसरी) != ०) { गलत१ = गलत१ + १; }
        यदि (लंबाई(तीसरी) != ०) { गलत१ = गलत१ + १; }
        इ = इ + १;
    }
    जाँचो("१ चक्र के भीतर", गलत१);
    जाँचो("१ बाद में सत्यापन", सत्यापन(धारक, पाठ_धारक));
    संग्रह_करो();
    जाँचो("१ GC के बाद", सत्यापन(धारक, पाठ_धारक));

    // GC से मुक्त हुई जगह नए ऑब्जेक्ट से भर दो — जीवित ऑब्जेक्ट मुक्त-सूची में गए होते तो अब बिगड़ते
    सूची भराव = [];
    संख्या ज = ०;
    यावत् (ज < ४००) {
        शब्दकोश नया = {"भ": ज, "भ२": "भराव" + ज};
        भराव = जोड़ें(भराव, नया);
        ज = ज + १;
    }
    जाँचो("१ भराव के बाद", सत्यापन(धारक, पाठ_धारक));

    // २. एक साथ बहुत सी खाली सूचियाँ जीवित; फिर एक-एक कर सब बढ़ाओ (पड़ोसी सूचियों के handle सुरक्षित?)
    सूची सब = [];
    संख्या क = ०;
    यावत् (क < २००) {
        सब = जोड़ें(सब, []);
        क = क + १;
    }
    क = ०;
    यावत् (क < २००) {
        सूची भीतर = सब[क];
        भीतर = जोड़ें(भीतर, क);
        भीतर = जोड़ें(भीतर, क * २);
        क = क + १;
    }
    संग्रह_करो();
    संख्या गलत२ = ०;
    क = ०;
    यावत् (क < २००) {
        सूची भीतर = सब[क];
        यदि (लंबाई(भीतर) != २) { गलत२ = गलत२ + १; }
        यदि (भीतर[०] != क) { गलत२ = गलत२ + १; }
        यदि (भीतर[१] != क * २) { गलत२ = गलत२ + १; }
        क = क + १;
    }
    जाँचो("२ खाली सूचियों का बढ़ना", गलत२);

    // ३. खाली सूचियों के बीच बुने शब्दकोश/पाठ: हर तरह की अदला-बदली के बाद भी सही
    सूची मिश्र = [];
    क = ०;
    यावत् (क < १५०) {
        मिश्र = जोड़ें(मिश्र, []);
        मिश्र = जोड़ें(मिश्र, {"चाबी": क});
        मिश्र = जोड़ें(मिश्र, "पाठ" + क);
        क = क + १;
    }
    क = ०;
    यावत् (क < १५०) {
        सूची ख = मिश्र[क * ३];
        ख = जोड़ें(ख, क + १००);
        क = क + १;
    }
    संग्रह_करो();
    संख्या गलत३ = ०;
    क = ०;
    यावत् (क < १५०) {
        सूची ख = मिश्र[क * ३];
        शब्दकोश घ = मिश्र[क * ३ + १];
        पाठ ट = मिश्र[क * ३ + २];
        यदि (लंबाई(ख) != १ || ख[०] != क + १००) { गलत३ = गलत३ + १; }
        यदि (घ["चाबी"] != क) { गलत३ = गलत३ + १; }
        यदि (ट != "पाठ" + क) { गलत३ = गलत३ + १; }
        क = क + १;
    }
    जाँचो("३ बुने हुए ऑब्जेक्ट", गलत३);

    परत् ०;
}
