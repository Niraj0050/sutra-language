// ६७_list_gc_stress.सूत्र — सूची (stable handle + अलग तत्व-बफर) पर GC का दबाव: बढ़ती/घटती/alias वाली/
// कंटेनरों के भीतर की सूचियाँ बार-बार `संग्रह_करो()` के पार सही रहें (तत्व-बफर का चिह्नन, तत्वों का
// पुनः-चिह्नन, handle का स्थिर रहना)। आउटपुट self-checking है: हर खंड "ठीक" या "गलत=<गिनती>" छापता।
// यह ~४० बार GC चलाता है, इसलिए दो पुराने bugs का रिग्रेशन भी है: (१) `जीसी_सीमा` हर बेकार चक्र पर दुगुनी
// होकर ~३६ चक्रों बाद int६४ overflow करती थी और तब *हर* आवंटन पर GC चलता; (२) तब `पाठ_योग_गतिक` का
// `संख्या_से_पाठ` अस्थायी (runtime फलन में rooted नहीं) `पाठ_जोड़` के आवंटन के बीच sweep हो जाता, परिणाम-
// ब्लॉक उसी मुक्त ब्लॉक पर बैठता और "कुं" + ५ का अंक बिगड़ जाता — "कुं५" की जगह चाबी "कुं" पर सब टकराते।

कार्य जाँचो(पाठ नाम, संख्या गलत) {
    यदि (गलत == ०) {
        लिखतु(नाम + ": ठीक");
    } अन्यथा {
        लिखतु(नाम + ": गलत=" + गलत);
    }
    परत् ०;
}

कार्य मुख्य() {
    // १. जीवित/मृत सूचियाँ: हर चक्र में कई सूचियाँ बनाओ, हर तीसरी रखो, GC चलाओ
    सूची जीवित = [];
    संख्या चक्र = ०;
    यावत् (चक्र < ३०) {
        संख्या ज = ०;
        यावत् (ज < २०) {
            सूची स = [];
            संख्या क = ०;
            यावत् (क < (ज % ७) + १) {
                स = जोड़ें(स, चक्र * १०० + ज * ५ + क);
                क = क + १;
            }
            यदि (ज % ३ == ०) {
                जीवित = जोड़ें(जीवित, स);
            }
            ज = ज + १;
        }
        संग्रह_करो();
        चक्र = चक्र + १;
    }
    संख्या गलत१ = ०;
    संख्या स्थान = ०;
    चक्र = ०;
    यावत् (चक्र < ३०) {
        संख्या ज = ०;
        यावत् (ज < २०) {
            यदि (ज % ३ == ०) {
                सूची स = जीवित[स्थान];
                यदि (लंबाई(स) != (ज % ७) + १) { गलत१ = गलत१ + १; }
                संख्या क = ०;
                यावत् (क < लंबाई(स)) {
                    यदि (स[क] != चक्र * १०० + ज * ५ + क) { गलत१ = गलत१ + १; }
                    क = क + १;
                }
                स्थान = स्थान + १;
            }
            ज = ज + १;
        }
        चक्र = चक्र + १;
    }
    जाँचो("१ जीवित सूचियाँ", गलत१);

    // २. एक सूची बढ़ती रहे (कई growth), साथ में alias, और हर १० जोड़ पर GC
    सूची बढ़ती = [];
    सूची उपनाम = बढ़ती;
    संख्या इ = ०;
    यावत् (इ < २५०) {
        उपनाम = जोड़ें(उपनाम, इ * २);
        यदि (इ % १० == ९) { संग्रह_करो(); }
        इ = इ + १;
    }
    संख्या गलत२ = ०;
    यदि (लंबाई(बढ़ती) != २५०) { गलत२ = गलत२ + १; }
    इ = ०;
    यावत् (इ < २५०) {
        यदि (बढ़ती[इ] != इ * २) { गलत२ = गलत२ + १; }
        इ = इ + १;
    }
    जाँचो("२ बढ़ती + alias", गलत२);

    // ३. घटती सूची: निकालते-निकालते संकुचन (realloc), बीच-बीच में GC
    संख्या गलत३ = ०;
    यावत् (लंबाई(बढ़ती) > ७) {
        उपनाम = निकालें(उपनाम);
        यदि (लंबाई(बढ़ती) % २५ == ०) { संग्रह_करो(); }
    }
    यदि (लंबाई(बढ़ती) != ७) { गलत३ = गलत३ + १; }
    इ = ०;
    यावत् (इ < ७) {
        यदि (बढ़ती[इ] != इ * २) { गलत३ = गलत३ + १; }
        इ = इ + १;
    }
    जाँचो("३ घटती सूची", गलत३);

    // ४. शब्दकोश के भीतर बढ़ती सूचियाँ (कुंजी → सूची), GC के पार
    शब्दकोश भंडार = {};
    संख्या कु = ०;
    यावत् (कु < ८) {
        भंडार["कुं" + कु] = [];
        कु = कु + १;
    }
    संख्या दौर = ०;
    यावत् (दौर < ४०) {
        कु = ०;
        यावत् (कु < ८) {
            सूची भीतर = भंडार["कुं" + कु];
            भीतर = जोड़ें(भीतर, दौर * १० + कु);
            कु = कु + १;
        }
        यदि (दौर % ८ == ७) { संग्रह_करो(); }
        दौर = दौर + १;
    }
    संख्या गलत४ = ०;
    कु = ०;
    यावत् (कु < ८) {
        सूची भीतर = भंडार["कुं" + कु];
        यदि (लंबाई(भीतर) != ४०) { गलत४ = गलत४ + १; }
        दौर = ०;
        यावत् (दौर < ४०) {
            यदि (भीतर[दौर] != दौर * १० + कु) { गलत४ = गलत४ + १; }
            दौर = दौर + १;
        }
        कु = कु + १;
    }
    जाँचो("४ शब्दकोश के भीतर सूचियाँ", गलत४);

    परत् ०;
}
