// भाषा_परीक्षण/गहन_अधिगम_परीक्षण.सूत्र
// ============================================================
// नवम चरण (Phase 9): गैर-पारंपरिक गहन अधिगम एवं पाणिनीय प्रज्ञा
// १. त्रिमूल्य संगणना एवं क्वांटाइजेशन (Ternary {-1, 0, +1} Quantization)
// २. शून्य-गुणा आव्यूह-सदिश संक्रिया (Zero-Mult GEMV)
// ३. त्रिमूल्य सघन स्तर (Ternary Dense Layer Forward Pass)
// ४. पाणिनीय कारक-ज्ञान ग्राफ़ (Semantic Karaka Hypergraph)
// ५. शून्य-भ्रम तार्किक प्रश्नोत्तर (Zero-Hallucination Symbolic Reasoning)
// ६. संरचनात्मक तुल्यता (Structural Graph Isomorphism)
// ७. प्रतीप वाक्य संश्लेषण (Inverse Thought-to-Speech Synthesis)
// ८. कारक सन्निवेश सदिश (Discrete Karaka Feature Embedding)
// ============================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  सूत्र गैर-पारंपरिक गहन अधिगम एवं पाणिनीय प्रज्ञा परीक्षण");
    लिखतु("============================================================\n");

    // ------------------------------------------------------------
    // परीक्षण १: त्रिमूल्य आव्यूह एवं शून्य-गुणा संक्रिया
    // ------------------------------------------------------------
    लिखतु("--- परीक्षण १: त्रिमूल्य आव्यूह एवं शून्य-गुणा संक्रिया ---");
    शब्दकोश त्रि_आव्यूह = त्रिमूल्य_आव्यूह_बनाओ(२, ३, ०);
    // पंक्ति ०: [१, ०, -१]
    त्रिमूल्य_आव्यूह_सेट(त्रि_आव्यूह, ०, ०, १);
    त्रिमूल्य_आव्यूह_सेट(त्रि_आव्यूह, ०, १, ०);
    त्रिमूल्य_आव्यूह_सेट(त्रि_आव्यूह, ०, २, -१);
    // पंक्ति १: [-१, १, १]
    त्रिमूल्य_आव्यूह_सेट(त्रि_आव्यूह, १, ०, -१);
    त्रिमूल्य_आव्यूह_सेट(त्रि_आव्यूह, १, १, १);
    त्रिमूल्य_आव्यूह_सेट(त्रि_आव्यूह, १, २, १);

    शब्दकोश इनपुट = सदिश_से_सूची([२.०, ३.०, ४.०]);
    शब्दकोश आउटपुट = त्रिमूल्य_सदिश_संक्रिया(त्रि_आव्यूह, इनपुट);

    // पंक्ति ०: (१*२.० + ०*३.० + (-१)*४.०) = -२.०
    // पंक्ति १: ((-१)*२.० + १*३.० + १*४.०) = ५.०
    दशमलव आउट_शून्य = आउटपुट["डेटा"][०];
    दशमलव आउट_एक = आउटपुट["डेटा"][१];

    सत्यापित_करो(आउट_शून्य == -२.०, "त्रिमूल्य संक्रिया पंक्ति ० परिणाम (-२.०)");
    सत्यापित_करो(आउट_एक == ५.०, "त्रिमूल्य संक्रिया पंक्ति १ परिणाम (५.०)");

    दशमलव शून्यता = त्रिमूल्य_शून्यता_प्रतिशत(त्रि_आव्यूह);
    // ६ तत्वों में से १ शून्य है -> १/६ * १०० = १६.६६%
    सत्यापित_करो(शून्यता > १५.० && शून्यता < २०.०, "त्रिमूल्य शून्यता गणना");
    लिखतु("  [सफल] त्रिमूल्य शून्य-गुणा आव्यूह संक्रिया एवं शून्यता सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण २: फ्लोट भारों का त्रिमूल्य क्वांटाइजेशन
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण २: फ्लोट भारों का त्रिमूल्य क्वांटाइजेशन ---");
    शब्दकोश फ्लोट_दिशक = दिशक_शून्य([२, २]);
    दिशक_सेट(फ्लोट_दिशक, [०, ०], १.५);
    दिशक_सेट(फ्लोट_दिशक, [०, १], ०.०५);
    दिशक_सेट(फ्लोट_दिशक, [१, ०], -१.२);
    दिशक_सेट(फ्लोट_दिशक, [१, १], ०.०१);

    शब्दकोश क्वांट = त्रिमूल्य_क्वांटाइज(फ्लोट_दिशक);
    संख्या तत्व_०० = त्रिमूल्य_आव्यूह_पाओ(क्वांट, ०, ०);
    संख्या तत्व_०१ = त्रिमूल्य_आव्यूह_पाओ(क्वांट, ०, १);
    संख्या तत्व_१० = त्रिमूल्य_आव्यूह_पाओ(क्वांट, १, ०);
    संख्या तत्व_११ = त्रिमूल्य_आव्यूह_पाओ(क्वांट, १, १);

    सत्यापित_करो(तत्व_०० == १, "उच्च धनात्मक भार +१ में क्वांटाइज");
    सत्यापित_करो(तत्व_०१ == ०, "लघु धनात्मक भार ० में क्वांटाइज");
    सत्यापित_करो(तत्व_१० == -१, "उच्च ऋणात्मक भार -१ में क्वांटाइज");
    सत्यापित_करो(तत्व_११ == ०, "लघु भार ० में क्वांटाइज");
    लिखतु("  [सफल] त्रिमूल्य क्वांटाइजेशन {-१, ०, +१} सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण ३: त्रिमूल्य सघन स्तर (Ternary Dense Layer)
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ३: त्रिमूल्य सघन स्तर अग्रेषण ---");
    शब्दकोश त्रि_स्तर = त्रिमूल्य_सघन_स्तर_बनाओ(४, ३, "रेलू");
    शब्दकोश इनपुट_सदिश = सदिश_से_सूची([१.०, २.०, ३.०, ४.०]);
    शब्दकोश स्तर_आउट = त्रिमूल्य_स्तर_अग्रेषण(त्रि_स्तर, इनपुट_सदिश);

    सत्यापित_करो(स्तर_आउट["आकार"] == ३, "त्रिमूल्य स्तर आउटपुट आयाम (३)");
    // रेलू सक्रियण के कारण सभी आउटपुट >= ० होने चाहिए
    दशमलव मान_० = स्तर_आउट["डेटा"][०];
    दशमलव मान_१ = स्तर_आउट["डेटा"][१];
    दशमलव मान_२ = स्तर_आउट["डेटा"][२];
    सत्यापित_करो(मान_० >= ०.०, "रेलू सक्रियण ० गैर-ऋणात्मक");
    सत्यापित_करो(मान_१ >= ०.०, "रेलू सक्रियण १ गैर-ऋणात्मक");
    सत्यापित_करो(मान_२ >= ०.०, "रेलू सक्रियण २ गैर-ऋणात्मक");
    लिखतु("  [सफल] त्रिमूल्य सघन स्तर अग्रेषण १००% सफल।");

    // ------------------------------------------------------------
    // परीक्षण ४: पाणिनीय कारक-ज्ञान ग्राफ़ निर्माण
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ४: पाणिनीय कारक-ज्ञान ग्राफ़ निर्माण ---");
    पाठ वाक्य = "पुस्तकेन रामः विद्यालये ज्ञानम् अर्जयति";
    शब्दकोश ग्राफ़ = पाणिनीय_वाक्य_ग्राफ़(वाक्य);

    सत्यापित_करो(ग्राफ़["क्रिया"] == "अर्जयति", "ग्राफ़ क्रिया पहचान (अर्जयति)");
    सत्यापित_करो(ग्राफ़["कर्ता"] == "रामः", "ग्राफ़ कर्ता पहचान (रामः)");
    सत्यापित_करो(ग्राफ़["कर्म"] == "ज्ञानम्", "ग्राफ़ कर्म पहचान (ज्ञानम्)");
    सत्यापित_करो(ग्राफ़["करण"] == "पुस्तकेन", "ग्राफ़ करण पहचान (पुस्तकेन)");
    सत्यापित_करो(ग्राफ़["अधिकरण"] == "विद्यालये", "ग्राफ़ अधिकरण पहचान (विद्यालये)");
    लिखतु("  [सफल] पाणिनीय कारक-ज्ञान ग्राफ़ रचना सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण ५: शून्य-भ्रम तार्किक प्रश्नोत्तर (Symbolic Reasoning)
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ५: शून्य-भ्रम तार्किक प्रश्नोत्तर ---");
    पाठ उत्तर_कः = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "कः");
    पाठ उत्तर_किम् = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "किम्");
    पाठ उत्तर_केन = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "केन");
    पाठ उत्तर_कुत्र = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "कुत्र");

    सत्यापित_करो(उत्तर_कः == "रामः", "संस्कृत प्रश्न 'कः' -> 'रामः'");
    सत्यापित_करो(उत्तर_किम् == "ज्ञानम्", "संस्कृत प्रश्न 'किम्' -> 'ज्ञानम्'");
    सत्यापित_करो(उत्तर_केन == "पुस्तकेन", "संस्कृत प्रश्न 'केन' -> 'पुस्तकेन'");
    सत्यापित_करो(उत्तर_कुत्र == "विद्यालये", "संस्कृत प्रश्न 'कुत्र' -> 'विद्यालये'");

    पाठ उत्तर_कौन = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "कौन");
    पाठ उत्तर_क्या = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "क्या");
    पाठ उत्तर_किससे = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "किससे");
    पाठ उत्तर_कहाँ = पाणिनीय_तर्क_प्रश्न(ग्राफ़, "कहाँ");

    सत्यापित_करो(उत्तर_कौन == "रामः", "तर्क प्रश्न 'कौन' -> 'रामः'");
    सत्यापित_करो(उत्तर_क्या == "ज्ञानम्", "तर्क प्रश्न 'क्या' -> 'ज्ञानम्'");
    सत्यापित_करो(उत्तर_किससे == "पुस्तकेन", "तर्क प्रश्न 'किससे' -> 'पुस्तकेन'");
    सत्यापित_करो(उत्तर_कहाँ == "विद्यालये", "तर्क प्रश्न 'कहाँ' -> 'विद्यालये'");
    लिखतु("  [सफल] शून्य-भ्रम तार्किक प्रश्नोत्तर पूर्णतः सटीक।");

    // ------------------------------------------------------------
    // परीक्षण ६: संरचनात्मक तुल्यता (Structural Isomorphism)
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ६: संरचनात्मक तुल्यता परीक्षण ---");
    पाठ वाक्य२ = "दण्डेन छात्रः गृहे पुस्तकम् पठति";
    शब्दकोश ग्राफ़२ = पाणिनीय_वाक्य_ग्राफ़(वाक्य२);

    मान तुल्य = पाणिनीय_संरचना_तुल्यता(ग्राफ़, ग्राफ़२);
    सत्यापित_करो(तुल्य == सत्य, "समान कारक-संरचना वाले दो वाक्यों में तुल्यता");

    पाठ वाक्य३ = "बालकः पठति";
    शब्दकोश ग्राफ़३ = पाणिनीय_वाक्य_ग्राफ़(वाक्य३);
    मान तुल्य_असम = पाणिनीय_संरचना_तुल्यता(ग्राफ़, ग्राफ़३);
    सत्यापित_करो(तुल्य_असम == असत्य, "असमान कारक-संरचना वाले वाक्यों में अतुल्यता");
    लिखतु("  [सफल] कारक-संरचनात्मक तुल्यता एवं सादृश्य सम्यक्।");

    // ------------------------------------------------------------
    // परीक्षण ७: प्रतीप वाक्य संश्लेषण (Inverse Synthesis)
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ७: प्रतीप वाक्य संश्लेषण ---");
    पाठ संश्लेषित = पाणिनीय_वाक्य_संश्लेषण(ग्राफ़);
    // पाणिनीय क्रम: कर्ता (रामः) + अधिकरण (विद्यालये) + करण (पुस्तकेन) + कर्म (ज्ञानम्) + क्रिया (अर्जयति)
    पाठ अपेक्षित = "रामः विद्यालये पुस्तकेन ज्ञानम् अर्जयति";
    सत्यापित_करो(संश्लेषित == अपेक्षित, "विचार/ग्राफ़ से पाणिनीय क्रम में वाक्य संश्लेषण");
    लिखतु("  [सफल] प्रतीप वाक्य संश्लेषण: " + संश्लेषित);

    // ------------------------------------------------------------
    // परीक्षण ८: कारक-सन्निवेश सदिश (Discrete Karaka Feature Embedding)
    // ------------------------------------------------------------
    लिखतु("\n--- परीक्षण ८: कारक-सन्निवेश सदिश ---");
    शब्दकोश सन्निवेश = पाणिनीय_कारक_सन्निवेश(ग्राफ़);
    // [कर्ता=१, कर्म=१, करण=१, सम्प्रदान=०, अपादान=०, अधिकरण=१, क्रिया=१]
    सत्यापित_करो(सन्निवेश["आकार"] == ७, "कारक सन्निवेश ७-आयामी सदिश");
    दशमलव सदिश_कर्ता = सन्निवेश["डेटा"][०];
    दशमलव सदिश_कर्म = सन्निवेश["डेटा"][१];
    दशमलव सदिश_करण = सन्निवेश["डेटा"][२];
    दशमलव सदिश_सम्प्रदान = सन्निवेश["डेटा"][३];
    दशमलव सदिश_अपादान = सन्निवेश["डेटा"][४];
    दशमलव सदिश_अधिकरण = सन्निवेश["डेटा"][५];
    दशमलव सदिश_क्रिया = सन्निवेश["डेटा"][६];

    सत्यापित_करो(सदिश_कर्ता == १.०, "सन्निवेश कर्ता बिट १.०");
    सत्यापित_करो(सदिश_कर्म == १.०, "सन्निवेश कर्म बिट १.०");
    सत्यापित_करो(सदिश_करण == १.०, "सन्निवेश करण बिट १.०");
    सत्यापित_करो(सदिश_सम्प्रदान == ०.०, "सन्निवेश सम्प्रदान बिट ०.०");
    सत्यापित_करो(सदिश_अपादान == ०.०, "सन्निवेश अपादान बिट ०.०");
    सत्यापित_करो(सदिश_अधिकरण == १.०, "सन्निवेश अधिकरण बिट १.०");
    सत्यापित_करो(सदिश_क्रिया == १.०, "सन्निवेश क्रिया बिट १.०");
    लिखतु("  [सफल] कारक-सन्निवेश सदिश गणना सम्यक्।");

    लिखतु("\n============================================================");
    लिखतु("  [सर्वं सम्यक्] गैर-पारंपरिक गहन अधिगम एवं पाणिनीय प्रज्ञा १००% सत्यापितम्!");
    लिखतु("============================================================");
}

मुख्य();
