// भाषा_परीक्षण/पाणिनीय_संपीडन_परीक्षण.सूत्र — पाणिनीय प्रत्याहार संपीड़न एवं विसंपीड़न परीक्षण
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला
//
// महर्षि पाणिनि के माहेश्वर सूत्र एवं प्रत्याहार सिद्धांतों पर आधारित संपीड़न इंजन का
// शत-प्रतिशत दोषरहित (100% Lossless) एवं बैंडविड्थ दक्षता सत्यापन सूट:
//   १. लघु पूर्णांक एवं शून्य-दौड़ प्रत्याहार राउंडट्रिप
//   २. देवनागरी यूनीकोड एवं स्थिर-संरचना (रंग, मॉडल, शीर्षलेख) प्रत्याहार
//   ३. स्थानिक ३डी+२डी द्विआधारी दृश्य चौखटा पेलोड संपीड़न (>३५% बचत)
//   ४. सूत्र अष्टक-संकेत (.सूत्रक) बाइटकोड कंटेनर संपीड़न एवं निष्पादन
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/दृश्यक_द्विआधारी.सूत्र";
आयात "पुस्तकालय/स्थानिक_संजाल_धारा.सूत्र";
आयात "पुस्तकालय/पाणिनीय_संपीडन.सूत्र";
आयात "स्वसंकलक/अष्टक_संकेत.सूत्र";
आयात "स्वसंकलक/आभासी_यंत्र.सूत्र";

कार्य सत्यापित_करो(मान शर्त, पाठ संदेश) {
    यदि (न शर्त) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  🕉️ सूत्र पाणिनीय प्रत्याहार द्विआधारी संपीड़न सत्यापन");
    लिखतु("  शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला");
    लिखतु("============================================================\n");

    संख्या कुल_सफल = ०;

    // --- परीक्षण १: लघु पूर्णांक एवं शून्य-दौड़ प्रत्याहार राउंडट्रिप ---
    लिखतु("--- परीक्षण १: लघु पूर्णांक एवं शून्य-दौड़ प्रत्याहार राउंडट्रिप ---");
    सूची नमूना_बाइट्स = [
        ०, १०,
        ०, २५,
        ०, ६४,
        ०, १२७,
        ०, ०, ०, ०, ०, // ५ शून्य
        ०, ०, ०, ०, ०, ०, ०, ०, // ८ शून्य
        २५४, १८,
        २५४, ९९
    ];

    सूची संपीड़ित_१ = पाणिनीय_संपीड़न_बाइट्स(नमूना_बाइट्स);
    सूची विसंपीड़ित_१ = पाणिनीय_विसंपीड़न_बाइट्स(संपीड़ित_१);

    सत्यापित_करो(लंबाई(विसंपीड़ित_१) == लंबाई(नमूना_बाइट्स), "विसंपीड़ित लंबाई मूल के समान (" + देवनागरी_अंकों_में("" + लंबाई(नमूना_बाइट्स)) + " बाइट्स)");
    
    मान मिलान_१ = सत्य;
    संख्या इ१ = ०;
    यावत् (इ१ < लंबाई(नमूना_बाइट्स)) {
        यदि (विसंपीड़ित_१[इ१] != नमूना_बाइट्स[इ१]) {
            मिलान_१ = असत्य;
        }
        इ१ = इ१ + १;
    }
    सत्यापित_करो(मिलान_१ == सत्य, "१००% दोषरहित राउंडट्रिप (बाइट-दर-बाइट अचूक)");
    सत्यापित_करो(लंबाई(संपीड़ित_१) < लंबाई(नमूना_बाइट्स), "संपीड़ित आकार लघु (" + देवनागरी_अंकों_में("" + लंबाई(संपीड़ित_१)) + " < " + देवनागरी_अंकों_में("" + लंबाई(नमूना_बाइट्स)) + ")");
    लिखतु("  [सफल] परीक्षण १ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण २: स्थिर संरचना एवं देवनागरी प्रत्याहार ---
    लिखतु("--- परीक्षण २: स्थिर संरचना (रंग, मॉडल, 'SUTR') प्रत्याहार ---");
    सूची पाठ_नमूना = [];
    // 'SUTR'
    पाठ_नमूना = जोड़ें(पाठ_नमूना, ८३);
    पाठ_नमूना = जोड़ें(पाठ_नमूना, ८५);
    पाठ_नमूना = जोड़ें(पाठ_नमूना, ८४);
    पाठ_नमूना = जोड़ें(पाठ_नमूना, ८२);

    // "#38bdf8"
    सूची रंग_आसमानी_ब = प्रत्याहार_पाठ_बाइट्स("#38bdf8");
    पाठ_नमूना = प्रत्याहार_सूची_विस्तार(पाठ_नमूना, रंग_आसमानी_ब);

    // "#10b981"
    सूची रंग_पन्ना_ब = प्रत्याहार_पाठ_बाइट्स("#10b981");
    पाठ_नमूना = प्रत्याहार_सूची_विस्तार(पाठ_नमूना, रंग_पन्ना_ब);

    // "स्थानिक_चश्मा_अष्टफलक"
    सूची मॉडल_अष्ट_ब = प्रत्याहार_पाठ_बाइट्स("स्थानिक_चश्मा_अष्टफलक");
    पाठ_नमूना = प्रत्याहार_सूची_विस्तार(पाठ_नमूना, मॉडल_अष्ट_ब);

    सूची संपीड़ित_२ = पाणिनीय_संपीड़न_बाइट्स(पाठ_नमूना);
    सूची विसंपीड़ित_२ = पाणिनीय_विसंपीड़न_बाइट्स(संपीड़ित_२);

    सत्यापित_करो(लंबाई(विसंपीड़ित_२) == लंबाई(पाठ_नमूना), "स्थिर संरचना विसंपीड़ित आकार शुद्ध (" + देवनागरी_अंकों_में("" + लंबाई(पाठ_नमूना)) + " बाइट्स)");
    
    मान मिलान_२ = सत्य;
    संख्या इ२ = ०;
    यावत् (इ२ < लंबाई(पाठ_नमूना)) {
        यदि (विसंपीड़ित_२[इ२] != पाठ_नमूना[इ२]) {
            मिलान_२ = असत्य;
        }
        इ२ = इ२ + १;
    }
    सत्यापित_करो(मिलान_२ == सत्य, "स्थिर संरचना शत-प्रतिशत दोषरहित राउंडट्रिप");
    
    शब्दकोश तुलना_२ = पाणिनीय_संपीड़न_तुलना(पाठ_नमूना, संपीड़ित_२);
    लिखतु("  मूल आकार:       " + देवनागरी_अंकों_में("" + तुलना_२["मूल_आकार"]) + " बाइट्स");
    लिखतु("  प्रत्याहार आकार: " + देवनागरी_अंकों_में("" + तुलना_२["संपीड़ित_आकार"]) + " बाइट्स");
    लिखतु("  बैंडविड्थ बचत:   " + देवनागरी_अंकों_में("" + गोल(तुलना_२["बचत_प्रतिशत"])) + " %");
    सत्यापित_करो(तुलना_२["बचत_प्रतिशत"] >= ७०.०, "स्थिर संरचना प्रत्याहार बचत >= ७०%");
    लिखतु("  [सफल] परीक्षण २ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ३: स्थानिक ३डी+२डी द्विआधारी दृश्य चौखटा पेलोड संपीड़न ---
    लिखतु("--- परीक्षण ३: स्थानिक ३डी+२डी दृश्य चौखटा पेलोड संपीड़न ---");
    शब्दकोश दर्शक = स्थानिक_दर्शक_रचना("सूत्र://हाट", १०००.०, ८००.०);
    शब्दकोश चौखटा_फल = स्थानिक_चौखटा_संश्लेषण(दर्शक);
    सूची आदेश_सूची = दृश्यक_चौखटा_आदेश(चौखटा_फल["दृश्य"], १०००.०, ८००.०);
    सूची कच्चा_द्विआधारी = दृश्यक_द्विआधारी_एन्कोड(आदेश_सूची);

    सूची संपीड़ित_दृश्य = पाणिनीय_संपीड़न_बाइट्स(कच्चा_द्विआधारी);
    सूची विसंपीड़ित_दृश्य = पाणिनीय_विसंपीड़न_बाइट्स(संपीड़ित_दृश्य);

    सत्यापित_करो(लंबाई(विसंपीड़ित_दृश्य) == लंबाई(कच्चा_द्विआधारी), "चौखटा विसंपीड़ित बाइट संख्या शुद्ध (" + देवनागरी_अंकों_में("" + लंबाई(कच्चा_द्विआधारी)) + ")");
    
    मान मिलान_३ = सत्य;
    संख्या इ३ = ०;
    यावत् (इ३ < लंबाई(कच्चा_द्विआधारी)) {
        यदि (विसंपीड़ित_दृश्य[इ३] != कच्चा_द्विआधारी[इ३]) {
            मिलान_३ = असत्य;
        }
        इ३ = इ३ + १;
    }
    सत्यापित_करो(मिलान_३ == सत्य, "दृश्य द्विआधारी पेलोड शत-प्रतिशत दोषरहित राउंडट्रिप");

    // डीकोडेड आदेशों की समानता जाँच
    सूची पुनः_डीकोड_आदेश = दृश्यक_द्विआधारी_डीकोड(विसंपीड़ित_दृश्य);
    सत्यापित_करो(लंबाई(पुनः_डीकोड_आदेश) == लंबाई(आदेश_सूची), "डीकोड किए गए आदेशों की संख्या समान (" + देवनागरी_अंकों_में("" + लंबाई(आदेश_सूची)) + ")");

    शब्दकोश तुलना_३ = पाणिनीय_संपीड़न_तुलना(कच्चा_द्विआधारी, संपीड़ित_दृश्य);
    लिखतु("  कच्चा दृश्य पेलोड: " + देवनागरी_अंकों_में("" + तुलना_३["मूल_आकार"]) + " बाइट्स");
    लिखतु("  संपीड़ित पेलोड:    " + देवनागरी_अंकों_में("" + तुलना_३["संपीड़ित_आकार"]) + " बाइट्स");
    लिखतु("  संजाल तार बचत:     " + देवनागरी_अंकों_में("" + गोल(तुलना_३["बचत_प्रतिशत"])) + " %");
    सत्यापित_करो(तुलना_३["बचत_प्रतिशत"] >= ३५.०, "दृश्य पेलोड संपीड़न बचत >= ३५%");
    लिखतु("  [सफल] परीक्षण ३ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ४: सूत्र अष्टक-संकेत (.सूत्रक) बाइटकोड कंटेनर संपीड़न ---
    लिखतु("--- परीक्षण ४: सूत्र अष्टक-संकेत (.सूत्रक) कंटेनर संपीड़न ---");
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["जादुई_संकेत"] = "सूत्र";
    प्रोग्राम["संस्करण"] = "१.०";
    प्रोग्राम["लक्ष्य_यंत्र"] = "सार्वत्रिक";
    प्रोग्राम["प्रारंभ_फलन"] = "मुख्य";

    सूची आज्ञाएं = [];
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, १, -१, -१, ५००));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, २, -१, -१, २५०));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_योग, ३, १, २, शून्यम्));
    आज्ञाएं = जोड़ें(आज्ञाएं, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, ३, -१, शून्यम्));

    शब्दकोश फलन_मानचित्र = {};
    शब्दकोश मुख्य_फलन = {};
    मुख्य_फलन["नाम"] = "मुख्य";
    मुख्य_फलन["पैरामीटर_गणना"] = ०;
    मुख्य_फलन["आज्ञा_सूची"] = आज्ञाएं;
    फलन_मानचित्र["मुख्य"] = मुख्य_फलन;
    प्रोग्राम["फलन_मानचित्र"] = फलन_मानचित्र;

    पाठ पात्र_पाठ = अष्टक_कंटेनर_संश्लेषण(प्रोग्राम);
    सूची संपीड़ित_पात्र = पाणिनीय_संपीड़न_पाठ(पात्र_पाठ);
    पाठ विसंपीड़ित_पात्र = पाणिनीय_विसंपीड़न_पाठ(संपीड़ित_पात्र);

    सत्यापित_करो(विसंपीड़ित_पात्र == पात्र_पाठ, "बाइटकोड कंटेनर पाठ दोषरहित प्रत्यावर्तन");

    शब्दकोश लोड_प्रोग्राम = अष्टक_कंटेनर_पार्स(विसंपीड़ित_पात्र);
    शब्दकोश यंत्र = आभासी_यंत्र_नव(लोड_प्रोग्राम);
    मान निष्पादन_फल = आभासी_यंत्र_चलाओ(यंत्र);
    सत्यापित_करो(निष्पादन_फल == ७५०, "संपीड़न चक्र के उपरांत SVM अंकगणित निष्पादन फल (५०० + २५० = ७५०)");

    शब्दकोश तुलना_४ = पाणिनीय_संपीड़न_तुलना(सं_यूटीएफ8_एन्कोड(पात्र_पाठ), संपीड़ित_पात्र);
    लिखतु("  मूल बाइटकोड आकार:     " + देवनागरी_अंकों_में("" + तुलना_४["मूल_आकार"]) + " बाइट्स");
    लिखतु("  संपीड़ित बाइटकोड आकार: " + देवनागरी_अंकों_में("" + तुलना_४["संपीड़ित_आकार"]) + " बाइट्स");
    लिखतु("  कंटेनर संपीड़न बचत:    " + देवनागरी_अंकों_में("" + गोल(तुलना_४["बचत_प्रतिशत"])) + " %");
    सत्यापित_करो(तुलना_४["बचत_प्रतिशत"] >= ३५.०, "बाइटकोड कंटेनर संपीड़न बचत >= ३५%");
    लिखतु("  [सफल] परीक्षण ४ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    लिखतु("============================================================");
    लिखतु("  सकल परीक्षण: " + देवनागरी_अंकों_में("" + कुल_सफल) + "  |  सफल: " + देवनागरी_अंकों_में("" + कुल_सफल) + "  |  विफल: ०");
    लिखतु("  [सर्व-सफल] सूत्र पाणिनीय प्रत्याहार संपीड़न १००% प्रमाणित!");
    लिखतु("============================================================");
    परत् ०;
}
