/* Dictionary built-ins: keys, has_key, remove, length */

कार्य मुख्य() {
    मान शब्द = {"अ": 1, "ब": 2};
    
    लिखतु(लंबाई(शब्द)); /* 2 */
    लिखतु(कुंजी_है(शब्द, "अ")); /* 1 or true */
    लिखतु(कुंजी_है(शब्द, "स")); /* 0 or false */
    
    लिखतु(शब्द["ब"]);
    हटाएं(शब्द, "ब");
    लिखतु(लंबाई(शब्द)); /* 1 */
    लिखतु(कुंजी_है(शब्द, "ब")); /* 0 */
}

मुख्य();
