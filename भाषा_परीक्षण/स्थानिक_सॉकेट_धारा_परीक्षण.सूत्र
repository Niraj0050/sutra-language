आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/दृश्यक_द्विआधारी.सूत्र";
आयात "पुस्तकालय/जाल_घटक.सूत्र";
आयात "पुस्तकालय/स्थानिक_कंसोल.सूत्र";
आयात "पुस्तकालय/स्थानिक_संजाल_धारा.सूत्र";
आयात "पुस्तकालय/पाणिनीय_संपीडन.सूत्र";
आयात "पुस्तकालय/स्थानिक_संजाल_सॉकेट.सूत्र";

कार्य सत्यापित_करो(मान शर्त, पाठ संदेश) {
    यदि (न शर्त) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("============================================================");
    लिखतु("  🕉️ सूत्र संप्रभु स्थानिक टीसीपी सॉकेट संजाल धारा सत्यापन");
    लिखतु("  शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला");
    लिखतु("  वास्तविक विंसॉक२ (Winsock2 Live TCP Sockets: 127.0.0.1:८०९५)");
    लिखतु("============================================================\n");

    संख्या कुल_सफल = ०;

    // --- परीक्षण १: विंसॉक२ आरंभ एवं सर्वर सॉकेट श्रवण ---
    लिखतु("--- परीक्षण १: विंसॉक२ आरंभ एवं सर्वर सॉकेट श्रवण (पोर्ट ८०९५) ---");
    मान आरंभ_फल = स्थानिक_सॉकेट_आरंभ();
    सत्यापित_करो(आरंभ_फल == सत्य, "विंसॉक२ परिवेश सफलतापूर्वक प्रारंभ");

    शब्दकोश सर्वर_सॉ = स्थानिक_सॉकेट_सर्वर_शुरू(८०९५, ५);
    सत्यापित_करो(सर्वर_सॉ["सफल"] == सत्य, "सर्वर सॉकेट पोर्ट ८०९५ पर श्रवण सक्रिय");
    लिखतु("  [सफल] परीक्षण १ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण २: क्लाइंट टीसीपी जुड़ाव एवं सर्वर स्वीकृति ---
    लिखतु("--- परीक्षण २: क्लाइंट टीसीपी जुड़ाव एवं सर्वर स्वीकृति ---");
    शब्दकोश क्लाइंट_सॉ = स्थानिक_सॉकेट_क्लाइंट_जोड़ो("127.0.0.1", ८०९५);
    सत्यापित_करो(क्लाइंट_सॉ["सफल"] == सत्य, "क्लाइंट टीसीपी जुड़ाव स्थापित (127.0.0.1:८०९५)");

    शब्दकोश ग्राहक_स्वीकार = स्थानिक_सॉकेट_सर्वर_स्वीकार(सर्वर_सॉ["सॉकेट"]);
    सत्यापित_करो(ग्राहक_स्वीकार["सफल"] == सत्य, "सर्वर ने टीसीपी क्लाइंट को सफलतापूर्वक स्वीकार किया");
    लिखतु("  [सफल] परीक्षण २ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // संप्रभु सर्वर इंजन एवं क्लाइंट दर्शक डेटा मॉडल रचना
    शब्दकोश सर्वर = स्थानिक_संजाल_सर्वर_रचना("संप्रभु_टीसीपी_स्थानिक_सर्वर");
    शब्दकोश दर्शक = स्थानिक_दर्शक_रचना("सूत्र://हाट", १०००.०, ८००.०);

    // --- परीक्षण ३: लाइव टीसीपी संप्रभु अभिगमन हैंडशेक एवं चौखटा १ धारा ---
    लिखतु("--- परीक्षण ३: लाइव टीसीपी अभिगमन हैंडशेक एवं चौखटा १ धारा ---");
    सूची हैंडशेक_पैकेट = स्थानिक_पैकेट_संश्लेषण(
        पैकेट_प्रकार_अभिगमन,
        १,
        स्थानिक_अभिगमन_पेलोड_पैक("सूत्र://हाट", १०००, ८००)
    );
    संख्या भेजा_१ = स्थानिक_सॉकेट_पैकेट_भेजो(क्लाइंट_सॉ["सॉकेट"], हैंडशेक_पैकेट);
    सत्यापित_करो(भेजा_१ == लंबाई(हैंडशेक_पैकेट), "क्लाइंट -> सर्वर: अभिगमन पैकेट प्रेषित (" + देवनागरी_अंकों_में("" + भेजा_१) + " बाइट्स)");

    शब्दकोश सर्वर_आवक_१ = स्थानिक_सॉकेट_पैकेट_पाओ(ग्राहक_स्वीकार["सॉकेट"]);
    सत्यापित_करो(सर्वर_आवक_१["सफल"] == सत्य, "सर्वर पर अभिगमन पैकेट टीसीपी द्वारा प्राप्त");
    सत्यापित_करो(सर्वर_आवक_१["प्रकार"] == पैकेट_प्रकार_अभिगमन, "पैकेट प्रकार अभिगमन");
    सत्यापित_करो(सर्वर_आवक_१["संप्रभु_पता"] == "सूत्र://हाट", "संप्रभु पता 'सूत्र://हाट'");

    // सर्वर प्रतिक्रिया उत्पादन
    सूची सर्वर_उत्तर_१ = स्थानिक_सर्वर_पैकेट_संभालो(सर्वर, दर्शक, सर्वर_आवक_१["कच्चा_पैकेट"]);
    संख्या प्रेषित_चौ_१ = स्थानिक_सॉकेट_पैकेट_भेजो(ग्राहक_स्वीकार["सॉकेट"], सर्वर_उत्तर_१);
    सत्यापित_करो(प्रेषित_चौ_१ == लंबाई(सर्वर_उत्तर_१), "सर्वर -> क्लाइंट: चौखटा १ टीसीपी द्वारा प्रवाहित (" + देवनागरी_अंकों_में("" + प्रेषित_चौ_१) + " बाइट्स)");

    शब्दकोश क्लाइंट_प्राप्त_१ = स्थानिक_सॉकेट_पैकेट_पाओ(क्लाइंट_सॉ["सॉकेट"]);
    सत्यापित_करो(क्लाइंट_प्राप्त_१["सफल"] == सत्य, "क्लाइंट पर चौखटा १ सफलतापूर्वक प्राप्त");
    सत्यापित_करो(क्लाइंट_प्राप्त_१["सक्रिय_अनुभाग"] == ०, "सक्रिय अनुभाग ० (स्थानिक विज़न)");
    सत्यापित_करो(क्लाइंट_प्राप्त_१["संपीड़ित_है"] == सत्य, "चौखटा १ पाणिनीय संपीड़ित");
    लिखतु("  ✓ चौखटा १ संपीड़ित आकार: " + देवनागरी_अंकों_में("" + क्लाइंट_प्राप्त_१["दृश्य_संपीड़ित_आकार"]) + " / मूल: " + देवनागरी_अंकों_में("" + क्लाइंट_प्राप्त_१["दृश्य_मूल_आकार"]) + " बाइट्स");
    लिखतु("  ✓ सक्रिय ३डी मॉडल: " + दर्शक["मॉडल_सूची"][०]["नाम"] + " (अष्टफलक)");

    शब्दकोश पटल_० = कंसोल_पटल_रचना(३६, १०);
    कंसोल_३डी_जाल_रेंडर(पटल_०, दर्शक["मॉडल_सूची"][०]["जाल"], ०.५, ०.३, ३.२, १५.०, "◆");
    कंसोल_पटल_मुद्रण(पटल_०, "टीसीपी सॉकेट धारा: अष्टफलक (अनुभाग ०)");
    लिखतु("  [सफल] परीक्षण ३ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ४: लाइव टीसीपी स्क्रॉल क्रिया एवं चौखटा २ धारा ---
    लिखतु("--- परीक्षण ४: लाइव टीसीपी स्क्रॉल क्रिया (+८०० पिक्सल) एवं चौखटा २ धारा ---");
    सूची स्क्रॉल_पैकेट = स्थानिक_पैकेट_संश्लेषण(
        पैकेट_प्रकार_क्रिया,
        २,
        स्थानिक_क्रिया_पेलोड_पैक(क्रिया_स्क्रॉल, ८००, ०, "")
    );
    स्थानिक_सॉकेट_पैकेट_भेजो(क्लाइंट_सॉ["सॉकेट"], स्क्रॉल_पैकेट);

    शब्दकोश सर्वर_आवक_२ = स्थानिक_सॉकेट_पैकेट_पाओ(ग्राहक_स्वीकार["सॉकेट"]);
    सत्यापित_करो(सर्वर_आवक_२["क्रिया_प्रकार"] == क्रिया_स्क्रॉल, "सर्वर पर स्क्रॉल क्रिया प्राप्त");
    सत्यापित_करो(सर्वर_आवक_२["मान१"] == ८००, "स्क्रॉल डेल्टा +८०० पिक्सल");

    सूची सर्वर_उत्तर_२ = स्थानिक_सर्वर_पैकेट_संभालो(सर्वर, दर्शक, सर्वर_आवक_२["कच्चा_पैकेट"]);
    स्थानिक_सॉकेट_पैकेट_भेजो(ग्राहक_स्वीकार["सॉकेट"], सर्वर_उत्तर_२);

    शब्दकोश क्लाइंट_प्राप्त_२ = स्थानिक_सॉकेट_पैकेट_पाओ(क्लाइंट_सॉ["सॉकेट"]);
    सत्यापित_करो(क्लाइंट_प्राप्त_२["सक्रिय_अनुभाग"] == १, "सक्रिय अनुभाग १ (त्रिमूल्य न्यूरल कोर)");
    सत्यापित_करो(क्लाइंट_प्राप्त_२["स्क्रॉल_य"] == ८००, "स्क्रॉल_य ८०० पिक्सल सिंक");
    लिखतु("  ✓ चौखटा २ संपीड़ित आकार: " + देवनागरी_अंकों_में("" + क्लाइंट_प्राप्त_२["दृश्य_संपीड़ित_आकार"]) + " / मूल: " + देवनागरी_अंकों_में("" + क्लाइंट_प्राप्त_२["दृश्य_मूल_आकार"]) + " बाइट्स");
    लिखतु("  ✓ सक्रिय ३डी मॉडल: " + दर्शक["मॉडल_सूची"][१]["नाम"] + " (घन चिप)");

    शब्दकोश पटल_१ = कंसोल_पटल_रचना(३६, १०);
    कंसोल_३डी_जाल_रेंडर(पटल_१, दर्शक["मॉडल_सूची"][१]["जाल"], ०.६, ०.४, ३.२, १५.०, "✦");
    कंसोल_पटल_मुद्रण(पटल_१, "टीसीपी सॉकेट धारा: घन चिप (अनुभाग १)");
    लिखतु("  [सफल] परीक्षण ४ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // --- परीक्षण ५: लाइव टीसीपी क्लिक क्रिया एवं अवस्था पुष्टि ---
    लिखतु("--- परीक्षण ५: लाइव टीसीपी क्लिक क्रिया एवं संप्रभु अवस्था पुष्टि ---");
    सूची क्लिक_पैकेट = स्थानिक_पैकेट_संश्लेषण(
        पैकेट_प्रकार_क्रिया,
        ३,
        स्थानिक_क्रिया_पेलोड_पैक(क्रिया_क्लिक, ३५०, २००, "अन्वेषण_क्लिक")
    );
    स्थानिक_सॉकेट_पैकेट_भेजो(क्लाइंट_सॉ["सॉकेट"], क्लिक_पैकेट);

    शब्दकोश सर्वर_आवक_३ = स्थानिक_सॉकेट_पैकेट_पाओ(ग्राहक_स्वीकार["सॉकेट"]);
    सत्यापित_करो(सर्वर_आवक_३["क्रिया_प्रकार"] == क्रिया_क्लिक, "सर्वर पर क्लिक क्रिया प्राप्त");
    सत्यापित_करो(सर्वर_आवक_३["क्रिया_आईडी"] == "अन्वेषण_क्लिक", "क्रिया आईडी 'अन्वेषण_क्लिक'");

    सूची सर्वर_उत्तर_३ = स्थानिक_सर्वर_पैकेट_संभालो(सर्वर, दर्शक, सर्वर_आवक_३["कच्चा_पैकेट"]);
    स्थानिक_सॉकेट_पैकेट_भेजो(ग्राहक_स्वीकार["सॉकेट"], सर्वर_उत्तर_३);

    शब्दकोश क्लाइंट_प्राप्त_३ = स्थानिक_सॉकेट_पैकेट_पाओ(क्लाइंट_सॉ["सॉकेट"]);
    सत्यापित_करो(क्लाइंट_प्राप्त_३["प्रकार"] == पैकेट_प्रकार_अवस्था, "सर्वर द्वारा संप्रभु अवस्था पैकेट प्रेषित");
    सत्यापित_करो(क्लाइंट_प्राप्त_३["स्थिति_कोड"] == २००, "स्थिति कोड २०० सम्यक्");
    सत्यापित_करो(क्लाइंट_प्राप्त_३["कार्ट_संख्या"] == १, "अद्यतन कार्ट संख्या १");
    सत्यापित_करो(क्लाइंट_प्राप्त_३["सुरक्षा_मुद्रा"] == "हस्ताक्षर_सूत्र_अष्टक_१", "क्रिप्टो मुद्रा सत्यापित");
    लिखतु("  ✓ संदेश: " + क्लाइंट_प्राप्त_३["संदेश"]);
    लिखतु("  [सफल] परीक्षण ५ उत्तीर्णम्!\n");
    कुल_सफल = कुल_सफल + १;

    // सॉकेट सफाई
