// भाषा_परीक्षण/सूत्र_सञ्चिका_प्रणाली_परीक्षण.सूत्र
// ==============================================================================
// सूत्र स्वायत्त सञ्चिका-प्रणाली (SutraFS) परीक्षण सूट
//
// परीक्षण अनुक्रम:
//   १. सञ्चिका-प्रणाली आरंभीकरण: परमखंड जादुई संख्या ('SFS1') एवं आरोहण
//   २. सञ्चिका सृजन एवं सेक्टर आवंटन: एकल एवं बहु-सेक्टर सञ्चिकाएं
//   ३. सञ्चिका पठन एवं अखंडता: बाइट-दर-बाइट मिलान एवं अप्राप्त सञ्चिका सुरक्षा
//   ४. सञ्चिका सूची: निर्देशिका अवलोकन एवं मेटाडेटा सांख्यिकी
//   ५. सञ्चिका विलोपन एवं सेक्टर विमुक्ति: डिस्क सेक्टरों का सुरक्षित पुनर्चक्रण
//   ६. समग्र सञ्चिका-तंत्र अखंडता एवं शून्य-रिसाव सत्यापन: प्रयुक्त + मुक्त == कुल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य सत्यापित_करो(मान स्थिति, पाठ संदेश) {
    यदि (न स्थिति) {
        फेको "त्रुटिः " + संदेश;
    }
    लिखतु("  ✓ " + संदेश);
}

कार्य मुख्य() {
    लिखतु("==============================================================================");
    लिखतु("  सूत्र स्वायत्त सञ्चिका-प्रणाली (SutraFS) परीक्षण संच");
    लिखतु("==============================================================================\n");

    // --------------------------------------------------------------------------
    // परीक्षण १: सञ्चिका-प्रणाली आरंभीकरण (SutraFS Mount)
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण १: सञ्चिका-प्रणाली आरंभीकरण एवं परमखंड ---");
    संख्या कुल_सेक्टर = १०२४;
    शब्दकोश तंत्र = सञ्चिका_प्रणाली_आरंभ(कुल_सेक्टर);

    सत्यापित_करो(तंत्र["जादुई_पहचान"] == १३९९८७८२२७, "परमखंड जादुई पहचान 'SFS1'");
    सत्यापित_करो(तंत्र["कुल_सेक्टर"] == १०२४, "कुल सेक्टर १०२४ (५१२ केबी डिस्क)");
    सत्यापित_करो(तंत्र["सेक्टर_आकार"] == ५१२, "सेक्टर ब्लॉक आकार ५१२ बाइट्स");
    सत्यापित_करो(तंत्र["मुक्त_सेक्टर_संख्या"] == १००८, "आरंभिक मुक्त सेक्टर १००८ (१६ आरक्षित)");
    सत्यापित_करो(तंत्र["स्थिति"] == "आरोहित", "सञ्चिका प्रणाली स्थिति 'आरोहित'");
    लिखतु("  [सफल] सञ्चिका-प्रणाली आरंभीकरण एवं आरोहण सम्यक्।\n");

    // --------------------------------------------------------------------------
    // परीक्षण २: सञ्चिका सृजन एवं सेक्टर आवंटन
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण २: सञ्चिका सृजन एवं सेक्टर आवंटन ---");
    // लघु सञ्चिका (<= ५१२ बाइट्स): १ सेक्टर
    पाठ लघु_सामग्री = "नमस्ते जीव-प्रणाली! यह सूत्र ऑपरेटिंग सिस्टम की प्रथम सञ्चिका है।";
    शब्दकोश पत्रक१ = सञ्चिका_सृजन(तंत्र, "नमस्ते.सूत्र", लघु_सामग्री);

    सत्यापित_करो(पत्रक१["नाम"] == "नमस्ते.सूत्र", "सञ्चिका नाम 'नमस्ते.सूत्र'");
    सत्यापित_करो(पत्रक१["आकार"] == लंबाई(लघु_सामग्री), "सञ्चिका आकार सटीक");
    सत्यापित_करो(लंबाई(पत्रक१["आवंटित_सेक्टर_सूची"]) == १, "लघु सञ्चिका हेतु ठीक १ सेक्टर आवंटित");
    सत्यापित_करो(तंत्र["मुक्त_सेक्टर_संख्या"] == १००७, "मुक्त सेक्टर १००७ हुए (-१)");

    // दीर्घ सञ्चिका (> १००० बाइट्स): ३ सेक्टर
    पाठ दीर्घ_सामग्री = दोहराओ("सूत्र_पाणिनीय_प्रज्ञा_अखंड_ज्ञान_कोष_जी२_प्रबुद्ध_स्वायत्त_प्रणाली_", २०);
    शब्दकोश पत्रक२ = सञ्चिका_सृजन(तंत्र, "ज्ञान.सूत्र", दीर्घ_सामग्री);

    सत्यापित_करो(पत्रक२["नाम"] == "ज्ञान.सूत्र", "दीर्घ सञ्चिका नाम 'ज्ञान.सूत्र'");
    सत्यापित_करो(पत्रक२["आकार"] > १०००, "दीर्घ सञ्चिका आकार > १००० बाइट्स");
    सत्यापित_करो(लंबाई(पत्रक२["आवंटित_सेक्टर_सूची"]) >= ३, "दीर्घ सञ्चिका हेतु >= ३ सेक्टर आवंटित");
    सत्यापित_करो(तंत्र["कुल_सञ्चिकाएं"] == २, "कुल सञ्चिकाएं = २");
    लिखतु("  [सफल] एकल एवं बहु-सेक्टर सञ्चिका सृजन एवं सेक्टर आवंटन सिद्ध।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ३: सञ्चिका पठन एवं अखंडता
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ३: सञ्चिका पठन एवं अखंडता ---");
    पाठ पठित_लघु = सञ्चिका_पठन(तंत्र, "नमस्ते.सूत्र");
    सत्यापित_करो(पठित_लघु == लघु_सामग्री, "पठित लघु सञ्चिका सामग्री शत-प्रतिशत समान");

    पाठ पठित_दीर्घ = सञ्चिका_पठन(तंत्र, "ज्ञान.सूत्र");
    सत्यापित_करो(पठित_दीर्घ == दीर्घ_सामग्री, "पठित दीर्घ सञ्चिका सामग्री शत-प्रतिशत समान");
    लिखतु("  [सफल] सञ्चिका पठन एवं डेटा अखंडता सत्यापन सिद्ध।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ४: सञ्चिका सूची (Directory Listing)
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ४: सञ्चिका सूची (Directory Listing) ---");
    सूची सूची_फल = सञ्चिका_सूची(तंत्र);
    सत्यापित_करो(लंबाई(सूची_फल) == २, "निर्देशिका में २ सञ्चिकाएं सूचीबद्ध");

    शब्दकोश स१ = सूची_फल[०];
    सत्यापित_करो(कुंजी_है(स१, "नाम") && कुंजी_है(स१, "आकार"), "सूची तत्व में नाम व आकार");
    लिखतु("  [सफल] निर्देशिका सूची अवलोकन सम्यक्।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ५: सञ्चिका विलोपन एवं सेक्टर विमुक्ति
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ५: सञ्चिका विलोपन एवं सेक्टर विमुक्ति ---");
    संख्या पूर्व_मुक्त = तंत्र["मुक्त_सेक्टर_संख्या"];
    संख्या ज्ञान_सेक्टर_संख्या = लंबाई(पत्रक२["आवंटित_सेक्टर_सूची"]);

    मान विलोपन_सफल = सञ्चिका_विलोपन(तंत्र, "ज्ञान.सूत्र");
    सत्यापित_करो(विलोपन_सफल == सत्य, "सञ्चिका 'ज्ञान.सूत्र' विलोपन सफल");
    सत्यापित_करो(तंत्र["कुल_सञ्चिकाएं"] == १, "अवशेष सञ्चिकाएं = १");
    सत्यापित_करो(तंत्र["मुक्त_सेक्टर_संख्या"] == पूर्व_मुक्त + ज्ञान_सेक्टर_संख्या, "विलोपित सञ्चिका के सभी सेक्टर मुक्त एवं पुनर्चक्रित");
    लिखतु("  [सफल] सञ्चिका विलोपन एवं सेक्टर पुनर्चक्रण सफल।\n");

    // --------------------------------------------------------------------------
    // परीक्षण ६: सञ्चिका-प्रणाली अखंडता एवं शून्य-रिसाव सत्यापन
    // --------------------------------------------------------------------------
    लिखतु("--- परीक्षण ६: समग्र सञ्चिका-प्रणाली अखंडता ऑडिट ---");
    शब्दकोश ऑडिट = सञ्चिका_तंत्र_अखंडता_जाँच(तंत्र);

    सत्यापित_करो(ऑडिट["सुसंगत"] == सत्य, "सञ्चिका तंत्र गणितीय रूप से सुसंगत");
    सत्यापित_करो(ऑडिट["स्वास्थ्य"] == "निर्दोष_अखंड", "सञ्चिका तंत्र स्वास्थ्य: 'निर्दोष_अखंड'");
    सत्यापित_करो(ऑडिट["कुल_सञ्चिकाएं"] == १, "ऑडिट कुल सञ्चिकाएं = १");
    लिखतु("  [सफल] शून्य-सेक्टर रिसाव एवं संपूर्ण अखंडता ऑडिट १००% प्रमाणित।\n");

    लिखतु("==============================================================================");
    लिखतु("  [सर्वं सम्यक्] सूत्र स्वायत्त सञ्चिका-प्रणाली (SutraFS) १००% सफल!");
    लिखतु("  परमखंड, सेक्टर आवंटन, बहु-ब्लॉक सञ्चिकाएं, एवं अखंडता ऑडिट सिद्ध।");
    लिखतु("==============================================================================");
}

मुख्य();
