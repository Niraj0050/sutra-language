// gc_तनाव.सूत्र — auto-GC rooting stress (parser-जैसे patterns)
// नेस्टेड dict trees, loop में string-build, गहरी recursion, list accum

कार्य पेड़_बनाओ(संख्या गहराई, संख्या चौड़ाई) {
    शब्दकोश नोड = {};
    नोड["नाम"] = "नोड_" + गहराई;
    नोड["गहराई"] = गहराई;
    नोड["बच्चे"] = [];
    यदि (गहराई <= 0) { परत् नोड; }
    संख्या इ = 0;
    यावत् (इ < चौड़ाई) {
        शब्दकोश बच्चा = पेड़_बनाओ(गहराई - 1, चौड़ाई);
        नोड["बच्चे"] = जोड़ें(नोड["बच्चे"], बच्चा);
        इ = इ + 1;
    }
    परत् नोड;
}

कार्य पेड़_गिनो(शब्दकोश नोड) {
    संख्या योग = 1;
    सूची बच्चे = नोड["बच्चे"];
    संख्या इ = 0;
    यावत् (इ < लंबाई(बच्चे)) {
        योग = योग + पेड़_गिनो(बच्चे[इ]);
        इ = इ + 1;
    }
    परत् योग;
}

कार्य पाठ_बनाओ(संख्या नन) {
    पाठ स = "";
    संख्या इ = 0;
    यावत् (इ < नन) {
        स = स + "क";
        यदि (इ % 7 == 0) { स = स + "-" + इ + "-"; }
        इ = इ + 1;
    }
    परत् लंबाई(स);
}

कार्य शब्दकोश_बनाओ(संख्या नन) {
    शब्दकोश द = {};
    संख्या इ = 0;
    यावत् (इ < नन) {
        द["कुंजी_" + इ] = "मान_" + इ + "_पूंछ";
        इ = इ + 1;
    }
    संख्या योग = 0;
    इ = 0;
    यावत् (इ < नन) {
        पाठ म = द["कुंजी_" + इ];
        योग = योग + लंबाई(म);
        इ = इ + 1;
    }
    परत् योग;
}

कार्य मुख्य() {
    शब्दकोश जड़ = पेड़_बनाओ(6, 3);
    लिखतु(पेड़_गिनो(जड़));       // 1+3+9+27+81+243+729 = 1093
    लिखतु(पाठ_बनाओ(500));
    लिखतु(शब्दकोश_बनाओ(400));
    // पेड़ फिर से touch करो — GC के बाद भी जीवित?
    लिखतु(पेड़_गिनो(जड़));
}
