कार्य मुख्य() {
    लिखतु("=== पठतु() इनपुट परीक्षण ===");

    // 1. Text Input
    लिखतु("1. पाठ इनपुट परीक्षण:");
    मान नाम = पठतु();
    लिखतु("नाम: " + नाम);

    // 2. Integer Input
    लिखतु("2. संख्या इनपुट परीक्षण:");
    मान आयु = पठतु();
    लिखतु("आयु: " + आयु);

    // 3. Decimal Input
    लिखतु("3. दशमलव इनपुट परीक्षण:");
    मान मूल्य = पठतु();
    लिखतु("मूल्य: " + मूल्य);

    // 4. Input in Calculation
    मान कुल_आयु = आयु + 5;
    लिखतु("5 वर्ष बाद आयु: " + कुल_आयु);

    // 5. Input in Condition
    अगर (आयु >= 18) {
        लिखतु("स्थिति: वयस्क");
    } अन्यथा {
        लिखतु("स्थिति: नाबालिग");
    }

    // 6. Input inside a Loop
    लिखतु("6. लूप में इनपुट परीक्षण:");
    मान चक्र_संख्या = पठतु();
    पुनरावृत्तिः (मान i = 1; i <= चक्र_संख्या; i = i + 1) {
        लिखतु("आवर्तन: " + i);
    }
}
