    }

    // ४. ३डी स्थानिक गोदाम एवं २डी डैशबोर्ड संयोजन
    लिखतु("\n--- ४. ३डी स्थानिक गोदाम दृश्य एवं २डी यूआई निर्माण ---");
    शब्दकोश दृश्य = उद्यम_स्थानिक_गोदाम_दृश्य(उद्यम);
    लिखतु("  ✓ गोदाम के ३ स्थानिक खंड (Shelving Bays) संयोजित।");
