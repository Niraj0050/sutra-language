कार्य अनुप्रयोग_अवस्था_आरंभ() {
    शब्दकोश प्रारंभिक = {
        "कार्ट_गणना": ०,
        "कार्ट_वस्तुएँ": [],
        "त्रिआयामी_कोण": ०,
        "सक्रिय_टैब": "उत्पाद",
        "ग्राहक_नाम": "आर्यभट्ट",
        "नगर": "उज्जयिनी",
