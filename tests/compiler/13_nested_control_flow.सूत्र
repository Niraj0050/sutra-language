// Native Compiler Test 13: Nested Control Flow & Functions
कार्य गणना(संख्या सीमा) {
    मान कुल = 0;
    पुनरावृत्तिः (मान इ = 1; इ <= सीमा; इ = इ + 1) {
        अगर (इ % 2 == 0) {
            कुल = कुल + इ;
        }
    }
    परत् कुल;
}

कार्य मुख्य() {
    मान परिणाम = गणना(10);
    लिखतु(परिणाम); // Sum of even numbers <= 10 = 2+4+6+8+10 = 30
}
