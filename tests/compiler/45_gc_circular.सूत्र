वर्ग नोड {
    मान नाम = "";
    मान सम्बन्ध = शून्यम्;

    कार्य रचना(पाठ नाम) {
        स्व.नाम = नाम;
    }
}

कार्य मुख्य() {
    लिखतु("प्रारम्भः");
    
    // 1. Create unreachable circular objects
    मान च१ = नवीन नोड("चक्र_एक");
    मान च२ = नवीन नोड("चक्र_द्वि");
    च१.सम्बन्ध = च२;
    च२.सम्बन्ध = च१;

    // 2. Clear roots
    च१ = शून्यम्;
    च२ = शून्यम्;

    // 3. Collect (should free both)
    संग्रह_करो();
    
    // 4. Create reachable circular objects
    मान स१ = नवीन नोड("सक्रिय_एक");
    मान स२ = नवीन नोड("सक्रिय_द्वि");
    स१.सम्बन्ध = स२;
    स२.सम्बन्ध = स१;

    // 5. Collect (both must survive)
    संग्रह_करो();

    // Verify still valid
    लिखतु(स१.नाम);
    लिखतु(स२.नाम);

    // 6. Clean up
    स१ = शून्यम्;
    स२ = शून्यम्;
    संग्रह_करो();
    लिखतु("समाप्तम्");
}

मुख्य();
