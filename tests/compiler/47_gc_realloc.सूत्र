कार्य मुख्य() {
    लिखतु("प्रारम्भः");

    // 1. String growth (causes realloc)
    पाठ क = "क";
    मान i = 0;
    जबतक (i < 100) {
        क = क + "ख";
        i = i + 1;
    }
    
    // GC before shrink
    संग्रह_करो();
    लिखतु(क);

    // 2. List growth and shrink
    सूची सू = [];
    मान j = 0;
    जबतक (j < 50) {
        सू = जोड़ें(सू, j);
        j = j + 1;
    }
    
    संग्रह_करो();
    लिखतु("सूची_लंबाई:");
    लिखतु(लंबाई(सू));

    // Pop/shrink
    जबतक (लंबाई(सू) > 5) {
        सू = निकालें(सू);
    }

    संग्रह_करो();
    लिखतु("सूची_संकुचित_लंबाई:");
    लिखतु(लंबाई(सू));
    
    // Verify remaining elements
    लिखतु(सू[0]);
    लिखतु(सू[4]);
    
    लिखतु("समाप्तम्");
}

मुख्य();
