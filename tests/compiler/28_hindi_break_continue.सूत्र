// Regression test: Hindi loop keywords (तोड़ो, जारीरखो)
कार्य मुख्य() {
    // Loop with break alias (तोड़ो)
    मान i = 1;
    जबतक (i <= 10) {
        अगर (i == 4) {
            तोड़ो;
        }
        लिखतु(i);
        i = i + 1;
    }

    // Loop with continue alias (जारीरखो)
    पुनरावृत्तिः (मान k = 1; k <= 5; k = k + 1) {
        अगर (k == 3) {
            जारीरखो;
        }
        लिखतु(k);
    }
}
