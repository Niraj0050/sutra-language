कार्य मुख्य() {
    // उपखंड (substring)
    अगर (उपखंड("Sutra", 0, 2) == "Su" तथा उपखंड("नमस्ते", 0, 2) == "नम" तथा उपखंड("AनB", 1, 2) == "न") {
        लिखतु("SUBSTR_OK");
    } अन्यथा {
        लिखतु("SUBSTR_FAIL");
    }

    अगर (उपखंड("hello", 2, 2) == "") {
        लिखतु("SUBSTR_EMPTY_OK");
    } अन्यथा {
        लिखतु("SUBSTR_EMPTY_FAIL");
    }


    // खोजें (find)
    अगर (खोजें("Sutra", "tr") == 2 तथा खोजें("नमस्ते", "स") == 2 तथा खोजें("hello", "z") == -1) {
        लिखतु("FIND_OK");
    } अन्यथा {
        लिखतु("FIND_FAIL");
    }


    // बदलें (replace)
    अगर (बदलें("hello world", "world", "Sutra") == "hello Sutra" तथा बदलें("abcabc", "bc", "X") == "aXabc" तथा बदलें("abc", "z", "Q") == "abc") {
        लिखतु("REPLACE_OK");
    } अन्यथा {
        लिखतु("REPLACE_FAIL");
    }

    अगर (बदलें("abcabc", "bc", "") == "aabc") {
        लिखतु("REPLACE_EMPTY_OK");
    } अन्यथा {
        लिखतु("REPLACE_EMPTY_FAIL");
    }


    // विभाजित (split)
    मान विभाजित_1 = विभाजित("a,b,c", ",");
    अगर (लंबाई(विभाजित_1) == 3 तथा विभाजित_1[0] == "a" तथा विभाजित_1[1] == "b" तथा विभाजित_1[2] == "c") {
        लिखतु("SPLIT_OK");
    } अन्यथा {
        लिखतु("SPLIT_FAIL");
    }

    मान विभाजित_2 = विभाजित("a,,b,", ",");
    अगर (लंबाई(विभाजित_2) == 4 तथा विभाजित_2[0] == "a" तथा विभाजित_2[1] == "" तथा विभाजित_2[2] == "b" तथा विभाजित_2[3] == "") {
        लिखतु("SPLIT_EMPTY_OK");
    } अन्यथा {
        लिखतु("SPLIT_EMPTY_FAIL");
    }

    अगर (विभाजित("नमस्ते", "म") [0] == "न" तथा विभाजित("नमस्ते", "म")[1] == "स्ते") {
        लिखतु("SPLIT_DEVA_OK");
    } अन्यथा {
        लिखतु("SPLIT_DEVA_FAIL");
    }


    // संयोजित (join)
    मान ल1 = ["a", "b", "c"];
    अगर (संयोजित(ल1, ",") == "a,b,c" तथा संयोजित(["x"], "-") == "x" तथा संयोजित([], "-") == "") {
        लिखतु("JOIN_OK");
    } अन्यथा {
        लिखतु("JOIN_FAIL");
    }


    // छाँटें (trim)
    अगर (छाँटें("  hello  ") == "hello" तथा छाँटें("\tनमस्ते\n") == "नमस्ते" तथा छाँटें("   ") == "") {
        लिखतु("TRIM_OK");
    } अन्यथा {
        लिखतु("TRIM_FAIL");
    }

    // आरंभिक / अंतिम (startswith/endswith)
    अगर (आरंभिक("नमस्ते", "नम") तथा आरंभिक("Sutra", "Su") तथा !(आरंभिक("Sutra", "su")) तथा अंतिम("नमस्ते", "स्ते") तथा अंतिम("hello", "lo") तथा !(अंतिम("hello", "LO"))) {
        लिखतु("PREFIX_SUFFIX_OK");
    } अन्यथा {
        लिखतु("PREFIX_SUFFIX_FAIL");
    }

    अगर (आरंभिक("abc", "") तथा अंतिम("abc", "")) {
        लिखतु("EMPTY_PREFIX_SUFFIX_OK");
    } अन्यथा {
        लिखतु("EMPTY_PREFIX_SUFFIX_FAIL");
    }
}
