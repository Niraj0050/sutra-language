// प्रयत्न / पकड़ो — IR path lowering जाँच

कार्य फेंकने_वाला(संख्या मान_क) {
    यदि (मान_क > 0) {
        प्रक्षेपः "मान धनात्मक है";
    }
    परत् "ठीक";
}

कार्य मुख्य() {
    // 1. सीधा — कोई अपवाद नहीं
    प्रयत्न {
        लिखतु("A: try चालू");
        लिखतु("A: try पूरा");
    } पकड़ो (त्रुटि) {
        लिखतु("A: पकड़ो (नहीं होना चाहिए)");
    }
    लिखतु("A: बाद");

    // 2. सीधा throw
    प्रयत्न {
        लिखतु("B: try चालू");
        प्रक्षेपः "बूम";
        लिखतु("B: throw के बाद (नहीं)");
    } पकड़ो (त्रुटि) {
        लिखतु("B: पकड़ा: " + त्रुटि);
    }
    लिखतु("B: बाद");

    // 3. नेस्टेड कॉल से throw
    प्रयत्न {
        मान र = फेंकने_वाला(5);
        लिखतु("C: मिला " + र);
    } पकड़ो (त्रुटि) {
        लिखतु("C: पकड़ा: " + त्रुटि);
    }

    // 4. कॉल जो throw नहीं करती
    प्रयत्न {
        मान र = फेंकने_वाला(0);
        लिखतु("D: मिला " + र);
    } पकड़ो (त्रुटि) {
        लिखतु("D: पकड़ो (नहीं)");
    }

    // 5. लूप के अंदर try/catch
    संख्या इक = 0;
    यावत् (इक < 3) {
        प्रयत्न {
            यदि (इक == 1) {
                प्रक्षेपः "इक एक है";
            }
            लिखतु("E: इक=" + इक + " ठीक");
        } पकड़ो (त्रुटि) {
            लिखतु("E: इक=" + इक + " पकड़ा: " + त्रुटि);
        }
        इक = इक + 1;
    }

    // 6. try से पहले घोषित चर पकड़ो में पढ़ो (throw से पहले नहीं बदला)
    मान स्थिति = "प्रारंभ";
    प्रयत्न {
        प्रक्षेपः "जल्दी";
    } पकड़ो (त्रुटि) {
        लिखतु("F: स्थिति=" + स्थिति + " त्रुटि=" + त्रुटि);
    }

    लिखतु("सब पूरा");
}
