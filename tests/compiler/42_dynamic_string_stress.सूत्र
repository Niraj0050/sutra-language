कार्य मुख्य() {
    लिखतु("Start");
    पाठ खाली = "";
    अगर (लंबाई(खाली) != 0) { लिखतु("FAIL: Empty string length"); }

    पाठ छोटा = "अ";
    अगर (लंबाई(छोटा) != 1) { लिखतु("FAIL: Short string length"); }

    लिखतु("Growth");
    पाठ क = "";
    मान इ = 0;
    जबतक (इ < 100) {
        क = क + "क्ष";
        इ = इ + 1;
    }
    अगर (लंबाई(क) != 100) { लिखतु("FAIL: Repeated append length"); }
    
    लिखतु("Concat");
    पाठ शून्य_शून्य = "" + "";
    अगर (लंबाई(शून्य_शून्य) != 0) { लिखतु("FAIL: Empty + Empty"); }

    पाठ शून्य_पाठ = "" + "abc";
    अगर (शून्य_पाठ != "abc") { लिखतु("FAIL: Empty + Text"); }

    पाठ पाठ_शून्य = "xyz" + "";
    अगर (पाठ_शून्य != "xyz") { लिखतु("FAIL: Text + Empty"); }

    पाठ पाठ_पाठ = "hello" + "world";
    अगर (पाठ_पाठ != "helloworld") { लिखतु("FAIL: Text + Text"); }

    लिखतु("Stress");
    पाठ विशाल = "start";
    इ = 0;
    जबतक (इ < 10) {
        विशाल = विशाल + विशाल;
        इ = इ + 1;
    }
    अगर (लंबाई(विशाल) != 5120) { लिखतु("FAIL: Large string growth"); }

    लिखतु("DYNAMIC_STRING_STRESS_OK");
}
