// Native Compiler Test 12: Break & Continue (विरामः, जारीरह)
कार्य मुख्य() {
    लिखतु(100);

    // Loop with Break
    मान i = 1;
    जबतक (i <= 10) {
        अगर (i == 4) {
            विरामः;
        }
        लिखतु(i);
        i = i + 1;
    }

    लिखतु(200);

    // Loop with Continue
    पुनरावृत्तिः (मान k = 1; k <= 5; k = k + 1) {
        अगर (k == 3) {
            जारीरह;
        }
        लिखतु(k);
    }
}
