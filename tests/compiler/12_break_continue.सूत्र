// Native Compiler Test 12: Break & Continue (विरामः, जारीरह)
कार्य मुख्य() {
    लिखतु(100);

    // Loop with Break
    मान इ = 1;
    जबतक (इ <= 10) {
        अगर (इ == 4) {
            विरामः;
        }
        लिखतु(इ);
        इ = इ + 1;
    }

    लिखतु(200);

    // Loop with Continue
    पुनरावृत्तिः (मान क = 1; क <= 5; क = क + 1) {
        अगर (क == 3) {
            जारीरह;
        }
        लिखतु(क);
    }
}
