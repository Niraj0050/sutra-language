// संकलन-काल स्थिरांक-तह (§4a) — अंकगणित/बिटवार/एकल तह के बाद
// परिणाम interp == native रहना चाहिए। कई folded मान > 2³¹ →
// उत्सर्जक का movabsq पथ (movq $imm, mem का imm केवल 32-बिट)।
कार्य मुख्य() {
    // अंकगणित तह — गुणनफल 2³¹ के पार
    लिखतु(1000000 * 1000000);              // 1000000000000
    लिखतु(2000000000 + 2000000000);        // 4000000000
    लिखतु(2 + 3 * 4 - 1);                  // 13
    लिखतु(0 - (5 * 5));                    // -25

    // एकल तह
    लिखतु(-(7 * 6));                       // -42

    // बिटवार तह
    लिखतु(बिट_या(बिट_और(240, 60), बाम_सरक(1, 8)));   // 304
    लिखतु(बाम_सरक(1, 40));                 // 1099511627776
    लिखतु(दक्षिण_सरक(बाम_सरक(1, 62), 10)); // 4503599627370496
    लिखतु(बिट_उलट(0));                     // -1
    लिखतु(बिट_और(बाम_सरक(255, 24), 2147483647));  // 2130706432

    // मिश्रित — कुछ folded कुछ runtime
    संख्या क = 1000000;
    लिखतु(क * 1000000);                    // 1000000000000  (runtime — क चर)
    संख्या ख = बाम_सरक(1, 45);
    लिखतु(ख + 1);                          // 35184372088833
}
