कार्य मुख्य() {
    // 1. Literal and Assignment
    दशमलव क = 1.5;
    दशमलव ख = 2.5;
    लिखतु(क);
    लिखतु(ख);

    // 2. Float Arithmetic
    लिखतु(क + ख); // 4.0
    लिखतु(ख - क); // 1.0
    लिखतु(क * ख); // 3.75
    लिखतु(ख / क); // 1.66667 (or close)

    // 3. Float Comparisons
    लिखतु(क == ख); // असत्य
    लिखतु(क != ख); // सत्य
    लिखतु(क < ख);  // सत्य
    लिखतु(क > ख);  // असत्य
    लिखतु(क <= ख); // सत्य
    लिखतु(क >= ख); // असत्य

    // 4. Type Promotion (Int <-> Float)
    लिखतु(10 + क); // 11.5
    लिखतु(ख * 2);  // 5.0
    लिखतु(3.0 > 2); // सत्य

    // 5. Mathematical Built-ins
    लिखतु(वर्गमूल(2.25)); // 1.5
    लिखतु(घात(2.0, 3.0)); // 8
    लिखतु(निरपेक्ष(-5.5)); // 5.5
    लिखतु(न्यूनतम(क, ख)); // 1.5
    लिखतु(अधिकतम(क, ख)); // 2.5
    लिखतु(गोल(क)); // 2 (rounds 1.5 to 2)

    // 6. String Implicit Concatenation
    लिखतु("दशमलव: " + क);

    // 7. Division by Zero Exception
    प्रयत्न {
        लिखतु(क / 0.0);
        लिखतु(क / 0);
        लिखतु("FLOAT_DIV_BY_ZERO_FAIL");
    } पकड़ो (त्रुटि) {
        लिखतु("FLOAT_DIV_BY_ZERO_OK");
    }
}


