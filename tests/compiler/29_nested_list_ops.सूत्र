कार्य संशोधित(सूची संख्याः) {
    संख्याः[0] = 99;
    परत् संख्याः;
}

कार्य मुख्य() {
    सूची बाह्य = [[10, 20], [30, 40]];
    बाह्य[1][0] = 99;
    लिखतु(बाह्य[1][0]);
    लिखतु(बाह्य[0][1]);

    सूची मानानि = [10, 20];
    सूची परिणाम = संशोधित(मानानि);
    लिखतु(लंबाई(परिणाम));
    लिखतु(परिणाम[0]);
}
