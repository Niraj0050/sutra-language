// else-if (अन्यथा यदि / अन्यथा अगर) chaining test

कार्य श्रेणी(संख्या अंक) {
    अगर (अंक >= 90) {
        परत् "अ";
    } अन्यथा अगर (अंक >= 80) {
        परत् "ब";
    } अन्यथा अगर (अंक >= 70) {
        परत् "स";
    } अन्यथा अगर (अंक >= 60) {
        परत् "द";
    } अन्यथा {
        परत् "फ";
    }
}

कार्य मुख्य() {
    लिखतु("=== अन्यथा-यदि/अगर (Else-If) परीक्षण ===");

    // Test 1: Basic else-if chain with अगर
    मान श्र1 = श्रेणी(95);
    अगर (श्र1 == "अ") {
        लिखतु("1. श्रेणी 95 = अ: सफल (PASS)");
    } अन्यथा {
        लिखतु("1. श्रेणी 95: विफल (FAIL)");
    }

    मान श्र2 = श्रेणी(85);
    अगर (श्र2 == "ब") {
        लिखतु("2. श्रेणी 85 = ब: सफल (PASS)");
    } अन्यथा {
        लिखतु("2. श्रेणी 85: विफल (FAIL)");
    }

    मान श्र3 = श्रेणी(55);
    अगर (श्र3 == "फ") {
        लिखतु("3. श्रेणी 55 = फ: सफल (PASS)");
    } अन्यथा {
        लिखतु("3. श्रेणी 55: विफल (FAIL)");
    }

    // Test 2: Using यदि with अन्यथा यदि
    मान x = 2;
    मान परिणाम = "";
    यदि (x == 1) {
        परिणाम = "एक";
    } अन्यथा यदि (x == 2) {
        परिणाम = "दो";
    } अन्यथा यदि (x == 3) {
        परिणाम = "तीन";
    } अन्यथा {
        परिणाम = "अन्य";
    }

    अगर (परिणाम == "दो") {
        लिखतु("4. यदि-अन्यथा यदि chain: सफल (PASS)");
    } अन्यथा {
        लिखतु("4. यदि-अन्यथा यदि chain: विफल (FAIL)");
    }

    // Test 3: Mixed अगर/यदि in chain
    मान y = 30;
    मान श्रेणी_वर्ग = "";
    अगर (y < 10) {
        श्रेणी_वर्ग = "छोटा";
    } अन्यथा यदि (y < 20) {
        श्रेणी_वर्ग = "मध्यम";
    } अन्यथा अगर (y < 40) {
        श्रेणी_वर्ग = "बड़ा";
    } अन्यथा {
        श्रेणी_वर्ग = "विशाल";
    }

    अगर (श्रेणी_वर्ग == "बड़ा") {
        लिखतु("5. मिश्रित अगर/यदि chain: सफल (PASS)");
    } अन्यथा {
        लिखतु("5. मिश्रित अगर/यदि chain: विफल (FAIL)");
    }

    लिखतु("=== else-if परीक्षण सम्पन्न ===");
}
