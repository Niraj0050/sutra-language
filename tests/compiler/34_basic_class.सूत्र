// Phase 5 Test: Basic class with fields and constructor
वर्ग व्यक्ति {
    मान नाम;
    मान आयु;

    कार्य रचना(मान न_तर्क, मान आ_तर्क) {
        स्व.नाम = न_तर्क;
        स्व.आयु = आ_तर्क;
    }

    कार्य परिचय() {
        लिखतु(स्व.नाम);
        लिखतु(स्व.आयु);
    }
}

कार्य मुख्य() {
    मान प = नवीन व्यक्ति("राम", 25);
    प.परिचय();
    लिखतु(प.नाम);
    लिखतु(प.आयु);
    प.आयु = 30;
    लिखतु(प.आयु);
}
