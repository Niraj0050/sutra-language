// OOP test for Sutra (वर्ग, नवीन, स्व)
लिखतु("=== OOP Class & Object Test ===");

वर्ग छात्र {
    मान नाम = "अज्ञात";
    संख्या आयु = 0;

    कार्य रचना(पाठ n, संख्या a) {
        स्व.नाम = n;
        स्व.आयु = a;
    }

    कार्य विवरण() {
        लिखतु("छात्र नाम: " + स्व.नाम);
        लिखतु("छात्र आयु:");
        लिखतु(स्व.आयु);
    }
}

मान स1 = नवीन छात्र("राधा", 21);
स1.विवरण();

लिखतु("आयु परिवर्तन पश्चात्:");
स1.आयु = 22;
स1.विवरण();
