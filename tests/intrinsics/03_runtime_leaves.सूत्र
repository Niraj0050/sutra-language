// रनटाइम के पत्ते अब सूत्र में — दैशिक_लंबाई / अक्षर_कोडबिंदु / पाठ_तुल्य / सञ्चय_गणना
// (मूल_रनटाइम.सूत्र), जो native संकलक द्वारा जोड़े जाते हैं।
मान विफल = 0;
कार्य जाँच(पाठ नाम, संख्या अ, संख्या ब) {
    यदि (अ == ब) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम + " — " + अ + " != " + ब); विफल = विफल + 1; }
}
कार्य मुख्य() {
    // लंबाई → दैशिक_लंबाई → पाठ_कोडबिंदु_गणना / सञ्चय_गणना
    जाँच("ASCII पाठ लंबाई", लंबाई("hello"), 5);
    जाँच("देवनागरी पाठ लंबाई (कोडबिंदु)", लंबाई("नमस्ते"), 6);
    जाँच("रिक्त पाठ लंबाई", लंबाई(""), 0);
    जाँच("सूची लंबाई", लंबाई([1, 2, 3, 4, 5]), 5);
    जाँच("रिक्त सूची लंबाई", लंबाई([]), 0);
    शब्दकोश द = {};
    द["क"] = 1;
    द["ख"] = 2;
    जाँच("शब्दकोश लंबाई", लंबाई(द), 2);

    // अक्षर_मान → अक्षर_कोडबिंदु
    जाँच("अक्षर_मान 'A'", अक्षर_मान("A"), 65);
    जाँच("अक्षर_मान 'न' (U+0928)", अक्षर_मान("न"), 2344);
    जाँच("अक्षर_मान पाठ-सूचकांक", अक्षर_मान("xyz"[1]), 121);

    // पाठ == → पाठ_तुल्य
    संख्या त1 = 0;
    यदि ("अ" + "ब" == "अब") { त1 = 1; }
    जाँच("संयोजित == साहित्य", त1, 1);
    संख्या त2 = 0;
    यदि ("क" == "ख") { त2 = 1; }
    जाँच("असमान पाठ ==", त2, 0);
    संख्या त3 = 0;
    यदि ("मान" != "मूल्य") { त3 = 1; }
    जाँच("पाठ !=", त3, 1);

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
