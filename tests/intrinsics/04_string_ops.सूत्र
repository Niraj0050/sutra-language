// आवंटन करने वाली पाठ-क्रियाएँ अब सूत्र में — पाठ_जोड़ / पाठ_उपखंड /
// संख्या_से_पाठ / बूल_से_पाठ / शून्य_से_पाठ / अक्षर_बना (मूल_रनटाइम.सूत्र),
// जो native संकलक द्वारा हर binary में जोड़े जाते हैं। C अब केवल shim है।
मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}
कार्य मुख्य() {
    // पाठ_जोड़ (sutra_str_concat) — खंड_प्रतिलिपि 8-बाइट + बाइट-पुच्छ
    जाँच("ASCII संयोजन", ("foo" + "bar" == "foobar"));
    जाँच("रिक्त + पाठ", ("" + "x" == "x"));
    जाँच("पाठ + रिक्त", ("y" + "" == "y"));
    जाँच("देवनागरी संयोजन", ("नम" + "स्ते" == "नमस्ते"));
    जाँच("बहु-संयोजन (लंबा)", ("a" + "b" + "c" + "d" + "e" + "f" + "g" + "h" + "i" == "abcdefghi"));

    // संख्या_से_पाठ (sutra_int_to_str)
    जाँच("धन संख्या→पाठ", ("" + 42 == "42"));
    जाँच("शून्य संख्या→पाठ", ("" + 0 == "0"));
    जाँच("ऋण संख्या→पाठ", ("" + (0 - 137) == "-137"));
    जाँच("बड़ी संख्या→पाठ", ("" + 1000000 == "1000000"));

    // बूल_से_पाठ / शून्य_से_पाठ
    जाँच("सत्य→पाठ", ("" + सत्य == "सत्य"));
    जाँच("असत्य→पाठ", ("" + असत्य == "असत्य"));
    जाँच("शून्य→पाठ", ("" + शून्यम् == "शून्यम्"));

    // पाठ_उपखंड (sutra_substr) — कोडबिंदु-सूचकांक
    जाँच("ASCII उपखंड", (उपखंड("hello world", 0, 5) == "hello"));
    जाँच("मध्य उपखंड", (उपखंड("hello world", 6, 11) == "world"));
    जाँच("देवनागरी उपखंड", (उपखंड("नमस्ते", 0, 3) == "नमस"));
    जाँच("रिक्त उपखंड (आरंभ==अंत)", (उपखंड("abc", 1, 1) == ""));
    जाँच("पूर्ण उपखंड", (उपखंड("abc", 0, 3) == "abc"));

    // पाठ-सूचकांक s[i] → sutra_arr_get → sutra_substr(i, i+1)
    जाँच("पाठ-सूचकांक ASCII", ("hello"[1] == "e"));
    जाँच("पाठ-सूचकांक देवनागरी", ("नमस्ते"[0] == "न"));

    // अक्षर_बना (sutra_char_chr) — कोडबिंदु → UTF-8
    जाँच("अक्षर_निर्माण 'A'", (अक्षर_निर्माण(65) == "A"));
    जाँच("अक्षर_निर्माण 'न' (U+0928)", (अक्षर_निर्माण(2344) == "न"));
    जाँच("अक्षर_निर्माण गोल-यात्रा", (अक्षर_मान(अक्षर_निर्माण(2404)) == 2404));

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
