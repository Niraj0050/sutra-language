// OS-तल अंतर्निर्देश — VirtualAlloc + WriteFile(stdout) + बिना C
कार्य मुख्य() {
    // 64 बाइट OS से माँगो
    मान बफ़र = अंतर्_क्षेत्र_आवंटन(64);

    // "नमस्ते\न" के बाइट्स भरो (UTF-8): न म स ् त े \n
    मान बाइट्स = [224, 164, 168, 224, 164, 174, 224, 164, 184, 224, 165, 141, 224, 164, 164, 224, 165, 135, 10];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(बाइट्स)) {
        अंतर्_लिख1(बफ़र, सूचक, बाइट्स[सूचक]);
        सूचक = सूचक + 1;
    }

    // सीधे stdout को लिखो — कोई लिखतु(), कोई printf
    अंतर्_मुद्रण(बफ़र, 0, लंबाई(बाइट्स));

    // पढ़कर जाँचो
    यदि (अंतर्_पढ़1(बफ़र, 0) == 224 && अंतर्_पढ़1(बफ़र, 18) == 10) {
        लिखतु("सर्वे उत्तीर्णाः");
    } अन्यथा {
        लिखतु("विफलम्");
    }

    अंतर्_क्षेत्र_मुक्त(बफ़र);
}
