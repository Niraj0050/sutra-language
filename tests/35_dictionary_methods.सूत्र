/* Dictionary built-ins: keys, has_key, remove, length */

कार्य मुख्य() {
    मान शब्द = {"a": 1, "b": 2};
    
    लिखतु(लंबाई(शब्द)); /* 2 */
    लिखतु(कुंजी_है(शब्द, "a")); /* 1 or true */
    लिखतु(कुंजी_है(शब्द, "c")); /* 0 or false */
    
    लिखतु(शब्द["b"]);
    हटाएं(शब्द, "b");
    लिखतु(लंबाई(शब्द)); /* 1 */
    लिखतु(कुंजी_है(शब्द, "b")); /* 0 */
}

मुख्य();
