// tests/stdlib/यूआईडी_परीक्षण.सूत्र
आयात "पुस्तकालय/यूआईडी.सूत्र";
आयात "पुस्तकालय/यादृच्छिक.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("प्रारूप — आकार/हाइफ़न-स्थिति/hex-अंक");
    शब्दकोश रा1 = यादृ_बनाओ(१);
    पाठ आ1 = यूआईडी_संस्करण४(रा1);
    जाँच("कुल लंबाई 36", लंबाई(आ1), ३६);
    जाँच("यूआईडी_मान्य_है(आ1) सत्य", यूआईडी_मान्य_है(आ1), सत्य);
    जाँच("हाइफ़न स्थिति 8", उपखंड(आ1, ८, ९), "-");
    जाँच("हाइफ़न स्थिति 13", उपखंड(आ1, १३, १४), "-");
    जाँच("हाइफ़न स्थिति 18", उपखंड(आ1, १८, १९), "-");
    जाँच("हाइफ़न स्थिति 23", उपखंड(आ1, २३, २४), "-");

    परीक्षण_समूह("संस्करण/variant अंक — RFC 4122 §4.4");
    पाठ संस्करण_अंक = उपखंड(आ1, १४, १५);
    जाँच("संस्करण अंक सदा '4' (14वाँ स्थान)", संस्करण_अंक, "4");
    पाठ प्रकार_अंक = उपखंड(आ1, १९, २०);
    बूल प्रकार_सही = प्रकार_अंक == "8" || प्रकार_अंक == "9" || प्रकार_अंक == "a" || प्रकार_अंक == "b";
    जाँच("variant अंक 8/9/a/b में से एक", प्रकार_सही, सत्य);

    परीक्षण_समूह("सटीक संदर्भ मान (बीज=1 के पहले 4 यादृ_अगला32 output से हाथ-गणना)");
    // यादृ_अगला32(बीज=१) पहला output = ९५१७४६४६६ = 0x38BA7FA2 (यादृच्छिक_परीक्षण
    // में स्वतंत्र-सत्यापित); पहले ४ बाइट इसी से — पहला बाइट = 0x38 = "38"
    शब्दकोश रा_सं = यादृ_बनाओ(१);
    पाठ आ_सं = यूआईडी_संस्करण४(रा_सं);
    जाँच("पहले 2 hex-अंक (पहला बाइट 0x38)", उपखंड(आ_सं, ०, २), "38");
    जाँच("अगले 2 hex-अंक (दूसरा बाइट 0xBA)", उपखंड(आ_सं, २, ४), "ba");

    परीक्षण_समूह("नियतात्मकता — वही बीज = वही UUID");
    जाँच("बीज=1 दुबारा से वही UUID", यूआईडी_संस्करण४(यादृ_बनाओ(१)), आ1);

    परीक्षण_समूह("स्वतंत्रता — अलग बीज/अलग कॉल अलग UUID");
    जाँच("बीज=1 और बीज=2 अलग", यूआईडी_संस्करण४(यादृ_बनाओ(२)) == आ1, असत्य);
    शब्दकोश रा2 = यादृ_बनाओ(१);
    पाठ बार1 = यूआईडी_संस्करण४(रा2);
    पाठ बार2 = यूआईडी_संस्करण४(रा2);   // वही स्ट्रीम, दूसरी कॉल — आगे बढ़ी अवस्था
    जाँच("एक ही स्ट्रीम की लगातार 2 कॉल अलग-अलग UUID", बार1 == बार2, असत्य);

    परीक्षण_समूह("रिक्त (nil) UUID");
    जाँच("यूआईडी_रिक्त() सही मान", यूआईडी_रिक्त(), "00000000-0000-0000-0000-000000000000");
    जाँच("रिक्त UUID भी आकार-मान्य", यूआईडी_मान्य_है(यूआईडी_रिक्त()), सत्य);

    परीक्षण_समूह("यूआईडी_मान्य_है — नकारात्मक मामले");
    जाँच("बहुत छोटा", यूआईडी_मान्य_है("123"), असत्य);
    जाँच("बहुत लंबा", यूआईडी_मान्य_है(यूआईडी_रिक्त() + "0"), असत्य);
    जाँच("ग़लत जगह हाइफ़न", यूआईडी_मान्य_है("00000000-0000-0000-00000-00000000000"), असत्य);
    जाँच("अमान्य अक्षर (g hex नहीं)", यूआईडी_मान्य_है("gggggggg-gggg-gggg-gggg-gggggggggggg"), असत्य);
    जाँच("हाइफ़न की जगह कुछ और", यूआईडी_मान्य_है("00000000_0000_0000_0000_000000000000"), असत्य);
    जाँच("बड़े-अक्षर hex भी मान्य (case-insensitive)",
        यूआईडी_मान्य_है("ABCDEF00-1234-4abc-8abc-abcdefabcdef"), सत्य);

    परीक्षण_समूह("100 लगातार UUID सब मान्य + संस्करण/variant सही");
    शब्दकोश रा3 = यादृ_बनाओ(९९);
    संख्या गिनती = ०;
    यावत् (गिनती < १००) {
        पाठ आ = यूआईडी_संस्करण४(रा3);
        जाँच_सत्य("मान्य UUID", यूआईडी_मान्य_है(आ));
        जाँच_सत्य("संस्करण 4", उपखंड(आ, १४, १५) == "4");
        पाठ व = उपखंड(आ, १९, २०);
        जाँच_सत्य("variant सही", व == "8" || व == "9" || व == "a" || व == "b");
        गिनती = गिनती + १;
    }

    परत् परीक्षण_सारांश();
}
