// पाठ_निर्माता (string builder) परीक्षण
कार्य जांच(पाठ नाम, मान अ, मान ब) {
    यदि (अ == ब) { लिखतु("PASS " + नाम); }
    अन्यथा { लिखतु("FAIL " + नाम + " : " + अ + " != " + ब); }
}

कार्य मुख्य() {
    // खाली
    मान ब0 = निर्माता_नया();
    जांच("empty-len", निर्माता_लंबाई(ब0), ०);
    जांच("empty-text", निर्माता_पाठ(ब0), "");

    // सरल append
    मान ब1 = निर्माता_नया();
    ब1 = निर्माता_जोड़(ब1, "hello");
    ब1 = निर्माता_जोड़(ब1, " ");
    ब1 = निर्माता_जोड़(ब1, "world");
    जांच("simple", निर्माता_पाठ(ब1), "hello world");
    जांच("simple-len", निर्माता_लंबाई(ब1), ११);

    // realloc पार (१६ से ज़्यादा)
    मान ब2 = निर्माता_नया();
    मान इ = ०;
    यावत् (इ < १०००) { ब2 = निर्माता_जोड़(ब2, "ab"); इ = इ + १; }
    जांच("grow-len", निर्माता_लंबाई(ब2), २०००);

    // देवनागरी (multi-byte)
    मान ब3 = निर्माता_नया();
    ब3 = निर्माता_जोड़(ब3, "नमस्ते");
    ब3 = निर्माता_अक्षर(ब3, ३२);
    ब3 = निर्माता_जोड़(ब3, "जगत");
    जांच("devanagari", निर्माता_पाठ(ब3), "नमस्ते जगत");
    जांच("devanagari-len", निर्माता_लंबाई(ब3), १०);

    // खाली append no-op
    मान ब4 = निर्माता_नया();
    ब4 = निर्माता_जोड़(ब4, "");
    ब4 = निर्माता_जोड़(ब4, "x");
    ब4 = निर्माता_जोड़(ब4, "");
    जांच("empty-append", निर्माता_पाठ(ब4), "x");

    // GC: build जबकि कचरा बनता
    सूची होल्ड = [];
    होल्ड = जोड़ें(होल्ड, "बचाओ");
    मान ब5 = निर्माता_नया();
    मान ज = ०;
    यावत् (ज < ५०००) { ब5 = निर्माता_जोड़(ब5, "z"); सूची क = [ज]; ज = ज + १; }
    संग्रह_करो();
    जांच("gc-build", निर्माता_लंबाई(ब5), ५०००);
    जांच("gc-hold", होल्ड[०], "बचाओ");

    // निर्माता_पाठ के बाद string-op
    मान ब6 = निर्माता_नया();
    ब6 = निर्माता_जोड़(ब6, "abcdef");
    पाठ स6 = निर्माता_पाठ(ब6);
    जांच("post-index", स6[२], "c");
    जांच("post-upper", उच्च(स6), "ABCDEF");
}
