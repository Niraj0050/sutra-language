// tests/stdlib/नेटवर्क_परीक्षण.सूत्र
//
// ⚠ बाकी stdlib परीक्षणों के विपरीत यह फ़ाइल असली इंटरनेट कनेक्टिविटी पर
// निर्भर है (example.com को असली TCP/HTTP/HTTPS कॉल, expired.badssl.com को
// एक जानबूझकर-ख़राब-प्रमाणपत्र negative-test कॉल) — नियतात्मक/ऑफ़लाइन नहीं।
// नेटवर्क उपलब्ध न हो तो network-निर्भर समूह असफल दिखेंगे (कम्पाइलर/
// लाइब्रेरी बग नहीं)। बफर-सहायक वाला समूह पूरी तरह नियतात्मक — कभी नेटवर्क
// नहीं चाहिए। HTTPS/FFI-आधारित होने से सिर्फ़ x86 + --release — दुभाषिया
// पर विदेशी घोषणाएँ पार्स ही नहीं होतीं (नेटवर्क.सूत्र README देखो)।

आयात "पुस्तकालय/नेटवर्क.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("कच्चे बफर सहायक — शुद्धता (नियतात्मक, नेटवर्क नहीं चाहिए)");
    पाठ बफ1 = ज_बफर(8);
    संख्या प1 = विदेशी_पता(बफ1);
    ज_लिख1(प1, 0, 255);
    जाँच("लिख1/पढ़1 राउंड-ट्रिप", ज_पढ़1(प1, 0), 255);
    ज_लिख4(प1, 0, 2585203816);
    जाँच("लिख4/पढ़4 राउंड-ट्रिप (बड़ा मान)", ज_पढ़4(प1, 0), 2585203816);
    ज_लिख4(प1, 4, 0);
    जाँच("लिख4/पढ़4 राउंड-ट्रिप (शून्य)", ज_पढ़4(प1, 4), 0);
    ज_लिख2(प1, 0, 65535);
    जाँच("लिख2 का निम्न बाइट (255)", ज_पढ़1(प1, 0), 255);
    जाँच("लिख2 का उच्च बाइट (255)", ज_पढ़1(प1, 1), 255);

    परीक्षण_समूह("inet_addr — dotted-quad सही बाइट-क्रम में (ज_पढ़4 पर हमारे कन्वेंशन में)");
    पाठ आइपी_पाठ = "104.20.23.154";
    संख्या आइपी_रॉ = ज_आइपी_रॉ(विदेशी_पता(आइपी_पाठ));
    जाँच("inet_addr(\"104.20.23.154\") का रॉ मान", आइपी_रॉ, 2585203816);

    परीक्षण_समूह("आरंभ/सफाई");
    संख्या आ = नेटवर्क_आरंभ();
    जाँच("नेटवर्क_आरंभ सफल", आ, सत्य);

    परीक्षण_समूह("संख्यात्मक IP कनेक्शन — असली HTTP GET (example.com)");
    शब्दकोश सं = नेटवर्क_जोड़ो("104.20.23.154", 80);
    जाँच_सत्य("कनेक्शन सफल", सं["सफल"]);
    यदि (सं["सफल"]) {
        नेटवर्क_भेजो_पाठ(सं["सॉकेट"], "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n");
        पाठ उत्तर = नेटवर्क_सब_पाओ_पाठ(सं["सॉकेट"]);
        जाँच_सत्य("उत्तर 'HTTP/1.1' से शुरू होता", उपखंड(उत्तर, 0, 8) == "HTTP/1.1");
        जाँच_सत्य("उत्तर में '200 OK' मौजूद", समाहित_पाठ(उत्तर, "200 OK"));
        जाँच_सत्य("उत्तर में अपेक्षित सामग्री मौजूद", समाहित_पाठ(उत्तर, "Example Domain"));
        जाँच_सत्य("उत्तर पर्याप्त लंबा", लंबाई(उत्तर) > 100);
        नेटवर्क_बंद(सं["सॉकेट"]);
    }

    परीक्षण_समूह("होस्टनाम रिज़ॉल्यूशन (DNS)");
    संख्या खोजा_आइपी = नेटवर्क_होस्ट_खोजो("example.com");
    जाँच_सत्य("example.com सफलतापूर्वक हल हुआ", खोजा_आइपी >= 0);
    संख्या असफल_खोज = नेटवर्क_होस्ट_खोजो("यह-डोमेन-कभी-मौजूद-नहीं-होगा-xyz123.invalid");
    जाँच("अमान्य होस्टनाम -1 लौटाता", असफल_खोज, -1);

    परीक्षण_समूह("सुविधा फलन — पूरा HTTP GET (होस्टनाम से सीधे)");
    पाठ पृष्ठ = नेटवर्क_एचटीटीपी_गेट("example.com", 80, "/");
    जाँच_सत्य("सुविधा-फलन का उत्तर भी सही सामग्री देता", समाहित_पाठ(पृष्ठ, "Example Domain"));

    परीक्षण_समूह("HTTPS/TLS (WinHTTP) — असली TLS हैंडशेक + प्रमाणपत्र-सत्यापन");
    पाठ सु_पृष्ठ = नेटवर्क_एचटीटीपीएस_गेट("example.com", 443, "/");
    जाँच_सत्य("HTTPS GET सही सामग्री देता (पूरा TLS हैंडशेक सफल)",
        समाहित_पाठ(सु_पृष्ठ, "Example Domain"));

    संख्या सु_सत्र = नेटवर्क_सुरक्षित_सत्र_बनाओ();
    संख्या सु_जुड़ाव = नेटवर्क_सुरक्षित_जोड़ो(सु_सत्र, "example.com", 443);
    संख्या सु_निवेदन = नेटवर्क_सुरक्षित_निवेदन_बनाओ(सु_जुड़ाव, "GET", "/", सत्य);
    नेटवर्क_सुरक्षित_भेजो(सु_निवेदन);
    नेटवर्क_सुरक्षित_उत्तर_पाओ(सु_निवेदन);
    जाँच("स्थिति कोड सटीक 200", नेटवर्क_सुरक्षित_स्थिति_कोड(सु_निवेदन), 200);
    नेटवर्क_सुरक्षित_बंद(सु_निवेदन);
    नेटवर्क_सुरक्षित_बंद(सु_जुड़ाव);
    नेटवर्क_सुरक्षित_बंद(सु_सत्र);

    // असली सुरक्षा-गुण जाँच — सिर्फ़ "कनेक्ट हो गया" नहीं, बल्कि "ग़लत
    // प्रमाणपत्र को सही से अस्वीकार करता" — यही TLS का पूरा मुद्दा है
    जाँच_असत्य("expired प्रमाणपत्र वाला सर्वर सही से अस्वीकृत होता",
        नेटवर्क_सुरक्षित_जुड़ाव_सफल("expired.badssl.com", 443, "/"));
    जाँच_सत्य("सामान्य वैध प्रमाणपत्र अब भी स्वीकृत होता",
        नेटवर्क_सुरक्षित_जुड़ाव_सफल("example.com", 443, "/"));

    परीक्षण_समूह("त्रुटि हैंडलिंग");
    शब्दकोश बंद_पोर्ट = नेटवर्क_जोड़ो("127.0.0.1", 1);   // लोकलहोस्ट पर लगभग निश्चित रूप से बंद पोर्ट
    जाँच_असत्य("बंद पोर्ट पर कनेक्शन विफल होता (क्रैश नहीं)", बंद_पोर्ट["सफल"]);

    नेटवर्क_सफाई();
    परत् परीक्षण_सारांश();
}
