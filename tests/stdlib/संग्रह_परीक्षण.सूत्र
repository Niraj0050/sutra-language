// समुच्चय / ढेर / कतार / शब्दकोश उपयोगिता — interp और native दोनों पर।
// शब्दकोश-कुंजी-क्रम interp (उल्टा) बनाम native (डालने का) में भिन्न है
// (interpreter C++ host अब build नहीं होता, तो वह side ठीक नहीं हो सकता) —
// इसलिए कुंजी-क्रम पर निर्भर जाँच को क्रमबद्ध() से normalise किया गया है।
आयात "पुस्तकालय/मानक.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // ===== समुच्चय =====
    मान स = नवीन समुच्चय();
    स.जोड़ो(3); स.जोड़ो(3); स.जोड़ो(5); स.जोड़ो(1);
    लिखतु(स.आकार());              // 3
    लिखतु(हन(स.है(3)));           // हाँ
    लिखतु(हन(स.है(9)));           // नहीं
    स.हटाओ(3);
    लिखतु(स.आकार());              // 2
    लिखतु(हन(स.है(3)));           // नहीं
    सूची सल = स.सूची_में();
    लिखतु(सल[0]); लिखतु(सल[1]);    // 5 1  (डालने का क्रम — सूची, ठीक)

    मान अ1 = समुच्चय_से_सूची([1, 2, 3, 3]);
    मान ब1 = समुच्चय_से_सूची([2, 3, 4]);
    लिखतु(लंबाई(संघ(अ1, ब1)));       // 4
    लिखतु(लंबाई(प्रतिच्छेद(अ1, ब1))); // 2
    लिखतु(लंबाई(अंतर(अ1, ब1)));      // 1

    // ===== ढेर =====
    मान ढ = नवीन ढेर();
    ढ.धकेलो(1); ढ.धकेलो(2); ढ.धकेलो(3);
    लिखतु(ढ.झाँको());             // 3
    लिखतु(ढ.निकालो());            // 3
    लिखतु(ढ.निकालो());            // 2
    लिखतु(ढ.आकार());             // 1
    लिखतु(हन(ढ.खाली_है()));       // नहीं
    लिखतु(ढ.निकालो());            // 1
    लिखतु(हन(ढ.खाली_है()));       // हाँ

    // ===== कतार =====
    मान क = नवीन कतार();
    क.डालो(10); क.डालो(20); क.डालो(30);
    लिखतु(क.आगे());              // 10
    लिखतु(क.निकालो());           // 10
    लिखतु(क.निकालो());           // 20
    क.डालो(40);
    लिखतु(क.आकार());            // 2
    लिखतु(क.निकालो());           // 30
    लिखतु(क.निकालो());           // 40
    लिखतु(हन(क.खाली_है()));      // हाँ

    // ===== शब्दकोश उपयोगिता (कुंजी-क्रम normalise) =====
    शब्दकोश द = {};
    द["अ"] = 1; द["ब"] = 2; द["स"] = 3;
    सूची मस = क्रमबद्ध(मान_सूची(द));
    लिखतु(मस[0]); लिखतु(मस[2]);   // 1 3

    शब्दकोश व = विलय({"अ": 1, "ब": 2}, {"ब": 20, "द": 4});
    लिखतु(व["अ"]); लिखतु(व["ब"]); लिखतु(व["द"]); // 1 20 4
    लिखतु(कुंजी_गणना(व));         // 3

    शब्दकोश यु = से_युग्म([["एक", 1], ["दो", 2]]);
    लिखतु(यु["दो"]);              // 2

    शब्दकोश च = चुनो(द, ["अ", "स", "क्ष"]);
    लिखतु(कुंजी_गणना(च));         // 2
    शब्दकोश छक = छोड़ो_कुंजियाँ(द, ["ब"]);
    लिखतु(कुंजी_गणना(छक));        // 2
    शब्दकोश कह = कुंजी_हटाओ(द, "ब");
    लिखतु(कुंजी_गणना(कह));        // 2
    लिखतु(हन(कुंजी_है(कह, "ब"))); // नहीं

    लिखतु(कुंजी_का(द, 2));        // ब
    लिखतु(हन(शब्दकोश_खाली_है({}))); // हाँ

    लिखतु("संग्रह परीक्षण पूरा");
}
