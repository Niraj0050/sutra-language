// tests/stdlib/यादृच्छिक_परीक्षण.सूत्र
आयात "पुस्तकालय/यादृच्छिक.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// संदर्भ मान PowerShell में दो स्वतंत्र तरीकों (uint32-cast चेन और मैनुअल
// int64+mask चेन) से क्रॉस-चेक करके निकाले — दोनों का परिणाम बिल्कुल मिला।
// बीज=1 → MINSTD-विस्तार a=16807 b=282475249 c=1622650073 d=984943658
// → xorshift128 के पहले 6 output: 951746466, 2568670198, 1142320488,
//   3595627932, 1039982491, 1928783529

कार्य मुख्य() {
    परीक्षण_समूह("यार_अगला32 — सटीक संदर्भ मान (बीज=1)");
    शब्दकोश रा1 = यार_बनाओ(1);
    जाँच("output 1", यार_अगला32(रा1), 951746466);
    जाँच("output 2", यार_अगला32(रा1), 2568670198);
    जाँच("output 3", यार_अगला32(रा1), 1142320488);
    जाँच("output 4", यार_अगला32(रा1), 3595627932);
    जाँच("output 5", यार_अगला32(रा1), 1039982491);
    जाँच("output 6", यार_अगला32(रा1), 1928783529);

    परीक्षण_समूह("नियतात्मकता — वही बीज = वही धारा (ताज़ा राज्य से)");
    शब्दकोश रा2 = यार_बनाओ(1);
    जाँच("दुबारा बीज=1 से पहला output वही", यार_अगला32(रा2), 951746466);

    परीक्षण_समूह("स्वतंत्र धाराएँ — बीज अलग तो output अलग");
    शब्दकोश रा3 = यार_बनाओ(2);
    जाँच("बीज=2 का पहला output बीज=1 से अलग", यार_अगला32(रा3) == 951746466, असत्य);
    जाँच("बीज=2 का पहला output संदर्भ मान", यार_अगला32(यार_बनाओ(2)), 1903492932);

    परीक्षण_समूह("स्वतंत्र धाराएँ — दो राज्य एक-दूसरे को प्रभावित नहीं करते");
    शब्दकोश अ = यार_बनाओ(1);
    शब्दकोश ब = यार_बनाओ(1);
    यार_अगला32(अ);            // अ को आगे बढ़ाओ (ब को नहीं)
    यार_अगला32(अ);
    जाँच("अ अब output 3 पर", यार_अगला32(अ), 1142320488);
    जाँच("ब अभी भी output 1 पर (अ से अप्रभावित)", यार_अगला32(ब), 951746466);

    परीक्षण_समूह("यार_दशमलव — [0,1) रूपांतरण");
    शब्दकोश रा4 = यार_बनाओ(1);
    दशमलव द4 = यार_दशमलव(रा4);
    जाँच_निकट("पहला दशमलव संदर्भ मान", द4, 0.221595742274076, 0.0000001);
    संख्या गिनती = 0;
    शब्दकोश रादश = यार_बनाओ(99);
    यावत् (गिनती < 500) {
        दशमलव द = यार_दशमलव(रादश);
        जाँच_सत्य("दशमलव >= 0", द >= 0.0);
        जाँच_सत्य("दशमलव < 1", द < 1.0);
        गिनती = गिनती + 1;
    }

    परीक्षण_समूह("यार_परास — सटीक संदर्भ मान + सीमाएँ");
    शब्दकोश रा5 = यार_बनाओ(1);
    जाँच("परास(1,6) कॉल 1", यार_परास(रा5, 1, 6), 1);
    जाँच("परास(1,6) कॉल 2", यार_परास(रा5, 1, 6), 5);
    जाँच("न्यून==उच्च सदा वही मान", यार_परास(यार_बनाओ(1), 7, 7), 7);
    जाँच("उच्च < न्यून सदा न्यून", यार_परास(यार_बनाओ(1), 9, 3), 9);

    संख्या गि2 = 0;
    शब्दकोश राप = यार_बनाओ(7);
    यावत् (गि2 < 500) {
        संख्या मा = यार_परास(राप, 10, 20);
        जाँच_सत्य("परास >= 10", मा >= 10);
        जाँच_सत्य("परास <= 20", मा <= 20);
        गि2 = गि2 + 1;
    }

    परीक्षण_समूह("यार_बूल — सटीक संदर्भ मान (बीज=1 के 6 output की समता)");
    शब्दकोश रा6 = यार_बनाओ(1);
    जाँच("बूल 1 (सम→सत्य)", यार_बूल(रा6), सत्य);
    जाँच("बूल 2 (सम→सत्य)", यार_बूल(रा6), सत्य);
    जाँच("बूल 3 (सम→सत्य)", यार_बूल(रा6), सत्य);
    जाँच("बूल 4 (सम→सत्य)", यार_बूल(रा6), सत्य);
    जाँच("बूल 5 (विषम→असत्य)", यार_बूल(रा6), असत्य);
    जाँच("बूल 6 (विषम→असत्य)", यार_बूल(रा6), असत्य);

    परीक्षण_समूह("यार_तत्व — सूची से यादृच्छिक चुनाव");
    शब्दकोश राखा = यार_बनाओ(3);
    जाँच("रिक्त सूची → शून्यम्", यार_तत्व(राखा, []), शून्यम्);
    संख्या गि3 = 0;
    यावत् (गि3 < 30) {
        जाँच("एक-तत्व सूची सदा वही", यार_तत्व(राखा, ["अकेला"]), "अकेला");
        गि3 = गि3 + 1;
    }
    सूची विकल्प = ["क", "ख", "ग", "घ", "ङ"];
    संख्या गि4 = 0;
    यावत् (गि4 < 200) {
        पाठ चुना = यार_तत्व(राखा, विकल्प);
        जाँच_सत्य("चुना गया तत्व सूची में मौजूद", समाहित(विकल्प, चुना));
        गि4 = गि4 + 1;
    }

    परीक्षण_समूह("यार_फेंटो — क्रमचय (permutation) शुद्धता");
    शब्दकोश राफ = यार_बनाओ(5);
    सूची मूल = [1, 2, 3, 4, 5, 6, 7, 8];
    सूची फेंटी = यार_फेंटो(राफ, मूल);
    जाँच("लंबाई अपरिवर्तित", लंबाई(फेंटी), लंबाई(मूल));
    जाँच("मूल सूची अछूती", मूल, [1, 2, 3, 4, 5, 6, 7, 8]);
    संख्या गि5 = 0;
    संख्या सब_मौजूद = 1;
    यावत् (गि5 < लंबाई(मूल)) {
        यदि (!समाहित(फेंटी, मूल[गि5])) { सब_मौजूद = 0; }
        गि5 = गि5 + 1;
    }
    जाँच_सत्य("फेंटी सूची में मूल के सारे तत्व मौजूद (क्रमचय)", सब_मौजूद == 1);

    जाँच("रिक्त सूची फेंटना → रिक्त", यार_फेंटो(राफ, []), []);
    जाँच("एक-तत्व सूची फेंटना → अपरिवर्तित", यार_फेंटो(राफ, [42]), [42]);

    परीक्षण_समूह("यार_फेंटो — नियतात्मकता (वही बीज = वही फेंट)");
    सूची फेंट_अ = यार_फेंटो(यार_बनाओ(11), [1, 2, 3, 4, 5]);
    सूची फेंट_ब = यार_फेंटो(यार_बनाओ(11), [1, 2, 3, 4, 5]);
    जाँच("दोनों फेंट बराबर", फेंट_अ, फेंट_ब);

    परीक्षण_समूह("गणित.सूत्र के साथ सह-अस्तित्व (global LCG अलग से चलता रहे)");
    यादृच्छिक_बीज(555);
    संख्या ग1 = यादृच्छिक_अगला();
    यार_अगला32(यार_बनाओ(1));   // यार_बनाओ का साइड-इफ़ेक्ट: गणित_बीज बदलेगा
    यादृच्छिक_बीज(555);        // दुबारा सेट करने पर गणित.सूत्र फिर सही चले
    संख्या ग2 = यादृच्छिक_अगला();
    जाँच("गणित.सूत्र दुबारा-बीजन के बाद सामान्य", ग1, ग2);

    परत् परीक्षण_सारांश();
}
