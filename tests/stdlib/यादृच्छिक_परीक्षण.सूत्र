// tests/stdlib/यादृच्छिक_परीक्षण.सूत्र
आयात "पुस्तकालय/यादृच्छिक.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// संदर्भ मान PowerShell में दो स्वतंत्र तरीकों (uint32-cast चेन और मैनुअल
// int64+mask चेन) से क्रॉस-चेक करके निकाले — दोनों का परिणाम बिल्कुल मिला।
// बीज=१ → MINSTD-विस्तार a=१६८०७ b=२८२४७५२४९ c=१६२२६५००७३ d=९८४९४३६५८
// → xorshift128 के पहले ६ output: ९५१७४६४६६, २५६८६७०१९८, ११४२३२०४८८,
//   ३५९५६२७९३२, १०३९९८२४९१, १९२८७८३५२९

कार्य मुख्य() {
    परीक्षण_समूह("यादृ_अगला32 — सटीक संदर्भ मान (बीज=1)");
    शब्दकोश रा1 = यादृ_बनाओ(१);
    जाँच("output 1", यादृ_अगला32(रा1), ९५१७४६४६६);
    जाँच("output 2", यादृ_अगला32(रा1), २५६८६७०१९८);
    जाँच("output 3", यादृ_अगला32(रा1), ११४२३२०४८८);
    जाँच("output 4", यादृ_अगला32(रा1), ३५९५६२७९३२);
    जाँच("output 5", यादृ_अगला32(रा1), १०३९९८२४९१);
    जाँच("output 6", यादृ_अगला32(रा1), १९२८७८३५२९);

    परीक्षण_समूह("नियतात्मकता — वही बीज = वही धारा (ताज़ा राज्य से)");
    शब्दकोश रा2 = यादृ_बनाओ(१);
    जाँच("दुबारा बीज=1 से पहला output वही", यादृ_अगला32(रा2), ९५१७४६४६६);

    परीक्षण_समूह("स्वतंत्र धाराएँ — बीज अलग तो output अलग");
    शब्दकोश रा3 = यादृ_बनाओ(२);
    जाँच("बीज=2 का पहला output बीज=1 से अलग", यादृ_अगला32(रा3) == ९५१७४६४६६, असत्य);
    जाँच("बीज=2 का पहला output संदर्भ मान", यादृ_अगला32(यादृ_बनाओ(२)), १९०३४९२९३२);

    परीक्षण_समूह("स्वतंत्र धाराएँ — दो राज्य एक-दूसरे को प्रभावित नहीं करते");
    शब्दकोश अ = यादृ_बनाओ(१);
    शब्दकोश ब = यादृ_बनाओ(१);
    यादृ_अगला32(अ);            // अ को आगे बढ़ाओ (ब को नहीं)
    यादृ_अगला32(अ);
    जाँच("अ अब output 3 पर", यादृ_अगला32(अ), ११४२३२०४८८);
    जाँच("ब अभी भी output 1 पर (अ से अप्रभावित)", यादृ_अगला32(ब), ९५१७४६४६६);

    परीक्षण_समूह("यादृ_दशमलव — [0,1) रूपांतरण");
    शब्दकोश रा4 = यादृ_बनाओ(१);
    दशमलव द4 = यादृ_दशमलव(रा4);
    जाँच_निकट("पहला दशमलव संदर्भ मान", द4, ०.२२१५९५७४२२७४०७६, ०.००००००१);
    संख्या गिनती = ०;
    शब्दकोश रादश = यादृ_बनाओ(९९);
    यावत् (गिनती < ५००) {
        दशमलव द = यादृ_दशमलव(रादश);
        जाँच_सत्य("दशमलव >= 0", द >= ०.०);
        जाँच_सत्य("दशमलव < 1", द < १.०);
        गिनती = गिनती + १;
    }

    परीक्षण_समूह("यादृ_परास — सटीक संदर्भ मान + सीमाएँ");
    शब्दकोश रा5 = यादृ_बनाओ(१);
    जाँच("परास(1,6) कॉल 1", यादृ_परास(रा5, १, ६), १);
    जाँच("परास(1,6) कॉल 2", यादृ_परास(रा5, १, ६), ५);
    जाँच("न्यून==उच्च सदा वही मान", यादृ_परास(यादृ_बनाओ(१), ७, ७), ७);
    जाँच("उच्च < न्यून सदा न्यून", यादृ_परास(यादृ_बनाओ(१), ९, ३), ९);

    संख्या गि2 = ०;
    शब्दकोश राप = यादृ_बनाओ(७);
    यावत् (गि2 < ५००) {
        संख्या मा = यादृ_परास(राप, १०, २०);
        जाँच_सत्य("परास >= 10", मा >= १०);
        जाँच_सत्य("परास <= 20", मा <= २०);
        गि2 = गि2 + १;
    }

    परीक्षण_समूह("यादृ_बूल — सटीक संदर्भ मान (बीज=1 के 6 output की समता)");
    शब्दकोश रा6 = यादृ_बनाओ(१);
    जाँच("बूल 1 (सम→सत्य)", यादृ_बूल(रा6), सत्य);
    जाँच("बूल 2 (सम→सत्य)", यादृ_बूल(रा6), सत्य);
    जाँच("बूल 3 (सम→सत्य)", यादृ_बूल(रा6), सत्य);
    जाँच("बूल 4 (सम→सत्य)", यादृ_बूल(रा6), सत्य);
    जाँच("बूल 5 (विषम→असत्य)", यादृ_बूल(रा6), असत्य);
    जाँच("बूल 6 (विषम→असत्य)", यादृ_बूल(रा6), असत्य);

    परीक्षण_समूह("यादृ_तत्व — सूची से यादृच्छिक चुनाव");
    शब्दकोश राखा = यादृ_बनाओ(३);
    जाँच("रिक्त सूची → शून्यम्", यादृ_तत्व(राखा, []), शून्यम्);
    संख्या गि3 = ०;
    यावत् (गि3 < ३०) {
        जाँच("एक-तत्व सूची सदा वही", यादृ_तत्व(राखा, ["अकेला"]), "अकेला");
        गि3 = गि3 + १;
    }
    सूची विकल्प = ["क", "ख", "ग", "घ", "ङ"];
    संख्या गि4 = ०;
    यावत् (गि4 < २००) {
        पाठ चुना = यादृ_तत्व(राखा, विकल्प);
        जाँच_सत्य("चुना गया तत्व सूची में मौजूद", समाहित(विकल्प, चुना));
        गि4 = गि4 + १;
    }

    परीक्षण_समूह("यादृ_फेंटो — क्रमचय (permutation) शुद्धता");
    शब्दकोश राफ = यादृ_बनाओ(५);
    सूची मूल = [१, २, ३, ४, ५, ६, ७, ८];
    सूची फेंटी = यादृ_फेंटो(राफ, मूल);
    जाँच("लंबाई अपरिवर्तित", लंबाई(फेंटी), लंबाई(मूल));
    जाँच("मूल सूची अछूती", मूल, [१, २, ३, ४, ५, ६, ७, ८]);
    संख्या गि5 = ०;
    संख्या सब_मौजूद = १;
    यावत् (गि5 < लंबाई(मूल)) {
        यदि (!समाहित(फेंटी, मूल[गि5])) { सब_मौजूद = ०; }
        गि5 = गि5 + १;
    }
    जाँच_सत्य("फेंटी सूची में मूल के सारे तत्व मौजूद (क्रमचय)", सब_मौजूद == १);

    जाँच("रिक्त सूची फेंटना → रिक्त", यादृ_फेंटो(राफ, []), []);
    जाँच("एक-तत्व सूची फेंटना → अपरिवर्तित", यादृ_फेंटो(राफ, [४२]), [४२]);

    परीक्षण_समूह("यादृ_फेंटो — नियतात्मकता (वही बीज = वही फेंट)");
    सूची फेंट_अ = यादृ_फेंटो(यादृ_बनाओ(११), [१, २, ३, ४, ५]);
    सूची फेंट_ब = यादृ_फेंटो(यादृ_बनाओ(११), [१, २, ३, ४, ५]);
    जाँच("दोनों फेंट बराबर", फेंट_अ, फेंट_ब);

    परीक्षण_समूह("गणित.सूत्र के साथ सह-अस्तित्व (global LCG अलग से चलता रहे)");
    यादृच्छिक_बीज(५५५);
    संख्या ग1 = यादृच्छिक_अगला();
    यादृ_अगला32(यादृ_बनाओ(१));   // यादृ_बनाओ का साइड-इफ़ेक्ट: गणित_बीज बदलेगा
    यादृच्छिक_बीज(५५५);        // दुबारा सेट करने पर गणित.सूत्र फिर सही चले
    संख्या ग2 = यादृच्छिक_अगला();
    जाँच("गणित.सूत्र दुबारा-बीजन के बाद सामान्य", ग1, ग2);

    परत् परीक्षण_सारांश();
}
