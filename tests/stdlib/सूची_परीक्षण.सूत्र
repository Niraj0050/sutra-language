आयात "पुस्तकालय/सूची.सूत्र";

कार्य हाँनहीं(मान ब) {
    यदि (ब) { परत् "हाँ"; }
    परत् "नहीं";
}

कार्य मुख्य() {
    सूची अ = [3, 1, 4, 1, 5, 9, 2, 6];

    लिखतु(योग(अ));                    // 31
    लिखतु(गुणनफल([1, 2, 3, 4]));      // 24
    लिखतु(न्यूनतम_का(अ));             // 1
    लिखतु(अधिकतम_का(अ));             // 9
    लिखतु(हाँनहीं(समाहित(अ, 5)));      // हाँ
    लिखतु(हाँनहीं(समाहित(अ, 7)));      // नहीं
    लिखतु(अनुक्रमणिका_की(अ, 4));       // 2
    लिखतु(गणना_की(अ, 1));            // 2

    सूची उ = उलटा([1, 2, 3]);
    लिखतु(उ[0]);                      // 3
    लिखतु(उ[2]);                      // 1

    सूची ए = अद्वितीय([1, 2, 2, 3, 3, 3, 1]);
    लिखतु(लंबाई(ए));                  // 3
    लिखतु(ए[0]); लिखतु(ए[1]); लिखतु(ए[2]);

    सूची स = समतल([[1, 2], [3], [4, 5]]);
    लिखतु(लंबाई(स));                  // 5
    लिखतु(स[3]);                      // 4

    सूची ट = टुकड़े([1, 2, 3, 4, 5], 2);
    लिखतु(लंबाई(ट));                  // 3
    लिखतु(ट[2][0]);                   // 5

    सूची र = श्रेणी(2, 7);
    लिखतु(लंबाई(र));                  // 5
    लिखतु(र[0]); लिखतु(र[4]);

    सूची रच = श्रेणी_चरण(10, 0, -3);
    लिखतु(लंबाई(रच));                 // 4
    लिखतु(रच[3]);                     // 1

    लिखतु(लंबाई(भरो(4, 0)));          // 4
    लिखतु(पहला([9, 8, 7]));           // 9
    लिखतु(पिछला([9, 8, 7]));          // 7

    सूची ल = लो([1, 2, 3, 4, 5], 3);
    लिखतु(लंबाई(ल)); लिखतु(ल[2]);
    सूची छ = छोड़ो([1, 2, 3, 4, 5], 2);
    लिखतु(लंबाई(छ)); लिखतु(छ[0]);

    सूची ख = खंड([10, 20, 30, 40, 50], 1, 4);
    लिखतु(लंबाई(ख)); लिखतु(ख[0]); लिखतु(ख[2]);

    लिखतु(हाँनहीं(सब_सत्य([1, 2, 3])));   // हाँ
    लिखतु(हाँनहीं(सब_सत्य([1, 0, 3])));   // नहीं
    लिखतु(हाँनहीं(कोई_सत्य([0, 0, 1])));  // हाँ
    लिखतु(हाँनहीं(कोई_सत्य([0, 0, 0])));  // नहीं

    सूची यु = युग्म([1, 2, 3], ["अ", "ब"]);
    लिखतु(लंबाई(यु));                 // 2
    लिखतु(यु[1][0]); लिखतु(यु[1][1]);

    लिखतु(लंबाई(सपाट_जोड़([[1, 2], [3], [4, 5]])));  // 5

    सूची क = क्रमबद्ध(अ);
    लिखतु(क[0]); लिखतु(क[7]);         // 1 9
    लिखतु(हाँनहीं(है_क्रमित(क)));      // हाँ
    लिखतु(हाँनहीं(है_क्रमित(अ)));      // नहीं
    सूची कअ = क्रमबद्ध_अवरोही([2, 8, 1, 9]);
    लिखतु(कअ[0]); लिखतु(कअ[3]);       // 9 1

    सूची पस = क्रमबद्ध(["केला", "आम", "सेब", "अंगूर"]);
    लिखतु(पस[0]);                     // अंगूर
    लिखतु(पस[3]);                     // सेब

    लिखतु(द्विआधारी_खोज(क, 5));        // >=0
    लिखतु(द्विआधारी_खोज(क, 7));        // -1

    लिखतु("सूची परीक्षण पूरा");
}
