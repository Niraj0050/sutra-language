आयात "पुस्तकालय/सूची.सूत्र";

कार्य हाँनहीं(मान ब) {
    यदि (ब) { परत् "हाँ"; }
    परत् "नहीं";
}

कार्य मुख्य() {
    सूची अ = [३, १, ४, १, ५, ९, २, ६];

    लिखतु(योग(अ));                    // 31
    लिखतु(गुणनफल([१, २, ३, ४]));      // 24
    लिखतु(न्यूनतम_का(अ));             // 1
    लिखतु(अधिकतम_का(अ));             // 9
    लिखतु(हाँनहीं(समाहित(अ, ५)));      // हाँ
    लिखतु(हाँनहीं(समाहित(अ, ७)));      // नहीं
    लिखतु(अनुक्रमणिका_की(अ, ४));       // 2
    लिखतु(गणना_की(अ, १));            // 2

    सूची उ = उलटा([१, २, ३]);
    लिखतु(उ[०]);                      // 3
    लिखतु(उ[२]);                      // 1

    सूची ए = अद्वितीय([१, २, २, ३, ३, ३, १]);
    लिखतु(लंबाई(ए));                  // 3
    लिखतु(ए[०]); लिखतु(ए[१]); लिखतु(ए[२]);

    सूची स = समतल([[१, २], [३], [४, ५]]);
    लिखतु(लंबाई(स));                  // 5
    लिखतु(स[३]);                      // 4

    सूची ट = टुकड़े([१, २, ३, ४, ५], २);
    लिखतु(लंबाई(ट));                  // 3
    लिखतु(ट[२][०]);                   // 5

    सूची र = श्रेणी(२, ७);
    लिखतु(लंबाई(र));                  // 5
    लिखतु(र[०]); लिखतु(र[४]);

    सूची रच = श्रेणी_चरण(१०, ०, -३);
    लिखतु(लंबाई(रच));                 // 4
    लिखतु(रच[३]);                     // 1

    लिखतु(लंबाई(भरो(४, ०)));          // 4
    लिखतु(पहला([९, ८, ७]));           // 9
    लिखतु(पिछला([९, ८, ७]));          // 7

    सूची ल = लो([१, २, ३, ४, ५], ३);
    लिखतु(लंबाई(ल)); लिखतु(ल[२]);
    सूची छ = छोड़ो([१, २, ३, ४, ५], २);
    लिखतु(लंबाई(छ)); लिखतु(छ[०]);

    सूची ख = खंड([१०, २०, ३०, ४०, ५०], १, ४);
    लिखतु(लंबाई(ख)); लिखतु(ख[०]); लिखतु(ख[२]);

    लिखतु(हाँनहीं(सब_सत्य([१, २, ३])));   // हाँ
    लिखतु(हाँनहीं(सब_सत्य([१, ०, ३])));   // नहीं
    लिखतु(हाँनहीं(कोई_सत्य([०, ०, १])));  // हाँ
    लिखतु(हाँनहीं(कोई_सत्य([०, ०, ०])));  // नहीं

    सूची यु = युग्म([१, २, ३], ["अ", "ब"]);
    लिखतु(लंबाई(यु));                 // 2
    लिखतु(यु[१][०]); लिखतु(यु[१][१]);

    लिखतु(लंबाई(सपाट_जोड़([[१, २], [३], [४, ५]])));  // 5

    सूची क = क्रमबद्ध(अ);
    लिखतु(क[०]); लिखतु(क[७]);         // 1 9
    लिखतु(हाँनहीं(है_क्रमित(क)));      // हाँ
    लिखतु(हाँनहीं(है_क्रमित(अ)));      // नहीं
    सूची कअ = क्रमबद्ध_अवरोही([२, ८, १, ९]);
    लिखतु(कअ[०]); लिखतु(कअ[३]);       // 9 1

    सूची पस = क्रमबद्ध(["केला", "आम", "सेब", "अंगूर"]);
    लिखतु(पस[०]);                     // अंगूर
    लिखतु(पस[३]);                     // सेब

    लिखतु(द्विआधारी_खोज(क, ५));        // >=0
    लिखतु(द्विआधारी_खोज(क, ७));        // -1

    लिखतु("सूची परीक्षण पूरा");
}
