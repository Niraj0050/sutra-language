// tests/stdlib/व्यंजक_परीक्षण.सूत्र
आयात "पुस्तकालय/व्यंजक.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("literal");
    जाँच("सादा मिला", व्यंजक_मिलान("abc", "xxabcyy"), सत्य);
    जाँच("सादा न मिला", व्यंजक_मिलान("abc", "xxabyy"), असत्य);
    जाँच("पूर्ण-मिलान सही", व्यंजक_पूर्ण_मिलान("abc", "abc"), सत्य);
    जाँच("पूर्ण-मिलान गलत (अतिरिक्त)", व्यंजक_पूर्ण_मिलान("abc", "abcd"), असत्य);
    जाँच("पूर्ण-मिलान गलत (कम)", व्यंजक_पूर्ण_मिलान("abc", "ab"), असत्य);

    परीक्षण_समूह("कोई_भी .");
    जाँच("डॉट एक अक्षर", व्यंजक_पूर्ण_मिलान("a.c", "abc"), सत्य);
    जाँच("डॉट अलग अक्षर", व्यंजक_पूर्ण_मिलान("a.c", "azc"), सत्य);
    जाँच("डॉट लंबाई-मेल ज़रूरी", व्यंजक_पूर्ण_मिलान("a.c", "ac"), असत्य);

    परीक्षण_समूह("दोहराव * + ?");
    जाँच("* शून्य बार", व्यंजक_पूर्ण_मिलान("ab*c", "ac"), सत्य);
    जाँच("* कई बार", व्यंजक_पूर्ण_मिलान("ab*c", "abbbbc"), सत्य);
    जाँच("+ शून्य बार असफल", व्यंजक_पूर्ण_मिलान("ab+c", "ac"), असत्य);
    जाँच("+ एक बार", व्यंजक_पूर्ण_मिलान("ab+c", "abc"), सत्य);
    जाँच("+ कई बार", व्यंजक_पूर्ण_मिलान("ab+c", "abbbc"), सत्य);
    जाँच("? शून्य बार", व्यंजक_पूर्ण_मिलान("ab?c", "ac"), सत्य);
    जाँच("? एक बार", व्यंजक_पूर्ण_मिलान("ab?c", "abc"), सत्य);
    जाँच("? दो बार असफल", व्यंजक_पूर्ण_मिलान("ab?c", "abbc"), असत्य);
    जाँच("greedy + backtrack", व्यंजक_पूर्ण_मिलान("a*a", "aaa"), सत्य);
    जाँच("greedy .* पूरा निगले", व्यंजक_पूर्ण_मिलान("a.*c", "axxxc"), सत्य);

    परीक्षण_समूह("वर्ग [...]");
    जाँच("सामान्य वर्ग मिले", व्यंजक_पूर्ण_मिलान("[abc]", "b"), सत्य);
    जाँच("सामान्य वर्ग न मिले", व्यंजक_पूर्ण_मिलान("[abc]", "d"), असत्य);
    जाँच("श्रेणी a-z", व्यंजक_पूर्ण_मिलान("[a-z]+", "hello"), सत्य);
    जाँच("श्रेणी a-z बड़े अक्षर से असफल", व्यंजक_पूर्ण_मिलान("[a-z]+", "Hello"), असत्य);
    जाँच("मिश्रित श्रेणी", व्यंजक_पूर्ण_मिलान("[a-zA-Z0-9]+", "Abc123"), सत्य);
    जाँच("निषेध वर्ग मिले", व्यंजक_पूर्ण_मिलान("[^0-9]+", "abc"), सत्य);
    जाँच("निषेध वर्ग न मिले", व्यंजक_पूर्ण_मिलान("[^0-9]+", "ab3"), असत्य);

    परीक्षण_समूह("एंकर ^ $");
    जाँच("^ आरंभ पर", व्यंजक_मिलान("^abc", "abcxyz"), सत्य);
    जाँच("^ बीच में नहीं मिलता", व्यंजक_मिलान("^abc", "xabcxyz"), असत्य);
    जाँच("$ अंत पर", व्यंजक_मिलान("xyz$", "abcxyz"), सत्य);
    जाँच("$ बीच में नहीं मिलता", व्यंजक_मिलान("xyz$", "abcxyzq"), असत्य);
    जाँच("^...$ पूर्ण-मिलान जैसा", व्यंजक_मिलान("^abc$", "abc"), सत्य);
    जाँच("^...$ आंशिक असफल", व्यंजक_मिलान("^abc$", "abcd"), असत्य);

    परीक्षण_समूह("विकल्प |");
    जाँच("पहला विकल्प", व्यंजक_पूर्ण_मिलान("cat|dog", "cat"), सत्य);
    जाँच("दूसरा विकल्प", व्यंजक_पूर्ण_मिलान("cat|dog", "dog"), सत्य);
    जाँच("कोई विकल्प नहीं", व्यंजक_पूर्ण_मिलान("cat|dog", "cow"), असत्य);
    जाँच("तीन विकल्प — तीसरा", व्यंजक_पूर्ण_मिलान("a|b|c", "c"), सत्य);
    जाँच("समूह में विकल्प", व्यंजक_पूर्ण_मिलान("(cat|dog)s", "dogs"), सत्य);

    परीक्षण_समूह("समूहन ( ) + दोहराव");
    जाँच("समूह-दोहराव शून्य बार", व्यंजक_पूर्ण_मिलान("(ab)*", ""), सत्य);
    जाँच("समूह-दोहराव कई बार", व्यंजक_पूर्ण_मिलान("(ab)*", "ababab"), सत्य);
    जाँच("समूह-दोहराव आंशिक असफल", व्यंजक_पूर्ण_मिलान("(ab)*", "aba"), असत्य);
    जाँच("नेस्टेड समूह", व्यंजक_पूर्ण_मिलान("((a|b)c)+", "acbc"), सत्य);

    परीक्षण_समूह("शॉर्टकट वर्ग \\d \\w \\s");
    जाँच("\\d अंक", व्यंजक_पूर्ण_मिलान("\\d+", "12345"), सत्य);
    जाँच("\\d अक्षर पर असफल", व्यंजक_पूर्ण_मिलान("\\d+", "12a45"), असत्य);
    जाँच("\\w शब्द-अक्षर", व्यंजक_पूर्ण_मिलान("\\w+", "hello_123"), सत्य);
    जाँच("\\w स्पेस पर असफल", व्यंजक_पूर्ण_मिलान("\\w+", "he llo"), असत्य);
    जाँच("\\s रिक्त", व्यंजक_पूर्ण_मिलान("a\\sb", "a b"), सत्य);
    जाँच("\\D गैर-अंक", व्यंजक_पूर्ण_मिलान("\\D+", "abc"), सत्य);
    जाँच("वर्ग में \\d", व्यंजक_पूर्ण_मिलान("[\\d]+", "42"), सत्य);

    परीक्षण_समूह("एस्केप");
    जाँच("बिंदु का literal", व्यंजक_पूर्ण_मिलान("a\\.c", "a.c"), सत्य);
    जाँच("बिंदु literal-escape से गलत मेल न हो", व्यंजक_पूर्ण_मिलान("a\\.c", "axc"), असत्य);
    जाँच("तारा का literal", व्यंजक_पूर्ण_मिलान("a\\*b", "a*b"), सत्य);

    परीक्षण_समूह("व्यंजक_खोजो — विवरण");
    शब्दकोश मि1 = व्यंजक_खोजो("\\d+", "क3म14ल");
    जाँच("मिला", मि1["मिला"], सत्य);
    जाँच("आरंभ", मि1["आरंभ"], १);
    जाँच("अंत", मि1["अंत"], २);
    जाँच("पाठ", मि1["पाठ"], "3");
    शब्दकोश मि2 = व्यंजक_खोजो("xyz", "abc");
    जाँच("न मिला", मि2["मिला"], असत्य);

    परीक्षण_समूह("व्यंजक_सभी_खोजो");
    जाँच("तीन अंक-समूह", व्यंजक_सभी_खोजो("\\d+", "क3म14ल5"), ["3", "14", "5"]);
    जाँच("कोई मिलान नहीं", व्यंजक_सभी_खोजो("\\d+", "अबस"), []);
    जाँच("पूरा पाठ एक मिलान", व्यंजक_सभी_खोजो("[a-z]+", "hello"), ["hello"]);

    परीक्षण_समूह("व्यंजक_बदलो");
    जाँच("स्वर बदलो", व्यंजक_बदलो("[aeiou]", "hello", "*"), "h*ll*");
    जाँच("अंक बदलो", व्यंजक_बदलो("\\d+", "क3म14ल5", "#"), "क#म#ल#");
    जाँच("कोई मिलान न हो तो अपरिवर्तित", व्यंजक_बदलो("xyz", "abc", "!"), "abc");

    परीक्षण_समूह("व्यंजक_विभाजित");
    जाँच("comma-space विभाजन", व्यंजक_विभाजित(",\\s*", "अ, ब,ग,  घ"), ["अ", "ब", "ग", "घ"]);
    जाँच("बिना-मिलान अखंडित", व्यंजक_विभाजित(",", "अकेला"), ["अकेला"]);
    जाँच("बहु-रिक्त विभाजन", व्यंजक_विभाजित("\\s+", "एक   दो तीन"), ["एक", "दो", "तीन"]);

    परीक्षण_समूह("Capturing groups — बुनियादी");
    शब्दकोश ग1 = व्यंजक_खोजो("(\\d+)", "abc123def");
    जाँच("एक समूह — पूरा मिलान", ग1["पाठ"], "123");
    जाँच("एक समूह — समूह सूची", ग1["समूह"], ["123"]);
    जाँच("व्यंजक_समूह सुविधा-फलन", व्यंजक_समूह(ग1, १), "123");

    शब्दकोश ग2 = व्यंजक_खोजो("(\\d+)-(\\d+)", "12-34");
    जाँच("दो समूह — पहला", व्यंजक_समूह(ग2, १), "12");
    जाँच("दो समूह — दूसरा", व्यंजक_समूह(ग2, २), "34");
    जाँच("दो समूह — समूह सूची", ग2["समूह"], ["12", "34"]);

    परीक्षण_समूह("Capturing groups — नेस्टेड (क्रमांक बाएँ-से-दाएँ खुलते कोष्ठक से)");
    शब्दकोश ग3 = व्यंजक_खोजो("((a)(b))", "ab");
    जाँच("बाहरी समूह (1)", व्यंजक_समूह(ग3, १), "ab");
    जाँच("भीतरी समूह (2)", व्यंजक_समूह(ग3, २), "a");
    जाँच("भीतरी समूह (3)", व्यंजक_समूह(ग3, ३), "b");

    परीक्षण_समूह("Capturing groups — विकल्प (alternation) backtracking शुद्धता");
    शब्दकोश ग4 = व्यंजक_खोजो("(a)|(b)", "b");
    जाँच("न-मिली शाखा का समूह शून्यम् (stale नहीं)", व्यंजक_समूह(ग4, १), शून्यम्);
    जाँच("मिली शाखा का समूह सही", व्यंजक_समूह(ग4, २), "b");

    शब्दकोश ग5 = व्यंजक_खोजो("((a)|(b))c", "bc");
    जाँच("नेस्टेड backtracking — बाहरी समूह", व्यंजक_समूह(ग5, १), "b");
    जाँच("नेस्टेड backtracking — न-मिली भीतरी शाखा शून्यम्", व्यंजक_समूह(ग5, २), शून्यम्);
    जाँच("नेस्टेड backtracking — मिली भीतरी शाखा", व्यंजक_समूह(ग5, ३), "b");

    परीक्षण_समूह("Capturing groups — दोहराव (अंतिम पुनरावृत्ति जीतती)");
    शब्दकोश ग6 = व्यंजक_खोजो("(\\d)+", "123");
    जाँच("दोहराया एकल-अक्षर समूह — अंतिम मान", व्यंजक_समूह(ग6, १), "3");
    शब्दकोश ग7 = व्यंजक_खोजो("(ab)+", "ababab");
    जाँच("दोहराया बहु-अक्षर समूह — अंतिम मान", व्यंजक_समूह(ग7, १), "ab");
    जाँच("दोहराया समूह — पूरा मिलान अप्रभावित", ग7["पाठ"], "ababab");

    परीक्षण_समूह("Capturing groups — वैकल्पिक (?) समूह जो मिलान में शामिल नहीं होता");
    शब्दकोश ग8 = व्यंजक_खोजो("(a)?b", "b");
    जाँच("वैकल्पिक समूह न मिला → शून्यम्", व्यंजक_समूह(ग8, १), शून्यम्);
    शब्दकोश ग9 = व्यंजक_खोजो("(a)?b", "ab");
    जाँच("वैकल्पिक समूह मिला → पाठ", व्यंजक_समूह(ग9, १), "a");

    परीक्षण_समूह("न-पकड़ने-वाला समूह (?:...)");
    शब्दकोश ग10 = व्यंजक_खोजो("(?:abc)+", "abcabcabc");
    जाँच("(?:...)+ पूरा मिलान", ग10["पाठ"], "abcabcabc");
    जाँच("(?:...) कोई समूह नहीं पकड़ता", ग10["समूह"], []);
    शब्दकोश ग11 = व्यंजक_खोजो("(?:a)(b)", "ab");
    जाँच("न-पकड़ने-वाला समूह क्रमांक नहीं लेता", व्यंजक_समूह(ग11, १), "b");

    परीक्षण_समूह("व्यंजक_समूह — सीमा-बाहर / अमान्य क्रमांक");
    जाँच("क्रमांक 0 → शून्यम्", व्यंजक_समूह(ग1, ०), शून्यम्);
    जाँच("क्रमांक सीमा-बाहर → शून्यम्", व्यंजक_समूह(ग1, ५), शून्यम्);

    परीक्षण_समूह("व्यंजक_सभी_खोजो_विस्तृत");
    सूची विस्तृत = व्यंजक_सभी_खोजो_विस्तृत("(\\w)=(\\d)", "a=1,b=2,c=3");
    जाँच("तीन मिलान", लंबाई(विस्तृत), ३);
    जाँच("पहला मिलान — पूरा पाठ", विस्तृत[०]["पाठ"], "a=1");
    जाँच("पहला मिलान — समूह 1", व्यंजक_समूह(विस्तृत[०], १), "a");
    जाँच("पहला मिलान — समूह 2", व्यंजक_समूह(विस्तृत[०], २), "1");
    जाँच("तीसरा मिलान — समूह 1", व्यंजक_समूह(विस्तृत[२], १), "c");
    जाँच("तीसरा मिलान — समूह 2", व्यंजक_समूह(विस्तृत[२], २), "3");

    परीक्षण_समूह("पीछे-संगत (backward compat) — व्यंजक_सभी_खोजो capture से अप्रभावित");
    जाँच("capturing pattern फिर भी सिर्फ़ पाठ लौटाता",
        व्यंजक_सभी_खोजो("(\\d+)", "12 34 56"), ["12", "34", "56"]);

    परीक्षण_समूह("{n} सटीक दोहराव");
    जाँच("a{3} तीन बार सही", व्यंजक_पूर्ण_मिलान("a{3}", "aaa"), सत्य);
    जाँच("a{3} दो बार असफल", व्यंजक_पूर्ण_मिलान("a{3}", "aa"), असत्य);
    जाँच("a{3} चार बार पूर्ण-मिलान असफल", व्यंजक_पूर्ण_मिलान("a{3}", "aaaa"), असत्य);
    जाँच("a{3} खोज चार में से पहले तीन", व्यंजक_खोजो("a{3}", "aaaa")["पाठ"], "aaa");
    जाँच("a{0} रिक्त पर सही", व्यंजक_पूर्ण_मिलान("a{0}", ""), सत्य);

    परीक्षण_समूह("{n,m} सीमा-सहित दोहराव — greedy");
    जाँच("a{2,4} एक बार असफल", व्यंजक_मिलान("^a{2,4}$", "a"), असत्य);
    जाँच("a{2,4} दो बार सफल", व्यंजक_मिलान("^a{2,4}$", "aa"), सत्य);
    जाँच("a{2,4} तीन बार सफल", व्यंजक_मिलान("^a{2,4}$", "aaa"), सत्य);
    जाँच("a{2,4} चार बार सफल", व्यंजक_मिलान("^a{2,4}$", "aaaa"), सत्य);
    जाँच("a{2,4} पाँच बार पूर्ण-मिलान असफल", व्यंजक_मिलान("^a{2,4}$", "aaaaa"), असत्य);
    जाँच("a{2,4} greedy — पाँच में से चार पकड़ता",
        व्यंजक_खोजो("a{2,4}", "aaaaa")["पाठ"], "aaaa");

    परीक्षण_समूह("{n,} न्यूनतम-सहित असीमित दोहराव");
    जाँच("a{2,} एक बार असफल", व्यंजक_पूर्ण_मिलान("a{2,}", "a"), असत्य);
    जाँच("a{2,} दो बार सफल", व्यंजक_पूर्ण_मिलान("a{2,}", "aa"), सत्य);
    जाँच("a{2,} छह बार सफल", व्यंजक_पूर्ण_मिलान("a{2,}", "aaaaaa"), सत्य);

    परीक्षण_समूह("{n,m} — शून्य-मिलान सीमा (0 शामिल)");
    जाँच("a{0,2}b शून्य a सहित", व्यंजक_पूर्ण_मिलान("a{0,2}b", "b"), सत्य);
    जाँच("a{0,2}b दो a सहित", व्यंजक_पूर्ण_मिलान("a{0,2}b", "aab"), सत्य);
    जाँच("a{0,2}b तीन a से असफल", व्यंजक_पूर्ण_मिलान("a{0,2}b", "aaab"), असत्य);

    परीक्षण_समूह("{n,m} — व्यावहारिक पैटर्न + capturing groups के साथ");
    जाँच("\\d{3}-\\d{4} फ़ोन-जैसा पैटर्न", व्यंजक_मिलान("\\d{3}-\\d{4}", "फ़ोन: 123-4567 है"), सत्य);
    शब्दकोश ग12 = व्यंजक_खोजो("(\\d{2,4})", "क123म");
    जाँच("{n,m} + capture साथ में", व्यंजक_समूह(ग12, १), "123");

    परीक्षण_समूह("{n,m} — त्रुटि-मामले");
    संख्या त्रुटि_गिनती = ०;
    प्रयत्न {
        व्यंजक_संकलन("a{3,2}");
    } पकड़ो (त्रु1) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        व्यंजक_संकलन("a{");
    } पकड़ो (त्रु2) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    प्रयत्न {
        व्यंजक_संकलन("a{x}");
    } पकड़ो (त्रु3) {
        त्रुटि_गिनती = त्रुटि_गिनती + १;
    }
    जाँच("तीनों अमान्य {n,m} पैटर्न त्रुटि देते", त्रुटि_गिनती, ३);

    परीक्षण_समूह("\\1-\\9 backreference — पैटर्न के भीतर");
    जाँच("दोहराया शब्द मिलता", व्यंजक_पूर्ण_मिलान("(\\w+)\\s+\\1", "hello hello"), सत्य);
    जाँच("अलग शब्द नहीं मिलता", व्यंजक_पूर्ण_मिलान("(\\w+)\\s+\\1", "hello world"), असत्य);
    जाँच("दोहरा अंक मिलता", व्यंजक_पूर्ण_मिलान("(\\d)\\1", "88"), सत्य);
    जाँच("अलग अंक नहीं मिलता", व्यंजक_पूर्ण_मिलान("(\\d)\\1", "89"), असत्य);
    जाँच("कई backreference (palindrome-शैली) मिलते",
        व्यंजक_पूर्ण_मिलान("(\\w)(\\w)\\2\\1", "abba"), सत्य);
    जाँच("कई backreference बेमेल असफल",
        व्यंजक_पूर्ण_मिलान("(\\w)(\\w)\\2\\1", "abcd"), असत्य);
    जाँच("दोहराए समूह पर backreference — अंतिम पुनरावृत्ति इस्तेमाल होती",
        व्यंजक_पूर्ण_मिलान("(ab)+\\1", "ababab"), सत्य);
    जाँच("न-मिला समूह पर backreference असफल होता (शून्य-चौड़ाई नहीं)",
        व्यंजक_मिलान("^((a)|b)\\2$", "b"), असत्य);

    परीक्षण_समूह("\\N backreference — संकलन-समय सत्यापन");
    संख्या पीछे_त्रुटि_गिनती = ०;
    प्रयत्न {
        व्यंजक_संकलन("(a)\\5");
    } पकड़ो (पीछे_त्रु) {
        पीछे_त्रुटि_गिनती = पीछे_त्रुटि_गिनती + १;
    }
    जाँच("अघोषित समूह का \\N त्रुटि देता", पीछे_त्रुटि_गिनती, १);

    परीक्षण_समूह("$N/$0/$$ — व्यंजक_बदलो प्रतिस्थापन में");
    जाँच("$1/$2 से अदला-बदली",
        व्यंजक_बदलो("(\\w+)@(\\w+)", "user@host", "$2@$1"), "host@user");
    जाँच("$0 पूरा मिलान लपेटता",
        व्यंजक_बदलो("\\d+", "abc123def", "[$0]"), "abc[123]def");
    जाँच("$$ literal डॉलर बनता", व्यंजक_बदलो("x", "x", "$$5"), "$5");
    जाँच("बिना $ वाला प्रतिस्थापन पहले जैसा अपरिवर्तित (backward compat)",
        व्यंजक_बदलो("[aeiou]", "hello", "*"), "h*ll*");

    परीक्षण_समूह("(?=...)/(?!...) — आगे-दृष्टि (lookahead)");
    जाँच("सकारात्मक lookahead — संख्या पकड़ता, प्रत्यय नहीं",
        व्यंजक_खोजो("\\d+(?=px)", "10px")["पाठ"], "10");
    जाँच("सकारात्मक lookahead असफल जब प्रत्यय न हो",
        व्यंजक_मिलान("^\\d+(?=px)$", "10em"), असत्य);
    जाँच("नकारात्मक lookahead — प्रत्यय न होने पर मिलता",
        व्यंजक_खोजो("\\d+(?!px)", "10em")["पाठ"], "10");
    जाँच("नकारात्मक lookahead असफल जब प्रत्यय हो",
        व्यंजक_मिलान("^\\d+(?!px)$", "10px"), असत्य);
    जाँच("lookahead के भीतर capture बाहर उजागर होता",
        व्यंजक_समूह(व्यंजक_खोजो("(?=(\\d+))\\d\\d", "12345"), १), "12345");
    जाँच("lookahead ख़ुद पाठ उपभोग नहीं करता (पूरा मिलान छोटा रहता)",
        व्यंजक_खोजो("(?=(\\d+))\\d\\d", "12345")["पाठ"], "12");

    परीक्षण_समूह("(?<=...)/(?<!...) — पीछे-दृष्टि (lookbehind, स्थिर-लंबाई)");
    जाँच("सकारात्मक lookbehind — उपसर्ग के बाद पकड़ता",
        व्यंजक_खोजो("(?<=\\$)\\d+", "$100")["पाठ"], "100");
    जाँच("सकारात्मक lookbehind असफल जब उपसर्ग न हो",
        व्यंजक_मिलान("(?<=\\$)\\d+", "100"), असत्य);
    जाँच("नकारात्मक lookbehind — उपसर्ग न होने पर मिलता",
        व्यंजक_खोजो("(?<!\\$)\\d+", "x100")["पाठ"], "100");
    जाँच("बहु-अक्षर स्थिर-लंबाई lookbehind सफल", व्यंजक_मिलान("(?<=abc)def", "abcdef"), सत्य);
    जाँच("बहु-अक्षर स्थिर-लंबाई lookbehind असफल", व्यंजक_मिलान("(?<=abc)def", "xyzdef"), असत्य);

    परीक्षण_समूह("कई lookahead एक साथ — पासवर्ड-जैसा सत्यापन");
    जाँच("बड़ा+अंक+8-लंबाई सभी शर्तें पूरी",
        व्यंजक_मिलान("^(?=.*[A-Z])(?=.*\\d).{8,}$", "Abc12345"), सत्य);
    जाँच("कोई बड़ा अक्षर/अंक नहीं — असफल",
        व्यंजक_मिलान("^(?=.*[A-Z])(?=.*\\d).{8,}$", "abcdefgh"), असत्य);

    परीक्षण_समूह("lookbehind — संकलन-समय सत्यापन");
    संख्या दृष्टि_त्रुटि_गिनती = ०;
    प्रयत्न {
        व्यंजक_संकलन("(?<=a+)b");
    } पकड़ो (दृ_त्रु1) {
        दृष्टि_त्रुटि_गिनती = दृष्टि_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        व्यंजक_संकलन("(?<=(a)\\1)");
    } पकड़ो (दृ_त्रु2) {
        दृष्टि_त्रुटि_गिनती = दृष्टि_त्रुटि_गिनती + १;
    }
    जाँच("चर-लंबाई और backreference-भीतर lookbehind दोनों त्रुटि देते",
        दृष्टि_त्रुटि_गिनती, २);

    परीक्षण_समूह("नामित capturing groups (?<नाम>...)");
    शब्दकोश ना_मि1 = व्यंजक_खोजो("(?<वर्ष>\\d{4})-(?<माह>\\d{2})-(?<दिन>\\d{2})", "तिथि: 2026-09-14 है");
    जाँच("मिला", ना_मि1["मिला"], सत्य);
    जाँच("वर्ष नाम से", व्यंजक_समूह_नाम(ना_मि1, "वर्ष"), "2026");
    जाँच("माह नाम से", व्यंजक_समूह_नाम(ना_मि1, "माह"), "09");
    जाँच("दिन नाम से", व्यंजक_समूह_नाम(ना_मि1, "दिन"), "14");
    जाँच("वर्ष क्रमांक से भी वही (नाम सिर्फ़ सुविधा, क्रमांक बना रहता)",
        व्यंजक_समूह(ना_मि1, 1), "2026");
    जाँच("अज्ञात नाम -> शून्यम् (त्रुटि नहीं)", व्यंजक_समूह_नाम(ना_मि1, "कुछ_और"), शून्यम्);

    जाँच("मिश्रित नामित+अनामित — क्रमांकन बाएँ-से-दाएँ अपरिवर्तित",
        व्यंजक_समूह(व्यंजक_खोजो("(\\w+)@(?<डोमेन>\\w+)\\.com", "ram@example.com"), 1), "ram");
    जाँच("वही मिश्रित पैटर्न में नामित समूह क्रमांक 2 से भी सुलभ",
        व्यंजक_समूह(व्यंजक_खोजो("(\\w+)@(?<डोमेन>\\w+)\\.com", "ram@example.com"), 2), "example");

    शब्दकोश ना_मि3 = व्यंजक_खोजो("(?=(?<अ>\\d+))\\d+", "क123ख");
    जाँच("lookahead के भीतर नामित समूह भी बाहर उजागर होता (अनामित जैसा ही)",
        व्यंजक_समूह_नाम(ना_मि3, "अ"), "123");

    शब्दकोश ना_मि4 = व्यंजक_खोजो("a(?<ख>)b", "ab");
    जाँच("(?<नाम>) खाली-शरीर भी वैध — खाली-पाठ कैप्चर", व्यंजक_समूह_नाम(ना_मि4, "ख"), "");

    परीक्षण_समूह("नामित backreference \\k<नाम>");
    जाँच("दोहराया शब्द मिलता", व्यंजक_मिलान("(?<श>\\w+)\\s+\\k<श>", "hello hello"), सत्य);
    जाँच("अलग शब्द नहीं मिलता", व्यंजक_मिलान("(?<श>\\w+)\\s+\\k<श>", "hello world"), असत्य);

    परीक्षण_समूह("नामित समूह — त्रुटि-मामले");
    संख्या ना_त्रुटि_गिनती = ०;
    प्रयत्न {
        व्यंजक_संकलन("(?<द>a)(?<द>b)");
    } पकड़ो (ना_त्रु1) {
        ना_त्रुटि_गिनती = ना_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        व्यंजक_संकलन("\\k<अघोषित>");
    } पकड़ो (ना_त्रु2) {
        ना_त्रुटि_गिनती = ना_त्रुटि_गिनती + १;
    }
    प्रयत्न {
        व्यंजक_संकलन("(?<>a)");
    } पकड़ो (ना_त्रु3) {
        ना_त्रुटि_गिनती = ना_त्रुटि_गिनती + १;
    }
    जाँच("दोहराया नाम + अघोषित \\k<नाम> + रिक्त नाम, तीनों त्रुटि देते",
        ना_त्रुटि_गिनती, ३);

    परत् परीक्षण_सारांश();
}
