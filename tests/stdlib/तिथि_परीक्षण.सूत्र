// tests/stdlib/तिथि_परीक्षण.सूत्र
आयात "पुस्तकालय/तिथि.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("युग-बिंदु + ज्ञात तिथियाँ");
    जाँच("युग = 0", समय_बनाओ(1970, 1, 1, 0, 0, 0), 0);
    जाँच("2000-01-01 = 946684800", तिथि_बनाओ(2000, 1, 1), 946684800);
    जाँच("2000-01-01 शनिवार (=6)", सप्ताह_दिन(946684800), 6);
    जाँच("1970-01-01 गुरुवार (=4)", सप्ताह_दिन(0), 4);

    परीक्षण_समूह("अपघटन round-trip");
    संख्या प = समय_बनाओ(2026, 9, 10, 14, 30, 45);
    शब्दकोश स = तिथि_अंश(प);
    जाँच("वर्ष",   स["वर्ष"],   2026);
    जाँच("माह",    स["माह"],    9);
    जाँच("दिन",    स["दिन"],    10);
    जाँच("घंटा",   स["घंटा"],   14);
    जाँच("मिनट",   स["मिनट"],   30);
    जाँच("सेकंड",  स["सेकंड"],  45);
    जाँच("वर्ष_का", वर्ष_का(प), 2026);
    जाँच("दिन_का",  दिन_का(प),  10);
    जाँच("घंटा_का", घंटा_का(प), 14);

    संख्या पुराना = समय_बनाओ(1953, 3, 1, 6, 0, 0);
    शब्दकोश पुस = तिथि_अंश(पुराना);
    जाँच("युग-पूर्व वर्ष",  पुस["वर्ष"], 1953);
    जाँच("युग-पूर्व माह",   पुस["माह"],  3);
    जाँच("युग-पूर्व दिन",   पुस["दिन"],  1);
    जाँच("युग-पूर्व घंटा",  पुस["घंटा"], 6);

    परीक्षण_समूह("लीप वर्ष / माह-दिन");
    जाँच_सत्य("2000 लीप",  लीप_वर्ष(2000));
    जाँच_असत्य("1900 लीप", लीप_वर्ष(1900));
    जाँच_सत्य("2024 लीप",  लीप_वर्ष(2024));
    जाँच_असत्य("2026 लीप", लीप_वर्ष(2026));
    जाँच("फ़र 2024 = 29", माह_के_दिन(2024, 2), 29);
    जाँच("फ़र 2023 = 28", माह_के_दिन(2023, 2), 28);
    जाँच("अप्रैल = 30",   माह_के_दिन(2026, 4), 30);
    जाँच("दिसंबर = 31",   माह_के_दिन(2026, 12), 31);
    जाँच("29 फ़र 2024 वैध", वर्ष_का(समय_बनाओ(2024, 2, 29, 0, 0, 0)), 2024);

    परीक्षण_समूह("वर्ष-दिन");
    जाँच("1 जन = दिन 1",   वर्ष_दिन(तिथि_बनाओ(2026, 1, 1)), 1);
    जाँच("31 दिस = दिन 365 (2026)", वर्ष_दिन(तिथि_बनाओ(2026, 12, 31)), 365);
    जाँच("31 दिस = दिन 366 (2024)", वर्ष_दिन(तिथि_बनाओ(2024, 12, 31)), 366);
    जाँच("1 मार्च 2024 = दिन 61", वर्ष_दिन(तिथि_बनाओ(2024, 3, 1)), 61);

    परीक्षण_समूह("अंकगणित — सरल");
    जाँच("जोड़_दिन 1", दिन_का(जोड़_दिन(प, 1)), 11);
    जाँच("जोड़_दिन माह-पार", माह_का(जोड़_दिन(तिथि_बनाओ(2026, 1, 31), 1)), 2);
    जाँच("जोड़_दिन माह-पार दिन", दिन_का(जोड़_दिन(तिथि_बनाओ(2026, 1, 31), 1)), 1);
    जाँच("जोड़_घंटा 24 = अगला दिन", दिन_का(जोड़_घंटा(प, 24)), 11);
    जाँच("जोड़_सप्ताह 1", दिन_का(जोड़_सप्ताह(तिथि_बनाओ(2026, 9, 3), 1)), 10);

    परीक्षण_समूह("अंकगणित — कैलेंडर-सजग माह/वर्ष");
    // 31 जन + 1 माह → 28 फ़र (clamp)
    संख्या जनवरी_अंत = तिथि_बनाओ(2026, 1, 31);
    जाँच("जन31 +1माह → माह 2", माह_का(जोड़_माह(जनवरी_अंत, 1)), 2);
    जाँच("जन31 +1माह → दिन 28", दिन_का(जोड़_माह(जनवरी_अंत, 1)), 28);
    // लीप वर्ष में 29
    जाँच("जन31 2024 +1माह → दिन 29", दिन_का(जोड़_माह(तिथि_बनाओ(2024, 1, 31), 1)), 29);
    // माह wrap
    जाँच("नव +3माह → फ़र अगले वर्ष", वर्ष_का(जोड़_माह(तिथि_बनाओ(2025, 11, 15), 3)), 2026);
    जाँच("नव +3माह → माह 2", माह_का(जोड़_माह(तिथि_बनाओ(2025, 11, 15), 3)), 2);
    // ऋणात्मक
    जाँच("मार्च -3माह → दिसंबर पिछले वर्ष", माह_का(जोड़_माह(तिथि_बनाओ(2026, 3, 15), 0 - 3)), 12);
    जाँच("मार्च -3माह → वर्ष 2025", वर्ष_का(जोड़_माह(तिथि_बनाओ(2026, 3, 15), 0 - 3)), 2025);
    जाँच("जोड़_वर्ष 1", वर्ष_का(जोड़_वर्ष(प, 1)), 2027);
    // 29 फ़र 2024 + 1 वर्ष → 28 फ़र 2025 (clamp)
    जाँच("29फ़र2024 +1वर्ष → दिन 28", दिन_का(जोड़_वर्ष(तिथि_बनाओ(2024, 2, 29), 1)), 28);

    परीक्षण_समूह("अंतर / तुलना");
    जाँच("अंतर_दिन", अंतर_दिन(तिथि_बनाओ(2026, 9, 10), तिथि_बनाओ(2026, 9, 20)), 10);
    जाँच("अंतर_दिन माह-पार", अंतर_दिन(तिथि_बनाओ(2026, 1, 15), तिथि_बनाओ(2026, 2, 15)), 31);
    जाँच("अंतर_घंटा", अंतर_घंटा(प, जोड़_घंटा(प, 5)), 5);
    जाँच("अंतर_सेकंड", अंतर_सेकंड(प, प + 90), 90);
    जाँच_सत्य("तिथि_पूर्व", तिथि_पूर्व(तिथि_बनाओ(2026, 1, 1), तिथि_बनाओ(2026, 6, 1)));
    जाँच_सत्य("तिथि_बाद",  तिथि_बाद(तिथि_बनाओ(2026, 6, 1), तिथि_बनाओ(2026, 1, 1)));
    जाँच_सत्य("एक_दिन", एक_दिन(समय_बनाओ(2026, 9, 10, 1, 0, 0), समय_बनाओ(2026, 9, 10, 23, 0, 0)));
    जाँच_असत्य("एक_दिन नहीं", एक_दिन(समय_बनाओ(2026, 9, 10, 23, 0, 0), समय_बनाओ(2026, 9, 11, 1, 0, 0)));
    जाँच("दिन_आरंभ", सेकंड_का(दिन_आरंभ(प)) + मिनट_का(दिन_आरंभ(प)) + घंटा_का(दिन_आरंभ(प)), 0);

    परीक्षण_समूह("नाम");
    जाँच("सितंबर", माह_नाम(9), "सितंबर");
    जाँच("Sep", माह_संक्षेप(9), "Sep");
    जाँच("गुरुवार", सप्ताह_दिन_नाम(प), "गुरुवार");   // 2026-09-10 गुरुवार
    जाँच("Thu", सप्ताह_दिन_संक्षेप(प), "Thu");

    परीक्षण_समूह("प्रारूपण");
    जाँच("YYYY-MM-DD", तिथि_प्रारूप(प, "YYYY-MM-DD"), "2026-09-10");
    जाँच("DD/MM/YYYY", तिथि_प्रारूप(प, "DD/MM/YYYY"), "10/09/2026");
    जाँच("HH:mm:ss", तिथि_प्रारूप(प, "HH:mm:ss"), "14:30:45");
    जाँच("D M YY", तिथि_प्रारूप(तिथि_बनाओ(2026, 1, 5), "D/M/YY"), "5/1/26");
    जाँच("MMMM D, YYYY", तिथि_प्रारूप(प, "MMMM D, YYYY"), "सितंबर 10, 2026");
    जाँच("ddd, DD MMM YYYY", तिथि_प्रारूप(प, "ddd, DD MMM YYYY"), "Thu, 10 Sep 2026");
    जाँच("साहित्य अक्षर", तिथि_प्रारूप(प, "वर्ष YYYY"), "वर्ष 2026");
    जाँच("आईएसओ", आईएसओ(प), "2026-09-10T14:30:45Z");
    जाँच("आईएसओ_तिथि", आईएसओ_तिथि(प), "2026-09-10");

    परीक्षण_समूह("पार्सिंग + round-trip");
    जाँच("पार्स तारीख", तिथि_पार्स("2026-09-10"), तिथि_बनाओ(2026, 9, 10));
    जाँच("पार्स T-समय", तिथि_पार्स("2026-09-10T14:30:45"), प);
    जाँच("पार्स space-समय", तिथि_पार्स("2026-09-10 14:30"), समय_बनाओ(2026, 9, 10, 14, 30, 0));
    जाँच("पार्स Z", तिथि_पार्स("2026-09-10T14:30:45Z"), प);
    जाँच("पार्स गलत आकार", तिथि_पार्स("10/09/2026"), 0 - 1);
    जाँच("पार्स गलत माह", तिथि_पार्स("2026-13-01"), 0 - 1);
    जाँच("पार्स गलत दिन", तिथि_पार्स("2026-02-30"), 0 - 1);
    // full round-trip: पल → आईएसओ → पार्स → पल
    जाँच("round-trip आईएसओ", तिथि_पार्स(आईएसओ(प)), प);

    परत् परीक्षण_सारांश();
}
