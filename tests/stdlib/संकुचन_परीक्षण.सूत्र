// tests/stdlib/संकुचन_परीक्षण.सूत्र
आयात "पुस्तकालय/संकुचन.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य दोहराओ_अक्षर(पाठ अ, संख्या गिनती) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = फल + अ;
        इ = इ + १;
    }
    परत् फल;
}

कार्य गोल_यात्रा_सही(पाठ स्रोत) {
    सूची क = संकुचन_पाठ_संपीड़ित(स्रोत);
    पाठ वापस = संकुचन_पाठ_विसंपीड़ित(क);
    परत् वापस == स्रोत;
}

कार्य मुख्य() {
    परीक्षण_समूह("गोल-यात्रा (round-trip) — बुनियादी");
    जाँच("रिक्त पाठ", गोल_यात्रा_सही(""), सत्य);
    जाँच("एक अक्षर", गोल_यात्रा_सही("क"), सत्य);
    जाँच("छोटा शब्द", गोल_यात्रा_सही("नमस्ते"), सत्य);
    जाँच("सारे-अलग बाइट (कोई मैच संभव नहीं)", गोल_यात्रा_सही("abcdefghij"), सत्य);

    परीक्षण_समूह("गोल-यात्रा — दोहराव");
    जाँच("एक अक्षर दोहराया", गोल_यात्रा_सही(दोहराओ_अक्षर("अ", ५०)), सत्य);
    जाँच("शब्द दोहराया", गोल_यात्रा_सही(दोहराओ_अक्षर("सूत्र ", २०)), सत्य);
    जाँच("overlapping self-reference (aaaa-शैली)", गोल_यात्रा_सही("xaaaaaaaaaaaaaaaaaaay"), सत्य);
    जाँच("abcabc-शैली", गोल_यात्रा_सही(दोहराओ_अक्षर("abc", १५)), सत्य);

    परीक्षण_समूह("गोल-यात्रा — सीमाएँ");
    जाँच("खिड़की-आकार से बड़ा (4096+)", गोल_यात्रा_सही(दोहराओ_अक्षर("बड़ा-पैटर्न ", १५०)), सत्य);
    जाँच("मिश्रित दोहराव+अनोखा", गोल_यात्रा_सही(दोहराओ_अक्षर("क", ३०) + "अनोखा-हिस्सा" + दोहराओ_अक्षर("ख", ३०)), सत्य);

    परीक्षण_समूह("असली संकुचन (compression वास्तव में होता है)");
    सूची क1 = संकुचन_पाठ_संपीड़ित(दोहराओ_अक्षर("अ", १००));
    जाँच("100× दोहराव काफ़ी छोटा होता", लंबाई(क1) < ५०, सत्य);
    सूची क2 = संकुचन_पाठ_संपीड़ित(दोहराओ_अक्षर("सूत्र ", ५०));
    जाँच("दोहराया शब्द भी सिकुड़ता", लंबाई(क2) < लंबाई(सं_यूटीएफ8_एन्कोड(दोहराओ_अक्षर("सूत्र ", ५०))), सत्य);

    परीक्षण_समूह("कच्चे बाइट्स (पाठ के बिना)");
    सूची मूल_बाइट = [१०, २०, २०, २०, २०, २०, २०, ३०, ४०];
    सूची सं_बाइट = संकुचन_संपीड़ित(मूल_बाइट);
    सूची वा_बाइट = संकुचन_विसंपीड़ित(सं_बाइट);
    जाँच("बाइट-स्तर गोल-यात्रा", वा_बाइट, मूल_बाइट);

    परत् परीक्षण_सारांश();
}
