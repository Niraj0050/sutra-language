आयात "पुस्तकालय/क्रमचय.सूत्र";
आयात "पुस्तकालय/ढेर_प्राथमिकता.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // क्रमचय
    सूची प = क्रमचय([1, 2, 3]);
    लिखतु(लंबाई(प));                  // 6
    लिखतु(प[0][0]); लिखतु(प[0][1]); लिखतु(प[0][2]); // 1 2 3

    सूची पर = क्रमचय_र([1, 2, 3], 2);
    लिखतु(लंबाई(पर));                 // 6
    लिखतु(लंबाई(पर[0]));              // 2

    // संचय
    सूची स = संचय([1, 2, 3, 4], 2);
    लिखतु(लंबाई(स));                  // 6
    लिखतु(संचय([1, 2, 3], 3)[0][2]);  // 3
    लिखतु(लंबाई(संचय([1, 2], 5)));    // 0

    // घात-समुच्चय
    सूची घ = घात_समुच्चय([1, 2, 3]);
    लिखतु(लंबाई(घ));                  // 8
    लिखतु(लंबाई(घ[0]));               // 0  (रिक्त उपसमुच्चय)

    // कार्तीय गुणन
    सूची क = कार्तीय_गुणन([[1, 2], [3, 4]]);
    लिखतु(लंबाई(क));                  // 4
    लिखतु(क[0][0]); लिखतु(क[0][1]);   // 1 3
    लिखतु(क[3][0]); लिखतु(क[3][1]);   // 2 4

    // विंडो / लगातार जोड़े
    सूची व = विंडो([1, 2, 3, 4, 5], 3);
    लिखतु(लंबाई(व));                  // 3
    लिखतु(व[2][0]); लिखतु(व[2][2]);   // 3 5
    सूची लज = लगातार_जोड़े([10, 20, 30]);
    लिखतु(लंबाई(लज));                 // 2
    लिखतु(लज[1][0]); लिखतु(लज[1][1]); // 20 30

    // गिनती सहित
    सूची ग = गिनती_सहित(["अ", "ब", "स"]);
    लिखतु(ग[1][0]); लिखतु(ग[1][1]);   // 1 ब

    // ===== ढेर_प्राथमिकता =====
    मान पप = नवीन ढेर_प्राथमिकता();
    पप.डालो(5); पप.डालो(1); पप.डालो(9); पप.डालो(3); पप.डालो(7);
    लिखतु(पप.शिखर());               // 1
    लिखतु(पप.आकार());               // 5
    लिखतु(पप.निकालो());             // 1
    लिखतु(पप.निकालो());             // 3
    लिखतु(पप.निकालो());             // 5
    लिखतु(पप.आकार());               // 2
    लिखतु(हन(पप.खाली_है()));         // नहीं

    // ढेर-सॉर्ट
    सूची हक = ढेर_क्रम([4, 1, 8, 2, 9, 3, 7]);
    लिखतु(हक[0]); लिखतु(हक[6]);       // 1 9
    लिखतु(लंबाई(हक));                // 7

    // पाठ पर भी (सामान्य_* से)
    सूची पक = ढेर_क्रम(["सेब", "आम", "केला"]);
    लिखतु(पक[0]);                    // आम

    लिखतु("क्रमचय परीक्षण पूरा");
}
