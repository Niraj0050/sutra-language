आयात "पुस्तकालय/क्रमचय.सूत्र";
आयात "पुस्तकालय/ढेर_प्राथमिकता.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // क्रमचय
    सूची प = क्रमचय([१, २, ३]);
    लिखतु(लंबाई(प));                  // 6
    लिखतु(प[०][०]); लिखतु(प[०][१]); लिखतु(प[०][२]); // 1 2 3

    सूची पर = क्रमचय_र([१, २, ३], २);
    लिखतु(लंबाई(पर));                 // 6
    लिखतु(लंबाई(पर[०]));              // 2

    // संचय
    सूची स = संचय([१, २, ३, ४], २);
    लिखतु(लंबाई(स));                  // 6
    लिखतु(संचय([१, २, ३], ३)[०][२]);  // 3
    लिखतु(लंबाई(संचय([१, २], ५)));    // 0

    // घात-समुच्चय
    सूची घ = घात_समुच्चय([१, २, ३]);
    लिखतु(लंबाई(घ));                  // 8
    लिखतु(लंबाई(घ[०]));               // 0  (रिक्त उपसमुच्चय)

    // कार्तीय गुणन
    सूची क = कार्तीय_गुणन([[१, २], [३, ४]]);
    लिखतु(लंबाई(क));                  // 4
    लिखतु(क[०][०]); लिखतु(क[०][१]);   // 1 3
    लिखतु(क[३][०]); लिखतु(क[३][१]);   // 2 4

    // विंडो / लगातार जोड़े
    सूची व = विंडो([१, २, ३, ४, ५], ३);
    लिखतु(लंबाई(व));                  // 3
    लिखतु(व[२][०]); लिखतु(व[२][२]);   // 3 5
    सूची लज = लगातार_जोड़े([१०, २०, ३०]);
    लिखतु(लंबाई(लज));                 // 2
    लिखतु(लज[१][०]); लिखतु(लज[१][१]); // 20 30

    // गिनती सहित
    सूची ग = गिनती_सहित(["अ", "ब", "स"]);
    लिखतु(ग[१][०]); लिखतु(ग[१][१]);   // 1 ब

    // ===== ढेर_प्राथमिकता =====
    मान पप = नवीन ढेर_प्राथमिकता();
    पप.डालो(५); पप.डालो(१); पप.डालो(९); पप.डालो(३); पप.डालो(७);
    लिखतु(पप.शिखर());               // 1
    लिखतु(पप.आकार());               // 5
    लिखतु(पप.निकालो());             // 1
    लिखतु(पप.निकालो());             // 3
    लिखतु(पप.निकालो());             // 5
    लिखतु(पप.आकार());               // 2
    लिखतु(हन(पप.खाली_है()));         // नहीं

    // ढेर-सॉर्ट
    सूची हक = ढेर_क्रम([४, १, ८, २, ९, ३, ७]);
    लिखतु(हक[०]); लिखतु(हक[६]);       // 1 9
    लिखतु(लंबाई(हक));                // 7

    // पाठ पर भी (सामान्य_* से)
    सूची पक = ढेर_क्रम(["सेब", "आम", "केला"]);
    लिखतु(पक[०]);                    // आम

    लिखतु("क्रमचय परीक्षण पूरा");
}
