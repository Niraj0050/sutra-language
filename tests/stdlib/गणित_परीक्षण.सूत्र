आयात "पुस्तकालय/गणित.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // पूर्णांक उपयोगिताएँ
    लिखतु(पूर्ण_निरपेक्ष(-७));       // 7
    लिखतु(चिह्न(-३)); लिखतु(चिह्न(०)); लिखतु(चिह्न(९)); // -1 0 1
    लिखतु(परिसीमन(१५, ०, १०));      // 10
    लिखतु(परिसीमन(-२, ०, १०));      // 0
    लिखतु(हन(सम_है(४))); लिखतु(हन(विषम_है(४))); // हाँ नहीं
    लिखतु(पूर्णांक_भाग(-७, २));      // -4
    लिखतु(गणित_शेष(-७, ३));         // 2
    लिखतु(घातांक(२, १०));           // 1024

    // संख्या-सिद्धांत
    लिखतु(गसो(४८, १८));            // 6
    लिखतु(लसो(४, ६));             // 12
    लिखतु(गुणनखंड(६));            // 720
    लिखतु(हन(अभाज्य_है(९७)));      // हाँ
    लिखतु(हन(अभाज्य_है(९१)));      // नहीं  (7×13)
    सूची गु = अभाज्य_गुणनखंड(३६०);   // [2,2,2,3,3,5]
    लिखतु(लंबाई(गु));              // 6
    लिखतु(गु[०]); लिखतु(गु[५]);    // 2 5
    लिखतु(लंबाई(अभाज्य_तक(२०)));   // 8
    लिखतु(फिबोनाची(१०));          // 55

    // सांख्यिकी
    सूची द = [४, ८, ६, ५, ३, ७];
    लिखतु(औसत(द));                // 5  (33/6 पूर्णांक भाग)
    लिखतु(माध्यिका([१, ३, ३, ६, ७, ८, ९])); // 6
    लिखतु(माध्यिका([१, २, ३, ४])); // 2  ((2+3)/2 पूर्णांक)
    लिखतु(बहुलक([१, २, २, ३, २, १])); // 2
    लिखतु(परिसर([४, ८, ६, ५, ३, ७])); // 5

    // PRNG — नियतात्मक (बीज सेट)
    यादृच्छिक_बीज(४२);
    संख्या र1 = यादृच्छिक_अगला();
    यादृच्छिक_बीज(४२);
    संख्या र2 = यादृच्छिक_अगला();
    लिखतु(हन(र1 == र2));          // हाँ  (एक ही बीज → एक ही क्रम)

    यादृच्छिक_बीज(१);
    संख्या प = यादृच्छिक_परास(१, ६);
    लिखतु(हन(प >= १ && प <= ६));   // हाँ

    यादृच्छिक_बीज(७);
    सूची मूल = [१, २, ३, ४, ५];
    सूची फ = फेंटो(मूल);
    लिखतु(लंबाई(फ));              // 5
    लिखतु(लंबाई(मूल));            // 5  (मूल अछूती)
    // फेंटी सूची में वही तत्व (योग समान)
    मान य1 = ०; मान य2 = ०;
    संख्या इ = ०;
    यावत् (इ < ५) { य1 = य1 + मूल[इ]; य2 = य2 + फ[इ]; इ = इ + १; }
    लिखतु(हन(य1 == य2));          // हाँ

    लिखतु("गणित परीक्षण पूरा");
}
