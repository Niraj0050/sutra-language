आयात "पुस्तकालय/गणित.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // पूर्णांक उपयोगिताएँ
    लिखतु(पूर्ण_निरपेक्ष(-7));       // 7
    लिखतु(चिह्न(-3)); लिखतु(चिह्न(0)); लिखतु(चिह्न(9)); // -1 0 1
    लिखतु(परिसीमन(15, 0, 10));      // 10
    लिखतु(परिसीमन(-2, 0, 10));      // 0
    लिखतु(हन(सम_है(4))); लिखतु(हन(विषम_है(4))); // हाँ नहीं
    लिखतु(पूर्णांक_भाग(-7, 2));      // -4
    लिखतु(गणित_शेष(-7, 3));         // 2
    लिखतु(घातांक(2, 10));           // 1024

    // संख्या-सिद्धांत
    लिखतु(गसो(48, 18));            // 6
    लिखतु(लसो(4, 6));             // 12
    लिखतु(गुणनखंड(6));            // 720
    लिखतु(हन(अभाज्य_है(97)));      // हाँ
    लिखतु(हन(अभाज्य_है(91)));      // नहीं  (7×13)
    सूची गु = अभाज्य_गुणनखंड(360);   // [2,2,2,3,3,5]
    लिखतु(लंबाई(गु));              // 6
    लिखतु(गु[0]); लिखतु(गु[5]);    // 2 5
    लिखतु(लंबाई(अभाज्य_तक(20)));   // 8
    लिखतु(फिबोनाची(10));          // 55

    // सांख्यिकी
    सूची द = [4, 8, 6, 5, 3, 7];
    लिखतु(औसत(द));                // 5  (33/6 पूर्णांक भाग)
    लिखतु(माध्यिका([1, 3, 3, 6, 7, 8, 9])); // 6
    लिखतु(माध्यिका([1, 2, 3, 4])); // 2  ((2+3)/2 पूर्णांक)
    लिखतु(बहुलक([1, 2, 2, 3, 2, 1])); // 2
    लिखतु(परिसर([4, 8, 6, 5, 3, 7])); // 5

    // PRNG — नियतात्मक (बीज सेट)
    यादृच्छिक_बीज(42);
    संख्या र1 = यादृच्छिक_अगला();
    यादृच्छिक_बीज(42);
    संख्या र2 = यादृच्छिक_अगला();
    लिखतु(हन(र1 == र2));          // हाँ  (एक ही बीज → एक ही क्रम)

    यादृच्छिक_बीज(1);
    संख्या प = यादृच्छिक_परास(1, 6);
    लिखतु(हन(प >= 1 && प <= 6));   // हाँ

    यादृच्छिक_बीज(7);
    सूची मूल = [1, 2, 3, 4, 5];
    सूची फ = फेंटो(मूल);
    लिखतु(लंबाई(फ));              // 5
    लिखतु(लंबाई(मूल));            // 5  (मूल अछूती)
    // फेंटी सूची में वही तत्व (योग समान)
    मान य1 = 0; मान य2 = 0;
    संख्या इ = 0;
    यावत् (इ < 5) { य1 = य1 + मूल[इ]; य2 = य2 + फ[इ]; इ = इ + 1; }
    लिखतु(हन(य1 == य2));          // हाँ

    लिखतु("गणित परीक्षण पूरा");
}
