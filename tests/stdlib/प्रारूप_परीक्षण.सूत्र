आयात "पुस्तकालय/प्रारूप.सूत्र";

कार्य मुख्य() {
    लिखतु(प्रारूप("{} + {} = {}", [2, 3, 5]));       // 2 + 3 = 5
    लिखतु(प्रारूप("नाम: {}, आयु: {}", ["सूत्र", 1])); // नाम: सूत्र, आयु: 1
    लिखतु(प्रारूप("कोई तर्क नहीं", []));              // कोई तर्क नहीं
    लिखतु(प्रारूप("{} बचा", [1]));                    // 1 बचा
    लिखतु(प्रारूप("{} {}", [1]));                     // 1 {}  (कम तर्क)

    लिखतु("[" + बाएँ_संरेखित("अ", 5, ".") + "]");     // [अ....]
    लिखतु("[" + दाएँ_संरेखित("अ", 5, ".") + "]");     // [....अ]
    लिखतु("[" + मध्य_संरेखित("अ", 5, ".") + "]");     // [..अ..]

    लिखतु(हज़ार_विभाजक(1234567));                     // 1,234,567
    लिखतु(हज़ार_विभाजक(-98765));                      // -98,765
    लिखतु(हज़ार_विभाजक(42));                          // 42

    लिखतु(संख्या_प्रारूप(3.14159, 2));                // 3.14
    लिखतु(संख्या_प्रारूप(2.5, 0));                    // 2  (गोल)
    लिखतु(संख्या_प्रारूप(0.007, 3));                  // 0.007
    लिखतु(प्रतिशत(0.25, 1));                          // 25.0%

    लिखतु(हेक्स(255));                                // ff
    लिखतु(हेक्स(4096));                               // 1000
    लिखतु(द्विआधारी(10));                             // 1010
    लिखतु(अष्टक(64));                                 // 100
    लिखतु(आधार_में(-255, 16));                        // -ff

    लिखतु(आधार_से("ff", 16));                         // 255
    लिखतु(आधार_से("1010", 2));                        // 10
    लिखतु(आधार_से("-1f", 16));                        // -31

    लिखतु(तालिका_पंक्ति(["नाम", "मान"], 6));          // "नाम    | मान   "

    लिखतु("प्रारूप परीक्षण पूरा");
}
