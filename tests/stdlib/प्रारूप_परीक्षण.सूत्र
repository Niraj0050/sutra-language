आयात "पुस्तकालय/प्रारूप.सूत्र";

कार्य मुख्य() {
    लिखतु(प्रारूप("{} + {} = {}", [२, ३, ५]));       // 2 + 3 = 5
    लिखतु(प्रारूप("नाम: {}, आयु: {}", ["सूत्र", १])); // नाम: सूत्र, आयु: 1
    लिखतु(प्रारूप("कोई तर्क नहीं", []));              // कोई तर्क नहीं
    लिखतु(प्रारूप("{} बचा", [१]));                    // 1 बचा
    लिखतु(प्रारूप("{} {}", [१]));                     // 1 {}  (कम तर्क)

    लिखतु("[" + बाएँ_संरेखित("अ", ५, ".") + "]");     // [अ....]
    लिखतु("[" + दाएँ_संरेखित("अ", ५, ".") + "]");     // [....अ]
    लिखतु("[" + मध्य_संरेखित("अ", ५, ".") + "]");     // [..अ..]

    लिखतु(हज़ार_विभाजक(१२३४५६७));                     // 1,234,567
    लिखतु(हज़ार_विभाजक(-९८७६५));                      // -98,765
    लिखतु(हज़ार_विभाजक(४२));                          // 42

    लिखतु(संख्या_प्रारूप(३.१४१५९, २));                // 3.14
    लिखतु(संख्या_प्रारूप(२.५, ०));                    // 2  (गोल)
    लिखतु(संख्या_प्रारूप(०.००७, ३));                  // 0.007
    लिखतु(प्रतिशत(०.२५, १));                          // 25.0%

    लिखतु(हेक्स(२५५));                                // ff
    लिखतु(हेक्स(४०९६));                               // 1000
    लिखतु(द्विआधारी(१०));                             // 1010
    लिखतु(अष्टक(६४));                                 // 100
    लिखतु(आधार_में(-२५५, १६));                        // -ff

    लिखतु(आधार_से("ff", १६));                         // 255
    लिखतु(आधार_से("1010", २));                        // 10
    लिखतु(आधार_से("-1f", १६));                        // -31

    लिखतु(तालिका_पंक्ति(["नाम", "मान"], ६));          // "नाम    | मान   "

    लिखतु("प्रारूप परीक्षण पूरा");
}
