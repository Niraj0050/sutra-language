आयात "पुस्तकालय/पथ.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    लिखतु(पथ_जोड़ो(["घर", "काम", "फ़ाइल.txt"]));  // घर/काम/फ़ाइल.txt
    लिखतु(पथ_जोड़ो(["/मूल", "उप"]));               // /मूल/उप
    लिखतु(पथ_जोड़ो(["अ/", "ब"]));                  // अ/ब
    लिखतु(पथ_जोड़ो(["", "अ", "", "ब"]));           // अ/ब

    लिखतु(आधार_नाम("/अ/ब/स.txt"));                // स.txt
    लिखतु(आधार_नाम("स.txt"));                     // स.txt
    लिखतु(आधार_नाम("/अ/ब/"));                     // ब

    लिखतु(निर्देशिका("/अ/ब/स.txt"));              // /अ/ब
    लिखतु(निर्देशिका("अ/ब/स.txt"));               // अ/ब
    लिखतु(निर्देशिका("स.txt"));                   // .
    लिखतु(निर्देशिका("/स.txt"));                  // /

    लिखतु(विस्तार("स.txt"));                       // txt
    लिखतु(विस्तार("स.tar.gz"));                    // gz
    लिखतु(विस्तार("बिना_विस्तार"));               // (खाली)
    लिखतु(विस्तार(".छिपा"));                      // (खाली)

    लिखतु(मूल_नाम("/अ/ब/स.txt"));                 // स
    लिखतु(मूल_नाम("स.tar.gz"));                   // स.tar

    लिखतु(हन(निरपेक्ष_है("/अ/ब")));               // हाँ
    लिखतु(हन(निरपेक्ष_है("अ/ब")));                // नहीं
    लिखतु(हन(निरपेक्ष_है("C:\\विंडोज़")));         // हाँ

    लिखतु(पथ_सामान्य("अ/ब/../स"));                // अ/स
    लिखतु(पथ_सामान्य("अ/./ब/./स"));               // अ/ब/स
    लिखतु(पथ_सामान्य("/अ/../../ब"));              // /ब
    लिखतु(पथ_सामान्य("अ/../.."));                 // ..
    लिखतु(पथ_सामान्य("./अ"));                     // अ

    लिखतु(साथ_विस्तार("अ/ब.txt", "md"));          // अ/ब.md
    लिखतु(साथ_विस्तार("रिपोर्ट.txt", "pdf"));     // रिपोर्ट.pdf

    लिखतु(लंबाई(पथ_खंड("/अ/ब/स")));               // ३

    लिखतु("पथ परीक्षण पूरा");
}
