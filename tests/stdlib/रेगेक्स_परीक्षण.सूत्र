// tests/stdlib/रेगेक्स_परीक्षण.सूत्र
आयात "पुस्तकालय/रेगेक्स.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("literal");
    जाँच("सादा मिला", रेगेक्स_मिलान("abc", "xxabcyy"), सत्य);
    जाँच("सादा न मिला", रेगेक्स_मिलान("abc", "xxabyy"), असत्य);
    जाँच("पूर्ण-मिलान सही", रेगेक्स_पूर्ण_मिलान("abc", "abc"), सत्य);
    जाँच("पूर्ण-मिलान गलत (अतिरिक्त)", रेगेक्स_पूर्ण_मिलान("abc", "abcd"), असत्य);
    जाँच("पूर्ण-मिलान गलत (कम)", रेगेक्स_पूर्ण_मिलान("abc", "ab"), असत्य);

    परीक्षण_समूह("कोई_भी .");
    जाँच("डॉट एक अक्षर", रेगेक्स_पूर्ण_मिलान("a.c", "abc"), सत्य);
    जाँच("डॉट अलग अक्षर", रेगेक्स_पूर्ण_मिलान("a.c", "azc"), सत्य);
    जाँच("डॉट लंबाई-मेल ज़रूरी", रेगेक्स_पूर्ण_मिलान("a.c", "ac"), असत्य);

    परीक्षण_समूह("दोहराव * + ?");
    जाँच("* शून्य बार", रेगेक्स_पूर्ण_मिलान("ab*c", "ac"), सत्य);
    जाँच("* कई बार", रेगेक्स_पूर्ण_मिलान("ab*c", "abbbbc"), सत्य);
    जाँच("+ शून्य बार असफल", रेगेक्स_पूर्ण_मिलान("ab+c", "ac"), असत्य);
    जाँच("+ एक बार", रेगेक्स_पूर्ण_मिलान("ab+c", "abc"), सत्य);
    जाँच("+ कई बार", रेगेक्स_पूर्ण_मिलान("ab+c", "abbbc"), सत्य);
    जाँच("? शून्य बार", रेगेक्स_पूर्ण_मिलान("ab?c", "ac"), सत्य);
    जाँच("? एक बार", रेगेक्स_पूर्ण_मिलान("ab?c", "abc"), सत्य);
    जाँच("? दो बार असफल", रेगेक्स_पूर्ण_मिलान("ab?c", "abbc"), असत्य);
    जाँच("greedy + backtrack", रेगेक्स_पूर्ण_मिलान("a*a", "aaa"), सत्य);
    जाँच("greedy .* पूरा निगले", रेगेक्स_पूर्ण_मिलान("a.*c", "axxxc"), सत्य);

    परीक्षण_समूह("वर्ग [...]");
    जाँच("सामान्य वर्ग मिले", रेगेक्स_पूर्ण_मिलान("[abc]", "b"), सत्य);
    जाँच("सामान्य वर्ग न मिले", रेगेक्स_पूर्ण_मिलान("[abc]", "d"), असत्य);
    जाँच("श्रेणी a-z", रेगेक्स_पूर्ण_मिलान("[a-z]+", "hello"), सत्य);
    जाँच("श्रेणी a-z बड़े अक्षर से असफल", रेगेक्स_पूर्ण_मिलान("[a-z]+", "Hello"), असत्य);
    जाँच("मिश्रित श्रेणी", रेगेक्स_पूर्ण_मिलान("[a-zA-Z0-9]+", "Abc123"), सत्य);
    जाँच("निषेध वर्ग मिले", रेगेक्स_पूर्ण_मिलान("[^0-9]+", "abc"), सत्य);
    जाँच("निषेध वर्ग न मिले", रेगेक्स_पूर्ण_मिलान("[^0-9]+", "ab3"), असत्य);

    परीक्षण_समूह("एंकर ^ $");
    जाँच("^ आरंभ पर", रेगेक्स_मिलान("^abc", "abcxyz"), सत्य);
    जाँच("^ बीच में नहीं मिलता", रेगेक्स_मिलान("^abc", "xabcxyz"), असत्य);
    जाँच("$ अंत पर", रेगेक्स_मिलान("xyz$", "abcxyz"), सत्य);
    जाँच("$ बीच में नहीं मिलता", रेगेक्स_मिलान("xyz$", "abcxyzq"), असत्य);
    जाँच("^...$ पूर्ण-मिलान जैसा", रेगेक्स_मिलान("^abc$", "abc"), सत्य);
    जाँच("^...$ आंशिक असफल", रेगेक्स_मिलान("^abc$", "abcd"), असत्य);

    परीक्षण_समूह("विकल्प |");
    जाँच("पहला विकल्प", रेगेक्स_पूर्ण_मिलान("cat|dog", "cat"), सत्य);
    जाँच("दूसरा विकल्प", रेगेक्स_पूर्ण_मिलान("cat|dog", "dog"), सत्य);
    जाँच("कोई विकल्प नहीं", रेगेक्स_पूर्ण_मिलान("cat|dog", "cow"), असत्य);
    जाँच("तीन विकल्प — तीसरा", रेगेक्स_पूर्ण_मिलान("a|b|c", "c"), सत्य);
    जाँच("समूह में विकल्प", रेगेक्स_पूर्ण_मिलान("(cat|dog)s", "dogs"), सत्य);

    परीक्षण_समूह("समूहन ( ) + दोहराव");
    जाँच("समूह-दोहराव शून्य बार", रेगेक्स_पूर्ण_मिलान("(ab)*", ""), सत्य);
    जाँच("समूह-दोहराव कई बार", रेगेक्स_पूर्ण_मिलान("(ab)*", "ababab"), सत्य);
    जाँच("समूह-दोहराव आंशिक असफल", रेगेक्स_पूर्ण_मिलान("(ab)*", "aba"), असत्य);
    जाँच("नेस्टेड समूह", रेगेक्स_पूर्ण_मिलान("((a|b)c)+", "acbc"), सत्य);

    परीक्षण_समूह("शॉर्टकट वर्ग \\d \\w \\s");
    जाँच("\\d अंक", रेगेक्स_पूर्ण_मिलान("\\d+", "12345"), सत्य);
    जाँच("\\d अक्षर पर असफल", रेगेक्स_पूर्ण_मिलान("\\d+", "12a45"), असत्य);
    जाँच("\\w शब्द-अक्षर", रेगेक्स_पूर्ण_मिलान("\\w+", "hello_123"), सत्य);
    जाँच("\\w स्पेस पर असफल", रेगेक्स_पूर्ण_मिलान("\\w+", "he llo"), असत्य);
    जाँच("\\s रिक्त", रेगेक्स_पूर्ण_मिलान("a\\sb", "a b"), सत्य);
    जाँच("\\D गैर-अंक", रेगेक्स_पूर्ण_मिलान("\\D+", "abc"), सत्य);
    जाँच("वर्ग में \\d", रेगेक्स_पूर्ण_मिलान("[\\d]+", "42"), सत्य);

    परीक्षण_समूह("एस्केप");
    जाँच("बिंदु का literal", रेगेक्स_पूर्ण_मिलान("a\\.c", "a.c"), सत्य);
    जाँच("बिंदु literal-escape से गलत मेल न हो", रेगेक्स_पूर्ण_मिलान("a\\.c", "axc"), असत्य);
    जाँच("तारा का literal", रेगेक्स_पूर्ण_मिलान("a\\*b", "a*b"), सत्य);

    परीक्षण_समूह("रेगेक्स_खोजो — विवरण");
    शब्दकोश मि1 = रेगेक्स_खोजो("\\d+", "क3म14ल");
    जाँच("मिला", मि1["मिला"], सत्य);
    जाँच("आरंभ", मि1["आरंभ"], 1);
    जाँच("अंत", मि1["अंत"], 2);
    जाँच("पाठ", मि1["पाठ"], "3");
    शब्दकोश मि2 = रेगेक्स_खोजो("xyz", "abc");
    जाँच("न मिला", मि2["मिला"], असत्य);

    परीक्षण_समूह("रेगेक्स_सभी_खोजो");
    जाँच("तीन अंक-समूह", रेगेक्स_सभी_खोजो("\\d+", "क3म14ल5"), ["3", "14", "5"]);
    जाँच("कोई मिलान नहीं", रेगेक्स_सभी_खोजो("\\d+", "अबस"), []);
    जाँच("पूरा पाठ एक मिलान", रेगेक्स_सभी_खोजो("[a-z]+", "hello"), ["hello"]);

    परीक्षण_समूह("रेगेक्स_बदलो");
    जाँच("स्वर बदलो", रेगेक्स_बदलो("[aeiou]", "hello", "*"), "h*ll*");
    जाँच("अंक बदलो", रेगेक्स_बदलो("\\d+", "क3म14ल5", "#"), "क#म#ल#");
    जाँच("कोई मिलान न हो तो अपरिवर्तित", रेगेक्स_बदलो("xyz", "abc", "!"), "abc");

    परीक्षण_समूह("रेगेक्स_विभाजित");
    जाँच("comma-space विभाजन", रेगेक्स_विभाजित(",\\s*", "अ, ब,ग,  घ"), ["अ", "ब", "ग", "घ"]);
    जाँच("बिना-मिलान अखंडित", रेगेक्स_विभाजित(",", "अकेला"), ["अकेला"]);
    जाँच("बहु-रिक्त विभाजन", रेगेक्स_विभाजित("\\s+", "एक   दो तीन"), ["एक", "दो", "तीन"]);

    परीक्षण_समूह("Capturing groups — बुनियादी");
    शब्दकोश ग1 = रेगेक्स_खोजो("(\\d+)", "abc123def");
    जाँच("एक समूह — पूरा मिलान", ग1["पाठ"], "123");
    जाँच("एक समूह — समूह सूची", ग1["समूह"], ["123"]);
    जाँच("रेगेक्स_समूह सुविधा-फलन", रेगेक्स_समूह(ग1, 1), "123");

    शब्दकोश ग2 = रेगेक्स_खोजो("(\\d+)-(\\d+)", "12-34");
    जाँच("दो समूह — पहला", रेगेक्स_समूह(ग2, 1), "12");
    जाँच("दो समूह — दूसरा", रेगेक्स_समूह(ग2, 2), "34");
    जाँच("दो समूह — समूह सूची", ग2["समूह"], ["12", "34"]);

    परीक्षण_समूह("Capturing groups — नेस्टेड (क्रमांक बाएँ-से-दाएँ खुलते कोष्ठक से)");
    शब्दकोश ग3 = रेगेक्स_खोजो("((a)(b))", "ab");
    जाँच("बाहरी समूह (1)", रेगेक्स_समूह(ग3, 1), "ab");
    जाँच("भीतरी समूह (2)", रेगेक्स_समूह(ग3, 2), "a");
    जाँच("भीतरी समूह (3)", रेगेक्स_समूह(ग3, 3), "b");

    परीक्षण_समूह("Capturing groups — विकल्प (alternation) backtracking शुद्धता");
    शब्दकोश ग4 = रेगेक्स_खोजो("(a)|(b)", "b");
    जाँच("न-मिली शाखा का समूह शून्यम् (stale नहीं)", रेगेक्स_समूह(ग4, 1), शून्यम्);
    जाँच("मिली शाखा का समूह सही", रेगेक्स_समूह(ग4, 2), "b");

    शब्दकोश ग5 = रेगेक्स_खोजो("((a)|(b))c", "bc");
    जाँच("नेस्टेड backtracking — बाहरी समूह", रेगेक्स_समूह(ग5, 1), "b");
    जाँच("नेस्टेड backtracking — न-मिली भीतरी शाखा शून्यम्", रेगेक्स_समूह(ग5, 2), शून्यम्);
    जाँच("नेस्टेड backtracking — मिली भीतरी शाखा", रेगेक्स_समूह(ग5, 3), "b");

    परीक्षण_समूह("Capturing groups — दोहराव (अंतिम पुनरावृत्ति जीतती)");
    शब्दकोश ग6 = रेगेक्स_खोजो("(\\d)+", "123");
    जाँच("दोहराया एकल-अक्षर समूह — अंतिम मान", रेगेक्स_समूह(ग6, 1), "3");
    शब्दकोश ग7 = रेगेक्स_खोजो("(ab)+", "ababab");
    जाँच("दोहराया बहु-अक्षर समूह — अंतिम मान", रेगेक्स_समूह(ग7, 1), "ab");
    जाँच("दोहराया समूह — पूरा मिलान अप्रभावित", ग7["पाठ"], "ababab");

    परीक्षण_समूह("Capturing groups — वैकल्पिक (?) समूह जो मिलान में शामिल नहीं होता");
    शब्दकोश ग8 = रेगेक्स_खोजो("(a)?b", "b");
    जाँच("वैकल्पिक समूह न मिला → शून्यम्", रेगेक्स_समूह(ग8, 1), शून्यम्);
    शब्दकोश ग9 = रेगेक्स_खोजो("(a)?b", "ab");
    जाँच("वैकल्पिक समूह मिला → पाठ", रेगेक्स_समूह(ग9, 1), "a");

    परीक्षण_समूह("न-पकड़ने-वाला समूह (?:...)");
    शब्दकोश ग10 = रेगेक्स_खोजो("(?:abc)+", "abcabcabc");
    जाँच("(?:...)+ पूरा मिलान", ग10["पाठ"], "abcabcabc");
    जाँच("(?:...) कोई समूह नहीं पकड़ता", ग10["समूह"], []);
    शब्दकोश ग11 = रेगेक्स_खोजो("(?:a)(b)", "ab");
    जाँच("न-पकड़ने-वाला समूह क्रमांक नहीं लेता", रेगेक्स_समूह(ग11, 1), "b");

    परीक्षण_समूह("रेगेक्स_समूह — सीमा-बाहर / अमान्य क्रमांक");
    जाँच("क्रमांक 0 → शून्यम्", रेगेक्स_समूह(ग1, 0), शून्यम्);
    जाँच("क्रमांक सीमा-बाहर → शून्यम्", रेगेक्स_समूह(ग1, 5), शून्यम्);

    परीक्षण_समूह("रेगेक्स_सभी_खोजो_विस्तृत");
    सूची विस्तृत = रेगेक्स_सभी_खोजो_विस्तृत("(\\w)=(\\d)", "a=1,b=2,c=3");
    जाँच("तीन मिलान", लंबाई(विस्तृत), 3);
    जाँच("पहला मिलान — पूरा पाठ", विस्तृत[0]["पाठ"], "a=1");
    जाँच("पहला मिलान — समूह 1", रेगेक्स_समूह(विस्तृत[0], 1), "a");
    जाँच("पहला मिलान — समूह 2", रेगेक्स_समूह(विस्तृत[0], 2), "1");
    जाँच("तीसरा मिलान — समूह 1", रेगेक्स_समूह(विस्तृत[2], 1), "c");
    जाँच("तीसरा मिलान — समूह 2", रेगेक्स_समूह(विस्तृत[2], 2), "3");

    परीक्षण_समूह("पीछे-संगत (backward compat) — रेगेक्स_सभी_खोजो capture से अप्रभावित");
    जाँच("capturing pattern फिर भी सिर्फ़ पाठ लौटाता",
        रेगेक्स_सभी_खोजो("(\\d+)", "12 34 56"), ["12", "34", "56"]);

    परत् परीक्षण_सारांश();
}
