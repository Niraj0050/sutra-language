आयात "पुस्तकालय/तर्क.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

// param class-typed → विधि-कॉल native में हल होते
कार्य विन्यास(तर्क_विश्लेषक प) {
    प.ध्वज("verbose", "v");
    प.ध्वज("force", "f");
    प.विकल्प("output", "o", "a.out");
    प.विकल्प("level", "l", "1");
    प.स्थानिक("इनपुट");
    परत् ०;
}

कार्य मुख्य() {
    // --लंबा ध्वज + -छ विकल्प + स्थानिक
    मान प1 = नवीन तर्क_विश्लेषक("परीक्षण उपकरण");
    विन्यास(प1);
    मान र1 = प1.विश्लेषण(["--verbose", "-o", "out.txt", "मेरी_फ़ाइल"]);
    लिखतु(हन(र1["verbose"]));         // हाँ
    लिखतु(हन(र1["force"]));           // नहीं
    लिखतु(र1["output"]);              // out.txt
    लिखतु(र1["level"]);               // १  (चूक)
    लिखतु(र1["इनपुट"]);               // मेरी_फ़ाइल

    // --लंबा=मान + -छ ध्वज + -छ मान
    मान प2 = नवीन तर्क_विश्लेषक("परीक्षण");
    विन्यास(प2);
    मान र2 = प2.विश्लेषण(["--output=res.md", "-f", "-l", "5", "in.txt"]);
    लिखतु(र2["output"]);              // res.md
    लिखतु(हन(र2["force"]));           // हाँ
    लिखतु(र2["level"]);               // ५
    लिखतु(र2["इनपुट"]);               // in.txt

    // -- के बाद सब शेष
    मान प3 = नवीन तर्क_विश्लेषक("परीक्षण");
    विन्यास(प3);
    मान र3 = प3.विश्लेषण(["-v", "पहला", "--", "--नकली-ध्वज", "दूसरा"]);
    लिखतु(हन(र3["verbose"]));         // हाँ
    लिखतु(र3["इनपुट"]);               // पहला
    मान श3 = र3["_शेष"];
    लिखतु(लंबाई(श3));                 // २
    लिखतु(श3[०]);                     // --नकली-ध्वज

    // कोई तर्क नहीं → चूक + स्थानिक शून्यम्
    मान प4 = नवीन तर्क_विश्लेषक("परीक्षण");
    विन्यास(प4);
    मान र4 = प4.विश्लेषण([]);
    लिखतु(हन(र4["verbose"]));         // नहीं
    लिखतु(र4["output"]);              // a.out
    लिखतु(हन(र4["इनपुट"] == शून्यम्)); // हाँ

    // अज्ञात ध्वज → शेष में
    मान प5 = नवीन तर्क_विश्लेषक("परीक्षण");
    विन्यास(प5);
    मान र5 = प5.विश्लेषण(["--अनजान", "x"]);
    मान श5 = र5["_शेष"];
    लिखतु(लंबाई(श5));                 // १
    लिखतु(र5["इनपुट"]);               // x

    // सहायता पाठ में नाम हों
    मान प6 = नवीन तर्क_विश्लेषक("परीक्षण");
    विन्यास(प6);
    पाठ स = प6.सहायता();
    लिखतु(हन(खोजें(स, "verbose") != -१));  // हाँ
    लिखतु(हन(खोजें(स, "output") != -१));   // हाँ

    लिखतु("तर्क परीक्षण पूरा");
}
