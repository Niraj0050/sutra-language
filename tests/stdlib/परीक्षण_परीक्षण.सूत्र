आयात "पुस्तकालय/परीक्षण.सूत्र";

कार्य मुख्य() {
    परीक्षण_समूह("अंकगणित");
    जाँच("जोड़", 2 + 3, 5);
    जाँच("गुणा", 4 * 5, 20);
    जाँच_सत्य("धनात्मक", 7 > 0);
    जाँच_असत्य("शून्य नहीं", 0 > 5);

    परीक्षण_समूह("सूची");
    जाँच("गहरी समानता", [1, [2, 3]], [1, [2, 3]]);
    जाँच("लंबाई", लंबाई([10, 20, 30]), 3);

    परीक्षण_समूह("दशमलव");
    जाँच_निकट("भाग", 10.0 / 3.0, 3.333, 0.01);
    जाँच_निकट("वर्गमूल", वर्गमूल(2.0), 1.414, 0.001);

    परीक्षण_समूह("पाठ");
    जाँच("जोड़", "अ" + "ब", "अब");
    जाँच("उच्च", उच्च("abc"), "ABC");

    // सारांश — सब पास होना चाहिए → 0
    संख्या कोड = परीक्षण_सारांश();
    लिखतु("निकास कोड: " + कोड);   // 0
}
