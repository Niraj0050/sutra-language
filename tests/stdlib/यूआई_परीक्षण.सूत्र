// tests/stdlib/यूआई_परीक्षण.सूत्र — यूआई मॉडल पुस्तकालय के परीक्षण
आयात "पुस्तकालय/यूआई.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// नोड का स्थान क्रिया-id से निकालो
कार्य स्थान_का(शब्दकोश जड़, पाठ क्रिया) {
    मान नोड = यूआई_खोजो_क्रिया(जड़, क्रिया);
    परत् नोड["स्थान"];
}

कार्य दृश्य_बनाओ() {
    परत् डिब्बा({"दिशा": "स्तंभ", "पैडिंग": 10, "अंतर": 8}, [
        डिब्बा({"दिशा": "पंक्ति", "अंतर": 6, "ऊँचाई": 40}, [
            बटन("A", "क्रिया_अ", {"चौड़ाई": 80}),
            बटन("B", "क्रिया_ब", {"चौड़ाई": 80}),
            रिक्ति(1)
        ]),
        डिब्बा({"बढ़त": 1, "पृष्ठ_रंग": "#111827", "क्रिया": "सामग्री_क्षेत्र"}, [])
    ]);
}

कार्य मुख्य() {
    परीक्षण_समूह("लेआउट — स्तंभ + पंक्ति + बढ़त + तनाव");

    शब्दकोश जड़ = दृश्य_बनाओ();
    लेआउट_करो(जड़, 400, 300);

    शब्दकोश जस = जड़["स्थान"];
    जाँच("जड़ चौड़ाई", जस["चौड़ाई"], 400);
    जाँच("जड़ ऊँचाई", जस["ऊँचाई"], 300);

    शब्दकोश अ_स = स्थान_का(जड़, "क्रिया_अ");
    जाँच("बटन A बाएँ",  अ_स["बाएँ"],  10);
    जाँच("बटन A ऊपर",   अ_स["ऊपर"],   10);
    जाँच("बटन A चौड़ाई", अ_स["चौड़ाई"], 80);
    जाँच("बटन A ऊँचाई (तनाव → टूलबार-ऊँचाई)", अ_स["ऊँचाई"], 40);

    शब्दकोश ब_स = स्थान_का(जड़, "क्रिया_ब");
    जाँच("बटन B बाएँ (A + चौड़ाई + अंतर)", ब_स["बाएँ"], 96);

    शब्दकोश सा_स = स्थान_का(जड़, "सामग्री_क्षेत्र");
    जाँच("सामग्री बाएँ",   सा_स["बाएँ"],   10);
    जाँच("सामग्री ऊपर (टूलबार-नीचे + अंतर)", सा_स["ऊपर"], 58);
    जाँच("सामग्री चौड़ाई (तनाव → पूरी भीतरी)", सा_स["चौड़ाई"], 380);
    जाँच("सामग्री ऊँचाई (बढ़त → बचा स्थान)",  सा_स["ऊँचाई"], 232);

    परीक्षण_समूह("चित्रण — आदेश-सूची");

    शब्दकोश अवस्था = यूआई_अवस्था_नई();
    सूची आदेश = चित्र_सूची(जड़, अवस्था);
    // 2 बटन (आयत + पाठ हर एक) + 1 सामग्री-आयत = 5
    जाँच("आदेश गिनती", लंबाई(आदेश), 5);
    जाँच("पहला आदेश = आयत (बटन A पृष्ठ)", आदेश[0]["आदेश"], "आयत");
    जाँच("बटन A आयत बाएँ",  आदेश[0]["क्ष"], 10);
    जाँच("बटन A आयत चौड़ाई", आदेश[0]["चौड़ाई"], 80);
    जाँच("दूसरा आदेश = पाठ", आदेश[1]["आदेश"], "पाठ");
    जाँच("बटन A पाठ सामग्री", आदेश[1]["सामग्री"], "A");
    जाँच("अंतिम आदेश = सामग्री आयत", आदेश[4]["आदेश"], "आयत");
    जाँच("सामग्री आयत रंग", आदेश[4]["रंग"], "#111827");

    परीक्षण_समूह("घटना — hover / press / click → संदेश");

    // बटन A के ऊपर माउस
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", 50, 25));
    जाँच("hover = बटन A", अवस्था["होवर"], "क्रिया_अ");

    // बटन A दबाओ
    घटना_भेजो(जड़, अवस्था, माउस_घटना("दबाव", 50, 25));
    जाँच("दबा = बटन A", अवस्था["दबा"], "क्रिया_अ");
    जाँच("केंद्रित = बटन A", अवस्था["केंद्रित"], "क्रिया_अ");

    // बटन A पर छोड़ो → संदेश
    शब्दकोश फल1 = घटना_भेजो(जड़, अवस्था, माउस_घटना("छोड़", 50, 25));
    जाँच("click संदेश", फल1["संदेश"], ["क्रिया_अ"]);
    जाँच("छोड़ के बाद दबा साफ़", अवस्था["दबा"], "");

    // बटन A दबाओ, बटन B पर छोड़ो → कोई संदेश नहीं (drag off)
    घटना_भेजो(जड़, अवस्था, माउस_घटना("दबाव", 50, 25));
    शब्दकोश फल2 = घटना_भेजो(जड़, अवस्था, माउस_घटना("छोड़", 120, 25));
    जाँच("drag-off → कोई संदेश नहीं", फल2["संदेश"], []);

    // रिक्ति के ऊपर (कोई क्रिया नहीं)
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", 300, 25));
    जाँच("रिक्ति पर hover = सामग्री? नहीं — रिक्ति क्रिया-रहित", अवस्था["होवर"], "");

    // सामग्री-क्षेत्र के ऊपर (उसकी क्रिया है)
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", 200, 200));
    जाँच("सामग्री-क्षेत्र पर hover", अवस्था["होवर"], "सामग्री_क्षेत्र");

    // दायरे-बाहर
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", 900, 900));
    जाँच("बाहर → hover साफ़", अवस्था["होवर"], "");

    परीक्षण_समूह("hover चित्रण को बदलता");

    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति", 50, 25));   // बटन A hover
    सूची आदेश2 = चित्र_सूची(जड़, अवस्था);
    जाँच("बटन A अब hover-रंग", आदेश2[0]["रंग"], "#3b82f6");
    जाँच("बटन B अब भी सामान्य", आदेश2[2]["रंग"], "#334155");

    परत् परीक्षण_सारांश();
}
