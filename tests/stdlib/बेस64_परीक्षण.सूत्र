// tests/stdlib/बेस64_परीक्षण.सूत्र
आयात "पुस्तकालय/बेस64.सूत्र";
आयात "पुस्तकालय/परीक्षण.सूत्र";

// संदर्भ मान PowerShell के [Convert]::ToBase64String (.NET का असली Base64)
// से निकाले — सिर्फ़ round-trip नहीं, स्वतंत्र कार्यान्वयन से सटीक मिलान।

कार्य मुख्य() {
    परीक्षण_समूह("बेस64_पाठ_एन्कोड — RFC 4648 क्लासिक सदिश (f/fo/foo/...)");
    जाँच("रिक्त", बेस64_पाठ_एन्कोड(""), "");
    जाँच("f", बेस64_पाठ_एन्कोड("f"), "Zg==");
    जाँच("fo", बेस64_पाठ_एन्कोड("fo"), "Zm8=");
    जाँच("foo", बेस64_पाठ_एन्कोड("foo"), "Zm9v");
    जाँच("foob", बेस64_पाठ_एन्कोड("foob"), "Zm9vYg==");
    जाँच("fooba", बेस64_पाठ_एन्कोड("fooba"), "Zm9vYmE=");
    जाँच("foobar", बेस64_पाठ_एन्कोड("foobar"), "Zm9vYmFy");

    परीक्षण_समूह("बेस64_पाठ_एन्कोड — बहु-बाइट UTF-8 (देवनागरी)");
    जाँच("नमस्ते", बेस64_पाठ_एन्कोड("नमस्ते"), "4KSo4KSu4KS44KWN4KSk4KWH");
    जाँच("सूत्र भाषा (स्पेस सहित)", बेस64_पाठ_एन्कोड("सूत्र भाषा"),
        "4KS44KWC4KSk4KWN4KSwIOCkreCkvuCkt+Ckvg==");

    परीक्षण_समूह("बेस64_पाठ_एन्कोड — मिश्रित ASCII वाक्य");
    जाँच("Sutra Base64 Test 123!", बेस64_पाठ_एन्कोड("Sutra Base64 Test 123!"),
        "U3V0cmEgQmFzZTY0IFRlc3QgMTIzIQ==");

    परीक्षण_समूह("बेस64_एन्कोड — कच्चे बाइट्स, पूरी वर्णमाला (+ और / सहित)");
    जाँच("[0,1,2,253,254,255]", बेस64_एन्कोड([०, १, २, २५३, २५४, २५५]), "AAEC/f7/");
    जाँच("[255] (एक बाकी बाइट)", बेस64_एन्कोड([२५५]), "/w==");
    जाँच("[255,255] (दो बाकी बाइट)", बेस64_एन्कोड([२५५, २५५]), "//8=");

    परीक्षण_समूह("बेस64_डिकोड — सटीक संदर्भ मान");
    जाँच("Zm9vYmE= → fooba बाइट्स", बेस64_डिकोड("Zm9vYmE="), [१०२, १११, १११, ९८, ९७]);
    जाँच("Zg== → [102]", बेस64_डिकोड("Zg=="), [१०२]);
    जाँच("Zm8= → [102,111]", बेस64_डिकोड("Zm8="), [१०२, १११]);
    जाँच("AAEC/f7/ → [0,1,2,253,254,255]", बेस64_डिकोड("AAEC/f7/"), [०, १, २, २५३, २५४, २५५]);

    परीक्षण_समूह("गोल-यात्रा (round-trip) — पाठ");
    जाँच("गोल-यात्रा: रिक्त", बेस64_पाठ_डिकोड(बेस64_पाठ_एन्कोड("")), "");
    जाँच("गोल-यात्रा: छोटा शब्द", बेस64_पाठ_डिकोड(बेस64_पाठ_एन्कोड("नमस्ते")), "नमस्ते");
    जाँच("गोल-यात्रा: लंबा वाक्य",
        बेस64_पाठ_डिकोड(बेस64_पाठ_एन्कोड("सूत्र एक देवनागरी-नेटिव भाषा है — 42!")),
        "सूत्र एक देवनागरी-नेटिव भाषा है — 42!");

    परीक्षण_समूह("गोल-यात्रा — कच्चे बाइट्स, सारी लंबाई-श्रेणियाँ (0,1,2 mod 3)");
    संख्या इ = ०;
    यावत् (इ < १२) {
        सूची मूल = [];
        संख्या क = ०;
        यावत् (क < इ) {
            मूल = जोड़ें(मूल, (क * ३७ + ५) % २५६);
            क = क + १;
        }
        सूची वापस = बेस64_डिकोड(बेस64_एन्कोड(मूल));
        जाँच("लंबाई " + ("" + इ) + " गोल-यात्रा", वापस, मूल);
        इ = इ + १;
    }

    परीक्षण_समूह("संरचनात्मक जाँच");
    जाँच("खाली इनपुट की लंबाई 0", लंबाई(बेस64_पाठ_एन्कोड("")), ०);
    जाँच_सत्य("पैडिंग हमेशा 4 के गुणज तक", (लंबाई(बेस64_पाठ_एन्कोड("foob")) % ४) == ०);

    परत् परीक्षण_सारांश();
}
