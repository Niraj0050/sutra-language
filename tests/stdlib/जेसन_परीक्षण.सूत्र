आयात "पुस्तकालय/जेसन.सूत्र";

कार्य हन(मान ब) { यदि (ब) { परत् "हाँ"; } परत् "नहीं"; }

कार्य मुख्य() {
    // बनाओ — शीर्ष-स्तर सीधे तर्क (यहाँ प्रकार static पता होता)
    लिखतु(जेसन_बनाओ(शून्यम्));                 // null
    लिखतु(जेसन_बनाओ(४२));                      // ४२
    लिखतु(जेसन_बनाओ("नम\"स्ते"));              // "नम\"स्ते"
    लिखतु(जेसन_बनाओ([१, २, ३]));               // [१,२,३]
    लिखतु(जेसन_बनाओ([]));                      // []
    लिखतु(जेसन_बनाओ(["अ", "ब"]));             // ["अ","ब"]

    // object — कुंजियाँ क्रमबद्ध छपती हैं
    लिखतु(जेसन_बनाओ({"ग": ३, "अ": १, "ब": २})); // {"अ":१,"ब":२,"ग":३}
    लिखतु(जेसन_बनाओ({"नेस्ट": {"भीतर": ५}, "सूची": [१०, २०]})); // {"सूची":[१०,२०],"नेस्ट":{"भीतर":५}}

    // पार्स — पूर्णांक / बूल / null (truthiness से जाँच)
    मान अ = जेसन_पार्स("[1, 2, 3, true, false, null]");
    लिखतु(लंबाई(अ));                           // ६
    लिखतु(अ[०]); लिखतु(अ[२]);                  // १ ३
    लिखतु(हन(अ[३])); लिखतु(हन(अ[४]));          // हाँ नहीं
    लिखतु(हन(अ[५] == शून्यम्));                // हाँ

    // पार्स — object
    मान व = जेसन_पार्स("{\"नाम\": \"सूत्र\", \"अंक\": 7, \"सूची\": [10, 20]}");
    लिखतु(व["नाम"]);                           // सूत्र
    लिखतु(व["अंक"]);                           // ७
    मान उ = व["सूची"];
    लिखतु(उ[०] + उ[१]);                        // ३०

    // पार्स — नेस्टेड + श्वेत-स्थान
    मान न1 = जेसन_पार्स("  { \"a\" : { \"b\" : [ 1 , 2 ] } }  ");
    मान बी = न1["a"];
    मान सी = बी["b"];
    लिखतु(सी[०] + सी[१]);                      // ३

    // पार्स — escaped string
    मान ए = जेसन_पार्स("\"पंक्ति1\\nपंक्ति2\\t\\\"उद्धृत\\\"\"");
    लिखतु(हन(खोजें(ए, "उद्धृत") != -१));        // हाँ
    लिखतु(हन(खोजें(ए, अक्षर_निर्माण(१०)) != -१)); // हाँ  (\n डिकोड हुआ)

    // पार्स — दशमलव (native: सूची-तत्व दशमलव को दशमलव-typed चर में बाँधो)
    मान द1 = जेसन_पार्स("[3.5, -1.25, 10]");
    दशमलव द_अ = द1[०];
    दशमलव द_ब = द1[१];
    लिखतु(द_अ + द_ब);                          // २.२५
    लिखतु(द1[२]);                              // १०

    // गोल-यात्रा (संख्या/पाठ/सूची — बूल/दशमलव native सीमा से बचाकर)
    मान मूल = {"संख्या": १००, "सूची": [१, २, ३], "पाठ": "अ"};
    पाठ जस = जेसन_बनाओ(मूल);
    मान वापस = जेसन_पार्स(जस);
    लिखतु(वापस["संख्या"]);                     // १००
    लिखतु(वापस["पाठ"]);                        // अ
    मान वस = वापस["सूची"];
    लिखतु(वस[०] + वस[१] + वस[२]);              // ६
    लिखतु(हन(जस == जेसन_बनाओ(वापस)));          // हाँ  (स्थिर round-trip)

    लिखतु("जेसन परीक्षण पूरा");
}
