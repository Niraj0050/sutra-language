// ========================================================
// सूत्र (Sutra) प्रोग्रामिंग भाषा — संपूर्ण भाषा एवं नवीन विशेषता परीक्षण
// ========================================================

कार्य जोड़ना(संख्या अ, संख्या ब) {
    परत् अ + ब;
}

कार्य मुख्य() {
    // 1. मूल आउटपुट परीक्षण
    लिखतु("========== 1. मूल आउटपुट परीक्षण ==========");
    लिखतु("लिखतु: सफल");
    दर्शयतु("दर्शयतु: सफल");
    पंक्तिं("पंक्तिं: सफल");

    // 2. चर एवं डेटा प्रकार परीक्षण
    लिखतु("========== 2. चर एवं डेटा प्रकार परीक्षण ==========");
    मान नाम = "निरज";
    संख्या आयु = 22;
    दशमलव मान_पाई = 3.14;
    बूल सक्रिय = सत्य;
    मान खाली = शून्यम्;

    लिखतु("नाम: " + नाम);
    लिखतु("आयु: " + आयु);
    लिखतु("पाई: " + मान_पाई);

    आयु = 23;
    अगर (आयु == 23) {
        लिखतु("चर पुनरंकन: सफल (PASS)");
    } अन्यथा {
        लिखतु("चर पुनरंकन: विफल (FAIL)");
    }

    // 3. गणित एवं स्ट्रिंग परीक्षण
    लिखतु("========== 3. गणित एवं स्ट्रिंग परीक्षण ==========");
    मान योग = 10 + 20;
    मान अंतर = 50 - 15;
    मान गुणन = 6 * 7;
    मान भाग = 100 / 4;
    मान शेष = 17 % 5;

    अगर (योग == 30 तथा अंतर == 35 तथा गुणन == 42 तथा भाग == 25 तथा शेष == 2) {
        लिखतु("गणित संक्रियाएँ: सफल (PASS)");
    } अन्यथा {
        लिखतु("गणित संक्रियाएँ: विफल (FAIL)");
    }

    मान संदेश = "नमस्ते " + "सूत्र";
    अगर (संदेश == "नमस्ते सूत्र") {
        लिखतु("स्ट्रिंग संयोजन: सफल (PASS)");
    } अन्यथा {
        लिखतु("स्ट्रिंग संयोजन: विफल (FAIL)");
    }

    // 4. तुलना एवं तार्किक ऑपरेटर परीक्षण
    लिखतु("========== 4. तुलना एवं तार्किक ऑपरेटर परीक्षण ==========");
    मान सत्य_तुलना = (10 > 5) तथा (20 >= 20) तथा (5 < 10) तथा (15 <= 15) तथा (5 != 10) तथा (10 == 10);
    अगर (सत्य_तुलना) {
        लिखतु("तुलनात्मक ऑपरेटर: सफल (PASS)");
    } अन्यथा {
        लिखतु("तुलनात्मक ऑपरेटर: विफल (FAIL)");
    }

    मान तर्क_परीक्षण = (सत्य अथवा असत्य) तथा (न असत्य);
    अगर (तर्क_परीक्षण) {
        लिखतु("तार्किक ऑपरेटर (तथा/अथवा/न): सफल (PASS)");
    } अन्यथा {
        लिखतु("तार्किक ऑपरेटर: विफल (FAIL)");
    }

    // 5. शर्त (If-Else) परीक्षण
    लिखतु("========== 5. शर्त परीक्षण ==========");
    अगर (आयु >= 18) {
        लिखतु("अगर शर्त: सफल (PASS)");
    } अन्यथा {
        लिखतु("अगर शर्त: विफल (FAIL)");
    }

    यदि (सक्रिय == असत्य) {
        लिखतु("यदि शर्त: विफल (FAIL)");
    } अन्यथा {
        लिखतु("यदि-अन्यथा शर्त: सफल (PASS)");
    }

    // 6. लूप (While) परीक्षण
    लिखतु("========== 6. लूप परीक्षण ==========");
    मान गिनती = 1;
    मान कुल_योग = 0;
    जबतक (गिनती <= 5) {
        कुल_योग = कुल_योग + गिनती;
        गिनती = गिनती + 1;
    }

    अगर (कुल_योग == 15) {
        लिखतु("जबतक लूप: सफल (PASS)");
    } अन्यथा {
        लिखतु("जबतक लूप: विफल (FAIL)");
    }

    // 7. सूची (Array/List) परीक्षण
    लिखतु("========== 7. सूची परीक्षण ==========");
    सूची अंक = [10, 20, 30];
    मान पहला = अंक[0];
    अंक[1] = 99;

    अगर (पहला == 10 तथा अंक[1] == 99) {
        लिखतु("सूची सूचकांक एवं संशोधन: सफल (PASS)");
    } अन्यथा {
        लिखतु("सूची परीक्षण: विफल (FAIL)");
    }

    // 8. कार्य (Function) परीक्षण
    लिखतु("========== 8. कार्य परीक्षण ==========");
    मान परिणाम = जोड़ना(15, 25);
    अगर (परिणाम == 40) {
        लिखतु("कार्य काह्वान एवं मान परत्: सफल (PASS)");
    } अन्यथा {
        लिखतु("कार्य परीक्षण: विफल (FAIL)");
    }

    // 9. देवनागरी अंक एवं टिप्पणी परीक्षण
    लिखतु("========== 9. देवनागरी अंक एवं टिप्पणी परीक्षण ==========");
    /* बहु-पंक्ति टिप्पणी परीक्षण */
    मान देवनागरी_योग = १० + २०;
    अगर (देवनागरी_योग == 30) {
        लिखतु("देवनागरी अंक प्रणाली: सफल (PASS)");
    } अन्यथा {
        लिखतु("देवनागरी अंक प्रणाली: विफल (FAIL)");
    }

    // 10. पुनरावृत्तिः (For Loop) परीक्षण
    लिखतु("========== 10. पुनरावृत्तिः (For Loop) परीक्षण ==========");
    मान फॉर_योग = 0;
    पुनरावृत्तिः (मान इ = 1; इ <= 5; इ = इ + 1) {
        फॉर_योग = फॉर_योग + इ;
    }
    अगर (फॉर_योग == 15) {
        लिखतु("पुनरावृत्तिः मानक लूप: सफल (PASS)");
    } अन्यथा {
        लिखतु("पुनरावृत्तिः मानक लूप: विफल (FAIL)");
    }

    // 0 iteration test
    मान शून्य_चक्र = 0;
    पुनरावृत्तिः (मान इ = 10; इ <= 5; इ = इ + 1) {
        शून्य_चक्र = शून्य_चक्र + 1;
    }
    अगर (शून्य_चक्र == 0) {
        लिखतु("पुनरावृत्तिः शून्य आवर्तन: सफल (PASS)");
    } अन्यथा {
        लिखतु("पुनरावृत्तिः शून्य आवर्तन: विफल (FAIL)");
    }

    // Reverse counting for loop
    मान उल्टी_गिनती_योग = 0;
    पुनरावृत्तिः (मान क = 5; क >= 1; क = क - 1) {
        उल्टी_गिनती_योग = उल्टी_गिनती_योग + क;
    }
    अगर (उल्टी_गिनती_योग == 15) {
        लिखतु("पुनरावृत्तिः विपरीत गणना: सफल (PASS)");
    } अन्यथा {
        लिखतु("पुनरावृत्तिः विपरीत गणना: विफल (FAIL)");
    }

    // 11. विरामः (Break Statement) एवं नेस्टेड लूप परीक्षण
    लिखतु("========== 11. विरामः (Break) एवं नेस्टेड लूप परीक्षण ==========");
    मान विराम_अंक = 0;
    पुनरावृत्तिः (मान इ = 1; इ <= 10; इ = इ + 1) {
        अगर (इ == 5) {
            विरामः;
        }
        विराम_अंक = इ;
    }
    अगर (विराम_अंक == 4) {
        लिखतु("विरामः (Break Statement): सफल (PASS)");
    } अन्यथा {
        लिखतु("विरामः: विफल (FAIL)");
    }

    // Nested loops break test
    मान नेस्टेड_योग = 0;
    पुनरावृत्तिः (मान इ = 1; इ <= 3; इ = इ + 1) {
        पुनरावृत्तिः (मान ज = 1; ज <= 3; ज = ज + 1) {
            अगर (ज == 2) {
                विरामः;
            }
            नेस्टेड_योग = नेस्टेड_योग + 1;
        }
    }
    // Inner loop runs 1 time per बाह्य iteration (for ज=1), so total 3
    अगर (नेस्टेड_योग == 3) {
        लिखतु("नेस्टेड लूप विरामः: सफल (PASS)");
    } अन्यथा {
        लिखतु("नेस्टेड लूप विरामः: विफल (FAIL)");
    }

    लिखतु("========================================");
    लिखतु("   सर्वाणि 11 परीक्षणानि सफलेन संपादितानि!");
    लिखतु("========================================");
}
