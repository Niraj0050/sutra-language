वर्ग नोड {
    मान नाम = "";
    मान सम्बन्ध = शून्यम्;

    कार्य रचना(पाठ n) {
        स्व.नाम = n;
    }
}

कार्य योग_योग(पाठ अ, पाठ ब) {
    परत् अ + ब;
}

कार्य मुख्य() {
    // 1. String allocation and concat
    मान अ: पाठ = "नमस्ते";
    मान ब: पाठ = "जगत्";
    मान स: पाठ = योग_योग(अ, ब);
    लिखतु(स);

    // 2. Reassignment (old values become unreachable)
    अ = "नवीन_मान_१";
    ब = "नवीन_मान_२";

    संग्रह_करो();
    स्मृति_स्थिति();

    // 3. Nested Scopes & Variable Lifetime
    {
        मान आंतरिक: पाठ = "केवल_आंतरिक_सीमा_हेतु";
        लिखतु(आंतरिक);
    }
    
    संग्रह_करो();
    स्मृति_स्थिति();

    // 4. Arrays containing strings
    सूची सूची_उदा = ["क", "ख"];
    संग्रह_करो();
    स्मृति_स्थिति();

    // Reassign list
    सूची_उदा = [];
    संग्रह_करो();
    स्मृति_स्थिति();

    // 5. OOP Objects Reachability and Nested Object Chains
    मान न१ = नवीन नोड("नोड_एक");
    मान न२ = नवीन नोड("नोड_द्वि");
    मान न३ = नवीन नोड("नोड_त्रि");

    न१.सम्बन्ध = न२;
    न२.सम्बन्ध = न३;

    संग्रह_करो();
    लिखतु("नोड_सक्रिय");
    स्मृति_स्थिति();

    // Sever root variables
    न१ = शून्यम्;
    न२ = शून्यम्;
    न३ = शून्यम्;

    संग्रह_करो();
    लिखतु("नोड_संग्रहित");
    स्मृति_स्थिति();

    // 6. Circular References
    मान च१ = नवीन नोड("चक्र_एक");
    मान च२ = नवीन नोड("चक्र_द्वि");

    च१.सम्बन्ध = च२;
    च२.सम्बन्ध = च१;

    संग्रह_करो();
    लिखतु("चक्र_सक्रिय");
    स्मृति_स्थिति();

    // Sever roots
    च१ = शून्यम्;
    च२ = शून्यम्;

    संग्रह_करो();
    लिखतु("चक्र_संग्रहित");
    स्मृति_स्थिति();
}
