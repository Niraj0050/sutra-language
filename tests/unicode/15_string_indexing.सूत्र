// String indexing (पाठ सूचकांक) Test

कार्य मुख्य() {
    लिखतु("=== पाठ सूचकांक (String Indexing) परीक्षण ===");

    // Test 1: ASCII string indexing
    मान पाठ1 = "Sutra";
    मान च0 = पाठ1[0];
    मान च4 = पाठ1[4];
    अगर (च0 == "S" तथा च4 == "a") {
        लिखतु("1. ASCII पाठ सूचकांक: सफल (PASS)");
    } अन्यथा {
        लिखतु("1. ASCII पाठ सूचकांक: विफल (FAIL), प्राप्त: " + च0 + ", " + च4);
    }

    // Test 2: Unicode (Devanagari) string indexing
    मान पाठ2 = "नमस्ते";
    // Unicode characters: न (0), म (1), स् (2) -> wait, न (0), म (1), स (2), ् (3), त (4), े (5)
    // Wait! decode_utf8 decodes codepoints. 
    // In "नमस्ते", the codepoints are:
    // 0: न (U+0928)
    // 1: म (U+092E)
    // 2: स (U+0938)
    // 3: ् (U+094D)
    // 4: त (U+0924)
    // 5: े (U+0947)
    // So index 0 should be "न", index 1 should be "म", index 2 should be "स", index 3 should be combining sign matra, etc.
    मान यू0 = पाठ2[0];
    मान यू1 = पाठ2[1];
    मान यू2 = पाठ2[2];
    
    अगर (यू0 == "न" तथा यू1 == "म" तथा यू2 == "स") {
        लिखतु("2. देवनागरी पाठ सूचकांक: सफल (PASS)");
    } अन्यथा {
        लिखतु("2. देवनागरी पाठ सूचकांक: विफल (FAIL), प्राप्त: " + यू0 + ", " + यू1 + ", " + यू2);
    }

    // Test 3: Loop indexing
    मान संक्षेप = "";
    पुनरावृत्तिः (मान i = 0; i < 5; i = i + 1) {
        संक्षेप = संक्षेप + पाठ1[i];
    }
    अगर (संक्षेप == "Sutra") {
        लिखतु("3. लूप द्वारा पाठ सूचकांक: सफल (PASS)");
    } अन्यथा {
        लिखतु("3. लूप द्वारा पाठ सूचकांक: विफल (FAIL)");
    }

    // Test 4: Bounds checking error handling
    लिखतु("4. सीमा उल्लंघन परीक्षण...");
    प्रयत्न {
        मान त्रुटि_मान = पाठ1[5]; // Index 5 is out of bounds (length is 5, indices 0..4)
        लिखतु("4. सीमा उल्लंघन: विफल (FAIL) - त्रुटि नहीं आई");
    } पकड़ो (त्रुटि) {
        लिखतु("4. सीमा उल्लंघन: सफल (PASS) - त्रुटि पकड़ी गई");
    }

    // Phase 2 regression coverage: ASCII, middle, last, Hindi, empty, and negative index behavior
    मान एच = "hello";
    मान एच_मध्य = एच[2];
    मान एच_अंत = एच[4];
    मान देवनागरी = "नमस्ते";
    मान द_मध्य = देवनागरी[2];
    मान रिक्त = "";
    अगर (एच[0] == "h" तथा एच_मध्य == "l" तथा एच_अंत == "o" तथा देवनागरी[0] == "न" तथा द_मध्य == "स") {
        लिखतु("5. UTF-8/ASCII पाठ सूचकांक: सफल (PASS)");
    } अन्यथा {
        लिखतु("5. UTF-8/ASCII पाठ सूचकांक: विफल (FAIL)");
    }

    प्रयत्न {
        मान नकारात्मक = देवनागरी[-1];
        लिखतु("6. ऋणात्मक सूचकांक: विफल (FAIL)");
    } पकड़ो (त्रुटि) {
        लिखतु("6. ऋणात्मक सूचकांक: सफल (PASS)");
    }

    प्रयत्न {
        मान रिक्त_मान = रिक्त[0];
        लिखतु("7. रिक्त पाठ सूचकांक: विफल (FAIL)");
    } पकड़ो (त्रुटि) {
        लिखतु("7. रिक्त पाठ सूचकांक: सफल (PASS)");
    }

    लिखतु("=== पाठ सूचकांक परीक्षण सम्पन्न ===");
}
