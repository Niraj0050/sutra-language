// पुस्तकालय/संजाल.सूत्र — TCP क्लाइंट संजाल (Winsock2 FFI पर आधारित)
// ============================================================
// आयात "पुस्तकालय/संजाल.सूत्र";
//
//   संजाल_आरंभ();                                     // प्रक्रिया-जीवनकाल में एक बार
//   शब्दकोश सं = संजाल_जोड़ो("93.184.216.34", ८०);     // संख्यात्मक IPv4 से
//   // या सीधे होस्टनाम से (DNS):
//   शब्दकोश सं2 = संजाल_होस्ट_जोड़ो("example.com", ८०);
//   संजाल_भेजो_पाठ(सं["सॉकेट"], "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n");
//   पाठ उत्तर = संजाल_सब_पाओ_पाठ(सं["सॉकेट"]);
//   संजाल_बंद(सं["सॉकेट"]);
//   संजाल_सफाई();                                      // प्रक्रिया-जीवनकाल के अंत में
//
//   // सुविधा — पूरा राउंड-ट्रिप एक कॉल में:
//   पाठ पृष्ठ = संजाल_एचटीटीपी_गेट("example.com", ८०, "/");
//
// विन32.सूत्र जैसा — विदेशी (Win32/Winsock2 DLL) पर आधारित असली OS क्षमता,
// पर struct-packing/byte-order/hostent-पार्सिंग/algorithm पूरी तरह मौलिक
// Sutra कोड, किसी socket-library का पोर्ट नहीं — OS API कॉल करना FFI का
// सामान्य उपयोग है (हर native भाषा यही करती है), ऊपर की सारी लॉजिक अपनी।
//
// v1 दायरा (जानबूझकर सीमित): सिर्फ़ TCP क्लाइंट (connect/send/recv), सिर्फ़
// IPv4, कोई TLS/HTTPS नहीं (plain HTTP ही काम करेगा), कोई server/listen/
// accept नहीं, gethostbyname (पुराना पर सरल API — getaddrinfo नहीं, IPv4-
// only काफ़ी है v1 के लिए)।
// ============================================================

आयात "पुस्तकालय/संकुचन.सूत्र";   // सं_यूटीएफ8_एन्कोड/डिकोड पुनःप्रयोग

// ---- कच्चे बाइट-बफर सहायक (अंतर्_पढ़*/लिख* पर, विन32.सूत्र जैसा पैटर्न) ----

कार्य ज_बफर(संख्या आकार) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < आकार) { फल = फल + " "; इ = इ + १; }
    परत् फल;
}
कार्य ज_लिख1(संख्या पता, संख्या ऑफ, संख्या मू) { अंतर्_लिख1(पता, ऑफ, बिट_और(मू, २५५)); परत् ०; }
कार्य ज_लिख2(संख्या पता, संख्या ऑफ, संख्या मू) {
    ज_लिख1(पता, ऑफ, मू);
    ज_लिख1(पता, ऑफ + १, दक्षिण_सरक(मू, ८));
    परत् ०;
}
कार्य ज_लिख4(संख्या पता, संख्या ऑफ, संख्या मू) {
    ज_लिख1(पता, ऑफ, मू);
    ज_लिख1(पता, ऑफ + १, दक्षिण_सरक(मू, ८));
    ज_लिख1(पता, ऑफ + २, दक्षिण_सरक(मू, १६));
    ज_लिख1(पता, ऑफ + ३, दक्षिण_सरक(मू, २४));
    परत् ०;
}
कार्य ज_पढ़1(संख्या पता, संख्या ऑफ) { परत् अंतर्_पढ़1(पता, ऑफ); }
कार्य ज_पढ़4(संख्या पता, संख्या ऑफ) {
    संख्या ब0 = ज_पढ़1(पता, ऑफ);
    संख्या ब1 = ज_पढ़1(पता, ऑफ + १);
    संख्या ब2 = ज_पढ़1(पता, ऑफ + २);
    संख्या ब3 = ज_पढ़1(पता, ऑफ + ३);
    परत् ब0 + ब1 * २५६ + ब2 * ६५५३६ + ब3 * १६७७७२१६;
}
कार्य ज_पढ़8(संख्या पता, संख्या ऑफ) { परत् अंतर्_पढ़8(पता, ऑफ); }

// ---- विदेशी घोषणाएँ (ws2_32.dll) ----

विदेशी "ws2_32" "WSAStartup" ज_विनसॉक_आरंभ_रॉ(संख्या, संख्या);
विदेशी "ws2_32" "WSACleanup" ज_विनसॉक_सफाई_रॉ();
विदेशी "ws2_32" "socket" ज_सॉकेट_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "connect" ज_जोड़ो_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "send" ज_भेजो_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "ws2_32" "recv" ज_पाओ_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "ws2_32" "closesocket" ज_बंद_रॉ(संख्या);
विदेशी "ws2_32" "htons" ज_एचटीओएनएस(संख्या);
विदेशी "ws2_32" "inet_addr" ज_आइपी_रॉ(संख्या);
विदेशी "ws2_32" "gethostbyname" ज_होस्ट_रॉ(संख्या);

कार्य ज_पता_परिवार() { परत् २; }
कार्य ज_धारा_प्रकार() { परत् १; }

// ---- आरंभ/सफाई (प्रक्रिया-जीवनकाल में एक-एक बार) ----

कार्य संजाल_आरंभ() {
    पाठ बफ = ज_बफर(५१२);   // WSADATA — सामग्री अनदेखी, बस जगह चाहिए
    संख्या फल = ज_विनसॉक_आरंभ_रॉ(५१४, विदेशी_पता(बफ));   // ५१४ = MAKEWORD(२,२)
    परत् फल == ०;
}
कार्य संजाल_सफाई() {
    ज_विनसॉक_सफाई_रॉ();
    परत् ०;
}

// ---- sockaddr_in बनाना (१६ बाइट: family@०(२) port@२(२) addr@४(४) zero@८(८)) ----

कार्य ज_पता_बनाओ(संख्या आइपी_रॉ, संख्या पोर्ट) {
    पाठ बफ = ज_बफर(१६);
    संख्या प = विदेशी_पता(बफ);
    ज_लिख2(प, ०, ज_पता_परिवार());
    ज_लिख2(प, २, ज_एचटीओएनएस(पोर्ट));
    ज_लिख4(प, ४, आइपी_रॉ);
    ज_लिख4(प, ८, ०);
    ज_लिख4(प, १२, ०);
    शब्दकोश फल = {};
    फल["_रॉ"] = बफ;
    फल["पता"] = प;
    परत् फल;
}

// ---- कनेक्शन बनाना ----

// संख्यात्मक IPv4 पते से (जैसे "93.184.216.34")
कार्य संजाल_जोड़ो(पाठ आइपी, संख्या पोर्ट) {
    संख्या आइपी_बाइट = ज_आइपी_रॉ(विदेशी_पता(आइपी));
    संख्या सॉ = ज_सॉकेट_रॉ(ज_पता_परिवार(), ज_धारा_प्रकार(), ०);
    शब्दकोश परिणाम = {};
    यदि (सॉ < ०) {
        परिणाम["सफल"] = असत्य;
        परिणाम["सॉकेट"] = -१;
        परत् परिणाम;
    }
    शब्दकोश पता = ज_पता_बनाओ(आइपी_बाइट, पोर्ट);
    संख्या क्_फल = ज_जोड़ो_रॉ(सॉ, पता["पता"], १६);
    परिणाम["सफल"] = क्_फल == ०;
    परिणाम["सॉकेट"] = सॉ;
    परत् परिणाम;
}

// होस्टनाम से (DNS, gethostbyname — IPv4-only)। असफल → -१
कार्य संजाल_होस्ट_खोजो(पाठ होस्टनाम) {
    संख्या ह = ज_होस्ट_रॉ(विदेशी_पता(होस्टनाम));
    यदि (ह == ०) { परत् -१; }
    संख्या सूची_पता = ज_पढ़8(ह, २४);         // hostent.h_addr_list
    यदि (सूची_पता == ०) { परत् -१; }
    संख्या पहला_पता = ज_पढ़8(सूची_पता, ०);     // *h_addr_list[०]
    यदि (पहला_पता == ०) { परत् -१; }
    परत् ज_पढ़4(पहला_पता, ०);                  // ४-बाइट IPv4, network-order पहले से
}

कार्य संजाल_होस्ट_जोड़ो(पाठ होस्टनाम, संख्या पोर्ट) {
    संख्या आइपी_बाइट = संजाल_होस्ट_खोजो(होस्टनाम);
    शब्दकोश परिणाम = {};
    यदि (आइपी_बाइट < ०) {
        परिणाम["सफल"] = असत्य;
        परिणाम["सॉकेट"] = -१;
        परत् परिणाम;
    }
    संख्या सॉ = ज_सॉकेट_रॉ(ज_पता_परिवार(), ज_धारा_प्रकार(), ०);
    यदि (सॉ < ०) {
        परिणाम["सफल"] = असत्य;
        परिणाम["सॉकेट"] = -१;
        परत् परिणाम;
    }
    शब्दकोश पता = ज_पता_बनाओ(आइपी_बाइट, पोर्ट);
    संख्या क्_फल = ज_जोड़ो_रॉ(सॉ, पता["पता"], १६);
    परिणाम["सफल"] = क्_फल == ०;
    परिणाम["सॉकेट"] = सॉ;
    परत् परिणाम;
}

// ---- भेजना/पाना ----

कार्य संजाल_भेजो(संख्या सॉकेट, सूची बाइट्स) {
    संख्या लं = लंबाई(बाइट्स);
    पाठ बफ = ज_बफर(लं);
    संख्या प = विदेशी_पता(बफ);
    संख्या इ = ०;
    यावत् (इ < लं) {
        ज_लिख1(प, इ, बाइट्स[इ]);
        इ = इ + १;
    }
    परत् ज_भेजो_रॉ(सॉकेट, प, लं, ०);
}
कार्य संजाल_भेजो_पाठ(संख्या सॉकेट, पाठ स्रोत) {
    परत् संजाल_भेजो(सॉकेट, सं_यूटीएफ8_एन्कोड(स्रोत));
}

// एक recv() कॉल — अधिकतम तक; कम मिल सकता है (रिक्त सूची = कनेक्शन बंद/त्रुटि)
कार्य संजाल_पाओ(संख्या सॉकेट, संख्या अधिकतम) {
    पाठ बफ = ज_बफर(अधिकतम);
    संख्या प = विदेशी_पता(बफ);
    संख्या गिनती = ज_पाओ_रॉ(सॉकेट, प, अधिकतम, ०);
    सूची फल = [];
    यदि (गिनती <= ०) { परत् फल; }
    संख्या इ = ०;
    यावत् (इ < गिनती) {
        फल = जोड़ें(फल, ज_पढ़1(प, इ));
        इ = इ + १;
    }
    परत् फल;
}

// कनेक्शन बंद होने तक सब कुछ पढ़ो (recv==० पर रुके — सर्वर "Connection: close" माने)
कार्य संजाल_सब_पाओ(संख्या सॉकेट) {
    सूची कुल = [];
    यावत् (सत्य) {
        सूची भाग = संजाल_पाओ(सॉकेट, ४०९६);
        यदि (लंबाई(भाग) == ०) { विरामः; }
        संख्या इ = ०;
        यावत् (इ < लंबाई(भाग)) {
            कुल = जोड़ें(कुल, भाग[इ]);
            इ = इ + १;
        }
    }
    परत् कुल;
}
कार्य संजाल_सब_पाओ_पाठ(संख्या सॉकेट) {
    परत् सं_यूटीएफ8_डिकोड(संजाल_सब_पाओ(सॉकेट));
}

कार्य संजाल_बंद(संख्या सॉकेट) {
    ज_बंद_रॉ(सॉकेट);
    परत् ०;
}

// ---- सुविधा — एक कॉल में पूरा HTTP GET (सिर्फ़ plain HTTP, HTTPS नहीं) ----

कार्य संजाल_एचटीटीपी_गेट(पाठ होस्टनाम, संख्या पोर्ट, पाठ पथ) {
    शब्दकोश सं = संजाल_होस्ट_जोड़ो(होस्टनाम, पोर्ट);
    यदि (!सं["सफल"]) { परत् ""; }
    पाठ निवेदन = "GET " + पथ + " HTTP/1.1\r\nHost: " + होस्टनाम
                + "\r\nConnection: close\r\n\r\n";
    संजाल_भेजो_पाठ(सं["सॉकेट"], निवेदन);
    पाठ उत्तर = संजाल_सब_पाओ_पाठ(सं["सॉकेट"]);
    संजाल_बंद(सं["सॉकेट"]);
    परत् उत्तर;
}

// ============================================================
// ---- HTTPS/TLS (WinHTTP — winhttp.dll पर आधारित) ----
// ============================================================
// ऊपर का कच्चा Winsock रास्ता TLS नहीं दे सकता — TLS खुद लागू करना (RSA/
// ECDHE कुंजी-विनिमय, AES-GCM, X.509 प्रमाणपत्र सत्यापन) यहाँ जानबूझकर
// नहीं किया: "अपना क्रिप्टो मत बनाओ" एक उद्योग-व्यापी नियम है — हाथ से
// लिखा TLS ग़लत होने पर असली सुरक्षा-कमज़ोरी बनता है, SHA-256/LZ77/PRNG
// जैसे "ग़लत होने पर सिर्फ़ ग़लत जवाब" वाले मामलों से बुनियादी रूप से अलग
// जोखिम-श्रेणी। इसकी जगह Windows का अपना, पहले से परीक्षित TLS
// कार्यान्वयन (WinHTTP, winhttp.dll) `विदेशी` से बुलाया — बिल्कुल वही
// सिद्धांत जो kernel32/user32/ws2_32 को FFI से बुलाने में लागू होता है:
// OS-दी क्षमता इस्तेमाल करना कॉपी नहीं। नीचे की सारी wrapper/buffer/API-
// सतह लॉजिक मौलिक Sutra कोड है — प्रमाणपत्र-सत्यापन डिफ़ॉल्ट रूप से चालू
// रहता है (WinHTTP का सामान्य व्यवहार), कहीं बंद नहीं किया।
//
// WinHTTP UTF-16 (wide) स्ट्रिंग्स लेता — विन32.सूत्र के विं_चौड़ा_बनाओ
// जैसा अपना ज_चौड़ा_बनाओ यहाँ।

कार्य ज_चौड़ा_बनाओ(पाठ स) {
    पाठ बफ = ज_बफर(५१२);   // २५६ WCHAR क्षमता
    संख्या बफ_पता = विदेशी_पता(बफ);
    सूत्र_तल_यूटीएफ_चौड़ा(विदेशी_पता(स), बफ_पता, २५६);
    शब्दकोश फल = {};
    फल["_रॉ"] = बफ;
    फल["पता"] = बफ_पता;
    परत् फल;
}

विदेशी "winhttp" "WinHttpOpen" ज_सु_खोलो_रॉ(संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "winhttp" "WinHttpConnect" ज_सु_जोड़ो_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "winhttp" "WinHttpOpenRequest" ज_सु_निवेदन_रॉ(संख्या, संख्या, संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "winhttp" "WinHttpSendRequest" ज_सु_भेजो_रॉ(संख्या, संख्या, संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "winhttp" "WinHttpReceiveResponse" ज_सु_उत्तर_रॉ(संख्या, संख्या);
विदेशी "winhttp" "WinHttpQueryDataAvailable" ज_सु_उपलब्ध_रॉ(संख्या, संख्या);
