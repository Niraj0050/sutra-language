// पुस्तकालय/यूआरएल.सूत्र — URL/URI पार्सिंग/निर्माण (RFC 3986)
// ============================================================
// आयात "पुस्तकालय/यूआरएल.सूत्र";
//
//   शब्दकोश भाग = यूआरएल_पार्स("https://ram:pass@example.com:8080/path?a=1&b=2#top");
//   भाग["योजना"]   // "https"
//   भाग["मेज़बान"]  // "example.com"
//   भाग["पोर्ट"]    // 8080
//   शब्दकोश प्रश्न = यूआरएल_प्रश्न_पार्स(भाग["प्रश्न"]);  // {"a":"1", "b":"2"}
//   पाठ यू = यूआरएल_बनाओ(भाग);   // वापस पूरा URL पाठ
//
// ⚠️ URL/URI डेटा असली वेब-सर्वर/ब्राउज़र से interop करता है — यह "हमारा
// अपना" निरूपण नहीं, SHA-256 hex/UUID जैसा ही बाहरी-मानक डेटा है। इसलिए
// यहाँ हर जगह Arabic अंक/मानक ASCII सही है (देवनागरी नियम लागू नहीं होता) —
// port संख्या, प्रतिशत-एन्कोडिंग के hex अंक, query-string मान, सब मानक
// URL-सिंटैक्स में, जैसा कोई भी real HTTP client/server समझता। केवल इस
// फ़ाइल के अपने कोड (चर-नाम, टिप्पणियाँ, तुलना-स्थिरांक) देवनागरी हैं।
//
// स्कोप (v1, जानबूझकर सीमित — दस्तावेज़ित, अंधाधुंध नहीं): केवल
// "योजना://[प्रयोक्ता@]मेज़बान[:पोर्ट][पथ][?प्रश्न][#खंड]" रूप — "//" रहित
// योजनाएँ (`mailto:`/`urn:` जैसी) असमर्थित। IPv6 bracket-नोटेशन
// (`[::1]:8080`) असमर्थित — मेज़बान में सीधे ':' को port-विभाजक मान लिया
// जाता। userinfo का user:pass उप-विभाजन नहीं किया जाता, पूरा एक पाठ रहता।
// ============================================================

आयात "पुस्तकालय/संकुचन.सूत्र";
आयात "पुस्तकालय/प्रारूप.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";

// ===== प्रतिशत-एन्कोडिंग (RFC 3986 §2.1-2.3) =====

// अनारक्षित वर्ण (percent-encode नहीं होते): A-Z a-z 0-9 - . _ ~
कार्य यूआरएल_अनारक्षित_है(संख्या ब) {
    यदि (ब >= ६५ && ब <= ९०) { परत् सत्य; }    // A-Z
    यदि (ब >= ९७ && ब <= १२२) { परत् सत्य; }   // a-z
    यदि (ब >= ४८ && ब <= ५७) { परत् सत्य; }    // 0-9
    यदि (ब == ४५ || ब == ४६ || ब == ९५ || ब == १२६) { परत् सत्य; } // - . _ ~
    परत् असत्य;
}

// पाठ → percent-encoded पाठ (UTF-8 बाइट-स्तर पर — बहु-बाइट अक्षर कई %XX देते)
कार्य यूआरएल_प्रतिशत_एन्कोड(पाठ स) {
    सूची बाइट्स = सं_यूटीएफ8_एन्कोड(स);
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(बाइट्स)) {
        संख्या ब = बाइट्स[इ];
        यदि (यूआरएल_अनारक्षित_है(ब)) {
            फल = फल + अक्षर_निर्माण(ब);
        } अन्यथा {
            फल = फल + "%" + बाएँ_भरो(हेक्स(ब), २, "0");
        }
        इ = इ + १;
    }
    परत् फल;
}

// percent-encoded पाठ → मूल पाठ (%XX और शाब्दिक दोनों — '+' शाब्दिक ही
// रहता, query-context-विशिष्ट "+ = space" के लिए यूआरएल_प्रश्न_पार्स देखो)
कार्य यूआरएल_प्रतिशत_डिकोड(पाठ स) {
    सूची बाइट्स = [];
    संख्या इ = ०;
    संख्या लं = लंबाई(स);
    यावत् (इ < लं) {
        पाठ च = उपखंड(स, इ, इ + १);
        यदि (च == "%") {
            यदि (इ + ३ > लं) {
                प्रक्षेपः "त्रुटिः — यूआरएल: अधूरा '%' एस्केप";
            }
            संख्या ऊ = अंक_मान(उपखंड(स, इ + १, इ + २));
            संख्या नी = अंक_मान(उपखंड(स, इ + २, इ + ३));
            यदि (ऊ < ० || ऊ > १५ || नी < ० || नी > १५) {
                प्रक्षेपः "त्रुटिः — यूआरएल: अमान्य hex अंक '%" + उपखंड(स, इ + १, इ + ३) + "'";
            }
            बाइट्स = जोड़ें(बाइट्स, ऊ * १६ + नी);
            इ = इ + ३;
        } अन्यथा {
            सूची यह_बाइट्स = सं_यूटीएफ8_एन्कोड(च);
            संख्या ज = ०;
            यावत् (ज < लंबाई(यह_बाइट्स)) {
                बाइट्स = जोड़ें(बाइट्स, यह_बाइट्स[ज]);
                ज = ज + १;
            }
            इ = इ + १;
        }
    }
    परत् सं_यूटीएफ8_डिकोड(बाइट्स);
}

// ===== आंतरिक =====

कार्य यूआरएल_अंक_पाठ_है(पाठ स) {
    यदि (लंबाई(स) == ०) { परत् असत्य; }
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, इ, इ + १));
        यदि (क < ४८ || क > ५७) { परत् असत्य; }
        इ = इ + १;
    }
    परत् सत्य;
}

// स में तीन खोज-लक्ष्यों ("/","?","#") में से जो सबसे पहले मिले, उसका
// सूचकांक (या न मिलने पर लंबाई(स), यानि "अंत")
कार्य यूआरएल_अगला_सीमा_चिह्न(पाठ स) {
    संख्या सीमा = लंबाई(स);
    संख्या स1 = खोजें(स, "/");
    संख्या स2 = खोजें(स, "?");
    संख्या स3 = खोजें(स, "#");
    यदि (स1 >= ० && स1 < सीमा) { सीमा = स1; }
    यदि (स2 >= ० && स2 < सीमा) { सीमा = स2; }
    यदि (स3 >= ० && स3 < सीमा) { सीमा = स3; }
    परत् सीमा;
}

// ===== पार्स / निर्माण =====

// URL पाठ → {"योजना","प्रयोक्ता","मेज़बान","पोर्ट","पथ","प्रश्न","खंड"}
// प्रयोक्ता/पोर्ट अनुपस्थित होने पर शून्यम्; पथ/प्रश्न/खंड अनुपस्थित होने
// पर "" (रिक्त पाठ, शून्यम् नहीं — यूआरएल_बनाओ में जोड़ने में आसान रहे)
कार्य यूआरएल_पार्स(पाठ यू) {
    शब्दकोश फल = {};
    फल["योजना"] = "";
    फल["प्रयोक्ता"] = शून्यम्;
    फल["मेज़बान"] = शून्यम्;
    फल["पोर्ट"] = शून्यम्;
    फल["पथ"] = "";
    फल["प्रश्न"] = "";
    फल["खंड"] = "";

    संख्या योजना_सू = खोजें(यू, ":");
    यदि (योजना_सू < ०) {
        प्रक्षेपः "त्रुटिः — यूआरएल: योजना (scheme) नहीं मिली — ':' अनुपस्थित";
    }
    फल["योजना"] = उपखंड(यू, ०, योजना_सू);
    पाठ शेष = उपखंड(यू, योजना_सू + १, लंबाई(यू));

    यदि (लंबाई(शेष) >= २ && उपखंड(शेष, ०, २) == "//") {
        शेष = उपखंड(शेष, २, लंबाई(शेष));
        संख्या प्राधिकार_अंत = यूआरएल_अगला_सीमा_चिह्न(शेष);
        पाठ प्राधिकार = उपखंड(शेष, ०, प्राधिकार_अंत);
        शेष = उपखंड(शेष, प्राधिकार_अंत, लंबाई(शेष));

        संख्या ऐट_सू = -१;
        संख्या ती = ०;
        यावत् (ती < लंबाई(प्राधिकार)) {
            यदि (उपखंड(प्राधिकार, ती, ती + १) == "@") { ऐट_सू = ती; }
            ती = ती + १;
        }
        यदि (ऐट_सू >= ०) {
            फल["प्रयोक्ता"] = उपखंड(प्राधिकार, ०, ऐट_सू);
            प्राधिकार = उपखंड(प्राधिकार, ऐट_सू + १, लंबाई(प्राधिकार));
        }

        संख्या कोलन_सू = खोजें(प्राधिकार, ":");
        यदि (कोलन_सू >= ०) {
            फल["मेज़बान"] = उपखंड(प्राधिकार, ०, कोलन_सू);
            पाठ पोर्ट_पाठ = उपखंड(प्राधिकार, कोलन_सू + १, लंबाई(प्राधिकार));
            यदि (न यूआरएल_अंक_पाठ_है(पोर्ट_पाठ)) {
                प्रक्षेपः "त्रुटिः — यूआरएल: अमान्य पोर्ट '" + पोर्ट_पाठ + "'";
            }
            फल["पोर्ट"] = आधार_से(पोर्ट_पाठ, १०);
        } अन्यथा {
            फल["मेज़बान"] = प्राधिकार;
        }
    }

    संख्या प्र_सू = खोजें(शेष, "?");
    संख्या ख_सू = खोजें(शेष, "#");

    यदि (प्र_सू >= ० && (ख_सू < ० || प्र_सू < ख_सू)) {
        फल["पथ"] = उपखंड(शेष, ०, प्र_सू);
        यदि (ख_सू >= ०) {
            फल["प्रश्न"] = उपखंड(शेष, प्र_सू + १, ख_सू);
            फल["खंड"] = उपखंड(शेष, ख_सू + १, लंबाई(शेष));
        } अन्यथा {
            फल["प्रश्न"] = उपखंड(शेष, प्र_सू + १, लंबाई(शेष));
        }
    } अन्यथा यदि (ख_सू >= ०) {
        फल["पथ"] = उपखंड(शेष, ०, ख_सू);
        फल["खंड"] = उपखंड(शेष, ख_सू + १, लंबाई(शेष));
    } अन्यथा {
        फल["पथ"] = शेष;
    }

    परत् फल;
}

// {"योजना","प्रयोक्ता","मेज़बान","पोर्ट","पथ","प्रश्न","खंड"} → URL पाठ
// (यूआरएल_पार्स का व्युत्क्रम — अनुपस्थित वैकल्पिक भाग शून्यम् हो सकते)
कार्य यूआरएल_बनाओ(शब्दकोश भाग) {
    पाठ फल = भाग["योजना"] + ":";
    यदि (भाग["मेज़बान"] != शून्यम् && लंबाई(भाग["मेज़बान"]) > ०) {
        फल = फल + "//";
        यदि (भाग["प्रयोक्ता"] != शून्यम्) {
            फल = फल + भाग["प्रयोक्ता"] + "@";
        }
        फल = फल + भाग["मेज़बान"];
        यदि (भाग["पोर्ट"] != शून्यम्) {
            फल = फल + ":" + ("" + भाग["पोर्ट"]);
        }
    }
    यदि (भाग["पथ"] != शून्यम्) {
        फल = फल + भाग["पथ"];
    }
    यदि (भाग["प्रश्न"] != शून्यम् && लंबाई(भाग["प्रश्न"]) > ०) {
        फल = फल + "?" + भाग["प्रश्न"];
    }
    यदि (भाग["खंड"] != शून्यम् && लंबाई(भाग["खंड"]) > ०) {
        फल = फल + "#" + भाग["खंड"];
    }
    परत् फल;
}

// ===== query-string (application/x-www-form-urlencoded सम्मेलन) =====

// "a=1&b=2" → {"a":"1", "b":"2"} — कुंजी/मान दोनों percent-decode होते,
// '+' यहाँ space माना जाता (सामान्य percent-decode से अलग, फ़ॉर्म-सम्मेलन)।
// दोहराई कुंजी पर आख़िरी मान जीतता (v1 सीमा — सूची-of-values नहीं)।
कार्य यूआरएल_प्रश्न_पार्स(पाठ प्रश्न) {
    शब्दकोश फल = {};
    यदि (लंबाई(प्रश्न) == ०) { परत् फल; }
    सूची जोड़े = विभाजित(प्रश्न, "&");
    संख्या इ = ०;
    यावत् (इ < लंबाई(जोड़े)) {
        पाठ जोड़ा = जोड़े[इ];
        यदि (लंबाई(जोड़ा) > ०) {
            संख्या बराबर_सू = खोजें(जोड़ा, "=");
            पाठ कुंजी_कच्ची = जोड़ा;
            पाठ मान_कच्चा = "";
            यदि (बराबर_सू >= ०) {
                कुंजी_कच्ची = उपखंड(जोड़ा, ०, बराबर_सू);
                मान_कच्चा = उपखंड(जोड़ा, बराबर_सू + १, लंबाई(जोड़ा));
            }
            पाठ कुंजी = यूआरएल_प्रतिशत_डिकोड(बदलें(कुंजी_कच्ची, "+", " "));
            पाठ मूल्य = यूआरएल_प्रतिशत_डिकोड(बदलें(मान_कच्चा, "+", " "));
            फल[कुंजी] = मूल्य;
        }
        इ = इ + १;
    }
    परत् फल;
}

// {"a":"1", "b":"2"} → "a=1&b=2" — कुंजियाँ वर्णानुक्रम में (कुंजियाँ()
// का क्रम interp/native में अलग होता — भाषा-सीमा, सूत्र README देखो —
// इसलिए नियतात्मक/दोहराने-योग्य आउटपुट के लिए यहाँ क्रमबद्ध किया जाता)
कार्य यूआरएल_प्रश्न_बनाओ(शब्दकोश प्रश्न) {
    सूची कुं = क्रमबद्ध(कुंजियाँ(प्रश्न));
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        यदि (इ > ०) { फल = फल + "&"; }
        पाठ क = कुं[इ];
        फल = फल + यूआरएल_प्रतिशत_एन्कोड(क) + "=" + यूआरएल_प्रतिशत_एन्कोड("" + प्रश्न[क]);
        इ = इ + १;
    }
    परत् फल;
}
