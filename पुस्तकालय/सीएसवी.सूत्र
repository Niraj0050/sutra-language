// पुस्तकालय/सीएसवी.सूत्र — CSV पार्स / बनाओ (RFC 4180)
// ============================================================
// आयात "पुस्तकालय/सीएसवी.सूत्र";
//
//   सूची पंक्तियाँ = सीएसवी_पार्स("नाम,आयु\nराम,30\n\"श्याम, जूनियर\",25");
//   // [["नाम","आयु"], ["राम","30"], ["श्याम, जूनियर","25"]]
//
//   सूची लोग = सीएसवी_शब्दकोश_पार्स("नाम,आयु\nराम,30\nश्याम,25");
//   // [{नाम:"राम", आयु:"30"}, {नाम:"श्याम", आयु:"25"}]
//
//   सीएसवी_बनाओ([["अ","ब"], ["1","2,3"]])   // "अ,ब\r\n1,\"2,3\"\r\n"
//
// नियम (RFC 4180): उद्धृत क्षेत्र `"..."` में `,` `\n` `"` (जोड़ी `""` से)
// रह सकते; CRLF या LF दोनों पंक्ति-अंत; अंतिम पंक्ति बिना newline भी चलती;
// पूर्णतः-खाली अंतिम पंक्ति छोड़ी जाती। सब क्षेत्र पाठ लौटते (संख्या-रूपांतरण
// caller करे)।
// ============================================================

// ---- पार्स ----

कार्य सीएसवी_पार्स(पाठ स्रोत) {
    परत् सीएसवी_पार्स_सीमांकक(स्रोत, ",");
}

// सीमांकक एक अक्षर (TSV = "\t", ";" आदि)
कार्य सीएसवी_पार्स_सीमांकक(पाठ स्रोत, पाठ सीमांकक) {
    सूची पंक्तियाँ = [];
    सूची क्षेत्र = [];
    पाठ बफ = "";
    मान उद्धृत = असत्य;         // अभी उद्धरण के भीतर?
    मान क्षेत्र_शुरू = सत्य;     // वर्तमान क्षेत्र में अभी कुछ नहीं आया
    मान पंक्ति_में_कुछ = असत्य; // इस पंक्ति में कोई अक्षर/क्षेत्र दिखा?

    संख्या इ = ०;
    संख्या लं = लंबाई(स्रोत);
    यावत् (इ < लं) {
        पाठ च = उपखंड(स्रोत, इ, इ + १);

        यदि (उद्धृत) {
            यदि (च == "\"") {
                // जोड़ी "" → literal "
                यदि (इ + १ < लं && उपखंड(स्रोत, इ + १, इ + २) == "\"") {
                    बफ = बफ + "\"";
                    इ = इ + २;
                } अन्यथा {
                    उद्धृत = असत्य;
                    इ = इ + १;
                }
            } अन्यथा {
                बफ = बफ + च;
                इ = इ + १;
            }
        } अन्यथा {
            यदि (च == "\"" && क्षेत्र_शुरू) {
                उद्धृत = सत्य;
                क्षेत्र_शुरू = असत्य;
                पंक्ति_में_कुछ = सत्य;
                इ = इ + १;
            } अन्यथा यदि (च == सीमांकक) {
                क्षेत्र = जोड़ें(क्षेत्र, बफ);
                बफ = "";
                क्षेत्र_शुरू = सत्य;
                पंक्ति_में_कुछ = सत्य;
                इ = इ + १;
            } अन्यथा यदि (च == "\n" || च == "\r") {
                // पंक्ति-अंत (\r\n को एक मानो)
                यदि (च == "\r" && इ + १ < लं && उपखंड(स्रोत, इ + १, इ + २) == "\n") {
                    इ = इ + २;
                } अन्यथा {
                    इ = इ + १;
                }
                यदि (पंक्ति_में_कुछ || लंबाई(बफ) > ० || लंबाई(क्षेत्र) > ०) {
                    क्षेत्र = जोड़ें(क्षेत्र, बफ);
                    पंक्तियाँ = जोड़ें(पंक्तियाँ, क्षेत्र);
                }
                क्षेत्र = [];
                बफ = "";
                क्षेत्र_शुरू = सत्य;
                पंक्ति_में_कुछ = असत्य;
            } अन्यथा {
                बफ = बफ + च;
                क्षेत्र_शुरू = असत्य;
                पंक्ति_में_कुछ = सत्य;
                इ = इ + १;
            }
        }
    }

    // अंतिम क्षेत्र/पंक्ति (बिना trailing newline)
    यदि (पंक्ति_में_कुछ || लंबाई(बफ) > ० || लंबाई(क्षेत्र) > ०) {
        क्षेत्र = जोड़ें(क्षेत्र, बफ);
        पंक्तियाँ = जोड़ें(पंक्तियाँ, क्षेत्र);
    }
    परत् पंक्तियाँ;
}

// पहली पंक्ति = हेडर → आगे की हर पंक्ति एक शब्दकोश
कार्य सीएसवी_शब्दकोश_पार्स(पाठ स्रोत) {
    परत् सीएसवी_शब्दकोश_पार्स_सीमांकक(स्रोत, ",");
}

कार्य सीएसवी_शब्दकोश_पार्स_सीमांकक(पाठ स्रोत, पाठ सीमांकक) {
    सूची पंक्तियाँ = सीएसवी_पार्स_सीमांकक(स्रोत, सीमांकक);
    सूची फल = [];
    यदि (लंबाई(पंक्तियाँ) == ०) { परत् फल; }
    सूची हेडर = पंक्तियाँ[०];
    संख्या प = १;
    यावत् (प < लंबाई(पंक्तियाँ)) {
        सूची पं = पंक्तियाँ[प];
        शब्दकोश रो = {};
        संख्या क = ०;
        यावत् (क < लंबाई(हेडर)) {
            पाठ मान_क = "";
            यदि (क < लंबाई(पं)) { मान_क = पं[क]; }
            रो[हेडर[क]] = मान_क;
            क = क + १;
        }
        फल = जोड़ें(फल, रो);
        प = प + १;
    }
    परत् फल;
}

// ---- बनाओ ----

// एक क्षेत्र को उद्धृत करो अगर उसमें सीमांकक / " / newline हो
कार्य सीएसवी_क्षेत्र_बनाओ(पाठ मान_क, पाठ सीमांकक) {
    मान चाहिए = असत्य;
    संख्या इ = ०;
    यावत् (इ < लंबाई(मान_क)) {
        पाठ च = उपखंड(मान_क, इ, इ + १);
        यदि (च == सीमांकक || च == "\"" || च == "\n" || च == "\r") { चाहिए = सत्य; }
        इ = इ + १;
    }
    यदि (चाहिए == असत्य) { परत् मान_क; }
    // " को "" करो
    पाठ बच = "";
    इ = ०;
    यावत् (इ < लंबाई(मान_क)) {
        पाठ च = उपखंड(मान_क, इ, इ + १);
        यदि (च == "\"") { बच = बच + "\"\""; }
        अन्यथा { बच = बच + च; }
        इ = इ + १;
    }
    परत् "\"" + बच + "\"";
}

कार्य सीएसवी_बनाओ(सूची पंक्तियाँ) {
    परत् सीएसवी_बनाओ_सीमांकक(पंक्तियाँ, ",");
}

कार्य सीएसवी_बनाओ_सीमांकक(सूची पंक्तियाँ, पाठ सीमांकक) {
    पाठ फल = "";
    संख्या प = ०;
    यावत् (प < लंबाई(पंक्तियाँ)) {
        सूची पं = पंक्तियाँ[प];
        संख्या क = ०;
        यावत् (क < लंबाई(पं)) {
            यदि (क > ०) { फल = फल + सीमांकक; }
            फल = फल + सीएसवी_क्षेत्र_बनाओ("" + पं[क], सीमांकक);
            क = क + १;
        }
        फल = फल + "\r\n";
        प = प + १;
    }
    परत् फल;
}

// शब्दकोश-सूची → CSV (हेडर = दिया क्रम; हर रो उसी क्रम में)
कार्य सीएसवी_शब्दकोश_बनाओ(सूची रो_सूची, सूची हेडर) {
    सूची पंक्तियाँ = [];
    पंक्तियाँ = जोड़ें(पंक्तियाँ, हेडर);
    संख्या प = ०;
    यावत् (प < लंबाई(रो_सूची)) {
        शब्दकोश रो = रो_सूची[प];
        सूची पं = [];
        संख्या क = ०;
        यावत् (क < लंबाई(हेडर)) {
            मान म = रो[हेडर[क]];
            यदि (म == शून्यम्) { म = ""; }
            पं = जोड़ें(पं, "" + म);
            क = क + १;
        }
        पंक्तियाँ = जोड़ें(पंक्तियाँ, पं);
        प = प + १;
    }
    परत् सीएसवी_बनाओ(पंक्तियाँ);
}
