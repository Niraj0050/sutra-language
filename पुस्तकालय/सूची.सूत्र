// पुस्तकालय/सूची.सूत्र — सूची (list) उपयोगिता-कार्य
// ============================================================
// आयात "पुस्तकालय/सूची.सूत्र";
//
// सूत्र में प्रथम-श्रेणी कार्य अभी नहीं हैं, इसलिए map/filter/reduce
// जैसे उच्च-क्रम कार्य नहीं — पर ठोस सूची-संक्रियाएँ सब यहाँ हैं।
// तुलना (< > == ) अब पाठ और संख्या दोनों पर सही चलती है, तो क्रमबद्ध /
// न्यूनतम_का / द्विआधारी_खोज मिश्रित-समरूप सूची पर काम करती हैं।
// सारे कार्य नई सूची लौटाते हैं — मूल अछूती रहती है।
// ============================================================

// उलटा क्रम
कार्य उलटा(सूची स) {
    सूची फल = [];
    संख्या इ = लंबाई(स) - १;
    यावत् (इ >= ०) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ - १;
    }
    परत् फल;
}

// सब तत्वों का योग (संख्या/दशमलव मान लेकर)
कार्य योग(सूची स) {
    मान कुल = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        कुल = कुल + स[इ];
        इ = इ + १;
    }
    परत् कुल;
}

// सब तत्वों का गुणनफल
कार्य गुणनफल(सूची स) {
    मान कुल = १;
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        कुल = कुल * स[इ];
        इ = इ + १;
    }
    परत् कुल;
}

// न्यूनतम तत्व (रिक्त सूची → शून्यम्)
कार्य न्यूनतम_का(सूची स) {
    यदि (लंबाई(स) == ०) { परत् शून्यम्; }
    मान न्यून = स[०];
    संख्या इ = १;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] < न्यून) { न्यून = स[इ]; }
        इ = इ + १;
    }
    परत् न्यून;
}

// अधिकतम तत्व (रिक्त सूची → शून्यम्)
कार्य अधिकतम_का(सूची स) {
    यदि (लंबाई(स) == ०) { परत् शून्यम्; }
    मान महत् = स[०];
    संख्या इ = १;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] > महत्) { महत् = स[इ]; }
        इ = इ + १;
    }
    परत् महत्;
}

// क्या म सूची में है?
कार्य समाहित(सूची स, मान म) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] == म) { परत् सत्य; }
        इ = इ + १;
    }
    परत् असत्य;
}

// म का पहला अनुक्रमांक, वरना -१
कार्य अनुक्रमणिका_की(सूची स, मान म) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] == म) { परत् इ; }
        इ = इ + १;
    }
    परत् -१;
}

// म कितनी बार आता है
कार्य गणना_की(सूची स, मान म) {
    संख्या ग = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] == म) { ग = ग + १; }
        इ = इ + १;
    }
    परत् ग;
}

// डुप्लिकेट हटाओ (पहली उपस्थिति का क्रम बना रहता है)
कार्य अद्वितीय(सूची स) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (न समाहित(फल, स[इ])) {
            फल = जोड़ें(फल, स[इ]);
        }
        इ = इ + १;
    }
    परत् फल;
}

// एक स्तर समतल: [[१,२],[३]] → [१,२,३]  (गैर-सूची तत्व ज्यों के त्यों)
कार्य समतल(सूची स) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        मान त = स[इ];
        यदि (प्रकार(त) == "सूची") {
            संख्या ज = ०;
            यावत् (ज < लंबाई(त)) {
                फल = जोड़ें(फल, त[ज]);
                ज = ज + १;
            }
        } अन्यथा {
            फल = जोड़ें(फल, त);
        }
        इ = इ + १;
    }
    परत् फल;
}

// आकार-आकार के टुकड़ों में बाँटो: टुकड़े([१,२,३,४,५], २) → [[१,२],[३,४],[५]]
कार्य टुकड़े(सूची स, संख्या आकार) {
    सूची फल = [];
    यदि (आकार <= ०) { परत् फल; }
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        सूची भाग = [];
        संख्या ज = ०;
        यावत् (ज < आकार && इ + ज < लंबाई(स)) {
            भाग = जोड़ें(भाग, स[इ + ज]);
            ज = ज + १;
        }
        फल = जोड़ें(फल, भाग);
        इ = इ + आकार;
    }
    परत् फल;
}

// [आरंभ, अंत) पूर्णांक श्रेणी
कार्य श्रेणी(संख्या आरंभ, संख्या अंत) {
    सूची फल = [];
    संख्या इ = आरंभ;
    यावत् (इ < अंत) {
        फल = जोड़ें(फल, इ);
        इ = इ + १;
    }
    परत् फल;
}

// चरण-सहित श्रेणी (चरण धनात्मक या ऋणात्मक)
कार्य श्रेणी_चरण(संख्या आरंभ, संख्या अंत, संख्या चरण) {
    सूची फल = [];
    यदि (चरण == ०) { परत् फल; }
    संख्या इ = आरंभ;
    यदि (चरण > ०) {
        यावत् (इ < अंत) { फल = जोड़ें(फल, इ); इ = इ + चरण; }
    } अन्यथा {
        यावत् (इ > अंत) { फल = जोड़ें(फल, इ); इ = इ + चरण; }
    }
    परत् फल;
}

// गिन प्रतियाँ: भरो(३, ०) → [०, ०, ०]
कार्य भरो(संख्या गिन, मान म) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < गिन) {
        फल = जोड़ें(फल, म);
        इ = इ + १;
    }
    परत् फल;
}

// पहला / अंतिम तत्व (रिक्त → शून्यम्)
कार्य पहला(सूची स) {
    यदि (लंबाई(स) == ०) { परत् शून्यम्; }
    परत् स[०];
}
कार्य पिछला(सूची स) {
    यदि (लंबाई(स) == ०) { परत् शून्यम्; }
    परत् स[लंबाई(स) - १];
}

// पहले गिन तत्व / पहले गिन छोड़कर बाकी
कार्य लो(सूची स, संख्या गिन) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < गिन && इ < लंबाई(स)) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    परत् फल;
}
कार्य छोड़ो(सूची स, संख्या गिन) {
    सूची फल = [];
    संख्या इ = गिन;
    यदि (इ < ०) { इ = ०; }
    यावत् (इ < लंबाई(स)) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// खंड [आरंभ, अंत)  (ऋणात्मक अनुक्रमांक समर्थित नहीं)
कार्य खंड(सूची स, संख्या आरंभ, संख्या अंत) {
    सूची फल = [];
    संख्या अ = आरंभ;
    यदि (अ < ०) { अ = ०; }
    संख्या ब = अंत;
    यदि (ब > लंबाई(स)) { ब = लंबाई(स); }
    संख्या इ = अ;
    यावत् (इ < ब) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// सब तत्व सत्य? / कोई तत्व सत्य?
कार्य सब_सत्य(सूची स) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (न स[इ]) { परत् असत्य; }
        इ = इ + १;
    }
    परत् सत्य;
}
कार्य कोई_सत्य(सूची स) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ]) { परत् सत्य; }
        इ = इ + १;
    }
    परत् असत्य;
}

// युग्म([१,२,३], ["अ","ब"]) → [[१,"अ"], [२,"ब"]]  (छोटी लंबाई तक)
कार्य युग्म(सूची अ, सूची ब) {
    सूची फल = [];
    संख्या गिन = लंबाई(अ);
    यदि (लंबाई(ब) < गिन) { गिन = लंबाई(ब); }
    संख्या इ = ०;
    यावत् (इ < गिन) {
        फल = जोड़ें(फल, [अ[इ], ब[इ]]);
        इ = इ + १;
    }
    परत् फल;
}

// सूचियों की सूची को एक में जोड़ो: सपाट_जोड़([[१,२],[३],[४,५]]) → [१,२,३,४,५]
कार्य सपाट_जोड़(सूची सूचियाँ) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(सूचियाँ)) {
        सूची भाग = सूचियाँ[इ];
        संख्या ज = ०;
        यावत् (ज < लंबाई(भाग)) {
            फल = जोड़ें(फल, भाग[ज]);
            ज = ज + १;
        }
        इ = इ + १;
    }
    परत् फल;
}

// ===== क्रमण (sorting) — मर्ज-सॉर्ट, स्थिर, O(n log n) =====

कार्य सूची_विलय(सूची अ, सूची ब) {
    सूची फल = [];
    संख्या इ = ०;
    संख्या ज = ०;
    यावत् (इ < लंबाई(अ) && ज < लंबाई(ब)) {
        यदि (अ[इ] <= ब[ज]) {
            फल = जोड़ें(फल, अ[इ]);
            इ = इ + १;
        } अन्यथा {
            फल = जोड़ें(फल, ब[ज]);
            ज = ज + १;
        }
    }
    यावत् (इ < लंबाई(अ)) { फल = जोड़ें(फल, अ[इ]); इ = इ + १; }
    यावत् (ज < लंबाई(ब)) { फल = जोड़ें(फल, ब[ज]); ज = ज + १; }
    परत् फल;
}

// आरोही क्रम में क्रमबद्ध नई सूची
कार्य क्रमबद्ध(सूची स) {
    यदि (लंबाई(स) <= १) { परत् स; }
    संख्या मध्य = लंबाई(स) / २;
    सूची बायाँ = क्रमबद्ध(खंड(स, ०, मध्य));
    सूची दायाँ = क्रमबद्ध(खंड(स, मध्य, लंबाई(स)));
    परत् सूची_विलय(बायाँ, दायाँ);
}

// अवरोही क्रम
कार्य क्रमबद्ध_अवरोही(सूची स) {
    परत् उलटा(क्रमबद्ध(स));
}

// क्या सूची आरोही क्रम में है?
कार्य है_क्रमित(सूची स) {
    संख्या इ = १;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] < स[इ - १]) { परत् असत्य; }
        इ = इ + १;
    }
    परत् सत्य;
}

// क्रमबद्ध सूची में द्विआधारी खोज → अनुक्रमांक, वरना -१
कार्य द्विआधारी_खोज(सूची स, मान लक्ष्य) {
    संख्या निम्न = ०;
    संख्या उच्च = लंबाई(स) - १;
    यावत् (निम्न <= उच्च) {
        संख्या मध्य = (निम्न + उच्च) / २;
        यदि (स[मध्य] == लक्ष्य) { परत् मध्य; }
        यदि (स[मध्य] < लक्ष्य) {
            निम्न = मध्य + १;
        } अन्यथा {
            उच्च = मध्य - १;
        }
    }
    परत् -१;
}
