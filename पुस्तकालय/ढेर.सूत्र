// पुस्तकालय/ढेर.सूत्र — ढेर (Stack, LIFO)
// ============================================================
// आयात "पुस्तकालय/ढेर.सूत्र";
//   मान ढ = नवीन ढेर();
//   ढ.धकेलो(१); ढ.धकेलो(२); ढ.धकेलो(३);
//   ढ.निकालो()   → ३   (और ढेर से हट जाता है)
//   ढ.झाँको()    → २   (हटता नहीं)
//   ढ.आकार()     → २
//   ढ.खाली_है()  → असत्य
// ============================================================

वर्ग ढेर {
    मान तत्व_क = ०;

    कार्य रचना() {
        स्व.तत्व_क = [];
    }

    कार्य धकेलो(मान म) {
        स्व.तत्व_क = जोड़ें(स्व.तत्व_क, म);
    }

    // शीर्ष तत्व लौटाओ और हटाओ (खाली → शून्यम्)
    कार्य निकालो() {
        संख्या गिन = लंबाई(स्व.तत्व_क);
        यदि (गिन == ०) { परत् शून्यम्; }
        मान शीर्ष = स्व.तत्व_क[गिन - १];
        स्व.तत्व_क = निकालें(स्व.तत्व_क);
        परत् शीर्ष;
    }

    // शीर्ष तत्व देखो, हटाओ मत (खाली → शून्यम्)
    कार्य झाँको() {
        संख्या गिन = लंबाई(स्व.तत्व_क);
        यदि (गिन == ०) { परत् शून्यम्; }
        परत् स्व.तत्व_क[गिन - १];
    }

    कार्य आकार() {
        परत् लंबाई(स्व.तत्व_क);
    }

    कार्य खाली_है() {
        परत् लंबाई(स्व.तत्व_क) == ०;
    }
}
