// पुस्तकालय/नेटवर्क.सूत्र — TCP क्लाइंट नेटवर्किंग (Winsock2 FFI पर आधारित)
// ============================================================
// आयात "पुस्तकालय/नेटवर्क.सूत्र";
//
//   नेटवर्क_आरंभ();                                     // प्रक्रिया-जीवनकाल में एक बार
//   शब्दकोश सं = नेटवर्क_जोड़ो("93.184.216.34", 80);     // संख्यात्मक IPv4 से
//   // या सीधे होस्टनाम से (DNS):
//   शब्दकोश सं2 = नेटवर्क_होस्ट_जोड़ो("example.com", 80);
//   नेटवर्क_भेजो_पाठ(सं["सॉकेट"], "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n");
//   पाठ उत्तर = नेटवर्क_सब_पाओ_पाठ(सं["सॉकेट"]);
//   नेटवर्क_बंद(सं["सॉकेट"]);
//   नेटवर्क_सफाई();                                      // प्रक्रिया-जीवनकाल के अंत में
//
//   // सुविधा — पूरा राउंड-ट्रिप एक कॉल में:
//   पाठ पृष्ठ = नेटवर्क_एचटीटीपी_गेट("example.com", 80, "/");
//
// विन32.सूत्र जैसा — विदेशी (Win32/Winsock2 DLL) पर आधारित असली OS क्षमता,
// पर struct-packing/byte-order/hostent-पार्सिंग/algorithm पूरी तरह मौलिक
// Sutra कोड, किसी socket-library का पोर्ट नहीं — OS API कॉल करना FFI का
// सामान्य उपयोग है (हर native भाषा यही करती है), ऊपर की सारी लॉजिक अपनी।
//
// v1 दायरा (जानबूझकर सीमित): सिर्फ़ TCP क्लाइंट (connect/send/recv), सिर्फ़
// IPv4, कोई TLS/HTTPS नहीं (plain HTTP ही काम करेगा), कोई server/listen/
// accept नहीं, gethostbyname (पुराना पर सरल API — getaddrinfo नहीं, IPv4-
// only काफ़ी है v1 के लिए)।
// ============================================================

आयात "पुस्तकालय/संकुचन.सूत्र";   // सं_यूटीएफ8_एन्कोड/डिकोड पुनःप्रयोग

// ---- कच्चे बाइट-बफर सहायक (अंतर्_पढ़*/लिख* पर, विन32.सूत्र जैसा पैटर्न) ----

कार्य ज_बफर(संख्या आकार) {
    पाठ फल = "";
    संख्या इ = 0;
    यावत् (इ < आकार) { फल = फल + " "; इ = इ + 1; }
    परत् फल;
}
कार्य ज_लिख1(संख्या पता, संख्या ऑफ, संख्या मू) { अंतर्_लिख1(पता, ऑफ, बिट_और(मू, 255)); परत् 0; }
कार्य ज_लिख2(संख्या पता, संख्या ऑफ, संख्या मू) {
    ज_लिख1(पता, ऑफ, मू);
    ज_लिख1(पता, ऑफ + 1, दक्षिण_सरक(मू, 8));
    परत् 0;
}
कार्य ज_लिख4(संख्या पता, संख्या ऑफ, संख्या मू) {
    ज_लिख1(पता, ऑफ, मू);
    ज_लिख1(पता, ऑफ + 1, दक्षिण_सरक(मू, 8));
    ज_लिख1(पता, ऑफ + 2, दक्षिण_सरक(मू, 16));
    ज_लिख1(पता, ऑफ + 3, दक्षिण_सरक(मू, 24));
    परत् 0;
}
कार्य ज_पढ़1(संख्या पता, संख्या ऑफ) { परत् अंतर्_पढ़1(पता, ऑफ); }
कार्य ज_पढ़4(संख्या पता, संख्या ऑफ) {
    संख्या ब0 = ज_पढ़1(पता, ऑफ);
    संख्या ब1 = ज_पढ़1(पता, ऑफ + 1);
    संख्या ब2 = ज_पढ़1(पता, ऑफ + 2);
    संख्या ब3 = ज_पढ़1(पता, ऑफ + 3);
    परत् ब0 + ब1 * 256 + ब2 * 65536 + ब3 * 16777216;
}
कार्य ज_पढ़8(संख्या पता, संख्या ऑफ) { परत् अंतर्_पढ़8(पता, ऑफ); }

// ---- विदेशी घोषणाएँ (ws2_32.dll) ----

विदेशी "ws2_32" "WSAStartup" ज_विनसॉक_आरंभ_रॉ(संख्या, संख्या);
विदेशी "ws2_32" "WSACleanup" ज_विनसॉक_सफाई_रॉ();
विदेशी "ws2_32" "socket" ज_सॉकेट_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "connect" ज_जोड़ो_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "send" ज_भेजो_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "ws2_32" "recv" ज_पाओ_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "ws2_32" "closesocket" ज_बंद_रॉ(संख्या);
विदेशी "ws2_32" "htons" ज_एचटीओएनएस(संख्या);
विदेशी "ws2_32" "inet_addr" ज_आइपी_रॉ(संख्या);
विदेशी "ws2_32" "gethostbyname" ज_होस्ट_रॉ(संख्या);

कार्य ज_पता_परिवार() { परत् 2; }
कार्य ज_धारा_प्रकार() { परत् 1; }

// ---- आरंभ/सफाई (प्रक्रिया-जीवनकाल में एक-एक बार) ----

कार्य नेटवर्क_आरंभ() {
    पाठ बफ = ज_बफर(512);   // WSADATA — सामग्री अनदेखी, बस जगह चाहिए
    संख्या फल = ज_विनसॉक_आरंभ_रॉ(514, विदेशी_पता(बफ));   // 514 = MAKEWORD(2,2)
    परत् फल == 0;
}
कार्य नेटवर्क_सफाई() {
    ज_विनसॉक_सफाई_रॉ();
    परत् 0;
}

// ---- sockaddr_in बनाना (16 बाइट: family@0(2) port@2(2) addr@4(4) zero@8(8)) ----

कार्य ज_पता_बनाओ(संख्या आइपी_रॉ, संख्या पोर्ट) {
    पाठ बफ = ज_बफर(16);
    संख्या प = विदेशी_पता(बफ);
    ज_लिख2(प, 0, ज_पता_परिवार());
    ज_लिख2(प, 2, ज_एचटीओएनएस(पोर्ट));
    ज_लिख4(प, 4, आइपी_रॉ);
    ज_लिख4(प, 8, 0);
    ज_लिख4(प, 12, 0);
    शब्दकोश फल = {};
    फल["_रॉ"] = बफ;
    फल["पता"] = प;
    परत् फल;
}

// ---- कनेक्शन बनाना ----

// संख्यात्मक IPv4 पते से (जैसे "93.184.216.34")
कार्य नेटवर्क_जोड़ो(पाठ आइपी, संख्या पोर्ट) {
    संख्या आइपी_बाइट = ज_आइपी_रॉ(विदेशी_पता(आइपी));
    संख्या सॉ = ज_सॉकेट_रॉ(ज_पता_परिवार(), ज_धारा_प्रकार(), 0);
    शब्दकोश परिणाम = {};
    यदि (सॉ < 0) {
        परिणाम["सफल"] = असत्य;
        परिणाम["सॉकेट"] = -1;
        परत् परिणाम;
    }
    शब्दकोश पता = ज_पता_बनाओ(आइपी_बाइट, पोर्ट);
    संख्या क्_फल = ज_जोड़ो_रॉ(सॉ, पता["पता"], 16);
    परिणाम["सफल"] = क्_फल == 0;
    परिणाम["सॉकेट"] = सॉ;
    परत् परिणाम;
}

// होस्टनाम से (DNS, gethostbyname — IPv4-only)। असफल → -1
कार्य नेटवर्क_होस्ट_खोजो(पाठ होस्टनाम) {
    संख्या ह = ज_होस्ट_रॉ(विदेशी_पता(होस्टनाम));
    यदि (ह == 0) { परत् -1; }
    संख्या सूची_पता = ज_पढ़8(ह, 24);         // hostent.h_addr_list
    यदि (सूची_पता == 0) { परत् -1; }
    संख्या पहला_पता = ज_पढ़8(सूची_पता, 0);     // *h_addr_list[0]
    यदि (पहला_पता == 0) { परत् -1; }
    परत् ज_पढ़4(पहला_पता, 0);                  // 4-बाइट IPv4, network-order पहले से
}

कार्य नेटवर्क_होस्ट_जोड़ो(पाठ होस्टनाम, संख्या पोर्ट) {
    संख्या आइपी_बाइट = नेटवर्क_होस्ट_खोजो(होस्टनाम);
    शब्दकोश परिणाम = {};
    यदि (आइपी_बाइट < 0) {
        परिणाम["सफल"] = असत्य;
        परिणाम["सॉकेट"] = -1;
        परत् परिणाम;
    }
    संख्या सॉ = ज_सॉकेट_रॉ(ज_पता_परिवार(), ज_धारा_प्रकार(), 0);
    यदि (सॉ < 0) {
        परिणाम["सफल"] = असत्य;
        परिणाम["सॉकेट"] = -1;
        परत् परिणाम;
    }
    शब्दकोश पता = ज_पता_बनाओ(आइपी_बाइट, पोर्ट);
    संख्या क्_फल = ज_जोड़ो_रॉ(सॉ, पता["पता"], 16);
    परिणाम["सफल"] = क्_फल == 0;
    परिणाम["सॉकेट"] = सॉ;
    परत् परिणाम;
}

// ---- भेजना/पाना ----

कार्य नेटवर्क_भेजो(संख्या सॉकेट, सूची बाइट्स) {
    संख्या लं = लंबाई(बाइट्स);
    पाठ बफ = ज_बफर(लं);
    संख्या प = विदेशी_पता(बफ);
    संख्या इ = 0;
    यावत् (इ < लं) {
        ज_लिख1(प, इ, बाइट्स[इ]);
        इ = इ + 1;
    }
    परत् ज_भेजो_रॉ(सॉकेट, प, लं, 0);
}
कार्य नेटवर्क_भेजो_पाठ(संख्या सॉकेट, पाठ स्रोत) {
    परत् नेटवर्क_भेजो(सॉकेट, सं_यूटीएफ8_एन्कोड(स्रोत));
}

// एक recv() कॉल — अधिकतम तक; कम मिल सकता है (रिक्त सूची = कनेक्शन बंद/त्रुटि)
कार्य नेटवर्क_पाओ(संख्या सॉकेट, संख्या अधिकतम) {
    पाठ बफ = ज_बफर(अधिकतम);
    संख्या प = विदेशी_पता(बफ);
    संख्या गिनती = ज_पाओ_रॉ(सॉकेट, प, अधिकतम, 0);
    सूची फल = [];
    यदि (गिनती <= 0) { परत् फल; }
    संख्या इ = 0;
    यावत् (इ < गिनती) {
        फल = जोड़ें(फल, ज_पढ़1(प, इ));
        इ = इ + 1;
    }
    परत् फल;
}

// कनेक्शन बंद होने तक सब कुछ पढ़ो (recv==0 पर रुके — सर्वर "Connection: close" माने)
कार्य नेटवर्क_सब_पाओ(संख्या सॉकेट) {
    सूची कुल = [];
    यावत् (सत्य) {
        सूची भाग = नेटवर्क_पाओ(सॉकेट, 4096);
        यदि (लंबाई(भाग) == 0) { विरामः; }
        संख्या इ = 0;
        यावत् (इ < लंबाई(भाग)) {
            कुल = जोड़ें(कुल, भाग[इ]);
            इ = इ + 1;
        }
    }
    परत् कुल;
}
कार्य नेटवर्क_सब_पाओ_पाठ(संख्या सॉकेट) {
    परत् सं_यूटीएफ8_डिकोड(नेटवर्क_सब_पाओ(सॉकेट));
}

कार्य नेटवर्क_बंद(संख्या सॉकेट) {
    ज_बंद_रॉ(सॉकेट);
    परत् 0;
}

// ---- सुविधा — एक कॉल में पूरा HTTP GET (सिर्फ़ plain HTTP, HTTPS नहीं) ----

कार्य नेटवर्क_एचटीटीपी_गेट(पाठ होस्टनाम, संख्या पोर्ट, पाठ पथ) {
    शब्दकोश सं = नेटवर्क_होस्ट_जोड़ो(होस्टनाम, पोर्ट);
    यदि (!सं["सफल"]) { परत् ""; }
    पाठ निवेदन = "GET " + पथ + " HTTP/1.1\r\nHost: " + होस्टनाम
                + "\r\nConnection: close\r\n\r\n";
    नेटवर्क_भेजो_पाठ(सं["सॉकेट"], निवेदन);
    पाठ उत्तर = नेटवर्क_सब_पाओ_पाठ(सं["सॉकेट"]);
    नेटवर्क_बंद(सं["सॉकेट"]);
    परत् उत्तर;
}
