// पुस्तकालय/जेसन.सूत्र — JSON बनाना और पार्स करना, शुद्ध सूत्र
// ============================================================
// आयात "पुस्तकालय/जेसन.सूत्र";
//   जेसन_बनाओ({"नाम": "सूत्र", "अंक": [१, २, ३]})
//     → {"नाम":"सूत्र","अंक":[१,२,३]}
//   जेसन_पार्स("{\"क\": 1, \"ख\": [true, null]}")
//     → शब्दकोश {क: १, ख: सूची [सत्य, शून्यम्]}
//
// समर्थित: object, array, string, number (पूर्णांक + दशमलव), true/false/null।
// escape: \" \\ \/ \n \t \r \b \f  (\\uXXXX अभी नहीं)।
//
// ⚠️ native-सीमा (tagged मान नहीं): जब कोई बूल/दशमलव मान `मान`-सीमा पार
// करके जेसन_बनाओ में पहुँचता (जैसे सूची/शब्दकोश-साहित्य का तत्व), native
// उसे संख्या से अलग नहीं कर पाता → बूल `1`/`0`, दशमलव पूर्णांक जैसा छप
// सकता। शीर्ष-स्तर सीधे तर्क (`जेसन_बनाओ(सत्य)`) पर काम करता। पार्स सही है।
// object कुंजियाँ क्रमबद्ध छपती हैं (interp/native एकरूपता + स्थिर output)।
// ============================================================

// कुंजी-सूची को पाठ-वार क्रमबद्ध (छोटा insertion sort — जेसन आत्मनिर्भर रहे)
कार्य जेसन_कुंजी_क्रम(सूची कुं) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) { फल = जोड़ें(फल, कुं[इ]); इ = इ + १; }
    संख्या क = १;
    यावत् (क < लंबाई(फल)) {
        पाठ वर्त = फल[क];
        संख्या ज = क - १;
        यावत् (ज >= ०) {
            पाठ पिछला = फल[ज];
            यदि (पिछला > वर्त) {
                फल[ज + १] = फल[ज];
                ज = ज - १;
            } अन्यथा {
                विरामः;
            }
        }
        फल[ज + १] = वर्त;
        क = क + १;
    }
    परत् फल;
}

// ===== बनाओ (serialize) =====

कार्य जेसन_पाठ_एस्केप(पाठ स) {
    पाठ फल = "\"";
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        संख्या क = अक्षर_मान(च);
        यदि (क == ३४) { फल = फल + "\\\""; }
        अन्यथा यदि (क == ९२) { फल = फल + "\\\\"; }
        अन्यथा यदि (क == १०) { फल = फल + "\\n"; }
        अन्यथा यदि (क == ९) { फल = फल + "\\t"; }
        अन्यथा यदि (क == १३) { फल = फल + "\\r"; }
        अन्यथा { फल = फल + च; }
        इ = इ + १;
    }
    परत् फल + "\"";
}

कार्य जेसन_बनाओ(मान म) {
    पाठ त = प्रकार(म);
    यदि (त == "शून्यम्") { परत् "null"; }
    यदि (त == "बूल") {
        यदि (म) { परत् "true"; }
        परत् "false";
    }
    यदि (त == "संख्या") { परत् "" + म; }
    यदि (त == "दशमलव") { परत् "" + म; }
    यदि (त == "पाठ") { परत् जेसन_पाठ_एस्केप(म); }
    यदि (त == "सूची") {
        पाठ फल = "[";
        संख्या इ = ०;
        यावत् (इ < लंबाई(म)) {
            यदि (इ > ०) { फल = फल + ","; }
            फल = फल + जेसन_बनाओ(म[इ]);
            इ = इ + १;
        }
        परत् फल + "]";
    }
    यदि (त == "शब्दकोश") {
        पाठ फल = "{";
        सूची कुं = जेसन_कुंजी_क्रम(कुंजियाँ(म));
        संख्या इ = ०;
        यावत् (इ < लंबाई(कुं)) {
            यदि (इ > ०) { फल = फल + ","; }
            फल = फल + जेसन_पाठ_एस्केप(कुं[इ]) + ":" + जेसन_बनाओ(म[कुं[इ]]);
            इ = इ + १;
        }
        परत् फल + "}";
    }
    परत् "null";
}

// सुंदर (indented) रूप
कार्य जेसन_सुंदर(मान म) {
    परत् जेसन_सुंदर_स्तर(म, ०);
}
कार्य जेसन_रिक्त(संख्या स्तर) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < स्तर) { फल = फल + "  "; इ = इ + १; }
    परत् फल;
}
कार्य जेसन_सुंदर_स्तर(मान म, संख्या स्तर) {
    पाठ त = प्रकार(म);
    यदि (त == "सूची") {
        यदि (लंबाई(म) == ०) { परत् "[]"; }
        पाठ फल = "[\n";
        संख्या इ = ०;
        यावत् (इ < लंबाई(म)) {
            यदि (इ > ०) { फल = फल + ",\n"; }
            फल = फल + जेसन_रिक्त(स्तर + १) + जेसन_सुंदर_स्तर(म[इ], स्तर + १);
            इ = इ + १;
        }
        परत् फल + "\n" + जेसन_रिक्त(स्तर) + "]";
    }
    यदि (त == "शब्दकोश") {
        सूची कुं = जेसन_कुंजी_क्रम(कुंजियाँ(म));
        यदि (लंबाई(कुं) == ०) { परत् "{}"; }
        पाठ फल = "{\n";
        संख्या इ = ०;
        यावत् (इ < लंबाई(कुं)) {
            यदि (इ > ०) { फल = फल + ",\n"; }
            फल = फल + जेसन_रिक्त(स्तर + १) + जेसन_पाठ_एस्केप(कुं[इ]) + ": "
                + जेसन_सुंदर_स्तर(म[कुं[इ]], स्तर + १);
            इ = इ + १;
        }
        परत् फल + "\n" + जेसन_रिक्त(स्तर) + "}";
    }
    परत् जेसन_बनाओ(म);
}

// ===== पार्स =====

कार्य जेसन_श्वेत_छोड़ो(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    यावत् (अव["स्थिति"] < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, अव["स्थिति"], अव["स्थिति"] + १));
        यदि (क == ३२ || क == ९ || क == १० || क == १३) {
            अव["स्थिति"] = अव["स्थिति"] + १;
        } अन्यथा {
            विरामः;
        }
    }
    परत् ०;
}

कार्य जेसन_झाँको(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    यदि (अव["स्थिति"] >= लंबाई(स)) { परत् ""; }
    परत् उपखंड(स, अव["स्थिति"], अव["स्थिति"] + १);
}

कार्य जेसन_मान_पार्स(शब्दकोश अव) {
    जेसन_श्वेत_छोड़ो(अव);
    पाठ च = जेसन_झाँको(अव);
    यदि (च == "{") { परत् जेसन_वस्तु_पार्स(अव); }
    यदि (च == "[") { परत् जेसन_सरणी_पार्स(अव); }
    यदि (च == "\"") { परत् जेसन_पाठ_पार्स(अव); }
    यदि (च == "t") { अव["स्थिति"] = अव["स्थिति"] + ४; परत् सत्य; }
    यदि (च == "f") { अव["स्थिति"] = अव["स्थिति"] + ५; परत् असत्य; }
    यदि (च == "n") { अव["स्थिति"] = अव["स्थिति"] + ४; परत् शून्यम्; }
    परत् जेसन_संख्या_पार्स(अव);
}

कार्य जेसन_पाठ_पार्स(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    अव["स्थिति"] = अव["स्थिति"] + १;   // खुला "
    पाठ फल = "";
    यावत् (अव["स्थिति"] < लंबाई(स)) {
        पाठ च = उपखंड(स, अव["स्थिति"], अव["स्थिति"] + १);
        यदि (च == "\"") {
            अव["स्थिति"] = अव["स्थिति"] + १;
            परत् फल;
        }
        यदि (च == "\\") {
            अव["स्थिति"] = अव["स्थिति"] + १;
            पाठ अगला = उपखंड(स, अव["स्थिति"], अव["स्थिति"] + १);
            यदि (अगला == "n") { फल = फल + अक्षर_निर्माण(१०); }
            अन्यथा यदि (अगला == "t") { फल = फल + अक्षर_निर्माण(९); }
            अन्यथा यदि (अगला == "r") { फल = फल + अक्षर_निर्माण(१३); }
            अन्यथा यदि (अगला == "b") { फल = फल + अक्षर_निर्माण(८); }
            अन्यथा यदि (अगला == "f") { फल = फल + अक्षर_निर्माण(१२); }
            अन्यथा यदि (अगला == "/") { फल = फल + "/"; }
            अन्यथा यदि (अगला == "\\") { फल = फल + "\\"; }
            अन्यथा यदि (अगला == "\"") { फल = फल + "\""; }
            अन्यथा { फल = फल + अगला; }
            अव["स्थिति"] = अव["स्थिति"] + १;
        } अन्यथा {
            फल = फल + च;
            अव["स्थिति"] = अव["स्थिति"] + १;
        }
    }
    परत् फल;
}

कार्य जेसन_संख्या_पार्स(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    पाठ अंकपाठ = "";
    संख्या दशमलव_है = ०;
    यावत् (अव["स्थिति"] < लंबाई(स)) {
        पाठ च = उपखंड(स, अव["स्थिति"], अव["स्थिति"] + १);
        संख्या क = अक्षर_मान(च);
        यदि ((क >= ४८ && क <= ५७) || च == "-" || च == "+") {
            अंकपाठ = अंकपाठ + च;
            अव["स्थिति"] = अव["स्थिति"] + १;
        } अन्यथा यदि (च == "." || च == "e" || च == "E") {
            दशमलव_है = १;
            अंकपाठ = अंकपाठ + च;
            अव["स्थिति"] = अव["स्थिति"] + १;
        } अन्यथा {
            विरामः;
        }
    }
    यदि (दशमलव_है == १) { परत् जेसन_दशमलव_बनाओ(अंकपाठ); }
    परत् जेसन_पूर्णांक_बनाओ(अंकपाठ);
}

कार्य जेसन_पूर्णांक_बनाओ(पाठ स) {
    संख्या फल = ०;
    संख्या इ = ०;
    संख्या चिह्न_न = १;
    यदि (लंबाई(स) > ०) {
        यदि (उपखंड(स, ०, १) == "-") { चिह्न_न = -१; इ = १; }
    }
    यावत् (इ < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, इ, इ + १));
        यदि (क >= ४८ && क <= ५७) {
            फल = फल * १० + (क - ४८);
        }
        इ = इ + १;
    }
    परत् चिह्न_न * फल;
}

// "3.14" जैसे सरल दशमलव (e-अंकन अनदेखा — पूर्णांक-भाग + अंश-भाग)
कार्य जेसन_दशमलव_बनाओ(पाठ स) {
    दशमलव चिह्न_द = १.०;
    संख्या इ = ०;
    यदि (लंबाई(स) > ०) {
        यदि (उपखंड(स, ०, १) == "-") { चिह्न_द = -१.०; इ = १; }
    }
    दशमलव पूर्ण_भाग = ०.०;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        यदि (च == ".") { इ = इ + १; विरामः; }
        संख्या क = अक्षर_मान(च);
        यदि (क >= ४८ && क <= ५७) {
            पूर्ण_भाग = पूर्ण_भाग * १०.० + (क - ४८);
        }
        इ = इ + १;
    }
    दशमलव अंश_भाग = ०.०;
    दशमलव स्थान_द = १.०;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        संख्या क = अक्षर_मान(च);
        यदि (क >= ४८ && क <= ५७) {
            स्थान_द = स्थान_द * १०.०;
            अंश_भाग = अंश_भाग + ((क - ४८) / स्थान_द);
        } अन्यथा यदि (च == "e" || च == "E") {
            विरामः;
        }
        इ = इ + १;
    }
    परत् चिह्न_द * (पूर्ण_भाग + अंश_भाग);
}

कार्य जेसन_सरणी_पार्स(शब्दकोश अव) {
    अव["स्थिति"] = अव["स्थिति"] + १;   // [
    सूची फल = [];
    जेसन_श्वेत_छोड़ो(अव);
    यदि (जेसन_झाँको(अव) == "]") {
        अव["स्थिति"] = अव["स्थिति"] + १;
        परत् फल;
    }
    यावत् (सत्य) {
        फल = जोड़ें(फल, जेसन_मान_पार्स(अव));
        जेसन_श्वेत_छोड़ो(अव);
        पाठ च = जेसन_झाँको(अव);
        अव["स्थिति"] = अव["स्थिति"] + १;
        यदि (च == "]") { विरामः; }
        // च == "," → अगला तत्व
    }
    परत् फल;
}

कार्य जेसन_वस्तु_पार्स(शब्दकोश अव) {
    अव["स्थिति"] = अव["स्थिति"] + १;   // {
    शब्दकोश फल = {};
    जेसन_श्वेत_छोड़ो(अव);
    यदि (जेसन_झाँको(अव) == "}") {
        अव["स्थिति"] = अव["स्थिति"] + १;
        परत् फल;
    }
    यावत् (सत्य) {
        जेसन_श्वेत_छोड़ो(अव);
        पाठ कुंजी = जेसन_पाठ_पार्स(अव);
        जेसन_श्वेत_छोड़ो(अव);
        अव["स्थिति"] = अव["स्थिति"] + १;   // :
        मान मूल्य = जेसन_मान_पार्स(अव);
        फल[कुंजी] = मूल्य;
        जेसन_श्वेत_छोड़ो(अव);
        पाठ च = जेसन_झाँको(अव);
        अव["स्थिति"] = अव["स्थिति"] + १;
        यदि (च == "}") { विरामः; }
        // च == "," → अगला युग्म
    }
    परत् फल;
}

// मुख्य प्रवेश
कार्य जेसन_पार्स(पाठ स) {
    शब्दकोश अव = {};
    अव["पाठ"] = स;
    अव["स्थिति"] = ०;
    परत् जेसन_मान_पार्स(अव);
}
