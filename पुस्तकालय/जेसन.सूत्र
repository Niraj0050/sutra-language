// पुस्तकालय/जेसन.सूत्र — JSON बनाना और पार्स करना, शुद्ध सूत्र
// ============================================================
// आयात "पुस्तकालय/जेसन.सूत्र";
//   जेसन_बनाओ({"नाम": "सूत्र", "अंक": [1, 2, 3]})
//     → {"नाम":"सूत्र","अंक":[1,2,3]}
//   जेसन_पार्स("{\"क\": 1, \"ख\": [true, null]}")
//     → शब्दकोश {क: 1, ख: सूची [सत्य, शून्यम्]}
//
// समर्थित: object, array, string, number (पूर्णांक + दशमलव), true/false/null।
// escape: \" \\ \/ \n \t \r \b \f  (\\uXXXX अभी नहीं)।
//
// ⚠️ native-सीमा (tagged मान नहीं): जब कोई बूल/दशमलव मान `मान`-सीमा पार
// करके जेसन_बनाओ में पहुँचता (जैसे सूची/शब्दकोश-साहित्य का तत्व), native
// उसे संख्या से अलग नहीं कर पाता → बूल `1`/`0`, दशमलव पूर्णांक जैसा छप
// सकता। शीर्ष-स्तर सीधे तर्क (`जेसन_बनाओ(सत्य)`) पर काम करता। पार्स सही है।
// object कुंजियाँ क्रमबद्ध छपती हैं (interp/native एकरूपता + स्थिर output)।
// ============================================================

// कुंजी-सूची को पाठ-वार क्रमबद्ध (छोटा insertion sort — जेसन आत्मनिर्भर रहे)
कार्य जेसन_कुंजी_क्रम(सूची कुं) {
    सूची फल = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(कुं)) { फल = जोड़ें(फल, कुं[इ]); इ = इ + 1; }
    संख्या क = 1;
    यावत् (क < लंबाई(फल)) {
        पाठ वर्त = फल[क];
        संख्या ज = क - 1;
        यावत् (ज >= 0) {
            पाठ पिछला = फल[ज];
            यदि (पिछला > वर्त) {
                फल[ज + 1] = फल[ज];
                ज = ज - 1;
            } अन्यथा {
                विरामः;
            }
        }
        फल[ज + 1] = वर्त;
        क = क + 1;
    }
    परत् फल;
}

// ===== बनाओ (serialize) =====

कार्य जेसन_पाठ_एस्केप(पाठ स) {
    पाठ फल = "\"";
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + 1);
        संख्या क = अक्षर_मान(च);
        यदि (क == 34) { फल = फल + "\\\""; }
        अन्यथा यदि (क == 92) { फल = फल + "\\\\"; }
        अन्यथा यदि (क == 10) { फल = फल + "\\n"; }
        अन्यथा यदि (क == 9) { फल = फल + "\\t"; }
        अन्यथा यदि (क == 13) { फल = फल + "\\r"; }
        अन्यथा { फल = फल + च; }
        इ = इ + 1;
    }
    परत् फल + "\"";
}

कार्य जेसन_बनाओ(मान म) {
    पाठ त = प्रकार(म);
    यदि (त == "शून्यम्") { परत् "null"; }
    यदि (त == "बूल") {
        यदि (म) { परत् "true"; }
        परत् "false";
    }
    यदि (त == "संख्या") { परत् "" + म; }
    यदि (त == "दशमलव") { परत् "" + म; }
    यदि (त == "पाठ") { परत् जेसन_पाठ_एस्केप(म); }
    यदि (त == "सूची") {
        पाठ फल = "[";
        संख्या इ = 0;
        यावत् (इ < लंबाई(म)) {
            यदि (इ > 0) { फल = फल + ","; }
            फल = फल + जेसन_बनाओ(म[इ]);
            इ = इ + 1;
        }
        परत् फल + "]";
    }
    यदि (त == "शब्दकोश") {
        पाठ फल = "{";
        सूची कुं = जेसन_कुंजी_क्रम(कुंजियाँ(म));
        संख्या इ = 0;
        यावत् (इ < लंबाई(कुं)) {
            यदि (इ > 0) { फल = फल + ","; }
            फल = फल + जेसन_पाठ_एस्केप(कुं[इ]) + ":" + जेसन_बनाओ(म[कुं[इ]]);
            इ = इ + 1;
        }
        परत् फल + "}";
    }
    परत् "null";
}

// सुंदर (indented) रूप
कार्य जेसन_सुंदर(मान म) {
    परत् जेसन_सुंदर_स्तर(म, 0);
}
कार्य जेसन_रिक्त(संख्या स्तर) {
    पाठ फल = "";
    संख्या इ = 0;
    यावत् (इ < स्तर) { फल = फल + "  "; इ = इ + 1; }
    परत् फल;
}
कार्य जेसन_सुंदर_स्तर(मान म, संख्या स्तर) {
    पाठ त = प्रकार(म);
    यदि (त == "सूची") {
        यदि (लंबाई(म) == 0) { परत् "[]"; }
        पाठ फल = "[\n";
        संख्या इ = 0;
        यावत् (इ < लंबाई(म)) {
            यदि (इ > 0) { फल = फल + ",\n"; }
            फल = फल + जेसन_रिक्त(स्तर + 1) + जेसन_सुंदर_स्तर(म[इ], स्तर + 1);
            इ = इ + 1;
        }
        परत् फल + "\n" + जेसन_रिक्त(स्तर) + "]";
    }
    यदि (त == "शब्दकोश") {
        सूची कुं = जेसन_कुंजी_क्रम(कुंजियाँ(म));
        यदि (लंबाई(कुं) == 0) { परत् "{}"; }
        पाठ फल = "{\n";
        संख्या इ = 0;
        यावत् (इ < लंबाई(कुं)) {
            यदि (इ > 0) { फल = फल + ",\n"; }
            फल = फल + जेसन_रिक्त(स्तर + 1) + जेसन_पाठ_एस्केप(कुं[इ]) + ": "
                + जेसन_सुंदर_स्तर(म[कुं[इ]], स्तर + 1);
            इ = इ + 1;
        }
        परत् फल + "\n" + जेसन_रिक्त(स्तर) + "}";
    }
    परत् जेसन_बनाओ(म);
}

// ===== पार्स =====

कार्य जेसन_श्वेत_छोड़ो(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    यावत् (अव["स्थिति"] < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, अव["स्थिति"], अव["स्थिति"] + 1));
        यदि (क == 32 || क == 9 || क == 10 || क == 13) {
            अव["स्थिति"] = अव["स्थिति"] + 1;
        } अन्यथा {
            विरामः;
        }
    }
    परत् 0;
}

कार्य जेसन_झाँको(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    यदि (अव["स्थिति"] >= लंबाई(स)) { परत् ""; }
    परत् उपखंड(स, अव["स्थिति"], अव["स्थिति"] + 1);
}

कार्य जेसन_मान_पार्स(शब्दकोश अव) {
    जेसन_श्वेत_छोड़ो(अव);
    पाठ च = जेसन_झाँको(अव);
    यदि (च == "{") { परत् जेसन_वस्तु_पार्स(अव); }
    यदि (च == "[") { परत् जेसन_सरणी_पार्स(अव); }
    यदि (च == "\"") { परत् जेसन_पाठ_पार्स(अव); }
    यदि (च == "t") { अव["स्थिति"] = अव["स्थिति"] + 4; परत् सत्य; }
    यदि (च == "f") { अव["स्थिति"] = अव["स्थिति"] + 5; परत् असत्य; }
    यदि (च == "n") { अव["स्थिति"] = अव["स्थिति"] + 4; परत् शून्यम्; }
    परत् जेसन_संख्या_पार्स(अव);
}

कार्य जेसन_पाठ_पार्स(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    अव["स्थिति"] = अव["स्थिति"] + 1;   // खुला "
    पाठ फल = "";
    यावत् (अव["स्थिति"] < लंबाई(स)) {
        पाठ च = उपखंड(स, अव["स्थिति"], अव["स्थिति"] + 1);
        यदि (च == "\"") {
            अव["स्थिति"] = अव["स्थिति"] + 1;
            परत् फल;
        }
        यदि (च == "\\") {
            अव["स्थिति"] = अव["स्थिति"] + 1;
            पाठ अगला = उपखंड(स, अव["स्थिति"], अव["स्थिति"] + 1);
            यदि (अगला == "n") { फल = फल + अक्षर_निर्माण(10); }
            अन्यथा यदि (अगला == "t") { फल = फल + अक्षर_निर्माण(9); }
            अन्यथा यदि (अगला == "r") { फल = फल + अक्षर_निर्माण(13); }
            अन्यथा यदि (अगला == "b") { फल = फल + अक्षर_निर्माण(8); }
            अन्यथा यदि (अगला == "f") { फल = फल + अक्षर_निर्माण(12); }
            अन्यथा यदि (अगला == "/") { फल = फल + "/"; }
            अन्यथा यदि (अगला == "\\") { फल = फल + "\\"; }
            अन्यथा यदि (अगला == "\"") { फल = फल + "\""; }
            अन्यथा { फल = फल + अगला; }
            अव["स्थिति"] = अव["स्थिति"] + 1;
        } अन्यथा {
            फल = फल + च;
            अव["स्थिति"] = अव["स्थिति"] + 1;
        }
    }
    परत् फल;
}

कार्य जेसन_संख्या_पार्स(शब्दकोश अव) {
    पाठ स = अव["पाठ"];
    पाठ अंकपाठ = "";
    संख्या दशमलव_है = 0;
    यावत् (अव["स्थिति"] < लंबाई(स)) {
        पाठ च = उपखंड(स, अव["स्थिति"], अव["स्थिति"] + 1);
        संख्या क = अक्षर_मान(च);
        यदि ((क >= 48 && क <= 57) || च == "-" || च == "+") {
            अंकपाठ = अंकपाठ + च;
            अव["स्थिति"] = अव["स्थिति"] + 1;
        } अन्यथा यदि (च == "." || च == "e" || च == "E") {
            दशमलव_है = 1;
            अंकपाठ = अंकपाठ + च;
            अव["स्थिति"] = अव["स्थिति"] + 1;
        } अन्यथा {
            विरामः;
        }
    }
    यदि (दशमलव_है == 1) { परत् जेसन_दशमलव_बनाओ(अंकपाठ); }
    परत् जेसन_पूर्णांक_बनाओ(अंकपाठ);
}

कार्य जेसन_पूर्णांक_बनाओ(पाठ स) {
    संख्या फल = 0;
    संख्या इ = 0;
    संख्या चिह्न_न = 1;
    यदि (लंबाई(स) > 0) {
        यदि (उपखंड(स, 0, 1) == "-") { चिह्न_न = -1; इ = 1; }
    }
    यावत् (इ < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, इ, इ + 1));
        यदि (क >= 48 && क <= 57) {
            फल = फल * 10 + (क - 48);
        }
        इ = इ + 1;
    }
    परत् चिह्न_न * फल;
}

// "3.14" जैसे सरल दशमलव (e-अंकन अनदेखा — पूर्णांक-भाग + अंश-भाग)
कार्य जेसन_दशमलव_बनाओ(पाठ स) {
    दशमलव चिह्न_द = 1.0;
    संख्या इ = 0;
    यदि (लंबाई(स) > 0) {
        यदि (उपखंड(स, 0, 1) == "-") { चिह्न_द = -1.0; इ = 1; }
    }
    दशमलव पूर्ण_भाग = 0.0;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + 1);
        यदि (च == ".") { इ = इ + 1; विरामः; }
        संख्या क = अक्षर_मान(च);
        यदि (क >= 48 && क <= 57) {
            पूर्ण_भाग = पूर्ण_भाग * 10.0 + (क - 48);
        }
        इ = इ + 1;
    }
    दशमलव अंश_भाग = 0.0;
    दशमलव स्थान_द = 1.0;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + 1);
        संख्या क = अक्षर_मान(च);
        यदि (क >= 48 && क <= 57) {
            स्थान_द = स्थान_द * 10.0;
            अंश_भाग = अंश_भाग + ((क - 48) / स्थान_द);
        } अन्यथा यदि (च == "e" || च == "E") {
            विरामः;
        }
        इ = इ + 1;
    }
    परत् चिह्न_द * (पूर्ण_भाग + अंश_भाग);
}

कार्य जेसन_सरणी_पार्स(शब्दकोश अव) {
    अव["स्थिति"] = अव["स्थिति"] + 1;   // [
    सूची फल = [];
    जेसन_श्वेत_छोड़ो(अव);
    यदि (जेसन_झाँको(अव) == "]") {
        अव["स्थिति"] = अव["स्थिति"] + 1;
        परत् फल;
    }
    यावत् (सत्य) {
        फल = जोड़ें(फल, जेसन_मान_पार्स(अव));
        जेसन_श्वेत_छोड़ो(अव);
        पाठ च = जेसन_झाँको(अव);
        अव["स्थिति"] = अव["स्थिति"] + 1;
        यदि (च == "]") { विरामः; }
        // च == "," → अगला तत्व
    }
    परत् फल;
}

कार्य जेसन_वस्तु_पार्स(शब्दकोश अव) {
    अव["स्थिति"] = अव["स्थिति"] + 1;   // {
    शब्दकोश फल = {};
    जेसन_श्वेत_छोड़ो(अव);
    यदि (जेसन_झाँको(अव) == "}") {
        अव["स्थिति"] = अव["स्थिति"] + 1;
        परत् फल;
    }
    यावत् (सत्य) {
        जेसन_श्वेत_छोड़ो(अव);
        पाठ कुंजी = जेसन_पाठ_पार्स(अव);
        जेसन_श्वेत_छोड़ो(अव);
        अव["स्थिति"] = अव["स्थिति"] + 1;   // :
        मान मूल्य = जेसन_मान_पार्स(अव);
        फल[कुंजी] = मूल्य;
        जेसन_श्वेत_छोड़ो(अव);
        पाठ च = जेसन_झाँको(अव);
        अव["स्थिति"] = अव["स्थिति"] + 1;
        यदि (च == "}") { विरामः; }
        // च == "," → अगला युग्म
    }
    परत् फल;
}

// मुख्य प्रवेश
कार्य जेसन_पार्स(पाठ स) {
    शब्दकोश अव = {};
    अव["पाठ"] = स;
    अव["स्थिति"] = 0;
    परत् जेसन_मान_पार्स(अव);
}
