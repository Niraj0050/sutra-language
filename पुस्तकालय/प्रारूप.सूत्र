// पुस्तकालय/प्रारूप.सूत्र — पाठ-प्रारूपण (formatting)
// ============================================================
// आयात "पुस्तकालय/प्रारूप.सूत्र";
//
// सूत्र में f-string नहीं — प्रारूप() टेम्पलेट देता है:
//   प्रारूप("{} + {} = {}", [2, 3, 5])   → "2 + 3 = 5"
// साथ ही संख्या-प्रारूपण, संरेखण, आधार-रूपांतरण।
// ============================================================

// टेम्पलेट में हर "{}" को क्रम से तर्क से बदलो
कार्य प्रारूप(पाठ टेम्पलेट, सूची तर्क) {
    सूची भाग = विभाजित(टेम्पलेट, "{}");
    पाठ फल = भाग[0];
    संख्या इ = 1;
    यावत् (इ < लंबाई(भाग)) {
        यदि (इ - 1 < लंबाई(तर्क)) {
            फल = फल + ("" + तर्क[इ - 1]);
        } अन्यथा {
            फल = फल + "{}";
        }
        फल = फल + भाग[इ];
        इ = इ + 1;
    }
    परत् फल;
}

// ===== संरेखण / padding =====

// स को चौड़ाई तक दाईं ओर भरो (बाएँ-संरेखित पाठ)
कार्य बाएँ_संरेखित(पाठ स, संख्या चौड़ाई, पाठ भरण) {
    पाठ फल = स;
    यावत् (लंबाई(फल) < चौड़ाई) { फल = फल + भरण; }
    परत् फल;
}

// स को चौड़ाई तक बाईं ओर भरो (दाएँ-संरेखित पाठ)
कार्य दाएँ_संरेखित(पाठ स, संख्या चौड़ाई, पाठ भरण) {
    पाठ फल = स;
    यावत् (लंबाई(फल) < चौड़ाई) { फल = भरण + फल; }
    परत् फल;
}

// स को चौड़ाई में केंद्रित करो
कार्य मध्य_संरेखित(पाठ स, संख्या चौड़ाई, पाठ भरण) {
    पाठ फल = स;
    संख्या बारी = 0;
    यावत् (लंबाई(फल) < चौड़ाई) {
        यदि ((बारी % 2) == 0) { फल = फल + भरण; }
        अन्यथा { फल = भरण + फल; }
        बारी = बारी + 1;
    }
    परत् फल;
}

// ===== संख्या-प्रारूपण =====

// पूर्णांक को हज़ार-विभाजक के साथ: 1234567 → "1,234,567"
कार्य हज़ार_विभाजक(संख्या न_मान) {
    पाठ चिह्न_पाठ = "";
    संख्या मान_न = न_मान;
    यदि (मान_न < 0) { चिह्न_पाठ = "-"; मान_न = 0 - मान_न; }
    पाठ अंक = "" + मान_न;
    पाठ फल = "";
    संख्या गिनती = 0;
    संख्या इ = लंबाई(अंक) - 1;
    यावत् (इ >= 0) {
        यदि (गिनती > 0) {
            यदि ((गिनती % 3) == 0) { फल = "," + फल; }
        }
        फल = उपखंड(अंक, इ, इ + 1) + फल;
        गिनती = गिनती + 1;
        इ = इ - 1;
    }
    परत् चिह्न_पाठ + फल;
}

// दशमलव को नियत दशमलव-स्थानों तक: संख्या_प्रारूप(3.14159, 2) → "3.14"
// ⚠️ पैरामीटर दशमलव-typed होना ज़रूरी — native path में `मान`-typed float
// अंकगणित (× − ÷) पूर्णांक जैसा चलता (कोई tagged मान नहीं)।
कार्य संख्या_प्रारूप(दशमलव द_मान, संख्या स्थान) {
    दशमलव गुणक = 1.0;
    संख्या इ = 0;
    यावत् (इ < स्थान) { गुणक = गुणक * 10.0; इ = इ + 1; }
    दशमलव स्केल्ड = द_मान * गुणक;
    संख्या पूर्ण_भाग = गोल(स्केल्ड);
    पाठ चिह्न_पाठ = "";
    यदि (पूर्ण_भाग < 0) { चिह्न_पाठ = "-"; पूर्ण_भाग = 0 - पूर्ण_भाग; }
    यदि (स्थान == 0) { परत् चिह्न_पाठ + ("" + पूर्ण_भाग); }
    पाठ अंक = "" + पूर्ण_भाग;
    यावत् (लंबाई(अंक) <= स्थान) { अंक = "0" + अंक; }
    संख्या विभाजन = लंबाई(अंक) - स्थान;
    परत् चिह्न_पाठ + उपखंड(अंक, 0, विभाजन) + "." + उपखंड(अंक, विभाजन, लंबाई(अंक));
}

// प्रतिशत: प्रतिशत(0.25, 1) → "25.0%"
कार्य प्रतिशत(दशमलव अंश, संख्या स्थान) {
    परत् संख्या_प्रारूप(अंश * 100.0, स्थान) + "%";
}

// ===== आधार-रूपांतरण =====

कार्य आधार_अंक(संख्या मान_अ) {
    यदि (मान_अ < 10) { परत् "" + मान_अ; }
    यदि (मान_अ == 10) { परत् "a"; }
    यदि (मान_अ == 11) { परत् "b"; }
    यदि (मान_अ == 12) { परत् "c"; }
    यदि (मान_अ == 13) { परत् "d"; }
    यदि (मान_अ == 14) { परत् "e"; }
    परत् "f";
}

// पूर्णांक → दिए आधार (2..16) में पाठ
कार्य आधार_में(संख्या न_मान, संख्या आधार_सं) {
    यदि (न_मान == 0) { परत् "0"; }
    पाठ चिह्न_पाठ = "";
    संख्या मान_न = न_मान;
    यदि (मान_न < 0) { चिह्न_पाठ = "-"; मान_न = 0 - मान_न; }
    पाठ फल = "";
    यावत् (मान_न > 0) {
        फल = आधार_अंक(मान_न % आधार_सं) + फल;
        मान_न = मान_न / आधार_सं;
    }
    परत् चिह्न_पाठ + फल;
}

कार्य हेक्स(संख्या न_मान) { परत् आधार_में(न_मान, 16); }
कार्य द्विआधारी(संख्या न_मान) { परत् आधार_में(न_मान, 2); }
कार्य अष्टक(संख्या न_मान) { परत् आधार_में(न_मान, 8); }

// आधार-अक्षर → मान (a→10 आदि); अमान्य → -1
कार्य अंक_मान(पाठ च) {
    संख्या क = अक्षर_मान(च);
    यदि (क >= 48 && क <= 57) { परत् क - 48; }       // 0-9
    यदि (क >= 97 && क <= 102) { परत् क - 97 + 10; }  // a-f
    यदि (क >= 65 && क <= 70) { परत् क - 65 + 10; }   // A-F
    परत् -1;
}

// दिए आधार में पाठ → पूर्णांक
कार्य आधार_से(पाठ स, संख्या आधार_सं) {
    संख्या फल = 0;
    संख्या इ = 0;
    संख्या चिह्न_न = 1;
    यदि (लंबाई(स) > 0) {
        यदि (उपखंड(स, 0, 1) == "-") { चिह्न_न = -1; इ = 1; }
    }
    यावत् (इ < लंबाई(स)) {
        संख्या म = अंक_मान(उपखंड(स, इ, इ + 1));
        यदि (म < 0 || म >= आधार_सं) { परत् 0; }
        फल = फल * आधार_सं + म;
        इ = इ + 1;
    }
    परत् चिह्न_न * फल;
}

// ===== विविध =====

// तालिका-पंक्ति: कक्षों को | से जोड़ो, हर कक्ष चौड़ाई तक भरो
कार्य तालिका_पंक्ति(सूची कक्ष, संख्या चौड़ाई) {
    पाठ फल = "";
    संख्या इ = 0;
    यावत् (इ < लंबाई(कक्ष)) {
        यदि (इ > 0) { फल = फल + " | "; }
        फल = फल + बाएँ_संरेखित("" + कक्ष[इ], चौड़ाई, " ");
        इ = इ + 1;
    }
    परत् फल;
}
