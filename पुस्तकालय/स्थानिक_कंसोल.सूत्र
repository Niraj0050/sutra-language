// पुस्तकालय/स्थानिक_कंसोल.सूत्र — संप्रभु त्रि-आयामी कंसोल दृश्य रेंडरर (Sovereign 3D Terminal Rasterizer)
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-ब्राउज़र | शून्य-अंग्रेजी वर्णमाला
//
// यह मॉड्यूल किसी भी ३डी ज्यामितीय जाल (Mesh) को शुद्ध गणितीय परिप्रेक्ष्य (Perspective
// Projection) एवं ब्रेसेनहैम रेखा कलन-विधि (Bresenham Algorithm) द्वारा सीधे
// कंसोल/टर्मिनल पटल पर १००% शुद्ध देवनागरी प्रतीकों में रेंडर करता है।
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";

कार्य कंसोल_पटल_रचना(संख्या चौड़ाई, संख्या ऊँचाई) {
    शब्दकोश प = {};
    प["चौड़ाई"] = चौड़ाई;
    प["ऊँचाई"] = ऊँचाई;
    सूची पंक्तियाँ = [];
    संख्या य = ०;
    यावत् (य < ऊँचाई) {
        सूची पंक्ति = [];
        संख्या क्ष = ०;
        यावत् (क्ष < चौड़ाई) {
            पंक्ति = जोड़ें(पंक्ति, " ");
            क्ष = क्ष + १;
        }
        पंक्तियाँ = जोड़ें(पंक्तियाँ, पंक्ति);
        य = य + १;
    }
    प["पंक्तियाँ"] = पंक्तियाँ;
    परत् प;
}

कार्य कंसोल_बिंदु_लगाओ(शब्दकोश प, संख्या क्ष, संख्या य, पाठ वर्ण) {
    यदि (क्ष >= ० && क्ष < प["चौड़ाई"] && य >= ० && य < प["ऊँचाई"]) {
        प["पंक्तियाँ"][य][क्ष] = वर्ण;
    }
}

कार्य निरपेक्ष_मान(संख्या मान_संख्या) {
    यदि (मान_संख्या < ०) {
        परत् ० - मान_संख्या;
    }
    परत् मान_संख्या;
}

कार्य कंसोल_रेखा_खींचो(शब्दकोश प, संख्या क्ष१, संख्या य१, संख्या क्ष२, संख्या य२, पाठ वर्ण) {
    संख्या डिक्ष = निरपेक्ष_मान(क्ष२ - क्ष१);
    संख्या डिय = ० - निरपेक्ष_मान(य२ - य१);
    संख्या पग_क्ष = १;
    यदि (क्ष१ > क्ष२) { पग_क्ष = -१; }
    संख्या पग_य = १;
    यदि (य१ > य२) { पग_य = -१; }
    संख्या त्रुटि = डिक्ष + डिय;

    संख्या चालू_क्ष = क्ष१;
    संख्या चालू_य = य१;

    यावत् (सत्य) {
        कंसोल_बिंदु_लगाओ(प, चालू_क्ष, चालू_य, वर्ण);
        यदि (चालू_क्ष == क्ष२ && चालू_य == य२) { विरामः; }
        संख्या दो_त्रुटि = २ * त्रुटि;
        यदि (दो_त्रुटि >= डिय) {
            त्रुटि = त्रुटि + डिय;
            चालू_क्ष = चालू_क्ष + पग_क्ष;
        }
        यदि (दो_त्रुटि <= डिक्ष) {
            त्रुटि = त्रुटि + डिक्ष;
            चालू_य = चालू_य + पग_य;
        }
    }
}

कार्य कंसोल_पाठ_दोहराओ(पाठ वर्ण, संख्या बार) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < बार) {
        फल = फल + वर्ण;
        इ = इ + १;
    }
    परत् फल;
}

कार्य कंसोल_पटल_मुद्रण(शब्दकोश प, पाठ शीर्षक) {
    संख्या शेष = प["चौड़ाई"] - लंबाई(शीर्षक) - ५;
    यदि (शेष < ०) { शेष = ०; }
    लिखतु("  ┌─ " + शीर्षक + " " + कंसोल_पाठ_दोहराओ("─", शेष) + "┐");
    संख्या य = ०;
    यावत् (य < प["ऊँचाई"]) {
        पाठ रेखा = "  │";
        संख्या क्ष = ०;
        यावत् (क्ष < प["चौड़ाई"]) {
            रेखा = रेखा + प["पंक्तियाँ"][य][क्ष];
            क्ष = क्ष + १;
        }
        रेखा = रेखा + "│";
        लिखतु(रेखा);
        य = य + १;
    }
    लिखतु("  └" + कंसोल_पाठ_दोहराओ("─", प["चौड़ाई"]) + "┘");
}

कार्य कंसोल_३डी_जाल_रेंडर(शब्दकोश पटल, शब्दकोश जाल, दशमलव कोण_य, दशमलव कोण_क्ष, दशमलव दूरी, दशमलव पैमाना, पाठ वर्ण) {
    दशमलव कोज्या_य = दृश्यक_कोज्या(कोण_य);
    दशमलव साइन_य = दृश्यक_साइन(कोण_य);
    दशमलव कोज्या_क्ष = दृश्यक_कोज्या(कोण_क्ष);
    दशमलव साइन_क्ष = दृश्यक_साइन(कोण_क्ष);

    सूची प्रक्षेपित = [];
    दशमलव केंद्र_क्ष = पटल["चौड़ाई"] / २.०;
    दशमलव केंद्र_य = पटल["ऊँचाई"] / २.०;

    संख्या शि = ०;
    यावत् (शि < लंबाई(जाल["शीर्ष"])) {
        सूची बिंदु = जाल["शीर्ष"][शि];
        दशमलव बिंदु_क्ष = बिंदु[०];
        दशमलव बिंदु_य = बिंदु[१];
        दशमलव बिंदु_ज्ञ = बिंदु[२];

        // घूर्णन Y
        दशमलव क्ष१ = बिंदु_क्ष * कोज्या_य + बिंदु_ज्ञ * साइन_य;
        दशमलव ज्ञ१ = (०.० - बिंदु_क्ष) * साइन_य + बिंदु_ज्ञ * कोज्या_य;

        // घूर्णन X
        दशमलव य२ = बिंदु_य * कोज्या_क्ष - ज्ञ१ * साइन_क्ष;
        दशमलव ज्ञ२ = बिंदु_य * साइन_क्ष + ज्ञ१ * कोज्या_क्ष;

        दशमलव कुल_ज्ञ = ज्ञ२ + दूरी;
        यदि (कुल_ज्ञ < ०.१) { कुल_ज्ञ = ०.१; }

        संख्या पटल_क्ष = गोल(केंद्र_क्ष + (क्ष१ / कुल_ज्ञ) * पैमाना * २.२);
        संख्या पटल_य = गोल(केंद्र_य - (य२ / कुल_ज्ञ) * पैमाना);
        प्रक्षेपित = जोड़ें(प्रक्षेपित, [पटल_क्ष, पटल_य]);

        शि = शि + १;
    }

    // त्रिकोण सूचकांकों से किनारे खींचें
    संख्या त्र = ०;
    यावत् (त्र < लंबाई(जाल["सूचकांक"])) {
        संख्या सू१ = जाल["सूचकांक"][त्र];
        संख्या सू२ = जाल["सूचकांक"][त्र + १];
        संख्या सू३ = जाल["सूचकांक"][त्र + २];

        सूची ब१ = प्रक्षेपित[सू१];
        सूची ब२ = प्रक्षेपित[सू२];
        सूची ब३ = प्रक्षेपित[सू३];

        कंसोल_रेखा_खींचो(पटल, ब१[०], ब१[१], ब२[०], ब२[१], वर्ण);
        कंसोल_रेखा_खींचो(पटल, ब२[०], ब२[१], ब३[०], ब३[१], वर्ण);
        कंसोल_रेखा_खींचो(पटल, ब३[०], ब३[१], ब१[०], ब१[१], वर्ण);

        त्र = त्र + ३;
    }
}
