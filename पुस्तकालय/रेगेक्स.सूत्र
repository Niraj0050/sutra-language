// पुस्तकालय/रेगेक्स.सूत्र — नियमित अभिव्यक्ति (regular expressions)
// ============================================================
// आयात "पुस्तकालय/रेगेक्स.सूत्र";
//
//   रेगेक्स_मिलान("[0-9]+", "अंक 42 यहाँ")        // सत्य — कहीं भी मिले
//   रेगेक्स_पूर्ण_मिलान("[a-z]+", "hello")         // सत्य — पूरा पाठ मिले
//   रेगेक्स_खोजो("\\d+", "क3म14")                  // {मिला:सत्य, आरंभ:1, अंत:2, पाठ:"3"}
//   रेगेक्स_सभी_खोजो("\\d+", "क3म14ल5")            // ["3", "14", "5"]
//   रेगेक्स_बदलो("[aeiou]", "hello", "*")          // "h*ll*"
//   रेगेक्स_विभाजित(",\\s*", "अ, ब,ग")             // ["अ", "ब", "ग"]
//
// समर्थित: literal अक्षर, `.` (कोई भी), `*`/`+`/`?` (greedy दोहराव),
// `[abc]`/`[^abc]`/`[a-z]` (वर्ग), `^`/`$` (आरंभ/अंत), `|` (विकल्प),
// `(...)` (समूहन), `\d \D \w \W \s \S` (शॉर्टकट वर्ग), `\` से literal escape।
// कोई capturing groups नहीं (v1), कोई `{n,m}` गिनती-दोहराव नहीं (v1)।
//
// ⚠️ सीमा: अगर कोई `*`/`+` से दोहराया गया हिस्सा खाली-पाठ पर भी मिल सकता
// है (जैसे `(a?)*` या `(x*)*`), तो engine अनंत-लूप में फँस सकता — ऐसे
// पैटर्न से बचें (ज़्यादातर व्यावहारिक पैटर्न में यह नहीं आता)।
//
// तरीका: पैटर्न को पहले एक छोटे bytecode (अक्षर/वर्ग/कूद/विभाजन/मिलान
// अनुदेश) में संकलित करते, फिर एक recursive backtracking VM उसे चलाता —
// Thompson की classic NFA-निर्माण तकनीक (Russ Cox के लेखों में वर्णित
// सामान्य सिद्धांत) का मूल विचार, इसी भाषा में स्वतंत्र रूप से लिखा गया
// (न कोई मौजूदा regex engine का कोड, न अनुवाद)। "कूद"/"विभाजन" के लक्ष्य
// संख्या-सूचकांक (data) हैं — फलन-संदर्भ/closure नहीं, क्योंकि Sutra में
// प्रथम-श्रेणी फलन नहीं — यही मुख्य डिज़ाइन-अंतर आम backtracking regex
// लेखों से (जो अक्सर continuation-फलनों से समझाते हैं)।
// ============================================================

// ---- वर्ग-जाँच (character class) ----

कार्य रे_वर्ग_जांचो(शब्दकोश अनु, पाठ च) {
    संख्या कोड = अक्षर_मान(च);
    सूची श्रेणियाँ = अनु["श्रेणियाँ"];
    मान मिला = असत्य;
    संख्या इ = 0;
    यावत् (इ < लंबाई(श्रेणियाँ)) {
        संख्या लो = श्रेणियाँ[इ][0];
        संख्या ही = श्रेणियाँ[इ][1];
        यदि (कोड >= लो && कोड <= ही) { मिला = सत्य; }
        इ = इ + 1;
    }
    यदि (अनु["निषेध"] == सत्य) { परत् न मिला; }
    परत् मिला;
}

कार्य रे_वर्ग_बनाओ(सूची श्रेणियाँ, बूल निषेध) {
    शब्दकोश नो = {};
    नो["प्रकार"] = "वर्ग";
    नो["श्रेणियाँ"] = श्रेणियाँ;
    नो["निषेध"] = निषेध;
    परत् नो;
}
कार्य रे_वर्ग_अंक(बूल निषेध) {
    परत् रे_वर्ग_बनाओ([[अक्षर_मान("0"), अक्षर_मान("9")]], निषेध);
}
कार्य रे_वर्ग_शब्द(बूल निषेध) {
    सूची श = [[अक्षर_मान("a"), अक्षर_मान("z")], [अक्षर_मान("A"), अक्षर_मान("Z")],
               [अक्षर_मान("0"), अक्षर_मान("9")], [अक्षर_मान("_"), अक्षर_मान("_")]];
    परत् रे_वर्ग_बनाओ(श, निषेध);
}
कार्य रे_वर्ग_रिक्त(बूल निषेध) {
    सूची श = [[अक्षर_मान(" "), अक्षर_मान(" ")], [अक्षर_मान("\t"), अक्षर_मान("\t")],
               [अक्षर_मान("\n"), अक्षर_मान("\n")], [अक्षर_मान("\r"), अक्षर_मान("\r")]];
    परत् रे_वर्ग_बनाओ(श, निषेध);
}

// ---- पार्सर: पैटर्न-पाठ → AST ----
// अवस्था = {पैटर्न, स्थिति, लंबाई} — विश्लेषक.सूत्र जैसा thread-through शैली

कार्य रे_अव_बनाओ(पाठ पैटर्न) {
    शब्दकोश अ = {};
    अ["पैटर्न"] = पैटर्न;
    अ["स्थिति"] = 0;
    अ["लंबाई"] = लंबाई(पैटर्न);
    परत् अ;
}
कार्य रे_अव_अंत(शब्दकोश अ) { परत् अ["स्थिति"] >= अ["लंबाई"]; }
कार्य रे_अव_वर्तमान(शब्दकोश अ) {
    यदि (रे_अव_अंत(अ)) { परत् ""; }
    परत् उपखंड(अ["पैटर्न"], अ["स्थिति"], अ["स्थिति"] + 1);
}
कार्य रे_अव_आगे(शब्दकोश अ) { अ["स्थिति"] = अ["स्थिति"] + 1; परत् 0; }

// विकल्प := क्रम ('|' क्रम)*  → सूची of शाखाएँ (हर शाखा एक क्रम-सूची)
कार्य रे_पार्स_विकल्प(शब्दकोश अ) {
    सूची शाखाएँ = [];
    शाखाएँ = जोड़ें(शाखाएँ, रे_पार्स_क्रम(अ));
    यावत् (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "|") {
        रे_अव_आगे(अ);
        शाखाएँ = जोड़ें(शाखाएँ, रे_पार्स_क्रम(अ));
    }
    परत् शाखाएँ;
}

कार्य रे_पार्स_क्रम(शब्दकोश अ) {
    सूची सू = [];
    यावत् (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) != "|" && रे_अव_वर्तमान(अ) != ")") {
        सू = जोड़ें(सू, रे_पार्स_परमाणु(अ));
    }
    परत् सू;
}

// परमाणु := आधार परिमाणक?  → {आधार, न्यून, अधिक(-1=अनंत)}
कार्य रे_पार्स_परमाणु(शब्दकोश अ) {
    शब्दकोश आधार = रे_पार्स_आधार(अ);
    संख्या न्यून = 1;
    संख्या अधिक = 1;
    यदि (न रे_अव_अंत(अ)) {
        पाठ च = रे_अव_वर्तमान(अ);
        यदि (च == "*") { न्यून = 0; अधिक = 0 - 1; रे_अव_आगे(अ); }
        अन्यथा यदि (च == "+") { न्यून = 1; अधिक = 0 - 1; रे_अव_आगे(अ); }
        अन्यथा यदि (च == "?") { न्यून = 0; अधिक = 1; रे_अव_आगे(अ); }
    }
    शब्दकोश प = {};
    प["आधार"] = आधार;
    प["न्यून"] = न्यून;
    प["अधिक"] = अधिक;
    परत् प;
}

कार्य रे_पार्स_आधार(शब्दकोश अ) {
    यदि (रे_अव_अंत(अ)) {
        प्रक्षेपः "त्रुटिः — रेगेक्स: अप्रत्याशित पैटर्न-अंत";
    }
    पाठ च = रे_अव_वर्तमान(अ);
    यदि (च == "(") {
        रे_अव_आगे(अ);
        सूची विकल्प = रे_पार्स_विकल्प(अ);
        यदि (रे_अव_अंत(अ) || रे_अव_वर्तमान(अ) != ")") {
            प्रक्षेपः "त्रुटिः — रेगेक्स: ')' अपेक्षित";
        }
        रे_अव_आगे(अ);
        शब्दकोश नो = {};
        नो["प्रकार"] = "समूह";
        नो["विकल्प"] = विकल्प;
        परत् नो;
    }
    यदि (च == "[") { परत् रे_पार्स_वर्ग(अ); }
    यदि (च == ".") {
        रे_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "कोई_भी";
        परत् नो;
    }
    यदि (च == "^") {
        रे_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "आरंभ";
        परत् नो;
    }
    यदि (च == "$") {
        रे_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "अंत";
        परत् नो;
    }
    यदि (च == "\\") {
        रे_अव_आगे(अ);
        परत् रे_पार्स_एस्केप(अ);
    }
    रे_अव_आगे(अ);
    शब्दकोश नो = {}; नो["प्रकार"] = "अक्षर"; नो["मान"] = च;
    परत् नो;
}

कार्य रे_पार्स_एस्केप(शब्दकोश अ) {
    यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: '\\' के बाद अक्षर अपेक्षित"; }
    पाठ च = रे_अव_वर्तमान(अ);
    रे_अव_आगे(अ);
    यदि (च == "d") { परत् रे_वर्ग_अंक(असत्य); }
    यदि (च == "D") { परत् रे_वर्ग_अंक(सत्य); }
    यदि (च == "w") { परत् रे_वर्ग_शब्द(असत्य); }
    यदि (च == "W") { परत् रे_वर्ग_शब्द(सत्य); }
    यदि (च == "s") { परत् रे_वर्ग_रिक्त(असत्य); }
    यदि (च == "S") { परत् रे_वर्ग_रिक्त(सत्य); }
    शब्दकोश नो = {}; नो["प्रकार"] = "अक्षर"; नो["मान"] = च;
    परत् नो;
}

कार्य रे_पार्स_वर्ग(शब्दकोश अ) {
    रे_अव_आगे(अ);   // '['
    बूल निषेध = असत्य;
    यदि (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "^") {
        निषेध = सत्य;
        रे_अव_आगे(अ);
    }
    सूची श्रेणियाँ = [];
    मान पहला = सत्य;
    यावत् (न रे_अव_अंत(अ) && (रे_अव_वर्तमान(अ) != "]" || पहला)) {
        पहला = असत्य;
        पाठ च1 = रे_अव_वर्तमान(अ);
        यदि (च1 == "\\") {
            रे_अव_आगे(अ);
            यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: वर्ग में अधूरा escape"; }
            पाठ ई = रे_अव_वर्तमान(अ);
            रे_अव_आगे(अ);
            यदि (ई == "d") { श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("0"), अक्षर_मान("9")]); }
            अन्यथा यदि (ई == "w") {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("a"), अक्षर_मान("z")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("A"), अक्षर_मान("Z")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("0"), अक्षर_मान("9")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("_"), अक्षर_मान("_")]);
            }
            अन्यथा यदि (ई == "s") {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान(" "), अक्षर_मान(" ")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("\t"), अक्षर_मान("\t")]);
            } अन्यथा {
                संख्या कोड = अक्षर_मान(ई);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड, कोड]);
            }
        } अन्यथा {
            रे_अव_आगे(अ);
            संख्या कोड1 = अक्षर_मान(च1);
            यदि (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "-"
                && (अ["स्थिति"] + 1) < अ["लंबाई"]
                && उपखंड(अ["पैटर्न"], अ["स्थिति"] + 1, अ["स्थिति"] + 2) != "]") {
                रे_अव_आगे(अ);   // '-'
                पाठ च2 = रे_अव_वर्तमान(अ);
                रे_अव_आगे(अ);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड1, अक्षर_मान(च2)]);
            } अन्यथा {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड1, कोड1]);
            }
        }
    }
    यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: ']' अपेक्षित"; }
    रे_अव_आगे(अ);   // ']'
    परत् रे_वर्ग_बनाओ(श्रेणियाँ, निषेध);
}

// ---- संकलक: AST → bytecode ----
// हर उप-संकलन एक सूची-of-अनुदेश लौटाता जिसके "कूद"/"विभाजन" लक्ष्य उसी
// सूची के भीतर LOCAL (0-आधारित) सूचकांक होते — जोड़ते वक़्त ऑफसेट-समायोजन

कार्य रे_अनु_अक्षर(पाठ च) { शब्दकोश अ = {}; अ["प्रकार"] = "अक्षर"; अ["मान"] = च; परत् अ; }
कार्य रे_अनु_कोई_भी() { शब्दकोश अ = {}; अ["प्रकार"] = "कोई_भी"; परत् अ; }
कार्य रे_अनु_आरंभ() { शब्दकोश अ = {}; अ["प्रकार"] = "आरंभ"; परत् अ; }
कार्य रे_अनु_अंत_एंकर() { शब्दकोश अ = {}; अ["प्रकार"] = "अंत"; परत् अ; }
कार्य रे_अनु_कूद(संख्या ल) { शब्दकोश अ = {}; अ["प्रकार"] = "कूद"; अ["लक्ष्य"] = ल; परत् अ; }
कार्य रे_अनु_विभाजन(संख्या ल1, संख्या ल2) {
    शब्दकोश अ = {}; अ["प्रकार"] = "विभाजन"; अ["लक्ष्य1"] = ल1; अ["लक्ष्य2"] = ल2; परत् अ;
}
कार्य रे_अनु_मिलान() { शब्दकोश अ = {}; अ["प्रकार"] = "मिलान"; परत् अ; }

कार्य रे_कोड_ऑफसेट(सूची कोड, संख्या ऑफ) {
    सूची नया = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "कूद") { नया = जोड़ें(नया, रे_अनु_कूद(अ["लक्ष्य"] + ऑफ)); }
        अन्यथा यदि (अ["प्रकार"] == "विभाजन") {
            नया = जोड़ें(नया, रे_अनु_विभाजन(अ["लक्ष्य1"] + ऑफ, अ["लक्ष्य2"] + ऑफ));
        } अन्यथा {
            नया = जोड़ें(नया, अ);
        }
        इ = इ + 1;
    }
    परत् नया;
}

कार्य रे_कोड_जोड़ो(सूची अ, सूची ब) {
    सूची ब2 = रे_कोड_ऑफसेट(ब, लंबाई(अ));
    सूची परिणाम = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(अ)) { परिणाम = जोड़ें(परिणाम, अ[इ]); इ = इ + 1; }
    इ = 0;
    यावत् (इ < लंबाई(ब2)) { परिणाम = जोड़ें(परिणाम, ब2[इ]); इ = इ + 1; }
    परत् परिणाम;
}

कार्य रे_संकलन_आधार(शब्दकोश आधार) {
    पाठ प्र = आधार["प्रकार"];
    यदि (प्र == "अक्षर") { परत् [रे_अनु_अक्षर(आधार["मान"])]; }
    यदि (प्र == "कोई_भी") { परत् [रे_अनु_कोई_भी()]; }
    यदि (प्र == "वर्ग") { परत् [आधार]; }   // वर्ग-नोड खुद ही अनुदेश जैसा (प्रकार="वर्ग")
    यदि (प्र == "आरंभ") { परत् [रे_अनु_आरंभ()]; }
    यदि (प्र == "अंत") { परत् [रे_अनु_अंत_एंकर()]; }
    यदि (प्र == "समूह") { परत् रे_संकलन_विकल्प(आधार["विकल्प"]); }
    प्रक्षेपः "त्रुटिः — रेगेक्स: अज्ञात नोड प्रकार";
}

// परमाणु (आधार + न्यून/अधिक दोहराव) — यहीं */+/? की bytecode-मशीनरी
कार्य रे_संकलन_परमाणु(शब्दकोश परमाणु) {
    सूची आ_कोड = रे_संकलन_आधार(परमाणु["आधार"]);
    संख्या न्यून = परमाणु["न्यून"];
    संख्या अधिक = परमाणु["अधिक"];

    यदि (न्यून == 1 && अधिक == 1) { परत् आ_कोड; }

    संख्या गिनती = लंबाई(आ_कोड);

    यदि (न्यून == 0 && अधिक == (0 - 1)) {
        // A*  : 0: विभाजन(1, गिनती+2)   1..गिनती: <आ_कोड@1>   गिनती+1: कूद(0)
        सूची शिफ्ट = रे_कोड_ऑफसेट(आ_कोड, 1);
        सूची परिणाम = [रे_अनु_विभाजन(1, गिनती + 2)];
        संख्या इ = 0;
        यावत् (इ < लंबाई(शिफ्ट)) { परिणाम = जोड़ें(परिणाम, शिफ्ट[इ]); इ = इ + 1; }
        परिणाम = जोड़ें(परिणाम, रे_अनु_कूद(0));
        परत् परिणाम;
    }
    यदि (न्यून == 1 && अधिक == (0 - 1)) {
        // A+  : 0..गिनती-1: <आ_कोड@0>   गिनती: विभाजन(0, गिनती+1)
        सूची परिणाम = [];
        संख्या इ = 0;
        यावत् (इ < गिनती) { परिणाम = जोड़ें(परिणाम, आ_कोड[इ]); इ = इ + 1; }
        परिणाम = जोड़ें(परिणाम, रे_अनु_विभाजन(0, गिनती + 1));
        परत् परिणाम;
    }
    यदि (न्यून == 0 && अधिक == 1) {
        // A?  : 0: विभाजन(1, गिनती+1)   1..गिनती: <आ_कोड@1>
        सूची शिफ्ट = रे_कोड_ऑफसेट(आ_कोड, 1);
        सूची परिणाम = [रे_अनु_विभाजन(1, गिनती + 1)];
        संख्या इ = 0;
        यावत् (इ < लंबाई(शिफ्ट)) { परिणाम = जोड़ें(परिणाम, शिफ्ट[इ]); इ = इ + 1; }
        परत् परिणाम;
    }
    प्रक्षेपः "त्रुटिः — रेगेक्स: असमर्थित दोहराव";
}

कार्य रे_संकलन_क्रम(सूची परमाणु_सूची) {
    सूची कोड = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(परमाणु_सूची)) {
        कोड = रे_कोड_जोड़ो(कोड, रे_संकलन_परमाणु(परमाणु_सूची[इ]));
        इ = इ + 1;
    }
    परत् कोड;
}

// विकल्प (शाखाओं की सूची) — 1 शाखा हो तो सीधे, नहीं तो split-श्रृंखला
कार्य रे_संकलन_विकल्प(सूची शाखाएँ) {
    यदि (लंबाई(शाखाएँ) == 1) { परत् रे_संकलन_क्रम(शाखाएँ[0]); }
    परत् रे_संकलन_विकल्प_सहायक(शाखाएँ, 0);
}
कार्य रे_संकलन_विकल्प_सहायक(सूची शाखाएँ, संख्या सूचक) {
    यदि (सूचक == लंबाई(शाखाएँ) - 1) { परत् रे_संकलन_क्रम(शाखाएँ[सूचक]); }
    सूची यह = रे_संकलन_क्रम(शाखाएँ[सूचक]);
    सूची बाकी = रे_संकलन_विकल्प_सहायक(शाखाएँ, सूचक + 1);
    संख्या गिनती_यह = लंबाई(यह);
    संख्या गिनती_बाकी = लंबाई(बाकी);
    सूची यह_शिफ्ट = रे_कोड_ऑफसेट(यह, 1);
    सूची बाकी_शिफ्ट = रे_कोड_ऑफसेट(बाकी, गिनती_यह + 2);
    सूची परिणाम = [रे_अनु_विभाजन(1, गिनती_यह + 2)];
    संख्या इ = 0;
    यावत् (इ < लंबाई(यह_शिफ्ट)) { परिणाम = जोड़ें(परिणाम, यह_शिफ्ट[इ]); इ = इ + 1; }
    परिणाम = जोड़ें(परिणाम, रे_अनु_कूद(गिनती_यह + गिनती_बाकी + 2));
    इ = 0;
    यावत् (इ < लंबाई(बाकी_शिफ्ट)) { परिणाम = जोड़ें(परिणाम, बाकी_शिफ्ट[इ]); इ = इ + 1; }
    परत् परिणाम;
}

// ---- VM: recursive backtracking (कोई closure नहीं — "आगे क्या" हमेशा
// एक संख्या-सूचकांक (पीसी) है, प्रथम-श्रेणी फलन नहीं) ----

कार्य रे_चलाओ(सूची कोड, संख्या पीसी, पाठ स्रोत, संख्या प_इ, संख्या पाठ_लं) {
    शब्दकोश अनु = कोड[पीसी];
    पाठ प्र = अनु["प्रकार"];
    यदि (प्र == "मिलान") { परत् प_इ; }
    यदि (प्र == "अक्षर") {
        यदि (प_इ < पाठ_लं && उपखंड(स्रोत, प_इ, प_इ + 1) == अनु["मान"]) {
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + 1, पाठ_लं);
        }
        परत् 0 - 1;
    }
    यदि (प्र == "कोई_भी") {
        यदि (प_इ < पाठ_लं) { परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + 1, पाठ_लं); }
        परत् 0 - 1;
    }
    यदि (प्र == "वर्ग") {
        यदि (प_इ < पाठ_लं && रे_वर्ग_जांचो(अनु, उपखंड(स्रोत, प_इ, प_इ + 1))) {
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + 1, पाठ_लं);
        }
        परत् 0 - 1;
    }
    यदि (प्र == "आरंभ") {
        यदि (प_इ == 0) { परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं); }
        परत् 0 - 1;
    }
    यदि (प्र == "अंत") {
        यदि (प_इ == पाठ_लं) { परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं); }
        परत् 0 - 1;
    }
    यदि (प्र == "कूद") { परत् रे_चलाओ(कोड, अनु["लक्ष्य"], स्रोत, प_इ, पाठ_लं); }
    यदि (प्र == "विभाजन") {
        संख्या प1 = रे_चलाओ(कोड, अनु["लक्ष्य1"], स्रोत, प_इ, पाठ_लं);
        यदि (प1 >= 0) { परत् प1; }
        परत् रे_चलाओ(कोड, अनु["लक्ष्य2"], स्रोत, प_इ, पाठ_लं);
    }
    प्रक्षेपः "त्रुटिः — रेगेक्स: अज्ञात bytecode प्रकार";
}

// ---- सार्वजनिक API ----

कार्य रेगेक्स_संकलन(पाठ पैटर्न) {
    शब्दकोश अ = रे_अव_बनाओ(पैटर्न);
    सूची शाखाएँ = रे_पार्स_विकल्प(अ);
    यदि (न रे_अव_अंत(अ)) {
        प्रक्षेपः "त्रुटिः — रेगेक्स: अनपेक्षित ')' या पैटर्न में गड़बड़ी";
    }
    परत् जोड़ें(रे_संकलन_विकल्प(शाखाएँ), रे_अनु_मिलान());
}

कार्य रे_खोजो_संकलित(सूची कोड, पाठ स्रोत, संख्या शुरू_से) {
    संख्या लं = लंबाई(स्रोत);
    संख्या श = शुरू_से;
    यावत् (श <= लं) {
        संख्या अंत = रे_चलाओ(कोड, 0, स्रोत, श, लं);
        यदि (अंत >= 0) {
            शब्दकोश प = {};
            प["मिला"] = सत्य;
            प["आरंभ"] = श;
            प["अंत"] = अंत;
            प["पाठ"] = उपखंड(स्रोत, श, अंत);
            परत् प;
        }
        श = श + 1;
    }
    शब्दकोश असफल = {};
    असफल["मिला"] = असत्य;
    परत् असफल;
}

// पैटर्न स्रोत-पाठ में कहीं भी मिलता है? (re.search जैसा, बूल रूप)
कार्य रेगेक्स_मिलान(पाठ पैटर्न, पाठ स्रोत) {
    शब्दकोश प = रेगेक्स_खोजो(पैटर्न, स्रोत);
    परत् प["मिला"];
}

// पूरा स्रोत-पाठ बिल्कुल पैटर्न से मिलता है? (re.fullmatch जैसा)
कार्य रेगेक्स_पूर्ण_मिलान(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    संख्या लं = लंबाई(स्रोत);
    परत् रे_चलाओ(कोड, 0, स्रोत, 0, लं) == लं;
}

// पहला मिलान — {मिला, आरंभ, अंत, पाठ} (re.search जैसा, विवरण सहित)
कार्य रेगेक्स_खोजो(पाठ पैटर्न, पाठ स्रोत) {
    परत् रे_खोजो_संकलित(रेगेक्स_संकलन(पैटर्न), स्रोत, 0);
}

// सभी (non-overlapping, बाएँ-से-दाएँ) मिलान — सूची of matched पाठ (re.findall जैसा)
कार्य रेगेक्स_सभी_खोजो(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        परिणाम = जोड़ें(परिणाम, मि["पाठ"]);
        यदि (मि["अंत"] > मि["आरंभ"]) { श = मि["अंत"]; } अन्यथा { श = मि["अंत"] + 1; }
    }
    परत् परिणाम;
}

// हर मिलान को प्रतिस्थापन-पाठ से बदलो (re.sub जैसा; v1 — कोई backreference नहीं)
कार्य रेगेक्स_बदलो(पाठ पैटर्न, पाठ स्रोत, पाठ प्रतिस्थापन) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    पाठ परिणाम = "";
    संख्या लं = लंबाई(स्रोत);
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) {
            परिणाम = परिणाम + उपखंड(स्रोत, श, लं);
            परत् परिणाम;
        }
        परिणाम = परिणाम + उपखंड(स्रोत, श, मि["आरंभ"]) + प्रतिस्थापन;
        यदि (मि["अंत"] > मि["आरंभ"]) {
            श = मि["अंत"];
        } अन्यथा {
            यदि (मि["अंत"] < लं) { परिणाम = परिणाम + उपखंड(स्रोत, मि["अंत"], मि["अंत"] + 1); }
            श = मि["अंत"] + 1;
        }
    }
    परत् परिणाम;
}

// पैटर्न-मिलान पर स्रोत-पाठ को विभाजित करो (re.split जैसा)
कार्य रेगेक्स_विभाजित(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या पिछला = 0;
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        यदि (मि["अंत"] == मि["आरंभ"]) {
            श = मि["अंत"] + 1;
        } अन्यथा {
            परिणाम = जोड़ें(परिणाम, उपखंड(स्रोत, पिछला, मि["आरंभ"]));
            पिछला = मि["अंत"];
            श = मि["अंत"];
        }
    }
    परिणाम = जोड़ें(परिणाम, उपखंड(स्रोत, पिछला, लं));
    परत् परिणाम;
}
