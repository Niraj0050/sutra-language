// पुस्तकालय/रेगेक्स.सूत्र — नियमित अभिव्यक्ति (regular expressions)
// ============================================================
// आयात "पुस्तकालय/रेगेक्स.सूत्र";
//
//   रेगेक्स_मिलान("[0-9]+", "अंक 42 यहाँ")        // सत्य — कहीं भी मिले
//   रेगेक्स_पूर्ण_मिलान("[a-z]+", "hello")         // सत्य — पूरा पाठ मिले
//   रेगेक्स_खोजो("\\d+", "क3म14")                  // {मिला:सत्य, आरंभ:1, अंत:2, पाठ:"3"}
//   रेगेक्स_सभी_खोजो("\\d+", "क3म14ल5")            // ["3", "14", "5"]
//   रेगेक्स_बदलो("[aeiou]", "hello", "*")          // "h*ll*"
//   रेगेक्स_विभाजित(",\\s*", "अ, ब,ग")             // ["अ", "ब", "ग"]
//
// समर्थित: literal अक्षर, `.` (कोई भी), `*`/`+`/`?` (greedy दोहराव),
// `{n}`/`{n,}`/`{n,m}` (greedy गिनती-दोहराव), `[abc]`/`[^abc]`/`[a-z]`
// (वर्ग), `^`/`$` (आरंभ/अंत), `|` (विकल्प), `(...)` (पकड़ने वाला समूह —
// capturing group), `(?:...)` (न पकड़ने वाला समूह), `(?=...)`/`(?!...)`
// (सकारात्मक/नकारात्मक आगे-दृष्टि — lookahead), `(?<=...)`/`(?<!...)`
// (सकारात्मक/नकारात्मक पीछे-दृष्टि — lookbehind, **स्थिर-लंबाई ही**),
// `\d \D \w \W \s \S` (शॉर्टकट वर्ग), `\1`-`\9` (backreference — पैटर्न
// में, एक-अंक v1), `\` से literal escape।
//
// `{n,m}`: तरीका — n अनिवार्य प्रतियाँ + (m−n) वैकल्पिक (`?`) प्रतियाँ
// क्रम में, और `{n,}` = n अनिवार्य + एक `*` पूंछ — यानी `{n,m}` अपने आप
// मौजूदा */+/? bytecode-रास्तों में विघटित होता (नया bytecode नहीं)।
//
// Capturing groups: `रेगेक्स_खोजो`/`रेगेक्स_सभी_खोजो_विस्तृत` के परिणाम में
// "समूह" = सूची (index 0 = समूह 1 का पाठ, index 1 = समूह 2 का, आदि; समूह
// मिलान में शामिल न हुआ हो तो शून्यम्)। `रेगेक्स_समूह(परिणाम, क्रमांक)` से
// 1-आधारित सुविधाजनक पहुँच। समूह-क्रमांक बाएँ-से-दाएँ खुलते कोष्ठक के क्रम
// में (नेस्टेड समूह भी शामिल) — मानक regex परंपरा जैसा ही।
//
// Backreference: पैटर्न में `\1` वही *पाठ* माँगता है जो समूह 1 ने रन-टाइम
// पर पकड़ा (सिर्फ़ वही उप-पैटर्न दोबारा नहीं) — जैसे `(\w+)\s+\1` दोहराया
// शब्द ("hello hello") पकड़ता, "hello world" नहीं। समूह अभी तक न मिला हो
// तो `\N` असफल होता (शून्य-चौड़ाई-मिलान नहीं)। `रेगेक्स_बदलो` के
// प्रतिस्थापन-पाठ में अलग से `$1`-`$9` (समूह का पाठ), `$0` (पूरा मिलान),
// `$$` (literal `$`) समर्थित — दोनों backreference रूप स्वतंत्र हैं।
//
// Lookahead/lookbehind: शून्य-चौड़ाई दावे — मिलते हैं (या नहीं मिलते) पर
// पाठ *उपभोग नहीं* करते। `(?=X)`/`(?!X)` आगे की ओर — किसी भी लंबाई का X
// चलता (VM पहले से backtracking है, इसलिए X पर कोई सीमा नहीं)।
// `(?<=X)`/`(?<!X)` पीछे की ओर — X की लंबाई **संकलन-समय पर स्थिर** होनी
// ज़रूरी (कोई `*`/`+`/`{n,m}` जहाँ n≠m, कोई `\N` भीतर नहीं) — मानक-सा गैर-
// स्थिर-लंबाई lookbehind सामान्य forward-bytecode VM में अनिश्चित समय ले
// सकता (कहाँ से पीछे शुरू करें, बिना जाने कितनी लंबाई मिलेगी); ज़्यादातर
// प्रमुख regex engine (Perl/PCRE/RE2/Rust) भी यही सीमा रखते हैं। सफल
// (?=X)/(?<=X) के भीतर capturing groups का मान बाहर उजागर होता (जैसे
// `(?=(\d+))` से `\1`/समूह-1 आगे इस्तेमाल हो सकता); नकारात्मक रूपों
// ((?!X)/(?<!X)) के capture कभी उजागर नहीं होते (व्यर्थ, X वैसे भी नहीं मिला)।
//
// ⚠️ सीमा: अगर कोई `*`/`+`/`{n,}` से दोहराया गया हिस्सा खाली-पाठ पर भी
// मिल सकता है (जैसे `(a?)*` या एक ख़ाली-कैप्चर वाला `\1`), तो engine
// अनंत-लूप में फँस सकता — ऐसे पैटर्न से बचें (ज़्यादातर व्यावहारिक पैटर्न
// में यह नहीं आता)।
//
// तरीका: पैटर्न को पहले एक छोटे bytecode (अक्षर/वर्ग/कूद/विभाजन/मिलान
// अनुदेश) में संकलित करते, फिर एक recursive backtracking VM उसे चलाता —
// Thompson की classic NFA-निर्माण तकनीक (Russ Cox के लेखों में वर्णित
// सामान्य सिद्धांत) का मूल विचार, इसी भाषा में स्वतंत्र रूप से लिखा गया
// (न कोई मौजूदा regex engine का कोड, न अनुवाद)। "कूद"/"विभाजन" के लक्ष्य
// संख्या-सूचकांक (data) हैं — फलन-संदर्भ/closure नहीं, क्योंकि Sutra में
// प्रथम-श्रेणी फलन नहीं — यही मुख्य डिज़ाइन-अंतर आम backtracking regex
// लेखों से (जो अक्सर continuation-फलनों से समझाते हैं)।
// ============================================================

// ---- वर्ग-जाँच (character class) ----

कार्य रे_वर्ग_जांचो(शब्दकोश अनु, पाठ च) {
    संख्या कोड = अक्षर_मान(च);
    सूची श्रेणियाँ = अनु["श्रेणियाँ"];
    मान मिला = असत्य;
    संख्या इ = 0;
    यावत् (इ < लंबाई(श्रेणियाँ)) {
        संख्या लो = श्रेणियाँ[इ][0];
        संख्या ही = श्रेणियाँ[इ][1];
        यदि (कोड >= लो && कोड <= ही) { मिला = सत्य; }
        इ = इ + 1;
    }
    यदि (अनु["निषेध"] == सत्य) { परत् न मिला; }
    परत् मिला;
}

कार्य रे_वर्ग_बनाओ(सूची श्रेणियाँ, बूल निषेध) {
    शब्दकोश नो = {};
    नो["प्रकार"] = "वर्ग";
    नो["श्रेणियाँ"] = श्रेणियाँ;
    नो["निषेध"] = निषेध;
    परत् नो;
}
कार्य रे_वर्ग_अंक(बूल निषेध) {
    परत् रे_वर्ग_बनाओ([[अक्षर_मान("0"), अक्षर_मान("9")]], निषेध);
}
कार्य रे_वर्ग_शब्द(बूल निषेध) {
    सूची श = [[अक्षर_मान("a"), अक्षर_मान("z")], [अक्षर_मान("A"), अक्षर_मान("Z")],
               [अक्षर_मान("0"), अक्षर_मान("9")], [अक्षर_मान("_"), अक्षर_मान("_")]];
    परत् रे_वर्ग_बनाओ(श, निषेध);
}
कार्य रे_वर्ग_रिक्त(बूल निषेध) {
    सूची श = [[अक्षर_मान(" "), अक्षर_मान(" ")], [अक्षर_मान("\t"), अक्षर_मान("\t")],
               [अक्षर_मान("\n"), अक्षर_मान("\n")], [अक्षर_मान("\r"), अक्षर_मान("\r")]];
    परत् रे_वर्ग_बनाओ(श, निषेध);
}

// ---- पार्सर: पैटर्न-पाठ → AST ----
// अवस्था = {पैटर्न, स्थिति, लंबाई} — विश्लेषक.सूत्र जैसा thread-through शैली

कार्य रे_अव_बनाओ(पाठ पैटर्न) {
    शब्दकोश अ = {};
    अ["पैटर्न"] = पैटर्न;
    अ["स्थिति"] = 0;
    अ["लंबाई"] = लंबाई(पैटर्न);
    अ["समूह_गिनती"] = 0;
    परत् अ;
}
कार्य रे_अव_अंत(शब्दकोश अ) { परत् अ["स्थिति"] >= अ["लंबाई"]; }
कार्य रे_अव_वर्तमान(शब्दकोश अ) {
    यदि (रे_अव_अंत(अ)) { परत् ""; }
    परत् उपखंड(अ["पैटर्न"], अ["स्थिति"], अ["स्थिति"] + 1);
}
कार्य रे_अव_आगे(शब्दकोश अ) { अ["स्थिति"] = अ["स्थिति"] + 1; परत् 0; }

// विकल्प := क्रम ('|' क्रम)*  → सूची of शाखाएँ (हर शाखा एक क्रम-सूची)
कार्य रे_पार्स_विकल्प(शब्दकोश अ) {
    सूची शाखाएँ = [];
    शाखाएँ = जोड़ें(शाखाएँ, रे_पार्स_क्रम(अ));
    यावत् (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "|") {
        रे_अव_आगे(अ);
        शाखाएँ = जोड़ें(शाखाएँ, रे_पार्स_क्रम(अ));
    }
    परत् शाखाएँ;
}

कार्य रे_पार्स_क्रम(शब्दकोश अ) {
    सूची सू = [];
    यावत् (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) != "|" && रे_अव_वर्तमान(अ) != ")") {
        सू = जोड़ें(सू, रे_पार्स_परमाणु(अ));
    }
    परत् सू;
}

// परमाणु := आधार परिमाणक?  → {आधार, न्यून, अधिक(-1=अनंत)}
// {n,m} के भीतर लगातार अंक पढ़ो और संख्या बनाओ
कार्य रे_पार्स_संख्या(शब्दकोश अ) {
    संख्या परिणाम = 0;
    संख्या गिनती = 0;
    यावत् (न रे_अव_अंत(अ)) {
        पाठ च = रे_अव_वर्तमान(अ);
        संख्या कोड = अक्षर_मान(च);
        यदि (कोड < 48 || कोड > 57) { विरामः; }
        परिणाम = परिणाम * 10 + (कोड - 48);
        गिनती = गिनती + 1;
        रे_अव_आगे(अ);
    }
    यदि (गिनती == 0) { प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में अंक अपेक्षित"; }
    परत् परिणाम;
}

// {n} / {n,} / {n,m} पार्स करो (कर्सर पहले ही '{' के बाद है) → {न्यून, अधिक}
कार्य रे_पार्स_गिनती_दोहराव(शब्दकोश अ) {
    संख्या पहला = रे_पार्स_संख्या(अ);
    यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में '}' अपेक्षित"; }
    पाठ अगला = रे_अव_वर्तमान(अ);
    शब्दकोश फल = {};
    यदि (अगला == "}") {
        रे_अव_आगे(अ);
        फल["न्यून"] = पहला;
        फल["अधिक"] = पहला;
        परत् फल;
    }
    यदि (अगला != ",") { प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में ',' या '}' अपेक्षित"; }
    रे_अव_आगे(अ);   // ','
    यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में '}' अपेक्षित"; }
    यदि (रे_अव_वर्तमान(अ) == "}") {
        रे_अव_आगे(अ);
        फल["न्यून"] = पहला;
        फल["अधिक"] = 0 - 1;
        परत् फल;
    }
    संख्या दूसरा = रे_पार्स_संख्या(अ);
    यदि (रे_अव_अंत(अ) || रे_अव_वर्तमान(अ) != "}") {
        प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में '}' अपेक्षित";
    }
    यदि (दूसरा < पहला) {
        प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में अधिकतम न्यूनतम से कम है";
    }
    रे_अव_आगे(अ);
    फल["न्यून"] = पहला;
    फल["अधिक"] = दूसरा;
    परत् फल;
}

कार्य रे_पार्स_परमाणु(शब्दकोश अ) {
    शब्दकोश आधार = रे_पार्स_आधार(अ);
    संख्या न्यून = 1;
    संख्या अधिक = 1;
    यदि (न रे_अव_अंत(अ)) {
        पाठ च = रे_अव_वर्तमान(अ);
        यदि (च == "*") { न्यून = 0; अधिक = 0 - 1; रे_अव_आगे(अ); }
        अन्यथा यदि (च == "+") { न्यून = 1; अधिक = 0 - 1; रे_अव_आगे(अ); }
        अन्यथा यदि (च == "?") { न्यून = 0; अधिक = 1; रे_अव_आगे(अ); }
        अन्यथा यदि (च == "{") {
            रे_अव_आगे(अ);
            शब्दकोश गि = रे_पार्स_गिनती_दोहराव(अ);
            न्यून = गि["न्यून"];
            अधिक = गि["अधिक"];
        }
    }
    शब्दकोश प = {};
    प["आधार"] = आधार;
    प["न्यून"] = न्यून;
    प["अधिक"] = अधिक;
    परत् प;
}

कार्य रे_पार्स_आधार(शब्दकोश अ) {
    यदि (रे_अव_अंत(अ)) {
        प्रक्षेपः "त्रुटिः — रेगेक्स: अप्रत्याशित पैटर्न-अंत";
    }
    पाठ च = रे_अव_वर्तमान(अ);
    यदि (च == "(") {
        रे_अव_आगे(अ);
        यदि (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "?") {
            रे_अव_आगे(अ);   // '?'
            यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: '(?' अधूरा"; }
            पाठ द्वि = रे_अव_वर्तमान(अ);
            यदि (द्वि == ":") {
                रे_अव_आगे(अ);
                सूची विकल्प_ग = रे_पार्स_विकल्प(अ);
                यदि (रे_अव_अंत(अ) || रे_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — रेगेक्स: ')' अपेक्षित"; }
                रे_अव_आगे(अ);
                शब्दकोश नो_ग = {};
                नो_ग["प्रकार"] = "समूह"; नो_ग["विकल्प"] = विकल्प_ग; नो_ग["कैप्चर"] = असत्य; नो_ग["क्रमांक"] = 0;
                परत् नो_ग;
            }
            यदि (द्वि == "=" || द्वि == "!") {
                रे_अव_आगे(अ);
                सूची विकल्प_आ = रे_पार्स_विकल्प(अ);
                यदि (रे_अव_अंत(अ) || रे_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — रेगेक्स: ')' अपेक्षित"; }
                रे_अव_आगे(अ);
                शब्दकोश नो_आ = {};
                नो_आ["प्रकार"] = "आगे_दृष्टि";
                नो_आ["विकल्प"] = विकल्प_आ;
                नो_आ["सकारात्मक"] = द्वि == "=";
                परत् नो_आ;
            }
            यदि (द्वि == "<") {
                रे_अव_आगे(अ);   // '<'
                यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: '(?<' अधूरा"; }
                पाठ त्रि = रे_अव_वर्तमान(अ);
                यदि (त्रि != "=" && त्रि != "!") {
                    प्रक्षेपः "त्रुटिः — रेगेक्स: '(?<' के बाद सिर्फ़ '=' या '!' समर्थित (lookbehind)";
                }
                रे_अव_आगे(अ);
                सूची विकल्प_प = रे_पार्स_विकल्प(अ);
                यदि (रे_अव_अंत(अ) || रे_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — रेगेक्स: ')' अपेक्षित"; }
                रे_अव_आगे(अ);
                शब्दकोश नो_प = {};
                नो_प["प्रकार"] = "पीछे_दृष्टि";
                नो_प["विकल्प"] = विकल्प_प;
                नो_प["सकारात्मक"] = त्रि == "=";
                परत् नो_प;
            }
            प्रक्षेपः "त्रुटिः — रेगेक्स: '(?' के बाद सिर्फ़ ':' '=' '!' '<=' '<!' समर्थित";
        }
        अ["समूह_गिनती"] = अ["समूह_गिनती"] + 1;
        संख्या क्रमांक = अ["समूह_गिनती"];
        सूची विकल्प = रे_पार्स_विकल्प(अ);
        यदि (रे_अव_अंत(अ) || रे_अव_वर्तमान(अ) != ")") {
            प्रक्षेपः "त्रुटिः — रेगेक्स: ')' अपेक्षित";
        }
        रे_अव_आगे(अ);
        शब्दकोश नो = {};
        नो["प्रकार"] = "समूह";
        नो["विकल्प"] = विकल्प;
        नो["कैप्चर"] = सत्य;
        नो["क्रमांक"] = क्रमांक;
        परत् नो;
    }
    यदि (च == "[") { परत् रे_पार्स_वर्ग(अ); }
    यदि (च == ".") {
        रे_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "कोई_भी";
        परत् नो;
    }
    यदि (च == "^") {
        रे_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "आरंभ";
        परत् नो;
    }
    यदि (च == "$") {
        रे_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "अंत";
        परत् नो;
    }
    यदि (च == "\\") {
        रे_अव_आगे(अ);
        परत् रे_पार्स_एस्केप(अ);
    }
    रे_अव_आगे(अ);
    शब्दकोश नो = {}; नो["प्रकार"] = "अक्षर"; नो["मान"] = च;
    परत् नो;
}

कार्य रे_पार्स_एस्केप(शब्दकोश अ) {
    यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: '\\' के बाद अक्षर अपेक्षित"; }
    पाठ च = रे_अव_वर्तमान(अ);
    रे_अव_आगे(अ);
    यदि (च == "d") { परत् रे_वर्ग_अंक(असत्य); }
    यदि (च == "D") { परत् रे_वर्ग_अंक(सत्य); }
    यदि (च == "w") { परत् रे_वर्ग_शब्द(असत्य); }
    यदि (च == "W") { परत् रे_वर्ग_शब्द(सत्य); }
    यदि (च == "s") { परत् रे_वर्ग_रिक्त(असत्य); }
    यदि (च == "S") { परत् रे_वर्ग_रिक्त(सत्य); }
    संख्या कोड = अक्षर_मान(च);
    यदि (कोड >= 49 && कोड <= 57) {   // '1'-'9' — backreference (एक-अंक, v1)
        शब्दकोश नो = {};
        नो["प्रकार"] = "पीछे_संदर्भ";
        नो["क्रमांक"] = कोड - 48;
        परत् नो;
    }
    शब्दकोश नो = {}; नो["प्रकार"] = "अक्षर"; नो["मान"] = च;
    परत् नो;
}

कार्य रे_पार्स_वर्ग(शब्दकोश अ) {
    रे_अव_आगे(अ);   // '['
    बूल निषेध = असत्य;
    यदि (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "^") {
        निषेध = सत्य;
        रे_अव_आगे(अ);
    }
    सूची श्रेणियाँ = [];
    मान पहला = सत्य;
    यावत् (न रे_अव_अंत(अ) && (रे_अव_वर्तमान(अ) != "]" || पहला)) {
        पहला = असत्य;
        पाठ च1 = रे_अव_वर्तमान(अ);
        यदि (च1 == "\\") {
            रे_अव_आगे(अ);
            यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: वर्ग में अधूरा escape"; }
            पाठ ई = रे_अव_वर्तमान(अ);
            रे_अव_आगे(अ);
            यदि (ई == "d") { श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("0"), अक्षर_मान("9")]); }
            अन्यथा यदि (ई == "w") {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("a"), अक्षर_मान("z")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("A"), अक्षर_मान("Z")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("0"), अक्षर_मान("9")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("_"), अक्षर_मान("_")]);
            }
            अन्यथा यदि (ई == "s") {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान(" "), अक्षर_मान(" ")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("\t"), अक्षर_मान("\t")]);
            } अन्यथा {
                संख्या कोड = अक्षर_मान(ई);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड, कोड]);
            }
        } अन्यथा {
            रे_अव_आगे(अ);
            संख्या कोड1 = अक्षर_मान(च1);
            यदि (न रे_अव_अंत(अ) && रे_अव_वर्तमान(अ) == "-"
                && (अ["स्थिति"] + 1) < अ["लंबाई"]
                && उपखंड(अ["पैटर्न"], अ["स्थिति"] + 1, अ["स्थिति"] + 2) != "]") {
                रे_अव_आगे(अ);   // '-'
                पाठ च2 = रे_अव_वर्तमान(अ);
                रे_अव_आगे(अ);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड1, अक्षर_मान(च2)]);
            } अन्यथा {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड1, कोड1]);
            }
        }
    }
    यदि (रे_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — रेगेक्स: ']' अपेक्षित"; }
    रे_अव_आगे(अ);   // ']'
    परत् रे_वर्ग_बनाओ(श्रेणियाँ, निषेध);
}

// ---- संकलक: AST → bytecode ----
// हर उप-संकलन एक सूची-of-अनुदेश लौटाता जिसके "कूद"/"विभाजन" लक्ष्य उसी
// सूची के भीतर LOCAL (0-आधारित) सूचकांक होते — जोड़ते वक़्त ऑफसेट-समायोजन

कार्य रे_अनु_अक्षर(पाठ च) { शब्दकोश अ = {}; अ["प्रकार"] = "अक्षर"; अ["मान"] = च; परत् अ; }
कार्य रे_अनु_कोई_भी() { शब्दकोश अ = {}; अ["प्रकार"] = "कोई_भी"; परत् अ; }
कार्य रे_अनु_आरंभ() { शब्दकोश अ = {}; अ["प्रकार"] = "आरंभ"; परत् अ; }
कार्य रे_अनु_अंत_एंकर() { शब्दकोश अ = {}; अ["प्रकार"] = "अंत"; परत् अ; }
कार्य रे_अनु_कूद(संख्या ल) { शब्दकोश अ = {}; अ["प्रकार"] = "कूद"; अ["लक्ष्य"] = ल; परत् अ; }
कार्य रे_अनु_विभाजन(संख्या ल1, संख्या ल2) {
    शब्दकोश अ = {}; अ["प्रकार"] = "विभाजन"; अ["लक्ष्य1"] = ल1; अ["लक्ष्य2"] = ल2; परत् अ;
}
कार्य रे_अनु_मिलान() { शब्दकोश अ = {}; अ["प्रकार"] = "मिलान"; परत् अ; }
कार्य रे_अनु_पकड़_आरंभ(संख्या क्रमांक) {
    शब्दकोश अ = {}; अ["प्रकार"] = "पकड़_आरंभ"; अ["क्रमांक"] = क्रमांक; परत् अ;
}
कार्य रे_अनु_पकड़_अंत(संख्या क्रमांक) {
    शब्दकोश अ = {}; अ["प्रकार"] = "पकड़_अंत"; अ["क्रमांक"] = क्रमांक; परत् अ;
}
कार्य रे_अनु_पीछे_संदर्भ(संख्या क्रमांक) {
    शब्दकोश अ = {}; अ["प्रकार"] = "पीछे_संदर्भ"; अ["क्रमांक"] = क्रमांक; परत् अ;
}
// आगे_दृष्टि/पीछे_दृष्टि — उप_कोड एक अलग, स्वतंत्र bytecode-सूची (अपना
// शून्य-आधारित PC-स्थान, "मिलान" पर समाप्त) — "उप-दिनचर्या कॉल" जैसा, बाहरी
// सूची में offset-समायोजन की ज़रूरत नहीं (रे_कोड_ऑफसेट इसे ज्यों-का-त्यों
// कॉपी करता, "कूद"/"विभाजन" जैसे लक्ष्य-फ़ील्ड नहीं होते)
कार्य रे_अनु_आगे_दृष्टि(सूची उप_कोड, बूल सकारात्मक) {
    शब्दकोश अ = {}; अ["प्रकार"] = "आगे_दृष्टि"; अ["उप_कोड"] = उप_कोड; अ["सकारात्मक"] = सकारात्मक; परत् अ;
}
कार्य रे_अनु_पीछे_दृष्टि(सूची उप_कोड, संख्या चौड़ाई, बूल सकारात्मक) {
    शब्दकोश अ = {};
    अ["प्रकार"] = "पीछे_दृष्टि"; अ["उप_कोड"] = उप_कोड; अ["चौड़ाई"] = चौड़ाई; अ["सकारात्मक"] = सकारात्मक;
    परत् अ;
}

कार्य रे_कोड_ऑफसेट(सूची कोड, संख्या ऑफ) {
    सूची नया = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "कूद") { नया = जोड़ें(नया, रे_अनु_कूद(अ["लक्ष्य"] + ऑफ)); }
        अन्यथा यदि (अ["प्रकार"] == "विभाजन") {
            नया = जोड़ें(नया, रे_अनु_विभाजन(अ["लक्ष्य1"] + ऑफ, अ["लक्ष्य2"] + ऑफ));
        } अन्यथा {
            नया = जोड़ें(नया, अ);
        }
        इ = इ + 1;
    }
    परत् नया;
}

कार्य रे_कोड_जोड़ो(सूची अ, सूची ब) {
    सूची ब2 = रे_कोड_ऑफसेट(ब, लंबाई(अ));
    सूची परिणाम = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(अ)) { परिणाम = जोड़ें(परिणाम, अ[इ]); इ = इ + 1; }
    इ = 0;
    यावत् (इ < लंबाई(ब2)) { परिणाम = जोड़ें(परिणाम, ब2[इ]); इ = इ + 1; }
    परत् परिणाम;
}

// ---- स्थिर-चौड़ाई गणना (lookbehind के लिए — इसकी लंबाई संकलन-समय पर एक
// निश्चित संख्या होनी ज़रूरी, चर-दोहराव/backreference वाला हिस्सा नहीं) ----
// -1 = चौड़ाई अज्ञात/चर (lookbehind में समर्थित नहीं)

कार्य रे_चौड़ाई_आधार(शब्दकोश आधार) {
    पाठ प्र = आधार["प्रकार"];
    यदि (प्र == "अक्षर" || प्र == "कोई_भी" || प्र == "वर्ग") { परत् 1; }
    यदि (प्र == "आरंभ" || प्र == "अंत") { परत् 0; }
    यदि (प्र == "आगे_दृष्टि" || प्र == "पीछे_दृष्टि") { परत् 0; }   // दोनों शून्य-चौड़ाई दावे
    यदि (प्र == "पीछे_संदर्भ") { परत् 0 - 1; }   // चर-लंबाई (रनटाइम-निर्भर)
    यदि (प्र == "समूह") { परत् रे_चौड़ाई_विकल्प(आधार["विकल्प"]); }
    परत् 0 - 1;
}
कार्य रे_चौड़ाई_परमाणु(शब्दकोश परमाणु) {
    यदि (परमाणु["न्यून"] != परमाणु["अधिक"]) { परत् 0 - 1; }   // */+/? या {n,m} n≠m
    संख्या आ = रे_चौड़ाई_आधार(परमाणु["आधार"]);
    यदि (आ < 0) { परत् 0 - 1; }
    परत् आ * परमाणु["न्यून"];
}
कार्य रे_चौड़ाई_क्रम(सूची परमाणु_सूची) {
    संख्या कुल = 0;
    संख्या इ = 0;
    यावत् (इ < लंबाई(परमाणु_सूची)) {
        संख्या च = रे_चौड़ाई_परमाणु(परमाणु_सूची[इ]);
        यदि (च < 0) { परत् 0 - 1; }
        कुल = कुल + च;
        इ = इ + 1;
    }
    परत् कुल;
}
कार्य रे_चौड़ाई_विकल्प(सूची शाखाएँ) {
    यदि (लंबाई(शाखाएँ) == 0) { परत् 0; }
    संख्या पहली = रे_चौड़ाई_क्रम(शाखाएँ[0]);
    यदि (पहली < 0) { परत् 0 - 1; }
    संख्या इ = 1;
    यावत् (इ < लंबाई(शाखाएँ)) {
        यदि (रे_चौड़ाई_क्रम(शाखाएँ[इ]) != पहली) { परत् 0 - 1; }
        इ = इ + 1;
    }
    परत् पहली;
}

कार्य रे_संकलन_आधार(शब्दकोश आधार) {
    पाठ प्र = आधार["प्रकार"];
    यदि (प्र == "अक्षर") { परत् [रे_अनु_अक्षर(आधार["मान"])]; }
    यदि (प्र == "कोई_भी") { परत् [रे_अनु_कोई_भी()]; }
    यदि (प्र == "वर्ग") { परत् [आधार]; }   // वर्ग-नोड खुद ही अनुदेश जैसा (प्रकार="वर्ग")
    यदि (प्र == "आरंभ") { परत् [रे_अनु_आरंभ()]; }
    यदि (प्र == "अंत") { परत् [रे_अनु_अंत_एंकर()]; }
    यदि (प्र == "पीछे_संदर्भ") { परत् [रे_अनु_पीछे_संदर्भ(आधार["क्रमांक"])]; }
    यदि (प्र == "आगे_दृष्टि") {
        सूची उप_कोड = जोड़ें(रे_संकलन_विकल्प(आधार["विकल्प"]), रे_अनु_मिलान());
        परत् [रे_अनु_आगे_दृष्टि(उप_कोड, आधार["सकारात्मक"])];
    }
    यदि (प्र == "पीछे_दृष्टि") {
        संख्या चौड़ाई = रे_चौड़ाई_विकल्प(आधार["विकल्प"]);
        यदि (चौड़ाई < 0) {
            प्रक्षेपः "त्रुटिः — रेगेक्स: lookbehind की लंबाई स्थिर (fixed-width) होनी चाहिए — */+/{n,m}(n≠m)/backreference भीतर समर्थित नहीं";
        }
        सूची उप_कोड = जोड़ें(रे_संकलन_विकल्प(आधार["विकल्प"]), रे_अनु_मिलान());
        परत् [रे_अनु_पीछे_दृष्टि(उप_कोड, चौड़ाई, आधार["सकारात्मक"])];
    }
    यदि (प्र == "समूह") {
        सूची भीतरी = रे_संकलन_विकल्प(आधार["विकल्प"]);
        यदि (आधार["कैप्चर"] != सत्य) { परत् भीतरी; }
        सूची शुरू = [रे_अनु_पकड़_आरंभ(आधार["क्रमांक"])];
        सूची अंत_अनु = [रे_अनु_पकड़_अंत(आधार["क्रमांक"])];
        परत् रे_कोड_जोड़ो(रे_कोड_जोड़ो(शुरू, भीतरी), अंत_अनु);
    }
    प्रक्षेपः "त्रुटिः — रेगेक्स: अज्ञात नोड प्रकार";
}

// परमाणु (आधार + न्यून/अधिक दोहराव) — यहीं */+/? की bytecode-मशीनरी
// आ_कोड को न्यून..अधिक बार दोहराने वाली bytecode बनाओ (अधिक == -1 माने अनंत)।
// तीन आधार-मामले (*, +, ?) सीधे हाथ-अनुकूलित bytecode; सामान्य {n,m} उन्हीं
// तीन में विघटित होता (न अनिवार्य प्रतियाँ + बाकी वैकल्पिक/तारा पूंछ) —
// इसलिए {0,1}=?, {0,∞}=*, {1,∞}=+ स्वतः उन्हीं सिद्ध रास्तों से गुज़रते।
कार्य रे_संकलन_दोहराव(सूची आ_कोड, संख्या न्यून, संख्या अधिक) {
    यदि (न्यून == 1 && अधिक == 1) { परत् आ_कोड; }

    संख्या गिनती = लंबाई(आ_कोड);

    यदि (न्यून == 0 && अधिक == (0 - 1)) {
        // A*  : 0: विभाजन(1, गिनती+2)   1..गिनती: <आ_कोड@1>   गिनती+1: कूद(0)
        सूची शिफ्ट = रे_कोड_ऑफसेट(आ_कोड, 1);
        सूची परिणाम = [रे_अनु_विभाजन(1, गिनती + 2)];
        संख्या इ = 0;
        यावत् (इ < लंबाई(शिफ्ट)) { परिणाम = जोड़ें(परिणाम, शिफ्ट[इ]); इ = इ + 1; }
        परिणाम = जोड़ें(परिणाम, रे_अनु_कूद(0));
        परत् परिणाम;
    }
    यदि (न्यून == 1 && अधिक == (0 - 1)) {
        // A+  : 0..गिनती-1: <आ_कोड@0>   गिनती: विभाजन(0, गिनती+1)
        सूची परिणाम = [];
        संख्या इ = 0;
        यावत् (इ < गिनती) { परिणाम = जोड़ें(परिणाम, आ_कोड[इ]); इ = इ + 1; }
        परिणाम = जोड़ें(परिणाम, रे_अनु_विभाजन(0, गिनती + 1));
        परत् परिणाम;
    }
    यदि (न्यून == 0 && अधिक == 1) {
        // A?  : 0: विभाजन(1, गिनती+1)   1..गिनती: <आ_कोड@1>
        सूची शिफ्ट = रे_कोड_ऑफसेट(आ_कोड, 1);
        सूची परिणाम = [रे_अनु_विभाजन(1, गिनती + 1)];
        संख्या इ = 0;
        यावत् (इ < लंबाई(शिफ्ट)) { परिणाम = जोड़ें(परिणाम, शिफ्ट[इ]); इ = इ + 1; }
        परत् परिणाम;
    }

    // सामान्य {n,m} / {n,} / {n} — न अनिवार्य प्रतियाँ, फिर बाकी वैकल्पिक
    यदि (न्यून < 0) { प्रक्षेपः "त्रुटिः — रेगेक्स: दोहराव-न्यूनतम ऋणात्मक नहीं हो सकता"; }
    सूची कोड = [];
    संख्या इ = 0;
    यावत् (इ < न्यून) {
        कोड = रे_कोड_जोड़ो(कोड, आ_कोड);
        इ = इ + 1;
    }
    यदि (अधिक == (0 - 1)) {
        कोड = रे_कोड_जोड़ो(कोड, रे_संकलन_दोहराव(आ_कोड, 0, 0 - 1));
        परत् कोड;
    }
    संख्या बाकी = अधिक - न्यून;
    यदि (बाकी < 0) { प्रक्षेपः "त्रुटिः — रेगेक्स: {n,m} में अधिकतम न्यूनतम से कम"; }
    इ = 0;
    यावत् (इ < बाकी) {
        कोड = रे_कोड_जोड़ो(कोड, रे_संकलन_दोहराव(आ_कोड, 0, 1));
        इ = इ + 1;
    }
    परत् कोड;
}

कार्य रे_संकलन_परमाणु(शब्दकोश परमाणु) {
    सूची आ_कोड = रे_संकलन_आधार(परमाणु["आधार"]);
    परत् रे_संकलन_दोहराव(आ_कोड, परमाणु["न्यून"], परमाणु["अधिक"]);
}

कार्य रे_संकलन_क्रम(सूची परमाणु_सूची) {
    सूची कोड = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(परमाणु_सूची)) {
        कोड = रे_कोड_जोड़ो(कोड, रे_संकलन_परमाणु(परमाणु_सूची[इ]));
        इ = इ + 1;
    }
    परत् कोड;
}

// विकल्प (शाखाओं की सूची) — 1 शाखा हो तो सीधे, नहीं तो split-श्रृंखला
कार्य रे_संकलन_विकल्प(सूची शाखाएँ) {
    यदि (लंबाई(शाखाएँ) == 1) { परत् रे_संकलन_क्रम(शाखाएँ[0]); }
    परत् रे_संकलन_विकल्प_सहायक(शाखाएँ, 0);
}
कार्य रे_संकलन_विकल्प_सहायक(सूची शाखाएँ, संख्या सूचक) {
    यदि (सूचक == लंबाई(शाखाएँ) - 1) { परत् रे_संकलन_क्रम(शाखाएँ[सूचक]); }
    सूची यह = रे_संकलन_क्रम(शाखाएँ[सूचक]);
    सूची बाकी = रे_संकलन_विकल्प_सहायक(शाखाएँ, सूचक + 1);
    संख्या गिनती_यह = लंबाई(यह);
    संख्या गिनती_बाकी = लंबाई(बाकी);
    सूची यह_शिफ्ट = रे_कोड_ऑफसेट(यह, 1);
    सूची बाकी_शिफ्ट = रे_कोड_ऑफसेट(बाकी, गिनती_यह + 2);
    सूची परिणाम = [रे_अनु_विभाजन(1, गिनती_यह + 2)];
    संख्या इ = 0;
    यावत् (इ < लंबाई(यह_शिफ्ट)) { परिणाम = जोड़ें(परिणाम, यह_शिफ्ट[इ]); इ = इ + 1; }
    परिणाम = जोड़ें(परिणाम, रे_अनु_कूद(गिनती_यह + गिनती_बाकी + 2));
    इ = 0;
    यावत् (इ < लंबाई(बाकी_शिफ्ट)) { परिणाम = जोड़ें(परिणाम, बाकी_शिफ्ट[इ]); इ = इ + 1; }
    परत् परिणाम;
}

// ---- VM: recursive backtracking (कोई closure नहीं — "आगे क्या" हमेशा
// एक संख्या-सूचकांक (पीसी) है, प्रथम-श्रेणी फलन नहीं) ----

// कैप्चर — शब्दकोश, संदर्भ-उत्परिवर्तित (v1: कुंजी "<क्रमांक>_आरंभ"/"<क्रमांक>_अंत")।
// विभाजन पर snapshot/restore ज़रूरी — पहली शाखा आंशिक रूप से मैच होकर फिर
// विफल हो सकती, तब तक जो capture सेट हुए वो दूसरी शाखा आज़माने से पहले
// वापस पुराने मान पर लौटने चाहिए (नहीं तो असफल शाखा के stale capture दूसरी,
// सफल शाखा के परिणाम में रिसते)।

कार्य रे_कैप्चर_कॉपी(शब्दकोश कैप्चर) {
    शब्दकोश नक़ल = {};
    सूची कुं = कुंजियाँ(कैप्चर);
    संख्या इ = 0;
    यावत् (इ < लंबाई(कुं)) {
        नक़ल[कुं[इ]] = कैप्चर[कुं[इ]];
        इ = इ + 1;
    }
    परत् नक़ल;
}
कार्य रे_कैप्चर_पुनर्स्थापन(शब्दकोश कैप्चर, शब्दकोश नक़ल) {
    सूची कुं = कुंजियाँ(नक़ल);
    संख्या इ = 0;
    यावत् (इ < लंबाई(कुं)) {
        कैप्चर[कुं[इ]] = नक़ल[कुं[इ]];
        इ = इ + 1;
    }
    परत् 0;
}

कार्य रे_चलाओ(सूची कोड, संख्या पीसी, पाठ स्रोत, संख्या प_इ, संख्या पाठ_लं, शब्दकोश कैप्चर) {
    शब्दकोश अनु = कोड[पीसी];
    पाठ प्र = अनु["प्रकार"];
    यदि (प्र == "मिलान") { परत् प_इ; }
    यदि (प्र == "अक्षर") {
        यदि (प_इ < पाठ_लं && उपखंड(स्रोत, प_इ, प_इ + 1) == अनु["मान"]) {
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + 1, पाठ_लं, कैप्चर);
        }
        परत् 0 - 1;
    }
    यदि (प्र == "कोई_भी") {
        यदि (प_इ < पाठ_लं) { परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + 1, पाठ_लं, कैप्चर); }
        परत् 0 - 1;
    }
    यदि (प्र == "वर्ग") {
        यदि (प_इ < पाठ_लं && रे_वर्ग_जांचो(अनु, उपखंड(स्रोत, प_इ, प_इ + 1))) {
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + 1, पाठ_लं, कैप्चर);
        }
        परत् 0 - 1;
    }
    यदि (प्र == "आरंभ") {
        यदि (प_इ == 0) { परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं, कैप्चर); }
        परत् 0 - 1;
    }
    यदि (प्र == "अंत") {
        यदि (प_इ == पाठ_लं) { परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं, कैप्चर); }
        परत् 0 - 1;
    }
    यदि (प्र == "पकड़_आरंभ") {
        कैप्चर[("" + अनु["क्रमांक"]) + "_आरंभ"] = प_इ;
        परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं, कैप्चर);
    }
    यदि (प्र == "पकड़_अंत") {
        कैप्चर[("" + अनु["क्रमांक"]) + "_अंत"] = प_इ;
        परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं, कैप्चर);
    }
    यदि (प्र == "पीछे_संदर्भ") {
        संख्या ग_आ = कैप्चर[("" + अनु["क्रमांक"]) + "_आरंभ"];
        संख्या ग_अं = कैप्चर[("" + अनु["क्रमांक"]) + "_अंत"];
        यदि (ग_आ < 0 || ग_अं < 0) { परत् 0 - 1; }   // समूह अभी तक मिला नहीं
        संख्या ग_लं = ग_अं - ग_आ;
        यदि (प_इ + ग_लं > पाठ_लं) { परत् 0 - 1; }
        यदि (उपखंड(स्रोत, प_इ, प_इ + ग_लं) == उपखंड(स्रोत, ग_आ, ग_अं)) {
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ + ग_लं, पाठ_लं, कैप्चर);
        }
        परत् 0 - 1;
    }
    यदि (प्र == "आगे_दृष्टि") {
        शब्दकोश नक़ल = रे_कैप्चर_कॉपी(कैप्चर);
        संख्या उप_परिणाम = रे_चलाओ(अनु["उप_कोड"], 0, स्रोत, प_इ, पाठ_लं, कैप्चर);
        बूल सफल = उप_परिणाम >= 0;
        यदि (सफल == अनु["सकारात्मक"]) {
            यदि (सफल != सत्य) { रे_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल); }   // नकारात्मक-सफल: कुछ उजागर नहीं
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं, कैप्चर);
        }
        रे_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल);
        परत् 0 - 1;
    }
    यदि (प्र == "पीछे_दृष्टि") {
        संख्या शुरू = प_इ - अनु["चौड़ाई"];
        शब्दकोश नक़ल2 = रे_कैप्चर_कॉपी(कैप्चर);
        बूल सफल2 = असत्य;
        यदि (शुरू >= 0) {
            संख्या उप_परिणाम2 = रे_चलाओ(अनु["उप_कोड"], 0, स्रोत, शुरू, पाठ_लं, कैप्चर);
            सफल2 = उप_परिणाम2 == प_इ;
        }
        यदि (सफल2 == अनु["सकारात्मक"]) {
            यदि (सफल2 != सत्य) { रे_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल2); }
            परत् रे_चलाओ(कोड, पीसी + 1, स्रोत, प_इ, पाठ_लं, कैप्चर);
        }
        रे_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल2);
        परत् 0 - 1;
    }
    यदि (प्र == "कूद") { परत् रे_चलाओ(कोड, अनु["लक्ष्य"], स्रोत, प_इ, पाठ_लं, कैप्चर); }
    यदि (प्र == "विभाजन") {
        शब्दकोश नक़ल = रे_कैप्चर_कॉपी(कैप्चर);
        संख्या प1 = रे_चलाओ(कोड, अनु["लक्ष्य1"], स्रोत, प_इ, पाठ_लं, कैप्चर);
        यदि (प1 >= 0) { परत् प1; }
        रे_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल);
        परत् रे_चलाओ(कोड, अनु["लक्ष्य2"], स्रोत, प_इ, पाठ_लं, कैप्चर);
    }
    प्रक्षेपः "त्रुटिः — रेगेक्स: अज्ञात bytecode प्रकार";
}

// संकलित bytecode में सबसे बड़ा capture-क्रमांक (0 = कोई capturing group नहीं)
// आगे_दृष्टि/पीछे_दृष्टि के उप_कोड में भी झाँकता — कोई समूह वहाँ घोषित हो
// सकता (जैसे "(?=(\d+))\d+\1" — समूह 1 lookahead के भीतर, \1 बाहर)
कार्य रे_अधिकतम_समूह(सूची कोड) {
    संख्या अधि = 0;
    संख्या इ = 0;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "पकड़_आरंभ") {
            यदि (अ["क्रमांक"] > अधि) { अधि = अ["क्रमांक"]; }
        } अन्यथा यदि (अ["प्रकार"] == "आगे_दृष्टि" || अ["प्रकार"] == "पीछे_दृष्टि") {
            संख्या भीतरी = रे_अधिकतम_समूह(अ["उप_कोड"]);
            यदि (भीतरी > अधि) { अधि = भीतरी; }
        }
        इ = इ + 1;
    }
    परत् अधि;
}

// ताज़ा कैप्चर-अवस्था — सारे स्लॉट "अभी तक नहीं मिला" (-1) पर आरंभित
कार्य रे_कैप्चर_बनाओ(संख्या अधिकतम) {
    शब्दकोश क = {};
    संख्या इ = 1;
    यावत् (इ <= अधिकतम) {
        क[("" + इ) + "_आरंभ"] = 0 - 1;
        क[("" + इ) + "_अंत"] = 0 - 1;
        इ = इ + 1;
    }
    परत् क;
}

// पूर्ण कैप्चर-अवस्था से हर समूह का मिला हुआ पाठ निकालो (न मिला → शून्यम्)
कार्य रे_कैप्चर_निकालो(शब्दकोश कैप्चर, संख्या अधिकतम, पाठ स्रोत) {
    सूची फल = [];
    संख्या इ = 1;
    यावत् (इ <= अधिकतम) {
        संख्या आ = कैप्चर[("" + इ) + "_आरंभ"];
        संख्या अं = कैप्चर[("" + इ) + "_अंत"];
        यदि (आ >= 0 && अं >= 0) {
            फल = जोड़ें(फल, उपखंड(स्रोत, आ, अं));
        } अन्यथा {
            फल = जोड़ें(फल, शून्यम्);
        }
        इ = इ + 1;
    }
    परत् फल;
}

// हर \N backreference किसी वास्तव में घोषित capturing group को संदर्भित
// करे — नहीं तो compile-time त्रुटि (runtime हमेशा-असफल से बेहतर)। समूह
// पूरे पैटर्न में कहीं भी घोषित हो सकता (आगे_दृष्टि/पीछे_दृष्टि के भीतर भी),
// इसलिए अधि एक बार शीर्ष-स्तर पर गणना कर हर स्तर पर वही इस्तेमाल होता।
कार्य रे_सत्यापन_पीछे_संदर्भ_सहायक(सूची कोड, संख्या अधि) {
    संख्या इ = 0;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "पीछे_संदर्भ" && अ["क्रमांक"] > अधि) {
            प्रक्षेपः "त्रुटिः — रेगेक्स: \\" + ("" + अ["क्रमांक"]) + " किसी घोषित समूह को संदर्भित नहीं करता";
        } अन्यथा यदि (अ["प्रकार"] == "आगे_दृष्टि" || अ["प्रकार"] == "पीछे_दृष्टि") {
            रे_सत्यापन_पीछे_संदर्भ_सहायक(अ["उप_कोड"], अधि);
        }
        इ = इ + 1;
    }
    परत् 0;
}
कार्य रे_सत्यापन_पीछे_संदर्भ(सूची कोड) {
    परत् रे_सत्यापन_पीछे_संदर्भ_सहायक(कोड, रे_अधिकतम_समूह(कोड));
}

// ---- सार्वजनिक API ----

कार्य रेगेक्स_संकलन(पाठ पैटर्न) {
    शब्दकोश अ = रे_अव_बनाओ(पैटर्न);
    सूची शाखाएँ = रे_पार्स_विकल्प(अ);
    यदि (न रे_अव_अंत(अ)) {
        प्रक्षेपः "त्रुटिः — रेगेक्स: अनपेक्षित ')' या पैटर्न में गड़बड़ी";
    }
    सूची कोड = जोड़ें(रे_संकलन_विकल्प(शाखाएँ), रे_अनु_मिलान());
    रे_सत्यापन_पीछे_संदर्भ(कोड);
    परत् कोड;
}

कार्य रे_खोजो_संकलित(सूची कोड, पाठ स्रोत, संख्या शुरू_से) {
    संख्या लं = लंबाई(स्रोत);
    संख्या अधि = रे_अधिकतम_समूह(कोड);
    संख्या श = शुरू_से;
    यावत् (श <= लं) {
        शब्दकोश कैप्चर = रे_कैप्चर_बनाओ(अधि);
        संख्या अंत = रे_चलाओ(कोड, 0, स्रोत, श, लं, कैप्चर);
        यदि (अंत >= 0) {
            शब्दकोश प = {};
            प["मिला"] = सत्य;
            प["आरंभ"] = श;
            प["अंत"] = अंत;
            प["पाठ"] = उपखंड(स्रोत, श, अंत);
            प["समूह"] = रे_कैप्चर_निकालो(कैप्चर, अधि, स्रोत);
            परत् प;
        }
        श = श + 1;
    }
    शब्दकोश असफल = {};
    असफल["मिला"] = असत्य;
    परत् असफल;
}

// पैटर्न स्रोत-पाठ में कहीं भी मिलता है? (re.search जैसा, बूल रूप)
कार्य रेगेक्स_मिलान(पाठ पैटर्न, पाठ स्रोत) {
    शब्दकोश प = रेगेक्स_खोजो(पैटर्न, स्रोत);
    परत् प["मिला"];
}

// पूरा स्रोत-पाठ बिल्कुल पैटर्न से मिलता है? (re.fullmatch जैसा)
कार्य रेगेक्स_पूर्ण_मिलान(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    संख्या लं = लंबाई(स्रोत);
    शब्दकोश कैप्चर = रे_कैप्चर_बनाओ(रे_अधिकतम_समूह(कोड));
    परत् रे_चलाओ(कोड, 0, स्रोत, 0, लं, कैप्चर) == लं;
}

// पहला मिलान — {मिला, आरंभ, अंत, पाठ} (re.search जैसा, विवरण सहित)
कार्य रेगेक्स_खोजो(पाठ पैटर्न, पाठ स्रोत) {
    परत् रे_खोजो_संकलित(रेगेक्स_संकलन(पैटर्न), स्रोत, 0);
}

// सभी (non-overlapping, बाएँ-से-दाएँ) मिलान — सूची of matched पाठ (re.findall जैसा)
कार्य रेगेक्स_सभी_खोजो(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        परिणाम = जोड़ें(परिणाम, मि["पाठ"]);
        यदि (मि["अंत"] > मि["आरंभ"]) { श = मि["अंत"]; } अन्यथा { श = मि["अंत"] + 1; }
    }
    परत् परिणाम;
}

// प्रतिस्थापन-पाठ में $1-$9 (समूह), $0 (पूरा मिलान), $$ (literal $) लागू करो
कार्य रे_प्रतिस्थापन_लागू(पाठ प्रतिस्थापन, सूची समूह, पाठ पूरा_मिलान) {
    पाठ फल = "";
    संख्या इ = 0;
    संख्या लं = लंबाई(प्रतिस्थापन);
    यावत् (इ < लं) {
        पाठ च = उपखंड(प्रतिस्थापन, इ, इ + 1);
        यदि (च == "$" && इ + 1 < लं) {
            पाठ अगला = उपखंड(प्रतिस्थापन, इ + 1, इ + 2);
            यदि (अगला == "$") {
                फल = फल + "$";
                इ = इ + 2;
            } अन्यथा यदि (अगला == "0") {
                फल = फल + पूरा_मिलान;
                इ = इ + 2;
            } अन्यथा {
                संख्या कोड = अक्षर_मान(अगला);
                यदि (कोड >= 49 && कोड <= 57) {
                    संख्या क्रमांक = कोड - 48;
                    यदि (क्रमांक <= लंबाई(समूह) && समूह[क्रमांक - 1] != शून्यम्) {
                        फल = फल + समूह[क्रमांक - 1];
                    }
                    इ = इ + 2;
                } अन्यथा {
                    फल = फल + च;
                    इ = इ + 1;
                }
            }
        } अन्यथा {
            फल = फल + च;
            इ = इ + 1;
        }
    }
    परत् फल;
}

// हर मिलान को प्रतिस्थापन-पाठ से बदलो (re.sub जैसा; $1-$9/$0/$$ समर्थित —
// पैटर्न के भीतर \1 backreference नहीं, प्रतिस्थापन-पाठ का अपना $N है)
कार्य रेगेक्स_बदलो(पाठ पैटर्न, पाठ स्रोत, पाठ प्रतिस्थापन) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    पाठ परिणाम = "";
    संख्या लं = लंबाई(स्रोत);
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) {
            परिणाम = परिणाम + उपखंड(स्रोत, श, लं);
            परत् परिणाम;
        }
        परिणाम = परिणाम + उपखंड(स्रोत, श, मि["आरंभ"]) + रे_प्रतिस्थापन_लागू(प्रतिस्थापन, मि["समूह"], मि["पाठ"]);
        यदि (मि["अंत"] > मि["आरंभ"]) {
            श = मि["अंत"];
        } अन्यथा {
            यदि (मि["अंत"] < लं) { परिणाम = परिणाम + उपखंड(स्रोत, मि["अंत"], मि["अंत"] + 1); }
            श = मि["अंत"] + 1;
        }
    }
    परत् परिणाम;
}

// पैटर्न-मिलान पर स्रोत-पाठ को विभाजित करो (re.split जैसा)
कार्य रेगेक्स_विभाजित(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या पिछला = 0;
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        यदि (मि["अंत"] == मि["आरंभ"]) {
            श = मि["अंत"] + 1;
        } अन्यथा {
            परिणाम = जोड़ें(परिणाम, उपखंड(स्रोत, पिछला, मि["आरंभ"]));
            पिछला = मि["अंत"];
            श = मि["अंत"];
        }
    }
    परिणाम = जोड़ें(परिणाम, उपखंड(स्रोत, पिछला, लं));
    परत् परिणाम;
}

// ---- Capturing groups — सुविधा फलन ----

// मिलान["समूह"][क्रमांक-1] का 1-आधारित सुविधाजनक रूप — न मिले/सीमा-बाहर → शून्यम्
कार्य रेगेक्स_समूह(शब्दकोश मिलान, संख्या क्रमांक) {
    सूची सू = मिलान["समूह"];
    यदि (क्रमांक < 1 || क्रमांक > लंबाई(सू)) { परत् शून्यम्; }
    परत् सू[क्रमांक - 1];
}

// रेगेक्स_सभी_खोजो जैसा पर सिर्फ़ पाठ नहीं — हर मिलान का पूरा विवरण
// (मिला/आरंभ/अंत/पाठ/समूह) सूची में; रेगेक्स_सभी_खोजो पहले जैसा अपरिवर्तित
कार्य रेगेक्स_सभी_खोजो_विस्तृत(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = रेगेक्स_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या श = 0;
    यावत् (श <= लं) {
        शब्दकोश मि = रे_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        परिणाम = जोड़ें(परिणाम, मि);
        यदि (मि["अंत"] > मि["आरंभ"]) { श = मि["अंत"]; } अन्यथा { श = मि["अंत"] + 1; }
    }
    परत् परिणाम;
}
