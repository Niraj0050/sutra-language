// ============================================================
// १. गणितीय सहायक (Mathematical Helpers)
// ============================================================

कार्य प्राकृतिक_लघुगणक(दशमलव संख्या_मान) {
    यदि (संख्या_मान <= ०.०) {
        परत् ०.० - १०००.०; // अत्यधिक लघु मान (log 0 बचाव)
    }
    
    दशमलव इ = ई_अंक();
    दशमलव मान_क = संख्या_मान;
    संख्या घातांक = ०;
    
    यावत् (मान_क > २.०) {
        मान_क = मान_क / इ;
        घातांक = घातांक + १;
    }
    यावत् (मान_क < ०.५) {
        मान_क = मान_क * इ;
        घातांक = घातांक - १;
    }
    
    // य = (मान_क - १) / (मान_क + १)
    दशमलव य = (मान_क - १.०) / (मान_क + १.०);
    दशमलव य२ = य * य;
    
    // २ * (य + य^३/३ + य^५/५ + य^७/७ + य^९/९ + य^११/११)
    दशमलव पद = य;
    दशमलव योग = पद;
    
    पद = पद * य२;
    योग = योग + (पद / ३.०);
    
    पद = पद * य२;
    योग = योग + (पद / ५.०);
    
    पद = पद * य२;
    योग = योग + (पद / ७.०);
    
    पद = पद * य२;
    योग = योग + (पद / ९.०);
    
    पद = पद * य२;
    योग = योग + (पद / ११.०);
    
    दशमलव लघुक = २.० * योग;
    दशमलव पूर्ण_फल = लघुक + (घातांक * १.०);
    परत् पूर्ण_फल;
}

// ============================================================
// २. सक्रियण फलन एवं अवकलज (Activation Functions & Derivatives)
// ============================================================

कार्य सक्रियण_रेलू(दशमलव मूल्य) {
    यदि (मूल्य > ०.०) { परत् मूल्य; }
    परत् ०.०;
}

कार्य रेलू_अवकलज(दशमलव मूल्य) {
    यदि (मूल्य > ०.०) { परत् १.०; }
    परत् ०.०;
}

कार्य सक्रियण_लीकी_रेलू(दशमलव मूल्य, दशमलव अल्फा) {
    यदि (मूल्य > ०.०) { परत् मूल्य; }
    परत् अल्फा * मूल्य;
}

कार्य लीकी_रेलू_अवकलज(दशमलव मूल्य, दशमलव अल्फा) {
    यदि (मूल्य > ०.०) { परत् १.०; }
    परत् अल्फा;
}

कार्य सक्रियण_सिग्मॉइड(दशमलव मूल्य) {
    यदि (मूल्य < ०.० - ४५.०) { परत् ०.०; }
    यदि (मूल्य > ४५.०) { परत् १.०; }
    दशमलव इ = ई_अंक();
    दशमलव घातांक_मान = घात(इ, ०.० - मूल्य);
    परत् १.० / (१.० + घातांक_मान);
}

कार्य सिग्मॉइड_अवकलज(दशमलव मूल्य) {
    दशमलव सिग = सक्रियण_सिग्मॉइड(मूल्य);
    परत् सिग * (१.० - सिग);
}

कार्य सक्रियण_टैनएच(दशमलव मूल्य) {
    यदि (मूल्य < ०.० - २०.०) { परत् ०.० - १.०; }
    यदि (मूल्य > २०.०) { परत् १.०; }
    दशमलव इ = ई_अंक();
    दशमलव धन_घात = घात(इ, मूल्य);
    दशमलव ऋण_घात = घात(इ, ०.० - मूल्य);
    परत् (धन_घात - ऋण_घात) / (धन_घात + ऋण_घात);
}

कार्य टैनएच_अवकलज(दशमलव मूल्य) {
    दशमलव टैन = सक्रियण_टैनएच(मूल्य);
    परत् १.० - (टैन * टैन);
}

कार्य सदिश_सक्रियण_रेलू(शब्दकोश सदिश) {
    संख्या आकार = सदिश["आकार"];
    सूची डेटा = सदिश["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव मूल्य = डेटा[इ];
        नया_डेटा = जोड़ें(नया_डेटा, सक्रियण_रेलू(मूल्य));
        इ = इ + १;
    }
    परत् सदिश_से_सूची(नया_डेटा);
}

कार्य सदिश_सक्रियण_सिग्मॉइड(शब्दकोश सदिश) {
    संख्या आकार = सदिश["आकार"];
    सूची डेटा = सदिश["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव मूल्य = डेटा[इ];
        नया_डेटा = जोड़ें(नया_डेटा, सक्रियण_सिग्मॉइड(मूल्य));
        इ = इ + १;
    }
    परत् सदिश_से_सूची(नया_डेटा);
}

कार्य सदिश_सॉफ्टमैक्स(शब्दकोश सदिश) {
    संख्या आकार = सदिश["आकार"];
    यदि (आकार == ०) { परत् सदिश; }
    सूची डेटा = सदिश["डेटा"];
    
    // संख्यात्मक स्थिरता हेतु अधिकतम मान अन्वेषण
    दशमलव अधिकतम_मान = डेटा[०];
    संख्या इ = १;
    यावत् (इ < आकार) {
        दशमलव मूल्य = डेटा[इ];
        यदि (मूल्य > अधिकतम_मान) { अधिकतम_मान = मूल्य; }
        इ = इ + १;
    }
    
    // e^(x_i - max) एवं योग
    दशमलव इ_अंक_मान = ई_अंक();
    सूची घातांक_डेटा = [];
    दशमलव योग = ०.०;
    इ = ०;
    यावत् (इ < आकार) {
        दशमलव मूल्य = डेटा[इ];
        दशमलव घ = घात(इ_अंक_मान, मूल्य - अधिकतम_मान);
        घातांक_डेटा = जोड़ें(घातांक_डेटा, घ);
        योग = योग + घ;
        इ = इ + १;
    }
    
    // प्रसामान्यीकरण
    सूची फल_डेटा = [];
    इ = ०;
    यावत् (इ < आकार) {
        दशमलव घ_मान = घातांक_डेटा[इ];
        फल_डेटा = जोड़ें(फल_डेटा, घ_मान / योग);
        इ = इ + १;
    }
    परत् सदिश_से_सूची(फल_डेटा);
}

// ============================================================
// ३. हानि फलन (Loss Functions)
// ============================================================

कार्य हानि_माध्य_वर्ग_त्रुटि(शब्दकोश अनुमान, शब्दकोश सत्य_लक्ष्य) {
    संख्या आकार = अनुमान["आकार"];
    यदि (आकार != सत्य_लक्ष्य["आकार"] || आकार == ०) {
        फेको "त्रुटिः हानि गणना हेतु आकार समान होना चाहिए";
    }
    सूची अ_डेटा = अनुमान["डेटा"];
    सूची स_डेटा = सत्य_लक्ष्य["डेटा"];
    दशमलव कुल_त्रुटि = ०.०;
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव अंतर = अ_डेटा[इ] - स_डेटा[इ];
        कुल_त्रुटि = कुल_त्रुटि + (अंतर * अंतर);
        इ = इ + १;
    }
    परत् कुल_त्रुटि / (आकार * १.०);
}

कार्य हानि_द्विआधारी_क्रॉस_एंट्रॉपी(शब्दकोश अनुमान, शब्दकोश सत्य_लक्ष्य) {
    संख्या आकार = अनुमान["आकार"];
    यदि (आकार != सत्य_लक्ष्य["आकार"] || आकार == ०) {
        फेको "त्रुटिः बीसीई गणना हेतु आकार समान होना चाहिए";
    }
    सूची अ_डेटा = अनुमान["डेटा"];
    सूची स_डेटा = सत्य_लक्ष्य["डेटा"];
    दशमलव कुल_हानि = ०.०;
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव सत्य_मान = स_डेटा[इ];
        दशमलव अनुमान_मान = अ_डेटा[इ];
        // क्लिपिंग (0 और 1 से सुरक्षित दूरी)
        यदि (अनुमान_मान < ०.००००००१) { अनुमान_मान = ०.००००००१; }
        यदि (अनुमान_मान > ०.९९९९९९९) { अनुमान_मान = ०.९९९९९९९; }
        
        दशमलव पद१ = सत्य_मान * प्राकृतिक_लघुगणक(अनुमान_मान);
        दशमलव पद२ = (१.० - सत्य_मान) * प्राकृतिक_लघुगणक(१.० - अनुमान_मान);
        कुल_हानि = कुल_हानि - (पद१ + पद२);
        इ = इ + १;
    }
    परत् कुल_हानि / (आकार * १.०);
}

// ============================================================
// ४. स्वचालित अवकलन यंत्र (Autograd Computational Graph Engine)
// ============================================================

संख्या वैश्विक_अवकलन_नोड_आईडी = ०;

कार्य चर_बनाओ(दशमलव मूल्य, पाठ नाम) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = नाम;
    नोड["मान"] = मूल्य;
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [];
    नोड["संक्रिया"] = "चर";
    परत् नोड;
}

कार्य अवकलन_नोड_योग(शब्दकोश अ, शब्दकोश ब) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "+";
    दशमलव अ_मान = अ["मान"];
    दशमलव ब_मान = ब["मान"];
    नोड["मान"] = अ_मान + ब_मान;
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ, ब];
    नोड["संक्रिया"] = "योग";
    परत् नोड;
}

कार्य अवकलन_नोड_अंतर(शब्दकोश अ, शब्दकोश ब) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "-";
    दशमलव अ_मान = अ["मान"];
    दशमलव ब_मान = ब["मान"];
    नोड["मान"] = अ_मान - ब_मान;
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ, ब];
    नोड["संक्रिया"] = "अंतर";
    परत् नोड;
}

कार्य अवकलन_नोड_गुणन(शब्दकोश अ, शब्दकोश ब) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "*";
    दशमलव अ_मान = अ["मान"];
    दशमलव ब_मान = ब["मान"];
    नोड["मान"] = अ_मान * ब_मान;
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ, ब];
    नोड["संक्रिया"] = "गुणन";
    परत् नोड;
}

कार्य अवकलन_नोड_भाग(शब्दकोश अ, शब्दकोश ब) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "/";
    दशमलव अ_मान = अ["मान"];
    दशमलव ब_मान = ब["मान"];
    यदि (ब_मान == ०.०) { फेको "त्रुटिः अवकलन में शून्य से भाग"; }
    नोड["मान"] = अ_मान / ब_मान;
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ, ब];
    नोड["संक्रिया"] = "भाग";
    परत् नोड;
}

कार्य अवकलन_नोड_वर्ग(शब्दकोश अ) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "^2";
    दशमलव अ_मान = अ["मान"];
    नोड["मान"] = अ_मान * अ_मान;
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ];
    नोड["संक्रिया"] = "वर्ग";
    परत् नोड;
}

कार्य अवकलन_नोड_रेलू(शब्दकोश अ) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "रेलू";
    दशमलव अ_मान = अ["मान"];
    नोड["मान"] = सक्रियण_रेलू(अ_मान);
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ];
    नोड["संक्रिया"] = "रेलू";
    परत् नोड;
}

कार्य अवकलन_नोड_सिग्मॉइड(शब्दकोश अ) {
    वैश्विक_अवकलन_नोड_आईडी = वैश्विक_अवकलन_नोड_आईडी + १;
    शब्दकोश नोड = {};
    नोड["आईडी"] = वैश्विक_अवकलन_नोड_आईडी;
    नोड["नाम"] = "सिग्मॉइड";
    दशमलव अ_मान = अ["मान"];
    नोड["मान"] = सक्रियण_सिग्मॉइड(अ_मान);
    नोड["प्रवणता"] = ०.०;
    नोड["जनक"] = [अ];
    नोड["संक्रिया"] = "सिग्मॉइड";
    परत् नोड;
}

कार्य अवकलन_क्रम_सहायक(शब्दकोश नोड, सूची दौरा, सूची क्रम) {
    संख्या आईडी = नोड["आईडी"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(दौरा)) {
        यदि (दौरा[इ] == आईडी) { परत् क्रम; }
        इ = इ + १;
    }
    दौरा = जोड़ें(दौरा, आईडी);
    
    सूची जनकाः = नोड["जनक"];
    संख्या ज_इ = ०;
    यावत् (ज_इ < लंबाई(जनकाः)) {
        क्रम = अवकलन_क्रम_सहायक(जनकाः[ज_इ], दौरा, क्रम);
        ज_इ = ज_इ + १;
    }
    क्रम = जोड़ें(क्रम, नोड);
    परत् क्रम;
}

कार्य प्रतीप_संचरण(शब्दकोश आउटपुट_नोड) {
    आउटपुट_नोड["प्रवणता"] = १.०;
    
    सूची क्रम = अवकलन_क्रम_सहायक(आउटपुट_नोड, [], []);
    
    // क्रम को पीछे से आगे चलाना (आउटपुट से इनपुट की ओर)
    संख्या इ = लंबाई(क्रम) - १;
    यावत् (इ >= ०) {
        शब्दकोश नोड = क्रम[इ];
        दशमलव प्रव = नोड["प्रवणता"];
        पाठ संक्रिया = नोड["संक्रिया"];
        सूची जनकाः = नोड["जनक"];
        
        यदि (संक्रिया == "योग") {
            शब्दकोश ज१ = जनकाः[०];
            शब्दकोश ज२ = जनकाः[१];
            दशमलव ज१_प्रव = ज१["प्रवणता"];
            दशमलव ज२_प्रव = ज२["प्रवणता"];
            ज१["प्रवणता"] = ज१_प्रव + प्रव;
            ज२["प्रवणता"] = ज२_प्रव + प्रव;
        } अन्यथा यदि (संक्रिया == "अंतर") {
            शब्दकोश ज१ = जनकाः[०];
            शब्दकोश ज२ = जनकाः[१];
            दशमलव ज१_प्रव = ज१["प्रवणता"];
            दशमलव ज२_प्रव = ज२["प्रवणता"];
            ज१["प्रवणता"] = ज१_प्रव + प्रव;
            ज२["प्रवणता"] = ज२_प्रव - प्रव;
        } अन्यथा यदि (संक्रिया == "गुणन") {
            शब्दकोश ज१ = जनकाः[०];
            शब्दकोश ज२ = जनकाः[१];
            दशमलव ज१_मान = ज१["मान"];
            दशमलव ज२_मान = ज२["मान"];
            दशमलव ज१_प्रव = ज१["प्रवणता"];
            दशमलव ज२_प्रव = ज२["प्रवणता"];
            ज१["प्रवणता"] = ज१_प्रव + (ज२_मान * प्रव);
            ज२["प्रवणता"] = ज२_प्रव + (ज१_मान * प्रव);
        } अन्यथा यदि (संक्रिया == "भाग") {
            शब्दकोश ज१ = जनकाः[०];
            शब्दकोश ज२ = जनकाः[१];
            दशमलव ज१_मान = ज१["मान"];
            दशमलव ज२_मान = ज२["मान"];
            दशमलव ज१_प्रव = ज१["प्रवणता"];
            दशमलव ज२_प्रव = ज२["प्रवणता"];
            ज१["प्रवणता"] = ज१_प्रव + (प्रव / ज२_मान);
            दशमलव भाजक_वर्ग = ज२_मान * ज२_मान;
            ज२["प्रवणता"] = ज२_प्रव - (प्रव * ज१_मान / भाजक_वर्ग);
        } अन्यथा यदि (संक्रिया == "वर्ग") {
            शब्दकोश ज१ = जनकाः[०];
            दशमलव ज१_मान = ज१["मान"];
            दशमलव ज१_प्रव = ज१["प्रवणता"];
            ज१["प्रवणता"] = ज१_प्रव + (२.० * ज१_मान * प्रव);
        } अन्यथा यदि (संक्रिया == "रेलू") {
            शब्दकोश ज१ = जनकाः[०];
            दशमलव ज१_मान = ज१["मान"];
            यदि (ज१_मान > ०.०) {
                दशमलव ज१_प्रव = ज१["प्रवणता"];
                ज१["प्रवणता"] = ज१_प्रव + प्रव;
            }
        } अन्यथा यदि (संक्रिया == "सिग्मॉइड") {
            शब्दकोश ज१ = जनकाः[०];
            दशमलव सिग_मान = नोड["मान"];
            दशमलव अवकल = सिग_मान * (१.० - सिग_मान);
            दशमलव ज१_प्रव = ज१["प्रवणता"];
            ज१["प्रवणता"] = ज१_प्रव + (अवकल * प्रव);
        }
        इ = इ - १;
    }
}

कार्य प्रवणता_शून्य_करो(सूची नोड_सूची) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(नोड_सूची)) {
        शब्दकोश नोड = नोड_सूची[इ];
        नोड["प्रवणता"] = ०.०;
        इ = इ + १;
    }
}

// ============================================================
// ५. अनुकूलक (Optimizers)
// ============================================================

कार्य अनुकूलक_एसजीडी(सूची मापदंड_सूची, दशमलव अधिगम_दर, दशमलव संवेग) {
    शब्दकोश अनुकूलक = {};
    अनुकूलक["प्रकार"] = "एसजीडी";
    अनुकूलक["मापदंड"] = मापदंड_सूची;
    अनुकूलक["अधिगम_दर"] = अधिगम_दर;
    अनुकूलक["संवेग"] = संवेग;
    
    // संवेग हेतु वेग संचयी सूची
    सूची वेगाः = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(मापदंड_सूची)) {
        वेगाः = जोड़ें(वेगाः, ०.०);
        इ = इ + १;
    }
    अनुकूलक["वेग"] = वेगाः;
    परत् अनुकूलक;
}

कार्य एसजीडी_चरण(शब्दकोश अनुकूलक) {
    सूची मापदंड = अनुकूलक["मापदंड"];
    सूची वेगाः = अनुकूलक["वेग"];
    दशमलव अधिगम_दर = अनुकूलक["अधिगम_दर"];
    दशमलव संवेग = अनुकूलक["संवेग"];
    
    संख्या इ = ०;
    यावत् (इ < लंबाई(मापदंड)) {
        शब्दकोश नोड = मापदंड[इ];
        दशमलव प्रव = नोड["प्रवणता"];
        दशमलव वेग_मान = वेगाः[इ];
        
        // वेग = संवेग * वेग + अधिगम_दर * प्रव
        दशमलव नया_वेग = (संवेग * वेग_मान) + (अधिगम_दर * प्रव);
        वेगाः[इ] = नया_वेग;
        
        दशमलव वर्तमान_मान = नोड["मान"];
        नोड["मान"] = वर्तमान_मान - नया_वेग;
        
        इ = इ + १;
    }
}

कार्य अनुकूलक_एडम(सूची मापदंड_सूची, दशमलव अधिगम_दर, दशमलव बीटा१, दशमलव बीटा२, दशमलव एप्सिलॉन) {
    शब्दकोश अनुकूलक = {};
    अनुकूलक["प्रकार"] = "एडम";
    अनुकूलक["मापदंड"] = मापदंड_सूची;
    अनुकूलक["अधिगम_दर"] = अधिगम_दर;
    अनुकूलक["बीटा१"] = बीटा१;
    अनुकूलक["बीटा२"] = बीटा२;
    अनुकूलक["एप्सिलॉन"] = एप्सिलॉन;
    अनुकूलक["चरण_संख्या"] = ०;
    
    सूची प्रथम_आघूर्ण = [];
    सूची द्वितीय_आघूर्ण = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(मापदंड_सूची)) {
        प्रथम_आघूर्ण = जोड़ें(प्रथम_आघूर्ण, ०.०);
        द्वितीय_आघूर्ण = जोड़ें(द्वितीय_आघूर्ण, ०.०);
        इ = इ + १;
    }
    अनुकूलक["एम"] = प्रथम_आघूर्ण;
    अनुकूलक["वी"] = द्वितीय_आघूर्ण;
    परत् अनुकूलक;
}

कार्य एडम_चरण(शब्दकोश अनुकूलक) {
    अनुकूलक["चरण_संख्या"] = अनुकूलक["चरण_संख्या"] + १;
    संख्या टी = अनुकूलक["चरण_संख्या"];
    
    सूची मापदंड = अनुकूलक["मापदंड"];
    सूची एम = अनुकूलक["एम"];
    सूची वी = अनुकूलक["वी"];
    दशमलव अल्फा = अनुकूलक["अधिगम_दर"];
    दशमलव बीटा१ = अनुकूलक["बीटा१"];
    दशमलव बीटा२ = अनुकूलक["बीटा२"];
    दशमलव एप्स = अनुकूलक["एप्सिलॉन"];
    
    दशमलव बीटा१_घात = घात(बीटा१, टी * १.०);
    दशमलव बीटा२_घात = घात(बीटा२, टी * १.०);
    
    संख्या इ = ०;
    यावत् (इ < लंबाई(मापदंड)) {
        शब्दकोश नोड = मापदंड[इ];
        दशमलव प्रवणता_मान = नोड["प्रवणता"];
        
        // m = beta1 * m + (1 - beta1) * g
        दशमलव नया_एम = (बीटा१ * एम[इ]) + ((१.० - बीटा१) * प्रवणता_मान);
        एम[इ] = नया_एम;
        
        // v = beta2 * v + (1 - beta2) * g^2
        दशमलव नया_वी = (बीटा२ * वी[इ]) + ((१.० - बीटा२) * प्रवणता_मान * प्रवणता_मान);
        वी[इ] = नया_वी;
        
        // अभिनति सुधार (bias correction)
        दशमलव एम_हैट = नया_एम / (१.० - बीटा१_घात);
        दशमलव वी_हैट = नया_वी / (१.० - बीटा२_घात);
        
        दशमलव अद्यतन = (अल्फा * एम_हैट) / (वर्गमूल(वी_हैट) + एप्स);
        दशमलव वर्तमान_मान = नोड["मान"];
        नोड["मान"] = वर्तमान_मान - अद्यतन;
        
        इ = इ + १;
    }
}

// ============================================================
// ६. तंत्रिका जाल सघन स्तर (Dense Layer)
// ============================================================

कार्य सघन_स्तर_बनाओ(संख्या इनपुट_आकार, संख्या आउटपुट_आकार, पाठ सक्रियण_नाम) {
    // Xavier / Glorot प्रारम्भिक भार सीमा: sqrt(6 / (in + out))
    दशमलव सीमा = वर्गमूल(६.० / (इनपुट_आकार + आउटपुट_आकार));
    
    // भार आव्यूह [आउटपुट, इनपुट] (row = neuron, col = input weight)
    सूची भार_पंक्तियाँ = [];
    संख्या आउट = ०;
    यावत् (आउट < आउटपुट_आकार) {
        सूची पं_डेटा = [];
        संख्या इन = ०;
        यावत् (इन < इनपुट_आकार) {
            // निर्धारणात्मक स्यूडो-रैंडम प्रारम्भिक मान [-सीमा, +सीमा]
            संख्या अनु = (आउट * इनपुट_आकार + इन + १);
            दशमलव अंश = (अनु % ७) / ७.०; // 0..1
            दशमलव भार_मूल्य = (अंश * २.० * सीमा) - सीमा;
            यदि (भार_मूल्य == ०.०) { भार_मूल्य = ०.०५; }
            पं_डेटा = जोड़ें(पं_डेटा, भार_मूल्य);
            इन = इन + १;
        }
        भार_पंक्तियाँ = जोड़ें(भार_पंक्तियाँ, पं_डेटा);
        आउट = आउट + १;
    }
    
    शब्दकोश बायस_सदिश = सदिश_शून्य(आउटपुट_आकार);
    
    शब्दकोश स्तर = {};
    स्तर["इनपुट_आकार"] = इनपुट_आकार;
    स्तर["आउटपुट_आकार"] = आउटपुट_आकार;
    स्तर["सक्रियण"] = सक्रियण_नाम;
    स्तर["भार"] = भार_पंक्तियाँ; // सूची-of-सूची
    स्तर["बायस"] = बायस_सदिश;
    
    // पश्चगमन हेतु कैश
    स्तर["अंतिम_इनपुट"] = सदिश_शून्य(इनपुट_आकार);
    स्तर["अंतिम_रैखिक"] = सदिश_शून्य(आउटपुट_आकार);
    स्तर["अंतिम_आउटपुट"] = सदिश_शून्य(आउटपुट_आकार);
    
    परत् स्तर;
}

कार्य सघन_स्तर_अग्रेषण(शब्दकोश स्तर, शब्दकोश इनपुट_सदिश) {
    स्तर["अंतिम_इनपुट"] = इनपुट_सदिश;
    
    संख्या इनपुट_ल = स्तर["इनपुट_आकार"];
    संख्या आउटपुट_ल = स्तर["आउटपुट_आकार"];
    पाठ सक्रियण_नाम = स्तर["सक्रियण"];
    
    सूची भार_पंक्तियाँ = स्तर["भार"];
    सूची बायस_डेटा = स्तर["बायस"]["डेटा"];
    सूची इन_डेटा = इनपुट_सदिश["डेटा"];
    
    सूची रैखिक_डेटा = [];
    सूची सक्रियण_डेटा = [];
    
    संख्या आउट = ०;
    यावत् (आउट < आउटपुट_ल) {
        सूची भार_पंक्ति = भार_पंक्तियाँ[आउट];
        दशमलव रैखिक_मूल्य = बायस_डेटा[आउट];
        
        संख्या इन = ०;
        यावत् (इन < इनपुट_ल) {
            रैखिक_मूल्य = रैखिक_मूल्य + (भार_पंक्ति[इन] * इन_डेटा[इन]);
            इन = इन + १;
        }
        रैखिक_डेटा = जोड़ें(रैखिक_डेटा, रैखिक_मूल्य);
        
        दशमलव सक्रियण_मूल्य = रैखिक_मूल्य;
        यदि (सक्रियण_नाम == "रेलू") {
            सक्रियण_मूल्य = सक्रियण_रेलू(रैखिक_मूल्य);
        } अन्यथा यदि (सक्रियण_नाम == "सिग्मॉइड") {
            सक्रियण_मूल्य = सक्रियण_सिग्मॉइड(रैखिक_मूल्य);
        } अन्यथा यदि (सक्रियण_नाम == "टैनएच") {
            सक्रियण_मूल्य = सक्रियण_टैनएच(रैखिक_मूल्य);
        }
        सक्रियण_डेटा = जोड़ें(सक्रियण_डेटा, सक्रियण_मूल्य);
        
        आउट = आउट + १;
    }
    
    स्तर["अंतिम_रैखिक"] = सदिश_से_सूची(रैखिक_डेटा);
    स्तर["अंतिम_आउटपुट"] = सदिश_से_सूची(सक्रियण_डेटा);
    परत् स्तर["अंतिम_आउटपुट"];
}

कार्य सघन_स्तर_पश्चगमन(शब्दकोश स्तर, शब्दकोश आउटपुट_प्रवणता, दशमलव अधिगम_दर) {
    संख्या इनपुट_ल = स्तर["इनपुट_आकार"];
    संख्या आउटपुट_ल = स्तर["आउटपुट_आकार"];
    पाठ सक्रियण_नाम = स्तर["सक्रियण"];
    
    सूची भार_पंक्तियाँ = स्तर["भार"];
    सूची बायस_डेटा = स्तर["बायस"]["डेटा"];
    सूची इन_डेटा = स्तर["अंतिम_इनपुट"]["डेटा"];
    सूची रैखिक_डेटा = स्तर["अंतिम_रैखिक"]["डेटा"];
    सूची आउटपुट_प्रवणता_सूची = आउटपुट_प्रवणता["डेटा"];
    
    // १. dz = d_out * activation_derivative(z)
    सूची सक्रियण_प्रवणता_सूची = [];
    संख्या आउट = ०;
    यावत् (आउट < आउटपुट_ल) {
        दशमलव रैखिक_मूल्य = रैखिक_डेटा[आउट];
        दशमलव प्रव_मान = आउटपुट_प्रवणता_सूची[आउट];
        दशमलव अवकल = १.०;
        
        यदि (सक्रियण_नाम == "रेलू") {
            अवकल = रेलू_अवकलज(रैखिक_मूल्य);
        } अन्यथा यदि (सक्रियण_नाम == "सिग्मॉइड") {
            अवकल = सिग्मॉइड_अवकलज(रैखिक_मूल्य);
        } अन्यथा यदि (सक्रियण_नाम == "टैनएच") {
            अवकल = टैनएच_अवकलज(रैखिक_मूल्य);
        }
        सक्रियण_प्रवणता_सूची = जोड़ें(सक्रियण_प्रवणता_सूची, प्रव_मान * अवकल);
        आउट = आउट + १;
    }
    
    // २. d_in = W^T * dz (अगले स्तर हेतु प्रवणता)
    सूची इनपुट_प्रवणता_सूची = [];
    संख्या इन = ०;
    यावत् (इन < इनपुट_ल) {
        दशमलव इनपुट_प्रवणता = ०.०;
        आउट = ०;
        यावत् (आउट < आउटपुट_ल) {
            सूची भार_पंक्ति = भार_पंक्तियाँ[आउट];
            इनपुट_प्रवणता = इनपुट_प्रवणता + (भार_पंक्ति[इन] * सक्रियण_प्रवणता_सूची[आउट]);
            आउट = आउट + १;
        }
        इनपुट_प्रवणता_सूची = जोड़ें(इनपुट_प्रवणता_सूची, इनपुट_प्रवणता);
        इन = इन + १;
    }
    
    // ३. भार एवं बायस अद्यतन (W = W - lr * dz * in^T, b = b - lr * dz)
    आउट = ०;
    यावत् (आउट < आउटपुट_ल) {
        सूची भार_पंक्ति = भार_पंक्तियाँ[आउट];
        दशमलव सक्रियण_प्रवणता = सक्रियण_प्रवणता_सूची[आउट];
        
        इन = ०;
        यावत् (इन < इनपुट_ल) {
            दशमलव भार_प्रव = सक्रियण_प्रवणता * इन_डेटा[इन];
            भार_पंक्ति[इन] = भार_पंक्ति[इन] - (अधिगम_दर * भार_प्रव);
            इन = इन + १;
        }
        बायस_डेटा[आउट] = बायस_डेटा[आउट] - (अधिगम_दर * सक्रियण_प्रवणता);
        आउट = आउट + १;
    }
    
    परत् सदिश_से_सूची(इनपुट_प्रवणता_सूची);
}

// ============================================================
// ७. अनुक्रमिक तंत्रिका जाल प्रतिरूप (Sequential Neural Model)
// ============================================================

कार्य प्रतिरूप_बनाओ() {
    शब्दकोश प्रतिरूप = {};
    प्रतिरूप["स्तराः"] = [];
    परत् प्रतिरूप;
}

कार्य प्रतिरूप_स्तर_जोड़ो(शब्दकोश प्रतिरूप, शब्दकोश स्तर) {
    प्रतिरूप["स्तराः"] = जोड़ें(प्रतिरूप["स्तराः"], स्तर);
}

कार्य प्रतिरूप_अनुमान(शब्दकोश प्रतिरूप, शब्दकोश इनपुट_सदिश) {
    सूची स्तराः = प्रतिरूप["स्तराः"];
    शब्दकोश वर्तमान = इनपुट_सदिश;
    संख्या इ = ०;
    यावत् (इ < लंबाई(स्तराः)) {
        वर्तमान = सघन_स्तर_अग्रेषण(स्तराः[इ], वर्तमान);
        इ = इ + १;
    }
    परत् वर्तमान;
}

कार्य प्रतिरूप_प्रशिक्षण_चरण(शब्दकोश प्रतिरूप, शब्दकोश इनपुट_सदिश, शब्दकोश लक्ष्य_सदिश, दशमलव अधिगम_दर) {
    // अग्रेषण संचरण
    शब्दकोश अनुमान = प्रतिरूप_अनुमान(प्रतिरूप, इनपुट_सदिश);
    
    // आउटपुट प्रवणता (MSE loss derivative: 2 * (y_hat - y) / N)
    संख्या आउट_ल = अनुमान["आकार"];
    सूची अ_डेटा = अनुमान["डेटा"];
    सूची ल_डेटा = लक्ष्य_सदिश["डेटा"];
    सूची प्रवणता_सूची = [];
    संख्या इ = ०;
    यावत् (इ < आउट_ल) {
        दशमलव त्रुटि = अ_डेटा[इ] - ल_डेटा[इ];
        प्रवणता_सूची = जोड़ें(प्रवणता_सूची, २.० * त्रुटि);
        इ = इ + १;
    }
    शब्दकोश वर्तमान_प्रवणता = सदिश_से_सूची(प्रवणता_सूची);
    
    // प्रतीप संचरण (पीछे से आगे)
    सूची स्तराः = प्रतिरूप["स्तराः"];
    इ = लंबाई(स्तराः) - १;
    यावत् (इ >= ०) {
        वर्तमान_प्रवणता = सघन_स्तर_पश्चगमन(स्तराः[इ], वर्तमान_प्रवणता, अधिगम_दर);
        इ = इ - १;
    }
    
    दशमलव हानि = हानि_माध्य_वर्ग_त्रुटि(अनुमान, लक्ष्य_सदिश);
    परत् हानि;
}

कार्य प्रतिरूप_ट्रेन(शब्दकोश प्रतिरूप, सूची इनपुट_सूची, सूची लक्ष्य_सूची, संख्या युग_संख्या, दशमलव अधिगम_दर) {
    संख्या नमूने = लंबाई(इनपुट_सूची);
    यदि (नमूने != लंबाई(लक्ष्य_सूची) || नमूने == ०) {
        फेको "त्रुटिः इनपुट एवं लक्ष्य नमूनों की संख्या समान होनी चाहिए";
    }
    
    संख्या युग = ०;
    यावत् (युग < युग_संख्या) {
        दशमलव कुल_हानि = ०.०;
        संख्या इ = ०;
        यावत् (इ < नमूने) {
            दशमलव हानि = प्रतिरूप_प्रशिक्षण_चरण(प्रतिरूप, इनपुट_सूची[इ], लक्ष्य_सूची[इ], अधिगम_दर);
            कुल_हानि = कुल_हानि + हानि;
            इ = इ + १;
        }
        युग = युग + १;
    }
}
