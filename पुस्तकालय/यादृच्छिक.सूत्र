// पुस्तकालय/यादृच्छिक.सूत्र — उच्च-गुणवत्ता PRNG (xorshift128, बहु-धारा)
// ============================================================
// आयात "पुस्तकालय/यादृच्छिक.सूत्र";
//
//   शब्दकोश रा = यादृ_बनाओ(४२);         // स्थिर बीज — नियतात्मक धारा
//   संख्या न = यादृ_परास(रा, १, ६);     // पासा फेंक (१..६ सम्मिलित)
//   संख्या द = यादृ_दशमलव(रा);          // [०,१) दशमलव
//   सूची फ = यादृ_फेंटो(रा, [१,२,३,४]); // फ़िशर-येट्स फेंटना
//
// गणित.सूत्र में पहले से एक बुनियादी PRNG है (यादृच्छिक्_बीज/यादृच्छिक्_अगला —
// MINSTD/Park-Miller LCG, एकल global धारा)। यह मॉड्यूल उसकी जगह नहीं लेता
// — गणित.सूत्र वाला वैसे ही चलता रहेगा — बल्कि दो असली सुधार देता है:
//
//   १. गुणवत्ता — Marsaglia की xorshift128 (शुद्ध shift+xor, कोई गुणा नहीं,
//      १२८-बिट अवस्था)। सार्वजनिक/अकादमिक एल्गोरिथ्म (जैसे SHA-256 का FIPS
//      स्पेक था) — समझ के अपना कार्यान्वयन, किसी और का कोड कॉपी नहीं। LCG के
//      जाने-पहचाने निम्न-बिट सहसंबंध (spectral-test विफलता) यहाँ नहीं होते।
//   २. बहु-धारा — अवस्था एक शब्दकोश में रहती है (संदर्भ द्वारा उत्परिवर्तित,
//      पुनः-निर्धारण ज़रूरी नहीं), तो एक साथ कई स्वतंत्र, एक-दूसरे से अप्रभावित
//      यादृच्छिक धाराएँ बनाई जा सकती हैं — गणित.सूत्र के एकल global बीज के
//      विपरीत।
//
// आंतरिक रूप से बीज-विस्तार (एक संख्या → ४-शब्द अवस्था) के लिए गणित.सूत्र के
// मौजूदा LCG का पुनःप्रयोग करता है — डुप्लिकेट लॉजिक नहीं।
//
// पूरी तरह शुद्ध Sutra — कोई FFI/OS निर्भरता नहीं, तीनों बैकएंड (x86 डिफ़ॉल्ट,
// दुभाषिया, --release) पर समान चलता है। जानबूझकर कोई स्वतः-बीजन (auto-seed
// from system time) नहीं — नियतात्मक-दर-डिफ़ॉल्ट, गणित.सूत्र जैसा ही।
//
// ⚠ साइड-इफ़ेक्ट: यादृ_बनाओ(बीज) आंतरिक रूप से गणित.सूत्र के SHARED global
// गणित_बीज को अस्थायी रूप से दुबारा सेट करता है (सिर्फ़ ४-शब्द बीज-विस्तार के
// लिए)। अगर आपका प्रोग्राम गणित.सूत्र का यादृच्छिक_अगला()/यादृच्छिक() सीधे भी
// इस्तेमाल कर रहा है, तो यादृ_बनाओ() को बीच में बुलाने से उस global धारा का
// क्रम बदल जाएगा। दोनों साथ चाहिए तो अपनी सारी यादृ_बनाओ() कॉल गणित.सूत्र की
// global धारा शुरू करने से *पहले* कर लो।
// ============================================================

आयात "पुस्तकालय/गणित.सूत्र";

कार्य यादृ_मास्क32() { परत् बाम_सरक(१, ३२) - १; }

// ---- अवस्था बनाना ----

// स्थिर बीज से नई स्वतंत्र धारा (राज्य = शब्दकोश, संदर्भ-उत्परिवर्तित रहता)
कार्य यादृ_बनाओ(संख्या बीज) {
    संख्या मूल = बीज;
    यदि (मूल == ०) { मूल = ८८६७५१२३; }
    यादृच्छिक_बीज(मूल);
    शब्दकोश रा = {};
    रा["अ"] = यादृच्छिक_अगला();
    रा["ब"] = यादृच्छिक_अगला();
    रा["स"] = यादृच्छिक_अगला();
    रा["द"] = यादृच्छिक_अगला();
    परत् रा;
}

// ---- मूल जनरेटर ----

// अगला कच्चा uint32 (०..२^३२−१); राज्य को स्थान-पर बदलता है
कार्य यादृ_अगला32(शब्दकोश रा) {
    संख्या मास्क = यादृ_मास्क32();
    संख्या ट = रा["अ"];
    ट = बिट_और(बिट_भेद(ट, बाम_सरक(ट, ११)), मास्क);
    ट = बिट_भेद(ट, दक्षिण_सरक(ट, ८));
    रा["अ"] = रा["ब"];
    रा["ब"] = रा["स"];
    रा["स"] = रा["द"];
    संख्या ड = रा["द"];
    ड = बिट_भेद(ड, दक्षिण_सरक(ड, १९));
    ड = बिट_भेद(ड, ट);
    रा["द"] = ड;
    परत् ड;
}

// ---- सुविधा-API ----

// [०, १) दशमलव
// नोट: यहाँ संख्या-फलन-कॉल को पहले एक संख्या स्थानीय चर में रखना ज़रूरी है
// (फिर दशमलव स्थानीय चर में परिणाम) — कॉल को सीधे मिश्रित संख्या/दशमलव
// अभिव्यक्ति में जोड़ने पर एक कम्पाइलर-बग टाइप-अनुमान को गलत कर देता है
// (परिणाम ग़लत-रूप से ० बनता); मुख्य/मूल में असल isolate किया, अलग से रिपोर्ट।
कार्य यादृ_दशमलव(शब्दकोश रा) {
    संख्या कच्चा = यादृ_अगला32(रा);
    संख्या मास्क = यादृ_मास्क32();
    दशमलव भाजक = मास्क + १.०;
    दशमलव फल = (कच्चा * १.०) / भाजक;
    परत् फल;
}

// पूर्णांक [न्यून, उच्च] (दोनों सम्मिलित)
कार्य यादृ_परास(शब्दकोश रा, संख्या न्यून, संख्या उच्च) {
    यदि (उच्च <= न्यून) { परत् न्यून; }
    संख्या चौड़ाई = उच्च - न्यून + १;
    परत् न्यून + (यादृ_अगला32(रा) % चौड़ाई);
}

// सत्य/असत्य ५०/५०
कार्य यादृ_बूल(शब्दकोश रा) {
    परत् (यादृ_अगला32(रा) % २) == ०;
}

// सूची से यादृच्छिक तत्व (रिक्त → शून्यम्)
कार्य यादृ_तत्व(शब्दकोश रा, सूची स) {
    यदि (लंबाई(स) == ०) { परत् शून्यम्; }
    परत् स[यादृ_परास(रा, ०, लंबाई(स) - १)];
}

// फ़िशर-येट्स फेंटना — नई सूची लौटाता है, मूल अछूती
कार्य यादृ_फेंटो(शब्दकोश रा, सूची स) {
    सूची फल = [];
    संख्या इ = ०;
    संख्या लं = लंबाई(स);
    यावत् (इ < लं) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    इ = लं - १;
    यावत् (इ > ०) {
        संख्या ज = यादृ_परास(रा, ०, इ);
        संख्या अस्थायी = फल[इ];
        फल[इ] = फल[ज];
        फल[ज] = अस्थायी;
        इ = इ - १;
    }
    परत् फल;
}
