// पुस्तकालय/यादृच्छिक.सूत्र — उच्च-गुणवत्ता PRNG (xorshift128, बहु-धारा)
// ============================================================
// आयात "पुस्तकालय/यादृच्छिक.सूत्र";
//
//   शब्दकोश रा = यार_बनाओ(42);         // स्थिर बीज — नियतात्मक धारा
//   संख्या न = यार_परास(रा, 1, 6);     // पासा फेंक (1..6 सम्मिलित)
//   संख्या द = यार_दशमलव(रा);          // [0,1) दशमलव
//   सूची फ = यार_फेंटो(रा, [1,2,3,4]); // फ़िशर-येट्स फेंटना
//
// गणित.सूत्र में पहले से एक बुनियादी PRNG है (यादृच्छिक्_बीज/यादृच्छिक्_अगला —
// MINSTD/Park-Miller LCG, एकल global धारा)। यह मॉड्यूल उसकी जगह नहीं लेता
// — गणित.सूत्र वाला वैसे ही चलता रहेगा — बल्कि दो असली सुधार देता है:
//
//   1. गुणवत्ता — Marsaglia की xorshift128 (शुद्ध shift+xor, कोई गुणा नहीं,
//      128-बिट अवस्था)। सार्वजनिक/अकादमिक एल्गोरिथ्म (जैसे SHA-256 का FIPS
//      स्पेक था) — समझ के अपना कार्यान्वयन, किसी और का कोड कॉपी नहीं। LCG के
//      जाने-पहचाने निम्न-बिट सहसंबंध (spectral-test विफलता) यहाँ नहीं होते।
//   2. बहु-धारा — अवस्था एक शब्दकोश में रहती है (संदर्भ द्वारा उत्परिवर्तित,
//      पुनः-निर्धारण ज़रूरी नहीं), तो एक साथ कई स्वतंत्र, एक-दूसरे से अप्रभावित
//      यादृच्छिक धाराएँ बनाई जा सकती हैं — गणित.सूत्र के एकल global बीज के
//      विपरीत।
//
// आंतरिक रूप से बीज-विस्तार (एक संख्या → 4-शब्द अवस्था) के लिए गणित.सूत्र के
// मौजूदा LCG का पुनःप्रयोग करता है — डुप्लिकेट लॉजिक नहीं।
//
// पूरी तरह शुद्ध Sutra — कोई FFI/OS निर्भरता नहीं, तीनों बैकएंड (x86 डिफ़ॉल्ट,
// दुभाषिया, --release) पर समान चलता है। जानबूझकर कोई स्वतः-बीजन (auto-seed
// from system time) नहीं — नियतात्मक-दर-डिफ़ॉल्ट, गणित.सूत्र जैसा ही।
//
// ⚠ साइड-इफ़ेक्ट: यार_बनाओ(बीज) आंतरिक रूप से गणित.सूत्र के SHARED global
// गणित_बीज को अस्थायी रूप से दुबारा सेट करता है (सिर्फ़ 4-शब्द बीज-विस्तार के
// लिए)। अगर आपका प्रोग्राम गणित.सूत्र का यादृच्छिक_अगला()/यादृच्छिक() सीधे भी
// इस्तेमाल कर रहा है, तो यार_बनाओ() को बीच में बुलाने से उस global धारा का
// क्रम बदल जाएगा। दोनों साथ चाहिए तो अपनी सारी यार_बनाओ() कॉल गणित.सूत्र की
// global धारा शुरू करने से *पहले* कर लो।
// ============================================================

आयात "पुस्तकालय/गणित.सूत्र";

कार्य यार_मास्क32() { परत् बाम_सरक(1, 32) - 1; }

// ---- अवस्था बनाना ----

// स्थिर बीज से नई स्वतंत्र धारा (राज्य = शब्दकोश, संदर्भ-उत्परिवर्तित रहता)
कार्य यार_बनाओ(संख्या बीज) {
    संख्या मूल = बीज;
    यदि (मूल == 0) { मूल = 88675123; }
    यादृच्छिक_बीज(मूल);
    शब्दकोश रा = {};
    रा["अ"] = यादृच्छिक_अगला();
    रा["ब"] = यादृच्छिक_अगला();
    रा["स"] = यादृच्छिक_अगला();
    रा["द"] = यादृच्छिक_अगला();
    परत् रा;
}

// ---- मूल जनरेटर ----

// अगला कच्चा uint32 (0..2^32−1); राज्य को स्थान-पर बदलता है
कार्य यार_अगला32(शब्दकोश रा) {
    संख्या मास्क = यार_मास्क32();
    संख्या ट = रा["अ"];
    ट = बिट_और(बिट_भेद(ट, बाम_सरक(ट, 11)), मास्क);
    ट = बिट_भेद(ट, दक्षिण_सरक(ट, 8));
    रा["अ"] = रा["ब"];
    रा["ब"] = रा["स"];
    रा["स"] = रा["द"];
    संख्या ड = रा["द"];
    ड = बिट_भेद(ड, दक्षिण_सरक(ड, 19));
    ड = बिट_भेद(ड, ट);
    रा["द"] = ड;
    परत् ड;
}

// ---- सुविधा-API ----

// [0, 1) दशमलव
// नोट: यहाँ संख्या-फलन-कॉल को पहले एक संख्या स्थानीय चर में रखना ज़रूरी है
// (फिर दशमलव स्थानीय चर में परिणाम) — कॉल को सीधे मिश्रित संख्या/दशमलव
// अभिव्यक्ति में जोड़ने पर एक कम्पाइलर-बग टाइप-अनुमान को गलत कर देता है
// (परिणाम ग़लत-रूप से 0 बनता); मुख्य/मूल में असल isolate किया, अलग से रिपोर्ट।
कार्य यार_दशमलव(शब्दकोश रा) {
    संख्या कच्चा = यार_अगला32(रा);
    संख्या मास्क = यार_मास्क32();
    दशमलव भाजक = मास्क + 1.0;
    दशमलव फल = (कच्चा * 1.0) / भाजक;
    परत् फल;
}

// पूर्णांक [न्यून, उच्च] (दोनों सम्मिलित)
कार्य यार_परास(शब्दकोश रा, संख्या न्यून, संख्या उच्च) {
    यदि (उच्च <= न्यून) { परत् न्यून; }
    संख्या चौड़ाई = उच्च - न्यून + 1;
    परत् न्यून + (यार_अगला32(रा) % चौड़ाई);
}

// सत्य/असत्य 50/50
कार्य यार_बूल(शब्दकोश रा) {
    परत् (यार_अगला32(रा) % 2) == 0;
}

// सूची से यादृच्छिक तत्व (रिक्त → शून्यम्)
कार्य यार_तत्व(शब्दकोश रा, सूची स) {
    यदि (लंबाई(स) == 0) { परत् शून्यम्; }
    परत् स[यार_परास(रा, 0, लंबाई(स) - 1)];
}

// फ़िशर-येट्स फेंटना — नई सूची लौटाता है, मूल अछूती
कार्य यार_फेंटो(शब्दकोश रा, सूची स) {
    सूची फल = [];
    संख्या इ = 0;
    संख्या लं = लंबाई(स);
    यावत् (इ < लं) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + 1;
    }
    इ = लं - 1;
    यावत् (इ > 0) {
        संख्या ज = यार_परास(रा, 0, इ);
        संख्या अस्थायी = फल[इ];
        फल[इ] = फल[ज];
        फल[ज] = अस्थायी;
        इ = इ - 1;
    }
    परत् फल;
}
