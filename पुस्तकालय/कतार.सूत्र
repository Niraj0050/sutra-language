// पुस्तकालय/कतार.सूत्र — कतार (Queue, FIFO)
// ============================================================
// आयात "पुस्तकालय/कतार.सूत्र";
//   मान क = नवीन कतार();
//   क.डालो(१); क.डालो(२); क.डालो(३);
//   क.निकालो()   → १   (सबसे पहले डाला गया)
//   क.आगे()      → २   (हटता नहीं)
//   क.आकार()     → २
//
// भीतर एक सूची + शीर्ष-सूचक (amortised O(१) निकालो; समय-समय पर संकुचन)।
// ============================================================

वर्ग कतार {
    मान तत्व_क = ०;
    मान शीर्ष_क = ०;

    कार्य रचना() {
        स्व.तत्व_क = [];
        स्व.शीर्ष_क = ०;
    }

    कार्य डालो(मान म) {
        स्व.तत्व_क = जोड़ें(स्व.तत्व_क, म);
    }

    // सबसे पुराना तत्व लौटाओ और हटाओ (खाली → शून्यम्)
    कार्य निकालो() {
        यदि (स्व.शीर्ष_क >= लंबाई(स्व.तत्व_क)) { परत् शून्यम्; }
        मान पहला_त = स्व.तत्व_क[स्व.शीर्ष_क];
        स्व.शीर्ष_क = स्व.शीर्ष_क + १;
        // आधे से ज़्यादा खाली हो गया → संकुचन
        यदि (स्व.शीर्ष_क * २ >= लंबाई(स्व.तत्व_क)) {
            सूची नया = [];
            संख्या इ = स्व.शीर्ष_क;
            यावत् (इ < लंबाई(स्व.तत्व_क)) {
                नया = जोड़ें(नया, स्व.तत्व_क[इ]);
                इ = इ + १;
            }
            स्व.तत्व_क = नया;
            स्व.शीर्ष_क = ०;
        }
        परत् पहला_त;
    }

    // सबसे पुराना तत्व देखो, हटाओ मत (खाली → शून्यम्)
    कार्य आगे() {
        यदि (स्व.शीर्ष_क >= लंबाई(स्व.तत्व_क)) { परत् शून्यम्; }
        परत् स्व.तत्व_क[स्व.शीर्ष_क];
    }

    कार्य आकार() {
        परत् लंबाई(स्व.तत्व_क) - स्व.शीर्ष_क;
    }

    कार्य खाली_है() {
        परत् (लंबाई(स्व.तत्व_क) - स्व.शीर्ष_क) == ०;
    }
}
