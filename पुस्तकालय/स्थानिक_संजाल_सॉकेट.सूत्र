// पुस्तकालय/स्थानिक_संजाल_सॉकेट.सूत्र — संप्रभु स्थानिक टीसीपी सॉकेट संजाल धारा (Sovereign TCP Socket Stream)
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला
//
// विंडोज़ विंसॉक२ (Winsock2 ws2_32.dll FFI) पर आधारित वास्तविक संप्रभु टीसीपी
// सर्वर एवं क्लाइंट सॉकेट स्ट्रीमिंग प्रणाली:
//   १. लोकलहोस्ट एवं लैन (LAN) पर संप्रभु द्विआधारी तार-प्रोटोकॉल प्रेषण एवं श्रवण।
//   २. मानक ९-बाइट SUTR शीर्षलेख आधारित सटीक टीसीपी फ़्रेमिंग (Framed Packet Streaming)।
//   ३. पाणिनीय प्रत्याहार संपीड़ित दृश्य चौखटा धारा का लाइव टीसीपी सॉकेट अंतरण।
//   ४. शत-प्रतिशत दोषरहित द्विआधारी राउंडट्रिप एवं विखंडन-मुक्त (De-fragmented) पठन।
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/दृश्यक_द्विआधारी.सूत्र";
आयात "पुस्तकालय/स्थानिक_संजाल_धारा.सूत्र";
आयात "पुस्तकालय/पाणिनीय_संपीडन.सूत्र";

// ==============================================================================
// भाग १: विंसॉक२ विदेशी घोषणाएँ (Winsock2 Foreign Declarations)
// ==============================================================================

विदेशी "ws2_32" "WSAStartup" स्था_विनसॉक_आरंभ_रॉ(संख्या, संख्या);
विदेशी "ws2_32" "WSACleanup" स्था_विनसॉक_सफाई_रॉ();
विदेशी "ws2_32" "socket" स्था_सॉकेट_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "bind" स्था_बांधो_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "listen" स्था_सुनो_रॉ(संख्या, संख्या);
विदेशी "ws2_32" "accept" स्था_स्वीकार_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "connect" स्था_जोड़ो_रॉ(संख्या, संख्या, संख्या);
विदेशी "ws2_32" "send" स्था_भेजो_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "ws2_32" "recv" स्था_पाओ_रॉ(संख्या, संख्या, संख्या, संख्या);
विदेशी "ws2_32" "closesocket" स्था_बंद_रॉ(संख्या);
विदेशी "ws2_32" "htons" स्था_एचटीओएनएस(संख्या);
विदेशी "ws2_32" "inet_addr" स्था_आइपी_रॉ(संख्या);

कार्य स्था_पता_परिवार() { परत् २; } // AF_INET
कार्य स्था_धारा_प्रकार() { परत् १; } // SOCK_STREAM

// ==============================================================================
// भाग २: कच्चा बफर सहायक (Low-level Buffer Helpers)
// ==============================================================================

कार्य स्था_बफर(संख्या आकार) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < आकार) {
        फल = फल + " ";
        इ = इ + १;
    }
    परत् फल;
}

कार्य स्था_लिख१(संख्या पता, संख्या ऑफ, संख्या मू) {
    अंतर्_लिख1(पता, ऑफ, बिट_और(मू, २५५));
    परत् ०;
}

कार्य स्था_लिख२(संख्या पता, संख्या ऑफ, संख्या मू) {
    स्था_लिख१(पता, ऑफ, मू);
    स्था_लिख१(पता, ऑफ + १, दक्षिण_सरक(मू, ८));
    परत् ०;
}

कार्य स्था_लिख४(संख्या पता, संख्या ऑफ, संख्या मू) {
    स्था_लिख१(पता, ऑफ, मू);
    स्था_लिख१(पता, ऑफ + १, दक्षिण_सरक(मू, ८));
    स्था_लिख१(पता, ऑफ + २, दक्षिण_सरक(मू, १६));
    स्था_लिख१(पता, ऑफ + ३, दक्षिण_सरक(मू, २४));
    परत् ०;
}

कार्य स्था_पढ़१(संख्या पता, संख्या ऑफ) {
    परत् अंतर्_पढ़1(पता, ऑफ);
}

कार्य स्था_पढ़४(संख्या पता, संख्या ऑफ) {
    संख्या ब० = स्था_पढ़१(पता, ऑफ);
    संख्या ब१ = स्था_पढ़१(पता, ऑफ + १);
    संख्या ब२ = स्था_पढ़१(पता, ऑफ + २);
    संख्या ब३ = स्था_पढ़१(पता, ऑफ + ३);
    परत् ब० + (ब१ * २५६) + (ब२ * ६५५३६) + (ब३ * १६७७७२१६);
}

कार्य स्था_पता_बनाओ(संख्या आइपी_रॉ, संख्या पोर्ट) {
    पाठ बफ = स्था_बफर(१६);
    संख्या प = विदेशी_पता(बफ);
    स्था_लिख२(प, ०, स्था_पता_परिवार());
    स्था_लिख२(प, २, स्था_एचटीओएनएस(पोर्ट));
    स्था_लिख४(प, ४, आइपी_रॉ);
    स्था_लिख४(प, ८, ०);
    स्था_लिख४(प, १२, ०);

    शब्दकोश फल = {};
    फल["_रॉ"] = बफ;
    फल["पता"] = प;
    परत् फल;
}

// ==============================================================================
// भाग ३: संजाल सॉकेट जीवनचक्र (Socket Lifecycle Engine)
// ==============================================================================

कार्य स्थानिक_सॉकेट_आरंभ() {
    पाठ बफ = स्था_बफर(५१२);
    संख्या फल = स्था_विनसॉक_आरंभ_रॉ(५१४, विदेशी_पता(बफ)); // MAKEWORD(2,2)
    परत् फल == ०;
}

कार्य स्थानिक_सॉकेट_सफाई() {
    स्था_विनसॉक_सफाई_रॉ();
    परत् ०;
}

// सर्वर सॉकेट श्रवण आरंभ
कार्य स्थानिक_सॉकेट_सर्वर_शुरू(संख्या पोर्ट, संख्या प्रतीक्षा_पंक्ति) {
    संख्या सॉ = स्था_सॉकेट_रॉ(स्था_पता_परिवार(), स्था_धारा_प्रकार(), ०);
    यदि (सॉ < ०) {
        शब्दकोश त्रुटि_फल = {};
        त्रुटि_फल["सफल"] = असत्य;
        त्रुटि_फल["सॉकेट"] = -१;
        परत् त्रुटि_फल;
    }

    शब्दकोश पता = स्था_पता_बनाओ(०, पोर्ट); // INADDR_ANY
    संख्या बां_फल = स्था_बांधो_रॉ(सॉ, पता["पता"], १६);
    यदि (बां_फल != ०) {
        स्था_बंद_रॉ(सॉ);
        शब्दकोश त्रुटि_फल = {};
        त्रुटि_फल["सफल"] = असत्य;
        त्रुटि_फल["सॉकेट"] = -१;
        परत् त्रुटि_फल;
    }

    संख्या सु_फल = स्था_सुनो_रॉ(सॉ, प्रतीक्षा_पंक्ति);
    शब्दकोश फल = {};
    फल["सफल"] = सु_फल == ०;
    फल["सॉकेट"] = सॉ;
    फल["पोर्ट"] = पोर्ट;
    परत् फल;
}

// सर्वर द्वारा आवक क्लाइंट सॉकेट स्वीकार
कार्य स्थानिक_सॉकेट_सर्वर_स्वीकार(संख्या सर्वर_सॉकेट) {
    संख्या ग्राहक_सॉ = स्था_स्वीकार_रॉ(सर्वर_सॉकेट, ०, ०);
    शब्दकोश फल = {};
    यदि (ग्राहक_सॉ < ०) {
        फल["सफल"] = असत्य;
        फल["सॉकेट"] = -१;
    } अन्यथा {
        फल["सफल"] = सत्य;
        फल["सॉकेट"] = ग्राहक_सॉ;
    }
    परत् फल;
}

// क्लाइंट द्वारा सर्वर से टीसीपी जुड़ाव
कार्य स्थानिक_सॉकेट_क्लाइंट_जोड़ो(पाठ आइपी, संख्या पोर्ट) {
    संख्या आइपी_बाइट = स्था_आइपी_रॉ(विदेशी_पता(आइपी));
    संख्या सॉ = स्था_सॉकेट_रॉ(स्था_पता_परिवार(), स्था_धारा_प्रकार(), ०);
    शब्दकोश फल = {};
    यदि (सॉ < ०) {
        फल["सफल"] = असत्य;
        फल["सॉकेट"] = -१;
        परत् फल;
    }

    शब्दकोश पता = स्था_पता_बनाओ(आइपी_बाइट, पोर्ट);
    संख्या क्_फल = स्था_जोड़ो_रॉ(सॉ, पता["पता"], १६);
    फल["सफल"] = क्_फल == ०;
    फल["सॉकेट"] = सॉ;
    फल["पोर्ट"] = पोर्ट;
    परत् फल;
}

कार्य स्थानिक_सॉकेट_बंद(संख्या सॉकेट) {
    यदि (सॉकेट >= ०) {
        स्था_बंद_रॉ(सॉकेट);
    }
    परत् ०;
}

// ==============================================================================
// भाग ४: विश्वसनीय संप्रभु पैकेट प्रेषण एवं पठन (Framed Binary Streaming)
// ==============================================================================

// कच्चे बाइट्स की सूची प्रेषित करना
कार्य स्थानिक_सॉकेट_बाइट्स_भेजो(संख्या सॉकेट, सूची बाइट्स) {
    संख्या कुल = लंबाई(बाइट्स);
    यदि (कुल == ०) { परत् ०; }

    पाठ बफ = स्था_बफर(कुल);
    संख्या प = विदेशी_पता(बफ);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        स्था_लिख१(प, इ, बाइट्स[इ]);
        इ = इ + १;
    }

    संख्या कुल_प्रेषित = ०;
    यावत् (कुल_प्रेषित < कुल) {
        संख्या बचा = कुल - कुल_प्रेषित;
        संख्या प्रेषित = स्था_भेजो_रॉ(सॉकेट, प + कुल_प्रेषित, बचा, ०);
        यदि (प्रेषित <= ०) {
            विरामः;
        }
        कुल_प्रेषित = कुल_प्रेषित + प्रेषित;
    }
    परत् कुल_प्रेषित;
}

// टीसीपी विखंडन से सुरक्षा: सटीक 'अपेक्षित_लंबाई' बाइट्स प्राप्त करना
कार्य स्थानिक_सॉकेट_सटीक_बाइट्स_पाओ(संख्या सॉकेट, संख्या अपेक्षित_लंबाई) {
    सूची कुल_सूची = [];
    संख्या प्राप्त_गिनती = ०;
    पाठ बफ = स्था_बफर(अपेक्षित_लंबाई);
    संख्या प = विदेशी_पता(बफ);

    यावत् (प्राप्त_गिनती < अपेक्षित_लंबाई) {
        संख्या बचा = अपेक्षित_लंबाई - प्राप्त_गिनती;
        संख्या मिला = स्था_पाओ_रॉ(सॉकेट, प, बचा, ०);
        यदि (मिला <= ०) {
            विरामः; // कनेक्शन बंद अथवा त्रुटि
        }

        संख्या इ = ०;
        यावत् (इ < मिला) {
            संख्या बाइट_मान = स्था_पढ़१(प, इ);
            कुल_सूची = जोड़ें(कुल_सूची, बाइट_मान);
            इ = इ + १;
        }
        प्राप्त_गिनती = प्राप्त_गिनती + मिला;
    }
    परत् कुल_सूची;
}

// पूर्ण संप्रभु द्विआधारी पैकेट प्रेषण
कार्य स्थानिक_सॉकेट_पैकेट_भेजो(संख्या सॉकेट, सूची पैकेट_बाइट्स) {
    परत् स्थानिक_सॉकेट_बाइट्स_भेजो(सॉकेट, पैकेट_बाइट्स);
}

// पूर्ण संप्रभु द्विआधारी पैकेट पठन एवं पार्सिंग
कार्य स्थानिक_सॉकेट_पैकेट_पाओ(संख्या सॉकेट) {
    // १. प्रथम ९ बाइट्स शीर्षलेख पढ़ें
    सूची शीर्ष_बाइट्स = स्थानिक_सॉकेट_सटीक_बाइट्स_पाओ(सॉकेट, ९);
    यदि (लंबाई(शीर्ष_बाइट्स) < ९) {
        शब्दकोश त्रुटि_उत्तर = {};
        त्रुटि_उत्तर["सफल"] = असत्य;
        त्रुटि_उत्तर["संदेश"] = "अपूर्ण शीर्षलेख";
        परत् त्रुटि_उत्तर;
    }

    // शीर्षलेख अनपैक
    शब्दकोश शीर्ष = स्थानिक_शीर्षलेख_अनपैक(शीर्ष_बाइट्स, ०);
    संख्या पेलोड_लं = शीर्ष["पेलोड_लंबाई"];

    // २. सटीक पेलोड बाइट्स पढ़ें
    सूची पेलोड_बाइट्स = [];
    यदि (पेलोड_लं > ०) {
        पेलोड_बाइट्स = स्थानिक_सॉकेट_सटीक_बाइट्स_पाओ(सॉकेट, पेलोड_लं);
        यदि (लंबाई(पेलोड_बाइट्स) < पेलोड_लं) {
            शब्दकोश त्रुटि_उत्तर = {};
            त्रुटि_उत्तर["सफल"] = असत्य;
            त्रुटि_उत्तर["संदेश"] = "अपूर्ण पेलोड";
            परत् त्रुटि_उत्तर;
        }
    }

    // ३. संपूर्ण पैकेट संयोजन
    सूची संपूर्ण_पैकेट = [];
    संख्या शि_इ = ०;
    यावत् (शि_इ < ९) {
        संपूर्ण_पैकेट = जोड़ें(संपूर्ण_पैकेट, शीर्ष_बाइट्स[शि_इ]);
        शि_इ = शि_इ + १;
    }
    संख्या पे_इ = ०;
    यावत् (पे_इ < पेलोड_लं) {
        संपूर्ण_पैकेट = जोड़ें(संपूर्ण_पैकेट, पेलोड_बाइट्स[पे_इ]);
        पे_इ = पे_इ + १;
    }

    // ४. स्थानिक पैकेट पार्स
    शब्दकोश पार्स_फल = स्थानिक_पैकेट_पार्स(संपूर्ण_पैकेट);
    पार्स_फल["सफल"] = सत्य;
    पार्स_फल["कच्चा_पैकेट"] = संपूर्ण_पैकेट;
    परत् पार्स_फल;
}
