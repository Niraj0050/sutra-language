// पुस्तकालय/सूत्रक_संपीड़ित.सूत्र — सूत्र अष्टक-संकेत (.सूत्रकस) स्वचालित डिस्क संपीड़न
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला
//
// महर्षि पाणिनि के माहेश्वर सूत्र एवं प्रत्याहार सिद्धांतों पर आधारित सूत्र अष्टक-संकेत
// (.सूत्रकस - Sutra Compressed Bytecode) संप्रभु द्विआधारी डिस्क कंटेनर।
//
// विनिर्देश:
//   १. जादुई शीर्षलेख (Magic Header): 'SUTR' (८३, ८५, ८४, ८२)
//   २. प्रारूप संस्करण (Format Version): १ बाइट (१)
//   ३. पेलोड: पाणिनीय प्रत्याहार संपीड़ित बाइटकोड धारा (>४०% डिस्क आकार संकुचन)
//   ४. स्वचालित संपीड़न पहचान (Auto-detecting Loader):
//      .सूत्रक (सादा पाठ) एवं .सूत्रकस (संपीड़ित द्विआधारी) दोनों का पारदर्शी लोड।
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";
आयात "स्वसंकलक/अष्टक_संकेत.सूत्र";

// जादुई शीर्षलेख स्थिरांक
मान सूत्रकस_जादुई_१ = ८३; // 'S'
मान सूत्रकस_जादुई_२ = ८५; // 'U'
मान सूत्रकस_जादुई_३ = ८४; // 'T'
मान सूत्रकस_जादुई_४ = ८२; // 'R'
मान सूत्रकस_संस्करण_१ = १;

// ==============================================================================
// भाग १: द्विआधारी बाइट-पाठ रूपांतरण सहायक
// ==============================================================================

// बाइट पूर्णांक सूची को द्विआधारी पाठ स्ट्रिंग में बदलना
कार्य सूत्रकस_बाइट्स_से_पाठ(सूची बाइट्स) {
    पाठ फल = "";
    संख्या कुल = लंबाई(बाइट्स);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        फल = फल + अक्षर_निर्माण(बाइट्स[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// द्विआधारी पाठ स्ट्रिंग को बाइट पूर्णांक सूची में बदलना
कार्य सूत्रकस_पाठ_से_बाइट्स(पाठ सामग्री, संख्या आरंभ_सूचकांक) {
    सूची फल = [];
    संख्या कुल = लंबाई(सामग्री);
    संख्या इ = आरंभ_सूचकांक;
    यावत् (इ < कुल) {
        फल = जोड़ें(फल, अक्षर_मान(उपखंड(सामग्री, इ, इ + १)));
        इ = इ + १;
    }
    परत् फल;
}

// ==============================================================================
// भाग २: संपीड़ित .सूत्रकस डिस्क लेखन (Save to Disk)
// ==============================================================================

कार्य सूत्रकस_सञ्चिका_सहेजें(शब्दकोश प्रोग्राम, पाठ मार्गः) {
    पाठ कंटेनर_पाठ = अष्टक_कंटेनर_संश्लेषण(प्रोग्राम);
    सूची पाण_बाइट्स = पाणिनीय_संपीड़न_पाठ(कंटेनर_पाठ);
    सूची संपीड़ित_बाइट्स = संकुचन_संपीड़ित(पाण_बाइट्स);

    // ५-बाइट शीर्षलेख: 'SUTR' + संस्करण १
    पाठ निर्गम_पाठ = "" + अक्षर_निर्माण(सूत्रकस_जादुई_१) +
                          अक्षर_निर्माण(सूत्रकस_जादुई_२) +
                          अक्षर_निर्माण(सूत्रकस_जादुई_३) +
                          अक्षर_निर्माण(सूत्रकस_जादुई_४) +
                          अक्षर_निर्माण(सूत्रकस_संस्करण_१);

    संख्या कुल = लंबाई(संपीड़ित_बाइट्स);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        निर्गम_पाठ = निर्गम_पाठ + अक्षर_निर्माण(संपीड़ित_बाइट्स[इ]);
        इ = इ + १;
    }

    सञ्चिका_लिखतु(मार्गः, निर्गम_पाठ);
    परत् सत्य;
}

// ==============================================================================
// भाग ३: जादुई शीर्षलेख जाँच एवं संपीड़ित .सूत्रकस लोड
// ==============================================================================

कार्य सूत्रकस_जाँच_संपीड़ित(पाठ सामग्री) {
    यदि (लंबाई(सामग्री) < ५) {
        परत् असत्य;
    }
    यदि (अक्षर_मान(उपखंड(सामग्री, ०, १)) == सूत्रकस_जादुई_१ &&
        अक्षर_मान(उपखंड(सामग्री, १, २)) == सूत्रकस_जादुई_२ &&
        अक्षर_मान(उपखंड(सामग्री, २, ३)) == सूत्रकस_जादुई_३ &&
        अक्षर_मान(उपखंड(सामग्री, ३, ४)) == सूत्रकस_जादुई_४) {
        परत् सत्य;
    }
    परत् असत्य;
}

कार्य सूत्रकस_सञ्चिका_लोड(पाठ मार्गः) {
    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        फेको "त्रुटिः संपीड़ित बाइटकोड सञ्चिका न लब्धा: " + मार्गः;
    }
    पाठ सामग्री = सञ्चिका_पठतु(मार्गः);
    यदि (न सूत्रकस_जाँच_संपीड़ित(सामग्री)) {
        फेको "त्रुटिः अवैध सूत्रकस जादुई शीर्षलेख (Not a valid .सूत्रकस file): " + मार्गः;
    }
    संख्या संस्करण = अक्षर_मान(उपखंड(सामग्री, ४, ५));
    यदि (संस्करण != सूत्रकस_संस्करण_१) {
        फेको "त्रुटिः असमर्थित सूत्रकस संस्करण: " + देवनागरी_अंकों_में("" + संस्करण);
    }

    // ५वें बाइट से पेलोड निकालना
    सूची संपीड़ित_बाइट्स = सूत्रकस_पाठ_से_बाइट्स(सामग्री, ५);

    // पाणिनीय + संकुचन विसंपीड़न
    सूची विसंकु_बाइट्स = संकुचन_विसंपीड़ित(संपीड़ित_बाइट्स);
    पाठ विसंपीड़ित_कंटेनर = पाणिनीय_विसंपीड़न_पाठ(विसंकु_बाइट्स);

    // पार्स करके SVM प्रोग्राम लौटना
    परत् अष्टक_कंटेनर_पार्स(विसंपीड़ित_कंटेनर);
}

// ==============================================================================
// भाग ४: पारदर्शी स्वचालित लोडर (Transparent Auto-detecting Loader)
// ==============================================================================

// .सूत्रक (सादा पाठ) अथवा .सूत्रकस (संपीड़ित द्विआधारी) का स्वचालित लोड
कार्य सूत्रक_स्वचालित_लोड(पाठ मार्गः) {
    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        फेको "त्रुटिः बाइटकोड सञ्चिका न लब्धा: " + मार्गः;
    }
    पाठ सामग्री = सञ्चिका_पठतु(मार्गः);
    यदि (सूत्रकस_जाँच_संपीड़ित(सामग्री)) {
        संख्या संस्करण = अक्षर_मान(उपखंड(सामग्री, ४, ५));
        यदि (संस्करण != सूत्रकस_संस्करण_१) {
            फेको "त्रुटिः असमर्थित सूत्रकस संस्करण: " + देवनागरी_अंकों_में("" + संस्करण);
        }
        सूची संपीड़ित_बाइट्स = सूत्रकस_पाठ_से_बाइट्स(सामग्री, ५);
        सूची विसंकु_बाइट्स = संकुचन_विसंपीड़ित(संपीड़ित_बाइट्स);
        पाठ विसंपीड़ित_कंटेनर = पाणिनीय_विसंपीड़न_पाठ(विसंकु_बाइट्स);
        परत् अष्टक_कंटेनर_पार्स(विसंपीड़ित_कंटेनर);
    }
    // सादा .सूत्रक कंटेनर
    परत् अष्टक_कंटेनर_पार्स(सामग्री);
}

// ==============================================================================
// भाग ५: डिस्क संपीड़न मेट्रिक्स विश्लेषण
// ==============================================================================

कार्य सूत्रकस_संपीड़न_विश्लेषण(पाठ सादा_मार्ग, पाठ संपीड़ित_मार्ग) {
    यदि (न सञ्चिका_अस्ति(सादा_मार्ग)) {
        फेको "त्रुटिः सादा बाइटकोड सञ्चिका न लब्धा: " + सादा_मार्ग;
    }
    यदि (न सञ्चिका_अस्ति(संपीड़ित_मार्ग)) {
        फेको "त्रुटिः संपीड़ित बाइटकोड सञ्चिका न लब्धा: " + संपीड़ित_मार्ग;
    }
    पाठ सादा_सामग्री = सञ्चिका_पठतु(सादा_मार्ग);
    पाठ संपीड़ित_सामग्री = सञ्चिका_पठतु(संपीड़ित_मार्ग);

    संख्या सादा_आकार = लंबाई(सं_यूटीएफ8_एन्कोड(सादा_सामग्री));
    संख्या संपीड़ित_आकार = लंबाई(सं_यूटीएफ8_एन्कोड(संपीड़ित_सामग्री));
    दशमलव बचत_प्रतिशत = ०.०;
    यदि (सादा_आकार > ०) {
        बचत_प्रतिशत = ((सादा_आकार - संपीड़ित_आकार) * १००.०) / (सादा_आकार * १.०);
    }

    शब्दकोश परिणाम = {};
    परिणाम["सादा_आकार"] = सादा_आकार;
    परिणाम["संपीड़ित_आकार"] = संपीड़ित_आकार;
    परिणाम["बचत_प्रतिशत"] = बचत_प्रतिशत;
    परिणाम["सादा_आकार_देव"] = देवनागरी_अंकों_में("" + सादा_आकार);
    परिणाम["संपीड़ित_आकार_देव"] = देवनागरी_अंकों_में("" + संपीड़ित_आकार);
    परिणाम["बचत_प्रतिशत_देव"] = देवनागरी_अंकों_में("" + गोल(बचत_प्रतिशत)) + " %";
    
    परत् परिणाम;
}

// ==============================================================================
// भाग ६: अष्टक-संकेत उपनाम (Aliases)
// ==============================================================================

कार्य अष्टक_संपीड़ित_सञ्चिका_सहेजें(शब्दकोश प्रोग्राम, पाठ मार्गः) {
    परत् सूत्रकस_सञ्चिका_सहेजें(प्रोग्राम, मार्गः);
}

कार्य अष्टक_संपीड़ित_सञ्चिका_लोड(पाठ मार्गः) {
    परत् सूत्रकस_सञ्चिका_लोड(मार्गः);
}

कार्य अष्टक_स्वचालित_सञ्चिका_लोड(पाठ मार्गः) {
    परत् सूत्रक_स्वचालित_लोड(मार्गः);
}

कार्य अष्टक_संपीड़न_विश्लेषण(पाठ सादा_मार्ग, पाठ संपीड़ित_मार्ग) {
    परत् सूत्रकस_संपीड़न_विश्लेषण(सादा_मार्ग, संपीड़ित_मार्ग);
}
