// पुस्तकालय/विभेद.सूत्र — संपादन-दूरी, साझा अनुक्रम (LCS) और diff
// ============================================================
// आयात "पुस्तकालय/विभेद.सूत्र";
//
//   संपादन_दूरी("kitten", "sitting")                // 3   (Levenshtein: डालो/हटाओ/बदलो, हर एक १)
//   संपादन_दूरी_अंतर्विनिमय("ab", "ba")             // 1   (+ पास-पास दो अक्षर की अदला-बदली)
//   संपादन_समानता("kitten", "sitting")              // ५७  (०-१०० का पूर्णांक; १०० = बराबर)
//   संपादन_निकटतम("kiten", ["mitten", "kitten"])    // "kitten"
//   साझा_अनुक्रम("AGGTAB", "GXTXAYB")               // "GTAB"
//   सूची ओप = विभेद_सूची([१, २, ३, ४], [१, ३, ४, ५]);
//   // ओप = [["=", १], ["-", २], ["=", ३], ["=", ४], ["+", ५]]
//   विभेद_एकीकृत("पुराना", "नया", पुराना_पाठ, नया_पाठ, ३)    // `diff -u` जैसा पाठ
//   विभेद_पैच_लगाओ(पुराना_पाठ, patch)                      // नया पाठ, या शून्यम् यदि patch न लगे
//   विभेद_पैच_उलटा_लगाओ(नया_पाठ, patch)                    // पुराना पाठ वापस (`patch -R`)
//   विभेद_पैच_पार्स(patch)                                  // [{"पुराना_नाम", "नया_नाम", "हंक": [...]}, ...]
//
// चार परिवार, सब शुद्ध Sutra:
//  • संपादन-दूरी — Levenshtein (डालना/हटाना/बदलना) और optimal-string-alignment
//    रूप (पास-पास दो तत्वों की अदला-बदली भी १ चरण)। O(अ·ब) समय, O(ब) स्मृति।
//  • साझा अनुक्रम (longest common subsequence) — लंबाई और एक वास्तविक अनुक्रम।
//    O(अ·ब) समय और स्मृति।
//  • diff — दो सूचियों (या दो पाठों की पंक्तियों) का न्यूनतम edit-script:
//    [कोड, तत्व] जोड़ों की सूची, कोड "=" (साझा) / "-" (केवल पुराने में) / "+"
//    (केवल नए में)। बदलाव-खंड में "-" हमेशा "+" से पहले। पहले साझा उपसर्ग/
//    प्रत्यय छाँटे जाते, फिर बीच पर LCS-सारणी (आम diff-अनुकूलन) — इसलिए लगभग
//    एक-जैसी बड़ी फ़ाइलें भी सस्ती। `विभेद_एकीकृत` GNU/git `diff -U<n>` का
//    हूबहू प्रारूप देता (hunk-शीर्ष `@@ -a,b +c,d @@`, जुड़े/अलग hunks, संदर्भ-पंक्तियाँ)।
//  • patch — एकीकृत diff (`diff -u` / `git diff`) पढ़ना (`विभेद_पैच_पार्स`) और पाठ पर लगाना
//    (`विभेद_पैच_लगाओ`, उलटा: `विभेद_पैच_उलटा_लगाओ`, विस्तृत परिणाम/ऑफ़सेट/कारण:
//    `विभेद_पैच_फाइल_लगाओ`)। नियम `git apply --unidiff-zero` जैसे: (संदर्भ + हटाई) पंक्तियाँ
//    हूबहू मिलें; घोषित जगह पर न मिलें तो पास-पास खोज (पहले आगे, फिर पीछे); "\ No newline at
//    end of file" चिह्न पढ़े और लगाए जाते (git की सख्ती समेत); पूरा patch या तो लगता है या बिल्कुल नहीं।
//
// तत्व `संख्या` या `पाठ` (तुलना `==`); पाठ पर संपादन-दूरी/LCS Unicode कोडबिंदु के
// स्तर पर चलते — यानी देवनागरी मात्रा/हलंत अलग "अक्षर" गिने जाते (grapheme-cluster
// नहीं)। पंक्ति-diff में पंक्ति-विभाजक "\n" है ("\r" पंक्ति का हिस्सा रहता); अंतिम "\n"
// के बाद खाली टुकड़ा पंक्ति नहीं गिना जाता। "अंतिम पंक्ति में नई-पंक्ति नहीं" का भेद
// (`\ No newline at end of file`) `विभेद_एकीकृत` और patch पढ़ने/लगाने वाले फ़ंक्शन git की तरह बाइट-सटीक
// सँभालते हैं; केवल `विभेद_पंक्तियाँ` (और उस पर टिका `विभेद_एकीकृत_ओप`) इसे मॉडल नहीं करते — वे बिना-"\n"
// पंक्तियों पर चलते हैं। इनपुट-सूचियाँ कभी बदली नहीं जातीं।
// ============================================================

// ===== आंतरिक =====

// पाठ → कोडबिंदुओं (संख्या) की सूची
कार्य विभे_कोडबिंदु(पाठ स) {
    सूची फल = [];
    संख्या लं = लंबाई(स);
    संख्या इ = ०;
    यावत् (इ < लं) {
        फल = जोड़ें(फल, अक्षर_मान(उपखंड(स, इ, इ + १)));
        इ = इ + १;
    }
    परत् फल;
}

// कोडबिंदुओं की सूची → पाठ
कार्य विभे_पाठ_बनाओ(सूची कोड) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(कोड)) {
        फल = फल + अक्षर_निर्माण(कोड[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// स[आरंभ .. अंत) की नई प्रति
कार्य विभे_खंड(सूची स, संख्या आरंभ, संख्या अंत) {
    सूची फल = [];
    संख्या इ = आरंभ;
    यावत् (इ < अंत) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// ===== संपादन-दूरी =====

// दो सूचियों का Levenshtein — तत्व-तुलना `==`
कार्य संपादन_दूरी_सूची(सूची अ, सूची ब) {
    संख्या अ_गिन = लंबाई(अ);
    संख्या ब_गिन = लंबाई(ब);
    यदि (अ_गिन == ०) { परत् ब_गिन; }
    यदि (ब_गिन == ०) { परत् अ_गिन; }
    सूची पिछली = [];
    संख्या ज = ०;
    यावत् (ज <= ब_गिन) {
        पिछली = जोड़ें(पिछली, ज);
        ज = ज + १;
    }
    संख्या इ = १;
    यावत् (इ <= अ_गिन) {
        सूची वर्तमान = [इ];
        ज = १;
        यावत् (ज <= ब_गिन) {
            संख्या लागत = १;
            यदि (अ[इ - १] == ब[ज - १]) { लागत = ०; }
            संख्या ऊपर = पिछली[ज];
            संख्या बाएँ = वर्तमान[ज - १];
            संख्या तिरछा = पिछली[ज - १];
            संख्या सबसे_कम = ऊपर + १;
            यदि (बाएँ + १ < सबसे_कम) { सबसे_कम = बाएँ + १; }
            यदि (तिरछा + लागत < सबसे_कम) { सबसे_कम = तिरछा + लागत; }
            वर्तमान = जोड़ें(वर्तमान, सबसे_कम);
            ज = ज + १;
        }
        पिछली = वर्तमान;
        इ = इ + १;
    }
    संख्या परिणाम = पिछली[ब_गिन];
    परत् परिणाम;
}

// दो पाठों का Levenshtein (कोडबिंदु-स्तर)
कार्य संपादन_दूरी(पाठ अ, पाठ ब) {
    परत् संपादन_दूरी_सूची(विभे_कोडबिंदु(अ), विभे_कोडबिंदु(ब));
}

// optimal-string-alignment रूप: Levenshtein + पास-पास दो तत्वों की अदला-बदली = १ चरण।
// (हर उप-भाग एक ही बार संपादित — इसलिए "ca" → "abc" = ३, unrestricted Damerau में २)
कार्य संपादन_दूरी_अंतर्विनिमय_सूची(सूची अ, सूची ब) {
    संख्या अ_गिन = लंबाई(अ);
    संख्या ब_गिन = लंबाई(ब);
    यदि (अ_गिन == ०) { परत् ब_गिन; }
    यदि (ब_गिन == ०) { परत् अ_गिन; }
    सूची पिछली_दो = [];
    सूची पिछली = [];
    संख्या ज = ०;
    यावत् (ज <= ब_गिन) {
        पिछली_दो = जोड़ें(पिछली_दो, ०);
        पिछली = जोड़ें(पिछली, ज);
        ज = ज + १;
    }
    संख्या इ = १;
    यावत् (इ <= अ_गिन) {
        सूची वर्तमान = [इ];
        ज = १;
        यावत् (ज <= ब_गिन) {
            संख्या लागत = १;
            यदि (अ[इ - १] == ब[ज - १]) { लागत = ०; }
            संख्या ऊपर = पिछली[ज];
            संख्या बाएँ = वर्तमान[ज - १];
            संख्या तिरछा = पिछली[ज - १];
            संख्या सबसे_कम = ऊपर + १;
            यदि (बाएँ + १ < सबसे_कम) { सबसे_कम = बाएँ + १; }
            यदि (तिरछा + लागत < सबसे_कम) { सबसे_कम = तिरछा + लागत; }
            यदि (इ > १ && ज > १) {
                यदि (अ[इ - १] == ब[ज - २] && अ[इ - २] == ब[ज - १]) {
                    संख्या दो_पीछे = पिछली_दो[ज - २];
                    संख्या अदला = दो_पीछे + १;
                    यदि (अदला < सबसे_कम) { सबसे_कम = अदला; }
                }
            }
            वर्तमान = जोड़ें(वर्तमान, सबसे_कम);
            ज = ज + १;
        }
        पिछली_दो = पिछली;
        पिछली = वर्तमान;
        इ = इ + १;
    }
    संख्या परिणाम = पिछली[ब_गिन];
    परत् परिणाम;
}

कार्य संपादन_दूरी_अंतर्विनिमय(पाठ अ, पाठ ब) {
    परत् संपादन_दूरी_अंतर्विनिमय_सूची(विभे_कोडबिंदु(अ), विभे_कोडबिंदु(ब));
}

// ०-१०० का पूर्णांक: बराबर = १००, कुछ भी साझा नहीं (समान लंबाई) = ०।
// = (बड़ी_लंबाई − Levenshtein) × १०० ÷ बड़ी_लंबाई (पूर्णांक-भाग); दोनों खाली = १००
कार्य संपादन_समानता(पाठ अ, पाठ ब) {
    संख्या अ_गिन = लंबाई(अ);
    संख्या ब_गिन = लंबाई(ब);
    संख्या बड़ी = अ_गिन;
    यदि (ब_गिन > बड़ी) { बड़ी = ब_गिन; }
    यदि (बड़ी == ०) { परत् १००; }
    संख्या दूरी = संपादन_दूरी(अ, ब);
    परत् ((बड़ी - दूरी) * १००) / बड़ी;
}

// शब्दावली (पाठों की सूची) में सबसे कम संपादन-दूरी वाला शब्द ("क्या आपका मतलब ...");
// बराबरी में पहला; शब्दावली खाली हो तो शून्यम्
कार्य संपादन_निकटतम(पाठ शब्द, सूची शब्दावली) {
    यदि (लंबाई(शब्दावली) == ०) { परत् शून्यम्; }
    संख्या सर्वोत्तम_दूरी = संपादन_दूरी(शब्द, शब्दावली[०]);
    संख्या सर्वोत्तम_क्रम = ०;
    संख्या इ = १;
    यावत् (इ < लंबाई(शब्दावली)) {
        संख्या द = संपादन_दूरी(शब्द, शब्दावली[इ]);
        यदि (द < सर्वोत्तम_दूरी) {
            सर्वोत्तम_दूरी = द;
            सर्वोत्तम_क्रम = इ;
        }
        इ = इ + १;
    }
    परत् शब्दावली[सर्वोत्तम_क्रम];
}

// ===== साझा अनुक्रम (LCS) और diff =====

// प्रत्यय-LCS सारणी (सपाट सूची): एल[इ*(ब+१)+ज] = अ[इ..] और ब[ज..] के LCS की लंबाई
कार्य विभे_एलसीएस_सारणी(सूची अ, सूची ब) {
    संख्या अ_गिन = लंबाई(अ);
    संख्या ब_गिन = लंबाई(ब);
    संख्या चौड़ाई = ब_गिन + १;
    संख्या कुल = (अ_गिन + १) * चौड़ाई;
    सूची एल = [];
    संख्या क = ०;
    यावत् (क < कुल) {
        एल = जोड़ें(एल, ०);
        क = क + १;
    }
    संख्या इ = अ_गिन - १;
    यावत् (इ >= ०) {
        संख्या ज = ब_गिन - १;
        यावत् (ज >= ०) {
            संख्या स्थान = इ * चौड़ाई + ज;
            यदि (अ[इ] == ब[ज]) {
                संख्या तिरछा = एल[(इ + १) * चौड़ाई + ज + १];
                एल[स्थान] = तिरछा + १;
            } अन्यथा {
                संख्या नीचे = एल[(इ + १) * चौड़ाई + ज];
                संख्या दाएँ = एल[इ * चौड़ाई + ज + १];
                यदि (नीचे >= दाएँ) {
                    एल[स्थान] = नीचे;
                } अन्यथा {
                    एल[स्थान] = दाएँ;
                }
            }
            ज = ज - १;
        }
        इ = इ - १;
    }
    परत् एल;
}

// दो सूचियों के LCS की लंबाई
कार्य साझा_अनुक्रम_लंबाई_सूची(सूची अ, सूची ब) {
    यदि (लंबाई(अ) == ० || लंबाई(ब) == ०) { परत् ०; }
    सूची एल = विभे_एलसीएस_सारणी(अ, ब);
    संख्या परिणाम = एल[०];
    परत् परिणाम;
}

// दो सूचियों का एक LCS (वास्तविक अनुक्रम, अ के क्रम में) — वही जो diff के "=" तत्व
// देते (बराबरी में पहले अ से हटाना, फिर ब में डालना पसंद)
कार्य साझा_अनुक्रम_सूची(सूची अ, सूची ब) {
    सूची ओप = विभेद_सूची(अ, ब);
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(ओप)) {
        सूची जोड़ी = ओप[इ];
        यदि (जोड़ी[०] == "=") { फल = जोड़ें(फल, जोड़ी[१]); }
        इ = इ + १;
    }
    परत् फल;
}

कार्य साझा_अनुक्रम_लंबाई(पाठ अ, पाठ ब) {
    परत् साझा_अनुक्रम_लंबाई_सूची(विभे_कोडबिंदु(अ), विभे_कोडबिंदु(ब));
}

// दो पाठों का एक LCS, पाठ के रूप में
कार्य साझा_अनुक्रम(पाठ अ, पाठ ब) {
    परत् विभे_पाठ_बनाओ(साझा_अनुक्रम_सूची(विभे_कोडबिंदु(अ), विभे_कोडबिंदु(ब)));
}

// पुराने → नए का न्यूनतम edit-script: [कोड, तत्व] जोड़ों की सूची (कोड "=" / "-" / "+")
कार्य विभेद_सूची(सूची पुराना, सूची नया) {
    संख्या पु_गिन = लंबाई(पुराना);
    संख्या न_गिन = लंबाई(नया);
    // साझा उपसर्ग, फिर (उससे न टकराता) साझा प्रत्यय
    संख्या उप = ०;
    यावत् (उप < पु_गिन && उप < न_गिन && पुराना[उप] == नया[उप]) {
        उप = उप + १;
    }
    संख्या प्रत = ०;
    यावत् (प्रत < पु_गिन - उप && प्रत < न_गिन - उप && पुराना[पु_गिन - १ - प्रत] == नया[न_गिन - १ - प्रत]) {
        प्रत = प्रत + १;
    }
    सूची ओप = [];
    संख्या इ = ०;
    यावत् (इ < उप) {
        ओप = जोड़ें(ओप, ["=", पुराना[इ]]);
        इ = इ + १;
    }
    // बीच का हिस्सा: पुराना[उप .. पु_गिन-प्रत) बनाम नया[उप .. न_गिन-प्रत)
    सूची अ = विभे_खंड(पुराना, उप, पु_गिन - प्रत);
    सूची ब = विभे_खंड(नया, उप, न_गिन - प्रत);
    संख्या अ_गिन = लंबाई(अ);
    संख्या ब_गिन = लंबाई(ब);
    संख्या चौड़ाई = ब_गिन + १;
    सूची एल = विभे_एलसीएस_सारणी(अ, ब);
    संख्या क = ०;
    संख्या ख = ०;
    यावत् (क < अ_गिन && ख < ब_गिन) {
        यदि (अ[क] == ब[ख]) {
            ओप = जोड़ें(ओप, ["=", अ[क]]);
            क = क + १;
            ख = ख + १;
        } अन्यथा {
            संख्या नीचे = एल[(क + १) * चौड़ाई + ख];
            संख्या दाएँ = एल[क * चौड़ाई + ख + १];
            यदि (नीचे >= दाएँ) {
                ओप = जोड़ें(ओप, ["-", अ[क]]);
                क = क + १;
            } अन्यथा {
                ओप = जोड़ें(ओप, ["+", ब[ख]]);
                ख = ख + १;
            }
        }
    }
    यावत् (क < अ_गिन) {
        ओप = जोड़ें(ओप, ["-", अ[क]]);
        क = क + १;
    }
    यावत् (ख < ब_गिन) {
        ओप = जोड़ें(ओप, ["+", ब[ख]]);
        ख = ख + १;
    }
    इ = ०;
    यावत् (इ < प्रत) {
        ओप = जोड़ें(ओप, ["=", पुराना[पु_गिन - प्रत + इ]]);
        इ = इ + १;
    }
    परत् ओप;
}

// edit-script से "पुराना" (= और -) और "नया" (= और +) सूचियाँ फिर बनाओ
कार्य विभेद_से_पुराना(सूची ओप) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(ओप)) {
        सूची जोड़ी = ओप[इ];
        यदि (जोड़ी[०] != "+") { फल = जोड़ें(फल, जोड़ी[१]); }
        इ = इ + १;
    }
    परत् फल;
}

कार्य विभेद_से_नया(सूची ओप) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(ओप)) {
        सूची जोड़ी = ओप[इ];
        यदि (जोड़ी[०] != "-") { फल = जोड़ें(फल, जोड़ी[१]); }
        इ = इ + १;
    }
    परत् फल;
}

// edit-script में असली बदलावों ("-" और "+") की गिनती
कार्य विभेद_बदलाव_गिनती(सूची ओप) {
    संख्या गिन = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(ओप)) {
        सूची जोड़ी = ओप[इ];
        यदि (जोड़ी[०] != "=") { गिन = गिन + १; }
        इ = इ + १;
    }
    परत् गिन;
}

// पाठ → पंक्तियों की सूची ("\n" पर); अंतिम "\n" के बाद का खाली टुकड़ा पंक्ति नहीं; "" → []
कार्य विभेद_पंक्तियों_में_बाँटो(पाठ स) {
    सूची टुकड़े = विभाजित(स, "\n");
    संख्या कुल = लंबाई(टुकड़े);
    यदि (कुल > ० && टुकड़े[कुल - १] == "") { कुल = कुल - १; }
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        फल = जोड़ें(फल, टुकड़े[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// दो पाठों की पंक्ति-स्तर का edit-script
कार्य विभेद_पंक्तियाँ(पाठ पुराना, पाठ नया) {
    परत् विभेद_सूची(विभेद_पंक्तियों_में_बाँटो(पुराना), विभेद_पंक्तियों_में_बाँटो(नया));
}

// hunk-शीर्ष की सीमा: गिनती १ हो तो केवल शुरुआत, वरना "शुरुआत,गिनती" (GNU/git नियम)
कार्य विभे_सीमा(संख्या शुरू, संख्या गिन) {
    यदि (गिन == १) { परत् "" + शुरू; }
    परत् शुरू + "," + गिन;
}

// पाठ → "अंत-सहित" पंक्ति-तत्व: हर पूरी पंक्ति `पंक्ति + "\n"`; अंतिम अधूरी पंक्ति (पाठ "\n" पर
// खत्म नहीं होता) बिना "\n" — इसलिए "b" और "b\n" अलग तत्व हैं (git का बाइट-सटीक नियम)। "" → []
कार्य विभे_पंक्तियाँ_अंत_सहित(पाठ स) {
    सूची टुकड़े = विभाजित(स, "\n");
    संख्या कुल = लंबाई(टुकड़े);
    संख्या अंतिम_पूरी = ०;
    यदि (कुल > ० && टुकड़े[कुल - १] == "") {
        कुल = कुल - १;
        अंतिम_पूरी = १;
    }
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        यदि (इ < कुल - १ || अंतिम_पूरी == १) {
            फल = जोड़ें(फल, टुकड़े[इ] + "\n");
        } अन्यथा {
            फल = जोड़ें(फल, टुकड़े[इ]);
        }
        इ = इ + १;
    }
    परत् फल;
}

// एक hunk-पंक्ति का पाठ। अंत_मोड == ० में तत्व बिना "\n" का है, इसलिए "\n" जोड़ो। अंत_मोड == १ में
// तत्व अपना "\n" साथ रखता है: "\n" से खत्म हो तो वैसे ही, वरना यह अधूरी अंतिम पंक्ति है — "\n" जोड़ो
// और उसके बाद "\ No newline at end of file" पंक्ति (बैकस्लैश कोड ९२ से, quoting की गलती से बचने को)
कार्य विभे_पंक्ति_छापो(पाठ चिह्न, पाठ तत्व, संख्या अंत_मोड) {
    यदि (अंत_मोड == ०) { परत् चिह्न + तत्व + "\n"; }
    संख्या ल = लंबाई(तत्व);
    यदि (ल > ० && अक्षर_मान(उपखंड(तत्व, ल - १, ल)) == १०) { परत् चिह्न + तत्व; }
    परत् चिह्न + तत्व + "\n" + अक्षर_निर्माण(९२) + " No newline at end of file\n";
}

// edit-script → एकीकृत (unified) diff पाठ; कोई अंतर नहीं हो तो ""।
// `संदर्भ` = हर बदलाव के आसपास की साझा पंक्तियाँ (diff -U<n>); बदलाव-समूह जुड़ते जब बीच
// की साझा पंक्तियाँ <= २ × संदर्भ हों। `अंत_मोड` के लिए `विभे_पंक्ति_छापो` देखो।
कार्य विभे_एकीकृत_ओप_मोड(पाठ पुराना_नाम, पाठ नया_नाम, सूची ओप, संख्या संदर्भ, संख्या अंत_मोड) {
    संख्या कुल = लंबाई(ओप);
    सूची बदलाव = [];
    // हर स्थान से पहले पुरानी / नई ओर की पंक्तियों की गिनती
    सूची पु_पहले = [];
    सूची न_पहले = [];
    संख्या पु_गिनती = ०;
    संख्या न_गिनती = ०;
    संख्या इ = ०;
    यावत् (इ < कुल) {
        सूची जोड़ी = ओप[इ];
        पु_पहले = जोड़ें(पु_पहले, पु_गिनती);
        न_पहले = जोड़ें(न_पहले, न_गिनती);
        यदि (जोड़ी[०] == "=") {
            पु_गिनती = पु_गिनती + १;
            न_गिनती = न_गिनती + १;
        } अन्यथा यदि (जोड़ी[०] == "-") {
            पु_गिनती = पु_गिनती + १;
            बदलाव = जोड़ें(बदलाव, इ);
        } अन्यथा {
            न_गिनती = न_गिनती + १;
            बदलाव = जोड़ें(बदलाव, इ);
        }
        इ = इ + १;
    }
    यदि (लंबाई(बदलाव) == ०) { परत् ""; }

    पाठ फल = "--- " + पुराना_नाम + "\n" + "+++ " + नया_नाम + "\n";
    संख्या ग = ०;
    यावत् (ग < लंबाई(बदलाव)) {
        संख्या पहला = बदलाव[ग];
        संख्या अंतिम = पहला;
        संख्या घ = ग + १;
        यावत् (घ < लंबाई(बदलाव)) {
            संख्या अगला = बदलाव[घ];
            यदि (अगला - अंतिम - १ > २ * संदर्भ) { विरामः; }
            अंतिम = अगला;
            घ = घ + १;
        }
        संख्या आरंभ = पहला - संदर्भ;
        यदि (आरंभ < ०) { आरंभ = ०; }
        संख्या अंत = अंतिम + संदर्भ;
        यदि (अंत > कुल - १) { अंत = कुल - १; }
        संख्या पु_कुल = ०;
        संख्या न_कुल = ०;
        संख्या क = आरंभ;
        यावत् (क <= अंत) {
            सूची जोड़ी = ओप[क];
            यदि (जोड़ी[०] != "+") { पु_कुल = पु_कुल + १; }
            यदि (जोड़ी[०] != "-") { न_कुल = न_कुल + १; }
            क = क + १;
        }
        संख्या पु_पहले_यहाँ = पु_पहले[आरंभ];
        संख्या न_पहले_यहाँ = न_पहले[आरंभ];
        संख्या पु_शुरू = पु_पहले_यहाँ + १;
        यदि (पु_कुल == ०) { पु_शुरू = पु_शुरू - १; }
        संख्या न_शुरू = न_पहले_यहाँ + १;
        यदि (न_कुल == ०) { न_शुरू = न_शुरू - १; }
        फल = फल + "@@ -" + विभे_सीमा(पु_शुरू, पु_कुल) + " +" + विभे_सीमा(न_शुरू, न_कुल) + " @@\n";
        क = आरंभ;
        यावत् (क <= अंत) {
            सूची जोड़ी = ओप[क];
            पाठ चिह्न = " ";
            यदि (जोड़ी[०] == "-") { चिह्न = "-"; }
            यदि (जोड़ी[०] == "+") { चिह्न = "+"; }
            फल = फल + विभे_पंक्ति_छापो(चिह्न, जोड़ी[१], अंत_मोड);
            क = क + १;
        }
        ग = घ;
    }
    परत् फल;
}

// edit-script (तत्व बिना "\n" की पंक्तियाँ, जैसे `विभेद_पंक्तियाँ` से) → एकीकृत (unified) diff पाठ; कोई अंतर
// नहीं हो तो ""। `संदर्भ` = हर बदलाव के आसपास की साझा पंक्तियाँ (diff -U<n>); बदलाव-समूह जुड़ते जब बीच
// की साझा पंक्तियाँ <= २ × संदर्भ हों। (अंतिम-नई-पंक्ति का भेद इस रूप में उपलब्ध नहीं — वह `विभेद_एकीकृत` में है।)
कार्य विभेद_एकीकृत_ओप(पाठ पुराना_नाम, पाठ नया_नाम, सूची ओप, संख्या संदर्भ) {
    परत् विभे_एकीकृत_ओप_मोड(पुराना_नाम, नया_नाम, ओप, संदर्भ, ०);
}

// दो पाठों का एकीकृत diff (`diff -u` / `git diff -U<संदर्भ>` जैसा); कोई अंतर नहीं हो तो "".
// "अंतिम पंक्ति में नई-पंक्ति नहीं" का भेद git की तरह बाइट-सटीक: "b" और "b\n" अलग पंक्तियाँ गिनी जातीं,
// और अधूरी अंतिम पंक्ति के बाद `\ No newline at end of file` छपता है
कार्य विभेद_एकीकृत(पाठ पुराना_नाम, पाठ नया_नाम, पाठ पुराना_पाठ, पाठ नया_पाठ, संख्या संदर्भ) {
    सूची पुरानी_सूची = विभे_पंक्तियाँ_अंत_सहित(पुराना_पाठ);
    सूची नई_सूची = विभे_पंक्तियाँ_अंत_सहित(नया_पाठ);
    सूची ओप = विभेद_सूची(पुरानी_सूची, नई_सूची);
    परत् विभे_एकीकृत_ओप_मोड(पुराना_नाम, नया_नाम, ओप, संदर्भ, १);
}

// ===== patch: एकीकृत diff पढ़ना और लगाना =====
//
// पार्स-परिणाम (विभेद_पैच_पार्स):
//   फाइल = {"पुराना_नाम", "नया_नाम", "हंक": [हंक, ...]}
//   हंक  = {"पु_शुरू", "पु_गिन", "न_शुरू", "न_गिन",     // "@@ -पु_शुरू,पु_गिन +न_शुरू,न_गिन @@"
//           "ओप": [[कोड, पंक्ति], ...],                   // कोड "=" / "-" / "+" (`विभेद_सूची` वाला ही)
//           "पु_अंत_बिना", "न_अंत_बिना"}                  // १ = उस ओर की अंतिम पंक्ति के बाद
//                                                         //     "\ No newline at end of file" था
// लगाने का नियम `git apply --unidiff-zero` जैसा: हंक की (संदर्भ + हटाई) पंक्तियाँ फ़ाइल में
// हूबहू मिलनी चाहिए; घोषित जगह पर न मिलें तो पास-पास खोजो (पहले आगे, फिर पीछे, बढ़ती दूरी
// से); पिछले हंक के बाद ही मिलना चाहिए; हंक का पुराना शुरू ० हो तो केवल फ़ाइल के आरंभ में।

// स[स्थिति ..] "टुकड़ा" से शुरू होता है?
कार्य विभे_यहाँ_है(पाठ स, संख्या स्थिति, पाठ टुकड़ा) {
    संख्या टु_गिन = लंबाई(टुकड़ा);
    यदि (स्थिति + टु_गिन > लंबाई(स)) { परत् असत्य; }
    परत् उपखंड(स, स्थिति, स्थिति + टु_गिन) == टुकड़ा;
}

// पाठ का पहला अक्षर (कोडबिंदु); खाली पाठ → -१
कार्य विभे_पहला_कोड(पाठ स) {
    यदि (लंबाई(स) == ०) { परत् -१; }
    परत् अक्षर_मान(उपखंड(स, ०, १));
}

// स[स्थिति ..] से दशमलव अंक पढ़ो → [मान, नई_स्थिति]; अंक न हों (या ९ से अधिक हों) तो [-१, स्थिति]
कार्य विभे_अंक_वाचन(पाठ स, संख्या स्थिति) {
    संख्या फल = ०;
    संख्या मिले = ०;
    संख्या इ = स्थिति;
    यावत् (इ < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, इ, इ + १));
        यदि (क < ४८ || क > ५७) { विरामः; }
        फल = फल * १० + (क - ४८);
        मिले = मिले + १;
        इ = इ + १;
    }
    यदि (मिले == ० || मिले > ९) { परत् [-१, स्थिति]; }
    परत् [फल, इ];
}

// "@@ -a[,b] +c[,d] @@ …" → [पु_शुरू, पु_गिन, न_शुरू, न_गिन]; भ्रष्ट हो तो []
कार्य विभे_हंक_शीर्ष(पाठ पं) {
    सूची खाली = [];
    यदि (न विभे_यहाँ_है(पं, ०, "@@ -")) { परत् खाली; }
    सूची र = विभे_अंक_वाचन(पं, ४);
    संख्या पु_शुरू = र[०];
    संख्या स्थिति = र[१];
    यदि (पु_शुरू < ०) { परत् खाली; }
    संख्या पु_गिन = १;
    यदि (विभे_यहाँ_है(पं, स्थिति, ",")) {
        र = विभे_अंक_वाचन(पं, स्थिति + १);
        पु_गिन = र[०];
        स्थिति = र[१];
        यदि (पु_गिन < ०) { परत् खाली; }
    }
    यदि (न विभे_यहाँ_है(पं, स्थिति, " +")) { परत् खाली; }
    र = विभे_अंक_वाचन(पं, स्थिति + २);
    संख्या न_शुरू = र[०];
    स्थिति = र[१];
    यदि (न_शुरू < ०) { परत् खाली; }
    संख्या न_गिन = १;
    यदि (विभे_यहाँ_है(पं, स्थिति, ",")) {
        र = विभे_अंक_वाचन(पं, स्थिति + १);
        न_गिन = र[०];
        स्थिति = र[१];
        यदि (न_गिन < ०) { परत् खाली; }
    }
    यदि (न विभे_यहाँ_है(पं, स्थिति, " @@")) { परत् खाली; }
    परत् [पु_शुरू, पु_गिन, न_शुरू, न_गिन];
}

// "--- नाम\tसमय" / "+++ नाम" पंक्ति से नाम (पहले टैब तक); पंक्ति "--- " या "+++ " से शुरू हो
कार्य विभे_नाम_काटो(पाठ पंक्ति) {
    पाठ नाम = उपखंड(पंक्ति, ४, लंबाई(पंक्ति));
    संख्या इ = ०;
    यावत् (इ < लंबाई(नाम)) {
        यदि (अक्षर_मान(उपखंड(नाम, इ, इ + १)) == ९) { विरामः; }
        इ = इ + १;
    }
    परत् उपखंड(नाम, ०, इ);
}

// हंक की देह पढ़ो — पं[शुरू ..] से, घोषित गिनतियाँ (पु_गिन, न_गिन) पूरी होने तक, फिर जुड़े हुए
// "\ No newline at end of file" चिह्न। लौटाता है {"त्रुटि", "ओप", "पु_अंत_बिना", "न_अंत_बिना", "अगला"}
कार्य विभे_हंक_देह(सूची पं, संख्या शुरू, संख्या पु_गिन, संख्या न_गिन) {
    सूची ओप = [];
    संख्या कुल = लंबाई(पं);
    संख्या पु_देखा = ०;
    संख्या न_देखा = ०;
    संख्या पु_बिना = ०;
    संख्या न_बिना = ०;
    पाठ पिछला = "";
    पाठ त्रुटि = "";
    संख्या इ = शुरू;
    यावत् (त्रुटि == "") {
        संख्या पूरा = ०;
        यदि (पु_देखा >= पु_गिन && न_देखा >= न_गिन) { पूरा = १; }
        यदि (इ >= कुल) {
            यदि (पूरा == ०) { त्रुटि = "हंक अधूरा — patch बीच में खत्म हो गया"; }
            विरामः;
        }
        पाठ रेखा = पं[इ];
        संख्या पहला = विभे_पहला_कोड(रेखा);
        संख्या चिह्न_है = ०;
        यदि (पहला == ९२) { चिह्न_है = १; }
        यदि (पूरा == १ && चिह्न_है == ०) { विरामः; }
        यदि (चिह्न_है == १) {
            यदि (पिछला == "-") { पु_बिना = १; }
            अन्यथा यदि (पिछला == "+") { न_बिना = १; }
            अन्यथा यदि (पिछला == "=") {
                पु_बिना = १;
                न_बिना = १;
            } अन्यथा { त्रुटि = "'No newline' चिह्न से पहले कोई पंक्ति नहीं"; }
        } अन्यथा {
            पाठ कोड = "=";
            पाठ सामग्री = "";
            यदि (पहला >= ०) {
                सामग्री = उपखंड(रेखा, १, लंबाई(रेखा));
                यदि (पहला == ४५) { कोड = "-"; }
                अन्यथा यदि (पहला == ४३) { कोड = "+"; }
                अन्यथा यदि (पहला != ३२) { कोड = "?"; }
            }
            यदि (कोड == "?") {
                त्रुटि = "हंक की पंक्ति ' ', '-' या '+' से शुरू नहीं होती";
            } अन्यथा {
                यदि (कोड != "+") { पु_देखा = पु_देखा + १; }
                यदि (कोड != "-") { न_देखा = न_देखा + १; }
                यदि (पु_देखा > पु_गिन || न_देखा > न_गिन) {
                    त्रुटि = "हंक की पंक्तियाँ घोषित गिनती से अधिक हैं";
                } अन्यथा {
                    ओप = जोड़ें(ओप, [कोड, सामग्री]);
                    पिछला = कोड;
                }
            }
        }
        इ = इ + १;
    }
    शब्दकोश फल = {"त्रुटि": त्रुटि, "ओप": ओप, "पु_अंत_बिना": पु_बिना, "न_अंत_बिना": न_बिना, "अगला": इ};
    परत् फल;
}

// पूरा patch पाठ → {"फाइलें": [फाइल, ...], "त्रुटि": ""}। "---"/"+++" जोड़ी नई फाइल शुरू करती
// है; "@@" से पहले की git-शीर्ष पंक्तियाँ (diff --git, index, mode …) छोड़ दी जाती हैं;
// बिना शीर्ष के अकेले हंक एक बिना-नाम फाइल में जाते हैं। बाइनरी patch समर्थित नहीं।
कार्य विभे_पैच_वाचन(पाठ पैच) {
    सूची पं = विभेद_पंक्तियों_में_बाँटो(पैच);
    संख्या कुल = लंबाई(पं);
    सूची फाइलें = [];
    शब्दकोश चालू = {};
    संख्या चालू_है = ०;
    पाठ त्रुटि = "";
    संख्या इ = ०;
    यावत् (त्रुटि == "" && इ < कुल) {
        पाठ रेखा = पं[इ];
        यदि (विभे_यहाँ_है(रेखा, ०, "GIT binary patch") || विभे_यहाँ_है(रेखा, ०, "Binary files ")) {
            त्रुटि = "पंक्ति " + (इ + १) + ": बाइनरी patch समर्थित नहीं";
        } अन्यथा यदि (विभे_यहाँ_है(रेखा, ०, "--- ") && इ + १ < कुल && विभे_यहाँ_है(पं[इ + १], ०, "+++ ")) {
            चालू = {"पुराना_नाम": विभे_नाम_काटो(रेखा), "नया_नाम": विभे_नाम_काटो(पं[इ + १]), "हंक": []};
            फाइलें = जोड़ें(फाइलें, चालू);
            चालू_है = १;
            इ = इ + २;
        } अन्यथा यदि (विभे_यहाँ_है(रेखा, ०, "@@ -")) {
            सूची शीर्ष = विभे_हंक_शीर्ष(रेखा);
            यदि (लंबाई(शीर्ष) == ०) {
                त्रुटि = "पंक्ति " + (इ + १) + ": हंक-शीर्ष भ्रष्ट";
            } अन्यथा {
                संख्या पु_शुरू = शीर्ष[०];
                संख्या पु_गिन = शीर्ष[१];
                संख्या न_शुरू = शीर्ष[२];
                संख्या न_गिन = शीर्ष[३];
                शब्दकोश देह = विभे_हंक_देह(पं, इ + १, पु_गिन, न_गिन);
                पाठ देह_त्रुटि = देह["त्रुटि"];
                यदि (देह_त्रुटि != "") {
                    त्रुटि = "पंक्ति " + (इ + १) + ": " + देह_त्रुटि;
                } अन्यथा {
                    यदि (चालू_है == ०) {
                        चालू = {"पुराना_नाम": "", "नया_नाम": "", "हंक": []};
                        फाइलें = जोड़ें(फाइलें, चालू);
                        चालू_है = १;
                    }
                    शब्दकोश हंक = {"पु_शुरू": पु_शुरू, "पु_गिन": पु_गिन, "न_शुरू": न_शुरू, "न_गिन": न_गिन, "ओप": देह["ओप"], "पु_अंत_बिना": देह["पु_अंत_बिना"], "न_अंत_बिना": देह["न_अंत_बिना"]};
                    चालू["हंक"] = जोड़ें(चालू["हंक"], हंक);
                    इ = देह["अगला"];
                }
            }
        } अन्यथा {
            इ = इ + १;
        }
    }
    शब्दकोश फल = {"फाइलें": फाइलें, "त्रुटि": त्रुटि};
    परत् फल;
}

// patch पाठ को पढ़ो → फाइलों की सूची [{"पुराना_नाम", "नया_नाम", "हंक"}, ...]; भ्रष्ट हो तो शून्यम्।
// खाली patch → खाली सूची
कार्य विभेद_पैच_पार्स(पाठ पैच) {
    शब्दकोश र = विभे_पैच_वाचन(पैच);
    पाठ त्रुटि = र["त्रुटि"];
    यदि (त्रुटि != "") { परत् शून्यम्; }
    परत् र["फाइलें"];
}

// patch पाठ ठीक है? "" = ठीक; वरना कारण-संदेश ("पंक्ति N: …")
कार्य विभेद_पैच_त्रुटि(पाठ पैच) {
    शब्दकोश र = विभे_पैच_वाचन(पैच);
    पाठ त्रुटि = र["त्रुटि"];
    परत् त्रुटि;
}

// पाठ में अंतिम पंक्ति के बाद नई-पंक्ति नहीं है? (१/०; खाली पाठ → ०)
कार्य विभे_अंत_बिना_है(पाठ स) {
    संख्या ल = लंबाई(स);
    यदि (ल == ०) { परत् ०; }
    यदि (अक्षर_मान(उपखंड(स, ल - १, ल)) == १०) { परत् ०; }
    परत् १;
}

// पंक्तियाँ → पाठ; अंत_बिना == १ हो तो अंतिम पंक्ति के बाद "\n" नहीं
कार्य विभे_पंक्तियाँ_जोड़ो(सूची पं, संख्या अंत_बिना) {
    पाठ फल = "";
    संख्या कुल = लंबाई(पं);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        फल = फल + पं[इ];
        यदि (इ < कुल - १ || अंत_बिना == ०) { फल = फल + "\n"; }
        इ = इ + १;
    }
    परत् फल;
}

// खोज-पंक्तियाँ पंक्तियाँ[स्थान ..] पर ठीक बैठती हैं? (स्थान निचला..ऊपरी में; अंत_रोध == १ हो तो
// फ़ाइल के अंतिम अधूरे टुकड़े तक पहुँचने वाली जगह अस्वीकार — git की तरह)
कार्य विभे_उम्मीदवार(सूची पंक्तियाँ, संख्या स्थान, सूची खोज, संख्या निचला, संख्या ऊपरी, संख्या अंत_रोध) {
    यदि (स्थान < निचला || स्थान > ऊपरी) { परत् असत्य; }
    संख्या म = लंबाई(खोज);
    यदि (अंत_रोध == १ && म > ० && स्थान + म == लंबाई(पंक्तियाँ)) { परत् असत्य; }
    संख्या क = ०;
    यावत् (क < म) {
        यदि (पंक्तियाँ[स्थान + क] != खोज[क]) { परत् असत्य; }
        क = क + १;
    }
    परत् सत्य;
}

// एक फाइल-अभिलेख (विभेद_पैच_पार्स का एक तत्व) को पाठ पर लगाओ। उलटा == १ हो तो patch उलटा
// लगता है (`patch -R`): फ़ाइल में "नया" पक्ष खोजकर "पुराना" पक्ष रखा जाता है।
// लौटाता है {"सफल": १/०, "पाठ": परिणाम ("" यदि विफल), "त्रुटि": "" / कारण,
//            "स्थान": [[हंक-क्रम (१ से), वास्तविक शुरू-पंक्ति (१ से), ऑफ़सेट (= वास्तविक − घोषित)], ...]}
कार्य विभेद_पैच_फाइल_लगाओ(पाठ पुराना_पाठ, शब्दकोश फाइल, संख्या उलटा) {
    सूची हंक_सूची = फाइल["हंक"];
    सूची पंक्तियाँ = विभेद_पंक्तियों_में_बाँटो(पुराना_पाठ);
    संख्या कुल = लंबाई(पंक्तियाँ);
    संख्या फाइल_अंत_बिना = विभे_अंत_बिना_है(पुराना_पाठ);
    सूची फल = [];
    सूची स्थान = [];
    संख्या हो_चुका = ०;
    संख्या नया_अंत_बिना = फाइल_अंत_बिना;
    पाठ त्रुटि = "";
    संख्या क = ०;
    यावत् (त्रुटि == "" && क < लंबाई(हंक_सूची)) {
        शब्दकोश ह = हंक_सूची[क];
        सूची ओप = ह["ओप"];
        सूची खोज = विभेद_से_पुराना(ओप);
        सूची बदल = विभेद_से_नया(ओप);
        संख्या घोषित = ह["पु_शुरू"];
        संख्या खोज_बिना = ह["पु_अंत_बिना"];
        संख्या बदल_बिना = ह["न_अंत_बिना"];
        यदि (उलटा == १) {
            खोज = विभेद_से_नया(ओप);
            बदल = विभेद_से_पुराना(ओप);
            घोषित = ह["न_शुरू"];
            खोज_बिना = ह["न_अंत_बिना"];
            बदल_बिना = ह["पु_अंत_बिना"];
        }
        संख्या म = लंबाई(खोज);
        // अनुमानित जगह (० से गिनकर): घोषित शुरू १ से गिना जाता; खाली खोज (केवल डालना) में
        // शुरू "उससे पहली पंक्ति" होती है, यानी डालने की जगह ठीक वही संख्या
        संख्या अनुमान = घोषित - १;
        यदि (म == ०) { अनुमान = घोषित; }
        यदि (घोषित == ०) { अनुमान = ०; }
        संख्या केंद्र = अनुमान;
        यदि (केंद्र < ०) { केंद्र = ०; }
        यदि (केंद्र > कुल) { केंद्र = कुल; }
        संख्या अंत_रोध = ०;
        यदि (फाइल_अंत_बिना == १ && खोज_बिना == ०) { अंत_रोध = १; }
        संख्या ऊपरी = कुल - म;
        संख्या मिला = -१;
        संख्या सीमा = कुल + १;
        यदि (घोषित == ०) { सीमा = ०; }
        संख्या दूरी = ०;
        यावत् (मिला < ० && दूरी <= सीमा) {
            संख्या आगे = केंद्र + दूरी;
            यदि (विभे_उम्मीदवार(पंक्तियाँ, आगे, खोज, हो_चुका, ऊपरी, अंत_रोध)) { मिला = आगे; }
            यदि (मिला < ० && दूरी > ०) {
                संख्या पीछे = केंद्र - दूरी;
                यदि (विभे_उम्मीदवार(पंक्तियाँ, पीछे, खोज, हो_चुका, ऊपरी, अंत_रोध)) { मिला = पीछे; }
            }
            दूरी = दूरी + १;
        }
        यदि (मिला < ०) {
            त्रुटि = "हंक " + (क + १) + ": संदर्भ फ़ाइल से मेल नहीं खाता (घोषित पंक्ति " + घोषित + ")";
        } अन्यथा {
            संख्या ख = हो_चुका;
            यावत् (ख < मिला) {
                फल = जोड़ें(फल, पंक्तियाँ[ख]);
                ख = ख + १;
            }
            ख = ०;
            यावत् (ख < लंबाई(बदल)) {
                फल = जोड़ें(फल, बदल[ख]);
                ख = ख + १;
            }
            हो_चुका = मिला + म;
            यदि (हो_चुका == कुल) {
                नया_अंत_बिना = ०;
                यदि (लंबाई(बदल) > ०) { नया_अंत_बिना = बदल_बिना; }
            }
            स्थान = जोड़ें(स्थान, [क + १, मिला + १, मिला - अनुमान]);
        }
        क = क + १;
    }
    यदि (त्रुटि == "") {
        संख्या ख = हो_चुका;
        यावत् (ख < कुल) {
            फल = जोड़ें(फल, पंक्तियाँ[ख]);
            ख = ख + १;
        }
    }
    यदि (त्रुटि != "") {
        शब्दकोश निष्फल = {"सफल": ०, "पाठ": "", "त्रुटि": त्रुटि, "स्थान": स्थान};
        परत् निष्फल;
    }
    पाठ परिणाम = विभे_पंक्तियाँ_जोड़ो(फल, नया_अंत_बिना);
    शब्दकोश सफलता = {"सफल": १, "पाठ": परिणाम, "त्रुटि": "", "स्थान": स्थान};
    परत् सफलता;
}

// एक-फाइल patch लगाना (उलटा == १ → उलटा); विफल हो तो शून्यम्
कार्य विभे_पैच_एकल(पाठ पाठ_इनपुट, पाठ पैच, संख्या उलटा) {
    शब्दकोश वाचित = विभे_पैच_वाचन(पैच);
    पाठ वाचन_त्रुटि = वाचित["त्रुटि"];
    यदि (वाचन_त्रुटि != "") { परत् शून्यम्; }
    सूची फाइलें = वाचित["फाइलें"];
    यदि (लंबाई(फाइलें) == ०) { परत् पाठ_इनपुट; }
    यदि (लंबाई(फाइलें) > १) { परत् शून्यम्; }
    शब्दकोश फाइल = फाइलें[०];
    शब्दकोश र = विभेद_पैच_फाइल_लगाओ(पाठ_इनपुट, फाइल, उलटा);
    संख्या सफल = र["सफल"];
    यदि (सफल == ०) { परत् शून्यम्; }
    परत् र["पाठ"];
}

// एकीकृत-diff patch (`diff -u` / `git diff` का एक-फाइल पाठ) पुराने पाठ पर लगाओ → नया पाठ।
// patch बिगड़ा हो, बहु-फाइल हो या संदर्भ न मिले तो शून्यम् (कारण चाहिए तो `विभेद_पैच_पार्स` +
// `विभेद_पैच_फाइल_लगाओ`)। खाली patch → पाठ जैसा का तैसा।
कार्य विभेद_पैच_लगाओ(पाठ पुराना_पाठ, पाठ पैच) {
    परत् विभे_पैच_एकल(पुराना_पाठ, पैच, ०);
}

// patch उलटा लगाओ (`patch -R`): नए पाठ से पुराना पाठ वापस। विफल हो तो शून्यम्
कार्य विभेद_पैच_उलटा_लगाओ(पाठ नया_पाठ, पाठ पैच) {
    परत् विभे_पैच_एकल(नया_पाठ, पैच, १);
}
