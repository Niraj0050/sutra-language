// ---- padding (FIPS 180-4 §5.1.1) ----

कार्य श256_पैड(सूची बाइट्स) {
    संख्या मूल_लं = लंबाई(बाइट्स);
    संख्या बिट_लं = मूल_लं * ८;
    सूची प = बाइट्स;
    प = जोड़ें(प, १२८);
    यावत् ((लंबाई(प) % ६४) != ५६) {
        प = जोड़ें(प, ०);
    }
    संख्या इ = ७;
    यावत् (इ >= ०) {
        संख्या बाइट = ०;
        यदि (इ < ४) { बाइट = बिट_और(दक्षिण_सरक(बिट_लं, इ * ८), २५५); }
        प = जोड़ें(प, बाइट);
        इ = इ - १;
    }
    परत् प;
}

// ---- हेक्स-प्रारूपण ----

कार्य श256_निबल_अक्षर(संख्या अंक) {
    यदि (अंक < १०) { परत् अक्षर_निर्माण(४८ + अंक); }
    परत् अक्षर_निर्माण(९७ + (अंक - १०));
}
कार्य श256_हेक्स8(संख्या मूल्य) {
    पाठ फल = "";
    संख्या इ = ७;
    यावत् (इ >= ०) {
        संख्या अंक = बिट_और(दक्षिण_सरक(मूल्य, इ * ४), १५);
        फल = फल + श256_निबल_अक्षर(अंक);
        इ = इ - १;
    }
    परत् फल;
}

// ---- एक 64-बाइट ब्लॉक संसाधित करो — ह (सूची of 8) को in-place अद्यतन ----

कार्य श256_ब्लॉक_चलाओ(सूची ह, सूची ब्लॉक, संख्या आरंभ, सूची क) {
    // संदेश-अनुसूची: W[0..15] बड़े-एंडियन 32-बिट शब्द, फिर W[16..63] विस्तार
    सूची डब्ल्यू = [];
    संख्या इ = ०;
    यावत् (इ < १६) {
        संख्या ऑ = आरंभ + इ * ४;
        संख्या शब्द = बाम_सरक(ब्लॉक[ऑ], २४) + बाम_सरक(ब्लॉक[ऑ + १], १६)
                    + बाम_सरक(ब्लॉक[ऑ + २], ८) + ब्लॉक[ऑ + ३];
        डब्ल्यू = जोड़ें(डब्ल्यू, शब्द);
        इ = इ + १;
    }
    यावत् (इ < ६४) {
        डब्ल्यू = जोड़ें(डब्ल्यू, ०);
        इ = इ + १;
    }
    इ = १६;
    यावत् (इ < ६४) {
        संख्या स1 = श256_सिग्मा1(डब्ल्यू[इ - २]);
        संख्या स0 = श256_सिग्मा0(डब्ल्यू[इ - १५]);
        डब्ल्यू[इ] = श256_जोड़32(श256_जोड़32(स1, डब्ल्यू[इ - ७]), श256_जोड़32(स0, डब्ल्यू[इ - १६]));
        इ = इ + १;
    }

    संख्या अ = ह[०];
    संख्या ब = ह[१];
    संख्या स = ह[२];
    संख्या द = ह[३];
    संख्या य = ह[४];
    संख्या फ = ह[५];
    संख्या ज = ह[६];
    संख्या हा = ह[७];

    इ = ०;
    यावत् (इ < ६४) {
        संख्या टी1 = श256_जोड़32(हा, श256_बसिग्मा1(य));
        टी1 = श256_जोड़32(टी1, श256_च(य, फ, ज));
        टी1 = श256_जोड़32(टी1, क[इ]);
        टी1 = श256_जोड़32(टी1, डब्ल्यू[इ]);
        संख्या टी2 = श256_जोड़32(श256_बसिग्मा0(अ), श256_माज(अ, ब, स));

        हा = ज;
        ज = फ;
        फ = य;
        य = श256_जोड़32(द, टी1);
        द = स;
        स = ब;
        ब = अ;
        अ = श256_जोड़32(टी1, टी2);

        इ = इ + १;
    }

    ह[०] = श256_जोड़32(ह[०], अ);
    ह[१] = श256_जोड़32(ह[१], ब);
    ह[२] = श256_जोड़32(ह[२], स);
    ह[३] = श256_जोड़32(ह[३], द);
    ह[४] = श256_जोड़32(ह[४], य);
    ह[५] = श256_जोड़32(ह[५], फ);
    ह[६] = श256_जोड़32(ह[६], ज);
    ह[७] = श256_जोड़32(ह[७], हा);
    परत् ०;
}

// ---- सार्वजनिक API ----

// SHA-256 हैश — लौटाता है 64-अक्षर लोअरकेस हेक्स पाठ
कार्य एसएचए256_हैश(पाठ स्रोत) {
    सूची बाइट्स = श256_पैड(श256_यूटीएफ8_एन्कोड(स्रोत));
    सूची ह = श256_आरंभिक_ह();
    सूची क = श256_क_सारणी();

    संख्या लं = लंबाई(बाइट्स);
    संख्या आरंभ = ०;
    यावत् (आरंभ < लं) {
        श256_ब्लॉक_चलाओ(ह, बाइट्स, आरंभ, क);
        आरंभ = आरंभ + ६४;
    }

    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < ८) {
        फल = फल + श256_हेक्स8(ह[इ]);
        इ = इ + १;
    }
    परत् फल;
}
