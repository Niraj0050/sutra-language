// ---- padding (FIPS 180-4 §5.1.1) ----

कार्य श256_पैड(सूची बाइट्स) {
    संख्या मूल_लं = लंबाई(बाइट्स);
    संख्या बिट_लं = मूल_लं * 8;
    सूची प = बाइट्स;
    प = जोड़ें(प, 128);
    यावत् ((लंबाई(प) % 64) != 56) {
        प = जोड़ें(प, 0);
    }
    संख्या इ = 7;
    यावत् (इ >= 0) {
        संख्या बाइट = 0;
        यदि (इ < 4) { बाइट = बिट_और(दक्षिण_सरक(बिट_लं, इ * 8), 255); }
        प = जोड़ें(प, बाइट);
        इ = इ - 1;
    }
    परत् प;
}

// ---- हेक्स-प्रारूपण ----

कार्य श256_निबल_अक्षर(संख्या अंक) {
    यदि (अंक < 10) { परत् अक्षर_निर्माण(48 + अंक); }
    परत् अक्षर_निर्माण(97 + (अंक - 10));
}
कार्य श256_हेक्स8(संख्या मूल्य) {
    पाठ फल = "";
    संख्या इ = 7;
    यावत् (इ >= 0) {
        संख्या अंक = बिट_और(दक्षिण_सरक(मूल्य, इ * 4), 15);
        फल = फल + श256_निबल_अक्षर(अंक);
        इ = इ - 1;
    }
    परत् फल;
}

// ---- एक 64-बाइट ब्लॉक संसाधित करो — ह (सूची of 8) को in-place अद्यतन ----

कार्य श256_ब्लॉक_चलाओ(सूची ह, सूची ब्लॉक, संख्या आरंभ, सूची क) {
    // संदेश-अनुसूची: W[0..15] बड़े-एंडियन 32-बिट शब्द, फिर W[16..63] विस्तार
    सूची डब्ल्यू = [];
    संख्या इ = 0;
    यावत् (इ < 16) {
        संख्या ऑ = आरंभ + इ * 4;
        संख्या शब्द = बाम_सरक(ब्लॉक[ऑ], 24) + बाम_सरक(ब्लॉक[ऑ + 1], 16)
                    + बाम_सरक(ब्लॉक[ऑ + 2], 8) + ब्लॉक[ऑ + 3];
        डब्ल्यू = जोड़ें(डब्ल्यू, शब्द);
        इ = इ + 1;
    }
    यावत् (इ < 64) {
        डब्ल्यू = जोड़ें(डब्ल्यू, 0);
        इ = इ + 1;
    }
    इ = 16;
    यावत् (इ < 64) {
        संख्या स1 = श256_सिग्मा1(डब्ल्यू[इ - 2]);
        संख्या स0 = श256_सिग्मा0(डब्ल्यू[इ - 15]);
        डब्ल्यू[इ] = श256_जोड़32(श256_जोड़32(स1, डब्ल्यू[इ - 7]), श256_जोड़32(स0, डब्ल्यू[इ - 16]));
        इ = इ + 1;
    }

    संख्या अ = ह[0];
    संख्या ब = ह[1];
    संख्या स = ह[2];
    संख्या द = ह[3];
    संख्या य = ह[4];
    संख्या फ = ह[5];
    संख्या ज = ह[6];
    संख्या हा = ह[7];

    इ = 0;
    यावत् (इ < 64) {
        संख्या टी1 = श256_जोड़32(हा, श256_बसिग्मा1(य));
        टी1 = श256_जोड़32(टी1, श256_च(य, फ, ज));
        टी1 = श256_जोड़32(टी1, क[इ]);
        टी1 = श256_जोड़32(टी1, डब्ल्यू[इ]);
        संख्या टी2 = श256_जोड़32(श256_बसिग्मा0(अ), श256_माज(अ, ब, स));

        हा = ज;
        ज = फ;
        फ = य;
        य = श256_जोड़32(द, टी1);
        द = स;
        स = ब;
        ब = अ;
        अ = श256_जोड़32(टी1, टी2);

        इ = इ + 1;
    }

    ह[0] = श256_जोड़32(ह[0], अ);
    ह[1] = श256_जोड़32(ह[1], ब);
    ह[2] = श256_जोड़32(ह[2], स);
    ह[3] = श256_जोड़32(ह[3], द);
    ह[4] = श256_जोड़32(ह[4], य);
    ह[5] = श256_जोड़32(ह[5], फ);
    ह[6] = श256_जोड़32(ह[6], ज);
    ह[7] = श256_जोड़32(ह[7], हा);
    परत् 0;
}

// ---- सार्वजनिक API ----

// SHA-256 हैश — लौटाता है 64-अक्षर लोअरकेस हेक्स पाठ
कार्य एसएचए256_हैश(पाठ स्रोत) {
    सूची बाइट्स = श256_पैड(श256_यूटीएफ8_एन्कोड(स्रोत));
    सूची ह = श256_आरंभिक_ह();
    सूची क = श256_क_सारणी();

    संख्या लं = लंबाई(बाइट्स);
    संख्या आरंभ = 0;
    यावत् (आरंभ < लं) {
        श256_ब्लॉक_चलाओ(ह, बाइट्स, आरंभ, क);
        आरंभ = आरंभ + 64;
    }

    पाठ फल = "";
    संख्या इ = 0;
    यावत् (इ < 8) {
        फल = फल + श256_हेक्स8(ह[इ]);
        इ = इ + 1;
    }
    परत् फल;
}
