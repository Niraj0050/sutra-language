// पुस्तकालय/एसएचए256.सूत्र — SHA-256 (FIPS 180-4) क्रिप्टोग्राफ़िक हैश
// ============================================================
// आयात "पुस्तकालय/एसएचए256.सूत्र";
//
//   एसएचए256_हैश("")        // "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b85"
//   एसएचए256_हैश("abc")     // "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"[64]
//
// FIPS 180-4 का सटीक, प्रकाशित गणित-विनिर्देश यहाँ है — इसमें कोई
// "डिज़ाइन-स्वतंत्रता" नहीं (हर bit-operation मानक तय करता), इसलिए
// "मौलिकता" का मतलब यहाँ: किसी और की SOURCE CODE कॉपी/अनुवाद नहीं की —
// विनिर्देश की गणित सीधे Sutra में लिखी। प्रकाशित test-vectors ("" और
// "abc" के जाने-माने हैश) से जाँच होती, किसी लाइब्रेरी से तुलना नहीं।
//
// तरीका: पाठ को UTF-8 बाइट्स में मैन्युअल रूप से encode करते (Sutra का
// उपखंड/लंबाई codepoint-स्तर पर काम करता, byte-स्तर पर नहीं — इसलिए
// hashing हमेशा standard-सुसंगत रहने के लिए खुद UTF-8 encode करना ज़रूरी,
// नहीं तो Devanagari जैसे बहु-बाइट पाठ का हैश sha256sum से मेल न खाता)।
// फिर मानक padding + 64-बाइट ब्लॉकों पर संपीड़न फलन। 32-बिट गणित Sutra के
// 64-बिट संख्या पर हर जोड़/rotate के बाद निचले 32 बिट पर मास्क करके।
//
// नोट: बिट_और/बिट_या/बिट_भेद फलन-कॉल हैं (`बिट_और(अ, ब)`), infix operator
// नहीं — Sutra में यही इनका syntax है (देखो मूल_रनटाइम.सूत्र का उपयोग)।
// ============================================================

// ---- UTF-8 एन्कोडिंग (शुद्ध Sutra — कोई FFI नहीं, तीनों backend पर चलता) ----

कार्य श256_यूटीएफ8_एन्कोड(पाठ स्रोत) {
    सूची बाइट्स = [];
    संख्या इ = 0;
    संख्या लं = लंबाई(स्रोत);
    यावत् (इ < लं) {
        संख्या कोड = अक्षर_मान(उपखंड(स्रोत, इ, इ + 1));
        यदि (कोड < 128) {
            बाइट्स = जोड़ें(बाइट्स, कोड);
        } अन्यथा यदि (कोड < 2048) {
            बाइट्स = जोड़ें(बाइट्स, 192 + दक्षिण_सरक(कोड, 6));
            बाइट्स = जोड़ें(बाइट्स, 128 + बिट_और(कोड, 63));
        } अन्यथा यदि (कोड < 65536) {
            बाइट्स = जोड़ें(बाइट्स, 224 + दक्षिण_सरक(कोड, 12));
            बाइट्स = जोड़ें(बाइट्स, 128 + बिट_और(दक्षिण_सरक(कोड, 6), 63));
            बाइट्स = जोड़ें(बाइट्स, 128 + बिट_और(कोड, 63));
        } अन्यथा {
            बाइट्स = जोड़ें(बाइट्स, 240 + दक्षिण_सरक(कोड, 18));
            बाइट्स = जोड़ें(बाइट्स, 128 + बिट_और(दक्षिण_सरक(कोड, 12), 63));
            बाइट्स = जोड़ें(बाइट्स, 128 + बिट_और(दक्षिण_सरक(कोड, 6), 63));
            बाइट्स = जोड़ें(बाइट्स, 128 + बिट_और(कोड, 63));
        }
        इ = इ + 1;
    }
    परत् बाइट्स;
}

// ---- 32-बिट गणित सहायक (Sutra संख्या 64-बिट है, हर संक्रिया के बाद मास्क) ----

कार्य श256_मास्क32() { परत् बाम_सरक(1, 32) - 1; }   // 0xFFFFFFFF — literal नहीं, गणना से

कार्य श256_जोड़32(संख्या अ, संख्या ब) {
    परत् बिट_और(अ + ब, श256_मास्क32());
}
कार्य श256_नहीं32(संख्या अ) {
    परत् बिट_और(बिट_उलट(अ), श256_मास्क32());
}
कार्य श256_रोटर(संख्या अ, संख्या गिनती) {
    संख्या बाएँ = दक्षिण_सरक(अ, गिनती);
    संख्या दाएँ = बिट_और(बाम_सरक(अ, 32 - गिनती), श256_मास्क32());
    परत् बिट_या(बाएँ, दाएँ);
}
कार्य श256_शिफ्ट_दायाँ(संख्या अ, संख्या गिनती) { परत् दक्षिण_सरक(अ, गिनती); }

// संदेश-अनुसूची विस्तार के sigma
कार्य श256_सिग्मा0(संख्या अ) {
    परत् बिट_भेद(बिट_भेद(श256_रोटर(अ, 7), श256_रोटर(अ, 18)), श256_शिफ्ट_दायाँ(अ, 3));
}
कार्य श256_सिग्मा1(संख्या अ) {
    परत् बिट_भेद(बिट_भेद(श256_रोटर(अ, 17), श256_रोटर(अ, 19)), श256_शिफ्ट_दायाँ(अ, 10));
}
// संपीड़न-फलन के बड़े-Sigma
कार्य श256_बसिग्मा0(संख्या अ) {
    परत् बिट_भेद(बिट_भेद(श256_रोटर(अ, 2), श256_रोटर(अ, 13)), श256_रोटर(अ, 22));
}
कार्य श256_बसिग्मा1(संख्या अ) {
    परत् बिट_भेद(बिट_भेद(श256_रोटर(अ, 6), श256_रोटर(अ, 11)), श256_रोटर(अ, 25));
}
कार्य श256_च(संख्या अ, संख्या ब, संख्या स) {
    परत् बिट_भेद(बिट_और(अ, ब), बिट_और(श256_नहीं32(अ), स));
}
कार्य श256_माज(संख्या अ, संख्या ब, संख्या स) {
    परत् बिट_भेद(बिट_भेद(बिट_और(अ, ब), बिट_और(अ, स)), बिट_और(ब, स));
}

