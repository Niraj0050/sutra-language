// पुस्तकालय/महासंख्या.सूत्र — मनमाने आकार के पूर्णांक (arbitrary-precision)
// ============================================================
// आयात "पुस्तकालय/महासंख्या.सूत्र";
//
//   शब्दकोश अ = महासंख्या_बनाओ(१२३४५);
//   शब्दकोश ब = महासंख्या_पाठ_से("९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९९");
//   पाठ स = महासंख्या_से_पाठ(महासंख्या_गुणा(अ, ब));
//   शब्दकोश फै = महासंख्या_गुणनखंड(५०);               // ५०! (देशी संख्या में नहीं समाता)
//   शब्दकोश गु = महासंख्या_घात_मॉड(आधार, घातांक, मापांक); // RSA-शैली modexp
//
// देशी `संख्या` ६४-बिट है, पर स्रोत-साहित्य २³¹ से ऊपर लिखा नहीं जा सकता —
// महासंख्या उस सीमा से परे बड़े पूर्णांकों के लिए है: गुणनखंड, modular
// घातांक, संयोजिकी (combinatorics), आदि।
//
// आंतरिक निरूपण: {"चिह्न": १ या -१, "अंक": सूची} — "अंक" आधार-१०⁹ के
// अंक-समूह (limb) की सूची है, सबसे कम-महत्वपूर्ण पहले (little-endian)।
// शून्य सदा {चिह्न: १, अंक: [०]}; सामान्यीकृत रूप में सबसे ऊपरी अंक-समूह
// कभी ० नहीं (सिवाय स्वयं शून्य के)। एक बार लौटाई गई कोई भी "अंक" सूची
// कभी इन-प्लेस नहीं बदली जाती — इसलिए दो महासंख्या मानों के बीच इसे
// साझा करना सुरक्षित है (सूत्र में सूची/शब्दकोश संदर्भ-अर्थ के होते हैं)।
//
// पाठ-रूपांतरण (महासंख्या_से_पाठ/महासंख्या_पाठ_से) देवनागरी अंकों में है —
// यह "हमारा अपना" संख्या-निरूपण है, किसी बाहरी मानक की तरह नहीं (SHA-256
// hex/UUID जैसा), इसलिए देवनागरी नियम यहाँ लागू होता है। ⚠️ देशी
// `"" + संख्या` concatenation ARABIC अंक देता है (रनटाइम-आंतरिक व्यवहार,
// स्रोत-साहित्य की लिपि से स्वतंत्र) — इसीलिए यह मॉड्यूल अंकों को खुद
// `अक्षर_निर्माण`/`अक्षर_मान` से बनाता/पढ़ता है, सीधे "" + पर निर्भर नहीं।
//
// भाग/शेष का चिह्न-नियम देशी `/`/`%` से मेल खाता है (जाँचा गया): भागफल ०
// की ओर छाँटा (truncate) जाता, शेष सदा भाज्य (dividend) का चिह्न लेता है।
//
// प्रदर्शन: स्कूली (schoolbook) गुणा O(n·m), भाग द्विआधारी-खोज वाला लंबा
// भाग O(n·m·log(आधार)) — सामान्य उपयोग के लिए पर्याप्त, क्रिप्टो-स्तरीय
// (RSA-4096 जैसा) प्रदर्शन का लक्ष्य नहीं।
// ============================================================

// ===== स्थिरांक =====
संख्या महा_आधार = १०००००००००;                // आधार 10^9 प्रति अंक-समूह
संख्या महा_आधार_अंक = ९;                      // प्रति अंक-समूह दशमलव-अंक गिनती
संख्या महा_देव_शून्य_कोड = २४०६;               // देवनागरी '०' का यूनिकोड कोडबिंदु (U+0966)

// ===== आंतरिक: परिमाण (चिह्न-रहित अंक-समूह सूची) सहायक =====

कार्य महा_परि_शून्य_है(सूची अ) {
    परत् लंबाई(अ) == १ && अ[०] == ०;
}

// सबसे ऊपरी शून्य अंक-समूह हटाओ (कम-से-कम एक अंक-समूह रहता है)
कार्य महा_परि_सामान्य(सूची अ) {
    संख्या गण = लंबाई(अ);
    यावत् (गण > १ && अ[गण - १] == ०) {
        गण = गण - १;
    }
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < गण) {
        फल = जोड़ें(फल, अ[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// परिमाण-तुलना: -१/०/१ (दोनों सामान्यीकृत मानकर)
कार्य महा_परि_तुलना(सूची अ, सूची ब) {
    यदि (लंबाई(अ) != लंबाई(ब)) {
        यदि (लंबाई(अ) < लंबाई(ब)) { परत् -१; }
        परत् १;
    }
    संख्या इ = लंबाई(अ) - १;
    यावत् (इ >= ०) {
        यदि (अ[इ] != ब[इ]) {
            यदि (अ[इ] < ब[इ]) { परत् -१; }
            परत् १;
        }
        इ = इ - १;
    }
    परत् ०;
}

// परिमाण जोड़ (ripple-carry)
कार्य महा_परि_जोड़(सूची अ, सूची ब) {
    सूची फल = [];
    संख्या ले = अधिकतम(लंबाई(अ), लंबाई(ब));
    संख्या ऋण = ०;
    संख्या इ = ०;
    यावत् (इ < ले) {
        संख्या अंश_अ = ०;
        यदि (इ < लंबाई(अ)) { अंश_अ = अ[इ]; }
        संख्या अंश_ब = ०;
        यदि (इ < लंबाई(ब)) { अंश_ब = ब[इ]; }
        संख्या य = अंश_अ + अंश_ब + ऋण;
        फल = जोड़ें(फल, य % महा_आधार);
        ऋण = य / महा_आधार;
        इ = इ + १;
    }
    यदि (ऋण > ०) { फल = जोड़ें(फल, ऋण); }
    परत् फल;
}

// परिमाण घटाव — शर्त: अ >= ब (परिमाण में), वरना ग़लत परिणाम
कार्य महा_परि_घटाओ(सूची अ, सूची ब) {
    सूची फल = [];
    संख्या उधार = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        संख्या अंश_अ = अ[इ];
        संख्या अंश_ब = ०;
        यदि (इ < लंबाई(ब)) { अंश_ब = ब[इ]; }
        संख्या य = अंश_अ - अंश_ब - उधार;
        यदि (य < ०) {
            य = य + महा_आधार;
            उधार = १;
        } अन्यथा {
            उधार = ०;
        }
        फल = जोड़ें(फल, य);
        इ = इ + १;
    }
    परत् महा_परि_सामान्य(फल);
}

// परिमाण × देशी लघु-मान (०..आधार-१) — भाग के भीतर द्विआधारी-खोज हेतु
कार्य महा_परि_गुणा_लघु(सूची अ, संख्या ग) {
    यदि (ग == ०) { परत् [०]; }
    सूची फल = [];
    संख्या ऋण = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        संख्या हल = अ[इ] * ग + ऋण;
        फल = जोड़ें(फल, हल % महा_आधार);
        ऋण = हल / महा_आधार;
        इ = इ + १;
    }
    यावत् (ऋण > ०) {
        फल = जोड़ें(फल, ऋण % महा_आधार);
        ऋण = ऋण / महा_आधार;
    }
    परत् महा_परि_सामान्य(फल);
}

// परिमाण × परिमाण — स्कूली गुणा, हर आंतरिक-लूप चरण के बाद उधार आगे बढ़ता
// (ताकि किसी भी सेल में जमा राशि ६४-बिट सीमा के पास न पहुँचे)
कार्य महा_परि_गुणा(सूची अ, सूची ब) {
    यदि (महा_परि_शून्य_है(अ) || महा_परि_शून्य_है(ब)) { परत् [०]; }
    संख्या लंअ = लंबाई(अ);
    संख्या लंब = लंबाई(ब);
    सूची फल = [];
    संख्या कुल = लंअ + लंब;
    संख्या भरो = ०;
    यावत् (भरो < कुल) {
        फल = जोड़ें(फल, ०);
        भरो = भरो + १;
    }
    संख्या इ = ०;
    यावत् (इ < लंअ) {
        संख्या ऋण = ०;
        संख्या ज = ०;
        यावत् (ज < लंब) {
            संख्या हल = फल[इ + ज] + अ[इ] * ब[ज] + ऋण;
            फल[इ + ज] = हल % महा_आधार;
            ऋण = हल / महा_आधार;
            ज = ज + १;
        }
        संख्या क = इ + लंब;
        यावत् (ऋण > ०) {
            संख्या हल = फल[क] + ऋण;
            फल[क] = हल % महा_आधार;
            ऋण = हल / महा_आधार;
            क = क + १;
        }
        इ = इ + १;
    }
    परत् महा_परि_सामान्य(फल);
}

// परिमाण लंबा-भाग: अ ÷ ब → {भागफल, शेष} (दोनों परिमाण-सूची, ब अशून्य)
// अंक-समूह-दर-अंक-समूह (आधार-१०⁹ "अंक"), हर चरण में भागफल-अंक-समूह
// द्विआधारी-खोज से ढूँढा जाता (Knuth Algorithm D जैसी जटिलता से बचने को)
कार्य महा_परि_भाग(सूची अ, सूची ब) {
    यदि (महा_परि_तुलना(अ, ब) < ०) {
        शब्दकोश फल = {};
        फल["भागफल"] = [०];
        फल["शेष"] = अ;
        परत् फल;
    }
    सूची भागफल_उल्टा = [];
    सूची शेष_अब = [०];
    संख्या इ = लंबाई(अ) - १;
    यावत् (इ >= ०) {
        सूची शि = महा_परि_गुणा_लघु(शेष_अब, महा_आधार);
        शेष_अब = महा_परि_जोड़(शि, [अ[इ]]);
        संख्या नि = ०;
        संख्या ऊ = महा_आधार - १;
        संख्या क = ०;
        यावत् (नि <= ऊ) {
            संख्या म = (नि + ऊ) / २;
            सूची कोशिश = महा_परि_गुणा_लघु(ब, म);
            यदि (महा_परि_तुलना(कोशिश, शेष_अब) <= ०) {
                क = म;
                नि = म + १;
            } अन्यथा {
                ऊ = म - १;
            }
        }
        भागफल_उल्टा = जोड़ें(भागफल_उल्टा, क);
        शेष_अब = महा_परि_घटाओ(शेष_अब, महा_परि_गुणा_लघु(ब, क));
        इ = इ - १;
    }
    सूची भागफल = [];
    संख्या ज = लंबाई(भागफल_उल्टा) - १;
    यावत् (ज >= ०) {
        भागफल = जोड़ें(भागफल, भागफल_उल्टा[ज]);
        ज = ज - १;
    }
    शब्दकोश फल = {};
    फल["भागफल"] = महा_परि_सामान्य(भागफल);
    फल["शेष"] = शेष_अब;
    परत् फल;
}

// एक अंक-मान (०-९) → देवनागरी अंक-अक्षर
कार्य महा_अंक_अक्षर(संख्या द) {
    परत् अक्षर_निर्माण(महा_देव_शून्य_कोड + द);
}

// मू (मू > ०) में कितने दशमलव-अंक हैं
कार्य महा_अंक_गणना(संख्या मू) {
    संख्या ग = ०;
    संख्या श = मू;
    यावत् (श > ०) {
        ग = ग + १;
        श = श / १०;
    }
    यदि (ग == ०) { परत् १; }
    परत् ग;
}

// मू → देवनागरी-अंक पाठ, चौड़ाई तक शून्य से बायीं ओर भरा हुआ
कार्य महा_सीमा_पाठ(संख्या मू, संख्या चौड़ाई) {
    पाठ फल = "";
    संख्या श = मू;
    संख्या इ = ०;
    यावत् (इ < चौड़ाई) {
        फल = महा_अंक_अक्षर(श % १०) + फल;
        श = श / १०;
        इ = इ + १;
    }
    परत् फल;
}

// ===== निर्माण / रूपांतरण =====

कार्य महासंख्या_शून्य() {
    शब्दकोश फल = {};
    फल["चिह्न"] = १;
    फल["अंक"] = [०];
    परत् फल;
}

// देशी संख्या से बनाओ
कार्य महासंख्या_बनाओ(संख्या क) {
    यदि (क == ०) { परत् महासंख्या_शून्य(); }
    संख्या चि = १;
    संख्या श = क;
    यदि (श < ०) {
        चि = -१;
        श = ० - श;
    }
    सूची अंक = [];
    यावत् (श > ०) {
        अंक = जोड़ें(अंक, श % महा_आधार);
        श = श / महा_आधार;
    }
    शब्दकोश फल = {};
    फल["चिह्न"] = चि;
    फल["अंक"] = अंक;
    परत् फल;
}

// देशी संख्या में वापस — सिर्फ़ तभी जब |मान| < १०^१८ (दो अंक-समूह),
// वरना त्रुटि (silent truncation से बेहतर स्पष्ट असफलता)
कार्य महासंख्या_से_संख्या(शब्दकोश अ) {
    यदि (लंबाई(अ["अंक"]) > २) {
        प्रक्षेपः "त्रुटिः — महासंख्या: देशी संख्या में समाता नहीं (>= 10^18)";
    }
    संख्या मू = ०;
    संख्या इ = लंबाई(अ["अंक"]) - १;
    यावत् (इ >= ०) {
        मू = मू * महा_आधार + अ["अंक"][इ];
        इ = इ - १;
    }
    परत् अ["चिह्न"] * मू;
}

// देवनागरी दशमलव-पाठ से बनाओ (वैकल्पिक अगुआ "-")
कार्य महासंख्या_पाठ_से(पाठ स) {
    संख्या शुरू = ०;
    संख्या चि = १;
    यदि (लंबाई(स) > ० && उपखंड(स, ०, १) == "-") {
        चि = -१;
        शुरू = १;
    }
    यदि (शुरू >= लंबाई(स)) {
        प्रक्षेपः "त्रुटिः — महासंख्या: रिक्त अंक-पाठ";
    }
    शब्दकोश फल = महासंख्या_शून्य();
    शब्दकोश दस = महासंख्या_बनाओ(१०);
    संख्या इ = शुरू;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        संख्या कोड = अक्षर_मान(च);
        संख्या द = कोड - महा_देव_शून्य_कोड;
        यदि (द < ० || द > ९) {
            प्रक्षेपः "त्रुटिः — महासंख्या: अमान्य अंक '" + च + "' (देवनागरी ०-९ चाहिए)";
        }
        फल = महासंख्या_जोड़(महासंख्या_गुणा(फल, दस), महासंख्या_बनाओ(द));
        इ = इ + १;
    }
    यदि (चि == -१ && न महासंख्या_शून्य_है(फल)) {
        फल["चिह्न"] = -१;
    }
    परत् फल;
}

// देवनागरी दशमलव-पाठ में बदलो
कार्य महासंख्या_से_पाठ(शब्दकोश अ) {
    संख्या न_ल = लंबाई(अ["अंक"]);
    संख्या शीर्ष = अ["अंक"][न_ल - १];
    पाठ फल = महा_सीमा_पाठ(शीर्ष, महा_अंक_गणना(शीर्ष));
    संख्या इ = न_ल - २;
    यावत् (इ >= ०) {
        फल = फल + महा_सीमा_पाठ(अ["अंक"][इ], महा_आधार_अंक);
        इ = इ - १;
    }
    यदि (अ["चिह्न"] == -१) {
        परत् "-" + फल;
    }
    परत् फल;
}

// ===== तुलना / निरीक्षण =====

कार्य महासंख्या_शून्य_है(शब्दकोश अ) {
    परत् महा_परि_शून्य_है(अ["अंक"]);
}

कार्य महासंख्या_ऋणात्मक_है(शब्दकोश अ) {
    परत् अ["चिह्न"] == -१;
}

कार्य महासंख्या_सम_है(शब्दकोश अ) {
    परत् (अ["अंक"][०] % २) == ०;
}

कार्य महासंख्या_विषम_है(शब्दकोश अ) {
    परत् (अ["अंक"][०] % २) != ०;
}

// -१ / ० / १ (अ तुलना ब से)
कार्य महासंख्या_तुलना(शब्दकोश अ, शब्दकोश ब) {
    बूल अशू = महासंख्या_शून्य_है(अ);
    बूल बशू = महासंख्या_शून्य_है(ब);
    यदि (अशू && बशू) { परत् ०; }
    यदि (अशू) { परत् ० - ब["चिह्न"]; }
    यदि (बशू) { परत् अ["चिह्न"]; }
    यदि (अ["चिह्न"] != ब["चिह्न"]) { परत् अ["चिह्न"]; }
    संख्या परि = महा_परि_तुलना(अ["अंक"], ब["अंक"]);
    यदि (अ["चिह्न"] == -१) { परत् ० - परि; }
    परत् परि;
}

कार्य महासंख्या_बराबर(शब्दकोश अ, शब्दकोश ब) {
    परत् महासंख्या_तुलना(अ, ब) == ०;
}

// ===== अंकगणित =====

कार्य महासंख्या_ऋणात्मक(शब्दकोश अ) {
    यदि (महासंख्या_शून्य_है(अ)) { परत् महासंख्या_शून्य(); }
    शब्दकोश फल = {};
    फल["चिह्न"] = ० - अ["चिह्न"];
    फल["अंक"] = अ["अंक"];
    परत् फल;
}

कार्य महासंख्या_निरपेक्ष(शब्दकोश अ) {
    शब्दकोश फल = {};
    फल["चिह्न"] = १;
    फल["अंक"] = अ["अंक"];
    परत् फल;
}

कार्य महासंख्या_जोड़(शब्दकोश अ, शब्दकोश ब) {
    यदि (अ["चिह्न"] == ब["चिह्न"]) {
        शब्दकोश फल = {};
        फल["चिह्न"] = अ["चिह्न"];
        फल["अंक"] = महा_परि_जोड़(अ["अंक"], ब["अंक"]);
        परत् फल;
    }
    संख्या परि = महा_परि_तुलना(अ["अंक"], ब["अंक"]);
    यदि (परि == ०) { परत् महासंख्या_शून्य(); }
    शब्दकोश फल = {};
    यदि (परि > ०) {
        फल["चिह्न"] = अ["चिह्न"];
        फल["अंक"] = महा_परि_घटाओ(अ["अंक"], ब["अंक"]);
    } अन्यथा {
        फल["चिह्न"] = ब["चिह्न"];
        फल["अंक"] = महा_परि_घटाओ(ब["अंक"], अ["अंक"]);
    }
    परत् फल;
}

कार्य महासंख्या_घटाओ(शब्दकोश अ, शब्दकोश ब) {
    परत् महासंख्या_जोड़(अ, महासंख्या_ऋणात्मक(ब));
}

कार्य महासंख्या_गुणा(शब्दकोश अ, शब्दकोश ब) {
    सूची परिमाण = महा_परि_गुणा(अ["अंक"], ब["अंक"]);
    यदि (महा_परि_शून्य_है(परिमाण)) { परत् महासंख्या_शून्य(); }
    शब्दकोश फल = {};
    फल["चिह्न"] = अ["चिह्न"] * ब["चिह्न"];
    फल["अंक"] = परिमाण;
    परत् फल;
}

// भागफल और शेष दोनों एक साथ (शब्दकोश{"भागफल":.., "शेष":..}) — चिह्न-नियम
// देशी /% जैसा: भागफल ० की ओर छाँटा, शेष भाज्य (अ) का चिह्न लेता है
कार्य महासंख्या_भाग_शेष(शब्दकोश अ, शब्दकोश ब) {
    यदि (महासंख्या_शून्य_है(ब)) {
        प्रक्षेपः "त्रुटिः — महासंख्या: शून्य से भाग";
    }
    शब्दकोश आं = महा_परि_भाग(अ["अंक"], ब["अंक"]);
    सूची भाप = आं["भागफल"];
    सूची शेप = आं["शेष"];
    संख्या भचि = अ["चिह्न"] * ब["चिह्न"];
    यदि (महा_परि_शून्य_है(भाप)) { भचि = १; }
    संख्या शचि = अ["चिह्न"];
    यदि (महा_परि_शून्य_है(शेप)) { शचि = १; }
    शब्दकोश भागफल = {};
    भागफल["चिह्न"] = भचि;
    भागफल["अंक"] = भाप;
    शब्दकोश शेष = {};
    शेष["चिह्न"] = शचि;
    शेष["अंक"] = शेप;
    शब्दकोश फल = {};
    फल["भागफल"] = भागफल;
    फल["शेष"] = शेष;
    परत् फल;
}

कार्य महासंख्या_भाग(शब्दकोश अ, शब्दकोश ब) {
    परत् महासंख्या_भाग_शेष(अ, ब)["भागफल"];
}

कार्य महासंख्या_शेष(शब्दकोश अ, शब्दकोश ब) {
    परत् महासंख्या_भाग_शेष(अ, ब)["शेष"];
}

// आधार^घातांक (घातांक देशी संख्या, >= ०) — वर्ग-द्वारा-घातांक (binary exponentiation)
कार्य महासंख्या_घात(शब्दकोश आधार, संख्या घातांक) {
    यदि (घातांक < ०) {
        प्रक्षेपः "त्रुटिः — महासंख्या: ऋणात्मक घातांक असमर्थित";
    }
    शब्दकोश फल = महासंख्या_बनाओ(१);
    शब्दकोश आ = आधार;
    संख्या घ = घातांक;
    यावत् (घ > ०) {
        यदि ((घ % २) == १) {
            फल = महासंख्या_गुणा(फल, आ);
        }
        आ = महासंख्या_गुणा(आ, आ);
        घ = घ / २;
    }
    परत् फल;
}

// (आधार ^ घातांक) mod मापांक — घातांक भी महासंख्या (RSA-शैली बड़े घातांकों
// के लिए), मापांक धनात्मक होना चाहिए
कार्य महासंख्या_घात_मॉड(शब्दकोश आधार, शब्दकोश घातांक, शब्दकोश मापांक) {
    यदि (महासंख्या_शून्य_है(मापांक) || महासंख्या_ऋणात्मक_है(मापांक)) {
        प्रक्षेपः "त्रुटिः — महासंख्या: मापांक धनात्मक होना चाहिए";
    }
    यदि (महासंख्या_ऋणात्मक_है(घातांक)) {
        प्रक्षेपः "त्रुटिः — महासंख्या: ऋणात्मक घातांक असमर्थित (घात_मॉड)";
    }
    यदि (महासंख्या_बराबर(मापांक, महासंख्या_बनाओ(१))) { परत् महासंख्या_शून्य(); }
    शब्दकोश फल = महासंख्या_बनाओ(१);
    शब्दकोश आ = महासंख्या_शेष(आधार, मापांक);
    यदि (महासंख्या_ऋणात्मक_है(आ)) { आ = महासंख्या_जोड़(आ, मापांक); }
    शब्दकोश घ = घातांक;
    शब्दकोश दो = महासंख्या_बनाओ(२);
    यावत् (न महासंख्या_शून्य_है(घ)) {
        यदि (महासंख्या_विषम_है(घ)) {
            फल = महासंख्या_शेष(महासंख्या_गुणा(फल, आ), मापांक);
        }
        घ = महासंख्या_भाग(घ, दो);
        आ = महासंख्या_शेष(महासंख्या_गुणा(आ, आ), मापांक);
    }
    परत् फल;
}

// क! (क देशी संख्या, >= ०)
कार्य महासंख्या_गुणनखंड(संख्या क) {
    यदि (क < ०) {
        प्रक्षेपः "त्रुटिः — महासंख्या: ऋणात्मक का गुणनखंड नहीं";
    }
    शब्दकोश फल = महासंख्या_बनाओ(१);
    संख्या इ = २;
    यावत् (इ <= क) {
        फल = महासंख्या_गुणा(फल, महासंख्या_बनाओ(इ));
        इ = इ + १;
    }
    परत् फल;
}
