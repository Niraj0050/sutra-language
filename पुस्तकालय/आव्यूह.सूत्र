// पुस्तकालय/आव्यूह.सूत्र — आव्यूह (Matrix) / रैखिक बीजगणित (linear algebra)
// ============================================================
// आयात "पुस्तकालय/आव्यूह.सूत्र";
//
//   शब्दकोश आ = आव्यूह_से_पंक्तियाँ([[1.0, 2.0], [3.0, 4.0]]);
//   शब्दकोश ब = आव्यूह_पहचान(२);
//   शब्दकोश स = आव्यूह_गुणा(आ, ब);
//   आव्यूह_पाओ(स, ०, १)                 // 2.0
//   आव्यूह_निर्धारक(आ)                  // -2.0
//   आव्यूह_व्युत्क्रम(आ)                 // आ का व्युत्क्रम
//
// निरूपण: शब्दकोश {"पंक्तियाँ", "स्तंभ", "डेटा"} — "डेटा" एक चपटी
// (flat, row-major) सूची of दशमलव है, नेस्टेड सूची-of-सूची नहीं।
// तत्व (पं,स्तं) → डेटा[पं * स्तंभ + स्तं]। कारण: इस सत्र में एक असली
// compiled-backend bug मिला — नेस्टेड सूची पर चेन्ड डबल-इंडेक्सिंग
// (`अ[i][j]`) native/`--release` दोनों पर दशमलव का raw bit-pattern
// लौटाती (असली मान नहीं) — जबकि इंटरमीडिएट नामित वेरिएबल से होकर
// अलग-अलग single-level indexing हमेशा सही चलता। इसीलिए यह पूरा
// मॉड्यूल कभी `x[i][j]` नहीं लिखता, चाहे भीतर हो या इस्तेमाल में;
// अलग background task में दर्ज।
//
// सभी अंकगणित फलन (जोड़/घटाओ/गुणा/स्थानांतरण/etc.) नया आव्यूह लौटाते,
// operand अपरिवर्तित रहते। `आव्यूह_सेट` अपवाद है — इनपुट को जगह पर
// बदलता (O(1), सूची-इंडेक्स-असाइनमेंट के ज़रिए, जिसका शब्दकोश-संदर्भ
// के through mutation-visibility इस सत्र में सीधे जाँच कर पुष्ट किया
// गया, तीनों बैकएंड पर)।
//
// ⚠️ `आव्यूह_निर्धारक`/`आव्यूह_व्युत्क्रम` recursive cofactor-expansion
// (Laplace expansion) से — गणितीय रूप से हमेशा सही (कोई
// numerical-pivoting चिंता नहीं, चूँकि division सिर्फ़ आख़िर में एक बार
// होता), पर **O(n!) समय** — छोटे आव्यूह (व्यवहारिक रूप से n ≤ 8-10) के
// लिए ही, बड़े आव्यूह के लिए नहीं (v1 सीमा, LU-decomposition/partial-
// pivoting जानबूझकर स्कोप से बाहर — सरलता प्राथमिकता, [[आलेख]] के
// O(V²) डिज्क्स्ट्रा जैसा ही व्यापार)।
// ============================================================

// ===== आंतरिक =====

// (पं,स्तं) को हटाकर बना (गण-1)×(गण-1) उप-आव्यूह — निर्धारक/व्युत्क्रम में इस्तेमाल
कार्य आ_उप_आव्यूह(शब्दकोश आ, संख्या हटा_पं, संख्या हटा_स्तं) {
    संख्या गण = आव्यूह_पंक्ति_गिनती(आ);
    शब्दकोश फल = आव्यूह_बनाओ(गण - १, गण - १);
    संख्या नई_पं = ०;
    संख्या पं = ०;
    यावत् (पं < गण) {
        यदि (पं != हटा_पं) {
            संख्या नई_स्तं = ०;
            संख्या स्तं = ०;
            यावत् (स्तं < गण) {
                यदि (स्तं != हटा_स्तं) {
                    आव्यूह_सेट(फल, नई_पं, नई_स्तं, आव्यूह_पाओ(आ, पं, स्तं));
                    नई_स्तं = नई_स्तं + १;
                }
                स्तं = स्तं + १;
            }
            नई_पं = नई_पं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

// पहली पंक्ति पर cofactor expansion — शून्य तत्व छोड़ता (गति के लिए)
कार्य आ_निर्धारक_सहायक(शब्दकोश आ) {
    संख्या गण = आव्यूह_पंक्ति_गिनती(आ);
    यदि (गण == १) {
        परत् आव्यूह_पाओ(आ, ०, ०);
    }
    यदि (गण == २) {
        दशमलव अ = आव्यूह_पाओ(आ, ०, ०);
        दशमलव ब = आव्यूह_पाओ(आ, ०, १);
        दशमलव स = आव्यूह_पाओ(आ, १, ०);
        दशमलव द = आव्यूह_पाओ(आ, १, १);
        परत् अ * द - ब * स;
    }
    दशमलव योग = ०.०;
    संख्या ज = ०;
    यावत् (ज < गण) {
        दशमलव तत्व = आव्यूह_पाओ(आ, ०, ज);
        यदि (तत्व != ०.०) {
            शब्दकोश उप = आ_उप_आव्यूह(आ, ०, ज);
            दशमलव उप_निर्धारक = आ_निर्धारक_सहायक(उप);
            दशमलव चिह्न = १.०;
            यदि ((ज % २) == १) { चिह्न = -१.०; }
            योग = योग + चिह्न * तत्व * उप_निर्धारक;
        }
        ज = ज + १;
    }
    परत् योग;
}

// ===== सार्वजनिक API — निर्माण/पहुँच =====

// पंक्तियाँ×स्तंभ का शून्य-भरा आव्यूह
कार्य आव्यूह_बनाओ(संख्या पंक्तियाँ, संख्या स्तंभ) {
    यदि (पंक्तियाँ < १ || स्तंभ < १) {
        प्रक्षेपः "त्रुटिः — आव्यूह: पंक्तियाँ/स्तंभ कम से कम 1 होने चाहिए";
    }
    शब्दकोश आ = {};
    आ["पंक्तियाँ"] = पंक्तियाँ;
    आ["स्तंभ"] = स्तंभ;
    सूची डेटा = [];
    संख्या कुल = पंक्तियाँ * स्तंभ;
    संख्या इ = ०;
    यावत् (इ < कुल) {
        डेटा = जोड़ें(डेटा, ०.०);
        इ = इ + १;
    }
    आ["डेटा"] = डेटा;
    परत् आ;
}

// गण×गण पहचान आव्यूह (identity)
कार्य आव्यूह_पहचान(संख्या गण) {
    शब्दकोश आ = आव्यूह_बनाओ(गण, गण);
    संख्या इ = ०;
    यावत् (इ < गण) {
        आव्यूह_सेट(आ, इ, इ, १.०);
        इ = इ + १;
    }
    परत् आ;
}

// नेस्टेड सूची-of-सूची (पंक्तियों की सूची) से आव्यूह — कभी चेन्ड
// इंडेक्सिंग नहीं करता (ऊपर टिप्पणी देखो), हर स्तर नामित वेरिएबल से
कार्य आव्यूह_से_पंक्तियाँ(सूची पंक्ति_सूची) {
    संख्या पं_गिनती = लंबाई(पंक्ति_सूची);
    यदि (पं_गिनती < १) {
        प्रक्षेपः "त्रुटिः — आव्यूह: खाली पंक्ति-सूची से नहीं बन सकता";
    }
    सूची पहली_पंक्ति = पंक्ति_सूची[०];
    संख्या स्तं_गिनती = लंबाई(पहली_पंक्ति);
    यदि (स्तं_गिनती < १) {
        प्रक्षेपः "त्रुटिः — आव्यूह: खाली पंक्ति से नहीं बन सकता";
    }
    शब्दकोश फल = आव्यूह_बनाओ(पं_गिनती, स्तं_गिनती);
    संख्या पं = ०;
    यावत् (पं < पं_गिनती) {
        सूची यह_पंक्ति = पंक्ति_सूची[पं];
        यदि (लंबाई(यह_पंक्ति) != स्तं_गिनती) {
            प्रक्षेपः "त्रुटिः — आव्यूह: सभी पंक्तियाँ समान लंबाई की होनी चाहिए";
        }
        संख्या स्तं = ०;
        यावत् (स्तं < स्तं_गिनती) {
            दशमलव मूल्य = यह_पंक्ति[स्तं];
            आव्यूह_सेट(फल, पं, स्तं, मूल्य);
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

कार्य आव्यूह_पंक्ति_गिनती(शब्दकोश आ) {
    परत् आ["पंक्तियाँ"];
}

कार्य आव्यूह_स्तंभ_गिनती(शब्दकोश आ) {
    परत् आ["स्तंभ"];
}

// तत्व (पं,स्तं) पढ़ो (सूचकांक सीमा से बाहर होने पर त्रुटि)
कार्य आव्यूह_पाओ(शब्दकोश आ, संख्या पं, संख्या स्तं) {
    संख्या स्तं_गिनती = आ["स्तंभ"];
    यदि (पं < ० || पं >= आ["पंक्तियाँ"] || स्तं < ० || स्तं >= स्तं_गिनती) {
        प्रक्षेपः "त्रुटिः — आव्यूह: सूचकांक सीमा से बाहर";
    }
    सूची डेटा = आ["डेटा"];
    परत् डेटा[पं * स्तं_गिनती + स्तं];
}

// तत्व (पं,स्तं) बदलो, जगह पर (O(1)) — इनपुट आव्यूह खुद बदलता है
कार्य आव्यूह_सेट(शब्दकोश आ, संख्या पं, संख्या स्तं, दशमलव मूल्य) {
    संख्या स्तं_गिनती = आ["स्तंभ"];
    यदि (पं < ० || पं >= आ["पंक्तियाँ"] || स्तं < ० || स्तं >= स्तं_गिनती) {
        प्रक्षेपः "त्रुटिः — आव्यूह: सूचकांक सीमा से बाहर";
    }
    सूची डेटा = आ["डेटा"];
    डेटा[पं * स्तं_गिनती + स्तं] = मूल्य;
    परत् ०;
}

// ===== सार्वजनिक API — अंकगणित (सभी नया आव्यूह लौटाते, operand अपरिवर्तित) =====

कार्य आव्यूह_जोड़(शब्दकोश अ, शब्दकोश ब) {
    संख्या पं_गिनती = आव्यूह_पंक्ति_गिनती(अ);
    संख्या स्तं_गिनती = आव्यूह_स्तंभ_गिनती(अ);
    यदि (पं_गिनती != आव्यूह_पंक्ति_गिनती(ब) || स्तं_गिनती != आव्यूह_स्तंभ_गिनती(ब)) {
        प्रक्षेपः "त्रुटिः — आव्यूह: जोड़ के लिए आकार मेल नहीं खाते";
    }
    शब्दकोश फल = आव्यूह_बनाओ(पं_गिनती, स्तं_गिनती);
    संख्या पं = ०;
    यावत् (पं < पं_गिनती) {
        संख्या स्तं = ०;
        यावत् (स्तं < स्तं_गिनती) {
            दशमलव अ_मूल्य = आव्यूह_पाओ(अ, पं, स्तं);
            दशमलव ब_मूल्य = आव्यूह_पाओ(ब, पं, स्तं);
            आव्यूह_सेट(फल, पं, स्तं, अ_मूल्य + ब_मूल्य);
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

कार्य आव्यूह_घटाओ(शब्दकोश अ, शब्दकोश ब) {
    संख्या पं_गिनती = आव्यूह_पंक्ति_गिनती(अ);
    संख्या स्तं_गिनती = आव्यूह_स्तंभ_गिनती(अ);
    यदि (पं_गिनती != आव्यूह_पंक्ति_गिनती(ब) || स्तं_गिनती != आव्यूह_स्तंभ_गिनती(ब)) {
        प्रक्षेपः "त्रुटिः — आव्यूह: घटाव के लिए आकार मेल नहीं खाते";
    }
    शब्दकोश फल = आव्यूह_बनाओ(पं_गिनती, स्तं_गिनती);
    संख्या पं = ०;
    यावत् (पं < पं_गिनती) {
        संख्या स्तं = ०;
        यावत् (स्तं < स्तं_गिनती) {
            दशमलव अ_मूल्य = आव्यूह_पाओ(अ, पं, स्तं);
            दशमलव ब_मूल्य = आव्यूह_पाओ(ब, पं, स्तं);
            आव्यूह_सेट(फल, पं, स्तं, अ_मूल्य - ब_मूल्य);
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

कार्य आव्यूह_अदिश_गुणा(शब्दकोश आ, दशमलव अदिश) {
    संख्या पं_गिनती = आव्यूह_पंक्ति_गिनती(आ);
    संख्या स्तं_गिनती = आव्यूह_स्तंभ_गिनती(आ);
    शब्दकोश फल = आव्यूह_बनाओ(पं_गिनती, स्तं_गिनती);
    संख्या पं = ०;
    यावत् (पं < पं_गिनती) {
        संख्या स्तं = ०;
        यावत् (स्तं < स्तं_गिनती) {
            आव्यूह_सेट(फल, पं, स्तं, आव्यूह_पाओ(आ, पं, स्तं) * अदिश);
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

// आव्यूह गुणा (अ.स्तंभ == ब.पंक्तियाँ ज़रूरी)
कार्य आव्यूह_गुणा(शब्दकोश अ, शब्दकोश ब) {
    संख्या अ_पं = आव्यूह_पंक्ति_गिनती(अ);
    संख्या अ_स्तं = आव्यूह_स्तंभ_गिनती(अ);
    संख्या ब_पं = आव्यूह_पंक्ति_गिनती(ब);
    संख्या ब_स्तं = आव्यूह_स्तंभ_गिनती(ब);
    यदि (अ_स्तं != ब_पं) {
        प्रक्षेपः "त्रुटिः — आव्यूह: गुणा के लिए आकार असंगत (अ.स्तंभ != ब.पंक्तियाँ)";
    }
    शब्दकोश फल = आव्यूह_बनाओ(अ_पं, ब_स्तं);
    संख्या पं = ०;
    यावत् (पं < अ_पं) {
        संख्या स्तं = ०;
        यावत् (स्तं < ब_स्तं) {
            दशमलव योग = ०.०;
            संख्या क = ०;
            यावत् (क < अ_स्तं) {
                दशमलव अ_मूल्य = आव्यूह_पाओ(अ, पं, क);
                दशमलव ब_मूल्य = आव्यूह_पाओ(ब, क, स्तं);
                योग = योग + अ_मूल्य * ब_मूल्य;
                क = क + १;
            }
            आव्यूह_सेट(फल, पं, स्तं, योग);
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

कार्य आव्यूह_स्थानांतरण(शब्दकोश आ) {
    संख्या पं_गिनती = आव्यूह_पंक्ति_गिनती(आ);
    संख्या स्तं_गिनती = आव्यूह_स्तंभ_गिनती(आ);
    शब्दकोश फल = आव्यूह_बनाओ(स्तं_गिनती, पं_गिनती);
    संख्या पं = ०;
    यावत् (पं < पं_गिनती) {
        संख्या स्तं = ०;
        यावत् (स्तं < स्तं_गिनती) {
            आव्यूह_सेट(फल, स्तं, पं, आव्यूह_पाओ(आ, पं, स्तं));
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

// वर्ग आव्यूह का निर्धारक (Laplace expansion — देखो ऊपर O(n!) टिप्पणी)
कार्य आव्यूह_निर्धारक(शब्दकोश आ) {
    यदि (आव्यूह_पंक्ति_गिनती(आ) != आव्यूह_स्तंभ_गिनती(आ)) {
        प्रक्षेपः "त्रुटिः — आव्यूह: निर्धारक सिर्फ़ वर्ग आव्यूह के लिए";
    }
    परत् आ_निर्धारक_सहायक(आ);
}

// वर्ग आव्यूह का व्युत्क्रम — adjugate/cofactor विधि (देखो ऊपर O(n×n!) टिप्पणी)
कार्य आव्यूह_व्युत्क्रम(शब्दकोश आ) {
    संख्या गण = आव्यूह_पंक्ति_गिनती(आ);
    यदि (गण != आव्यूह_स्तंभ_गिनती(आ)) {
        प्रक्षेपः "त्रुटिः — आव्यूह: व्युत्क्रम सिर्फ़ वर्ग आव्यूह के लिए";
    }
    दशमलव द = आव्यूह_निर्धारक(आ);
    यदि (द == ०.०) {
        प्रक्षेपः "त्रुटिः — आव्यूह: एकवचन (singular) आव्यूह का व्युत्क्रम नहीं होता";
    }
    यदि (गण == १) {
        शब्दकोश फल = आव्यूह_बनाओ(१, १);
        आव्यूह_सेट(फल, ०, ०, १.० / द);
        परत् फल;
    }
    शब्दकोश सह_आव्यूह = आव्यूह_बनाओ(गण, गण);
    संख्या पं = ०;
    यावत् (पं < गण) {
        संख्या स्तं = ०;
        यावत् (स्तं < गण) {
            शब्दकोश उप = आ_उप_आव्यूह(आ, पं, स्तं);
            दशमलव लघु = आ_निर्धारक_सहायक(उप);
            दशमलव चिह्न = १.०;
            यदि (((पं + स्तं) % २) == १) { चिह्न = -१.०; }
            आव्यूह_सेट(सह_आव्यूह, पं, स्तं, चिह्न * लघु);
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    शब्दकोश सहायुज्य = आव्यूह_स्थानांतरण(सह_आव्यूह);
    परत् आव्यूह_अदिश_गुणा(सहायुज्य, १.० / द);
}

// ===== सार्वजनिक API — उपयोगिता =====

// दो आव्यूह सहनशीलता के भीतर बराबर हैं? (फ्लोटिंग-पॉइंट तुलना)
कार्य आव्यूह_लगभग_बराबर(शब्दकोश अ, शब्दकोश ब, दशमलव सहनशीलता) {
    यदि (आव्यूह_पंक्ति_गिनती(अ) != आव्यूह_पंक्ति_गिनती(ब)) { परत् असत्य; }
    यदि (आव्यूह_स्तंभ_गिनती(अ) != आव्यूह_स्तंभ_गिनती(ब)) { परत् असत्य; }
    संख्या पं = ०;
    यावत् (पं < आव्यूह_पंक्ति_गिनती(अ)) {
        संख्या स्तं = ०;
        यावत् (स्तं < आव्यूह_स्तंभ_गिनती(अ)) {
            दशमलव अ_मूल्य = आव्यूह_पाओ(अ, पं, स्तं);
            दशमलव ब_मूल्य = आव्यूह_पाओ(ब, पं, स्तं);
            दशमलव अंतर = अ_मूल्य - ब_मूल्य;
            यदि (अंतर < ०.०) { अंतर = ०.० - अंतर; }
            यदि (अंतर > सहनशीलता) { परत् असत्य; }
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् सत्य;
}

कार्य आव्यूह_शून्य_है(शब्दकोश आ) {
    परत् आव्यूह_लगभग_बराबर(आ, आव्यूह_बनाओ(आव्यूह_पंक्ति_गिनती(आ), आव्यूह_स्तंभ_गिनती(आ)), ०.०००००१);
}

कार्य आव्यूह_पहचान_है(शब्दकोश आ) {
    यदि (आव्यूह_पंक्ति_गिनती(आ) != आव्यूह_स्तंभ_गिनती(आ)) { परत् असत्य; }
    परत् आव्यूह_लगभग_बराबर(आ, आव्यूह_पहचान(आव्यूह_पंक्ति_गिनती(आ)), ०.०००००१);
}

// डीबग/प्रदर्शन के लिए पठनीय पाठ-रूप ("[1, 2]\n[3, 4]\n")
कार्य आव्यूह_से_पाठ(शब्दकोश आ) {
    पाठ फल = "";
    संख्या पं_गिनती = आव्यूह_पंक्ति_गिनती(आ);
    संख्या स्तं_गिनती = आव्यूह_स्तंभ_गिनती(आ);
    संख्या पं = ०;
    यावत् (पं < पं_गिनती) {
        पाठ पंक्ति_पाठ = "[";
        संख्या स्तं = ०;
        यावत् (स्तं < स्तं_गिनती) {
            यदि (स्तं > ०) { पंक्ति_पाठ = पंक्ति_पाठ + ", "; }
            दशमलव तत्व = आव्यूह_पाओ(आ, पं, स्तं);
            पंक्ति_पाठ = पंक्ति_पाठ + तत्व;
            स्तं = स्तं + १;
        }
        फल = फल + पंक्ति_पाठ + "]\n";
        पं = पं + १;
    }
    परत् फल;
}
