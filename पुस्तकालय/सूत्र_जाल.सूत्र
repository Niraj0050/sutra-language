// पुस्तकालय/सूत्र_जाल.सूत्र — सूत्र अर्थगत संजाल एवं वेब एपीआई इंजन (Sutra-Jal Web Engine)
// ============================================================
// आयात "पुस्तकालय/सूत्र_जाल.सूत्र";
//
// पाणिनीय अर्थगत संजाल एवं रूटिंग ढाँचा।
// पारंपरिक भारी नोड/पायथन वेब ढाँचों से भिन्न:
// १. शून्य-निर्भरता शुद्ध सूत्र रूटिंग ट्री (Trie / Prefix Router)
// २. प्राचल-सहित रूटिंग (Dynamic Routes: "/छात्र/:आईडी")
// ३. मध्यस्थ पाइपलाइन (Middleware Pipeline)
// ४. देवनागरी एचटीटीपी अमूर्तीकरण (अनुरोध, प्रतिक्रिया, स्थिति-कोड)
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/जेसन.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/व्याकरण.सूत्र";

// ============================================================
// १. अनुरोध एवं प्रतिक्रिया अमूर्तीकरण (Request & Response)
// ============================================================

कार्य अनुरोध_बनाओ(पाठ विधि, पाठ पथ, शब्दकोश हेडर, पाठ मुख्य_भाग) {
    शब्दकोश अनु = {};
    अनु["विधि"] = विधि;            // "प्राप्त", "भेजें", "अद्यतन", "हटाएं" (GET, POST, PUT, DELETE)
    अनु["पथ"] = पथ;
    अनु["हेडर"] = हेडर;
    अनु["मुख्य_भाग"] = मुख्य_भाग;
    अनु["प्राचल"] = {};             // रूट पैरामीटर જેમ કે :आईडी
    अनु["क्वेरी"] = {};
    परत् अनु;
}

कार्य प्रतिक्रिया_बनाओ(संख्या स्थिति_कोड, पाठ डेटा, शब्दकोश हेडर) {
    शब्दकोश प्रति = {};
    प्रति["स्थिति_कोड"] = स्थिति_कोड; // २०० (सम्यक्), ४०४ (अप्राप्त), आदि
    प्रति["डेटा"] = डेटा;
    प्रति["हेडर"] = हेडर;
    परत् प्रति;
}

कार्य प्रतिक्रिया_जेसन(संख्या स्थिति_कोड, शब्दकोश डेटा) {
    पाठ जेसन_पाठ = जेसन_बनाओ(डेटा);
    शब्दकोश हेडर = {};
    हेडर["सामग्री_प्रकार"] = "अनुप्रयोग/जेसन; यूनिकोड=यूटीएफ-८";
    परत् प्रतिक्रिया_बनाओ(स्थिति_कोड, जेसन_पाठ, हेडर);
}

// ============================================================
// २. अर्थगत मार्गक (Semantic URL Router)
// ============================================================

कार्य मार्गक_बनाओ() {
    शब्दकोश मार्गक = {};
    मार्गक["मार्ग_सूची"] = [];     // {विधि, पथ, खंड, क्रिया} की सूची
    मार्गक["हेडर_मध्यस्थ"] = {};   // स्वतः जोड़े जाने वाले हेडर
    परत् मार्गक;
}

कार्य मार्ग_जोड़ें(शब्दकोश मार्गक, पाठ विधि, पाठ पथ, पाठ क्रिया_नाम) {
    // पथ को खंडों में विभाजित करना
    सूची खंड = विभाजित(पथ, "/");
    सूची स्वच्छ_खंड = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(खंड)) {
        यदि (खंड[इ] != "") {
            स्वच्छ_खंड = जोड़ें(स्वच्छ_खंड, खंड[इ]);
        }
        इ = इ + १;
    }
    
    शब्दकोश मार्ग = {};
    मार्ग["विधि"] = विधि;
    मार्ग["पथ"] = पथ;
    मार्ग["खंड"] = स्वच्छ_खंड;
    मार्ग["क्रिया"] = क्रिया_नाम;
    
    मार्गक["मार्ग_सूची"] = जोड़ें(मार्गक["मार्ग_सूची"], मार्ग);
}

// डिफ़ॉल्ट हेडर मध्यस्थ (Default Response Header Middleware)
कार्य मार्गक_मध्यस्थ_हेडर(शब्दकोश मार्गक, पाठ हेडर_नाम, पाठ हेडर_मूल्य) {
    मार्गक["हेडर_मध्यस्थ"][हेडर_नाम] = हेडर_मूल्य;
}

// पथ मिलान एवं प्राचल निष्कर्षण (Path Matching & Param Extraction)
कार्य मार्ग_मिलान(सूची मार्ग_खंड, सूची अनुरोध_खंड) {
    यदि (लंबाई(मार्ग_खंड) != लंबाई(अनुरोध_खंड)) {
        परत् शून्यम्;
    }
    
    शब्दकोश प्राचल = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(मार्ग_खंड)) {
        पाठ म_खंड = मार्ग_खंड[इ];
        पाठ अ_खंड = अनुरोध_खंड[इ];
        
        यदि (पाठ_प्रारंभ_है(म_खंड, ":")) {
            // प्राचल मिला (Dynamic Parameter like :आईडी)
            पाठ कुंजी = उपखंड(म_खंड, १, लंबाई(म_खंड));
            प्राचल[कुंजी] = अ_खंड;
        } अन्यथा यदि (म_खंड != अ_खंड) {
            परत् शून्यम्; // मिलान विफल
        }
        इ = इ + १;
    }
    
    परत् प्राचल;
}

// अनुरोध प्रेषण (Dispatch Request)
कार्य मार्गक_प्रेषण(शब्दकोश मार्गक, शब्दकोश अनुरोध) {
    // १. अनुरोध पथ खंडन
    सूची अनु_कच्चे_खंड = विभाजित(अनुरोध["पथ"], "/");
    सूची अनु_खंड = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(अनु_कच्चे_खंड)) {
        यदि (अनु_कच्चे_खंड[इ] != "") {
            अनु_खंड = जोड़ें(अनु_खंड, अनु_कच्चे_खंड[इ]);
        }
        इ = इ + १;
    }
    
    // २. मार्ग सूची में मिलान खोज
    संख्या मा_इ = ०;
    यावत् (मा_इ < लंबाई(मार्गक["मार्ग_सूची"])) {
        शब्दकोश मार्ग = मार्गक["मार्ग_सूची"][मा_इ];
        यदि (मार्ग["विधि"] == अनुरोध["विधि"]) {
            शब्दकोश प्राचल = मार्ग_मिलान(मार्ग["खंड"], अनु_खंड);
            यदि (प्राचल != शून्यम्) {
                // मिलान सफल
                अनुरोध["प्राचल"] = प्राचल;
                
                शब्दकोश प्रेषण_फल = {};
                प्रेषण_फल["स्थिति"] = २००;
                प्रेषण_फल["क्रिया"] = मार्ग["क्रिया"];
                प्रेषण_फल["प्राचल"] = प्राचल;
                प्रेषण_फल["अनुरोध"] = अनुरोध;
                प्रेषण_फल["मध्यस्थ_हेडर"] = मार्गक["हेडर_मध्यस्थ"];
                परत् प्रेषण_फल;
            }
        }
        मा_इ = मा_इ + १;
    }
    
    // ३. कोई मार्ग नहीं मिला -> ४०४ अप्राप्त
    शब्दकोश विफल_फल = {};
    विफल_फल["स्थिति"] = ४०४;
    विफल_फल["क्रिया"] = "";
    विफल_फल["प्राचल"] = {};
    विफल_फल["त्रुटि"] = "मार्ग अप्राप्तः";
    विफल_फल["पथ"] = अनुरोध["पथ"];
    परत् विफल_फल;
}
