// पुस्तकालय/तर्क.सूत्र — कमांड-लाइन तर्क विश्लेषक (argparse-सम)
// ============================================================
// आयात "पुस्तकालय/तर्क.सूत्र";
//
//   कार्य मुख्य() {
//       मान प = नवीन तर्क_विश्लेषक("मेरा उपकरण");
//       प.ध्वज("verbose", "v");                 // --verbose / -v  (बूल)
//       प.विकल्प("output", "o", "a.out");        // --output x / -o x / --output=x
//       प.स्थानिक("इनपुट");                      // पहला गैर-ध्वज तर्क
//
//       मान परिणाम = प.विश्लेषण(कार्यक्रम_तर्क());
//       यदि (परिणाम["verbose"]) { लिखतु("वाचाल"); }
//       लिखतु(परिणाम["output"]);
//       लिखतु(परिणाम["इनपुट"]);
//       // बचे हुए (extra) positionals: परिणाम["_शेष"] (सूची)
//   }
//
// समर्थित: --लंबा, -छ, --लंबा=मान, -छ मान, --लंबा मान, -- (शेष सब positional)।
// संयुक्त छोटे ध्वज (-abc) समर्थित नहीं। अज्ञात --ध्वज को शेष में डाल देता।
// ============================================================

// तर्काः() में से कार्यक्रम-नाम (पहला) हटाकर बाकी
कार्य कार्यक्रम_तर्क() {
    सूची सब = तर्काः();
    सूची फल = [];
    संख्या इ = १;
    यावत् (इ < लंबाई(सब)) {
        फल = जोड़ें(फल, सब[इ]);
        इ = इ + १;
    }
    परत् फल;
}

वर्ग तर्क_विश्लेषक {
    मान वर्णन_क = ०;
    मान ध्वज_क = ०;
    मान विकल्प_क = ०;
    मान स्थानिक_क = ०;

    कार्य रचना(पाठ वर्णन) {
        स्व.वर्णन_क = वर्णन;
        स्व.ध्वज_क = [];
        स्व.विकल्प_क = [];
        स्व.स्थानिक_क = [];
    }

    कार्य ध्वज(पाठ नाम, पाठ संक्षिप्त) {
        शब्दकोश ई = {};
        ई["नाम"] = नाम;
        ई["संक्षिप्त"] = संक्षिप्त;
        स्व.ध्वज_क = जोड़ें(स्व.ध्वज_क, ई);
    }

    कार्य विकल्प(पाठ नाम, पाठ संक्षिप्त, मान चूक) {
        शब्दकोश ई = {};
        ई["नाम"] = नाम;
        ई["संक्षिप्त"] = संक्षिप्त;
        ई["चूक"] = चूक;
        स्व.विकल्प_क = जोड़ें(स्व.विकल्प_क, ई);
    }

    कार्य स्थानिक(पाठ नाम) {
        स्व.स्थानिक_क = जोड़ें(स्व.स्थानिक_क, नाम);
    }

    // "verbose" / "v" → ध्वज-प्रविष्टि या शून्यम्
    कार्य खोजो_ध्वज(पाठ कुं) {
        संख्या इ = ०;
        यावत् (इ < लंबाई(स्व.ध्वज_क)) {
            मान ई = स्व.ध्वज_क[इ];
            यदि (ई["नाम"] == कुं || ई["संक्षिप्त"] == कुं) { परत् ई; }
            इ = इ + १;
        }
        परत् शून्यम्;
    }
    कार्य खोजो_विकल्प(पाठ कुं) {
        संख्या इ = ०;
        यावत् (इ < लंबाई(स्व.विकल्प_क)) {
            मान ई = स्व.विकल्प_क[इ];
            यदि (ई["नाम"] == कुं || ई["संक्षिप्त"] == कुं) { परत् ई; }
            इ = इ + १;
        }
        परत् शून्यम्;
    }

    कार्य विश्लेषण(सूची तर्क) {
        शब्दकोश परिणाम = {};
        // चूक भरो
        संख्या इ = ०;
        यावत् (इ < लंबाई(स्व.ध्वज_क)) {
            परिणाम[स्व.ध्वज_क[इ]["नाम"]] = असत्य;
            इ = इ + १;
        }
        इ = ०;
        यावत् (इ < लंबाई(स्व.विकल्प_क)) {
            परिणाम[स्व.विकल्प_क[इ]["नाम"]] = स्व.विकल्प_क[इ]["चूक"];
            इ = इ + १;
        }
        सूची स्थानिक_मान = [];
        सूची शेष = [];
        संख्या केवल_शेष = ०;

        इ = ०;
        यावत् (इ < लंबाई(तर्क)) {
            पाठ ट = "" + तर्क[इ];
            यदि (केवल_शेष == १) {
                शेष = जोड़ें(शेष, ट);
                इ = इ + १;
            } अन्यथा यदि (ट == "--") {
                केवल_शेष = १;
                इ = इ + १;
            } अन्यथा यदि (लंबाई(ट) >= २ && उपखंड(ट, ०, २) == "--") {
                // --लंबा  या  --लंबा=मान
                पाठ बाकी = उपखंड(ट, २, लंबाई(ट));
                संख्या बराबर = खोजें(बाकी, "=");
                यदि (बराबर != -१) {
                    पाठ नाम = उपखंड(बाकी, ०, बराबर);
                    पाठ मान_पाठ = उपखंड(बाकी, बराबर + १, लंबाई(बाकी));
                    मान विक = स्व.खोजो_विकल्प(नाम);
                    यदि (विक != शून्यम्) { परिणाम[विक["नाम"]] = मान_पाठ; }
                    अन्यथा { शेष = जोड़ें(शेष, ट); }
                    इ = इ + १;
                } अन्यथा {
                    मान ध्व = स्व.खोजो_ध्वज(बाकी);
                    यदि (ध्व != शून्यम्) {
                        परिणाम[ध्व["नाम"]] = सत्य;
                        इ = इ + १;
                    } अन्यथा {
                        मान विक2 = स्व.खोजो_विकल्प(बाकी);
                        यदि (विक2 != शून्यम् && इ + १ < लंबाई(तर्क)) {
                            परिणाम[विक2["नाम"]] = "" + तर्क[इ + १];
                            इ = इ + २;
                        } अन्यथा {
                            शेष = जोड़ें(शेष, ट);
                            इ = इ + १;
                        }
                    }
                }
            } अन्यथा यदि (लंबाई(ट) >= २ && उपखंड(ट, ०, १) == "-" && ट != "-") {
                // -छ  या  -छ मान
                पाठ छ = उपखंड(ट, १, लंबाई(ट));
                मान ध्व = स्व.खोजो_ध्वज(छ);
                यदि (ध्व != शून्यम्) {
                    परिणाम[ध्व["नाम"]] = सत्य;
                    इ = इ + १;
                } अन्यथा {
                    मान विक = स्व.खोजो_विकल्प(छ);
                    यदि (विक != शून्यम् && इ + १ < लंबाई(तर्क)) {
                        परिणाम[विक["नाम"]] = "" + तर्क[इ + १];
                        इ = इ + २;
                    } अन्यथा {
                        शेष = जोड़ें(शेष, ट);
                        इ = इ + १;
                    }
                }
            } अन्यथा {
                स्थानिक_मान = जोड़ें(स्थानिक_मान, ट);
                इ = इ + १;
            }
        }

        // स्थानिक नाम भरो
        संख्या ज = ०;
        यावत् (ज < लंबाई(स्व.स्थानिक_क) && ज < लंबाई(स्थानिक_मान)) {
            परिणाम[स्व.स्थानिक_क[ज]] = स्थानिक_मान[ज];
            ज = ज + १;
        }
        // बचे हुए स्थानिक
        यावत् (ज < लंबाई(स्थानिक_मान)) {
            शेष = जोड़ें(शेष, स्थानिक_मान[ज]);
            ज = ज + १;
        }
        // घोषित पर अनुपस्थित स्थानिक → शून्यम्
        यावत् (ज < लंबाई(स्व.स्थानिक_क)) {
            यदि (न कुंजी_है(परिणाम, स्व.स्थानिक_क[ज])) {
                परिणाम[स्व.स्थानिक_क[ज]] = शून्यम्;
            }
            ज = ज + १;
        }

        परिणाम["_शेष"] = शेष;
        परत् परिणाम;
    }

    कार्य सहायता() {
        पाठ फल = स्व.वर्णन_क + "\n";
        यदि (लंबाई(स्व.स्थानिक_क) > ०) {
            फल = फल + "\nस्थानिक:\n";
            संख्या इ = ०;
            यावत् (इ < लंबाई(स्व.स्थानिक_क)) {
                फल = फल + "  " + स्व.स्थानिक_क[इ] + "\n";
                इ = इ + १;
            }
        }
        यदि (लंबाई(स्व.ध्वज_क) > ०) {
            फल = फल + "\nध्वज:\n";
            संख्या इ = ०;
            यावत् (इ < लंबाई(स्व.ध्वज_क)) {
                मान ई = स्व.ध्वज_क[इ];
                फल = फल + "  -" + ई["संक्षिप्त"] + ", --" + ई["नाम"] + "\n";
                इ = इ + १;
            }
        }
        यदि (लंबाई(स्व.विकल्प_क) > ०) {
            फल = फल + "\nविकल्प:\n";
            संख्या इ = ०;
            यावत् (इ < लंबाई(स्व.विकल्प_क)) {
                मान ई = स्व.विकल्प_क[इ];
                फल = फल + "  -" + ई["संक्षिप्त"] + ", --" + ई["नाम"]
                    + "  (चूक: " + ("" + ई["चूक"]) + ")\n";
                इ = इ + १;
            }
        }
        परत् फल;
    }
}
