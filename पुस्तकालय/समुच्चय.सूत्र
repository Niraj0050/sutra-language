// पुस्तकालय/समुच्चय.सूत्र — समुच्चय (Set), शब्दकोश-आधारित
// ============================================================
// आयात "पुस्तकालय/समुच्चय.सूत्र";
//   मान स = नवीन समुच्चय();
//   स.जोड़ो(3); स.जोड़ो(3); स.जोड़ो(5);
//   स.है(3)        → सत्य
//   स.आकार()       → 2
//   स.सूची_में()   → [3, 5]   (डालने का क्रम)
//
// सदस्य: संख्या / पाठ / बूल (आदिम मान)। भीतर कुंजी "" + मान से बनती है,
// तो संख्या 5 और पाठ "5" एक ही मानी जाएँगी — v1 सीमा।
// ============================================================

वर्ग समुच्चय {
    मान नक्शा_क = 0;
    मान क्रम_क = 0;

    कार्य रचना() {
        स्व.नक्शा_क = {};
        स्व.क्रम_क = [];
    }

    कार्य जोड़ो(मान सदस्य) {
        पाठ कुं = "" + सदस्य;
        यदि (न कुंजी_है(स्व.नक्शा_क, कुं)) {
            // सूत्र में स्व.क्षेत्र[कुंजी] = मान असमर्थित — संदर्भ स्थानीय में लो
            मान तालिका = स्व.नक्शा_क;
            तालिका[कुं] = सदस्य;
            स्व.क्रम_क = जोड़ें(स्व.क्रम_क, सदस्य);
        }
    }

    कार्य है(मान सदस्य) {
        परत् कुंजी_है(स्व.नक्शा_क, "" + सदस्य);
    }

    कार्य हटाओ(मान सदस्य) {
        पाठ कुं = "" + सदस्य;
        यदि (कुंजी_है(स्व.नक्शा_क, कुं)) {
            // हटाएं(शब्दकोश, कुंजी) native path में नहीं चलता — नक्शा+क्रम
            // दोनों नए सिरे से बनाओ।
            शब्दकोश नया_नक्शा = {};
            सूची नया_क्रम = [];
            संख्या इ = 0;
            यावत् (इ < लंबाई(स्व.क्रम_क)) {
                पाठ इक = "" + स्व.क्रम_क[इ];
                यदि (न (इक == कुं)) {
                    नया_नक्शा[इक] = स्व.क्रम_क[इ];
                    नया_क्रम = जोड़ें(नया_क्रम, स्व.क्रम_क[इ]);
                }
                इ = इ + 1;
            }
            स्व.नक्शा_क = नया_नक्शा;
            स्व.क्रम_क = नया_क्रम;
        }
    }

    कार्य आकार() {
        परत् लंबाई(स्व.क्रम_क);
    }

    कार्य खाली_है() {
        परत् लंबाई(स्व.क्रम_क) == 0;
    }

    कार्य सूची_में() {
        सूची फल = [];
        संख्या इ = 0;
        यावत् (इ < लंबाई(स्व.क्रम_क)) {
            फल = जोड़ें(फल, स्व.क्रम_क[इ]);
            इ = इ + 1;
        }
        परत् फल;
    }
}

// सूची से समुच्चय
कार्य समुच्चय_से_सूची(सूची स) {
    मान फल = नवीन समुच्चय();
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        फल.जोड़ो(स[इ]);
        इ = इ + 1;
    }
    परत् फल;
}

// ⚠️ सूत्र native codegen में विधि-कॉल का लक्ष्य receiver के static वर्ग से
// हल होता है — इसलिए (1) params को समुच्चय-typed रखो, (2) फलन का परिणाम
// समुच्चय नहीं, सूची लौटाओ (`समुच्चय v = f()` local-decl पार्स नहीं होता,
// और `मान v = f()` पर v.विधि() → `वर्ग_मान_*` अनसुलझा)। सेट चाहिए तो
// परिणाम को `समुच्चय_से_सूची(...)` से दुबारा लपेटो।

// संघ (a ∪ b) → अद्वितीय तत्वों की सूची
कार्य संघ(समुच्चय अ, समुच्चय ब) {
    मान फल = नवीन समुच्चय();
    सूची ला = अ.सूची_में();
    संख्या इ = 0;
    यावत् (इ < लंबाई(ला)) { फल.जोड़ो(ला[इ]); इ = इ + 1; }
    सूची लब = ब.सूची_में();
    इ = 0;
    यावत् (इ < लंबाई(लब)) { फल.जोड़ो(लब[इ]); इ = इ + 1; }
    परत् फल.सूची_में();
}

// प्रतिच्छेद (a ∩ b) → सूची
कार्य प्रतिच्छेद(समुच्चय अ, समुच्चय ब) {
    मान फल = नवीन समुच्चय();
    सूची ला = अ.सूची_में();
    संख्या इ = 0;
    यावत् (इ < लंबाई(ला)) {
        यदि (ब.है(ला[इ])) { फल.जोड़ो(ला[इ]); }
        इ = इ + 1;
    }
    परत् फल.सूची_में();
}

// अंतर (a − b) → सूची
कार्य अंतर(समुच्चय अ, समुच्चय ब) {
    मान फल = नवीन समुच्चय();
    सूची ला = अ.सूची_में();
    संख्या इ = 0;
    यावत् (इ < लंबाई(ला)) {
        यदि (न ब.है(ला[इ])) { फल.जोड़ो(ला[इ]); }
        इ = इ + 1;
    }
    परत् फल.सूची_में();
}
