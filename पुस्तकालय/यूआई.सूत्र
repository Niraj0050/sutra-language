// पुस्तकालय/यूआई.सूत्र — शुद्ध-सूत्र UI मॉडल (retained-mode)
// ============================================================
// विजेट-वृक्ष (शब्दकोश-नोड) + flexbox-उपसमुच्चय लेआउट-इंजन +
// चित्रण-आदेश-सूची + घटना-प्रेषण। कोई pixel यहाँ नहीं खिंचता —
// पुस्तकालय renderer-निरपेक्ष है; `चित्र_सूची()` एक सपाट आदेश-सूची
// देता जिसे कोई भी backend (Win32 GDI, HTML canvas, framebuffer,
// SVG, टर्मिनल) खींच सकता।
//
//   आयात "पुस्तकालय/यूआई.सूत्र";
//
//   कार्य दृश्य() {
//       परत् डिब्बा({"दिशा":"स्तंभ","पैडिंग":१२,"अंतर":८,"पृष्ठ_रंग":"#0f172a"}, [
//           लेख("नमस्ते सूत्र", {"पाठ_आकार":१८,"पाठ_रंग":"#e2e8f0"}),
//           डिब्बा({"दिशा":"पंक्ति","अंतर":८}, [
//               बटन("सहेजो", "क्रिया_सहेजो", {}),
//               बटन("रद्द",  "क्रिया_रद्द",  {}),
//               रिक्ति(१)
//           ])
//       ]);
//   }
//
//   कार्य मुख्य() {
//       शब्दकोश अवस्था = यूआई_अवस्था_नई();
//       शब्दकोश जड़ = दृश्य();
//       सूची आदेश = यूआई_चौखटा(जड़, अवस्था, ६४०, ४८०);
//       // आदेश → अपने renderer को दो
//
//       // घटना आने पर:
//       शब्दकोश फल = घटना_भेजो(जड़, अवस्था, माउस_घटना("छोड़", ३०, २०));
//       सूची संदेश = फल["संदेश"];   // ["क्रिया_सहेजो"] जैसे id
//   }
//
// नोड-आकार:
//   {"किस्म": "डिब्बा"|"लेख"|"बटन"|"रिक्ति",
//    "गुण": { ...शैली/विन्यास... },
//    "बच्चे": [ ...नोड... ],
//    "स्थान": {"बाएँ":_, "ऊपर":_, "चौड़ाई":_, "ऊँचाई":_}}   // लेआउट भरता
//
// गुण (सब वैकल्पिक):
//   दिशा        "स्तंभ"(default) | "पंक्ति"    — container मुख्य-अक्ष
//   अंतर        बच्चों के बीच खाली जगह (px)
//   पैडिंग      भीतरी हाशिया (px, चारों ओर समान)
//   चौड़ाई/ऊँचाई नियत आकार (px) — तो flex-grow लागू नहीं
//   बढ़त        flex-grow भार (पूर्णांक) — बचा main-अक्ष स्थान इसी अनुपात में
//   संरेखण      "तनाव"(default) | "आरंभ" | "मध्य" | "अंत"  — cross-अक्ष
//               (तनाव = बच्चा पूरा cross भरता, जब तक उसका अपना cross-आकार न हो)
//   पृष्ठ_रंग   पृष्ठभूमि (hex पाठ) — न हो तो पारदर्शी
//   किनारा_रंग / किनारा_मोटाई
//   कोना        कोना-त्रिज्या (px)
//   सामग्री     लेख/बटन का पाठ
//   पाठ_रंग / पाठ_आकार   (आकार default १४)
//   क्रिया      बटन: click पर उत्सर्जित संदेश-id
//   अक्षम       बूल — बटन निष्क्रिय (कोई hover/click नहीं)
// ============================================================

// पाठ-चौड़ाई अनुमान (renderer असली माप देगा; यहाँ मोटा estimate) —
// नियत `चौड़ाई` गुण देकर override करो जहाँ सटीकता चाहिए।
कार्य यूआई_पाठ_चौड़ाई(पाठ स, संख्या आकार) {
    परत् (लंबाई(स) * आकार * ६) / १०;
}
कार्य यूआई_पाठ_ऊँचाई(संख्या आकार) {
    परत् (आकार * १४) / १०;
}

// ---- गुण-पाठक (सुरक्षित डिफ़ॉल्ट) ----
कार्य यूआई_गुण_सं(शब्दकोश नोड, पाठ कुं, संख्या डफ) {
    शब्दकोश ग = नोड["गुण"];
    यदि (ग == शून्यम्) { परत् डफ; }
    मान म = ग[कुं];
    यदि (म == शून्यम्) { परत् डफ; }
    परत् म;
}
कार्य यूआई_गुण_पा(शब्दकोश नोड, पाठ कुं, पाठ डफ) {
    शब्दकोश ग = नोड["गुण"];
    यदि (ग == शून्यम्) { परत् डफ; }
    मान म = ग[कुं];
    यदि (म == शून्यम्) { परत् डफ; }
    परत् म;
}
कार्य यूआई_गुण_है(शब्दकोश नोड, पाठ कुं) {
    शब्दकोश ग = नोड["गुण"];
    यदि (ग == शून्यम्) { परत् असत्य; }
    परत् कुंजी_है(ग, कुं);
}

// ============================================================
// विजेट-निर्माता
// ============================================================

कार्य यूआई_नोड(पाठ किस्म, शब्दकोश गुण, सूची बच्चे) {
    शब्दकोश नोड = {};
    नोड["किस्म"] = किस्म;
    यदि (गुण == शून्यम्) { गुण = {}; }
    नोड["गुण"] = गुण;
    यदि (बच्चे == शून्यम्) { बच्चे = []; }
    नोड["बच्चे"] = बच्चे;
    शब्दकोश स्थान = {};
    स्थान["बाएँ"] = ०;
    स्थान["ऊपर"] = ०;
    स्थान["चौड़ाई"] = ०;
    स्थान["ऊँचाई"] = ०;
    नोड["स्थान"] = स्थान;
    परत् नोड;
}

कार्य डिब्बा(शब्दकोश गुण, सूची बच्चे) {
    परत् यूआई_नोड("डिब्बा", गुण, बच्चे);
}

कार्य लेख(पाठ सामग्री, शब्दकोश गुण) {
    यदि (गुण == शून्यम्) { गुण = {}; }
    गुण["सामग्री"] = सामग्री;
    परत् यूआई_नोड("लेख", गुण, []);
}

कार्य बटन(पाठ सामग्री, पाठ क्रिया, शब्दकोश गुण) {
    यदि (गुण == शून्यम्) { गुण = {}; }
    गुण["सामग्री"] = सामग्री;
    गुण["क्रिया"] = क्रिया;
    परत् यूआई_नोड("बटन", गुण, []);
}

// लचीली खाली जगह — बढ़त-भार से main-अक्ष का बचा स्थान सोखती
कार्य रिक्ति(संख्या बढ़त) {
    शब्दकोश गुण = {};
    गुण["बढ़त"] = बढ़त;
    परत् यूआई_नोड("रिक्ति", गुण, []);
}

// ---- वृक्ष-सहायक ----

// क्रिया-id से नोड ढूँढो (पहला मिलान, गहराई-प्रथम) — शून्यम् अगर नहीं
कार्य यूआई_खोजो_क्रिया(शब्दकोश जड़, पाठ क्रिया) {
    यदि (यूआई_गुण_पा(जड़, "क्रिया", "") == क्रिया) { परत् जड़; }
    सूची ब = जड़["बच्चे"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(ब)) {
        मान मिला = यूआई_खोजो_क्रिया(ब[इ], क्रिया);
        यदि (मिला != शून्यम्) { परत् मिला; }
        इ = इ + १;
    }
    परत् शून्यम्;
}

// ============================================================
// लेआउट-इंजन (flexbox उपसमुच्चय) — दो पास: नाप (नीचे→ऊपर) + व्यवस्था (ऊपर→नीचे)
// ============================================================

// नोड का स्वाभाविक आकार दिए अक्ष पर ("मुख्य"/"क्रॉस" नहीं — सीधे "चौड़ाई"/"ऊँचाई")
कार्य यूआई_नाप(शब्दकोश नोड, पाठ अक्ष) {
    यदि (यूआई_गुण_है(नोड, अक्ष)) { परत् यूआई_गुण_सं(नोड, अक्ष, ०); }

    पाठ किस्म = नोड["किस्म"];
    संख्या पैड = यूआई_गुण_सं(नोड, "पैडिंग", ०);

    यदि (किस्म == "रिक्ति") { परत् ०; }

    यदि (किस्म == "लेख" || किस्म == "बटन") {
        संख्या आकार = यूआई_गुण_सं(नोड, "पाठ_आकार", १४);
        पाठ सामग्री = यूआई_गुण_पा(नोड, "सामग्री", "");
        संख्या अतिरिक्त = पैड * २;
        यदि (किस्म == "बटन") { अतिरिक्त = अतिरिक्त + १६; }   // बटन का सहज हाशिया
        यदि (अक्ष == "चौड़ाई") {
            परत् यूआई_पाठ_चौड़ाई(सामग्री, आकार) + अतिरिक्त;
        }
        परत् यूआई_पाठ_ऊँचाई(आकार) + अतिरिक्त;
    }

    // डिब्बा — बच्चों से जोड़ो/अधिकतम लो
    पाठ दिशा = यूआई_गुण_पा(नोड, "दिशा", "स्तंभ");
    पाठ मुख्य_अक्ष = "ऊँचाई";
    यदि (दिशा == "पंक्ति") { मुख्य_अक्ष = "चौड़ाई"; }
    संख्या अंतर = यूआई_गुण_सं(नोड, "अंतर", ०);

    सूची बच्चे = नोड["बच्चे"];
    संख्या भीतरी = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(बच्चे)) {
        संख्या बन = यूआई_नाप(बच्चे[इ], अक्ष);
        यदि (अक्ष == मुख्य_अक्ष) {
            यदि (इ > ०) { भीतरी = भीतरी + अंतर; }
            भीतरी = भीतरी + बन;
        } अन्यथा {
            यदि (बन > भीतरी) { भीतरी = बन; }
        }
        इ = इ + १;
    }
    परत् भीतरी + पैड * २;
}

// व्यवस्था — नोड का "स्थान" पहले से भरा माना जाता; बच्चों का भरो + पुनरावर्तन
कार्य यूआई_व्यवस्था(शब्दकोश नोड) {
    सूची बच्चे = नोड["बच्चे"];
    यदि (लंबाई(बच्चे) == ०) { परत् ०; }

    शब्दकोश स्थान = नोड["स्थान"];
    संख्या पैड = यूआई_गुण_सं(नोड, "पैडिंग", ०);
    संख्या अंतर = यूआई_गुण_सं(नोड, "अंतर", ०);
    पाठ दिशा = यूआई_गुण_पा(नोड, "दिशा", "स्तंभ");
    पाठ संरेखण = यूआई_गुण_पा(नोड, "संरेखण", "तनाव");   // flexbox align-items: stretch

    // अक्ष-कुंजियाँ
    पाठ मुख्य_क = "ऊँचाई"; पाठ क्रॉस_क = "चौड़ाई";
    पाठ मुख्य_आरंभ = "ऊपर"; पाठ क्रॉस_आरंभ = "बाएँ";
    यदि (दिशा == "पंक्ति") {
        मुख्य_क = "चौड़ाई"; क्रॉस_क = "ऊँचाई";
        मुख्य_आरंभ = "बाएँ"; क्रॉस_आरंभ = "ऊपर";
    }

    संख्या भीतरी_मुख्य = स्थान[मुख्य_क] - पैड * २;
    संख्या भीतरी_क्रॉस = स्थान[क्रॉस_क] - पैड * २;

    // पास १: हर बच्चे का नियत/स्वाभाविक मुख्य-आकार + कुल बढ़त
    सूची आकार_सूची = [];
    संख्या कुल_नियत = ०;
    संख्या कुल_बढ़त = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(बच्चे)) {
        संख्या बन = यूआई_नाप(बच्चे[इ], मुख्य_क);
        आकार_सूची = जोड़ें(आकार_सूची, बन);
        कुल_नियत = कुल_नियत + बन;
        यदि (इ > ०) { कुल_नियत = कुल_नियत + अंतर; }
        कुल_बढ़त = कुल_बढ़त + यूआई_गुण_सं(बच्चे[इ], "बढ़त", ०);
        इ = इ + १;
    }

    संख्या बचा = भीतरी_मुख्य - कुल_नियत;
    यदि (बचा < ०) { बचा = ०; }

    // पास २: बढ़त बाँटो (पूर्णांक; अंतिम बढ़ने वाले को शेष)
    यदि (कुल_बढ़त > ०) {
        संख्या दिया = ०;
        संख्या अंतिम_बढ़_सूचकांक = ० - १;
        संख्या ज = ०;
        यावत् (ज < लंबाई(बच्चे)) {
            यदि (यूआई_गुण_सं(बच्चे[ज], "बढ़त", ०) > ०) { अंतिम_बढ़_सूचकांक = ज; }
            ज = ज + १;
        }
        ज = ०;
        यावत् (ज < लंबाई(बच्चे)) {
            संख्या भ = यूआई_गुण_सं(बच्चे[ज], "बढ़त", ०);
            यदि (भ > ०) {
                संख्या हिस्सा = (बचा * भ) / कुल_बढ़त;
                यदि (ज == अंतिम_बढ़_सूचकांक) { हिस्सा = बचा - दिया; }
                आकार_सूची[ज] = आकार_सूची[ज] + हिस्सा;
                दिया = दिया + हिस्सा;
            }
            ज = ज + १;
        }
    }

    // पास ३: स्थान भरो + पुनरावर्तन
    संख्या कर्सर = स्थान[मुख्य_आरंभ] + पैड;
    संख्या क = ०;
    यावत् (क < लंबाई(बच्चे)) {
        शब्दकोश बस = बच्चे[क]["स्थान"];
        संख्या बम = आकार_सूची[क];

        // क्रॉस-अक्ष आकार + स्थिति
        संख्या बक = यूआई_नाप(बच्चे[क], क्रॉस_क);
        संख्या क_ऑफ = ०;
        यदि (संरेखण == "तनाव" && यूआई_गुण_है(बच्चे[क], क्रॉस_क) == असत्य) {
            बक = भीतरी_क्रॉस;
        } अन्यथा यदि (संरेखण == "मध्य") {
            क_ऑफ = (भीतरी_क्रॉस - बक) / २;
        } अन्यथा यदि (संरेखण == "अंत") {
            क_ऑफ = भीतरी_क्रॉस - बक;
        }
        यदि (क_ऑफ < ०) { क_ऑफ = ०; }

        बस[मुख्य_आरंभ] = कर्सर;
        बस[क्रॉस_आरंभ] = स्थान[क्रॉस_आरंभ] + पैड + क_ऑफ;
        बस[मुख्य_क] = बम;
        बस[क्रॉस_क] = बक;

        यूआई_व्यवस्था(बच्चे[क]);

        कर्सर = कर्सर + बम + अंतर;
        क = क + १;
    }
    परत् ०;
}

// पूरा लेआउट — जड़ को दिए चौखटे में बिठाओ
कार्य लेआउट_करो(शब्दकोश जड़, संख्या चौड़ाई, संख्या ऊँचाई) {
    शब्दकोश स्थान = जड़["स्थान"];
    स्थान["बाएँ"] = ०;
    स्थान["ऊपर"] = ०;
    स्थान["चौड़ाई"] = चौड़ाई;
    स्थान["ऊँचाई"] = ऊँचाई;
    यूआई_व्यवस्था(जड़);
    परत् ०;
}

// ============================================================
// चित्रण — विजेट-वृक्ष → सपाट आदेश-सूची
// ============================================================
// आदेश-आकार:
//   {"आदेश":"आयत",   "क्ष":_,"य":_,"चौड़ाई":_,"ऊँचाई":_,"रंग":_,"कोना":_}
//   {"आदेश":"किनारा","क्ष":_,"य":_,"चौड़ाई":_,"ऊँचाई":_,"रंग":_,"मोटाई":_,"कोना":_}
//   {"आदेश":"पाठ",   "क्ष":_,"य":_,"सामग्री":_,"रंग":_,"आकार":_}

कार्य यूआई_आयत_आदेश(संख्या क्ष, संख्या य, संख्या चौ, संख्या ऊँ, पाठ रंग, संख्या कोना) {
    शब्दकोश आ = {};
    आ["आदेश"] = "आयत";
    आ["क्ष"] = क्ष; आ["य"] = य;
    आ["चौड़ाई"] = चौ; आ["ऊँचाई"] = ऊँ;
    आ["रंग"] = रंग; आ["कोना"] = कोना;
    परत् आ;
}

कार्य यूआई_नोड_चित्र(शब्दकोश नोड, शब्दकोश अवस्था, सूची बाहर) {
    शब्दकोश स्थान = नोड["स्थान"];
    संख्या क्ष = स्थान["बाएँ"];
    संख्या य = स्थान["ऊपर"];
    संख्या चौ = स्थान["चौड़ाई"];
    संख्या ऊँ = स्थान["ऊँचाई"];
    पाठ किस्म = नोड["किस्म"];
    संख्या कोना = यूआई_गुण_सं(नोड, "कोना", ०);

    // पृष्ठभूमि
    पाठ पृष्ठ = यूआई_गुण_पा(नोड, "पृष्ठ_रंग", "");
    पाठ क्रिया = यूआई_गुण_पा(नोड, "क्रिया", "");
    मान अक्षम = यूआई_गुण_सं(नोड, "अक्षम", ०);

    यदि (किस्म == "बटन") {
        // बटन: अवस्था-अनुसार पृष्ठभूमि
        पाठ बटन_रंग = यूआई_गुण_पा(नोड, "पृष्ठ_रंग", "#334155");
        यदि (अक्षम == १ || अक्षम == सत्य) {
            बटन_रंग = यूआई_गुण_पा(नोड, "अक्षम_रंग", "#1f2937");
        } अन्यथा यदि (अवस्था["दबा"] == क्रिया && क्रिया != "") {
            बटन_रंग = यूआई_गुण_पा(नोड, "दबा_रंग", "#1d4ed8");
        } अन्यथा यदि (अवस्था["होवर"] == क्रिया && क्रिया != "") {
            बटन_रंग = यूआई_गुण_पा(नोड, "होवर_रंग", "#3b82f6");
        }
        बाहर = जोड़ें(बाहर, यूआई_आयत_आदेश(क्ष, य, चौ, ऊँ, बटन_रंग, कोना));
    } अन्यथा यदि (पृष्ठ != "") {
        बाहर = जोड़ें(बाहर, यूआई_आयत_आदेश(क्ष, य, चौ, ऊँ, पृष्ठ, कोना));
    }

    // किनारा
    पाठ किनारा = यूआई_गुण_पा(नोड, "किनारा_रंग", "");
    यदि (किनारा != "") {
        शब्दकोश कआ = {};
        कआ["आदेश"] = "किनारा";
        कआ["क्ष"] = क्ष; कआ["य"] = य;
        कआ["चौड़ाई"] = चौ; कआ["ऊँचाई"] = ऊँ;
        कआ["रंग"] = किनारा;
        कआ["मोटाई"] = यूआई_गुण_सं(नोड, "किनारा_मोटाई", १);
        कआ["कोना"] = कोना;
        बाहर = जोड़ें(बाहर, कआ);
    }

    // पाठ
    यदि (किस्म == "लेख" || किस्म == "बटन") {
        पाठ सामग्री = यूआई_गुण_पा(नोड, "सामग्री", "");
        संख्या आकार = यूआई_गुण_सं(नोड, "पाठ_आकार", १४);
        पाठ रंग = यूआई_गुण_पा(नोड, "पाठ_रंग", "#e2e8f0");
        संख्या पठ_चौ = यूआई_पाठ_चौड़ाई(सामग्री, आकार);
        संख्या पठ_ऊँ = यूआई_पाठ_ऊँचाई(आकार);
        // बटन/लेख के भीतर पाठ केंद्रित (क्षैतिज) + ऊर्ध्व-केंद्रित
        पाठ पक्ष = यूआई_गुण_पा(नोड, "पाठ_संरेखण", "मध्य");
        संख्या पक्ष_क्ष = क्ष + (चौ - पठ_चौ) / २;
        यदि (पक्ष == "आरंभ") { पक्ष_क्ष = क्ष + यूआई_गुण_सं(नोड, "पैडिंग", ०); }
        यदि (पक्ष == "अंत") { पक्ष_क्ष = क्ष + चौ - पठ_चौ - यूआई_गुण_सं(नोड, "पैडिंग", ०); }
        यदि (पक्ष_क्ष < क्ष) { पक्ष_क्ष = क्ष; }
        शब्दकोश पआ = {};
        पआ["आदेश"] = "पाठ";
        पआ["क्ष"] = पक्ष_क्ष;
        पआ["य"] = य + (ऊँ - पठ_ऊँ) / २;
        पआ["सामग्री"] = सामग्री;
        पआ["रंग"] = रंग;
        पआ["आकार"] = आकार;
        बाहर = जोड़ें(बाहर, पआ);
    }

    // बच्चे
    सूची बच्चे = नोड["बच्चे"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(बच्चे)) {
        बाहर = यूआई_नोड_चित्र(बच्चे[इ], अवस्था, बाहर);
        इ = इ + १;
    }
    परत् बाहर;
}

// जड़ → चित्रण-आदेश-सूची (लेआउट_करो पहले चलना चाहिए)
कार्य चित्र_सूची(शब्दकोश जड़, शब्दकोश अवस्था) {
    सूची बाहर = [];
    परत् यूआई_नोड_चित्र(जड़, अवस्था, बाहर);
}

// सुविधा: लेआउट + चित्रण एक साथ
कार्य यूआई_चौखटा(शब्दकोश जड़, शब्दकोश अवस्था, संख्या चौड़ाई, संख्या ऊँचाई) {
    लेआउट_करो(जड़, चौड़ाई, ऊँचाई);
    परत् चित्र_सूची(जड़, अवस्था);
}

// ============================================================
// घटना-प्रेषण — closures नहीं, तो संदेश-id सूची लौटाते हैं (Elm-शैली)
// ============================================================

कार्य यूआई_अवस्था_नई() {
    शब्दकोश अ = {};
    अ["होवर"] = "";
    अ["दबा"] = "";
    अ["केंद्रित"] = "";
    परत् अ;
}

// घटना-रिकॉर्ड निर्माता
कार्य माउस_घटना(पाठ प्रकार, संख्या क्ष, संख्या य) {
    शब्दकोश घ = {};
    घ["प्रकार"] = प्रकार;   // "गति" | "दबाव" | "छोड़"
    घ["क्ष"] = क्ष;
    घ["य"] = य;
    परत् घ;
}

कार्य यूआई_बिंदु_भीतर(शब्दकोश स्थान, संख्या क्ष, संख्या य) {
    संख्या ब = स्थान["बाएँ"];
    संख्या ऊ = स्थान["ऊपर"];
    यदि (क्ष < ब) { परत् असत्य; }
    यदि (य < ऊ) { परत् असत्य; }
    यदि (क्ष >= ब + स्थान["चौड़ाई"]) { परत् असत्य; }
    यदि (य >= ऊ + स्थान["ऊँचाई"]) { परत् असत्य; }
    परत् सत्य;
}

// बिंदु के नीचे सबसे-ऊपरी क्रिया-वाला नोड की क्रिया-id ("" अगर कोई नहीं)।
// बच्चे बाद-से-पहले (z-क्रम) — बाद वाला ऊपर खिंचा माना।
कार्य यूआई_हिट(शब्दकोश नोड, संख्या क्ष, संख्या य) {
    यदि (यूआई_बिंदु_भीतर(नोड["स्थान"], क्ष, य) == असत्य) { परत् ""; }
    सूची बच्चे = नोड["बच्चे"];
    संख्या इ = लंबाई(बच्चे) - १;
    यावत् (इ >= ०) {
        पाठ अंदर = यूआई_हिट(बच्चे[इ], क्ष, य);
        यदि (अंदर != "") { परत् अंदर; }
        इ = इ - १;
    }
    पाठ क्रिया = यूआई_गुण_पा(नोड, "क्रिया", "");
    मान अक्षम = यूआई_गुण_सं(नोड, "अक्षम", ०);
    यदि (क्रिया != "" && अक्षम != १ && अक्षम != सत्य) { परत् क्रिया; }
    परत् "";
}

// घटना प्रेषित करो — अवस्था स्थान-पर बदलती, संदेश-सूची लौटती
//   फल = {"अवस्था": <वही अवस्था>, "संदेश": [क्रिया-id ...]}
कार्य घटना_भेजो(शब्दकोश जड़, शब्दकोश अवस्था, शब्दकोश घ) {
    सूची संदेश = [];
    पाठ प्रकार = घ["प्रकार"];
    पाठ हिट = यूआई_हिट(जड़, घ["क्ष"], घ["य"]);

    यदि (प्रकार == "गति") {
        अवस्था["होवर"] = हिट;
    } अन्यथा यदि (प्रकार == "दबाव") {
        अवस्था["दबा"] = हिट;
        अवस्था["होवर"] = हिट;
        यदि (हिट != "") { अवस्था["केंद्रित"] = हिट; }
    } अन्यथा यदि (प्रकार == "छोड़") {
        यदि (हिट != "" && हिट == अवस्था["दबा"]) {
            संदेश = जोड़ें(संदेश, हिट);
        }
        अवस्था["दबा"] = "";
        अवस्था["होवर"] = हिट;
    }

    शब्दकोश फल = {};
    फल["अवस्था"] = अवस्था;
    फल["संदेश"] = संदेश;
    परत् फल;
}

// माउस दायरे-बाहर — hover/press साफ़ करो
कार्य यूआई_बाहर_गया(शब्दकोश अवस्था) {
    अवस्था["होवर"] = "";
    अवस्था["दबा"] = "";
    परत् ०;
}
