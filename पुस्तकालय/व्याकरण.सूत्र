    }
    परत् असत्य;
}

// ============================================================
// २. प्रत्याहार निर्माण (Pratyahara Generation)
// "आदिरन्त्येन सहेता" (१.१.७१)
// ============================================================

कार्य प्रत्याहार_वर्ण_सूची(पाठ प्रत्याहार_नाम) {
    सूची परिणाम = [];
    संख्या ल = लंबाई(प्रत्याहार_नाम);
    यदि (ल < २) { परत् परिणाम; }
    
    // आदि वर्ण एवं इत् वर्ण निकालना
    पाठ आदि = उपखंड(प्रत्याहार_नाम, ०, १);
    पाठ अन्त्य = उपखंड(प्रत्याहार_नाम, १, ल);
    
    सूची सूत्राणि = माहेश्वर_सूत्राणि_सूची();
    मान प्रारंभ_मिला = असत्य;
    मान समाप्त_हुआ = असत्य;
    
    संख्या सइ = ०;
    यावत् (सइ < लंबाई(सूत्राणि) && न समाप्त_हुआ) {
        सूची सूत्र = सूत्राणि[सइ];
        संख्या वि = ०;
        यावत् (वि < लंबाई(सूत्र) && न समाप्त_हुआ) {
            पाठ वर्ण = सूत्र[वि];
            मान इत्_है = माहेश्वर_इत्_वर्ण(वर्ण);
            
            यदि (न प्रारंभ_मिला) {
                यदि (वर्ण == आदि) {
                    प्रारंभ_मिला = सत्य;
                    परिणाम = जोड़ें(परिणाम, वर्ण);
                }
            } अन्यथा {
                यदि (इत्_है) {
                    यदि (वर्ण == अन्त्य) {
                        समाप्त_हुआ = सत्य;
                        विरामः;
                    }
                } अन्यथा {
                    परिणाम = जोड़ें(परिणाम, वर्ण);
                }
            }
            वि = वि + १;
        }
        सइ = सइ + १;
    }
    
    परत् परिणाम;
}

// क्या वर्ण निर्दिष्ट प्रत्याहार में है?
कार्य प्रत्याहारे_अस्ति(पाठ प्रत्याहार_नाम, पाठ वर्ण) {
    सूची वर्ण_सूची = प्रत्याहार_वर्ण_सूची(प्रत्याहार_नाम);
    संख्या इ = ०;
    यावत् (इ < लंबाई(वर्ण_सूची)) {
        यदि (वर्ण_सूची[इ] == वर्ण) { परत् सत्य; }
        इ = इ + १;
    }
    परत् असत्य;
}

// ============================================================
// ३. स्वर एवं मात्रा संबंध
