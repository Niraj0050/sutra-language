// अनुनासिक वर्ण (ङ, ञ, ण, न, म)
कार्य अनुनासिक_वर्ण_है(पाठ वर्ण) {
    यदि (वर्ण == "ङ" || वर्ण == "ञ" || वर्ण == "ण" || वर्ण == "न" || वर्ण == "म") {
        परत् सत्य;
    }
