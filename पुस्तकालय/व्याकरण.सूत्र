}

// अघोष व्यंजन (खर् प्रत्याहार: क, ख, च, छ, ट, ठ, त, थ, प, फ, श, ष, स)
कार्य अघोष_व्यंजन_है(पाठ वर्ण) {
    यदि (वर्ण == "क" || वर्ण == "ख" || वर्ण == "च" || वर्ण == "छ" || वर्ण == "ट" || वर्ण == "ठ" || वर्ण == "त" || वर्ण == "थ" || वर्ण == "प" || वर्ण == "फ" || वर्ण == "श" || वर्ण == "ष" || वर्ण == "स") {
