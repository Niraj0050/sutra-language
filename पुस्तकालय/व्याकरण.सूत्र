कार्य स्वर_से_मात्रा(पाठ स्वर) {
    यदि (स्वर == "अ") { परत् ""; }
    यदि (स्वर == "आ") { परत् "ा"; }
    यदि (स्वर == "इ") { परत् "ि"; }
    यदि (स्वर == "ई") { परत् "ी"; }
    यदि (स्वर == "उ") { परत् "ु"; }
    यदि (स्वर == "ऊ") { परत् "ू"; }
    यदि (स्वर == "ऋ") { परत् "ृ"; }
    यदि (स्वर == "ॠ") { परत् "ॄ"; }
    यदि (स्वर == "ऌ") { परत् "ॢ"; }
    यदि (स्वर == "ए") { परत् "े"; }
    यदि (स्वर == "ऐ") { परत् "ै"; }
    यदि (स्वर == "ओ") { परत् "ो"; }
    यदि (स्वर == "औ") { परत् "ौ"; }
    परत् "";
}

कार्य मात्रा_से_स्वर(पाठ मात्रा) {
    यदि (मात्रा == "ा") { परत् "आ"; }
    यदि (मात्रा == "ि") { परत् "इ"; }
    यदि (मात्रा == "ी") { परत् "ई"; }
    यदि (मात्रा == "ु") { परत् "उ"; }
    यदि (मात्रा == "ू") { परत् "ऊ"; }
    यदि (मात्रा == "ृ") { परत् "ऋ"; }
    यदि (मात्रा == "ॄ") { परत् "ॠ"; }
    यदि (मात्रा == "ॢ") { परत् "ऌ"; }
    यदि (मात्रा == "े") { परत् "ए"; }
    यदि (मात्रा == "ै") { परत् "ऐ"; }
    यदि (मात्रा == "ो") { परत् "ओ"; }
    यदि (मात्रा == "ौ") { परत् "औ"; }
    परत् "अ";
}

कार्य स्वर_वर्ण_है(पाठ वर्ण) {
    यदि (वर्ण == "अ" || वर्ण == "आ" || वर्ण == "इ" || वर्ण == "ई" || वर्ण == "उ" || वर्ण == "ऊ" || वर्ण == "ऋ" || वर्ण == "ॠ" || वर्ण == "ऌ" || वर्ण == "ए" || वर्ण == "ऐ" || वर्ण == "ओ" || वर्ण == "औ") {
        परत् सत्य;
    }
    परत् असत्य;
}

// व्यंजन और स्वर का संयोजन (उदा. "य्" + "ए" → "ये", "व्" + "आ" → "वा")
कार्य व्यंजन_स्वर_संयोग(पाठ हलन्त_व्यंजन, पाठ स्वर) {
    संख्या ल = लंबाई(हलन्त_व्यंजन);
    पाठ शुद्ध_व्यंजन = हलन्त_व्यंजन;
    यदि (ल > ० && उपखंड(हलन्त_व्यंजन, ल - १, ल) == "्") {
        शुद्ध_व्यंजन = उपखंड(हलन्त_व्यंजन, ०, ल - १);
    }
    पाठ मात्रा = स्वर_से_मात्रा(स्वर);
    परत् शुद्ध_व्यंजन + मात्रा;
}

// घोष व्यंजन (हश् प्रत्याहार: ग, घ, ङ, ज, झ, ञ, ड, ढ, ण, द, ध, न, ब, भ, म, य, र, ल, व, ह)
कार्य घोष_व्यंजन_है(पाठ वर्ण) {
