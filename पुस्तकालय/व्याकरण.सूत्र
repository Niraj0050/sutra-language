    फल["कारक"] = "अन्य";
    फल["विभक्ति"] = विवरण;
    
    यदि (प्रकार == "तिङन्त") {
        फल["कारक"] = "क्रियापद";
        परत् फल;
    }
    
    यदि (खोजें(विवरण, "द्वितीया") >= ०) {
        फल["कारक"] = "कर्म";
    } अन्यथा यदि (खोजें(विवरण, "प्रथमा") >= ०) {
        फल["कारक"] = "कर्ता";
    } अन्यथा यदि (खोजें(विवरण, "तृतीया") >= ०) {
        फल["कारक"] = "करण";
    } अन्यथा यदि (खोजें(विवरण, "चतुर्थी") >= ०) {
        फल["कारक"] = "सम्प्रदान";
    } अन्यथा यदि (खोजें(विवरण, "पञ्चमी") >= ०) {
        फल["कारक"] = "अपादान";
    } अन्यथा यदि (खोजें(विवरण, "षष्ठी") >= ०) {
        फल["कारक"] = "सम्बन्ध";
    } अन्यथा यदि (खोजें(विवरण, "सप्तमी") >= ०) {
        फल["कारक"] = "अधिकरण";
    }
    
    परत् फल;
}

कार्य वाक्य_अन्वय_विश्लेषण(पाठ वाक्य) {
    सूची पदानि = विभाजित(वाक्य, " ");
    सूची पद_कारक_सूची = [];
    
    पाठ कर्ता_पद = "";
    पाठ कर्म_पद = "";
    पाठ करण_पद = "";
    पाठ अधिकरण_पद = "";
    पाठ क्रिया_पद = "";
    
    संख्या इ = ०;
    यावत् (इ < लंबाई(पदानि)) {
        पाठ पद = पदानि[इ];
        यदि (पद != "") {
            शब्दकोश क = कारक_निर्णय(पद);
            पद_कारक_सूची = जोड़ें(पद_कारक_सूची, क);
            
            यदि (क["कारक"] == "कर्ता" && कर्ता_पद == "") {
                कर्ता_पद = पद;
            } अन्यथा यदि (क["कारक"] == "कर्म" && कर्म_पद == "") {
                कर्म_पद = पद;
            } अन्यथा यदि (क["कारक"] == "करण" && करण_पद == "") {
                करण_पद = पद;
            } अन्यथा यदि (क["कारक"] == "अधिकरण" && अधिकरण_पद == "") {
                अधिकरण_पद = पद;
            } अन्यथा यदि (क["कारक"] == "क्रियापद" && क्रिया_पद == "") {
                क्रिया_पद = पद;
            }
        }
        इ = इ + १;
    }
    
    // पाणिनीय/आगम अन्वय क्रम: कर्ता + अधिकरण + करण + कर्म + क्रिया
    सूची अन्वय_क्रम = [];
    यदि (कर्ता_पद != "") { अन्वय_क्रम = जोड़ें(अन्वय_क्रम, कर्ता_पद); }
    यदि (अधिकरण_पद != "") { अन्वय_क्रम = जोड़ें(अन्वय_क्रम, अधिकरण_पद); }
    यदि (करण_पद != "") { अन्वय_क्रम = जोड़ें(अन्वय_क्रम, करण_पद); }
    यदि (कर्म_पद != "") { अन्वय_क्रम = जोड़ें(अन्वय_क्रम, कर्म_पद); }
    यदि (क्रिया_पद != "") { अन्वय_क्रम = जोड़ें(अन्वय_क्रम, क्रिया_पद); }
    
    शब्दकोश फल = {};
    फल["मूल_वाक्य"] = वाक्य;
    फल["पदानि"] = पद_कारक_सूची;
    फल["अन्वय_वाक्य"] = संयोजित(अन्वय_क्रम, " ");
    फल["कर्ता"] = कर्ता_पद;
    फल["कर्म"] = कर्म_पद;
    फल["करण"] = करण_पद;
    फल["अधिकरण"] = अधिकरण_पद;
    फल["क्रिया"] = क्रिया_पद;
    परत् फल;
}

