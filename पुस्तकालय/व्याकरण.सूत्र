}

// पाठ अंत जाँच
कार्य पाठ_अंत_है(पाठ स, पाठ अंत) {
    संख्या ल1 = लंबाई(स);
    संख्या ल2 = लंबाई(अंत);
    यदि (ल1 < ल2) { परत् असत्य; }
    परत् उपखंड(स, ल1 - ल2, ल1) == अंत;
}

// पाठ प्रारंभ जाँच
कार्य पाठ_प्रारंभ_है(पाठ स, पाठ आदि) {
    संख्या ल1 = लंबाई(स);
    संख्या ल2 = लंबाई(आदि);
    यदि (ल1 < ल2) { परत् असत्य; }
    परत् उपखंड(स, ०, ल2) == आदि;
}

