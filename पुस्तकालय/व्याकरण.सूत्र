    सूची कुंज्यः = कुंजियाँ(कोश);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुंज्यः)) {
        पाठ क = कुंज्यः[इ];
        यदि (कोश[क]["विलोम"] == शब्द) {
            परत् क;
        }
        इ = इ + १;
    }
    परत् "";
}

कार्य पर्याय_अस्ति(पाठ शब्द१, पाठ शब्द२) {
    यदि (शब्द१ == शब्द२) { परत् सत्य; }
    सूची पर्यायाः = पर्याय_सूची(शब्द१);
    संख्या इ = ०;
    यावत् (इ < लंबाई(पर्यायाः)) {
