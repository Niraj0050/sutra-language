कार्य व्युत्पत्ति_विघटन(पाठ पद) {
    शब्दकोश फल = {};
    फल["पद"] = पद;
    फल["उपसर्ग"] = "";
    फल["मूल_प्रकृति"] = "";
    फल["प्रत्यय"] = "";
    फल["विभक्ति"] = "";
    
    शब्दकोश उप_वि = उपसर्ग_विश्लेषण(पद);
    यदि (उप_वि["उपसर्ग"] != "") {
        फल["उपसर्ग"] = उप_वि["उपसर्ग"];
    }
    
    शब्दकोश प्र_वि = प्रत्यय_विश्लेषण(पद);
    यदि (प्र_वि["प्रत्यय"] != "") {
        फल["प्रत्यय"] = प्र_वि["प्रत्यय"];
    }
    
    शब्दकोश मूल_वि = शब्द_मूलरूप_विश्लेषण(पद);
    फल["मूल_प्रकृति"] = मूल_वि["मूलरूप"];
    फल["विभक्ति"] = मूल_वि["विवरण"];
    
    परत् फल;
}

कार्य संस्कृत_पद_विश्लेषण(पाठ पद) {
    शब्दकोश फल = {};
    फल["पद"] = पद;
    
    शब्दकोश व्यु = व्युत्पत्ति_विघटन(पद);
    फल["उपसर्ग"] = व्यु["उपसर्ग"];
    फल["प्रत्यय"] = व्यु["प्रत्यय"];
    फल["मूलरूप"] = व्यु["मूल_प्रकृति"];
    फल["विभक्ति"] = व्यु["विभक्ति"];
    
    शब्दकोश का = कारक_निर्णय(पद);
    फल["कारक"] = का["कारक"];
    
    पाठ अन्वेष्य = व्यु["मूल_प्रकृति"];
    यदि (अन्वेष्य == "") { अन्वेष्य = पद; }
    फल["पर्याय"] = पर्याय_सूची(अन्वेष्य);
    फल["विलोम"] = विलोम_शब्द(अन्वेष्य);
    
    परत् फल;
}
