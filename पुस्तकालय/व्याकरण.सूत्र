// पद का अंतिम स्वर और मूल तना (Stem) निकालना
कार्य पद_अंतिम_स्वर_विश्लेषण(पाठ पद) {
    शब्दकोश फल = {};
    संख्या ल = लंबाई(पद);
    यदि (ल == ०) {
        फल["तना"] = "";
        फल["अंतिम_स्वर"] = "";
        फल["हलन्त_है"] = असत्य;
        परत् फल;
    }
    
    पाठ अंतिम_वर्ण = उपखंड(पद, ल - १, ल);
    
    // १. यदि पद हलन्त पर समाप्त होता है (उदा. "सत्", "भगवत्")
    यदि (अंतिम_वर्ण == "्") {
        फल["तना"] = पद;
        फल["अंतिम_स्वर"] = "";
        फल["हलन्त_है"] = सत्य;
        परत् फल;
    }
    
    // २. यदि पद किसी मात्रा पर समाप्त होता है (उदा. "विद्या", "कवि", "भानु")
    पाठ स्वर = मात्रा_से_स्वर(अंतिम_वर्ण);
    यदि (स्वर != "अ" || अंतिम_वर्ण == "ा") {
        फल["तना"] = उपखंड(पद, ०, ल - १) + "्";
        फल["अंतिम_स्वर"] = स्वर;
        फल["हलन्त_है"] = असत्य;
        परत् फल;
    }
    
    // ३. यदि अंतिम वर्ण स्वतंत्र स्वर है
    यदि (स्वर_वर्ण_है(अंतिम_वर्ण)) {
        फल["तना"] = उपखंड(पद, ०, ल - १);
        फल["अंतिम_स्वर"] = अंतिम_वर्ण;
        फल["हलन्त_है"] = असत्य;
        परत् फल;
    }
    
    // ४. सामान्य व्यंजन (उदा. "हिम", "देव") — अंत में निहित 'अ' स्वर
    फल["तना"] = पद + "्";
    फल["अंतिम_स्वर"] = "अ";
    फल["हलन्त_है"] = असत्य;
    परत् फल;
}

// पद का प्रथम स्वर और प्रत्यय (Suffix) निकालना
कार्य पद_आरंभिक_स्वर_विश्लेषण(पाठ पद) {
    शब्दकोश फल = {};
    संख्या ल = लंबाई(पद);
    यदि (ल == ०) {
        फल["प्रथम_स्वर"] = "";
        फल["शेष_भाग"] = "";
        परत् फल;
    }
    
    पाठ प्रथम_वर्ण = उपखंड(पद, ०, १);
    यदि (स्वर_वर्ण_है(प्रथम_वर्ण)) {
        फल["प्रथम_स्वर"] = प्रथम_वर्ण;
        फल["शेष_भाग"] = उपखंड(पद, १, ल);
        परत् फल;
    }
    
    फल["प्रथम_स्वर"] = "";
    फल["शेष_भाग"] = पद;
    परत् फल;
}

// ============================================================
// ५. पाणिनीय संधि-नियम निर्णय (Sandhi Rules Engine)
// ============================================================

कार्य संधि_नियम_निर्णय(पाठ स्वर१, पाठ स्वर२) {
    शब्दकोश फल = {};
    फल["नियम"] = "अज्ञात";
    फल["सूत्र"] = "";
    फल["परिणाम_ध्वनि"] = "";
    
    // १. अकः सवर्णे दीर्घः (६.१.१०१) — दीर्घ संधि
    // अ/आ + अ/आ → आ, इ/ई + इ/ई → ई, उ/ऊ + उ/ऊ → ऊ, ऋ/ॠ + ऋ/ॠ → ॠ
    यदि ((स्वर१ == "अ" || स्वर१ == "आ") && (स्वर२ == "अ" || स्वर२ == "आ")) {
        फल["नियम"] = "दीर्घ";
        फल["सूत्र"] = "अकः सवर्णे दीर्घः (६.१.१०१)";
        फल["परिणाम_ध्वनि"] = "आ";
        परत् फल;
    }
    यदि ((स्वर१ == "इ" || स्वर१ == "ई") && (स्वर२ == "इ" || स्वर२ == "ई")) {
        फल["नियम"] = "दीर्घ";
        फल["सूत्र"] = "अकः सवर्णे दीर्घः (६.१.१०१)";
        फल["परिणाम_ध्वनि"] = "ई";
        परत् फल;
    }
    यदि ((स्वर१ == "उ" || स्वर१ == "ऊ") && (स्वर२ == "उ" || स्वर२ == "ऊ")) {
        फल["नियम"] = "दीर्घ";
        फल["सूत्र"] = "अकः सवर्णे दीर्घः (६.१.१०१)";
        फल["परिणाम_ध्वनि"] = "ऊ";
        परत् फल;
    }
    यदि ((स्वर१ == "ऋ" || स्वर१ == "ॠ") && (स्वर२ == "ऋ" || स्वर२ == "ॠ")) {
        फल["नियम"] = "दीर्घ";
        फल["सूत्र"] = "अकः सवर्णे दीर्घः (६.१.१०१)";
        फल["परिणाम_ध्वनि"] = "ॠ";
        परत् फल;
    }
    
    // २. आद्गुणः (६.१.८७) — गुण संधि
    // अ/आ + इ/ई → ए, अ/आ + उ/ऊ → ओ, अ/आ + ऋ/ॠ → अर्, अ/आ + ऌ → अल्
    यदि (स्वर१ == "अ" || स्वर१ == "आ") {
        यदि (स्वर२ == "इ" || स्वर२ == "ई") {
            फल["नियम"] = "गुण";
            फल["सूत्र"] = "आद्गुणः (६.१.८७)";
            फल["परिणाम_ध्वनि"] = "ए";
            परत् फल;
        }
        यदि (स्वर२ == "उ" || स्वर२ == "ऊ") {
            फल["नियम"] = "गुण";
            फल["सूत्र"] = "आद्गुणः (६.१.८७)";
            फल["परिणाम_ध्वनि"] = "ओ";
            परत् फल;
        }
        यदि (स्वर२ == "ऋ" || स्वर२ == "ॠ") {
            फल["नियम"] = "गुण";
            फल["सूत्र"] = "आद्गुणः (६.१.८७)";
            फल["परिणाम_ध्वनि"] = "अर्";
            परत् फल;
        }
        यदि (स्वर२ == "ऌ") {
            फल["नियम"] = "गुण";
            फल["सूत्र"] = "आद्गुणः (६.१.८७)";
            फल["परिणाम_ध्वनि"] = "अल्";
            परत् फल;
        }
    }
    
    // ३. वृद्धिरेचि (६.१.८८) — वृद्धि संधि
    // अ/आ + ए/ऐ → ऐ, अ/आ + ओ/औ → औ
    यदि (स्वर१ == "अ" || स्वर१ == "आ") {
        यदि (स्वर२ == "ए" || स्वर२ == "ऐ") {
            फल["नियम"] = "वृद्धि";
            फल["सूत्र"] = "वृद्धिरेचि (६.१.८८)";
            फल["परिणाम_ध्वनि"] = "ऐ";
            परत् फल;
        }
        यदि (स्वर२ == "ओ" || स्वर२ == "औ") {
            फल["नियम"] = "वृद्धि";
            फल["सूत्र"] = "वृद्धिरेचि (६.१.८८)";
            फल["परिणाम_ध्वनि"] = "औ";
            परत् फल;
        }
    }
    
    // ४. इको यणचि (६.१.७७) — यण् संधि
    // इ/ई + असमान स्वर → य् + स्वर
    // उ/ऊ + असमान स्वर → व् + स्वर
    // ऋ/ॠ + असमान स्वर → र् + स्वर
    // ऌ + असमान स्वर → ल् + स्वर
    यदि (स्वर१ == "इ" || स्वर१ == "ई") {
        यदि (स्वर२ != "इ" && स्वर२ != "ई") {
            फल["नियम"] = "यण्";
            फल["सूत्र"] = "इको यणचि (६.१.७७)";
            फल["परिणाम_ध्वनि"] = व्यंजन_स्वर_संयोग("य्", स्वर२);
            परत् फल;
        }
    }
    यदि (स्वर१ == "उ" || स्वर१ == "ऊ") {
        यदि (स्वर२ != "उ" && स्वर२ != "ऊ") {
            फल["नियम"] = "यण्";
            फल["सूत्र"] = "इको यणचि (६.१.७७)";
            फल["परिणाम_ध्वनि"] = व्यंजन_स्वर_संयोग("व्", स्वर२);
            परत् फल;
        }
    }
    यदि (स्वर१ == "ऋ" || स्वर१ == "ॠ") {
        यदि (स्वर२ != "ऋ" && स्वर२ != "ॠ") {
            फल["नियम"] = "यण्";
            फल["सूत्र"] = "इको यणचि (६.१.७७)";
            फल["परिणाम_ध्वनि"] = व्यंजन_स्वर_संयोग("र्", स्वर२);
            परत् फल;
        }
    }
    यदि (स्वर१ == "ऌ") {
        यदि (स्वर२ != "ऌ") {
            फल["नियम"] = "यण्";
            फल["सूत्र"] = "इको यणचि (६.१.७७)";
            फल["परिणाम_ध्वनि"] = व्यंजन_स्वर_संयोग("ल्", स्वर२);
            परत् फल;
        }
    }
    
    // ५. एचोऽयवायावः (६.१.७८) — अयादि संधि
    // ए + स्वर → अय् + स्वर
    // ओ + स्वर → अव् + स्वर
    // ऐ + स्वर → आय् + स्वर
    // औ + स्वर → आव् + स्वर
    यदि (स्वर१ == "ए") {
        फल["नियम"] = "अयादि";
        फल["सूत्र"] = "एचोऽयवायावः (६.१.७८)";
        फल["परिणाम_ध्वनि"] = "अ" + व्यंजन_स्वर_संयोग("य्", स्वर२);
        परत् फल;
    }
    यदि (स्वर१ == "ओ") {
        फल["नियम"] = "अयादि";
        फल["सूत्र"] = "एचोऽयवायावः (६.१.७८)";
        फल["परिणाम_ध्वनि"] = "अ" + व्यंजन_स्वर_संयोग("व्", स्वर२);
        परत् फल;
    }
    यदि (स्वर१ == "ऐ") {
        फल["नियम"] = "अयादि";
        फल["सूत्र"] = "एचोऽयवायावः (६.१.७८)";
        फल["परिणाम_ध्वनि"] = "आ" + व्यंजन_स्वर_संयोग("य्", स्वर२);
        परत् फल;
    }
    यदि (स्वर१ == "औ") {
        फल["नियम"] = "अयादि";
        फल["सूत्र"] = "एचोऽयवायावः (६.१.७८)";
        फल["परिणाम_ध्वनि"] = "आ" + व्यंजन_स्वर_संयोग("व्", स्वर२);
        परत् फल;
    }
    
    परत् फल;
}

// ============================================================
// ६. संधि-संयोजन (Sandhi Formation)
// ============================================================

कार्य तना_मात्रा_जोड़ो(पाठ तना, पाठ ध्वनि) {
    // यदि तना हलन्त पर समाप्त होता है (उदा. "हिम्")
    संख्या ल = लंबाई(तना);
    यदि (ल > ० && उपखंड(तना, ल - १, ल) == "्") {
        पाठ शुद्ध_तना = उपखंड(तना, ०, ल - १);
        
        // ध्वनि का प्रथम वर्ण स्वर हो तो मात्रा बनेगी
        पाठ प्रथम = उपखंड(ध्वनि, ०, १);
        पाठ शेष = "";
        यदि (लंबाई(ध्वनि) > १) {
            शेष = उपखंड(ध्वनि, १, लंबाई(ध्वनि));
        }
        
        यदि (स्वर_वर्ण_है(प्रथम)) {
            पाठ मात्रा = स्वर_से_मात्रा(प्रथम);
            परत् शुद्ध_तना + मात्रा + शेष;
        }
    }
    
    परत् तना + ध्वनि;
}

कार्य संधि_संयोजन(पाठ पूर्व_पद, पाठ पर_पद) {
    संख्या पूर्व_ल = लंबाई(पूर्व_पद);
    संख्या पर_ल = लंबाई(पर_पद);
    यदि (पूर्व_ल == ०) { परत् पर_पद; }
    यदि (पर_ल == ०) { परत् पूर्व_पद; }

    पाठ पूर्व_अंतिम = उपखंड(पूर्व_पद, पूर्व_ल - १, पूर्व_ल);
    पाठ पर_प्रथम = उपखंड(पर_पद, ०, १);
    पाठ पर_शेष = "";
    यदि (पर_ल > १) {
        पर_शेष = उपखंड(पर_पद, १, पर_ल);
    }

    // १. विसर्ग संधि
    यदि (पूर्व_अंतिम == "ः") {
        पाठ पूर्व_बिना_विसर्ग = उपखंड(पूर्व_पद, ०, पूर्व_ल - १);
        शब्दकोश वि = पद_अंतिम_स्वर_विश्लेषण(पूर्व_बिना_विसर्ग);
        पाठ स्वर = वि["अंतिम_स्वर"];

        // सत्व संधि (८.३.३४)
        यदि (पर_प्रथम == "त" || पर_प्रथम == "थ") {
            परत् पूर्व_बिना_विसर्ग + "स्" + पर_पद;
        }
        यदि (पर_प्रथम == "च" || पर_प्रथम == "छ" || पर_प्रथम == "श") {
            परत् पूर्व_बिना_विसर्ग + "श्" + पर_पद;
        }
        यदि (पर_प्रथम == "ट" || पर_प्रथम == "ठ" || पर_प्रथम == "ष") {
            परत् पूर्व_बिना_विसर्ग + "ष्" + पर_पद;
        }

        // उत्व संधि (६.१.११३ / ६.१.११४)
        यदि (स्वर == "अ") {
            यदि (पर_प्रथम == "अ") {
                परत् पूर्व_बिना_विसर्ग + "ोऽ" + पर_शेष;
            }
            यदि (घोष_व्यंजन_है(पर_प्रथम)) {
                परत् पूर्व_बिना_विसर्ग + "ो" + पर_पद;
            }
        }

        // रुत्व संधि
        यदि (स्वर != "अ" && स्वर != "आ") {
            यदि (स्वर_वर्ण_है(पर_प्रथम)) {
                परत् पूर्व_बिना_विसर्ग + व्यंजन_स्वर_संयोग("र्", पर_प्रथम) + पर_शेष;
            }
            यदि (घोष_व्यंजन_है(पर_प्रथम)) {
                परत् पूर्व_बिना_विसर्ग + "र्" + पर_पद;
            }
        }
    }

    // २. हल् (व्यंजन) संधि
    यदि (पूर्व_ल >= २ && पूर्व_अंतिम == "्") {
        पाठ अंतिम_हलन्त_व्यंजन = उपखंड(पूर्व_पद, पूर्व_ल - २, पूर्व_ल);
        पाठ पूर्व_मूल = उपखंड(पूर्व_पद, ०, पूर्व_ल - २);

        // अनुस्वार संधि (८.३.२३)
        यदि (अंतिम_हलन्त_व्यंजन == "म्") {
            यदि (न स्वर_वर्ण_है(पर_प्रथम)) {
                परत् पूर्व_मूल + "ं" + पर_पद;
            }
        }

        // श्चुत्व संधि (८.४.४०)
        यदि (अंतिम_हलन्त_व्यंजन == "त्" || अंतिम_हलन्त_व्यंजन == "स्") {
            यदि (पर_प्रथम == "च" || पर_प्रथम == "छ" || पर_प्रथम == "श") {
                परत् पूर्व_मूल + "च्" + पर_पद;
            }
            यदि (पर_प्रथम == "ज" || पर_प्रथम == "झ") {
                परत् पूर्व_मूल + "ज्" + पर_पद;
            }
        }

        // ष्टुत्व संधि (८.४.४१)
        यदि (अंतिम_हलन्त_व्यंजन == "त्") {
            यदि (पर_प्रथम == "ट" || पर_प्रथम == "ठ") {
                परत् पूर्व_मूल + "ट्" + पर_पद;
            }
            यदि (पर_प्रथम == "ड" || पर_प्रथम == "ढ") {
                परत् पूर्व_मूल + "ड्" + पर_पद;
            }
        }

        // अनुनासिक संधि (८.४.४५)
        यदि (अनुनासिक_वर्ण_है(पर_प्रथम)) {
            यदि (अंतिम_हलन्त_व्यंजन == "त्") { परत् पूर्व_मूल + "न्" + पर_पद; }
            यदि (अंतिम_हलन्त_व्यंजन == "क्") { परत् पूर्व_मूल + "ङ्" + पर_पद; }
            यदि (अंतिम_हलन्त_व्यंजन == "ट्") { परत् पूर्व_मूल + "ण्" + पर_पद; }
            यदि (अंतिम_हलन्त_व्यंजन == "प्") { परत् पूर्व_मूल + "म्" + पर_पद; }
        }

        // चर्त्व संधि (८.४.५५)
        यदि (अघोष_व्यंजन_है(पर_प्रथम)) {
            यदि (अंतिम_हलन्त_व्यंजन == "द्") { परत् पूर्व_मूल + "त्" + पर_पद; }
            यदि (अंतिम_हलन्त_व्यंजन == "ग्") { परत् पूर्व_मूल + "क्" + पर_पद; }
            यदि (अंतिम_हलन्त_व्यंजन == "ब्") { परत् पूर्व_मूल + "प्" + पर_पद; }
        }

        // जश्त्व संधि (८.२.३९ / ८.४.५३)
        यदि (स्वर_वर्ण_है(पर_प्रथम) || घोष_व्यंजन_है(पर_प्रथम)) {
            यदि (अंतिम_हलन्त_व्यंजन == "क्") {
                यदि (स्वर_वर्ण_है(पर_प्रथम)) { परत् पूर्व_मूल + व्यंजन_स्वर_संयोग("ग्", पर_प्रथम) + पर_शेष; }
                अन्यथा { परत् पूर्व_मूल + "ग्" + पर_पद; }
            }
            यदि (अंतिम_हलन्त_व्यंजन == "च्") {
                यदि (स्वर_वर्ण_है(पर_प्रथम)) { परत् पूर्व_मूल + व्यंजन_स्वर_संयोग("ज्", पर_प्रथम) + पर_शेष; }
                अन्यथा { परत् पूर्व_मूल + "ज्" + पर_पद; }
            }
            यदि (अंतिम_हलन्त_व्यंजन == "ट्") {
                यदि (स्वर_वर्ण_है(पर_प्रथम)) { परत् पूर्व_मूल + व्यंजन_स्वर_संयोग("ड्", पर_प्रथम) + पर_शेष; }
                अन्यथा { परत् पूर्व_मूल + "ड्" + पर_पद; }
            }
            यदि (अंतिम_हलन्त_व्यंजन == "त्") {
                यदि (स्वर_वर्ण_है(पर_प्रथम)) { परत् पूर्व_मूल + व्यंजन_स्वर_संयोग("द्", पर_प्रथम) + पर_शेष; }
                अन्यथा { परत् पूर्व_मूल + "द्" + पर_पद; }
            }
            यदि (अंतिम_हलन्त_व्यंजन == "प्") {
                यदि (स्वर_वर्ण_है(पर_प्रथम)) { परत् पूर्व_मूल + व्यंजन_स्वर_संयोग("ब्", पर_प्रथम) + पर_शेष; }
                अन्यथा { परत् पूर्व_मूल + "ब्" + पर_पद; }
            }
        }
    }

    // ३. अच-संधि (स्वर संधि)
    शब्दकोश पूर्व_विश्लेषण = पद_अंतिम_स्वर_विश्लेषण(पूर्व_पद);
    शब्दकोश पर_विश्लेषण = पद_आरंभिक_स्वर_विश्लेषण(पर_पद);
    
    पाठ स्वर१ = पूर्व_विश्लेषण["अंतिम_स्वर"];
    पाठ स्वर२ = पर_विश्लेषण["प्रथम_स्वर"];
    
    यदि (स्वर१ != "" && स्वर२ != "") {
        शब्दकोश निर्णय = संधि_नियम_निर्णय(स्वर१, स्वर२);
        यदि (निर्णय["नियम"] != "अज्ञात") {
            पाठ परिणाम_ध्वनि = निर्णय["परिणाम_ध्वनि"];
            पाठ संयुक्त_पूर्व = तना_मात्रा_जोड़ो(पूर्व_विश्लेषण["तना"], परिणाम_ध्वनि);
            परत् संयुक्त_पूर्व + पर_विश्लेषण["शेष_भाग"];
        }
    }
    
    // यदि कोई संधि नियम लागू न हुआ तो सामान्य संयोग
    परत् पूर्व_पद + पर_पद;
}

// ============================================================
// ७. संधि-विच्छेद (Sandhi Decomposition Engine)
// ============================================================

कार्य संधि_विच्छेद(पाठ पद) {
    सूची परिणाम = [];
    संख्या ल = लंबाई(पद);
    यदि (ल < २) { परत् परिणाम; }

    // १. यण् संधि विच्छेद (् + य, ् + व)
    संख्या इ = ०;
    यावत् (इ < ल - १) {
        पाठ व1 = उपखंड(पद, इ, इ + १);
        पाठ व2 = उपखंड(पद, इ + १, इ + २);
        
        यदि (व1 == "्" && व2 == "य" && इ > ०) {
            पाठ पूर्व_मूल = उपखंड(पद, ०, इ);
            पाठ मात्रा = "";
            पाठ पर_शेष = "";
            यदि (इ + २ < ल) {
                मात्रा = उपखंड(पद, इ + २, इ + ३);
                यदि (मात्रा_से_स्वर(मात्रा) != "अ" || मात्रा == "ा") {
                    यदि (इ + ३ < ल) {
                        पर_शेष = उपखंड(पद, इ + ३, ल);
                    }
                } अन्यथा {
                    पर_शेष = उपखंड(पद, इ + २, ल);
                }
            }
            पाठ स्वर = मात्रा_से_स्वर(मात्रा);
            पाठ पर_पद = स्वर + पर_शेष;
            
            सूची पूर्व_विकल्प = [पूर्व_मूल + "ि", पूर्व_मूल + "ी"];
            संख्या पइ = ०;
            यावत् (पइ < लंबाई(पूर्व_विकल्प)) {
                पाठ पू = पूर्व_विकल्प[पइ];
                यदि (संधि_संयोजन(पू, पर_पद) == पद) {
                    शब्दकोश फ = {};
                    फ["पूर्व"] = पू;
                    फ["पर"] = पर_पद;
                    फ["नियम"] = "यण्";
                    फ["सूत्र"] = "इको यणचि (६.१.७७)";
                    परिणाम = जोड़ें(परिणाम, फ);
                }
                पइ = पइ + १;
            }
        }
        
        यदि (व1 == "्" && व2 == "व" && इ > ०) {
            पाठ पूर्व_मूल = उपखंड(पद, ०, इ);
            पाठ मात्रा = "";
            पाठ पर_शेष = "";
            यदि (इ + २ < ल) {
                मात्रा = उपखंड(पद, इ + २, इ + ३);
                यदि (मात्रा_से_स्वर(मात्रा) != "अ" || मात्रा == "ा") {
                    यदि (इ + ३ < ल) {
                        पर_शेष = उपखंड(पद, इ + ३, ल);
                    }
                } अन्यथा {
                    पर_शेष = उपखंड(पद, इ + २, ल);
                }
            }
            पाठ स्वर = मात्रा_से_स्वर(मात्रा);
            पाठ पर_पद = स्वर + पर_शेष;
            
