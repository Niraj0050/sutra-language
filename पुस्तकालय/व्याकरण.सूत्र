कार्य पर्याय_सूची(पाठ शब्द) {
    शब्दकोश कोश = ज्ञान_आलेख_कोश();
    यदि (कुंजी_है(कोश, शब्द)) {
        परत् कोश[शब्द]["पर्याय"];
    }
    सूची कुंज्यः = कुंजियाँ(कोश);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुंज्यः)) {
        पाठ क = कुंज्यः[इ];
        सूची पर्यायाः = कोश[क]["पर्याय"];
        संख्या पइ = ०;
        यावत् (पइ < लंबाई(पर्यायाः)) {
            यदि (पर्यायाः[पइ] == शब्द) {
                सूची फल = [क];
                संख्या कई = ०;
                यावत् (कई < लंबाई(पर्यायाः)) {
                    यदि (पर्यायाः[कई] != शब्द) {
                        फल = जोड़ें(फल, पर्यायाः[कई]);
                    }
                    कई = कई + १;
                }
                परत् फल;
            }
            पइ = पइ + १;
        }
        इ = इ + १;
    }
    परत् [];
}

