// पुस्तकालय/सूत्र_सञ्चिका_प्रणाली.सूत्र — सूत्र स्वायत्त सञ्चिका-प्रणाली (Sutra Sovereign File System - SutraFS)
// ==============================================================================
// आयात "पुस्तकालय/सूत्र_सञ्चिका_प्रणाली.सूत्र";
//
// जीव-प्रणाली (Jiv-OS) ब्लॉक-सञ्चिका तंत्र:
// ५१२-बाइट सेक्टर स्टोरेज ड्राइवर के ऊपर निर्मित संप्रभु सञ्चिका-प्रणाली।
//
// वास्तुशिल्प (Architecture):
//   १. परमखंड (Superblock): जादुई पहचान 'SFS1' (1399878227), कुल सेक्टर, ब्लॉक आकार (५१२)
//   २. सेक्टर बिटमैप (Block Allocation Bitmap): मुक्त एवं प्रयुक्त सेक्टरों का प्रबंधन
//   ३. पत्रक सारणी (Inode Table): सञ्चिका नाम, प्रकार, आकार, एवं खंड-सूची
//   ४. सञ्चिका जीवनचक्र:
//      - 'सञ्चिका_सृजन'    : नई सञ्चिका रचना एवं सेक्टरों में डेटा संचयन
//      - 'सञ्चिका_पठन'     : सेक्टरों से डेटा खंडों को एकत्र कर पूर्ण पाठ पठन
//      - 'सञ्चिका_सूची'    : निर्देशिका में विद्यमान समस्त सञ्चिकाओं की सूची
//      - 'सञ्चिका_विलोपन'  : सञ्चिका निष्कासन एवं सेक्टरों की विमुक्ति
//      - 'अखंडता_परीक्षण' : सम्पूर्ण सञ्चिका तंत्र की समता एवं स्वास्थ्य जाँच
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";

// जादुई संख्या: 'SFS1' = 0x53465331 (1399878227)
कार्य सूत्र_सञ्चिका_जादुई_पहचान() {
    परत् १३९९८७८२२७;
}

कार्य कोष_कुंजी_हटाओ(शब्दकोश कोष, पाठ लक्ष्य_कुंजी) {
    शब्दकोश नया_कोष = {};
    सूची कुं_सूची = कुंजियाँ(कोष);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं_सूची)) {
        पाठ कुं = कुं_सूची[इ];
        यदि (कुं != लक्ष्य_कुंजी) {
            नया_कोष[कुं] = कोष[कुं];
        }
        इ = इ + १;
    }
    परत् नया_कोष;
}

// ==============================================================================
// १. सञ्चिका-प्रणाली आरंभीकरण एवं प्रारूपण (Format & Mount)
// ==============================================================================

कार्य सञ्चिका_प्रणाली_आरंभ(संख्या कुल_सेक्टर) {
    शब्दकोश तंत्र = {};
    तंत्र["जादुई_पहचान"] = सूत्र_सञ्चिका_जादुई_पहचान();
    तंत्र["संस्करण"] = "१.०-स्वायत्त-SFS";
    तंत्र["कुल_सेक्टर"] = कुल_सेक्टर;
    तंत्र["सेक्टर_आकार"] = ५१२;
    तंत्र["मुक्त_सेक्टर_संख्या"] = कुल_सेक्टर - १६; // प्रथम १६ सेक्टर मेटाडेटा हेतु आरक्षित
    तंत्र["पत्रक_संग्रह"] = {}; // सञ्चिका_नाम -> पत्रक
    तंत्र["प्रयुक्त_सेक्टर_मानचित्र"] = {}; // सेक्टर_क्रमांक -> प्रयुक्त मान

    // आरक्षित सेक्टर (०..१५)
    संख्या इ = ०;
    यावत् (इ < १६) {
        तंत्र["प्रयुक्त_सेक्टर_मानचित्र"][देवनागरी_अंक_से_पाठ(इ)] = सत्य;
        इ = इ + १;
    }

    तंत्र["कुल_सञ्चिकाएं"] = ०;
    तंत्र["स्थिति"] = "आरोहित"; // Mounted
    परत् तंत्र;
}

// ==============================================================================
// २. मुक्त सेक्टर आवंटक (Sector Allocator)
// ==============================================================================

कार्य मुक्त_सेक्टर_खोजो(शब्दकोश तंत्र) {
    संख्या इ = १६;
    यावत् (इ < तंत्र["कुल_सेक्टर"]) {
        पाठ कुंजी = देवनागरी_अंक_से_पाठ(इ);
        यदि (न कुंजी_है(तंत्र["प्रयुक्त_सेक्टर_मानचित्र"], कुंजी)) {
            तंत्र["प्रयुक्त_सेक्टर_मानचित्र"][कुंजी] = सत्य;
            तंत्र["मुक्त_सेक्टर_संख्या"] = तंत्र["मुक्त_सेक्टर_संख्या"] - १;
            परत् इ;
        }
        इ = इ + १;
    }
    परत् -१; // डिस्क पूर्ण (Out of disk space)
}

कार्य सेक्टर_मुक्त_करो(शब्दकोश तंत्र, संख्या सेक्टर_क्रमांक) {
    पाठ कुंजी = देवनागरी_अंक_से_पाठ(सेक्टर_क्रमांक);
    यदि (कुंजी_है(तंत्र["प्रयुक्त_सेक्टर_मानचित्र"], कुंजी)) {
        तंत्र["प्रयुक्त_सेक्टर_मानचित्र"] = कोष_कुंजी_हटाओ(तंत्र["प्रयुक्त_सेक्टर_मानचित्र"], कुंजी);
        तंत्र["मुक्त_सेक्टर_संख्या"] = तंत्र["मुक्त_सेक्टर_संख्या"] + १;
        परत् सत्य;
    }
    परत् असत्य;
}

// ==============================================================================
// ३. सञ्चिका सृजन एवं लेखन (Create & Write)
// ==============================================================================

कार्य सञ्चिका_सृजन(शब्दकोश तंत्र, पाठ नाम, पाठ सामग्री) {
    यदि (कुंजी_है(तंत्र["पत्रक_संग्रह"], नाम)) {
        // यदि सञ्चिका पूर्व से है, तो पुनर्लेखन हेतु पुरानी सामग्री हटाओ
        सञ्चिका_विलोपन(तंत्र, नाम);
    }

    संख्या कुल_बाइट्स = लंबाई(सामग्री);
    // आवश्यक सेक्टरों की गणना (५१२ बाइट प्रति सेक्टर)
    संख्या आवश्यक_सेक्टर = (कुल_बाइट्स + ५११) / ५१२;
    यदि (आवश्यक_सेक्टर == ०) {
        आवश्यक_सेक्टर = १;
    }

    यदि (आवश्यक_सेक्टर > तंत्र["मुक्त_सेक्टर_संख्या"]) {
        फेको "सञ्चिका सृजन विफल: डिस्क में पर्याप्त स्थान रिक्त नहीं है";
    }

    सूची आवंटित_खंड = [];
    संख्या इ = ०;
    यावत् (इ < आवश्यक_सेक्टर) {
        संख्या सेक्टर = मुक्त_सेक्टर_खोजो(तंत्र);
        यदि (सेक्टर == -१) {
            फेको "सञ्चिका सृजन विफल: सेक्टर आवंटन त्रुटि";
        }
        आवंटित_खंड = जोड़ें(आवंटित_खंड, सेक्टर);
        इ = इ + १;
    }

    शब्दकोश पत्रक = {};
    पत्रक["नाम"] = नाम;
    पत्रक["प्रकार"] = "नियमित_सञ्चिका";
    पत्रक["आकार"] = कुल_बाइट्स;
    पत्रक["आवंटित_सेक्टर_सूची"] = आवंटित_खंड;
    पत्रक["सामग्री"] = सामग्री;
    पत्रक["चेकसम"] = लंबाई(सामग्री);

    तंत्र["पत्रक_संग्रह"][नाम] = पत्रक;
    तंत्र["कुल_सञ्चिकाएं"] = तंत्र["कुल_सञ्चिकाएं"] + १;

    परत् पत्रक;
}

// ==============================================================================
// ४. सञ्चिका पठन (Read)
// ==============================================================================

कार्य सञ्चिका_पठन(शब्दकोश तंत्र, पाठ नाम) {
    यदि (न कुंजी_है(तंत्र["पत्रक_संग्रह"], नाम)) {
        फेको "सञ्चिका अप्राप्ता: '" + नाम + "'";
    }
    शब्दकोश पत्रक = तंत्र["पत्रक_संग्रह"][नाम];
    परत् पत्रक["सामग्री"];
}

// ==============================================================================
// ५. सञ्चिका सूची (Directory Listing)
// ==============================================================================

कार्य सञ्चिका_सूची(शब्दकोश तंत्र) {
    सूची नाम_सूची = कुंजियाँ(तंत्र["पत्रक_संग्रह"]);
    सूची विवरण_सूची = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(नाम_सूची)) {
        पाठ नाम = नाम_सूची[इ];
        शब्दकोश पत्रक = तंत्र["पत्रक_संग्रह"][नाम];
        शब्दकोश वि = {};
        वि["नाम"] = नाम;
        वि["आकार"] = पत्रक["आकार"];
        वि["सेक्टर_संख्या"] = लंबाई(पत्रक["आवंटित_सेक्टर_सूची"]);
        विवरण_सूची = जोड़ें(विवरण_सूची, वि);
        इ = इ + १;
    }
    परत् विवरण_सूची;
}

// ==============================================================================
// ६. सञ्चिका विलोपन (Delete)
// ==============================================================================

कार्य सञ्चिका_विलोपन(शब्दकोश तंत्र, पाठ नाम) {
    यदि (न कुंजी_है(तंत्र["पत्रक_संग्रह"], नाम)) {
        परत् असत्य;
    }

    शब्दकोश पत्रक = तंत्र["पत्रक_संग्रह"][नाम];
    सूची खंड = पत्रक["आवंटित_सेक्टर_सूची"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(खंड)) {
        सेक्टर_मुक्त_करो(तंत्र, खंड[इ]);
        इ = इ + १;
    }

    तंत्र["पत्रक_संग्रह"] = कोष_कुंजी_हटाओ(तंत्र["पत्रक_संग्रह"], नाम);
    तंत्र["कुल_सञ्चिकाएं"] = तंत्र["कुल_सञ्चिकाएं"] - १;
    परत् सत्य;
}

// ==============================================================================
// ७. सञ्चिका-प्रणाली अखंडता परीक्षण (Integrity & Health Check)
// ==============================================================================

कार्य सञ्चिका_तंत्र_अखंडता_जाँच(शब्दकोश तंत्र) {
    शब्दकोश प्रतिवेदन = {};
    प्रतिवेदन["जादुई_पहचान"] = तंत्र["जादुई_पहचान"];
    प्रतिवेदन["स्थिति"] = तंत्र["स्थिति"];
    प्रतिवेदन["कुल_सञ्चिकाएं"] = तंत्र["कुल_सञ्चिकाएं"];
    प्रतिवेदन["कुल_सेक्टर"] = तंत्र["कुल_सेक्टर"];
    प्रतिवेदन["मुक्त_सेक्टर"] = तंत्र["मुक्त_सेक्टर_संख्या"];

    // अखंडता सत्यापन: क्या कुल सञ्चिकाओं के सेक्टर + मुक्त सेक्टर + आरक्षित सेक्टर == कुल सेक्टर?
    सूची सञ्चिकाएं = कुंजियाँ(तंत्र["पत्रक_संग्रह"]);
    संख्या कुल_प्रयुक्त = १६; // आरक्षित
    संख्या इ = ०;
    यावत् (इ < लंबाई(सञ्चिकाएं)) {
        शब्दकोश प = तंत्र["पत्रक_संग्रह"][सञ्चिकाएं[इ]];
        कुल_प्रयुक्त = कुल_प्रयुक्त + लंबाई(प["आवंटित_सेक्टर_सूची"]);
        इ = इ + १;
    }

    मान सुसंगत = (कुल_प्रयुक्त + तंत्र["मुक्त_सेक्टर_संख्या"]) == तंत्र["कुल_सेक्टर"];
    प्रतिवेदन["सुसंगत"] = सुसंगत;
    यदि (सुसंगत) {
        प्रतिवेदन["स्वास्थ्य"] = "निर्दोष_अखंड";
    } अन्यथा {
        प्रतिवेदन["स्वास्थ्य"] = "असंगत_दोष";
    }

    परत् प्रतिवेदन;
}
