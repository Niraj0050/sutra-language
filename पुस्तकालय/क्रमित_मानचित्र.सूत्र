// पुस्तकालय/क्रमित_मानचित्र.सूत्र — क्रमित मानचित्र (sorted map / ordered dictionary)
// ============================================================
// आयात "पुस्तकालय/क्रमित_मानचित्र.सूत्र";
//
//   शब्दकोश म = क्रमित_बनाओ();
//   क्रमित_रखो(म, ३०, "ग");
//   क्रमित_रखो(म, १०, "क");
//   क्रमित_रखो(म, २०, "ख");
//   क्रमित_कुंजियाँ(म)              // [10, 20, 30] — हमेशा आरोही क्रम
//   क्रमित_पाओ(म, २०)               // "ख"
//   क्रमित_फर्श(म, २५)              // 20  (सबसे बड़ी कुंजी <= 25)
//   क्रमित_छत(म, २५)                // 30  (सबसे छोटी कुंजी >= 25)
//   क्रमित_श्रेणी(म, १५, ३५)         // [20, 30]
//   क्रमित_रैंक(म, ३०)              // 2   (30 से छोटी कुंजियाँ)
//   क्रमित_चयन(म, ०)                // 10  (सबसे छोटी कुंजी)
//
// शब्दकोश अक्रमित है (कुंजियाँ() का क्रम गारंटी नहीं) — यह मॉड्यूल वही
// मानचित्र क्रमित पहुँच के साथ देता। निरूपण: AVL संतुलित द्विआधारी खोज-वृक्ष;
// नोड = शब्दकोश {"कुंजी","मूल्य","बायाँ","दायाँ","ऊँचाई","आकार"} ("आकार" =
// उस उपवृक्ष के नोड-गिनती, जिससे रैंक/चयन भी O(log n) हैं); मानचित्र =
// शब्दकोश {"मूल","कुंजी_प्रकार"}।
//
// समय: रखो / पाओ / है / हटाओ / फर्श / छत / पिछला / अगला / रैंक / चयन /
// न्यूनतम / अधिकतम सब O(log n); कुंजियाँ / मूल्य / युग्म O(n);
// श्रेणी O(log n + k)।
//
// कुंजियाँ: सब संख्या, या सब पाठ (पाठ की तुलना कोडबिंदु-वार, यानी Unicode
// क्रम)। एक मानचित्र में दोनों प्रकार मिलाना `क्रमित_रखो` में त्रुटि देता;
// पढ़ने वाले कार्य (पाओ / है / हटाओ / फर्श ...) मेल न खाने वाली कुंजी को
// "नहीं मिली" मानते। दशमलव / बूल कुंजी समर्थित नहीं (native में संख्या से
// अलग नहीं दिखते)। कुंजी `०` मान्य है (native में स्पष्ट `शून्यम्` कुंजी भी ०
// बन जाती — interpreter में वह त्रुटि देती)।
//
// ⚠️ native में `०` और `शून्यम्` अलग नहीं (tagged मान नहीं — पुस्तकालय/
// README.md की सीमाएँ #6)। "नहीं मिला" के लिए `शून्यम्` लौटाने वाले कार्य
// (पाओ / न्यूनतम_कुंजी / फर्श ...) इसलिए तब अस्पष्ट हैं जब मूल्य या कुंजी
// खुद ० हो सकती है — वहाँ पहले `क्रमित_है` / `क्रमित_खाली_है` से जाँचो, या
// `क्रमित_रैंक` + `क्रमित_चयन` से चलो, या `क्रमित_पाओ_या` लो।
//
// मानचित्र शब्दकोश-संदर्भ है (reference) — रखो / हटाओ जगह पर बदलते; सूचियाँ
// (कुंजियाँ, मूल्य ...) नई बनकर लौटतीं, कभी जगह पर बदली नहीं जातीं।
// ============================================================

// ===== आंतरिक =====

// कुंजी का प्रकार-टैग: "संख्या" / "पाठ" / "अन्य"। native में शब्द ० को `प्रकार()`
// "शून्यम्" कहता (० और शून्यम् और असत्य एक ही शब्द) — इसलिए "शून्यम्" पर भी
// `कुंजी == ०` सत्य हो तो वह संख्या ० है। interpreter में `शून्यम् == ०` असत्य,
// तो स्पष्ट शून्यम् कुंजी वहाँ "अन्य" (अमान्य) रहती।
कार्य क्रमि_प्रकार_टैग(मान कुंजी) {
    पाठ त = प्रकार(कुंजी);
    यदि (त == "शून्यम्") {
        यदि (कुंजी == ०) { परत् "संख्या"; }
        परत् "अन्य";
    }
    यदि (त == "संख्या" || त == "पाठ") { परत् त; }
    परत् "अन्य";
}

// कुंजी का प्रकार-टैग ("संख्या" या "पाठ"); बाकी प्रकार अमान्य
कार्य क्रमि_कुंजी_प्रकार(मान कुंजी) {
    पाठ त = क्रमि_प्रकार_टैग(कुंजी);
    यदि (त == "अन्य") {
        प्रक्षेपः "त्रुटिः — क्रमित_मानचित्र: कुंजी संख्या या पाठ होनी चाहिए";
    }
    परत् त;
}

// क्या कुंजी का प्रकार मानचित्र की कुंजियों से मेल खाता है (खाली में कुछ भी चलता)
कार्य क्रमि_प्रकार_मेल(शब्दकोश म, मान कुंजी) {
    यदि (म["मूल"] == शून्यम्) { परत् सत्य; }
    पाठ त = क्रमि_प्रकार_टैग(कुंजी);
    पाठ मानचित्र_प्रकार = म["कुंजी_प्रकार"];
    परत् त == मानचित्र_प्रकार;
}

// -१ / ० / १ — दो कुंजियों की तुलना (संख्या-संख्या या पाठ-पाठ)
कार्य क्रमि_तुलना(मान अ, मान ब) {
    यदि (अ < ब) { परत् ० - १; }
    यदि (अ > ब) { परत् १; }
    परत् ०;
}

// उपवृक्ष की ऊँचाई / नोड-गिनती (खाली उपवृक्ष = ०)
कार्य क्रमि_ऊ(मान नो) {
    यदि (नो == शून्यम्) { परत् ०; }
    परत् नो["ऊँचाई"];
}

कार्य क्रमि_आ(मान नो) {
    यदि (नो == शून्यम्) { परत् ०; }
    परत् नो["आकार"];
}

// नोड की ऊँचाई और आकार बच्चों से दोबारा गिनो
कार्य क्रमि_अद्यतन(शब्दकोश नो) {
    संख्या बऊ = क्रमि_ऊ(नो["बायाँ"]);
    संख्या दऊ = क्रमि_ऊ(नो["दायाँ"]);
    यदि (बऊ > दऊ) {
        नो["ऊँचाई"] = बऊ + १;
    } अन्यथा {
        नो["ऊँचाई"] = दऊ + १;
    }
    संख्या बआ = क्रमि_आ(नो["बायाँ"]);
    संख्या दआ = क्रमि_आ(नो["दायाँ"]);
    नो["आकार"] = बआ + दआ + १;
    परत् ०;
}

// दायाँ घुमाव: नो का बायाँ बच्चा नया मूल बनता है
कार्य क्रमि_दायाँ_घुमाव(शब्दकोश नो) {
    शब्दकोश नया = नो["बायाँ"];
    नो["बायाँ"] = नया["दायाँ"];
    नया["दायाँ"] = नो;
    क्रमि_अद्यतन(नो);
    क्रमि_अद्यतन(नया);
    परत् नया;
}

// बायाँ घुमाव: नो का दायाँ बच्चा नया मूल बनता है
कार्य क्रमि_बायाँ_घुमाव(शब्दकोश नो) {
    शब्दकोश नया = नो["दायाँ"];
    नो["दायाँ"] = नया["बायाँ"];
    नया["बायाँ"] = नो;
    क्रमि_अद्यतन(नो);
    क्रमि_अद्यतन(नया);
    परत् नया;
}

// AVL संतुलन: ऊँचाई/आकार ताज़ा करो, ज़रूरत हो तो घुमाओ; उपवृक्ष का नया मूल लौटाता
कार्य क्रमि_संतुलित(शब्दकोश नो) {
    क्रमि_अद्यतन(नो);
    संख्या बऊ = क्रमि_ऊ(नो["बायाँ"]);
    संख्या दऊ = क्रमि_ऊ(नो["दायाँ"]);
    संख्या संतुलन = बऊ - दऊ;
    यदि (संतुलन > १) {
        शब्दकोश ब = नो["बायाँ"];
        संख्या ब_ब = क्रमि_ऊ(ब["बायाँ"]);
        संख्या ब_द = क्रमि_ऊ(ब["दायाँ"]);
        यदि (ब_ब < ब_द) {
            नो["बायाँ"] = क्रमि_बायाँ_घुमाव(ब);
        }
        परत् क्रमि_दायाँ_घुमाव(नो);
    }
    यदि (संतुलन < ० - १) {
        शब्दकोश द = नो["दायाँ"];
        संख्या द_ब = क्रमि_ऊ(द["बायाँ"]);
        संख्या द_द = क्रमि_ऊ(द["दायाँ"]);
        यदि (द_ब > द_द) {
            नो["दायाँ"] = क्रमि_दायाँ_घुमाव(द);
        }
        परत् क्रमि_बायाँ_घुमाव(नो);
    }
    परत् नो;
}

// कुंजी वाला नोड (नहीं मिला / प्रकार बेमेल = शून्यम्)
कार्य क्रमि_खोजो(शब्दकोश म, मान कुंजी) {
    यदि (न क्रमि_प्रकार_मेल(म, कुंजी)) { परत् शून्यम्; }
    मान नो = म["मूल"];
    यावत् (नो != शून्यम्) {
        शब्दकोश वर्तमान = नो;
        संख्या ल = क्रमि_तुलना(कुंजी, वर्तमान["कुंजी"]);
        यदि (ल == ०) { परत् वर्तमान; }
        यदि (ल < ०) {
            नो = वर्तमान["बायाँ"];
        } अन्यथा {
            नो = वर्तमान["दायाँ"];
        }
    }
    परत् शून्यम्;
}

// उपवृक्ष में (कुंजी, मूल्य) डालो या मौजूदा कुंजी का मूल्य अद्यतन करो;
// उपवृक्ष का नया मूल लौटाता
कार्य क्रमि_डालो(मान नो, मान कुंजी, मान मूल्य) {
    यदि (नो == शून्यम्) {
        शब्दकोश नया = {};
        नया["कुंजी"] = कुंजी;
        नया["मूल्य"] = मूल्य;
        नया["बायाँ"] = शून्यम्;
        नया["दायाँ"] = शून्यम्;
        नया["ऊँचाई"] = १;
        नया["आकार"] = १;
        परत् नया;
    }
    शब्दकोश वर्तमान = नो;
    संख्या ल = क्रमि_तुलना(कुंजी, वर्तमान["कुंजी"]);
    यदि (ल < ०) {
        वर्तमान["बायाँ"] = क्रमि_डालो(वर्तमान["बायाँ"], कुंजी, मूल्य);
    } अन्यथा यदि (ल > ०) {
        वर्तमान["दायाँ"] = क्रमि_डालो(वर्तमान["दायाँ"], कुंजी, मूल्य);
    } अन्यथा {
        वर्तमान["मूल्य"] = मूल्य;
        परत् वर्तमान;
    }
    परत् क्रमि_संतुलित(वर्तमान);
}

// उपवृक्ष का सबसे बाएँ / सबसे दाएँ नोड
कार्य क्रमि_न्यूनतम_नोड(शब्दकोश नो) {
    शब्दकोश वर्तमान = नो;
    यावत् (वर्तमान["बायाँ"] != शून्यम्) {
        वर्तमान = वर्तमान["बायाँ"];
    }
    परत् वर्तमान;
}

कार्य क्रमि_अधिकतम_नोड(शब्दकोश नो) {
    शब्दकोश वर्तमान = नो;
    यावत् (वर्तमान["दायाँ"] != शून्यम्) {
        वर्तमान = वर्तमान["दायाँ"];
    }
    परत् वर्तमान;
}

// उपवृक्ष से सबसे छोटा / सबसे बड़ा नोड काट दो; उपवृक्ष का नया मूल लौटाता
कार्य क्रमि_न्यूनतम_हटाओ(शब्दकोश नो) {
    यदि (नो["बायाँ"] == शून्यम्) { परत् नो["दायाँ"]; }
    नो["बायाँ"] = क्रमि_न्यूनतम_हटाओ(नो["बायाँ"]);
    परत् क्रमि_संतुलित(नो);
}

कार्य क्रमि_अधिकतम_हटाओ(शब्दकोश नो) {
    यदि (नो["दायाँ"] == शून्यम्) { परत् नो["बायाँ"]; }
    नो["दायाँ"] = क्रमि_अधिकतम_हटाओ(नो["दायाँ"]);
    परत् क्रमि_संतुलित(नो);
}

// उपवृक्ष से कुंजी हटाओ (कुंजी मौजूद हो, यह caller पहले जाँच चुका); नया मूल लौटाता
कार्य क्रमि_हटाओ_नोड(मान नो, मान कुंजी) {
    यदि (नो == शून्यम्) { परत् शून्यम्; }
    शब्दकोश वर्तमान = नो;
    संख्या ल = क्रमि_तुलना(कुंजी, वर्तमान["कुंजी"]);
    यदि (ल < ०) {
        वर्तमान["बायाँ"] = क्रमि_हटाओ_नोड(वर्तमान["बायाँ"], कुंजी);
    } अन्यथा यदि (ल > ०) {
        वर्तमान["दायाँ"] = क्रमि_हटाओ_नोड(वर्तमान["दायाँ"], कुंजी);
    } अन्यथा {
        मान बायाँ_बच्चा = वर्तमान["बायाँ"];
        मान दायाँ_बच्चा = वर्तमान["दायाँ"];
        यदि (बायाँ_बच्चा == शून्यम्) { परत् दायाँ_बच्चा; }
        यदि (दायाँ_बच्चा == शून्यम्) { परत् बायाँ_बच्चा; }
        // दो बच्चे: दाएँ उपवृक्ष का न्यूनतम (उत्तराधिकारी) इस जगह आता
        शब्दकोश दायाँ_नोड = दायाँ_बच्चा;
        शब्दकोश उत्तराधिकारी = क्रमि_न्यूनतम_नोड(दायाँ_नोड);
        उत्तराधिकारी["दायाँ"] = क्रमि_न्यूनतम_हटाओ(दायाँ_नोड);
        उत्तराधिकारी["बायाँ"] = बायाँ_बच्चा;
        परत् क्रमि_संतुलित(उत्तराधिकारी);
    }
    परत् क्रमि_संतुलित(वर्तमान);
}

// विधा: ० = फर्श (<=), १ = छत (>=), २ = पिछला (<), ३ = अगला (>)
// कोई कुंजी न मिले (या प्रकार बेमेल) तो शून्यम्
कार्य क्रमि_पड़ोसी(शब्दकोश म, मान कुंजी, संख्या विधा) {
    यदि (न क्रमि_प्रकार_मेल(म, कुंजी)) { परत् शून्यम्; }
    मान नो = म["मूल"];
    मान उम्मीदवार = शून्यम्;
    यावत् (नो != शून्यम्) {
        शब्दकोश वर्तमान = नो;
        संख्या ल = क्रमि_तुलना(कुंजी, वर्तमान["कुंजी"]);
        यदि (विधा == ०) {
            यदि (ल == ०) { परत् वर्तमान["कुंजी"]; }
            यदि (ल < ०) {
                नो = वर्तमान["बायाँ"];
            } अन्यथा {
                उम्मीदवार = वर्तमान["कुंजी"];
                नो = वर्तमान["दायाँ"];
            }
        } अन्यथा यदि (विधा == १) {
            यदि (ल == ०) { परत् वर्तमान["कुंजी"]; }
            यदि (ल > ०) {
                नो = वर्तमान["दायाँ"];
            } अन्यथा {
                उम्मीदवार = वर्तमान["कुंजी"];
                नो = वर्तमान["बायाँ"];
            }
        } अन्यथा यदि (विधा == २) {
            यदि (ल <= ०) {
                नो = वर्तमान["बायाँ"];
            } अन्यथा {
                उम्मीदवार = वर्तमान["कुंजी"];
                नो = वर्तमान["दायाँ"];
            }
        } अन्यथा {
            यदि (ल >= ०) {
                नो = वर्तमान["दायाँ"];
            } अन्यथा {
                उम्मीदवार = वर्तमान["कुंजी"];
                नो = वर्तमान["बायाँ"];
            }
        }
    }
    परत् उम्मीदवार;
}

// in-order (आरोही) चलकर सूची बनाओ — लौट-कर-पुनः-असाइन (सूची जगह पर नहीं बदलती)
// रूप: ० = कुंजियाँ, १ = मूल्य, २ = [कुंजी, मूल्य] युग्म
कार्य क्रमि_क्रम_में(मान नो, सूची फल, संख्या रूप) {
    यदि (नो == शून्यम्) { परत् फल; }
    शब्दकोश वर्तमान = नो;
    फल = क्रमि_क्रम_में(वर्तमान["बायाँ"], फल, रूप);
    यदि (रूप == ०) {
        फल = जोड़ें(फल, वर्तमान["कुंजी"]);
    } अन्यथा यदि (रूप == १) {
        फल = जोड़ें(फल, वर्तमान["मूल्य"]);
    } अन्यथा {
        फल = जोड़ें(फल, [वर्तमान["कुंजी"], वर्तमान["मूल्य"]]);
    }
    फल = क्रमि_क्रम_में(वर्तमान["दायाँ"], फल, रूप);
    परत् फल;
}

// बंद अंतराल [निम्न, उच्च] की कुंजियाँ (आरोही); केवल संबंधित उपवृक्षों में उतरता
कार्य क्रमि_श्रेणी_खोजो(मान नो, मान निम्न, मान उच्च, सूची फल) {
    यदि (नो == शून्यम्) { परत् फल; }
    शब्दकोश वर्तमान = नो;
    संख्या ल_निम्न = क्रमि_तुलना(निम्न, वर्तमान["कुंजी"]);
    संख्या ल_उच्च = क्रमि_तुलना(उच्च, वर्तमान["कुंजी"]);
    यदि (ल_निम्न < ०) {
        फल = क्रमि_श्रेणी_खोजो(वर्तमान["बायाँ"], निम्न, उच्च, फल);
    }
    यदि (ल_निम्न <= ० && ल_उच्च >= ०) {
        फल = जोड़ें(फल, वर्तमान["कुंजी"]);
    }
    यदि (ल_उच्च > ०) {
        फल = क्रमि_श्रेणी_खोजो(वर्तमान["दायाँ"], निम्न, उच्च, फल);
    }
    परत् फल;
}

// अपरिवर्तनीयताओं की जाँच: लौटाता उपवृक्ष की ऊँचाई, या -१ यदि कुछ टूटा।
// स्थिति = {"पिछली_है","पिछली"} — in-order में कुंजियाँ सख्ती से बढ़ती हों
कार्य क्रमि_जाँच_नोड(मान नो, शब्दकोश स्थिति) {
    यदि (नो == शून्यम्) { परत् ०; }
    शब्दकोश वर्तमान = नो;
    संख्या बऊ = क्रमि_जाँच_नोड(वर्तमान["बायाँ"], स्थिति);
    यदि (बऊ < ०) { परत् ० - १; }
    यदि (स्थिति["पिछली_है"] == सत्य) {
        यदि (क्रमि_तुलना(स्थिति["पिछली"], वर्तमान["कुंजी"]) >= ०) { परत् ० - १; }
    }
    स्थिति["पिछली"] = वर्तमान["कुंजी"];
    स्थिति["पिछली_है"] = सत्य;
    संख्या दऊ = क्रमि_जाँच_नोड(वर्तमान["दायाँ"], स्थिति);
    यदि (दऊ < ०) { परत् ० - १; }
    संख्या भेद = बऊ - दऊ;
    यदि (भेद > १ || भेद < ० - १) { परत् ० - १; }
    संख्या ऊ = बऊ;
    यदि (दऊ > ऊ) { ऊ = दऊ; }
    ऊ = ऊ + १;
    संख्या दर्ज_ऊ = वर्तमान["ऊँचाई"];
    यदि (ऊ != दर्ज_ऊ) { परत् ० - १; }
    संख्या बआ = क्रमि_आ(वर्तमान["बायाँ"]);
    संख्या दआ = क्रमि_आ(वर्तमान["दायाँ"]);
    संख्या आ = बआ + दआ + १;
    संख्या दर्ज_आ = वर्तमान["आकार"];
    यदि (आ != दर्ज_आ) { परत् ० - १; }
    परत् ऊ;
}

// ===== सार्वजनिक API =====

// नया खाली मानचित्र
कार्य क्रमित_बनाओ() {
    शब्दकोश म = {};
    म["मूल"] = शून्यम्;
    म["कुंजी_प्रकार"] = शून्यम्;
    परत् म;
}

// कुंजी/मूल्य रखो — कुंजी नई हो तो सत्य, पहले से हो (मूल्य अद्यतन) तो असत्य
कार्य क्रमित_रखो(शब्दकोश म, मान कुंजी, मान मूल्य) {
    पाठ त = क्रमि_कुंजी_प्रकार(कुंजी);
    यदि (म["मूल"] == शून्यम्) {
        म["कुंजी_प्रकार"] = त;
    } अन्यथा {
        पाठ मानचित्र_प्रकार = म["कुंजी_प्रकार"];
        यदि (त != मानचित्र_प्रकार) {
            प्रक्षेपः "त्रुटिः — क्रमित_मानचित्र: संख्या और पाठ कुंजियाँ एक मानचित्र में नहीं मिल सकतीं";
        }
    }
    मान नई = क्रमि_खोजो(म, कुंजी) == शून्यम्;
    म["मूल"] = क्रमि_डालो(म["मूल"], कुंजी, मूल्य);
    परत् नई;
}

// कुंजी का मूल्य; न मिले तो शून्यम्
कार्य क्रमित_पाओ(शब्दकोश म, मान कुंजी) {
    मान नोड = क्रमि_खोजो(म, कुंजी);
    यदि (नोड == शून्यम्) { परत् शून्यम्; }
    शब्दकोश वर्तमान = नोड;
    परत् वर्तमान["मूल्य"];
}

// कुंजी का मूल्य; न मिले तो दिया गया पूर्वनिर्धारित
कार्य क्रमित_पाओ_या(शब्दकोश म, मान कुंजी, मान पूर्वनिर्धारित) {
    मान नोड = क्रमि_खोजो(म, कुंजी);
    यदि (नोड == शून्यम्) { परत् पूर्वनिर्धारित; }
    शब्दकोश वर्तमान = नोड;
    परत् वर्तमान["मूल्य"];
}

// क्या कुंजी मौजूद है
कार्य क्रमित_है(शब्दकोश म, मान कुंजी) {
    परत् क्रमि_खोजो(म, कुंजी) != शून्यम्;
}

// कुंजी हटाओ — मौजूद थी तो सत्य, नहीं तो असत्य
कार्य क्रमित_हटाओ(शब्दकोश म, मान कुंजी) {
    यदि (क्रमि_खोजो(म, कुंजी) == शून्यम्) { परत् असत्य; }
    म["मूल"] = क्रमि_हटाओ_नोड(म["मूल"], कुंजी);
    परत् सत्य;
}

// कुंजियों की संख्या
कार्य क्रमित_आकार(शब्दकोश म) {
    परत् क्रमि_आ(म["मूल"]);
}

कार्य क्रमित_खाली_है(शब्दकोश म) {
    परत् म["मूल"] == शून्यम्;
}

// सब हटाओ (खाली मानचित्र किसी भी प्रकार की कुंजी फिर से ले सकता)
कार्य क्रमित_खाली_करो(शब्दकोश म) {
    म["मूल"] = शून्यम्;
    म["कुंजी_प्रकार"] = शून्यम्;
    परत् ०;
}

// सबसे छोटी / सबसे बड़ी कुंजी; खाली हो तो शून्यम्
कार्य क्रमित_न्यूनतम_कुंजी(शब्दकोश म) {
    यदि (म["मूल"] == शून्यम्) { परत् शून्यम्; }
    शब्दकोश मूल = म["मूल"];
    शब्दकोश नोड = क्रमि_न्यूनतम_नोड(मूल);
    परत् नोड["कुंजी"];
}

कार्य क्रमित_अधिकतम_कुंजी(शब्दकोश म) {
    यदि (म["मूल"] == शून्यम्) { परत् शून्यम्; }
    शब्दकोश मूल = म["मूल"];
    शब्दकोश नोड = क्रमि_अधिकतम_नोड(मूल);
    परत् नोड["कुंजी"];
}

// सबसे छोटी / सबसे बड़ी कुंजी हटाकर [कुंजी, मूल्य] लौटाओ; खाली हो तो शून्यम्
// (priority-queue की तरह उपयोग: बार-बार न्यूनतम_निकालो = क्रमबद्ध क्रम)
कार्य क्रमित_न्यूनतम_निकालो(शब्दकोश म) {
    यदि (म["मूल"] == शून्यम्) { परत् शून्यम्; }
    शब्दकोश मूल = म["मूल"];
    शब्दकोश नोड = क्रमि_न्यूनतम_नोड(मूल);
    सूची जोड़ी = [नोड["कुंजी"], नोड["मूल्य"]];
    म["मूल"] = क्रमि_न्यूनतम_हटाओ(मूल);
    परत् जोड़ी;
}

कार्य क्रमित_अधिकतम_निकालो(शब्दकोश म) {
    यदि (म["मूल"] == शून्यम्) { परत् शून्यम्; }
    शब्दकोश मूल = म["मूल"];
    शब्दकोश नोड = क्रमि_अधिकतम_नोड(मूल);
    सूची जोड़ी = [नोड["कुंजी"], नोड["मूल्य"]];
    म["मूल"] = क्रमि_अधिकतम_हटाओ(मूल);
    परत् जोड़ी;
}

// सबसे बड़ी कुंजी <= दी गई (फर्श); कोई न हो तो शून्यम्
कार्य क्रमित_फर्श(शब्दकोश म, मान कुंजी) {
    परत् क्रमि_पड़ोसी(म, कुंजी, ०);
}

// सबसे छोटी कुंजी >= दी गई (छत); कोई न हो तो शून्यम्
कार्य क्रमित_छत(शब्दकोश म, मान कुंजी) {
    परत् क्रमि_पड़ोसी(म, कुंजी, १);
}

// सबसे बड़ी कुंजी < दी गई (सख्ती से पिछली); कोई न हो तो शून्यम्
कार्य क्रमित_पिछला(शब्दकोश म, मान कुंजी) {
    परत् क्रमि_पड़ोसी(म, कुंजी, २);
}

// सबसे छोटी कुंजी > दी गई (सख्ती से अगली); कोई न हो तो शून्यम्
कार्य क्रमित_अगला(शब्दकोश म, मान कुंजी) {
    परत् क्रमि_पड़ोसी(म, कुंजी, ३);
}

// कितनी कुंजियाँ दी गई कुंजी से सख्ती से छोटी हैं (कुंजी मौजूद हो या नहीं)।
// खाली मानचित्र या प्रकार-बेमेल कुंजी के लिए ०
कार्य क्रमित_रैंक(शब्दकोश म, मान कुंजी) {
    यदि (न क्रमि_प्रकार_मेल(म, कुंजी)) { परत् ०; }
    संख्या गिन = ०;
    मान नो = म["मूल"];
    यावत् (नो != शून्यम्) {
        शब्दकोश वर्तमान = नो;
        संख्या ल = क्रमि_तुलना(कुंजी, वर्तमान["कुंजी"]);
        संख्या बआ = क्रमि_आ(वर्तमान["बायाँ"]);
        यदि (ल == ०) {
            परत् गिन + बआ;
        }
        यदि (ल < ०) {
            नो = वर्तमान["बायाँ"];
        } अन्यथा {
            गिन = गिन + बआ + १;
            नो = वर्तमान["दायाँ"];
        }
    }
    परत् गिन;
}

// आरोही क्रम में सूचकांक-वीं (०-आधारित) कुंजी; सीमा से बाहर हो तो शून्यम्
कार्य क्रमित_चयन(शब्दकोश म, संख्या सूचकांक) {
    यदि (सूचकांक < ० || सूचकांक >= क्रमित_आकार(म)) { परत् शून्यम्; }
    मान नो = म["मूल"];
    संख्या शेष = सूचकांक;
    यावत् (नो != शून्यम्) {
        शब्दकोश वर्तमान = नो;
        संख्या बआ = क्रमि_आ(वर्तमान["बायाँ"]);
        यदि (शेष < बआ) {
            नो = वर्तमान["बायाँ"];
        } अन्यथा यदि (शेष == बआ) {
            परत् वर्तमान["कुंजी"];
        } अन्यथा {
            शेष = शेष - बआ - १;
            नो = वर्तमान["दायाँ"];
        }
    }
    परत् शून्यम्;
}

// सारी कुंजियाँ आरोही क्रम में (नई सूची)
कार्य क्रमित_कुंजियाँ(शब्दकोश म) {
    सूची फल = [];
    परत् क्रमि_क्रम_में(म["मूल"], फल, ०);
}

// सारे मूल्य, कुंजी के आरोही क्रम में (नई सूची)
कार्य क्रमित_मूल्य(शब्दकोश म) {
    सूची फल = [];
    परत् क्रमि_क्रम_में(म["मूल"], फल, १);
}

// सारे [कुंजी, मूल्य] युग्म, कुंजी के आरोही क्रम में (नई सूची)
कार्य क्रमित_युग्म(शब्दकोश म) {
    सूची फल = [];
    परत् क्रमि_क्रम_में(म["मूल"], फल, २);
}

// बंद अंतराल [निम्न, उच्च] की कुंजियाँ आरोही क्रम में; निम्न > उच्च हो तो खाली सूची
कार्य क्रमित_श्रेणी(शब्दकोश म, मान निम्न, मान उच्च) {
    सूची फल = [];
    यदि (म["मूल"] == शून्यम्) { परत् फल; }
    यदि (न क्रमि_प्रकार_मेल(म, निम्न) || न क्रमि_प्रकार_मेल(म, उच्च)) { परत् फल; }
    यदि (क्रमि_तुलना(निम्न, उच्च) > ०) { परत् फल; }
    परत् क्रमि_श्रेणी_खोजो(म["मूल"], निम्न, उच्च, फल);
}

// वृक्ष की ऊँचाई (खाली = ०) — AVL में हमेशा <= १.४४ * log2(n + २)
कार्य क्रमित_ऊँचाई(शब्दकोश म) {
    परत् क्रमि_ऊ(म["मूल"]);
}

// आंतरिक अपरिवर्तनीयताएँ ठीक हैं? (कुंजियाँ सख्ती से क्रमित, हर नोड पर AVL
// संतुलन |बायाँ − दायाँ| <= १, दर्ज ऊँचाई/आकार असली से मेल खाते) — परीक्षण/डीबग के लिए
कार्य क्रमित_जाँच(शब्दकोश म) {
    शब्दकोश स्थिति = {};
    स्थिति["पिछली_है"] = असत्य;
    संख्या ऊ = क्रमि_जाँच_नोड(म["मूल"], स्थिति);
    परत् ऊ >= ०;
}
