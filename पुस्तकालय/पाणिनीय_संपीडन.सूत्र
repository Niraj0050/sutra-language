कार्य पाणिनीय_विसंपीड़न_बाइट्स(सूची संपीड़ित) {
    यदि (लंबाई(संपीड़ित) == ०) { परत् []; }

    सूची रंग_१ = प्रत्याहार_पाठ_बाइट्स("#38bdf8");
    सूची रंग_२ = प्रत्याहार_पाठ_बाइट्स("#10b981");
    सूची रंग_३ = प्रत्याहार_पाठ_बाइट्स("#f59e0b");
    सूची रंग_४ = प्रत्याहार_पाठ_बाइट्स("#00ffcc");
    सूची रंग_५ = प्रत्याहार_पाठ_बाइट्स("#ffffff");
    सूची रंग_६ = प्रत्याहार_पाठ_बाइट्स("#0f172a");
    सूची रंग_७ = प्रत्याहार_पाठ_बाइट्स("#1e293b");
    सूची रंग_८ = प्रत्याहार_पाठ_बाइट्स("#f8fafc");
    सूची रंग_९ = प्रत्याहार_पाठ_बाइट्स("#000000");

    सूची पाठ_अष्टफलक = प्रत्याहार_पाठ_बाइट्स("स्थानिक_चश्मा_अष्टफलक");
    सूची पाठ_घन = प्रत्याहार_पाठ_बाइट्स("तंत्रिका_चिप_घन");
    सूची पाठ_पिरामिड = प्रत्याहार_पाठ_बाइट्स("उद्यम_सर्वर_पिरामिड");
    सूची पाठ_हीरो = प्रत्याहार_पाठ_बाइट्स("अनुभाग_हीरो");
    सूची पाठ_चिप = प्रत्याहार_पाठ_बाइट्स("अनुभाग_चिप");
    सूची पाठ_उद्यम = प्रत्याहार_पाठ_बाइट्स("अनुभाग_उद्यम");
    सूची पाठ_अन्वेषण = प्रत्याहार_पाठ_बाइट्स("अन्वेषण_क्लिक");
    सूची पाठ_चिप_क्लिक = प्रत्याहार_पाठ_बाइट्स("चिप_क्लिक");
    सूची पाठ_सर्वर_क्लिक = प्रत्याहार_पाठ_बाइट्स("सर्वर_क्लिक");
    सूची पाठ_सूत्र = प्रत्याहार_पाठ_बाइट्स("सूत्र");
    सूची पाठ_मुख्य = प्रत्याहार_पाठ_बाइट्स("मुख्य");
    सूची पाठ_आज्ञा = प्रत्याहार_पाठ_बाइट्स("आज्ञा:");

    सूची आउट = [];
    संख्या लं = लंबाई(संपीड़ित);
    संख्या इ = ०;

    यावत् (इ < लं) {
        संख्या टोकन = संपीड़ित[इ];

        यदि (टोकन < १२८) {
            // लघु-पूर्णांक [०, टोकन]
            आउट = जोड़ें(आउट, ०);
            आउट = जोड़ें(आउट, टोकन);
            इ = इ + १;
        } अन्यथा यदि (टोकन >= १२८ && टोकन <= २१५) {
            // देवनागरी [९, टोकन - १२८]
            आउट = जोड़ें(आउट, ९);
            आउट = जोड़ें(आउट, टोकन - १२८);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_जादुई_सूत्र) {
            आउट = जोड़ें(आउट, ८३);
            आउट = जोड़ें(आउट, ८५);
            आउट = जोड़ें(आउट, ८४);
            आउट = जोड़ें(आउट, ८२);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_आसमानी) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_१);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_पन्ना) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_२);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_पीताभ) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_३);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_हरित) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_४);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_श्वेत) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_५);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_श्याम) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_६);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_धूसर) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_७);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_उज्ज्वल) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_८);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_रंग_गहन) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, रंग_९);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_मॉडल_अष्टफलक) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_अष्टफलक);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_मॉडल_घन) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_घन);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_मॉडल_पिरामिड) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_पिरामिड);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_अनुभाग_हीरो) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_हीरो);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_अनुभाग_चिप) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_चिप);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_अनुभाग_उद्यम) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_उद्यम);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_बटन_अन्वेषण) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_अन्वेषण);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_बटन_चिप) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_चिप_क्लिक);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_बटन_सर्वर) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_सर्वर_क्लिक);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_शब्द_सूत्र) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_सूत्र);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_शब्द_मुख्य) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_मुख्य);
            इ = इ + १;
        } अन्यथा यदि (टोकन == प्रत्याहार_शब्द_आज्ञा) {
            आउट = प्रत्याहार_सूची_विस्तार(आउट, पाठ_आज्ञा);
            इ = इ + १;
        } अन्यथा यदि (टोकन >= २४० && टोकन <= २४७) {
            // लघु शून्य-दौड़ (३..१० शून्य)
            संख्या गिनती = (टोकन - २४०) + ३;
            संख्या श = ०;
            यावत् (श < गिनती) {
                आउट = जोड़ें(आउट, ०);
                श = श + १;
            }
            इ = इ + १;
        } अन्यथा यदि (टोकन == २४८) {
            // दीर्घ शून्य-दौड़
            संख्या गिनती = संपीड़ित[इ + १];
            संख्या श = ०;
            यावत् (श < गिनती) {
                आउट = जोड़ें(आउट, ०);
                श = श + १;
            }
            इ = इ + २;
        } अन्यथा यदि (टोकन == २४९) {
            // सामान्य १६-बिट पूर्णांक
            आउट = जोड़ें(आउट, संपीड़ित[इ + १]);
            आउट = जोड़ें(आउट, संपीड़ित[इ + २]);
            इ = इ + ३;
        } अन्यथा यदि (टोकन == २५०) {
            // सामान्य यूनीकोड वर्ण
            आउट = जोड़ें(आउट, संपीड़ित[इ + १]);
            आउट = जोड़ें(आउट, संपीड़ित[इ + २]);
            इ = इ + ३;
        } अन्यथा यदि (टोकन == २५४) {
            // शाब्दिक एकल बाइट
            आउट = जोड़ें(आउट, संपीड़ित[इ + १]);
            इ = इ + २;
        } अन्यथा {
            फेको "त्रुटिः अज्ञात पाणिनीय प्रत्याहार टोकन: " + टोकन;
        }
    }

    परत् आउट;
}

// ==============================================================================
// भाग ५: पाठ एवं बाइटकोड संपीड़न सुविधा (Text & Bytecode Helpers)
// ==============================================================================

कार्य पाणिनीय_संपीड़न_पाठ(पाठ स्रोत) {
    सूची बाइट्स = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या इ = ०;
    यावत् (इ < लं) {
        संख्या कोड = अक्षर_मान(उपखंड(स्रोत, इ, इ + १));
        बाइट्स = जोड़ें(बाइट्स, दक्षिण_सरक(कोड, ८));
        बाइट्स = जोड़ें(बाइट्स, बिट_और(कोड, २५५));
        इ = इ + १;
    }
    परत् पाणिनीय_संपीड़न_बाइट्स(बाइट्स);
}

कार्य पाणिनीय_विसंपीड़न_पाठ(सूची संपीड़ित) {
    सूची बाइट्स = पाणिनीय_विसंपीड़न_बाइट्स(संपीड़ित);
    पाठ फल = "";
    संख्या लं = लंबाई(बाइट्स);
    संख्या इ = ०;
    यावत् (इ + १ < लं) {
        संख्या उच्च = बाइट्स[इ];
        संख्या निम्न = बाइट्स[इ + १];
        संख्या कोड = (उच्च * २५६) + निम्न;
        फल = फल + अक्षर_निर्माण(कोड);
        इ = इ + २;
    }
    परत् फल;
}

// संपीड़न मेट्रिक्स तुलना
कार्य पाणिनीय_संपीड़न_तुलना(सूची मूल_बाइट्स, सूची संपीड़ित_बाइट्स) {
    संख्या मूल_आकार = लंबाई(मूल_बाइट्स);
    संख्या संपीड़ित_आकार = लंबाई(संपीड़ित_बाइट्स);
    दशमलव बचत = ०.०;
    यदि (मूल_आकार > ०) {
        बचत = ((मूल_आकार - संपीड़ित_आकार) * १००.०) / (मूल_आकार * १.०);
    }
    शब्दकोश फल = {};
    फल["मूल_आकार"] = मूल_आकार;
    फल["संपीड़ित_आकार"] = संपीड़ित_आकार;
    फल["बचत_प्रतिशत"] = बचत;
    परत् फल;
}
