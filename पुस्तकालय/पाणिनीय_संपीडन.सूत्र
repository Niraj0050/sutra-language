// ==============================================================================
// भाग २: सहायक मिलान फलन (Matching Helper)
// ==============================================================================

कार्य प्रत्याहार_मेल_जाँच(सूची बाइट्स, संख्या स्थिति, सूची लक्ष्य) {
    संख्या लक्ष्य_लं = लंबाई(लक्ष्य);
    यदि (स्थिति + लक्ष्य_लं > लंबाई(बाइट्स)) {
        परत् असत्य;
    }
    संख्या इ = ०;
    यावत् (इ < लक्ष्य_लं) {
        यदि (बाइट्स[स्थिति + इ] != लक्ष्य[इ]) {
            परत् असत्य;
        }
        इ = इ + १;
    }
    परत् सत्य;
}

// पाठ को द्विआधारी पाठ बाइट्स ([०, लं] + [उच्च, निम्न]...) में बदलना
कार्य प्रत्याहार_पाठ_बाइट्स(पाठ स्रोत) {
    सूची फल = [];
    संख्या लं = लंबाई(स्रोत);
    फल = जोड़ें(फल, ०);
    फल = जोड़ें(फल, लं);
    संख्या इ = ०;
    यावत् (इ < लं) {
        संख्या कोड = अक्षर_मान(उपखंड(स्रोत, इ, इ + १));
        फल = जोड़ें(फल, दक्षिण_सरक(कोड, ८));
        फल = जोड़ें(फल, बिट_और(कोड, २५५));
        इ = इ + १;
    }
    परत् फल;
}

// सूची विस्तार संयोजन
कार्य प्रत्याहार_सूची_विस्तार(सूची लक्ष्य, सूची स्रोत) {
    संख्या ज = ०;
    संख्या कुल = लंबाई(स्रोत);
    यावत् (ज < कुल) {
        लक्ष्य = जोड़ें(लक्ष्य, स्रोत[ज]);
        ज = ज + १;
    }
    परत् लक्ष्य;
}

// ==============================================================================
// भाग ३: पाणिनीय प्रत्याहार संपीड़न (Paninian Stream Compression)
// ==============================================================================

कार्य पाणिनीय_संपीड़न_बाइट्स(सूची बाइट्स) {
    यदि (लंबाई(बाइट्स) == ०) { परत् []; }

    // बहु-प्रचलित संरचनाओं के पूर्व-गणना बाइट्स
    सूची रंग_१ = प्रत्याहार_पाठ_बाइट्स("#38bdf8");
    सूची रंग_२ = प्रत्याहार_पाठ_बाइट्स("#10b981");
    सूची रंग_३ = प्रत्याहार_पाठ_बाइट्स("#f59e0b");
    सूची रंग_४ = प्रत्याहार_पाठ_बाइट्स("#00ffcc");
    सूची रंग_५ = प्रत्याहार_पाठ_बाइट्स("#ffffff");
    सूची रंग_६ = प्रत्याहार_पाठ_बाइट्स("#0f172a");
    सूची रंग_७ = प्रत्याहार_पाठ_बाइट्स("#1e293b");
    सूची रंग_८ = प्रत्याहार_पाठ_बाइट्स("#f8fafc");
    सूची रंग_९ = प्रत्याहार_पाठ_बाइट्स("#000000");

    सूची पाठ_अष्टफलक = प्रत्याहार_पाठ_बाइट्स("स्थानिक_चश्मा_अष्टफलक");
    सूची पाठ_घन = प्रत्याहार_पाठ_बाइट्स("तंत्रिका_चिप_घन");
    सूची पाठ_पिरामिड = प्रत्याहार_पाठ_बाइट्स("उद्यम_सर्वर_पिरामिड");
    सूची पाठ_हीरो = प्रत्याहार_पाठ_बाइट्स("अनुभाग_हीरो");
    सूची पाठ_चिप = प्रत्याहार_पाठ_बाइट्स("अनुभाग_चिप");
    सूची पाठ_उद्यम = प्रत्याहार_पाठ_बाइट्स("अनुभाग_उद्यम");
    सूची पाठ_अन्वेषण = प्रत्याहार_पाठ_बाइट्स("अन्वेषण_क्लिक");
    सूची पाठ_चिप_क्लिक = प्रत्याहार_पाठ_बाइट्स("चिप_क्लिक");
    सूची पाठ_सर्वर_क्लिक = प्रत्याहार_पाठ_बाइट्स("सर्वर_क्लिक");
    सूची पाठ_सूत्र = प्रत्याहार_पाठ_बाइट्स("सूत्र");
    सूची पाठ_मुख्य = प्रत्याहार_पाठ_बाइट्स("मुख्य");
    सूची पाठ_आज्ञा = प्रत्याहार_पाठ_बाइट्स("आज्ञा:");

    सूची आउट = [];
    संख्या लं = लंबाई(बाइट्स);
    संख्या इ = ०;

    यावत् (इ < लं) {
        // १. स्थिर-संरचना प्रत्याहार (रंग एवं मॉडल पाठ)
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_१)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_आसमानी);
            इ = इ + लंबाई(रंग_१);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_२)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_पन्ना);
            इ = इ + लंबाई(रंग_२);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_३)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_पीताभ);
            इ = इ + लंबाई(रंग_३);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_४)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_हरित);
            इ = इ + लंबाई(रंग_४);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_५)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_श्वेत);
            इ = इ + लंबाई(रंग_५);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_६)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_श्याम);
            इ = इ + लंबाई(रंग_६);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_७)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_धूसर);
            इ = इ + लंबाई(रंग_७);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_८)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_उज्ज्वल);
            इ = इ + लंबाई(रंग_८);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, रंग_९)) {
            आउट = जोड़ें(आउट, प्रत्याहार_रंग_गहन);
            इ = इ + लंबाई(रंग_९);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_अष्टफलक)) {
            आउट = जोड़ें(आउट, प्रत्याहार_मॉडल_अष्टफलक);
            इ = इ + लंबाई(पाठ_अष्टफलक);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_घन)) {
            आउट = जोड़ें(आउट, प्रत्याहार_मॉडल_घन);
            इ = इ + लंबाई(पाठ_घन);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_पिरामिड)) {
            आउट = जोड़ें(आउट, प्रत्याहार_मॉडल_पिरामिड);
            इ = इ + लंबाई(पाठ_पिरामिड);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_हीरो)) {
            आउट = जोड़ें(आउट, प्रत्याहार_अनुभाग_हीरो);
            इ = इ + लंबाई(पाठ_हीरो);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_चिप)) {
            आउट = जोड़ें(आउट, प्रत्याहार_अनुभाग_चिप);
            इ = इ + लंबाई(पाठ_चिप);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_उद्यम)) {
            आउट = जोड़ें(आउट, प्रत्याहार_अनुभाग_उद्यम);
            इ = इ + लंबाई(पाठ_उद्यम);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_अन्वेषण)) {
            आउट = जोड़ें(आउट, प्रत्याहार_बटन_अन्वेषण);
            इ = इ + लंबाई(पाठ_अन्वेषण);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_चिप_क्लिक)) {
            आउट = जोड़ें(आउट, प्रत्याहार_बटन_चिप);
            इ = इ + लंबाई(पाठ_चिप_क्लिक);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_सर्वर_क्लिक)) {
            आउट = जोड़ें(आउट, प्रत्याहार_बटन_सर्वर);
            इ = इ + लंबाई(पाठ_सर्वर_क्लिक);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_सूत्र)) {
            आउट = जोड़ें(आउट, प्रत्याहार_शब्द_सूत्र);
            इ = इ + लंबाई(पाठ_सूत्र);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_मुख्य)) {
            आउट = जोड़ें(आउट, प्रत्याहार_शब्द_मुख्य);
            इ = इ + लंबाई(पाठ_मुख्य);
            जारीरह;
        }
        यदि (प्रत्याहार_मेल_जाँच(बाइट्स, इ, पाठ_आज्ञा)) {
            आउट = जोड़ें(आउट, प्रत्याहार_शब्द_आज्ञा);
            इ = इ + लंबाई(पाठ_आज्ञा);
            जारीरह;
        }

        // 'SUTR' (८३, ८५, ८४, ८२)
        यदि (इ + ३ < लं && बाइट्स[इ] == ८३ && बाइट्स[इ + १] == ८५ && बाइट्स[इ + २] == ८४ && बाइट्स[इ + ३] == ८२) {
            आउट = जोड़ें(आउट, प्रत्याहार_जादुई_सूत्र);
            इ = इ + ४;
            जारीरह;
        }

        // २. शून्य-दौड़ प्रत्याहार
        यदि (बाइट्स[इ] == ०) {
            संख्या श_गिनती = ०;
            यावत् (इ + श_गिनती < लं && बाइट्स[इ + श_गिनती] == ० && श_गिनती < २५५) {
                श_गिनती = श_गिनती + १;
            }
            यदि (श_गिनती >= ३) {
                यदि (श_गिनती <= १०) {
                    आउट = जोड़ें(आउट, २४० + (श_गिनती - ३));
                } अन्यथा {
                    आउट = जोड़ें(आउट, २४८);
                    आउट = जोड़ें(आउट, श_गिनती);
                }
                इ = इ + श_गिनती;
                जारीरह;
            }
        }

        // ३. लघु-पूर्णांक प्रत्याहार [०, ब] जहाँ ब < १२८
        यदि (इ + १ < लं && बाइट्स[इ] == ० && बाइट्स[इ + १] < १२८) {
            आउट = जोड़ें(आउट, बाइट्स[इ + १]); // ०..१२७
            इ = इ + २;
            जारीरह;
        }

        // ४. देवनागरी यूनीकोड प्रत्याहार [९, ब] जहाँ ब < ८८
        यदि (इ + १ < लं && बाइट्स[इ] == ९ && बाइट्स[इ + १] < ८८) {
            आउट = जोड़ें(आउट, १२८ + बाइट्स[इ + १]); // १२८..२१५
            इ = इ + २;
            जारीरह;
        }

        // ५. सामान्य १६-बिट पूर्णांक [०, ब] जहाँ ब >= १२८
        यदि (इ + १ < लं && बाइट्स[इ] == ० && बाइट्स[इ + १] >= १२८) {
            आउट = जोड़ें(आउट, २४९);
            आउट = जोड़ें(आउट, ०);
            आउट = जोड़ें(आउट, बाइट्स[इ + १]);
            इ = इ + २;
            जारीरह;
        }

        // ६. सामान्य यूनीकोड वर्ण [९, ब] जहाँ ब >= ८८
        यदि (इ + १ < लं && बाइट्स[इ] == ९ && बाइट्स[इ + १] >= ८८) {
            आउट = जोड़ें(आउट, २५०);
            आउट = जोड़ें(आउट, ९);
            आउट = जोड़ें(आउट, बाइट्स[इ + १]);
            इ = इ + २;
            जारीरह;
        }

        // ७. शाब्दिक एकल बाइट [२५४, ब]
        आउट = जोड़ें(आउट, २५४);
        आउट = जोड़ें(आउट, बाइट्स[इ]);
        इ = इ + १;
    }

    परत् आउट;
}

