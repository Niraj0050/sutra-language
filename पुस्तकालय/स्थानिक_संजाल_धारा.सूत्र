// पुस्तकालय/स्थानिक_संजाल_धारा.सूत्र — संप्रभु स्थानिक द्विआधारी संजाल धारा (Sovereign Binary Spatial Stream)
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-DOM | शून्य-अंग्रेजी वर्णमाला
//
// पारम्परिक वेब ब्राउज़र (Chrome, Safari, Firefox) सैकड़ों मेगाबाइट के HTML DOM,
// CSS stylesheets, और भारी JavaScript बंडलों को पार्स करने में भारी CPU व ऊर्जा
// नष्ट करते हैं।
//
// स्थानिक संजाल धारा (Sutra Spatial Binary Stream) एक संप्रभु द्विआधारी तार-प्रोटोकॉल
// (Micro-Binary Wire Protocol) है जो:
//   १. सर्वर से क्लाइंट तक ३डी ज्यामितीय जालों एवं २डी स्थानिक यूआई को
//      प्रत्यक्ष संपीड़ित द्विआधारी पैकेटों में प्रवाहित (Stream) करता है।
//   २. क्लाइंट से सर्वर तक स्क्रॉल व अंतःक्रियात्मक क्लिक संकेतों को
//      अति-लघु द्विआधारी पैकेटों में प्रेषित करता है।
//   ३. पारम्परिक वेब की तुलना में ९९.५%+ बैंडविड्थ की बचत करता है।
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/दृश्यक_द्विआधारी.सूत्र";
आयात "पुस्तकालय/जाल_घटक.सूत्र";
आयात "पुस्तकालय/पाणिनीय_संपीडन.सूत्र";

// ==============================================================================
// भाग १: पैकेट प्रकार स्थिरांक (Packet Types)
// ==============================================================================
मान पैकेट_प्रकार_अभिगमन        = १;  // क्लाइंट -> सर्वर: संप्रभु पता व पटल आकार
मान पैकेट_प्रकार_चौखटा          = २;  // सर्वर -> क्लाइंट: ३डी+२डी दृश्य चौखटा धारा (असंपीड़ित)
मान पैकेट_प्रकार_क्रिया           = ३;  // क्लाइंट -> सर्वर: स्क्रॉल / क्लिक घटना
मान पैकेट_प्रकार_अवस्था          = ४;  // सर्वर -> क्लाइंट: अवस्था एवं सुरक्षा पुष्टि
मान पैकेट_प्रकार_विराम           = ५;  // सत्र समाप्ति
मान पैकेट_प्रकार_संपीड़ित_चौखटा = ६;  // सर्वर -> क्लाइंट: पाणिनीय प्रत्याहार संपीड़ित चौखटा धारा

// क्रिया प्रकार
मान क्रिया_स्क्रॉल = १;
मान क्रिया_क्लिक   = २;

// ==============================================================================
// भाग २: शीर्षलेख पैकिंग एवं अनपैकिंग (9-Byte Standard Binary Header)
// ==============================================================================
// संरचना:
//   [०..३] : 'SUTR' (८३, ८५, ८४, ८२)
//   [४]    : पैकेट प्रकार (१..५)
//   [५..६] : अनुक्रम संख्या (Uint16)
//   [७..८] : पेलोड लंबाई (Uint16)

कार्य स्थानिक_शीर्षलेख_पैक(संख्या प्रकार, संख्या अनुक्रम, संख्या पेलोड_लं) {
    सूची बाइट्स = [];
    // 'SUTR'
    बाइट्स = जोड़ें(बाइट्स, ८३);
    बाइट्स = जोड़ें(बाइट्स, ८५);
    बाइट्स = जोड़ें(बाइट्स, ८४);
    बाइट्स = जोड़ें(बाइट्स, ८२);

    // प्रकार
    बाइट्स = जोड़ें(बाइट्स, प्रकार);

    // अनुक्रम
    सूची अनु_ब = द्विआधारी_१६बिट_पैक(अनुक्रम);
    बाइट्स = जोड़ें(बाइट्स, अनु_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, अनु_ब[१]);

    // पेलोड लंबाई
    सूची पेलोड_ब = द्विआधारी_१६बिट_पैक(पेलोड_लं);
    बाइट्स = जोड़ें(बाइट्स, पेलोड_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, पेलोड_ब[१]);

    परत् बाइट्स;
}

कार्य स्थानिक_शीर्षलेख_अनपैक(सूची बाइट्स, संख्या सूचकांक) {
    यदि (लंबाई(बाइट्स) - सूचकांक < ९) {
        फेको "त्रुटिः द्विआधारी संजाल पैकेट शीर्षलेख अपूर्ण";
    }

    यदि (बाइट्स[सूचकांक] != ८३ || बाइट्स[सूचकांक + १] != ८५ || बाइट्स[सूचकांक + २] != ८४ || बाइट्स[सूचकांक + ३] != ८२) {
        फेको "त्रुटिः अमान्य SUTR द्विआधारी संजाल पैकेट हस्ताक्षर";
    }

    संख्या प्रकार = बाइट्स[सूचकांक + ४];
    संख्या अनुक्रम = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ५);
    संख्या पेलोड_लं = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ७);

    शब्दकोश उत्तर = {};
    उत्तर["प्रकार"] = प्रकार;
    उत्तर["अनुक्रम"] = अनुक्रम;
    उत्तर["पेलोड_लंबाई"] = पेलोड_लं;
    उत्तर["शीर्षलेख_आकार"] = ९;
    परत् उत्तर;
}

// ==============================================================================
// भाग ३: पेलोड एन्कोडिंग (Payload Serialization)
// ==============================================================================

// १. अभिगमन पेलोड (URL Handshake: पता, चौड़ाई, ऊँचाई)
कार्य स्थानिक_अभिगमन_पेलोड_पैक(पाठ संप्रभु_पता, संख्या चौड़ाई, संख्या ऊँचाई) {
    सूची बाइट्स = द्विआधारी_पाठ_पैक(संप्रभु_पता);
    सूची चौ_ब = द्विआधारी_१६बिट_पैक(चौड़ाई);
    सूची ऊँ_ब = द्विआधारी_१६बिट_पैक(ऊँचाई);

    बाइट्स = जोड़ें(बाइट्स, चौ_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, चौ_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, ऊँ_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, ऊँ_ब[१]);
    परत् बाइट्स;
}

// २. चौखटा पेलोड (Frame Stream: सक्रिय अनुभाग, स्क्रॉल, ३डी संख्या, दृश्य बाइट्स)
कार्य स्थानिक_चौखटा_पेलोड_पैक(संख्या सक्रिय_अनुभाग, संख्या स्क्रॉल_य, संख्या सक्रिय_त्रिआयामी, सूची दृश्य_बाइट्स) {
    सूची बाइट्स = [];
    सूची अनु_ब = द्विआधारी_१६बिट_पैक(सक्रिय_अनुभाग);
    सूची स्क्रॉल_ब = द्विआधारी_१६बिट_पैक(स्क्रॉल_य);
    सूची त्रि_ब = द्विआधारी_१६बिट_पैक(सक्रिय_त्रिआयामी);

    बाइट्स = जोड़ें(बाइट्स, अनु_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, अनु_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, स्क्रॉल_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, स्क्रॉल_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, त्रि_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, त्रि_ब[१]);

    // आंतरिक दृश्यक द्विआधारी पेलोड संयोजन
    संख्या दृ_कुल = लंबाई(दृश्य_बाइट्स);
    संख्या दृ_इ = ०;
    यावत् (दृ_इ < दृ_कुल) {
        बाइट्स = जोड़ें(बाइट्स, दृश्य_बाइट्स[दृ_इ]);
        दृ_इ = दृ_इ + १;
    }
    परत् बाइट्स;
}

// २.ख पाणिनीय प्रत्याहार संपीड़ित चौखटा पेलोड (Paninian Pratyahara Compressed Frame)
कार्य स्थानिक_संपीड़ित_चौखटा_पेलोड_पैक(संख्या सक्रिय_अनुभाग, संख्या स्क्रॉल_य, संख्या सक्रिय_त्रिआयामी, सूची दृश्य_बाइट्स) {
    सूची संपीड़ित_दृश्य = पाणिनीय_संपीड़न_बाइट्स(दृश्य_बाइट्स);
    सूची बाइट्स = [];
    सूची अनु_ब = द्विआधारी_१६बिट_पैक(सक्रिय_अनुभाग);
    सूची स्क्रॉल_ब = द्विआधारी_१६बिट_पैक(स्क्रॉल_य);
    सूची त्रि_ब = द्विआधारी_१६बिट_पैक(सक्रिय_त्रिआयामी);

    बाइट्स = जोड़ें(बाइट्स, अनु_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, अनु_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, स्क्रॉल_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, स्क्रॉल_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, त्रि_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, त्रि_ब[१]);

    संख्या सं_कुल = लंबाई(संपीड़ित_दृश्य);
    संख्या सं_इ = ०;
    यावत् (सं_इ < सं_कुल) {
        बाइट्स = जोड़ें(बाइट्स, संपीड़ित_दृश्य[सं_इ]);
        सं_इ = सं_इ + १;
    }
    परत् बाइट्स;
}

// ३. क्रिया पेलोड (Client Event: स्क्रॉल / क्लिक)
कार्य स्थानिक_क्रिया_पेलोड_पैक(संख्या क्रिया_प्रकार, संख्या मान१, संख्या मान२, पाठ क्रिया_आईडी) {
    सूची बाइट्स = [];
    बाइट्स = जोड़ें(बाइट्स, क्रिया_प्रकार);

    सूची म१_ब = द्विआधारी_१६बिट_पैक(मान१);
    सूची म२_ब = द्विआधारी_१६बिट_पैक(मान२);

    बाइट्स = जोड़ें(बाइट्स, म१_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, म१_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, म२_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, म२_ब[१]);

    सूची क्रि_पैक = द्विआधारी_पाठ_पैक(क्रिया_आईडी);
    संख्या कि = ०;
    यावत् (कि < लंबाई(क्रि_पैक)) {
        बाइट्स = जोड़ें(बाइट्स, क्रि_पैक[कि]);
        कि = कि + १;
    }
    परत् बाइट्स;
}

// ४. अवस्था पेलोड (Server State Ack: स्थिति कोड, कार्ट संख्या, मुद्रा, संदेश)
कार्य स्थानिक_अवस्था_पेलोड_पैक(संख्या स्थिति_कोड, संख्या कार्ट_संख्या, पाठ सुरक्षा_मुद्रा, पाठ संदेश) {
    सूची बाइट्स = [];
    सूची स्थि_ब = द्विआधारी_१६बिट_पैक(स्थिति_कोड);
    सूची कार्ट_ब = द्विआधारी_१६बिट_पैक(कार्ट_संख्या);

    बाइट्स = जोड़ें(बाइट्स, स्थि_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, स्थि_ब[१]);
    बाइट्स = जोड़ें(बाइट्स, कार्ट_ब[०]);
    बाइट्स = जोड़ें(बाइट्स, कार्ट_ब[१]);

    सूची मुद्र_पैक = द्विआधारी_पाठ_पैक(सुरक्षा_मुद्रा);
    संख्या मु_इ = ०;
    यावत् (मु_इ < लंबाई(मुद्र_पैक)) {
        बाइट्स = जोड़ें(बाइट्स, मुद्र_पैक[मु_इ]);
        मु_इ = मु_इ + १;
    }

    सूची संदे_पैक = द्विआधारी_पाठ_पैक(संदेश);
    संख्या सं_इ = ०;
    यावत् (सं_इ < लंबाई(संदे_पैक)) {
        बाइट्स = जोड़ें(बाइट्स, संदे_पैक[सं_इ]);
        सं_इ = सं_इ + १;
    }
    परत् बाइट्स;
}

// ==============================================================================
// भाग ४: संपूर्ण पैकेट संश्लेषण (Packet Assembly)
// ==============================================================================

कार्य स्थानिक_पैकेट_संश्लेषण(संख्या प्रकार, संख्या अनुक्रम, सूची पेलोड) {
    संख्या पेलोड_लं = लंबाई(पेलोड);
    सूची शीर्षलेख = स्थानिक_शीर्षलेख_पैक(प्रकार, अनुक्रम, पेलोड_लं);

    सूची संपूर्ण = [];
    संख्या शि_इ = ०;
    यावत् (शि_इ < लंबाई(शीर्षलेख)) {
        संपूर्ण = जोड़ें(संपूर्ण, शीर्षलेख[शि_इ]);
        शि_इ = शि_इ + १;
    }

    संख्या पे_इ = ०;
    यावत् (पे_इ < पेलोड_लं) {
        संपूर्ण = जोड़ें(संपूर्ण, पेलोड[पे_इ]);
        पे_इ = पे_इ + १;
    }
    परत् संपूर्ण;
}

// ==============================================================================
// भाग ५: पैकेट पार्सिंग एवं वि-संश्लेषण (Packet Disassembly)
// ==============================================================================

कार्य स्थानिक_पैकेट_पार्स(सूची बाइट्स) {
    शब्दकोश शीर्ष = स्थानिक_शीर्षलेख_अनपैक(बाइट्स, ०);
    संख्या प्रकार = शीर्ष["प्रकार"];
    संख्या अनुक्रम = शीर्ष["अनुक्रम"];
    संख्या पेलोड_लं = शीर्ष["पेलोड_लंबाई"];
    संख्या सूचकांक = ९;

    शब्दकोश परिणाम = {};
    परिणाम["प्रकार"] = प्रकार;
    परिणाम["अनुक्रम"] = अनुक्रम;
    परिणाम["कुल_बाइट्स"] = लंबाई(बाइट्स);

    यदि (प्रकार == पैकेट_प्रकार_अभिगमन) {
        शब्दकोश पता_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
        परिणाम["संप्रभु_पता"] = पता_फल["पाठ"];
        सूचकांक = सूचकांक + पता_फल["खपत_बाइट्स"];

        परिणाम["पटल_चौड़ाई"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
        परिणाम["पटल_ऊँचाई"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);

    } अन्यथा यदि (प्रकार == पैकेट_प्रकार_चौखटा || प्रकार == पैकेट_प्रकार_संपीड़ित_चौखटा) {
        परिणाम["सक्रिय_अनुभाग"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
        परिणाम["स्क्रॉल_य"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);
        परिणाम["सक्रिय_त्रिआयामी"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ४);
        सूचकांक = सूचकांक + ६;

        // शेष दृश्य बाइट्स निकालें
        सूची दृश्य_पेलोड = [];
        यावत् (सूचकांक < लंबाई(बाइट्स)) {
            दृश्य_पेलोड = जोड़ें(दृश्य_पेलोड, बाइट्स[सूचकांक]);
            सूचकांक = सूचकांक + १;
        }

        यदि (प्रकार == पैकेट_प्रकार_संपीड़ित_चौखटा) {
            परिणाम["संपीड़ित_है"] = सत्य;
            परिणाम["दृश्य_संपीड़ित_बाइट्स"] = दृश्य_पेलोड;
            परिणाम["दृश्य_संपीड़ित_आकार"] = लंबाई(दृश्य_पेलोड);
            सूची मूल_दृश्य = पाणिनीय_विसंपीड़न_बाइट्स(दृश्य_पेलोड);
            परिणाम["दृश्य_कच्चे_बाइट्स"] = मूल_दृश्य;
            परिणाम["दृश्य_मूल_आकार"] = लंबाई(मूल_दृश्य);
            परिणाम["दृश्य_आदेश"] = दृश्यक_द्विआधारी_डीकोड(मूल_दृश्य);
        } अन्यथा {
            परिणाम["संपीड़ित_है"] = असत्य;
            परिणाम["दृश्य_कच्चे_बाइट्स"] = दृश्य_पेलोड;
            परिणाम["दृश्य_मूल_आकार"] = लंबाई(दृश्य_पेलोड);
            परिणाम["दृश्य_संपीड़ित_आकार"] = लंबाई(दृश्य_पेलोड);
            परिणाम["दृश्य_आदेश"] = दृश्यक_द्विआधारी_डीकोड(दृश्य_पेलोड);
        }

    } अन्यथा यदि (प्रकार == पैकेट_प्रकार_क्रिया) {
        परिणाम["क्रिया_प्रकार"] = बाइट्स[सूचकांक];
        परिणाम["मान१"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + १);
        परिणाम["मान२"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ३);
        सूचकांक = सूचकांक + ५;

        शब्दकोश क्रिया_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
        परिणाम["क्रिया_आईडी"] = क्रिया_फल["पाठ"];

    } अन्यथा यदि (प्रकार == पैकेट_प्रकार_अवस्था) {
        परिणाम["स्थिति_कोड"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
        परिणाम["कार्ट_संख्या"] = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);
        सूचकांक = सूचकांक + ४;

        शब्दकोश मुद्रा_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
        परिणाम["सुरक्षा_मुद्रा"] = मुद्रा_फल["पाठ"];
        सूचकांक = सूचकांक + मुद्रा_फल["खपत_बाइट्स"];

        शब्दकोश संदेश_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
        परिणाम["संदेश"] = संदेश_फल["पाठ"];
    }

    परत् परिणाम;
}

