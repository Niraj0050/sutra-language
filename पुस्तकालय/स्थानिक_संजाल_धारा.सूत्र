    शब्दकोश दृश्य = संश्लेषण["दृश्य"];

    सूची आदेश_सूची = दृश्यक_चौखटा_आदेश(दृश्य, पटल_चौ, पटल_ऊँ);
    सूची द्विआधारी_प्रवाह = दृश्यक_द्विआधारी_एन्कोड(आदेश_सूची);

    शब्दकोश चौखटा_फल = {};
    चौखटा_फल["दृश्य"] = दृश्य;
    चौखटा_फल["सक्रिय_अनुभाग"] = दर्शक["सक्रिय_अनुभाग"];
    चौखटा_फल["स्क्रॉल_य"] = स्क्रॉल_य;
    चौखटा_फल["सक्रिय_त्रिआयामी_मॉडल_संख्या"] = संश्लेषण["सक्रिय_त्रिआयामी_मॉडल_संख्या"];
    चौखटा_फल["द्विआधारी_बाइट_संख्या"] = लंबाई(द्विआधारी_प्रवाह);
    परत् चौखटा_फल;
}

