// पुस्तकालय/दृश्यक.सूत्र — एकीकृत द्वि-आयामी एवं त्रि-आयामी स्थानिक दृश्य इंजन (Unified 2D + 3D Spatial Engine)
// ============================================================
// आयात "पुस्तकालय/दृश्यक.सूत्र";
//
// पारंपरिक HTML, CSS, JavaScript, और भारी 3D वेब ढाँचों (Three.js/WebGL DOM)
// को पूर्णतः विलोपित (Eliminate) करने वाला एकीकृत स्थानिक दृश्य कोर।
//
// १. द्वि-आयामी अर्थगत घटक (2D Semantic Box & Constraints — No HTML/CSS)
// २. त्रि-आयामी बीजगणित एवं ४x४ आव्यूह (3D Vector, LookAt & Perspective Math)
// ३. त्रि-आयामी जाल निर्माण (3D Meshes: Cube, Pyramid, Vertex/Normal Buffers)
// ४. एकीकृत स्थानिक दृश्य-ग्राफ़ (Unified 2D UI + 3D Spatial Scene)
// ५. प्रत्यक्ष प्रक्षेपण एवं चित्रांकन आदेश प्रवाह (Zero-DOM Render Commands)
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/दिशक.सूत्र";
आयात "पुस्तकालय/आव्यूह.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";

// ============================================================
// भाग १: द्वि-आयामी अर्थगत घटक (2D Semantic UI Components)
// ============================================================

कार्य दृश्यक_डिब्बा(शब्दकोश गुण, सूची बच्चे) {
    शब्दकोश नोड = {};
    नोड["प्रकार"] = "डिब्बा";
    नोड["दिशा"] = "स्तंभ";        // डिफ़ॉल्ट "स्तंभ" अथवा "पंक्ति"
    नोड["पैडिंग"] = ०.०;
    नोड["अंतर"] = ०.०;
    नोड["पृष्ठ_रंग"] = "";
    नोड["किनारा_रंग"] = "";
    नोड["चौड़ाई"] = ०.०;
    नोड["ऊँचाई"] = ०.०;
    नोड["बच्चे"] = बच्चे;
    नोड["स्थान"] = [०.०, ०.०, ०.०, ०.०]; // [बाएँ, ऊपर, चौड़ाई, ऊँचाई]

    यदि (कुंजी_है(गुण, "दिशा")) { नोड["दिशा"] = गुण["दिशा"]; }
    यदि (कुंजी_है(गुण, "पैडिंग")) { नोड["पैडिंग"] = गुण["पैडिंग"]; }
    यदि (कुंजी_है(गुण, "अंतर")) { नोड["अंतर"] = गुण["अंतर"]; }
    यदि (कुंजी_है(गुण, "पृष्ठ_रंग")) { नोड["पृष्ठ_रंग"] = गुण["पृष्ठ_रंग"]; }
    यदि (कुंजी_है(गुण, "चौड़ाई")) { नोड["चौड़ाई"] = गुण["चौड़ाई"]; }
    यदि (कुंजी_है(गुण, "ऊँचाई")) { नोड["ऊँचाई"] = गुण["ऊँचाई"]; }

    परत् नोड;
}

कार्य दृश्यक_लेख(पाठ सामग्री, शब्दकोश गुण) {
    शब्दकोश नोड = {};
    नोड["प्रकार"] = "लेख";
    नोड["सामग्री"] = सामग्री;
    नोड["आकार"] = १४.०;
    नोड["रंग"] = "#ffffff";
    नोड["स्थान"] = [०.०, ०.०, ०.०, ०.०];

    यदि (कुंजी_है(गुण, "आकार")) { नोड["आकार"] = गुण["आकार"]; }
    यदि (कुंजी_है(गुण, "रंग")) { नोड["रंग"] = गुण["रंग"]; }

    परत् नोड;
}

कार्य दृश्यक_बटन(पाठ लेबल, पाठ क्रिया_आईडी, शब्दकोश गुण) {
    शब्दकोश नोड = {};
    नोड["प्रकार"] = "बटन";
    नोड["सामग्री"] = लेबल;
    नोड["क्रिया_आईडी"] = क्रिया_आईडी;
    नोड["पृष्ठ_रंग"] = "#3b82f6";
    नोड["रंग"] = "#ffffff";
    नोड["स्थान"] = [०.०, ०.०, १२०.०, ४०.०];

    यदि (कुंजी_है(गुण, "पृष्ठ_रंग")) { नोड["पृष्ठ_रंग"] = गुण["पृष्ठ_रंग"]; }
    यदि (कुंजी_है(गुण, "रंग")) { नोड["रंग"] = गुण["रंग"]; }
    यदि (कुंजी_है(गुण, "चौड़ाई")) { नोड["स्थान"][२] = गुण["चौड़ाई"]; }
    यदि (कुंजी_है(गुण, "ऊँचाई")) { नोड["स्थान"][३] = गुण["ऊँचाई"]; }

    परत् नोड;
}

// १-पास विश्लेषणात्मक लेआउट समाधान (1-Pass Box Constraint Solver — No CSS Reflows)
कार्य दृश्यक_२डी_लेआउट(शब्दकोश जड़, दशमलव बाएँ, दशमलव ऊपर, दशमलव चौड़ाई, दशमलव ऊँचाई) {
    जड़["स्थान"] = [बाएँ, ऊपर, चौड़ाई, ऊँचाई];

    यदि (जड़["प्रकार"] == "डिब्बा") {
        सूची बच्चे = जड़["बच्चे"];
        संख्या कुल_बच्चे = लंबाई(बच्चे);
        यदि (कुल_बच्चे == ०) { परत् जड़; }

        दशमलव पैडिंग = जड़["पैडिंग"];
        दशमलव अंतर = जड़["अंतर"];
        दशमलव आरंभ_क्ष = बाएँ + पैडिंग;
        दशमलव आरंभ_य = ऊपर + पैडिंग;
        दशमलव उपलब्ध_चौड़ाई = चौड़ाई - (२.० * पैडिंग);
        दशमलव उपलब्ध_ऊँचाई = ऊँचाई - (२.० * पैडिंग);

        यदि (जड़["दिशा"] == "स्तंभ") {
            दशमलव बच्चा_ऊँचाई = (उपलब्ध_ऊँचाई - (अंतर * (कुल_बच्चे - १) * १.०)) / (कुल_बच्चे * १.०);
            दशमलव वर्तमान_य = आरंभ_य;
            संख्या इ = ०;
            यावत् (इ < कुल_बच्चे) {
                शब्दकोश बच्चा = बच्चे[इ];
                दृश्यक_२डी_लेआउट(बच्चा, आरंभ_क्ष, वर्तमान_य, उपलब्ध_चौड़ाई, बच्चा_ऊँचाई);
                वर्तमान_य = वर्तमान_य + बच्चा_ऊँचाई + अंतर;
                इ = इ + १;
            }
        } अन्यथा {
            // पंक्ति दिशा (Row)
            दशमलव बच्चा_चौड़ाई = (उपलब्ध_चौड़ाई - (अंतर * (कुल_बच्चे - १) * १.०)) / (कुल_बच्चे * १.०);
            दशमलव वर्तमान_क्ष = आरंभ_क्ष;
            संख्या इ = ०;
            यावत् (इ < कुल_बच्चे) {
                शब्दकोश बच्चा = बच्चे[इ];
                दृश्यक_२डी_लेआउट(बच्चा, वर्तमान_क्ष, आरंभ_य, बच्चा_चौड़ाई, उपलब्ध_ऊँचाई);
                वर्तमान_क्ष = वर्तमान_क्ष + बच्चा_चौड़ाई + अंतर;
                इ = इ + १;
            }
        }
    }

    परत् जड़;
}

// ============================================================
// भाग २: त्रि-आयामी स्थानिक गणित एवं ४x४ आव्यूह (3D Math & 4x4 Matrices)
// ============================================================

कार्य दृश्यक_सदिश३(दशमलव क्ष, दशमलव य, दशमलव ज्ञ) {
    परत् [क्ष, य, ज्ञ];
}

// ४x४ शून्य आव्यूह
कार्य दृश्यक_आव्यूह४_शून्य() {
    सूची पंक्तियाँ = [];
    संख्या इ = ०;
    यावत् (इ < ४) {
        पंक्तियाँ = जोड़ें(पंक्तियाँ, [०.०, ०.०, ०.०, ०.०]);
        इ = इ + १;
    }
    परत् पंक्तियाँ;
}

// ४x४ तत्समक आव्यूह (Identity Matrix)
कार्य दृश्यक_आव्यूह४_तत्समक() {
    सूची म = दृश्यक_आव्यूह४_शून्य();
    म[०][०] = १.०;
    म[१][१] = १.०;
    म[२][२] = १.०;
    म[३][३] = १.०;
    परत् म;
}

// अनुवाद आव्यूह (Translation Matrix)
कार्य दृश्यक_आव्यूह४_अनुवाद(दशमलव अनु_क्ष, दशमलव अनु_य, दशमलव अनु_ज्ञ) {
    सूची म = दृश्यक_आव्यूह४_तत्समक();
    म[०][३] = अनु_क्ष;
    म[१][३] = अनु_य;
    म[२][३] = अनु_ज्ञ;
    परत् म;
}

// पैमाना आव्यूह (Scaling Matrix)
कार्य दृश्यक_आव्यूह४_पैमाना(दशमलव पै_क्ष, दशमलव पै_य, दशमलव पै_ज्ञ) {
    सूची म = दृश्यक_आव्यूह४_तत्समक();
    म[०][०] = पै_क्ष;
    म[१][१] = पै_य;
    म[२][२] = पै_ज्ञ;
    परत् म;
}

// त्रिकोणमितीय टेलर श्रेणी आधार (Trigonometric Functions)
कार्य दृश्यक_साइन(दशमलव कोण) {
    दशमलव पाई_मान = ३.१४१५९२६५३५८९७९३;
    दशमलव दो_पाई = ६.२८३१८५३०७१७९५८६;
    यावत् (कोण > पाई_मान) { कोण = कोण - दो_पाई; }
    यावत् (कोण < ०.० - पाई_मान) { कोण = कोण + दो_पाई; }

    दशमलव क२ = कोण * कोण;
    दशमलव क३ = कोण * क२;
    दशमलव क५ = क३ * क२;
    दशमलव क७ = क५ * क२;

    परत् कोण - (क३ / ६.०) + (क५ / १२०.०) - (क७ / ५०४०.०);
}

कार्य दृश्यक_कोज्या(दशमलव कोण) {
    दशमलव पाई_मान = ३.१४१५९२६५३५८९७९३;
    दशमलव दो_पाई = ६.२८३१८५३०७१७९५८६;
    यावत् (कोण > पाई_मान) { कोण = कोण - दो_पाई; }
    यावत् (कोण < ०.० - पाई_मान) { कोण = कोण + दो_पाई; }

    दशमलव क२ = कोण * कोण;
    दशमलव क४ = क२ * क२;
    दशमलव क६ = क४ * क२;

    परत् १.० - (क२ / २.०) + (क४ / २४.०) - (क६ / ७२०.०);
}

कार्य दृश्यक_स्पर्शज्या(दशमलव कोण) {
    दशमलव स = दृश्यक_साइन(कोण);
    दशमलव क = दृश्यक_कोज्या(कोण);
    यदि (क == ०.०) { क = ०.०००००१; }
    परत् स / क;
}

// घूर्णन य-अक्ष (Rotation around Y-axis)
कार्य दृश्यक_आव्यूह४_घूर्णन_य(दशमलव रेडियन) {
    दशमलव क = दृश्यक_कोज्या(रेडियन);
    दशमलव स = दृश्यक_साइन(रेडियन);
    सूची म = दृश्यक_आव्यूह४_तत्समक();
    म[०][०] = क;
    म[०][२] = स;
    म[२][०] = ०.० - स;
    म[२][२] = क;
    परत् म;
}

// ४x४ आव्यूह गुणन (Matrix Multiplication A * B)
कार्य दृश्यक_आव्यूह४_गुणन(सूची अ, सूची ब) {
    सूची फल = दृश्यक_आव्यूह४_शून्य();
    संख्या पं = ०;
    यावत् (पं < ४) {
        संख्या स्तं = ०;
        यावत् (स्तं < ४) {
            दशमलव योग = ०.०;
            संख्या क = ०;
            यावत् (क < ४) {
                दशमलव अ_मान = अ[पं][क];
                दशमलव ब_मान = ब[क][स्तं];
                योग = योग + (अ_मान * ब_मान);
                क = क + १;
            }
            फल[पं][स्तं] = योग;
            स्तं = स्तं + १;
        }
        पं = पं + १;
    }
    परत् फल;
}

// ४x४ आव्यूह द्वारा सदिश३ रूपांतरण
कार्य दृश्यक_सदिश३_रूपांतरण(सूची म, सूची स३) {
    दशमलव क्ष = स३[०];
    दशमलव य = स३[१];
    दशमलव ज्ञ = स३[२];

    दशमलव न_क्ष = म[०][०] * क्ष + म[०][१] * य + म[०][२] * ज्ञ + म[०][३];
    दशमलव न_य = म[१][०] * क्ष + म[१][१] * य + म[१][२] * ज्ञ + म[१][३];
    दशमलव न_ज्ञ = म[२][०] * क्ष + म[२][१] * य + म[२][२] * ज्ञ + म[२][३];
    दशमलव डब्लू = म[३][०] * क्ष + म[३][१] * य + म[३][२] * ज्ञ + म[३][३];

    यदि (डब्लू != ०.० && डब्लू != १.०) {
        न_क्ष = न_क्ष / डब्लू;
        न_य = न_य / डब्लू;
        न_ज्ञ = न_ज्ञ / डब्लू;
    }

    परत् [न_क्ष, न_य, न_ज्ञ];
}

// परिप्रेक्ष्य प्रक्षेपण आव्यूह (Perspective Projection Matrix)
कार्य दृश्यक_परिप्रेक्ष्य(दशमलव दृष्टि_कोण_रेडियन, दशमलव पहलू_अनुपात, दशमलव निकट, दशमलव दूर) {
    दशमलव टैन_अर्ध = दृश्यक_स्पर्शज्या(दृष्टि_कोण_रेडियन / २.०);
    दशमलव एफ = १.० / टैन_अर्ध;

    सूची म = दृश्यक_आव्यूह४_शून्य();
    म[०][०] = एफ / पहलू_अनुपात;
    म[१][१] = एफ;
    म[२][२] = (दूर + निकट) / (निकट - दूर);
    म[२][३] = (२.० * दूर * निकट) / (निकट - दूर);
    म[३][२] = -१.०;
    म[३][३] = ०.०;
    परत् म;
}

// ============================================================
// भाग ३: त्रि-आयामी जाल निर्माण (3D Meshes: Cube & Geometry)
// ============================================================

कार्य दृश्यक_घन_जाल(दशमलव आकार) {
    दशमलव आधा = आकार / २.०;
    // ८ शीर्ष बिन्दु (8 Vertices)
    सूची शीर्ष = [
        [-आधा, -आधा, -आधा], // ०
        [ आधा, -आधा, -आधा], // १
        [ आधा,  आधा, -आधा], // २
        [-आधा,  आधा, -आधा], // ३
        [-आधा, -आधा,  आधा], // ४
        [ आधा, -आधा,  आधा], // ५
        [ आधा,  आधा,  आधा], // ६
        [-आधा,  आधा,  आधा]  // ७
    ];

    // १२ त्रिकोण (36 Indices - 6 Faces * 2 Triangles)
    सूची सूचकांक = [
        ०, १, २,  ०, २, ३, // पृष्ठ (Back)
        ५, ४, ७,  ५, ७, ६, // अग्र (Front)
        ४, ०, ३,  ४, ३, ७, // वाम (Left)
        १, ५, ६,  १, ६, २, // दक्षिण (Right)
        ३, २, ६,  ३, ६, ७, // शीर्ष (Top)
        ४, ५, १,  ४, १, ०  // तल (Bottom)
    ];

    शब्दकोश जाल = {};
    जाल["प्रकार"] = "घन";
    जाल["शीर्ष"] = शीर्ष;
    जाल["सूचकांक"] = सूचकांक;
    जाल["कुल_शीर्ष"] = ८;
    जाल["कुल_त्रिकोण"] = १२;
    परत् जाल;
}

// पिरामिड जाल (3D Pyramid Mesh)
कार्य दृश्यक_पिरामिड_जाल(दशमलव आधार_आकार, दशमलव ऊँचाई) {
    दशमलव आधा_आ = आधार_आकार / २.०;
    दशमलव आधा_ऊ = ऊँचाई / २.०;

    सूची शीर्ष = [
        [०.०, आधा_ऊ, ०.०],          // ०: शीर्ष (Apex)
        [-आधा_आ, -आधा_ऊ, -आधा_आ],   // १: वाम-पृष्ठ (Left-Back)
        [ आधा_आ, -आधा_ऊ, -आधा_आ],   // २: दक्षिण-पृष्ठ (Right-Back)
        [ आधा_आ, -आधा_ऊ,  आधा_आ],   // ३: दक्षिण-अग्र (Right-Front)
        [-आधा_आ, -आधा_ऊ,  आधा_आ]    // ४: वाम-अग्र (Left-Front)
    ];

    सूची सूचकांक = [
        ०, २, १,   // पृष्ठ त्रिकोण
        ०, ३, २,   // दक्षिण त्रिकोण
        ०, ४, ३,   // अग्र त्रिकोण
        ०, १, ४,   // वाम त्रिकोण
        १, २, ३,   // आधार त्रिकोण १
        १, ३, ४    // आधार त्रिकोण २
    ];

    शब्दकोश जाल = {};
    जाल["प्रकार"] = "पिरामिड";
    जाल["शीर्ष"] = शीर्ष;
    जाल["सूचकांक"] = सूचकांक;
    जाल["कुल_शीर्ष"] = ५;
    जाल["कुल_त्रिकोण"] = ६;
    परत् जाल;
}

// अष्टफलक जाल (3D Octahedron / Diamond Mesh)
कार्य दृश्यक_अष्टफलक_जाल(दशमलव आकार) {
    सूची शीर्ष = [
        [०.०, आकार, ०.०],     // ०: ऊर्ध्व शीर्ष (Top Apex)
        [०.०, -आकार, ०.०],    // १: निम्न शीर्ष (Bottom Apex)
        [-आकार, ०.०, ०.०],    // २: वाम (Left)
        [आकार, ०.०, ०.०],     // ३: दक्षिण (Right)
        [०.०, ०.०, -आकार],    // ४: पृष्ठ (Back)
        [०.०, ०.०, आकार]      // ५: अग्र (Front)
    ];

    सूची सूचकांक = [
        ०, २, ५,  ०, ५, ३,  ०, ३, ४,  ०, ४, २,  // ४ ऊपरी फलक
        १, ५, २,  १, ३, ५,  १, ४, ३,  १, २, ४   // ४ निचले फलक
    ];

    शब्दकोश जाल = {};
    जाल["प्रकार"] = "अष्टफलक";
    जाल["शीर्ष"] = शीर्ष;
    जाल["सूचकांक"] = सूचकांक;
    जाल["कुल_शीर्ष"] = ६;
    जाल["कुल_त्रिकोण"] = ८;
    परत् जाल;
}

