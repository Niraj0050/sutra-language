कार्य दृश्यक_वस्तु_जोड़ो(शब्दकोश दृश्य, शब्दकोश स्थानिक_वस्तु) {
    दृश्य["३डी_वस्तु_सूची"] = जोड़ें(दृश्य["३डी_वस्तु_सूची"], स्थानिक_वस्तु);
}

कार्य दृश्यक_यूआई_जोड़ो(शब्दकोश दृश्य, शब्दकोश यूआई_जड़) {
    दृश्य["२डी_यूआई_जड़"] = यूआई_जड़;
}

// ============================================================
// भाग ५: ३डी से २डी स्क्रीन प्रक्षेपण एवं प्रत्यक्ष चित्रांकन आदेश
// ============================================================

कार्य दृश्यक_स्क्रीन_प्रक्षेपण(सूची बिंदु३डी, दशमलव चौड़ाई, दशमलव ऊँचाई) {
    // सरल परिप्रेक्ष्य प्रक्षेपण: x_screen = (x / -z) * scale + center_x
    दशमलव क्ष = बिंदु३डी[०];
    दशमलव य = बिंदु३डी[१];
    दशमलव ज्ञ = बिंदु३डी[२];

    दशमलव दूरी = ज्ञ;
    यदि (दूरी < ०.१) { दूरी = ०.१; }

    दशमलव पैमाना = ५००.० / दूरी;
    दशमलव स्क्रीन_क्ष = (चौड़ाई / २.०) + (क्ष * पैमाना);
    दशमलव स्क्रीन_य = (ऊँचाई / २.०) - (य * पैमाना);

    परत् [स्क्रीन_क्ष, स्क्रीन_य];
}

// दृश्य का संपूर्ण चौखटा मूल्यांकन (Evaluate Scene Frame to Draw Orders)
कार्य दृश्यक_चौखटा_आदेश(शब्दकोश दृश्य, दशमलव चौड़ाई, दशमलव ऊँचाई) {
    सूची आदेश_सूची = [];

    // १. ३डी वस्तु प्रक्षेप एवं रेखा/त्रिकोण आदेश
    संख्या व_इ = ०;
    यावत् (व_इ < लंबाई(दृश्य["३डी_वस्तु_सूची"])) {
        शब्दकोश वस्तु = दृश्य["३डी_वस्तु_सूची"][व_इ];
        शब्दकोश जाल = वस्तु["जाल"];
        सूची रूपांतरण = वस्तु["रूपांतरण"];
        पाठ रंग = वस्तु["रंग"];

        // शीर्षों को रूपांतरित और प्रक्षेपित करना
        सूची प्रक्षेपित_शीर्ष = [];
        संख्या शी_इ = ०;
        यावत् (शी_इ < लंबाई(जाल["शीर्ष"])) {
            सूची मूल_बिंदु = जाल["शीर्ष"][शी_इ];
            सूची रूपांतरित = दृश्यक_सदिश३_रूपांतरण(रूपांतरण, मूल_बिंदु);
            सूची स्क्रीन_बिंदु = दृश्यक_स्क्रीन_प्रक्षेपण(रूपांतरित, चौड़ाई, ऊँचाई);
            प्रक्षेपित_शीर्ष = जोड़ें(प्रक्षेपित_शीर्ष, स्क्रीन_बिंदु);
            शी_इ = शी_इ + १;
        }

        // त्रिकोण ड्रा आदेश जोड़ना
        शब्दकोश आदेश_त्रिविम = {};
        आदेश_त्रिविम["प्रकार"] = "३डी_जाल";
        आदेश_त्रिविम["नाम"] = वस्तु["नाम"];
        आदेश_त्रिविम["प्रक्षेपित_शीर्ष"] = प्रक्षेपित_शीर्ष;
        आदेश_त्रिविम["सूचकांक"] = जाल["सूचकांक"];
        आदेश_त्रिविम["रंग"] = रंग;
        आदेश_सूची = जोड़ें(आदेश_सूची, आदेश_त्रिविम);

        व_इ = व_इ + १;
    }

    // २. २डी यूआई ओवरले आदेश (यदि उपस्थित हो)
    यदि (दृश्य["२डी_यूआई_जड़"] != शून्यम्) {
        शब्दकोश समतल_जड़ = दृश्यक_२डी_लेआउट(दृश्य["२डी_यूआई_जड़"], ०.०, ०.०, चौड़ाई, ऊँचाई);
        शब्दकोश आदेश_द्विविम = {};
        आदेश_द्विविम["प्रकार"] = "२डी_यूआई";
        आदेश_द्विविम["जड़"] = समतल_जड़;
        आदेश_सूची = जोड़ें(आदेश_सूची, आदेश_द्विविम);
    }

    परत् आदेश_सूची;
}
