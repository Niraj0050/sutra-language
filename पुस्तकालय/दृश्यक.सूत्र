कार्य दृश्यक_स्थानिक_वस्तु(पाठ नाम, शब्दकोश जाल, सूची रूपांतरण_आव्यूह, पाठ रंग) {
    शब्दकोश वस्तु = {};
    वस्तु["नाम"] = नाम;
    वस्तु["जाल"] = जाल;
    वस्तु["रूपांतरण"] = रूपांतरण_आव्यूह;
    वस्तु["रंग"] = रंग;
    परत् वस्तु;
}

कार्य दृश्यक_दृश्य_बनाओ() {
    शब्दकोश दृश्य = {};
    दृश्य["३डी_वस्तु_सूची"] = [];
    दृश्य["२डी_यूआई_जड़"] = शून्यम्;
    दृश्य["कैमरा_स्थिति"] = [०.०, ०.०, ५.०];
    दृश्य["कैमरा_लक्ष्य"] = [०.०, ०.०, ०.०];
    दृश्य["प्रकाश_दिशा"] = [०.०, १.०, १.०];
