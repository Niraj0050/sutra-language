// पुस्तकालय/स्थानिक_टैब_प्रबंधक.सूत्र — संप्रभु स्थानिक दर्शक बहु-टैब एवं इतिहास प्रबंधक
// ==============================================================================
// शून्य-HTML | शून्य-CSS | शून्य-JS | शून्य-अंग्रेजी वर्णमाला
//
// पारंपरिक क्रोमियम ब्राउज़र में प्रत्येक टैब २००-४००MB RAM और स्वतंत्र V8 रेंडरर
// प्रक्रियाएँ खा जाता है।
//
// सूत्र संप्रभु स्थानिक टैब प्रबंधक:
//   १. एकल विश्लेषणात्मक रेंडर लूप में अनेक संप्रभु पतों (Tabs) का कुशल प्रबंधन।
//   २. पूर्णतः स्वायत्त द्वि-दिशा इतिहास स्टैक (Back Stack / Forward Stack)।
//   ३. शून्य-रिफ्लो एवं तात्कालिक टैब स्विचिंग (Zero-Reflow Instant Tab Switch)।
//   ४. प्रत्येक टैब की स्वतंत्र ३डी मॉडल अवस्था, स्क्रॉल स्थिति एवं कार्ट स्मृति।
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/जाल_घटक.सूत्र";
आयात "पुस्तकालय/स्थानिक_संजाल_धारा.सूत्र";

// ==============================================================================
// भाग १: एकल टैब संरचना (Single Tab State)
// ==============================================================================

कार्य स्थानिक_टैब_रचना(संख्या टैब_आईडी, पाठ संप्रभु_पता, दशमलव चौड़ाई, दशमलव ऊँचाई) {
    शब्दकोश टैब = {};
    टैब["टैब_आईडी"] = टैब_आईडी;
    टैब["शीर्षक"] = संप्रभु_पता;
    टैब["दर्शक"] = स्थानिक_दर्शक_रचना(संप्रभु_पता, चौड़ाई, ऊँचाई);
    टैब["इतिहास_सूची"] = []; // वापस स्टैक (Back Stack)
    टैब["अग्रिम_सूची"] = [];  // अग्रिम स्टैक (Forward Stack)
    परत् टैब;
}

// ==============================================================================
// भाग २: बहु-टैब प्रबंधक (Multi-Tab Manager Engine)
// ==============================================================================

कार्य स्थानिक_टैब_प्रबंधक_रचना(दशमलव पटल_चौड़ाई, दशमलव पटल_ऊँचाई) {
    शब्दकोश प्रबंधक = {};
    प्रबंधक["पटल_चौड़ाई"] = पटल_चौड़ाई;
    प्रबंधक["पटल_ऊँचाई"] = पटल_ऊँचाई;
    प्रबंधक["टैब_सूची"] = [];
    प्रबंधक["सक्रिय_टैब_आईडी"] = ०;
    प्रबंधक["अगला_टैब_आईडी"] = १;
    प्रबंधक["कुल_सक्रिय_टैब"] = ०;
    परत् प्रबंधक;
}

// नवीन टैब जोड़ना
कार्य स्थानिक_टैब_नया(शब्दकोश प्रबंधक, पाठ संप्रभु_पता) {
    संख्या नया_आईडी = प्रबंधक["अगला_टैब_आईडी"];
    संख्या अगला_आईडी = नया_आईडी + १;
    प्रबंधक["अगला_टैब_आईडी"] = अगला_आईडी;

    शब्दकोश नया_टैब = स्थानिक_टैब_रचना(
        नया_आईडी,
        संप्रभु_पता,
        प्रबंधक["पटल_चौड़ाई"],
        प्रबंधक["पटल_ऊँचाई"]
    );

    प्रबंधक["टैब_सूची"] = जोड़ें(प्रबंधक["टैब_सूची"], नया_टैब);
    प्रबंधक["कुल_सक्रिय_टैब"] = लंबाई(प्रबंधक["टैब_सूची"]);
    प्रबंधक["सक्रिय_टैब_आईडी"] = नया_आईडी;
    परत् नया_टैब;
}

// सक्रिय टैब प्राप्त करना
कार्य स्थानिक_टैब_सक्रिय_प्राप्त(शब्दकोश प्रबंधक) {
    संख्या सक्रिय_आईडी = प्रबंधक["सक्रिय_टैब_आईडी"];
    संख्या कुल = लंबाई(प्रबंधक["टैब_सूची"]);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        शब्दकोश टैब = प्रबंधक["टैब_सूची"][इ];
        यदि (टैब["टैब_आईडी"] == सक्रिय_आईडी) {
            परत् टैब;
        }
        इ = इ + १;
    }
    यदि (कुल > ०) {
        परत् प्रबंधक["टैब_सूची"][०];
    }
    परत् शून्यम्;
}

// टैब चुनना (Switch Active Tab)
कार्य स्थानिक_टैब_चुनें(शब्दकोश प्रबंधक, संख्या लक्ष्य_टैब_आईडी) {
    संख्या कुल = लंबाई(प्रबंधक["टैब_सूची"]);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        शब्दकोश टैब = प्रबंधक["टैब_सूची"][इ];
        यदि (टैब["टैब_आईडी"] == लक्ष्य_टैब_आईडी) {
            प्रबंधक["सक्रिय_टैब_आईडी"] = लक्ष्य_टैब_आईडी;
            परत् सत्य;
        }
        इ = इ + १;
    }
    परत् असत्य;
}

// टैब बंद करना (Close Tab)
कार्य स्थानिक_टैब_बंद(शब्दकोश प्रबंधक, संख्या लक्ष्य_टैब_आईडी) {
    सूची नई_सूची = [];
    संख्या कुल = लंबाई(प्रबंधक["टैब_सूची"]);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        शब्दकोश टैब = प्रबंधक["टैब_सूची"][इ];
        यदि (टैब["टैब_आईडी"] != लक्ष्य_टैब_आईडी) {
            नई_सूची = जोड़ें(नई_सूची, टैब);
        }
        इ = इ + १;
    }
    प्रबंधक["टैब_सूची"] = नई_सूची;
    प्रबंधक["कुल_सक्रिय_टैब"] = लंबाई(नई_सूची);

    यदि (प्रबंधक["सक्रिय_टैब_आईडी"] == लक्ष्य_टैब_आईडी) {
        यदि (लंबाई(नई_सूची) > ०) {
            शब्दकोश पिछला_टैब = नई_सूची[लंबाई(नई_सूची) - १];
            प्रबंधक["सक्रिय_टैब_आईडी"] = पिछला_टैब["टैब_आईडी"];
        } अन्यथा {
            प्रबंधक["सक्रिय_टैब_आईडी"] = ०;
        }
    }
    परत् सत्य;
}

// ==============================================================================
// भाग ३: इतिहास नेविगेशन (History: Navigate, Back, Forward)
// ==============================================================================

// नवीन संप्रभु पते पर जाना
कार्य स्थानिक_टैब_अभिगमन(शब्दकोश प्रबंधक, पाठ नया_संप्रभु_पता) {
    शब्दकोश टैब = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    यदि (टैब == शून्यम्) { परत् असत्य; }

    शब्दकोश दर्शक = टैब["दर्शक"];
    पाठ वर्तमान_पता = दर्शक["संप्रभु_पता"];

    // वर्तमान पृष्ठ स्थिति इतिहास में सहेजें
    शब्दकोश इतिहास_तत्व = {};
    इतिहास_तत्व["पता"] = वर्तमान_पता;
    इतिहास_तत्व["स्क्रॉल_य"] = दर्शक["स्क्रॉल_य"];
    इतिहास_तत्व["सक्रिय_अनुभाग"] = दर्शक["सक्रिय_अनुभाग"];

    टैब["इतिहास_सूची"] = जोड़ें(टैब["इतिहास_सूची"], इतिहास_तत्व);
    टैब["अग्रिम_सूची"] = []; // नया नेविगेशन होने पर फॉरवर्ड स्टैक रीसेट

    // नवीन पता लोड
    दर्शक["संप्रभु_पता"] = नया_संप्रभु_पता;
    दर्शक["स्क्रॉल_य"] = ०.०;
    दर्शक["सक्रिय_अनुभाग"] = ०;
    टैब["शीर्षक"] = नया_संप्रभु_पता;

    परत् सत्य;
}

// पीछे जाना (Back Navigation)
कार्य स्थानिक_टैब_वापस(शब्दकोश प्रबंधक) {
    शब्दकोश टैब = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    यदि (टैब == शून्यम्) { परत् असत्य; }

    संख्या इति_लं = लंबाई(टैब["इतिहास_सूची"]);
    यदि (इति_लं == ०) {
        परत् असत्य; // पीछे जाने के लिए कोई इतिहास नहीं
    }

    शब्दकोश दर्शक = टैब["दर्शक"];
    पाठ वर्तमान_पता = दर्शक["संप्रभु_पता"];

    // वर्तमान पृष्ठ को फॉरवर्ड स्टैक में डालें
    शब्दकोश अग्रिम_तत्व = {};
    अग्रिम_तत्व["पता"] = वर्तमान_पता;
    अग्रिम_तत्व["स्क्रॉल_य"] = दर्शक["स्क्रॉल_य"];
    अग्रिम_तत्व["सक्रिय_अनुभाग"] = दर्शक["सक्रिय_अनुभाग"];
    टैब["अग्रिम_सूची"] = जोड़ें(टैब["अग्रिम_सूची"], अग्रिम_तत्व);

    // इतिहास से पिछला पृष्ठ निकालें
    शब्दकोश पिछला = टैब["इतिहास_सूची"][इति_लं - १];

    // इतिहास स्टैक छोटा करें
    सूची नई_इतिहास_सूची = [];
    संख्या इ = ०;
    यावत् (इ < इति_लं - १) {
        नई_इतिहास_सूची = जोड़ें(नई_इतिहास_सूची, टैब["इतिहास_सूची"][इ]);
        इ = इ + १;
    }
    टैब["इतिहास_सूची"] = नई_इतिहास_सूची;

    // पिछला पृष्ठ पुनर्स्थापित करें
    दर्शक["संप्रभु_पता"] = पिछला["पता"];
    दर्शक["स्क्रॉल_य"] = पिछला["स्क्रॉल_य"];
    दर्शक["सक्रिय_अनुभाग"] = पिछला["सक्रिय_अनुभाग"];
    टैब["शीर्षक"] = पिछला["पता"];

    परत् सत्य;
}

// आगे जाना (Forward Navigation)
कार्य स्थानिक_टैब_अग्रिम(शब्दकोश प्रबंधक) {
    शब्दकोश टैब = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    यदि (टैब == शून्यम्) { परत् असत्य; }

    संख्या अग्रि_लं = लंबाई(टैब["अग्रिम_सूची"]);
    यदि (अग्रि_लं == ०) {
        परत् असत्य; // आगे जाने के लिए कोई पृष्ठ नहीं
    }

    शब्दकोश दर्शक = टैब["दर्शक"];
    पाठ वर्तमान_पता = दर्शक["संप्रभु_पता"];

    // वर्तमान पृष्ठ को इतिहास स्टैक में डालें
    शब्दकोश इतिहास_तत्व = {};
    इतिहास_तत्व["पता"] = वर्तमान_पता;
    इतिहास_तत्व["स्क्रॉल_य"] = दर्शक["स्क्रॉल_य"];
    इतिहास_तत्व["सक्रिय_अनुभाग"] = दर्शक["सक्रिय_अनुभाग"];
    टैब["इतिहास_सूची"] = जोड़ें(टैब["इतिहास_सूची"], इतिहास_तत्व);

    // फॉरवर्ड स्टैक से तत्व निकालें
    शब्दकोश अगला = टैब["अग्रिम_सूची"][अग्रि_लं - १];

    सूची नई_अग्रिम_सूची = [];
    संख्या इ = ०;
    यावत् (इ < अग्रि_लं - १) {
        नई_अग्रिम_सूची = जोड़ें(नई_अग्रिम_सूची, टैब["अग्रिम_सूची"][इ]);
        इ = इ + १;
    }
    टैब["अग्रिम_सूची"] = नई_अग्रिम_सूची;

    // अगला पृष्ठ पुनर्स्थापित करें
    दर्शक["संप्रभु_पता"] = अगला["पता"];
    दर्शक["स्क्रॉल_य"] = अगला["स्क्रॉल_य"];
    दर्शक["सक्रिय_अनुभाग"] = अगला["सक्रिय_अनुभाग"];
    टैब["शीर्षक"] = अगला["पता"];

    परत् सत्य;
}

// ==============================================================================
// भाग ४: संप्रभु टैब एवं नेविगेशन पट्टी यूआई संश्लेषण (Tab Bar Synthesis)
// ==============================================================================

कार्य स्थानिक_टैब_पट्टी_रचना(शब्दकोश प्रबंधक) {
    सूची शीर्ष_तत्व = [];

    // नेविगेशन बटन: वापस (Back) एवं अग्रिम (Forward)
    शब्दकोश सक्रिय_टैब = स्थानिक_टैब_सक्रिय_प्राप्त(प्रबंधक);
    पाठ वापस_रंग = "#475569";
    पाठ अग्रिम_रंग = "#475569";

    यदि (सक्रिय_टैब != शून्यम् && लंबाई(सक्रिय_टैब["इतिहास_सूची"]) > ०) {
        वापस_रंग = "#38bdf8";
    }
    यदि (सक्रिय_टैब != शून्यम् && लंबाई(सक्रिय_टैब["अग्रिम_सूची"]) > ०) {
        अग्रिम_रंग = "#38bdf8";
    }

    शब्दकोश वापस_बटन = दृश्यक_बटन("⮜ वापस", "नेविगेशन_वापस", {
        "पृष्ठ_रंग": "#1e293b",
        "रंग": वापस_रंग,
        "चौड़ाई": ८०.०
    });
    शीर्ष_तत्व = जोड़ें(शीर्ष_तत्व, वापस_बटन);

    शब्दकोश अग्रिम_बटन = दृश्यक_बटन("अग्रिम ⮞", "नेविगेशन_अग्रिम", {
        "पृष्ठ_रंग": "#1e293b",
        "रंग": अग्रिम_रंग,
        "चौड़ाई": ८०.०
    });
    शीर्ष_तत्व = जोड़ें(शीर्ष_तत्व, अग्रिम_बटन);

    // सभी सक्रिय टैब बटन
    संख्या कुल = लंबाई(प्रबंधक["टैब_सूची"]);
    संख्या इ = ०;
    यावत् (इ < कुल) {
        शब्दकोश टैब = प्रबंधक["टैब_सूची"][इ];
        पाठ पृष्ठ_रंग = "#0f172a";
        पाठ लेख_रंग = "#94a3b8";

        यदि (टैब["टैब_आईडी"] == प्रबंधक["सक्रिय_टैब_आईडी"]) {
            पृष्ठ_रंग = "#0284c7";
            लेख_रंग = "#ffffff";
        }

        पाठ टैब_लेबल = "🗂️ " + टैब["शीर्षक"];
        शब्दकोश टैब_बटन = दृश्यक_बटन(टैब_लेबल, "टैब_क्लिक_" + देवनागरी_अंकों_में("" + टैब["टैब_आईडी"]), {
            "पृष्ठ_रंग": पृष्ठ_रंग,
            "रंग": लेख_रंग,
            "चौड़ाई": १४०.०
        });
        शीर्ष_तत्व = जोड़ें(शीर्ष_तत्व, टैब_बटन);
        इ = इ + १;
    }

    // नया टैब जोड़ें '+' बटन
    शब्दकोश जोड़_बटन = दृश्यक_बटन("+", "टैब_नवीन", {
        "पृष्ठ_रंग": "#334155",
        "रंग": "#f8fafc",
        "चौड़ाई": ३५.०
    });
    शीर्ष_तत्व = जोड़ें(शीर्ष_तत्व, जोड़_बटन);

    शब्दकोश टैब_डिब्बा = दृश्यक_डिब्बा({
        "दिशा": "पंक्ति",
        "पृष्ठ_रंग": "#020617",
        "पैडिंग": ८.०,
        "अंतर": १०.०,
        "चौड़ाई": प्रबंधक["पटल_चौड़ाई"],
        "ऊँचाई": ४५.०
    }, शीर्ष_तत्व);

    परत् टैब_डिब्बा;
}
