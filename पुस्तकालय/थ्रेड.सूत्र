// पुस्तकालय/थ्रेड.सूत्र — असली OS थ्रेड + Mutex (Win32, विदेशी पर आधारित)
// ============================================================
// आयात "पुस्तकालय/थ्रेड.सूत्र";
//
//   कार्य कार्य_खंड(संख्या पैरामीटर) {
//       ... केवल संख्या-गणित + अंतर्_पढ़*/लिख* + विदेशी कॉल ...
//       परत् 0;
//   }
//   कार्य मुख्य() {
//       संख्या ह = थ्रेड_बनाओ(फलन_पता(कार्य_खंड), 0);
//       थ्रेड_प्रतीक्षा_बंद(ह);   // join
//   }
//
// ⚠️ GC-सुरक्षा (पढ़े बिना थ्रेड मत बनाओ): Sutra का GC (mark-sweep) single-
// threaded बना है। दूसरे थ्रेड पर चलने वाला फलन सूची/शब्दकोश/पाठ न बनाए, न
// किसी ऐसे फलन को बुलाए जो बनाता हो (जोड़ें, पाठ-जोड़, वर्ग की नवीन, आदि) —
// सिर्फ़ संख्या-गणित, अंतर्_पढ़8/पढ़1/लिख8/लिख1 (पहले-से-आवंटित raw buffer
// पर), और विदेशी कॉल। एक-बार-पहले-आवंटित बफर पर raw पढ़-लिख कई थ्रेड से
// mutex से सुरक्षित रखकर ठीक — देखो नीचे उदाहरण + examples/thread_test.सूत्र
// (4 थ्रेड, mutex-सुरक्षित साझा counter, exact परिणाम सत्यापित)।
//
// rules.md §2b — फलन_पता की पूरी व्याख्या।
// ============================================================

विदेशी "kernel32" "CreateThread" थ्रे_बनाओ_रॉ(संख्या, संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "kernel32" "WaitForSingleObject" थ्रे_प्रतीक्षा_रॉ(संख्या, संख्या);
विदेशी "kernel32" "CloseHandle" थ्रे_बंद_रॉ(संख्या);
विदेशी "kernel32" "CreateMutexA" थ्रे_म्यू_बनाओ_रॉ(संख्या, संख्या, संख्या);
विदेशी "kernel32" "ReleaseMutex" थ्रे_म्यू_छोड़ो_रॉ(संख्या);
विदेशी "kernel32" "Sleep" थ्रे_सोओ_रॉ(संख्या);
विदेशी "kernel32" "GetCurrentThreadId" थ्रे_वर्तमान_आईडी();

कार्य थ्रे_अनंत() { परत् ० - १; }   // INFINITE (निम्न 32-बिट = 0xFFFFFFFF)

// नया थ्रेड — प्रा = फलन_पता(...) से मिला पता; पैरामीटर उस फलन को rcx में
// मिलता। लौटाता है थ्रेड-हैंडल (0 = विफल)।
कार्य थ्रेड_बनाओ(संख्या प्रा, संख्या पैरामीटर) {
    परत् थ्रे_बनाओ_रॉ(०, ०, प्रा, पैरामीटर, ०, ०);
}

// थ्रेड के पूरा होने तक रुको (join); INFINITE प्रतीक्षा
कार्य थ्रेड_प्रतीक्षा(संख्या हैंडल) {
    परत् थ्रे_प्रतीक्षा_रॉ(हैंडल, थ्रे_अनंत());
}

कार्य थ्रेड_बंद(संख्या हैंडल) {
    परत् थ्रे_बंद_रॉ(हैंडल);
}

// सुविधा — प्रतीक्षा + हैंडल-मुक्ति एक साथ (सामान्य "join" पैटर्न)
कार्य थ्रेड_प्रतीक्षा_बंद(संख्या हैंडल) {
    थ्रेड_प्रतीक्षा(हैंडल);
    परत् थ्रेड_बंद(हैंडल);
}

कार्य सोओ(संख्या मिलीसेकंड) {
    परत् थ्रे_सोओ_रॉ(मिलीसेकंड);
}

// ---- Mutex — कई थ्रेड से साझा कच्चे-मेमोरी क्षेत्र की सुरक्षा हेतु ----

कार्य म्यूटेक्स_नया() {
    परत् थ्रे_म्यू_बनाओ_रॉ(०, ०, ०);   // unnamed, शुरू में unowned
}
कार्य म्यूटेक्स_लो(संख्या हैंडल) {
    परत् थ्रे_प्रतीक्षा_रॉ(हैंडल, थ्रे_अनंत());
}
कार्य म्यूटेक्स_छोड़ो(संख्या हैंडल) {
    परत् थ्रे_म्यू_छोड़ो_रॉ(हैंडल);
}
कार्य म्यूटेक्स_बंद(संख्या हैंडल) {
    परत् थ्रे_बंद_रॉ(हैंडल);
}
