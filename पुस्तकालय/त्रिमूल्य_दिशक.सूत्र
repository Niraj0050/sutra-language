// पुस्तकालय/त्रिमूल्य_दिशक.सूत्र — त्रिमूल्य संगणना एवं गुणा-मुक्त न्यूरल इंजन (Ternary {-1, 0, +1} AI)
// ============================================================
// आयात "पुस्तकालय/त्रिमूल्य_दिशक.सूत्र";
//
// पारंपरिक फ्लोटिंग-पॉइंट गुणा (Float Multiplications) के स्थान पर
// केवल जोड़-घटाव (Addition & Subtraction) आधारित १०x तीव्र गति AI कोर।
// भार केवल त्रिमूल्य मान रखते हैं: {-१, ०, +१} (अभाव, शून्य, भाव)।
//
// १. क्वांटाइजेशन:
//    शब्दकोश त्रि_भार = त्रिमूल्य_क्वांटाइज(फ्लोट_आव्यूह);
// २. गुणा-मुक्त आव्यूह-सदिश संक्रिया (Zero-Mult GEMV):
//    शब्दकोश आउटपुट = त्रिमूल्य_सदिश_संक्रिया(त्रि_भार, इनपुट_सदिश);
// ३. त्रिमूल्य सघन स्तर (Ternary Dense Layer):
//    शब्दकोश स्तर = त्रिमूल्य_सघन_स्तर_बनाओ(इनपुट_आकार, आउटपुट_आकार, "रेलू");
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/दिशक.सूत्र";
आयात "पुस्तकालय/कृत्रिम_प्रज्ञा.सूत्र";

// ============================================================
// १. त्रिमूल्य आव्यूह आधार (Ternary Matrix Core)
// ============================================================

कार्य त्रिमूल्य_आव्यूह_बनाओ(संख्या पंक्तियाँ, संख्या स्तंभ, संख्या प्रारंभिक_मान) {
    संख्या कुल = पंक्तियाँ * स्तंभ;
    सूची डेटा = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        डेटा = जोड़ें(डेटा, प्रारंभिक_मान);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["पंक्तियाँ"] = पंक्तियाँ;
    फल["स्तंभ"] = स्तंभ;
    फल["कुल_तत्व"] = कुल;
    फल["स्केल"] = १.०;
    फल["डेटा"] = डेटा;
    परत् फल;
}

कार्य त्रिमूल्य_आव्यूह_सेट(शब्दकोश आव्यूह, संख्या पं, संख्या स्तं, संख्या मूल्य) {
    संख्या स्तं_गिनती = आव्यूह["स्तंभ"];
    संख्या सूचकांक = पं * स्तं_गिनती + स्तं;
    आव्यूह["डेटा"][सूचकांक] = मूल्य;
}

कार्य त्रिमूल्य_आव्यूह_पाओ(शब्दकोश आव्यूह, संख्या पं, संख्या स्तं) {
    संख्या स्तं_गिनती = आव्यूह["स्तंभ"];
    संख्या सूचकांक = पं * स्तं_गिनती + स्तं;
    संख्या मूल्य = आव्यूह["डेटा"][सूचकांक];
    परत् मूल्य;
}

// फ्लोट भार आव्यूह को त्रिमूल्य {-1, 0, +1} में क्वांटाइज करना
कार्य त्रिमूल्य_क्वांटाइज(शब्दकोश फ्लोट_दिशक) {
    संख्या कुल = फ्लोट_दिशक["कुल_तत्व"];
    सूची मूल_डेटा = फ्लोट_दिशक["डेटा"];
    
    // १. औसत निरपेक्ष मान (Scale factor alpha)
    दशमलव योग_निरपेक्ष = ०.०;
    संख्या इ = ०;
    यावत् (इ < कुल) {
        दशमलव मूल्य = मूल_डेटा[इ];
        यदि (मूल्य < ०.०) { मूल्य = ०.० - मूल्य; }
        योग_निरपेक्ष = योग_निरपेक्ष + मूल्य;
        इ = इ + १;
    }
    दशमलव स्केल = योग_निरपेक्ष / (कुल * १.०);
    यदि (स्केल == ०.०) { स्केल = १.०; }
    
    // २. देहली (Threshold = 0.5 * scale)
    दशमलव देहली = ०.५ * स्केल;
    
    सूची त्रिमूल्य_डेटा = [];
    इ = ०;
    यावत् (इ < कुल) {
        दशमलव मूल्य = मूल_डेटा[इ];
        संख्या त्रि = ०;
        यदि (मूल्य > देहली) {
            त्रि = १;
        } अन्यथा यदि (मूल्य < ०.० - देहली) {
            त्रि = -१;
        }
        त्रिमूल्य_डेटा = जोड़ें(त्रिमूल्य_डेटा, त्रि);
        इ = इ + १;
    }
    
    शब्दकोश फल = {};
    फल["पंक्तियाँ"] = फ्लोट_दिशक["आकार"][०];
    फल["स्तंभ"] = फ्लोट_दिशक["आकार"][१];
    फल["कुल_तत्व"] = कुल;
    फल["स्केल"] = स्केल;
    फल["डेटा"] = त्रिमूल्य_डेटा;
    परत् फल;
}

// बिना गुणा वाला आव्यूह-सदिश गुणन (Zero-Multiplication GEMV)
// Output_i = scale * (sum_{w=+1} x_j - sum_{w=-1} x_j)
कार्य त्रिमूल्य_सदिश_संक्रिया(शब्दकोश त्रिमूल्य_आव्यूह, शब्दकोश इनपुट_सदिश) {
    संख्या पंक्तियाँ = त्रिमूल्य_आव्यूह["पंक्तियाँ"];
    संख्या स्तंभ = त्रिमूल्य_आव्यूह["स्तंभ"];
    
    यदि (स्तंभ != इनपुट_सदिश["आकार"]) {
        फेको "त्रुटिः आव्यूह स्तंभ एवं सदिश आकार असमान";
    }
    
    सूची भार_डेटा = त्रिमूल्य_आव्यूह["डेटा"];
    सूची इन_डेटा = इनपुट_सदिश["डेटा"];
    दशमलव स्केल = त्रिमूल्य_आव्यूह["स्केल"];
    
    सूची आउटपुट_डेटा = [];
    संख्या पं = ०;
    यावत् (पं < पंक्तियाँ) {
        दशमलव योग = ०.०;
        संख्या आधार = पं * स्तंभ;
        संख्या स्तं = ०;
        यावत् (स्तं < स्तंभ) {
            संख्या भार = भार_डेटा[आधार + स्तं];
            // केवल जोड़ और घटाव — कोई फ्लोट गुणा नहीं!
            यदि (भार == १) {
                योग = योग + इन_डेटा[स्तं];
            } अन्यथा यदि (भार == -१) {
                योग = योग - इन_डेटा[स्तं];
            }
            स्तं = स्तं + १;
        }
        // प्रति पंक्ति केवल एक अंतिम स्केलिंग
        दशमलव अंतिम_मूल्य = योग * स्केल;
        आउटपुट_डेटा = जोड़ें(आउटपुट_डेटा, अंतिम_मूल्य);
        पं = पं + १;
    }
    
    परत् सदिश_से_सूची(आउटपुट_डेटा);
}

// शून्यता प्रतिशत (Sparsity Percentage: ऑपरेशन्स जो पूरी तरह स्किप होते हैं)
कार्य त्रिमूल्य_शून्यता_प्रतिशत(शब्दकोश त्रिमूल्य_आव्यूह) {
    संख्या कुल = त्रिमूल्य_आव्यूह["कुल_तत्व"];
    यदि (कुल == ०) { परत् ०.०; }
    सूची डेटा = त्रिमूल्य_आव्यूह["डेटा"];
    संख्या शून्य_गिनती = ०;
    संख्या इ = ०;
    यावत् (इ < कुल) {
        यदि (डेटा[इ] == ०) { शून्य_गिनती = शून्य_गिनती + १; }
        इ = इ + १;
    }
    दशमलव प्रतिशत = (शून्य_गिनती * १००.०) / (कुल * १.०);
    परत् प्रतिशत;
}

// ============================================================
// २. त्रिमूल्य सघन स्तर (Ternary Dense Layer)
// ============================================================

कार्य त्रिमूल्य_सघन_स्तर_बनाओ(संख्या इनपुट_आकार, संख्या आउटपुट_आकार, पाठ सक्रियण_नाम) {
    // प्रारंभिक सघन स्तर बनाकर उसे त्रिमूल्य में क्वांटाइज करना
    शब्दकोश फ्लोट_स्तर = सघन_स्तर_बनाओ(इनपुट_आकार, आउटपुट_आकार, सक्रियण_नाम);
    
    // भार पंक्तियों को २D दिशक में परिवर्तित करना
    शब्दकोश फ्लोट_दिशक = दिशक_शून्य([आउटपुट_आकार, इनपुट_आकार]);
    संख्या आउट = ०;
    यावत् (आउट < आउटपुट_आकार) {
        संख्या इन = ०;
        यावत् (इन < इनपुट_आकार) {
            दशमलव भार_मूल्य = फ्लोट_स्तर["भार"][आउट][इन];
            दिशक_सेट(फ्लोट_दिशक, [आउट, इन], भार_मूल्य);
            इन = इन + १;
        }
        आउट = आउट + १;
    }
    
    शब्दकोश त्रिमूल्य_भार = त्रिमूल्य_क्वांटाइज(फ्लोट_दिशक);
    
    शब्दकोश स्तर = {};
    स्तर["इनपुट_आकार"] = इनपुट_आकार;
    स्तर["आउटपुट_आकार"] = आउटपुट_आकार;
    स्तर["सक्रियण"] = सक्रियण_नाम;
    स्तर["त्रिमूल्य_भार"] = त्रिमूल्य_भार;
    स्तर["बायस"] = फ्लोट_स्तर["बायस"];
    परत् स्तर;
}

कार्य त्रिमूल्य_स्तर_अग्रेषण(शब्दकोश स्तर, शब्दकोश इनपुट_सदिश) {
    // बिना गुणा वाला आव्यूह-सदिश योग/घटाव
    शब्दकोश रैखिक_आउट = त्रिमूल्य_सदिश_संक्रिया(स्तर["त्रिमूल्य_भार"], इनपुट_सदिश);
    
    // बायस योग
    शब्दकोश योग_बायस = सदिश_जोड़(रैखिक_आउट, स्तर["बायस"]);
    
    // सक्रियण
    पाठ सक्रियण_नाम = स्तर["सक्रियण"];
    यदि (सक्रियण_नाम == "रेलू") {
        परत् सदिश_सक्रियण_रेलू(योग_बायस);
    } अन्यथा यदि (सक्रियण_नाम == "सिग्मॉइड") {
        परत् सदिश_सक्रियण_सिग्मॉइड(योग_बायस);
    }
    परत् योग_बायस;
}
