// पुस्तकालय/आलेख.सूत्र — आलेख (ग्राफ़) संरचना और एल्गोरिथम
// ============================================================
// आयात "पुस्तकालय/आलेख.सूत्र";
//
//   शब्दकोश ग = {};                              // खाली आलेख — बस एक शब्दकोश
//   आलेख_किनारा_जोड़ो(ग, "अ", "ब", १);
//   आलेख_किनारा_जोड़ो(ग, "ब", "स", २);
//   आलेख_बीएफएस(ग, "अ")                          // ["अ", "ब", "स"]
//   आलेख_डिज्क्स्ट्रा(ग, "अ")                     // {"अ":०, "ब":१, "स":३}
//   आलेख_लघुत्तम_पथ(ग, "अ", "स")                  // ["अ", "ब", "स"]
//
// निरूपण: आलेख = शब्दकोश (शीर्ष-नाम → उस शीर्ष से निकलने वाले किनारों की
// सूची, हर किनारा {"लक्ष्य": पाठ, "भार": संख्या})। दिशा-सहित (directed) —
// अदिश (undirected) आलेख के लिए हर किनारा दोनों दिशा में जोड़ो
// (आलेख_अदिश_किनारा_जोड़ो यही करता)। अभारित (unweighted) आलेख के लिए भार
// के स्थान पर कोई भी स्थिर मान (जैसे १) दो — बीएफएस/डीएफएस/पथ_है उसे
// अनदेखा करते, सिर्फ़ डिज्क्स्ट्रा/लघुत्तम_पथ भार पर निर्भर हैं।
//
// ⚠️ भार ऋणात्मक नहीं होने चाहिए — डिज्क्स्ट्रा का एल्गोरिथम ऋणात्मक
// किनारों पर ग़लत परिणाम दे सकता (यह किसी भी डिज्क्स्ट्रा-कार्यान्वयन की
// मौलिक सीमा है, इस पुस्तकालय की नहीं — ऋणात्मक-भार के लिए बेलमन-फ़ोर्ड
// चाहिए, जो यहाँ नहीं है)।
//
// शीर्ष-गणना (जैसे लघुत्तम_पथ के भीतर) वर्णानुक्रम में क्रमबद्ध रहती —
// `कुंजियाँ()` का क्रम interp/native में अलग होता (भाषा-सीमा, README
// देखो) — नियतात्मक परिणाम के लिए, जेसन्/यूआरएल् मॉड्यूल जैसा ही।
// ============================================================

आयात "पुस्तकालय/सूची.सूत्र";

// ===== निर्माण / शीर्ष-प्रबंधन =====

// शीर्ष जोड़ो (पहले से हो तो कुछ नहीं होता — निष्क्रिय/idempotent)
कार्य आलेख_शीर्ष_जोड़ो(शब्दकोश ग्राफ, पाठ नाम) {
    यदि (ग्राफ[नाम] == शून्यम्) {
        ग्राफ[नाम] = [];
    }
    परत् ०;
}

// दिशा-सहित किनारा स्रोत→लक्ष्य जोड़ो (दोनों शीर्ष न हों तो बनते हैं)
कार्य आलेख_किनारा_जोड़ो(शब्दकोश ग्राफ, पाठ स्रोत, पाठ लक्ष्य, संख्या भार) {
    आलेख_शीर्ष_जोड़ो(ग्राफ, स्रोत);
    आलेख_शीर्ष_जोड़ो(ग्राफ, लक्ष्य);
    शब्दकोश किनारा = {};
    किनारा["लक्ष्य"] = लक्ष्य;
    किनारा["भार"] = भार;
    ग्राफ[स्रोत] = जोड़ें(ग्राफ[स्रोत], किनारा);
    परत् ०;
}

// अदिश किनारा अ↔ब जोड़ो (दोनों दिशा में आलेख_किनारा_जोड़ो)
कार्य आलेख_अदिश_किनारा_जोड़ो(शब्दकोश ग्राफ, पाठ अ, पाठ ब, संख्या भार) {
    आलेख_किनारा_जोड़ो(ग्राफ, अ, ब, भार);
    आलेख_किनारा_जोड़ो(ग्राफ, ब, अ, भार);
    परत् ०;
}

// शीर्ष अ के सारे किनारे (सूची of {"लक्ष्य","भार"}) — अ आलेख में न हो तो []
कार्य आलेख_पड़ोसी(शब्दकोश ग्राफ, पाठ अ) {
    यदि (ग्राफ[अ] == शून्यम्) { परत् []; }
    परत् ग्राफ[अ];
}

// सारे शीर्ष-नाम, वर्णानुक्रम में (नियतात्मक)
कार्य आलेख_शीर्ष_सूची(शब्दकोश ग्राफ) {
    परत् क्रमबद्ध(कुंजियाँ(ग्राफ));
}

// ===== BFS / DFS =====

// चौड़ाई-प्रथम अन्वेषण — दौरा-क्रम में शीर्ष-नामों की सूची
कार्य आलेख_बीएफएस(शब्दकोश ग्राफ, पाठ आरंभ) {
    सूची क्रम = [];
    शब्दकोश देखा = {};
    सूची कतार = [आरंभ];
    देखा[आरंभ] = सत्य;
    संख्या शीर्ष_सूचक = ०;
    यावत् (शीर्ष_सूचक < लंबाई(कतार)) {
        पाठ वर्तमान = कतार[शीर्ष_सूचक];
        शीर्ष_सूचक = शीर्ष_सूचक + १;
        क्रम = जोड़ें(क्रम, वर्तमान);
        सूची पड़ोसी = आलेख_पड़ोसी(ग्राफ, वर्तमान);
        संख्या इ = ०;
        यावत् (इ < लंबाई(पड़ोसी)) {
            पाठ ल = पड़ोसी[इ]["लक्ष्य"];
            यदि (देखा[ल] != सत्य) {
                देखा[ल] = सत्य;
                कतार = जोड़ें(कतार, ल);
            }
            इ = इ + १;
        }
    }
    परत् क्रम;
}

कार्य आ_डीएफएस_सहायक(शब्दकोश ग्राफ, पाठ वर्तमान, शब्दकोश देखा, सूची क्रम) {
    देखा[वर्तमान] = सत्य;
    क्रम = जोड़ें(क्रम, वर्तमान);
    सूची पड़ोसी = आलेख_पड़ोसी(ग्राफ, वर्तमान);
    संख्या इ = ०;
    यावत् (इ < लंबाई(पड़ोसी)) {
        पाठ ल = पड़ोसी[इ]["लक्ष्य"];
        यदि (देखा[ल] != सत्य) {
            क्रम = आ_डीएफएस_सहायक(ग्राफ, ल, देखा, क्रम);
        }
        इ = इ + १;
    }
    परत् क्रम;
}

// गहराई-प्रथम अन्वेषण — दौरा-क्रम में शीर्ष-नामों की सूची
कार्य आलेख_डीएफएस(शब्दकोश ग्राफ, पाठ आरंभ) {
    शब्दकोश देखा = {};
    सूची क्रम = [];
    क्रम = आ_डीएफएस_सहायक(ग्राफ, आरंभ, देखा, क्रम);
    परत् क्रम;
}

// क्या ब, अ से पहुँच-योग्य है (BFS-आधारित)
कार्य आलेख_पथ_है(शब्दकोश ग्राफ, पाठ अ, पाठ ब) {
    सूची पहुँच = आलेख_बीएफएस(ग्राफ, अ);
    संख्या इ = ०;
    यावत् (इ < लंबाई(पहुँच)) {
        यदि (पहुँच[इ] == ब) { परत् सत्य; }
        इ = इ + १;
    }
    परत् असत्य;
}

// ===== डिज्क्स्ट्रा (न्यूनतम-भार पथ, ऋणात्मक-भार-रहित) =====
// सरल O(शीर्ष²) रैखिक-खोज — ढेर_प्राथमिकता का न्यून-ढेर सिर्फ़ तुलनीय
// *मान* जमा करता (जोड़ी नहीं), तो (दूरी,शीर्ष) जोड़ी के लिए उपयुक्त नहीं;
// इस सरल रूप में सामान्य आकार के आलेख के लिए पर्याप्त तेज़।

// आंतरिक: दूरी + पूर्ववर्ती दोनों एक साथ लौटाता (लघुत्तम_पथ को दोनों चाहिए)
कार्य आ_डिज्क्स्ट्रा_कोर(शब्दकोश ग्राफ, पाठ आरंभ) {
    सूची शीर्ष_सूची = आलेख_शीर्ष_सूची(ग्राफ);
    शब्दकोश दूरी = {};
    शब्दकोश पूर्ववर्ती = {};
    शब्दकोश देखा = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(शीर्ष_सूची)) {
        दूरी[शीर्ष_सूची[इ]] = -१;
        इ = इ + १;
    }
    यदि (दूरी[आरंभ] == शून्यम्) {
        प्रक्षेपः "त्रुटिः — आलेख: आरंभ-शीर्ष आलेख में नहीं है";
    }
    दूरी[आरंभ] = ०;

    संख्या शेष = लंबाई(शीर्ष_सूची);
    यावत् (शेष > ०) {
        पाठ वर्तमान = "";
        संख्या वर्तमान_दूरी = -१;
        बूल मिला = असत्य;
        संख्या ज = ०;
        यावत् (ज < लंबाई(शीर्ष_सूची)) {
            पाठ नाम = शीर्ष_सूची[ज];
            यदि (देखा[नाम] != सत्य && दूरी[नाम] != -१) {
                यदि (न मिला || दूरी[नाम] < वर्तमान_दूरी) {
                    वर्तमान = नाम;
                    वर्तमान_दूरी = दूरी[नाम];
                    मिला = सत्य;
                }
            }
            ज = ज + १;
        }
        यदि (न मिला) { विरामः; }
        देखा[वर्तमान] = सत्य;
        शेष = शेष - १;

        सूची पड़ोसी = आलेख_पड़ोसी(ग्राफ, वर्तमान);
        ज = ०;
        यावत् (ज < लंबाई(पड़ोसी)) {
            शब्दकोश किनारा = पड़ोसी[ज];
            पाठ ल = किनारा["लक्ष्य"];
            संख्या नई_दूरी = वर्तमान_दूरी + किनारा["भार"];
            यदि (दूरी[ल] == -१ || नई_दूरी < दूरी[ल]) {
                दूरी[ल] = नई_दूरी;
                पूर्ववर्ती[ल] = वर्तमान;
            }
            ज = ज + १;
        }
    }
    शब्दकोश फल = {};
    फल["दूरी"] = दूरी;
    फल["पूर्ववर्ती"] = पूर्ववर्ती;
    परत् फल;
}

// आरंभ से हर पहुँच-योग्य शीर्ष की न्यूनतम-भार दूरी ({शीर्ष: दूरी}) —
// अपहुँच्य शीर्ष की दूरी -१ (कोई ऋणात्मक-भार-मार्ग नहीं होता, तो -१
// स्वाभाविक "अनंत" सेंटिनल है)
कार्य आलेख_डिज्क्स्ट्रा(शब्दकोश ग्राफ, पाठ आरंभ) {
    परत् आ_डिज्क्स्ट्रा_कोर(ग्राफ, आरंभ)["दूरी"];
}

// आरंभ से अंत तक का वास्तविक न्यूनतम-भार पथ (शीर्ष-नामों की सूची, आरंभ
// और अंत सहित) — अपहुँच्य हो तो []
कार्य आलेख_लघुत्तम_पथ(शब्दकोश ग्राफ, पाठ आरंभ, पाठ अंत) {
    शब्दकोश परि = आ_डिज्क्स्ट्रा_कोर(ग्राफ, आरंभ);
    शब्दकोश दूरी = परि["दूरी"];
    यदि (दूरी[अंत] == शून्यम् || दूरी[अंत] == -१) { परत् []; }
    शब्दकोश पूर्ववर्ती = परि["पूर्ववर्ती"];
    सूची उल्टा_पथ = [];
    पाठ वर्तमान = अंत;
    यावत् (वर्तमान != आरंभ) {
        उल्टा_पथ = जोड़ें(उल्टा_पथ, वर्तमान);
        वर्तमान = पूर्ववर्ती[वर्तमान];
    }
    उल्टा_पथ = जोड़ें(उल्टा_पथ, आरंभ);
    सूची पथ = [];
    संख्या इ = लंबाई(उल्टा_पथ) - १;
    यावत् (इ >= ०) {
        पथ = जोड़ें(पथ, उल्टा_पथ[इ]);
        इ = इ - १;
    }
    परत् पथ;
}

// ===== सांस्थिति-क्रम (Kahn's algorithm) / चक्र-जाँच =====

// शीर्षों को इस क्रम में रखो कि हर किनारा स्रोत→लक्ष्य में स्रोत पहले आए
// (सिर्फ़ DAG — चक्र-रहित दिशा-सहित आलेख के लिए मान्य); चक्र हो तो त्रुटि
कार्य आलेख_सांस्थिति_क्रम(शब्दकोश ग्राफ) {
    सूची शीर्ष_सूची = आलेख_शीर्ष_सूची(ग्राफ);
    शब्दकोश अंश_घात = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(शीर्ष_सूची)) {
        अंश_घात[शीर्ष_सूची[इ]] = ०;
        इ = इ + १;
    }
    इ = ०;
    यावत् (इ < लंबाई(शीर्ष_सूची)) {
        सूची पड़ोसी = आलेख_पड़ोसी(ग्राफ, शीर्ष_सूची[इ]);
        संख्या ज = ०;
        यावत् (ज < लंबाई(पड़ोसी)) {
            पाठ ल = पड़ोसी[ज]["लक्ष्य"];
            अंश_घात[ल] = अंश_घात[ल] + १;
            ज = ज + १;
        }
        इ = इ + १;
    }

    सूची कतार = [];
    इ = ०;
    यावत् (इ < लंबाई(शीर्ष_सूची)) {
        यदि (अंश_घात[शीर्ष_सूची[इ]] == ०) {
            कतार = जोड़ें(कतार, शीर्ष_सूची[इ]);
        }
        इ = इ + १;
    }

    सूची फल = [];
    संख्या शीर्ष_सूचक = ०;
    यावत् (शीर्ष_सूचक < लंबाई(कतार)) {
        पाठ वर्तमान = कतार[शीर्ष_सूचक];
        शीर्ष_सूचक = शीर्ष_सूचक + १;
        फल = जोड़ें(फल, वर्तमान);
        सूची पड़ोसी = आलेख_पड़ोसी(ग्राफ, वर्तमान);
        संख्या ज = ०;
        यावत् (ज < लंबाई(पड़ोसी)) {
            पाठ ल = पड़ोसी[ज]["लक्ष्य"];
            अंश_घात[ल] = अंश_घात[ल] - १;
            यदि (अंश_घात[ल] == ०) {
                कतार = जोड़ें(कतार, ल);
            }
            ज = ज + १;
        }
    }

    यदि (लंबाई(फल) != लंबाई(शीर्ष_सूची)) {
        प्रक्षेपः "त्रुटिः — आलेख: चक्र मौजूद है, सांस्थिति क्रम असंभव";
    }
    परत् फल;
}

// क्या आलेख में कोई चक्र है (सांस्थिति_क्रम को दुबारा-इस्तेमाल करता)
कार्य आलेख_चक्र_है(शब्दकोश ग्राफ) {
    प्रयत्न {
        आलेख_सांस्थिति_क्रम(ग्राफ);
        परत् असत्य;
    } पकड़ो (त्रु) {
        परत् सत्य;
    }
}
