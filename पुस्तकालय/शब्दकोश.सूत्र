// पुस्तकालय/शब्दकोश.सूत्र — शब्दकोश (dict/map) उपयोगिता-कार्य
// ============================================================
// आयात "पुस्तकालय/शब्दकोश.सूत्र";
//
// अंतर्निहित: कुंजियाँ(द), कुंजी_है(द, कुं), हटाएं(द, कुं)।
// यहाँ: मान_सूची, युग्म_सूची, विलय, उलट, से_युग्म, चुनो, छोड़ो_कुंजियाँ, आदि।
// कुंजियाँ हमेशा पाठ। सारे कार्य नई संरचना लौटाते हैं।
// ============================================================

// सारे मान (कुंजियों के क्रम में)
कार्य मान_सूची(शब्दकोश द) {
    सूची कुं = कुंजियाँ(द);
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        फल = जोड़ें(फल, द[कुं[इ]]);
        इ = इ + १;
    }
    परत् फल;
}

// [[कुंजी, मान], ...]
कार्य युग्म_सूची(शब्दकोश द) {
    सूची कुं = कुंजियाँ(द);
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        फल = जोड़ें(फल, [कुं[इ], द[कुं[इ]]]);
        इ = इ + १;
    }
    परत् फल;
}

// दो शब्दकोश मिलाओ — ब की कुंजियाँ अ पर हावी
कार्य विलय(शब्दकोश अ, शब्दकोश ब) {
    शब्दकोश फल = {};
    सूची का = कुंजियाँ(अ);
    संख्या इ = ०;
    यावत् (इ < लंबाई(का)) {
        फल[का[इ]] = अ[का[इ]];
        इ = इ + १;
    }
    सूची कब = कुंजियाँ(ब);
    इ = ०;
    यावत् (इ < लंबाई(कब)) {
        फल[कब[इ]] = ब[कब[इ]];
        इ = इ + १;
    }
    परत् फल;
}

// कुंजी ↔ मान पलटो (मान पाठ में बदला जाता है)
कार्य उलट(शब्दकोश द) {
    शब्दकोश फल = {};
    सूची कुं = कुंजियाँ(द);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        फल["" + द[कुं[इ]]] = कुं[इ];
        इ = इ + १;
    }
    परत् फल;
}

// [[कुंजी, मान], ...] से शब्दकोश
कार्य से_युग्म(सूची युग्म) {
    शब्दकोश फल = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(युग्म)) {
        सूची ज = युग्म[इ];
        फल[ज[०]] = ज[१];
        इ = इ + १;
    }
    परत् फल;
}

// केवल दी गई कुंजियाँ रखो
कार्य चुनो(शब्दकोश द, सूची चयन) {
    शब्दकोश फल = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(चयन)) {
        यदि (कुंजी_है(द, चयन[इ])) {
            फल[चयन[इ]] = द[चयन[इ]];
        }
        इ = इ + १;
    }
    परत् फल;
}

// दी गई कुंजियाँ हटाकर बाकी रखो
कार्य छोड़ो_कुंजियाँ(शब्दकोश द, सूची हटाओ_सूची) {
    शब्दकोश फल = {};
    सूची कुं = कुंजियाँ(द);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        संख्या मिला = ०;
        संख्या ज = ०;
        यावत् (ज < लंबाई(हटाओ_सूची)) {
            यदि (हटाओ_सूची[ज] == कुं[इ]) { मिला = १; }
            ज = ज + १;
        }
        यदि (मिला == ०) {
            फल[कुं[इ]] = द[कुं[इ]];
        }
        इ = इ + १;
    }
    परत् फल;
}

// कुंजियों की संख्या
कार्य कुंजी_गणना(शब्दकोश द) {
    परत् लंबाई(कुंजियाँ(द));
}

// क्या शब्दकोश खाली है?
कार्य शब्दकोश_खाली_है(शब्दकोश द) {
    परत् लंबाई(कुंजियाँ(द)) == ०;
}

// मान म से जुड़ी पहली कुंजी, वरना शून्यम्
कार्य कुंजी_का(शब्दकोश द, मान म) {
    सूची कुं = कुंजियाँ(द);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        यदि (द[कुं[इ]] == म) { परत् कुं[इ]; }
        इ = इ + १;
    }
    परत् शून्यम्;
}

// कुंजी हटाकर नया शब्दकोश (अंतर्निहित हटाएं शब्दकोश पर native में नहीं चलता)
कार्य कुंजी_हटाओ(शब्दकोश द, पाठ कुंजी) {
    शब्दकोश फल = {};
    सूची कुं = कुंजियाँ(द);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        यदि (न (कुं[इ] == कुंजी)) {
            फल[कुं[इ]] = द[कुं[इ]];
        }
        इ = इ + १;
    }
    परत् फल;
}

// शब्दकोश की उथली प्रतिलिपि
कार्य प्रतिलिपि(शब्दकोश द) {
    शब्दकोश फल = {};
    सूची कुं = कुंजियाँ(द);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        फल[कुं[इ]] = द[कुं[इ]];
        इ = इ + १;
    }
    परत् फल;
}
