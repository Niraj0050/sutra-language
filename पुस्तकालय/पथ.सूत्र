// पुस्तकालय/पथ.सूत्र — फ़ाइल-पथ हेरफेर (शुद्ध पाठ, कोई फ़ाइल-तंत्र छूता नहीं)
// ============================================================
// आयात "पुस्तकालय/पथ.सूत्र";
//
//   पथ_जोड़ो(["घर", "काम", "फ़ाइल.txt"])  → "घर/काम/फ़ाइल.txt"
//   आधार_नाम("/अ/ब/स.txt")                → "स.txt"
//   निर्देशिका("/अ/ब/स.txt")              → "/अ/ब"
//   विस्तार("स.tar.gz")                    → "gz"
//   मूल_नाम("/अ/ब/स.txt")                 → "स"
//
// दोनों विभाजक (/ और \) इनपुट में समझे जाते; आउटपुट / देता।
// ============================================================

कार्य पथ_विभाजक_है(पाठ च) {
    यदि (च == "/") { परत् सत्य; }
    यदि (च == "\\") { परत् सत्य; }
    परत् असत्य;
}

// पथ को विभाजक पर टुकड़ों में (खाली टुकड़े हटाकर, अग्र-विभाजक याद रखकर)
कार्य पथ_खंड(पाठ प) {
    सूची फल = [];
    पाठ वर्त = "";
    संख्या इ = 0;
    यावत् (इ < लंबाई(प)) {
        पाठ च = उपखंड(प, इ, इ + 1);
        यदि (पथ_विभाजक_है(च)) {
            यदि (लंबाई(वर्त) > 0) {
                फल = जोड़ें(फल, वर्त);
                वर्त = "";
            }
        } अन्यथा {
            वर्त = वर्त + च;
        }
        इ = इ + 1;
    }
    यदि (लंबाई(वर्त) > 0) { फल = जोड़ें(फल, वर्त); }
    परत् फल;
}

// क्या पथ निरपेक्ष है (/ से शुरू या C: जैसा)
कार्य निरपेक्ष_है(पाठ प) {
    यदि (लंबाई(प) == 0) { परत् असत्य; }
    यदि (पथ_विभाजक_है(उपखंड(प, 0, 1))) { परत् सत्य; }
    यदि (लंबाई(प) >= 2) {
        यदि (उपखंड(प, 1, 2) == ":") { परत् सत्य; }   // ड्राइव अक्षर
    }
    परत् असत्य;
}

// टुकड़ों को जोड़कर पथ
कार्य पथ_जोड़ो(सूची टुकड़े) {
    पाठ फल = "";
    संख्या इ = 0;
    यावत् (इ < लंबाई(टुकड़े)) {
        पाठ ट = "" + टुकड़े[इ];
        यदि (लंबाई(ट) == 0) {
            इ = इ + 1;
        } अन्यथा {
            यदि (लंबाई(फल) == 0) {
                फल = ट;
            } अन्यथा यदि (पथ_विभाजक_है(उपखंड(फल, लंबाई(फल) - 1, लंबाई(फल)))) {
                फल = फल + ट;
            } अन्यथा {
                फल = फल + "/" + ट;
            }
            इ = इ + 1;
        }
    }
    परत् फल;
}

// अंतिम टुकड़ा (फ़ाइल-नाम)
कार्य आधार_नाम(पाठ प) {
    सूची ख = पथ_खंड(प);
    यदि (लंबाई(ख) == 0) { परत् ""; }
    परत् ख[लंबाई(ख) - 1];
}

// अंतिम टुकड़े को छोड़कर बाकी (निर्देशिका)
कार्य निर्देशिका(पाठ प) {
    सूची ख = पथ_खंड(प);
    यदि (लंबाई(ख) <= 1) {
        यदि (निरपेक्ष_है(प)) { परत् "/"; }
        परत् ".";
    }
    पाठ फल = "";
    यदि (निरपेक्ष_है(प)) {
        यदि (पथ_विभाजक_है(उपखंड(प, 0, 1))) { फल = ""; }
    }
    संख्या इ = 0;
    यावत् (इ < लंबाई(ख) - 1) {
        यदि (इ > 0 || फल != "") { फल = फल + "/"; }
        फल = फल + ख[इ];
        इ = इ + 1;
    }
    यदि (निरपेक्ष_है(प)) {
        यदि (पथ_विभाजक_है(उपखंड(प, 0, 1))) { फल = "/" + फल; }
    }
    परत् फल;
}

// अंतिम "." के बाद का भाग (विस्तार); कोई "." न हो या नाम "." से शुरू → ""
कार्य विस्तार(पाठ प) {
    पाठ नाम = आधार_नाम(प);
    संख्या अंतिम_बिंदु = -1;
    संख्या इ = 0;
    यावत् (इ < लंबाई(नाम)) {
        यदि (उपखंड(नाम, इ, इ + 1) == ".") { अंतिम_बिंदु = इ; }
        इ = इ + 1;
    }
    यदि (अंतिम_बिंदु <= 0) { परत् ""; }
    परत् उपखंड(नाम, अंतिम_बिंदु + 1, लंबाई(नाम));
}

// विस्तार-रहित फ़ाइल-नाम
कार्य मूल_नाम(पाठ प) {
    पाठ नाम = आधार_नाम(प);
    संख्या अंतिम_बिंदु = -1;
    संख्या इ = 0;
    यावत् (इ < लंबाई(नाम)) {
        यदि (उपखंड(नाम, इ, इ + 1) == ".") { अंतिम_बिंदु = इ; }
        इ = इ + 1;
    }
    यदि (अंतिम_बिंदु <= 0) { परत् नाम; }
    परत् उपखंड(नाम, 0, अंतिम_बिंदु);
}

// "." और ".." को सुलझाकर सामान्य रूप
कार्य पथ_सामान्य(पाठ प) {
    संख्या निर = 0;
    यदि (निरपेक्ष_है(प)) {
        यदि (पथ_विभाजक_है(उपखंड(प, 0, 1))) { निर = 1; }
    }
    सूची ख = पथ_खंड(प);
    सूची ढेर = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(ख)) {
        पाठ ट = ख[इ];
        यदि (ट == ".") {
            इ = इ + 1;
        } अन्यथा यदि (ट == "..") {
            यदि (लंबाई(ढेर) > 0) {
                यदि (ढेर[लंबाई(ढेर) - 1] != "..") {
                    ढेर = निकालें(ढेर);
                } अन्यथा {
                    ढेर = जोड़ें(ढेर, "..");
                }
            } अन्यथा यदि (निर == 0) {
                ढेर = जोड़ें(ढेर, "..");
            }
            इ = इ + 1;
        } अन्यथा {
            ढेर = जोड़ें(ढेर, ट);
            इ = इ + 1;
        }
    }
    पाठ जुड़ा = पथ_जोड़ो(ढेर);
    यदि (निर == 1) { परत् "/" + जुड़ा; }
    यदि (लंबाई(जुड़ा) == 0) { परत् "."; }
    परत् जुड़ा;
}

// फ़ाइल-नाम का विस्तार बदलो: साथ_विस्तार("a/b.txt", "md") → "a/b.md"
कार्य साथ_विस्तार(पाठ प, पाठ नया_विस्तार) {
    पाठ निर = निर्देशिका(प);
    पाठ मूल = मूल_नाम(प);
    पाठ नाम = मूल;
    यदि (लंबाई(नया_विस्तार) > 0) { नाम = मूल + "." + नया_विस्तार; }
    यदि (निर == "." || निर == "") { परत् नाम; }
    परत् निर + "/" + नाम;
}
