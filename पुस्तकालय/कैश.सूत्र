// पुस्तकालय/कैश.सूत्र — LRU (Least Recently Used) कैश
// ============================================================
// आयात "पुस्तकालय/कैश.सूत्र";
//
//   शब्दकोश क = कैश_बनाओ(२);           // क्षमता = 2
//   कैश_रखो(क, "अ", "1");
//   कैश_रखो(क, "ब", "2");
//   कैश_पाओ(क, "अ");                   // "1" — अ अब सबसे हाल इस्तेमाल
//   कैश_रखो(क, "स", "3");              // क्षमता पूरी — ब हटाया जाता (सबसे पुराना)
//   कैश_है(क, "ब")                     // असत्य
//   कैश_है(क, "अ")                     // सत्य
//
// निरूपण: दोहरी-कड़ी सूची (doubly-linked list, नोड=शब्दकोश) + एक
// शब्दकोश मानचित्र (कुंजी→नोड) — दोनों दिशा O(1) पहुँच के लिए। नोड =
// {"कुंजी","मूल्य","पिछला","अगला"}। "शीर्ष" = सबसे हाल इस्तेमाल (MRU
// सिरा), "पुच्छ" = सबसे पुराना (LRU सिरा, अगली बार हटाया जाने वाला)।
//
// नोड-पहचान कभी `==` (dict-to-dict) से नहीं, हमेशा उसकी "कुंजी" पाठ
// तुलना से होती — dict equality (deep बनाम reference) अनिश्चित मानकर
// जोखिम न लिया गया, चाहे वह इस्तेमाल ही न होता।
//
// ⚠️ निष्कासन (eviction) में मानचित्र से कुंजी हटाने को शब्दकोश.सूत्र
// का `कुंजी_हटाओ` इस्तेमाल होता (अंतर्निहित हटाएं() शब्दकोश पर native
// में नहीं चलता — देखो शब्दकोश.सूत्र की टिप्पणी)। यह पूरा मानचित्र
// दोबारा बनाता, तो निष्कासन O(क्षमता) है, O(1) नहीं — पाओ/रखो की खोज
// खुद (कुंजी_है + प्रत्यक्ष अनुक्रमण) अब भी O(1) रहती। बिना इसके,
// शून्यम्-चिह्नित कुंजियाँ मानचित्र में हमेशा के लिए जमा होतीं (असीमित
// स्मृति-वृद्धि) — बंधी हुई स्मृति को निष्कासन-गति से ऊपर चुना गया,
// आलेख.सूत्र के डिज्क्स्ट्रा वाले उसी सरलता-बनाम-गति व्यापार जैसा।
// छोटी-मध्यम क्षमता के लिए यह व्यवहारिक रूप से कोई समस्या नहीं।
// ============================================================

आयात "पुस्तकालय/शब्दकोश.सूत्र";

// ===== आंतरिक =====

कार्य कै_नोड_बनाओ(पाठ कुंजी, मान मूल्य) {
    शब्दकोश नोड = {};
    नोड["कुंजी"] = कुंजी;
    नोड["मूल्य"] = मूल्य;
    नोड["पिछला"] = शून्यम्;
    नोड["अगला"] = शून्यम्;
    परत् नोड;
}

// नोड को कड़ी-सूची से अलग करो (पड़ोसी + शीर्ष/पुच्छ ठीक करते हुए)
कार्य कै_अलग_करो(शब्दकोश कैश, शब्दकोश नोड) {
    शब्दकोश पिछला_नोड = नोड["पिछला"];
    शब्दकोश अगला_नोड = नोड["अगला"];

    यदि (पिछला_नोड != शून्यम्) {
        पिछला_नोड["अगला"] = अगला_नोड;
    } अन्यथा {
        कैश["शीर्ष"] = अगला_नोड;
    }

    यदि (अगला_नोड != शून्यम्) {
        अगला_नोड["पिछला"] = पिछला_नोड;
    } अन्यथा {
        कैश["पुच्छ"] = पिछला_नोड;
    }

    नोड["पिछला"] = शून्यम्;
    नोड["अगला"] = शून्यम्;
    परत् ०;
}

// नोड को शीर्ष (सबसे हाल इस्तेमाल सिरा) पर जोड़ो
कार्य कै_आगे_जोड़ो(शब्दकोश कैश, शब्दकोश नोड) {
    शब्दकोश पुराना_शीर्ष = कैश["शीर्ष"];
    नोड["पिछला"] = शून्यम्;
    नोड["अगला"] = पुराना_शीर्ष;
    यदि (पुराना_शीर्ष != शून्यम्) {
        पुराना_शीर्ष["पिछला"] = नोड;
    }
    कैश["शीर्ष"] = नोड;
    यदि (कैश["पुच्छ"] == शून्यम्) {
        कैश["पुच्छ"] = नोड;
    }
    परत् ०;
}

// मौजूदा नोड को सबसे हाल-इस्तेमाल बनाओ (शीर्ष पर ले जाओ)
कार्य कै_स्पर्श(शब्दकोश कैश, शब्दकोश नोड) {
    शब्दकोश शीर्ष = कैश["शीर्ष"];
    यदि (शीर्ष != शून्यम् && शीर्ष["कुंजी"] == नोड["कुंजी"]) {
        परत् ०;
    }
    कै_अलग_करो(कैश, नोड);
    कै_आगे_जोड़ो(कैश, नोड);
    परत् ०;
}

// ===== सार्वजनिक API =====

कार्य कैश_बनाओ(संख्या क्षमता) {
    यदि (क्षमता < १) {
        प्रक्षेपः "त्रुटिः — कैश: क्षमता कम से कम 1 होनी चाहिए";
    }
    शब्दकोश कैश = {};
    कैश["क्षमता"] = क्षमता;
    कैश["मानचित्र"] = {};
    कैश["शीर्ष"] = शून्यम्;
    कैश["पुच्छ"] = शून्यम्;
    कैश["आकार"] = ०;
    परत् कैश;
}

// कुंजी का मूल्य पाओ (मिलने पर वह सबसे हाल-इस्तेमाल बन जाती); न मिले तो शून्यम्
कार्य कैश_पाओ(शब्दकोश कैश, पाठ कुंजी) {
    शब्दकोश मानचित्र = कैश["मानचित्र"];
    यदि (न कुंजी_है(मानचित्र, कुंजी)) {
        परत् शून्यम्;
    }
    शब्दकोश नोड = मानचित्र[कुंजी];
    कै_स्पर्श(कैश, नोड);
    परत् नोड["मूल्य"];
}

// कुंजी/मूल्य रखो — पहले से हो तो अद्यतन (सबसे हाल-इस्तेमाल बने), नहीं
// तो नया जोड़ो; क्षमता पार होने पर सबसे पुराना (पुच्छ) हटाओ
कार्य कैश_रखो(शब्दकोश कैश, पाठ कुंजी, मान मूल्य) {
    शब्दकोश मानचित्र = कैश["मानचित्र"];

    यदि (कुंजी_है(मानचित्र, कुंजी)) {
        शब्दकोश नोड = मानचित्र[कुंजी];
        नोड["मूल्य"] = मूल्य;
        कै_स्पर्श(कैश, नोड);
        परत् ०;
    }

    शब्दकोश नया = कै_नोड_बनाओ(कुंजी, मूल्य);
    मानचित्र[कुंजी] = नया;
    कै_आगे_जोड़ो(कैश, नया);
    कैश["आकार"] = कैश["आकार"] + १;

    यदि (कैश["आकार"] > कैश["क्षमता"]) {
        शब्दकोश पुराना = कैश["पुच्छ"];
        कै_अलग_करो(कैश, पुराना);
        कैश["मानचित्र"] = कुंजी_हटाओ(मानचित्र, पुराना["कुंजी"]);
        कैश["आकार"] = कैश["आकार"] - १;
    }
    परत् ०;
}

// क्या कुंजी मौजूद है (recency पर असर डाले बिना — शुद्ध जाँच/peek)
कार्य कैश_है(शब्दकोश कैश, पाठ कुंजी) {
    परत् कुंजी_है(कैश["मानचित्र"], कुंजी);
}

// कुंजी हटाओ (मौजूद थी तो सत्य लौटाता, नहीं तो असत्य)
कार्य कैश_हटाओ(शब्दकोश कैश, पाठ कुंजी) {
    शब्दकोश मानचित्र = कैश["मानचित्र"];
    यदि (न कुंजी_है(मानचित्र, कुंजी)) {
        परत् असत्य;
    }
    शब्दकोश नोड = मानचित्र[कुंजी];
    कै_अलग_करो(कैश, नोड);
    कैश["मानचित्र"] = कुंजी_हटाओ(मानचित्र, कुंजी);
    कैश["आकार"] = कैश["आकार"] - १;
    परत् सत्य;
}

// वर्तमान प्रविष्टि-संख्या
कार्य कैश_आकार(शब्दकोश कैश) {
    परत् कैश["आकार"];
}

कार्य कैश_खाली_है(शब्दकोश कैश) {
    परत् कैश["आकार"] == ०;
}

// कैश को पूरी तरह खाली करो (क्षमता अपरिवर्तित रहती)
कार्य कैश_खाली_करो(शब्दकोश कैश) {
    कैश["मानचित्र"] = {};
    कैश["शीर्ष"] = शून्यम्;
    कैश["पुच्छ"] = शून्यम्;
    कैश["आकार"] = ०;
    परत् ०;
}

// सबसे-हाल-इस्तेमाल→सबसे-पुराना क्रम में कुंजियों की सूची (डीबग/परीक्षण
// के लिए — कड़ी-सूची पर सीधे चलता, मानचित्र/कुंजियाँ() बिल्कुल नहीं छूता)
कार्य कैश_कुंजियाँ_क्रम_में(शब्दकोश कैश) {
    सूची फल = [];
    शब्दकोश वर्तमान = कैश["शीर्ष"];
    यावत् (वर्तमान != शून्यम्) {
        फल = जोड़ें(फल, वर्तमान["कुंजी"]);
        वर्तमान = वर्तमान["अगला"];
    }
    परत् फल;
}
