कार्य व्यं_कोड_ऑफसेट(सूची कोड, संख्या ऑफ) {
    सूची नया = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "कूद") { नया = जोड़ें(नया, व्यं_अनु_कूद(अ["लक्ष्य"] + ऑफ)); }
        अन्यथा यदि (अ["प्रकार"] == "विभाजन") {
            नया = जोड़ें(नया, व्यं_अनु_विभाजन(अ["लक्ष्य1"] + ऑफ, अ["लक्ष्य2"] + ऑफ));
        } अन्यथा {
            नया = जोड़ें(नया, अ);
        }
        इ = इ + १;
    }
    परत् नया;
}

कार्य व्यं_कोड_जोड़ो(सूची अ, सूची ब) {
    सूची ब2 = व्यं_कोड_ऑफसेट(ब, लंबाई(अ));
    सूची परिणाम = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) { परिणाम = जोड़ें(परिणाम, अ[इ]); इ = इ + १; }
    इ = ०;
    यावत् (इ < लंबाई(ब2)) { परिणाम = जोड़ें(परिणाम, ब2[इ]); इ = इ + १; }
    परत् परिणाम;
}

// ---- स्थिर-चौड़ाई गणना (lookbehind के लिए — इसकी लंबाई संकलन-समय पर एक
// निश्चित संख्या होनी ज़रूरी, चर-दोहराव/backreference वाला हिस्सा नहीं) ----
// -१ = चौड़ाई अज्ञात/चर (lookbehind में समर्थित नहीं)

कार्य व्यं_चौड़ाई_आधार(शब्दकोश आधार) {
    पाठ प्र = आधार["प्रकार"];
    यदि (प्र == "अक्षर" || प्र == "कोई_भी" || प्र == "वर्ग") { परत् १; }
    यदि (प्र == "आरंभ" || प्र == "अंत") { परत् ०; }
    यदि (प्र == "आगे_दृष्टि" || प्र == "पीछे_दृष्टि") { परत् ०; }   // दोनों शून्य-चौड़ाई दावे
    यदि (प्र == "पीछे_संदर्भ") { परत् ० - १; }   // चर-लंबाई (रनटाइम-निर्भर)
    यदि (प्र == "समूह") { परत् व्यं_चौड़ाई_विकल्प(आधार["विकल्प"]); }
    परत् ० - १;
}
कार्य व्यं_चौड़ाई_परमाणु(शब्दकोश परमाणु) {
    यदि (परमाणु["न्यून"] != परमाणु["अधिक"]) { परत् ० - १; }   // */+/? या {n,m} n≠m
    संख्या आ = व्यं_चौड़ाई_आधार(परमाणु["आधार"]);
    यदि (आ < ०) { परत् ० - १; }
    परत् आ * परमाणु["न्यून"];
}
कार्य व्यं_चौड़ाई_क्रम(सूची परमाणु_सूची) {
    संख्या कुल = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(परमाणु_सूची)) {
        संख्या च = व्यं_चौड़ाई_परमाणु(परमाणु_सूची[इ]);
        यदि (च < ०) { परत् ० - १; }
        कुल = कुल + च;
        इ = इ + १;
    }
    परत् कुल;
}
कार्य व्यं_चौड़ाई_विकल्प(सूची शाखाएँ) {
    यदि (लंबाई(शाखाएँ) == ०) { परत् ०; }
    संख्या पहली = व्यं_चौड़ाई_क्रम(शाखाएँ[०]);
    यदि (पहली < ०) { परत् ० - १; }
    संख्या इ = १;
    यावत् (इ < लंबाई(शाखाएँ)) {
        यदि (व्यं_चौड़ाई_क्रम(शाखाएँ[इ]) != पहली) { परत् ० - १; }
        इ = इ + १;
    }
    परत् पहली;
}

कार्य व्यं_संकलन_आधार(शब्दकोश आधार) {
    पाठ प्र = आधार["प्रकार"];
    यदि (प्र == "अक्षर") { परत् [व्यं_अनु_अक्षर(आधार["मान"])]; }
    यदि (प्र == "कोई_भी") { परत् [व्यं_अनु_कोई_भी()]; }
    यदि (प्र == "वर्ग") { परत् [आधार]; }   // वर्ग-नोड खुद ही अनुदेश जैसा (प्रकार="वर्ग")
    यदि (प्र == "आरंभ") { परत् [व्यं_अनु_आरंभ()]; }
    यदि (प्र == "अंत") { परत् [व्यं_अनु_अंत_एंकर()]; }
    यदि (प्र == "पीछे_संदर्भ") { परत् [व्यं_अनु_पीछे_संदर्भ(आधार["क्रमांक"])]; }
    यदि (प्र == "आगे_दृष्टि") {
        सूची उप_कोड = जोड़ें(व्यं_संकलन_विकल्प(आधार["विकल्प"]), व्यं_अनु_मिलान());
        परत् [व्यं_अनु_आगे_दृष्टि(उप_कोड, आधार["सकारात्मक"])];
    }
    यदि (प्र == "पीछे_दृष्टि") {
        संख्या चौड़ाई = व्यं_चौड़ाई_विकल्प(आधार["विकल्प"]);
        यदि (चौड़ाई < ०) {
            प्रक्षेपः "त्रुटिः — व्यंजक: lookbehind की लंबाई स्थिर (fixed-width) होनी चाहिए — */+/{n,m}(n≠m)/backreference भीतर समर्थित नहीं";
        }
        सूची उप_कोड = जोड़ें(व्यं_संकलन_विकल्प(आधार["विकल्प"]), व्यं_अनु_मिलान());
        परत् [व्यं_अनु_पीछे_दृष्टि(उप_कोड, चौड़ाई, आधार["सकारात्मक"])];
    }
    यदि (प्र == "समूह") {
        सूची भीतरी = व्यं_संकलन_विकल्प(आधार["विकल्प"]);
        यदि (आधार["कैप्चर"] != सत्य) { परत् भीतरी; }
        सूची शुरू = [व्यं_अनु_पकड़_आरंभ(आधार["क्रमांक"], आधार["नाम"])];
        सूची अंत_अनु = [व्यं_अनु_पकड़_अंत(आधार["क्रमांक"])];
        परत् व्यं_कोड_जोड़ो(व्यं_कोड_जोड़ो(शुरू, भीतरी), अंत_अनु);
    }
    प्रक्षेपः "त्रुटिः — व्यंजक: अज्ञात नोड प्रकार";
}

// परमाणु (आधार + न्यून/अधिक दोहराव) — यहीं */+/? की bytecode-मशीनरी
// आ_कोड को न्यून..अधिक बार दोहराने वाली bytecode बनाओ (अधिक == -१ माने अनंत)।
// तीन आधार-मामले (*, +, ?) सीधे हाथ-अनुकूलित bytecode; सामान्य {n,m} उन्हीं
// तीन में विघटित होता (न अनिवार्य प्रतियाँ + बाकी वैकल्पिक/तारा पूंछ) —
// इसलिए {०,१}=?, {०,∞}=*, {१,∞}=+ स्वतः उन्हीं सिद्ध रास्तों से गुज़रते।
कार्य व्यं_संकलन_दोहराव(सूची आ_कोड, संख्या न्यून, संख्या अधिक) {
    यदि (न्यून == १ && अधिक == १) { परत् आ_कोड; }

    संख्या गिनती = लंबाई(आ_कोड);

    यदि (न्यून == ० && अधिक == (० - १)) {
        // A*  : ०: विभाजन(१, गिनती+२)   १..गिनती: <आ_कोड@१>   गिनती+१: कूद(०)
        सूची शिफ्ट = व्यं_कोड_ऑफसेट(आ_कोड, १);
        सूची परिणाम = [व्यं_अनु_विभाजन(१, गिनती + २)];
        संख्या इ = ०;
        यावत् (इ < लंबाई(शिफ्ट)) { परिणाम = जोड़ें(परिणाम, शिफ्ट[इ]); इ = इ + १; }
        परिणाम = जोड़ें(परिणाम, व्यं_अनु_कूद(०));
        परत् परिणाम;
    }
    यदि (न्यून == १ && अधिक == (० - १)) {
        // A+  : ०..गिनती-१: <आ_कोड@०>   गिनती: विभाजन(०, गिनती+१)
        सूची परिणाम = [];
        संख्या इ = ०;
        यावत् (इ < गिनती) { परिणाम = जोड़ें(परिणाम, आ_कोड[इ]); इ = इ + १; }
        परिणाम = जोड़ें(परिणाम, व्यं_अनु_विभाजन(०, गिनती + १));
        परत् परिणाम;
    }
    यदि (न्यून == ० && अधिक == १) {
        // A?  : ०: विभाजन(१, गिनती+१)   १..गिनती: <आ_कोड@१>
        सूची शिफ्ट = व्यं_कोड_ऑफसेट(आ_कोड, १);
        सूची परिणाम = [व्यं_अनु_विभाजन(१, गिनती + १)];
        संख्या इ = ०;
        यावत् (इ < लंबाई(शिफ्ट)) { परिणाम = जोड़ें(परिणाम, शिफ्ट[इ]); इ = इ + १; }
        परत् परिणाम;
    }

    // सामान्य {n,m} / {n,} / {n} — न अनिवार्य प्रतियाँ, फिर बाकी वैकल्पिक
    यदि (न्यून < ०) { प्रक्षेपः "त्रुटिः — व्यंजक: दोहराव-न्यूनतम ऋणात्मक नहीं हो सकता"; }
    सूची कोड = [];
    संख्या इ = ०;
    यावत् (इ < न्यून) {
        कोड = व्यं_कोड_जोड़ो(कोड, आ_कोड);
        इ = इ + १;
    }
    यदि (अधिक == (० - १)) {
        कोड = व्यं_कोड_जोड़ो(कोड, व्यं_संकलन_दोहराव(आ_कोड, ०, ० - १));
        परत् कोड;
    }
    संख्या बाकी = अधिक - न्यून;
    यदि (बाकी < ०) { प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में अधिकतम न्यूनतम से कम"; }
    इ = ०;
    यावत् (इ < बाकी) {
        कोड = व्यं_कोड_जोड़ो(कोड, व्यं_संकलन_दोहराव(आ_कोड, ०, १));
        इ = इ + १;
    }
    परत् कोड;
}

कार्य व्यं_संकलन_परमाणु(शब्दकोश परमाणु) {
    सूची आ_कोड = व्यं_संकलन_आधार(परमाणु["आधार"]);
    परत् व्यं_संकलन_दोहराव(आ_कोड, परमाणु["न्यून"], परमाणु["अधिक"]);
}

कार्य व्यं_संकलन_क्रम(सूची परमाणु_सूची) {
    सूची कोड = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(परमाणु_सूची)) {
        कोड = व्यं_कोड_जोड़ो(कोड, व्यं_संकलन_परमाणु(परमाणु_सूची[इ]));
        इ = इ + १;
    }
    परत् कोड;
}

// विकल्प (शाखाओं की सूची) — १ शाखा हो तो सीधे, नहीं तो split-श्रृंखला
कार्य व्यं_संकलन_विकल्प(सूची शाखाएँ) {
    यदि (लंबाई(शाखाएँ) == १) { परत् व्यं_संकलन_क्रम(शाखाएँ[०]); }
    परत् व्यं_संकलन_विकल्प_सहायक(शाखाएँ, ०);
}
कार्य व्यं_संकलन_विकल्प_सहायक(सूची शाखाएँ, संख्या सूचक) {
    यदि (सूचक == लंबाई(शाखाएँ) - १) { परत् व्यं_संकलन_क्रम(शाखाएँ[सूचक]); }
    सूची यह = व्यं_संकलन_क्रम(शाखाएँ[सूचक]);
    सूची बाकी = व्यं_संकलन_विकल्प_सहायक(शाखाएँ, सूचक + १);
    संख्या गिनती_यह = लंबाई(यह);
    संख्या गिनती_बाकी = लंबाई(बाकी);
    सूची यह_शिफ्ट = व्यं_कोड_ऑफसेट(यह, १);
    सूची बाकी_शिफ्ट = व्यं_कोड_ऑफसेट(बाकी, गिनती_यह + २);
    सूची परिणाम = [व्यं_अनु_विभाजन(१, गिनती_यह + २)];
    संख्या इ = ०;
    यावत् (इ < लंबाई(यह_शिफ्ट)) { परिणाम = जोड़ें(परिणाम, यह_शिफ्ट[इ]); इ = इ + १; }
    परिणाम = जोड़ें(परिणाम, व्यं_अनु_कूद(गिनती_यह + गिनती_बाकी + २));
    इ = ०;
    यावत् (इ < लंबाई(बाकी_शिफ्ट)) { परिणाम = जोड़ें(परिणाम, बाकी_शिफ्ट[इ]); इ = इ + १; }
    परत् परिणाम;
}

// ---- VM: recursive backtracking (कोई closure नहीं — "आगे क्या" हमेशा
// एक संख्या-सूचकांक (पीसी) है, प्रथम-श्रेणी फलन नहीं) ----

// कैप्चर — शब्दकोश, संदर्भ-उत्परिवर्तित (v1: कुंजी "<क्रमांक>_आरंभ"/"<क्रमांक>_अंत")।
// विभाजन पर snapshot/restore ज़रूरी — पहली शाखा आंशिक रूप से मैच होकर फिर
// विफल हो सकती, तब तक जो capture सेट हुए वो दूसरी शाखा आज़माने से पहले
// वापस पुराने मान पर लौटने चाहिए (नहीं तो असफल शाखा के stale capture दूसरी,
// सफल शाखा के परिणाम में रिसते)।

कार्य व्यं_कैप्चर_कॉपी(शब्दकोश कैप्चर) {
    शब्दकोश नक़ल = {};
    सूची कुं = कुंजियाँ(कैप्चर);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        नक़ल[कुं[इ]] = कैप्चर[कुं[इ]];
        इ = इ + १;
    }
    परत् नक़ल;
}
कार्य व्यं_कैप्चर_पुनर्स्थापन(शब्दकोश कैप्चर, शब्दकोश नक़ल) {
    सूची कुं = कुंजियाँ(नक़ल);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        कैप्चर[कुं[इ]] = नक़ल[कुं[इ]];
        इ = इ + १;
    }
    परत् ०;
}

// व्यं_चलाओ — पुनरावर्ती (recursive) नहीं, ITERATIVE, एक स्पष्ट (explicit)
// choice-point ढेर के साथ। क्यों: "विभाजन" (greedy +/*) की हर एक इकाई पहले
// डिज़ाइन में एक नेस्टेड, कभी-न-लौटने वाली recursive कॉल थी — यानी मिलान की
// गई हर इनपुट-लंबाई-इकाई नेटिव कॉल-स्टैक की एक नई परत खाती। कंपाइल किए गए
// बैकएंड (x86/LLVM) पर यह परत बहुत हल्की है (कुछ रजिस्टर + रिटर्न-एड्रेस),
// पर tree-walking इंटरप्रेटर पर हर एक Sutra-स्तर कॉल कई गुना ज़्यादा नेटिव
// C++ स्टैक खा जाती — एक साधारण, बिल्कुल-सामान्य पैटर्न जैसे
// "[^@\s]+@[^@\s]+" एक ~30-अक्षर इनपुट पर इंटरप्रेटर की OS थ्रेड-स्टैक सीमा
// पार कर स्टैक-ओवरफ़्लो (0xC00000FD) क्रैश देता था, जबकि दोनों कंपाइल
// बैकएंड बिल्कुल सही परिणाम देते (देखें: भाषा_परीक्षण/stdlib का सत्यापन
// bug-hunt नोट)। समाधान: "विभाजन" अब नेटिव रिकर्शन की जगह "चयन_ढेर" नामक
// एक Sutra-स्तर सूची में choice-point (लक्ष्य2-पीसी + प_इ + कैप्चर-स्नैपशॉट)
// push करता — असफल होने पर सबसे हाल का choice-point pop होकर backtrack
// करता, ठीक वैसे ही क्रम में जैसे नेटिव कॉल-स्टैक unwind करता (LIFO)। इससे
// किसी भी पैटर्न/इनपुट-लंबाई के लिए native/interpreter स्टैक-गहराई अब
// स्थिर (O(1)) रहती — सिर्फ़ ढेर की सूची (heap पर, GC-प्रबंधित) बढ़ती।
// आगे_दृष्टि/पीछे_दृष्टि अब भी नेटिव रूप से व्यं_चलाओ को दोबारा बुलाते
// (सच्चा recursion) — पर उनकी गहराई पैटर्न में lookaround-नेस्टिंग जितनी ही
// होती (सामान्यतः 1-3), इनपुट-लंबाई पर निर्भर नहीं, इसलिए सुरक्षित।
कार्य व्यं_चलाओ(सूची कोड, संख्या पीसी, पाठ स्रोत, संख्या प_इ, संख्या पाठ_लं, शब्दकोश कैप्चर) {
    सूची चयन_ढेर = [];
    संख्या ढेर_गहराई = ०;

    यावत् (सत्य) {
        शब्दकोश अनु = कोड[पीसी];
        पाठ प्र = अनु["प्रकार"];
        बूल असफल = असत्य;
        संख्या अगला_पीसी = पीसी + १;
        संख्या अगला_प_इ = प_इ;

        यदि (प्र == "मिलान") { परत् प_इ; }
        अन्यथा यदि (प्र == "अक्षर") {
            यदि (प_इ < पाठ_लं && उपखंड(स्रोत, प_इ, प_इ + १) == अनु["मान"]) { अगला_प_इ = प_इ + १; }
            अन्यथा { असफल = सत्य; }
        }
        अन्यथा यदि (प्र == "कोई_भी") {
            यदि (प_इ < पाठ_लं) { अगला_प_इ = प_इ + १; }
            अन्यथा { असफल = सत्य; }
        }
        अन्यथा यदि (प्र == "वर्ग") {
            यदि (प_इ < पाठ_लं && व्यं_वर्ग_जांचो(अनु, उपखंड(स्रोत, प_इ, प_इ + १))) { अगला_प_इ = प_इ + १; }
            अन्यथा { असफल = सत्य; }
        }
        अन्यथा यदि (प्र == "आरंभ") {
            यदि (प_इ != ०) { असफल = सत्य; }
        }
        अन्यथा यदि (प्र == "अंत") {
            यदि (प_इ != पाठ_लं) { असफल = सत्य; }
        }
        अन्यथा यदि (प्र == "पकड़_आरंभ") {
            कैप्चर[("" + अनु["क्रमांक"]) + "_आरंभ"] = प_इ;
        }
        अन्यथा यदि (प्र == "पकड़_अंत") {
            कैप्चर[("" + अनु["क्रमांक"]) + "_अंत"] = प_इ;
        }
        अन्यथा यदि (प्र == "पीछे_संदर्भ") {
            संख्या ग_आ = कैप्चर[("" + अनु["क्रमांक"]) + "_आरंभ"];
            संख्या ग_अं = कैप्चर[("" + अनु["क्रमांक"]) + "_अंत"];
            यदि (ग_आ < ० || ग_अं < ०) { असफल = सत्य; }   // समूह अभी तक मिला नहीं
            अन्यथा {
                संख्या ग_लं = ग_अं - ग_आ;
                यदि (प_इ + ग_लं > पाठ_लं) { असफल = सत्य; }
                अन्यथा यदि (उपखंड(स्रोत, प_इ, प_इ + ग_लं) != उपखंड(स्रोत, ग_आ, ग_अं)) { असफल = सत्य; }
                अन्यथा { अगला_प_इ = प_इ + ग_लं; }
            }
        }
        अन्यथा यदि (प्र == "आगे_दृष्टि") {
            शब्दकोश नक़ल = व्यं_कैप्चर_कॉपी(कैप्चर);
            संख्या उप_परिणाम = व्यं_चलाओ(अनु["उप_कोड"], ०, स्रोत, प_इ, पाठ_लं, कैप्चर);
            बूल सफल = उप_परिणाम >= ०;
            यदि (सफल == अनु["सकारात्मक"]) {
                यदि (सफल != सत्य) { व्यं_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल); }   // नकारात्मक-सफल: कुछ उजागर नहीं
            } अन्यथा {
                व्यं_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल);
                असफल = सत्य;
            }
        }
        अन्यथा यदि (प्र == "पीछे_दृष्टि") {
            संख्या शुरू = प_इ - अनु["चौड़ाई"];
            शब्दकोश नक़ल2 = व्यं_कैप्चर_कॉपी(कैप्चर);
            बूल सफल2 = असत्य;
            यदि (शुरू >= ०) {
                संख्या उप_परिणाम2 = व्यं_चलाओ(अनु["उप_कोड"], ०, स्रोत, शुरू, पाठ_लं, कैप्चर);
                सफल2 = उप_परिणाम2 == प_इ;
            }
            यदि (सफल2 == अनु["सकारात्मक"]) {
                यदि (सफल2 != सत्य) { व्यं_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल2); }
            } अन्यथा {
                व्यं_कैप्चर_पुनर्स्थापन(कैप्चर, नक़ल2);
                असफल = सत्य;
            }
        }
        अन्यथा यदि (प्र == "कूद") {
            अगला_पीसी = अनु["लक्ष्य"];
        }
        अन्यथा यदि (प्र == "विभाजन") {
            शब्दकोश नक़ल3 = व्यं_कैप्चर_कॉपी(कैप्चर);
            शब्दकोश चयन = {};
            चयन["पीसी"] = अनु["लक्ष्य2"];
            चयन["प_इ"] = प_इ;
            चयन["कैप्चर"] = नक़ल3;
            यदि (ढेर_गहराई == लंबाई(चयन_ढेर)) {
                चयन_ढेर = जोड़ें(चयन_ढेर, चयन);
            } अन्यथा {
                चयन_ढेर[ढेर_गहराई] = चयन;
            }
            ढेर_गहराई = ढेर_गहराई + १;
            अगला_पीसी = अनु["लक्ष्य1"];
        }
        अन्यथा {
            प्रक्षेपः "त्रुटिः — व्यंजक: अज्ञात bytecode प्रकार";
        }

        यदि (असफल) {
            यदि (ढेर_गहराई == ०) { परत् ० - १; }
            ढेर_गहराई = ढेर_गहराई - १;
            शब्दकोश शीर्ष = चयन_ढेर[ढेर_गहराई];
            व्यं_कैप्चर_पुनर्स्थापन(कैप्चर, शीर्ष["कैप्चर"]);
            पीसी = शीर्ष["पीसी"];
            प_इ = शीर्ष["प_इ"];
        } अन्यथा {
            पीसी = अगला_पीसी;
            प_इ = अगला_प_इ;
        }
    }
}

// संकलित bytecode में सबसे बड़ा capture-क्रमांक (० = कोई capturing group नहीं)
// आगे_दृष्टि/पीछे_दृष्टि के उप_कोड में भी झाँकता — कोई समूह वहाँ घोषित हो
// सकता (जैसे "(?=(\d+))\d+\1" — समूह १ lookahead के भीतर, \१ बाहर)
कार्य व्यं_अधिकतम_समूह(सूची कोड) {
    संख्या अधि = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "पकड़_आरंभ") {
            यदि (अ["क्रमांक"] > अधि) { अधि = अ["क्रमांक"]; }
        } अन्यथा यदि (अ["प्रकार"] == "आगे_दृष्टि" || अ["प्रकार"] == "पीछे_दृष्टि") {
            संख्या भीतरी = व्यं_अधिकतम_समूह(अ["उप_कोड"]);
            यदि (भीतरी > अधि) { अधि = भीतरी; }
        }
        इ = इ + १;
    }
    परत् अधि;
}

// समूह-नाम → क्रमांक; व्यं_अधिकतम_समूह जैसी ही recursion (आगे_दृष्टि/पीछे_दृष्टि
// के उप_कोड में भी झाँकता, चूँकि नामित समूह वहाँ भी घोषित हो सकता है)
कार्य व्यं_नाम_मानचित्र_सहायक(सूची कोड, शब्दकोश नक्शा) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "पकड़_आरंभ" && अ["नाम"] != शून्यम्) {
            नक्शा[अ["नाम"]] = अ["क्रमांक"];
        } अन्यथा यदि (अ["प्रकार"] == "आगे_दृष्टि" || अ["प्रकार"] == "पीछे_दृष्टि") {
            व्यं_नाम_मानचित्र_सहायक(अ["उप_कोड"], नक्शा);
        }
        इ = इ + १;
    }
    परत् ०;
}
कार्य व्यं_नाम_मानचित्र(सूची कोड) {
    शब्दकोश नक्शा = {};
    व्यं_नाम_मानचित्र_सहायक(कोड, नक्शा);
    परत् नक्शा;
}

// ताज़ा कैप्चर-अवस्था — सारे स्लॉट "अभी तक नहीं मिला" (-१) पर आरंभित
कार्य व्यं_कैप्चर_बनाओ(संख्या अधिकतम) {
    शब्दकोश क = {};
    संख्या इ = १;
    यावत् (इ <= अधिकतम) {
        क[("" + इ) + "_आरंभ"] = ० - १;
        क[("" + इ) + "_अंत"] = ० - १;
        इ = इ + १;
    }
    परत् क;
}

// पूर्ण कैप्चर-अवस्था से हर समूह का मिला हुआ पाठ निकालो (न मिला → शून्यम्)
कार्य व्यं_कैप्चर_निकालो(शब्दकोश कैप्चर, संख्या अधिकतम, पाठ स्रोत) {
    सूची फल = [];
    संख्या इ = १;
    यावत् (इ <= अधिकतम) {
        संख्या आ = कैप्चर[("" + इ) + "_आरंभ"];
        संख्या अं = कैप्चर[("" + इ) + "_अंत"];
        यदि (आ >= ० && अं >= ०) {
            फल = जोड़ें(फल, उपखंड(स्रोत, आ, अं));
        } अन्यथा {
            फल = जोड़ें(फल, शून्यम्);
        }
        इ = इ + १;
    }
    परत् फल;
}

// हर \N backreference किसी वास्तव में घोषित capturing group को संदर्भित
// करे — नहीं तो compile-time त्रुटि (runtime हमेशा-असफल से बेहतर)। समूह
// पूरे पैटर्न में कहीं भी घोषित हो सकता (आगे_दृष्टि/पीछे_दृष्टि के भीतर भी),
// इसलिए अधि एक बार शीर्ष-स्तर पर गणना कर हर स्तर पर वही इस्तेमाल होता।
कार्य व्यं_सत्यापन_पीछे_संदर्भ_सहायक(सूची कोड, संख्या अधि) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(कोड)) {
        शब्दकोश अ = कोड[इ];
        यदि (अ["प्रकार"] == "पीछे_संदर्भ" && अ["क्रमांक"] > अधि) {
            प्रक्षेपः "त्रुटिः — व्यंजक: \\" + ("" + अ["क्रमांक"]) + " किसी घोषित समूह को संदर्भित नहीं करता";
        } अन्यथा यदि (अ["प्रकार"] == "आगे_दृष्टि" || अ["प्रकार"] == "पीछे_दृष्टि") {
            व्यं_सत्यापन_पीछे_संदर्भ_सहायक(अ["उप_कोड"], अधि);
        }
        इ = इ + १;
    }
    परत् ०;
}
कार्य व्यं_सत्यापन_पीछे_संदर्भ(सूची कोड) {
    परत् व्यं_सत्यापन_पीछे_संदर्भ_सहायक(कोड, व्यं_अधिकतम_समूह(कोड));
}

// ---- सार्वजनिक API ----

कार्य व्यंजक_संकलन(पाठ पैटर्न) {
    शब्दकोश अ = व्यं_अव_बनाओ(पैटर्न);
    सूची शाखाएँ = व्यं_पार्स_विकल्प(अ);
    यदि (न व्यं_अव_अंत(अ)) {
        प्रक्षेपः "त्रुटिः — व्यंजक: अनपेक्षित ')' या पैटर्न में गड़बड़ी";
    }
    सूची कोड = जोड़ें(व्यं_संकलन_विकल्प(शाखाएँ), व्यं_अनु_मिलान());
    व्यं_सत्यापन_पीछे_संदर्भ(कोड);
    परत् कोड;
}

कार्य व्यं_खोजो_संकलित(सूची कोड, पाठ स्रोत, संख्या शुरू_से) {
    संख्या लं = लंबाई(स्रोत);
    संख्या अधि = व्यं_अधिकतम_समूह(कोड);
    संख्या श = शुरू_से;
    यावत् (श <= लं) {
        शब्दकोश कैप्चर = व्यं_कैप्चर_बनाओ(अधि);
        संख्या अंत = व्यं_चलाओ(कोड, ०, स्रोत, श, लं, कैप्चर);
        यदि (अंत >= ०) {
            शब्दकोश प = {};
            प["मिला"] = सत्य;
            प["आरंभ"] = श;
            प["अंत"] = अंत;
            प["पाठ"] = उपखंड(स्रोत, श, अंत);
            प["समूह"] = व्यं_कैप्चर_निकालो(कैप्चर, अधि, स्रोत);
            प["नाम_मानचित्र"] = व्यं_नाम_मानचित्र(कोड);
            परत् प;
        }
        श = श + १;
    }
    शब्दकोश असफल = {};
    असफल["मिला"] = असत्य;
    परत् असफल;
}

// पैटर्न स्रोत-पाठ में कहीं भी मिलता है? (re.search जैसा, बूल रूप)
कार्य व्यंजक_मिलान(पाठ पैटर्न, पाठ स्रोत) {
    शब्दकोश प = व्यंजक_खोजो(पैटर्न, स्रोत);
    परत् प["मिला"];
}

// पूरा स्रोत-पाठ बिल्कुल पैटर्न से मिलता है? (re.fullmatch जैसा)
कार्य व्यंजक_पूर्ण_मिलान(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = व्यंजक_संकलन(पैटर्न);
    संख्या लं = लंबाई(स्रोत);
    शब्दकोश कैप्चर = व्यं_कैप्चर_बनाओ(व्यं_अधिकतम_समूह(कोड));
    परत् व्यं_चलाओ(कोड, ०, स्रोत, ०, लं, कैप्चर) == लं;
}

// पहला मिलान — {मिला, आरंभ, अंत, पाठ} (re.search जैसा, विवरण सहित)
कार्य व्यंजक_खोजो(पाठ पैटर्न, पाठ स्रोत) {
    परत् व्यं_खोजो_संकलित(व्यंजक_संकलन(पैटर्न), स्रोत, ०);
}

// सभी (non-overlapping, बाएँ-से-दाएँ) मिलान — सूची of matched पाठ (re.findall जैसा)
कार्य व्यंजक_सभी_खोजो(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = व्यंजक_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या श = ०;
    यावत् (श <= लं) {
        शब्दकोश मि = व्यं_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        परिणाम = जोड़ें(परिणाम, मि["पाठ"]);
        यदि (मि["अंत"] > मि["आरंभ"]) { श = मि["अंत"]; } अन्यथा { श = मि["अंत"] + १; }
    }
    परत् परिणाम;
}

// प्रतिस्थापन-पाठ में $१-$९ (समूह), $० (पूरा मिलान), $$ (literal $) लागू करो
कार्य व्यं_प्रतिस्थापन_लागू(पाठ प्रतिस्थापन, सूची समूह, पाठ पूरा_मिलान) {
    पाठ फल = "";
    संख्या इ = ०;
    संख्या लं = लंबाई(प्रतिस्थापन);
    यावत् (इ < लं) {
        पाठ च = उपखंड(प्रतिस्थापन, इ, इ + १);
        यदि (च == "$" && इ + १ < लं) {
            पाठ अगला = उपखंड(प्रतिस्थापन, इ + १, इ + २);
            यदि (अगला == "$") {
                फल = फल + "$";
                इ = इ + २;
            } अन्यथा यदि (अगला == "0") {
                फल = फल + पूरा_मिलान;
                इ = इ + २;
            } अन्यथा {
                संख्या कोड = अक्षर_मान(अगला);
                यदि (कोड >= ४९ && कोड <= ५७) {
                    संख्या क्रमांक = कोड - ४८;
                    यदि (क्रमांक <= लंबाई(समूह) && समूह[क्रमांक - १] != शून्यम्) {
                        फल = फल + समूह[क्रमांक - १];
                    }
                    इ = इ + २;
                } अन्यथा {
                    फल = फल + च;
                    इ = इ + १;
                }
            }
        } अन्यथा {
            फल = फल + च;
            इ = इ + १;
        }
    }
    परत् फल;
}

// हर मिलान को प्रतिस्थापन-पाठ से बदलो (re.sub जैसा; $१-$९/$०/$$ समर्थित —
// पैटर्न के भीतर \१ backreference नहीं, प्रतिस्थापन-पाठ का अपना $N है)
कार्य व्यंजक_बदलो(पाठ पैटर्न, पाठ स्रोत, पाठ प्रतिस्थापन) {
    सूची कोड = व्यंजक_संकलन(पैटर्न);
    पाठ परिणाम = "";
    संख्या लं = लंबाई(स्रोत);
    संख्या श = ०;
    यावत् (श <= लं) {
        शब्दकोश मि = व्यं_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) {
            परिणाम = परिणाम + उपखंड(स्रोत, श, लं);
            परत् परिणाम;
        }
        परिणाम = परिणाम + उपखंड(स्रोत, श, मि["आरंभ"]) + व्यं_प्रतिस्थापन_लागू(प्रतिस्थापन, मि["समूह"], मि["पाठ"]);
        यदि (मि["अंत"] > मि["आरंभ"]) {
            श = मि["अंत"];
        } अन्यथा {
            यदि (मि["अंत"] < लं) { परिणाम = परिणाम + उपखंड(स्रोत, मि["अंत"], मि["अंत"] + १); }
            श = मि["अंत"] + १;
        }
    }
    परत् परिणाम;
}

// पैटर्न-मिलान पर स्रोत-पाठ को विभाजित करो (re.split जैसा)
कार्य व्यंजक_विभाजित(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = व्यंजक_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या पिछला = ०;
    संख्या श = ०;
    यावत् (श <= लं) {
        शब्दकोश मि = व्यं_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        यदि (मि["अंत"] == मि["आरंभ"]) {
            श = मि["अंत"] + १;
        } अन्यथा {
            परिणाम = जोड़ें(परिणाम, उपखंड(स्रोत, पिछला, मि["आरंभ"]));
            पिछला = मि["अंत"];
            श = मि["अंत"];
        }
    }
    परिणाम = जोड़ें(परिणाम, उपखंड(स्रोत, पिछला, लं));
    परत् परिणाम;
}

// ---- Capturing groups — सुविधा फलन ----

// मिलान["समूह"][क्रमांक-१] का १-आधारित सुविधाजनक रूप — न मिले/सीमा-बाहर → शून्यम्
कार्य व्यंजक_समूह(शब्दकोश मिलान, संख्या क्रमांक) {
    सूची सू = मिलान["समूह"];
    यदि (क्रमांक < १ || क्रमांक > लंबाई(सू)) { परत् शून्यम्; }
    परत् सू[क्रमांक - १];
}

// (?<नाम>...) से पकड़ा नामित समूह — नाम अज्ञात → शून्यम् (व्यंजक_समूह जैसा
// सीमा-बाहर व्यवहार, त्रुटि नहीं)
कार्य व्यंजक_समूह_नाम(शब्दकोश मिलान, पाठ नाम) {
    शब्दकोश नक्शा = मिलान["नाम_मानचित्र"];
    संख्या क्रमांक = नक्शा[नाम];
    यदि (क्रमांक == शून्यम्) { परत् शून्यम्; }
    परत् व्यंजक_समूह(मिलान, क्रमांक);
}

// व्यंजक_सभी_खोजो जैसा पर सिर्फ़ पाठ नहीं — हर मिलान का पूरा विवरण
// (मिला/आरंभ/अंत/पाठ/समूह) सूची में; व्यंजक_सभी_खोजो पहले जैसा अपरिवर्तित
कार्य व्यंजक_सभी_खोजो_विस्तृत(पाठ पैटर्न, पाठ स्रोत) {
    सूची कोड = व्यंजक_संकलन(पैटर्न);
    सूची परिणाम = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या श = ०;
    यावत् (श <= लं) {
        शब्दकोश मि = व्यं_खोजो_संकलित(कोड, स्रोत, श);
        यदि (मि["मिला"] != सत्य) { विरामः; }
        परिणाम = जोड़ें(परिणाम, मि);
        यदि (मि["अंत"] > मि["आरंभ"]) { श = मि["अंत"]; } अन्यथा { श = मि["अंत"] + १; }
    }
    परत् परिणाम;
}
