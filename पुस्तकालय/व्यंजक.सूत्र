// पुस्तकालय/व्यंजक.सूत्र — नियमित अभिव्यक्ति (regular expressions)
// ============================================================
// आयात "पुस्तकालय/व्यंजक.सूत्र";
//
//   व्यंजक_मिलान("[0-9]+", "अंक 42 यहाँ")        // सत्य — कहीं भी मिले
//   व्यंजक_पूर्ण_मिलान("[a-z]+", "hello")         // सत्य — पूरा पाठ मिले
//   व्यंजक_खोजो("\\d+", "क3म14")                  // {मिला:सत्य, आरंभ:१, अंत:२, पाठ:"3"}
//   व्यंजक_सभी_खोजो("\\d+", "क3म14ल5")            // ["3", "14", "5"]
//   व्यंजक_बदलो("[aeiou]", "hello", "*")          // "h*ll*"
//   व्यंजक_विभाजित(",\\s*", "अ, ब,ग")             // ["अ", "ब", "ग"]
//
// समर्थित: literal अक्षर, `.` (कोई भी), `*`/`+`/`?` (greedy दोहराव),
// `{n}`/`{n,}`/`{n,m}` (greedy गिनती-दोहराव), `[abc]`/`[^abc]`/`[a-z]`
// (वर्ग), `^`/`$` (आरंभ/अंत), `|` (विकल्प), `(...)` (पकड़ने वाला समूह —
// capturing group), `(?<नाम>...)` (नामित capturing group), `(?:...)`
// (न पकड़ने वाला समूह), `(?=...)`/`(?!...)` (सकारात्मक/नकारात्मक
// आगे-दृष्टि — lookahead), `(?<=...)`/`(?<!...)` (सकारात्मक/नकारात्मक
// पीछे-दृष्टि — lookbehind, **स्थिर-लंबाई ही**), `\d \D \w \W \s \S`
// (शॉर्टकट वर्ग), `\1`-`\9` (backreference — पैटर्न में, एक-अंक v1),
// `\k<नाम>` (नामित backreference — नाम पहले पार्स हो चुके समूह को ही
// संदर्भित कर सकता, आगे वाले को नहीं), `\` से literal escape।
//
// `{n,m}`: तरीका — n अनिवार्य प्रतियाँ + (m−n) वैकल्पिक (`?`) प्रतियाँ
// क्रम में, और `{n,}` = n अनिवार्य + एक `*` पूंछ — यानी `{n,m}` अपने आप
// मौजूदा */+/? bytecode-रास्तों में विघटित होता (नया bytecode नहीं)।
//
// Capturing groups: `व्यंजक_खोजो`/`व्यंजक_सभी_खोजो_विस्तृत` के परिणाम में
// "समूह" = सूची (index ० = समूह १ का पाठ, index १ = समूह २ का, आदि; समूह
// मिलान में शामिल न हुआ हो तो शून्यम्)। `व्यंजक_समूह(परिणाम, क्रमांक)` से
// १-आधारित सुविधाजनक पहुँच। समूह-क्रमांक बाएँ-से-दाएँ खुलते कोष्ठक के क्रम
// में (नेस्टेड समूह भी शामिल) — मानक regex परंपरा जैसा ही।
//
// नामित समूह: `(?<नाम>X)` एक सामान्य capturing group ही है (क्रमांक भी
// मिलता, ऊपर जैसा), बस उसे `व्यंजक_समूह_नाम(परिणाम, "नाम")` से नाम द्वारा
// भी पाया जा सकता (नाम अज्ञात → शून्यम्, त्रुटि नहीं)। दो अलग समूहों को
// एक ही नाम देना संकलन-समय त्रुटि। नाम में कोई भी अक्षर (Devanagari/ASCII)
// चल सकता, सिर्फ़ `>` नहीं — यह सूत्र का अपना पहचानकर्ता नहीं, पैटर्न-पाठ
// (data) के भीतर सिर्फ़ एक लेबल-स्ट्रिंग है।
//
// Backreference: पैटर्न में `\1` वही *पाठ* माँगता है जो समूह १ ने रन-टाइम
// पर पकड़ा (सिर्फ़ वही उप-पैटर्न दोबारा नहीं) — जैसे `(\w+)\s+\1` दोहराया
// शब्द ("hello hello") पकड़ता, "hello world" नहीं। समूह अभी तक न मिला हो
// तो `\N` असफल होता (शून्य-चौड़ाई-मिलान नहीं)। `व्यंजक_बदलो` के
// प्रतिस्थापन-पाठ में अलग से `$1`-`$9` (समूह का पाठ), `$0` (पूरा मिलान),
// `$$` (literal `$`) समर्थित — दोनों backreference रूप स्वतंत्र हैं।
//
// Lookahead/lookbehind: शून्य-चौड़ाई दावे — मिलते हैं (या नहीं मिलते) पर
// पाठ *उपभोग नहीं* करते। `(?=X)`/`(?!X)` आगे की ओर — किसी भी लंबाई का X
// चलता (VM पहले से backtracking है, इसलिए X पर कोई सीमा नहीं)।
// `(?<=X)`/`(?<!X)` पीछे की ओर — X की लंबाई **संकलन-समय पर स्थिर** होनी
// ज़रूरी (कोई `*`/`+`/`{n,m}` जहाँ n≠m, कोई `\N` भीतर नहीं) — मानक-सा गैर-
// स्थिर-लंबाई lookbehind सामान्य forward-bytecode VM में अनिश्चित समय ले
// सकता (कहाँ से पीछे शुरू करें, बिना जाने कितनी लंबाई मिलेगी); ज़्यादातर
// प्रमुख regex engine (Perl/PCRE/RE2/Rust) भी यही सीमा रखते हैं। सफल
// (?=X)/(?<=X) के भीतर capturing groups का मान बाहर उजागर होता (जैसे
// `(?=(\d+))` से `\1`/समूह-१ आगे इस्तेमाल हो सकता); नकारात्मक रूपों
// ((?!X)/(?<!X)) के capture कभी उजागर नहीं होते (व्यर्थ, X वैसे भी नहीं मिला)।
//
// ⚠️ सीमा: अगर कोई `*`/`+`/`{n,}` से दोहराया गया हिस्सा खाली-पाठ पर भी
// मिल सकता है (जैसे `(a?)*` या एक ख़ाली-कैप्चर वाला `\1`), तो engine
// अनंत-लूप में फँस सकता — ऐसे पैटर्न से बचें (ज़्यादातर व्यावहारिक पैटर्न
// में यह नहीं आता)।
//
// तरीका: पैटर्न को पहले एक छोटे bytecode (अक्षर/वर्ग/कूद/विभाजन/मिलान
// अनुदेश) में संकलित करते, फिर एक recursive backtracking VM उसे चलाता —
// Thompson की classic NFA-निर्माण तकनीक (Russ Cox के लेखों में वर्णित
// सामान्य सिद्धांत) का मूल विचार, इसी भाषा में स्वतंत्र रूप से लिखा गया
// (न कोई मौजूदा regex engine का कोड, न अनुवाद)। "कूद"/"विभाजन" के लक्ष्य
// संख्या-सूचकांक (data) हैं — फलन-संदर्भ/closure नहीं, क्योंकि Sutra में
// प्रथम-श्रेणी फलन नहीं — यही मुख्य डिज़ाइन-अंतर आम backtracking regex
// लेखों से (जो अक्सर continuation-फलनों से समझाते हैं)।
// ============================================================

// ---- वर्ग-जाँच (character class) ----

कार्य व्यं_वर्ग_जांचो(शब्दकोश अनु, पाठ च) {
    संख्या कोड = अक्षर_मान(च);
    सूची श्रेणियाँ = अनु["श्रेणियाँ"];
    मान मिला = असत्य;
    संख्या इ = ०;
    यावत् (इ < लंबाई(श्रेणियाँ)) {
        संख्या लो = श्रेणियाँ[इ][०];
        संख्या ही = श्रेणियाँ[इ][१];
        यदि (कोड >= लो && कोड <= ही) { मिला = सत्य; }
        इ = इ + १;
    }
    यदि (अनु["निषेध"] == सत्य) { परत् न मिला; }
    परत् मिला;
}

कार्य व्यं_वर्ग_बनाओ(सूची श्रेणियाँ, बूल निषेध) {
    शब्दकोश नो = {};
    नो["प्रकार"] = "वर्ग";
    नो["श्रेणियाँ"] = श्रेणियाँ;
    नो["निषेध"] = निषेध;
    परत् नो;
}
कार्य व्यं_वर्ग_अंक(बूल निषेध) {
    परत् व्यं_वर्ग_बनाओ([[अक्षर_मान("0"), अक्षर_मान("9")]], निषेध);
}
कार्य व्यं_वर्ग_शब्द(बूल निषेध) {
    सूची श = [[अक्षर_मान("a"), अक्षर_मान("z")], [अक्षर_मान("A"), अक्षर_मान("Z")],
               [अक्षर_मान("0"), अक्षर_मान("9")], [अक्षर_मान("_"), अक्षर_मान("_")]];
    परत् व्यं_वर्ग_बनाओ(श, निषेध);
}
कार्य व्यं_वर्ग_रिक्त(बूल निषेध) {
    सूची श = [[अक्षर_मान(" "), अक्षर_मान(" ")], [अक्षर_मान("\t"), अक्षर_मान("\t")],
               [अक्षर_मान("\n"), अक्षर_मान("\n")], [अक्षर_मान("\r"), अक्षर_मान("\r")]];
    परत् व्यं_वर्ग_बनाओ(श, निषेध);
}

// ---- पार्सर: पैटर्न-पाठ → AST ----
// अवस्था = {पैटर्न, स्थिति, लंबाई} — विश्लेषक.सूत्र जैसा thread-through शैली

कार्य व्यं_अव_बनाओ(पाठ पैटर्न) {
    शब्दकोश अ = {};
    अ["पैटर्न"] = पैटर्न;
    अ["स्थिति"] = ०;
    अ["लंबाई"] = लंबाई(पैटर्न);
    अ["समूह_गिनती"] = ०;
    अ["समूह_नाम"] = {};
    परत् अ;
}
कार्य व्यं_अव_अंत(शब्दकोश अ) { परत् अ["स्थिति"] >= अ["लंबाई"]; }
कार्य व्यं_अव_वर्तमान(शब्दकोश अ) {
    यदि (व्यं_अव_अंत(अ)) { परत् ""; }
    परत् उपखंड(अ["पैटर्न"], अ["स्थिति"], अ["स्थिति"] + १);
}
कार्य व्यं_अव_आगे(शब्दकोश अ) { अ["स्थिति"] = अ["स्थिति"] + १; परत् ०; }

// विकल्प := क्रम ('|' क्रम)*  → सूची of शाखाएँ (हर शाखा एक क्रम-सूची)
कार्य व्यं_पार्स_विकल्प(शब्दकोश अ) {
    सूची शाखाएँ = [];
    शाखाएँ = जोड़ें(शाखाएँ, व्यं_पार्स_क्रम(अ));
    यावत् (न व्यं_अव_अंत(अ) && व्यं_अव_वर्तमान(अ) == "|") {
        व्यं_अव_आगे(अ);
        शाखाएँ = जोड़ें(शाखाएँ, व्यं_पार्स_क्रम(अ));
    }
    परत् शाखाएँ;
}

कार्य व्यं_पार्स_क्रम(शब्दकोश अ) {
    सूची सू = [];
    यावत् (न व्यं_अव_अंत(अ) && व्यं_अव_वर्तमान(अ) != "|" && व्यं_अव_वर्तमान(अ) != ")") {
        सू = जोड़ें(सू, व्यं_पार्स_परमाणु(अ));
    }
    परत् सू;
}

// परमाणु := आधार परिमाणक?  → {आधार, न्यून, अधिक(-१=अनंत)}
// {n,m} के भीतर लगातार अंक पढ़ो और संख्या बनाओ
कार्य व्यं_पार्स_संख्या(शब्दकोश अ) {
    संख्या परिणाम = ०;
    संख्या गिनती = ०;
    यावत् (न व्यं_अव_अंत(अ)) {
        पाठ च = व्यं_अव_वर्तमान(अ);
        संख्या कोड = अक्षर_मान(च);
        यदि (कोड < ४८ || कोड > ५७) { विरामः; }
        परिणाम = परिणाम * १० + (कोड - ४८);
        गिनती = गिनती + १;
        व्यं_अव_आगे(अ);
    }
    यदि (गिनती == ०) { प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में अंक अपेक्षित"; }
    परत् परिणाम;
}

// {n} / {n,} / {n,m} पार्स करो (कर्सर पहले ही '{' के बाद है) → {न्यून, अधिक}
कार्य व्यं_पार्स_गिनती_दोहराव(शब्दकोश अ) {
    संख्या पहला = व्यं_पार्स_संख्या(अ);
    यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में '}' अपेक्षित"; }
    पाठ अगला = व्यं_अव_वर्तमान(अ);
    शब्दकोश फल = {};
    यदि (अगला == "}") {
        व्यं_अव_आगे(अ);
        फल["न्यून"] = पहला;
        फल["अधिक"] = पहला;
        परत् फल;
    }
    यदि (अगला != ",") { प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में ',' या '}' अपेक्षित"; }
    व्यं_अव_आगे(अ);   // ','
    यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में '}' अपेक्षित"; }
    यदि (व्यं_अव_वर्तमान(अ) == "}") {
        व्यं_अव_आगे(अ);
        फल["न्यून"] = पहला;
        फल["अधिक"] = ० - १;
        परत् फल;
    }
    संख्या दूसरा = व्यं_पार्स_संख्या(अ);
    यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != "}") {
        प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में '}' अपेक्षित";
    }
    यदि (दूसरा < पहला) {
        प्रक्षेपः "त्रुटिः — व्यंजक: {n,m} में अधिकतम न्यूनतम से कम है";
    }
    व्यं_अव_आगे(अ);
    फल["न्यून"] = पहला;
    फल["अधिक"] = दूसरा;
    परत् फल;
}

कार्य व्यं_पार्स_परमाणु(शब्दकोश अ) {
    शब्दकोश आधार = व्यं_पार्स_आधार(अ);
    संख्या न्यून = १;
    संख्या अधिक = १;
    यदि (न व्यं_अव_अंत(अ)) {
        पाठ च = व्यं_अव_वर्तमान(अ);
        यदि (च == "*") { न्यून = ०; अधिक = ० - १; व्यं_अव_आगे(अ); }
        अन्यथा यदि (च == "+") { न्यून = १; अधिक = ० - १; व्यं_अव_आगे(अ); }
        अन्यथा यदि (च == "?") { न्यून = ०; अधिक = १; व्यं_अव_आगे(अ); }
        अन्यथा यदि (च == "{") {
            व्यं_अव_आगे(अ);
            शब्दकोश गि = व्यं_पार्स_गिनती_दोहराव(अ);
            न्यून = गि["न्यून"];
            अधिक = गि["अधिक"];
        }
    }
    शब्दकोश प = {};
    प["आधार"] = आधार;
    प["न्यून"] = न्यून;
    प["अधिक"] = अधिक;
    परत् प;
}

// नामित समूह/backreference में '<' के ठीक बाद से '>' तक का नाम पढ़ो
// ('<' खुद पहले ही खप चुका होना चाहिए)। नाम में '>' के अलावा कुछ भी
// चलता — कोई ASCII/Devanagari प्रतिबंध नहीं, चूँकि यह पैटर्न-पाठ (data)
// के भीतर सिर्फ़ एक लेबल-स्ट्रिंग है, सूत्र का अपना पहचानकर्ता नहीं।
कार्य व्यं_पार्स_समूह_नाम(शब्दकोश अ) {
    पाठ नाम = "";
    यावत् (सत्य) {
        यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: नामित समूह में '>' अपेक्षित"; }
        पाठ च = व्यं_अव_वर्तमान(अ);
        यदि (च == ">") { व्यं_अव_आगे(अ); विरामः; }
        नाम = नाम + च;
        व्यं_अव_आगे(अ);
    }
    यदि (लंबाई(नाम) == ०) { प्रक्षेपः "त्रुटिः — व्यंजक: समूह-नाम रिक्त नहीं हो सकता"; }
    परत् नाम;
}

कार्य व्यं_पार्स_आधार(शब्दकोश अ) {
    यदि (व्यं_अव_अंत(अ)) {
        प्रक्षेपः "त्रुटिः — व्यंजक: अप्रत्याशित पैटर्न-अंत";
    }
    पाठ च = व्यं_अव_वर्तमान(अ);
    यदि (च == "(") {
        व्यं_अव_आगे(अ);
        यदि (न व्यं_अव_अंत(अ) && व्यं_अव_वर्तमान(अ) == "?") {
            व्यं_अव_आगे(अ);   // '?'
            यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: '(?' अधूरा"; }
            पाठ द्वि = व्यं_अव_वर्तमान(अ);
            यदि (द्वि == ":") {
                व्यं_अव_आगे(अ);
                सूची विकल्प_ग = व्यं_पार्स_विकल्प(अ);
                यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — व्यंजक: ')' अपेक्षित"; }
                व्यं_अव_आगे(अ);
                शब्दकोश नो_ग = {};
                नो_ग["प्रकार"] = "समूह"; नो_ग["विकल्प"] = विकल्प_ग; नो_ग["कैप्चर"] = असत्य; नो_ग["क्रमांक"] = ०;
                परत् नो_ग;
            }
            यदि (द्वि == "=" || द्वि == "!") {
                व्यं_अव_आगे(अ);
                सूची विकल्प_आ = व्यं_पार्स_विकल्प(अ);
                यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — व्यंजक: ')' अपेक्षित"; }
                व्यं_अव_आगे(अ);
                शब्दकोश नो_आ = {};
                नो_आ["प्रकार"] = "आगे_दृष्टि";
                नो_आ["विकल्प"] = विकल्प_आ;
                नो_आ["सकारात्मक"] = द्वि == "=";
                परत् नो_आ;
            }
            यदि (द्वि == "<") {
                व्यं_अव_आगे(अ);   // '<'
                यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: '(?<' अधूरा"; }
                पाठ त्रि = व्यं_अव_वर्तमान(अ);
                यदि (त्रि == "=" || त्रि == "!") {
                    व्यं_अव_आगे(अ);
                    सूची विकल्प_प = व्यं_पार्स_विकल्प(अ);
                    यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — व्यंजक: ')' अपेक्षित"; }
                    व्यं_अव_आगे(अ);
                    शब्दकोश नो_प = {};
                    नो_प["प्रकार"] = "पीछे_दृष्टि";
                    नो_प["विकल्प"] = विकल्प_प;
                    नो_प["सकारात्मक"] = त्रि == "=";
                    परत् नो_प;
                }
                // नामित capturing group: (?<name>...)
                पाठ नाम = व्यं_पार्स_समूह_नाम(अ);
                यदि (अ["समूह_नाम"][नाम] != शून्यम्) {
                    प्रक्षेपः "त्रुटिः — व्यंजक: दोहराया गया समूह-नाम '" + नाम + "'";
                }
                अ["समूह_गिनती"] = अ["समूह_गिनती"] + १;
                संख्या न_क्रमांक = अ["समूह_गिनती"];
                अ["समूह_नाम"][नाम] = न_क्रमांक;
                सूची विकल्प_न = व्यं_पार्स_विकल्प(अ);
                यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != ")") { प्रक्षेपः "त्रुटिः — व्यंजक: ')' अपेक्षित"; }
                व्यं_अव_आगे(अ);
                शब्दकोश नो_न = {};
                नो_न["प्रकार"] = "समूह";
                नो_न["विकल्प"] = विकल्प_न;
                नो_न["कैप्चर"] = सत्य;
                नो_न["क्रमांक"] = न_क्रमांक;
                नो_न["नाम"] = नाम;
                परत् नो_न;
            }
            प्रक्षेपः "त्रुटिः — व्यंजक: '(?' के बाद सिर्फ़ ':' '=' '!' '<name>' '<=' '<!' समर्थित";
        }
        अ["समूह_गिनती"] = अ["समूह_गिनती"] + १;
        संख्या क्रमांक = अ["समूह_गिनती"];
        सूची विकल्प = व्यं_पार्स_विकल्प(अ);
        यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != ")") {
            प्रक्षेपः "त्रुटिः — व्यंजक: ')' अपेक्षित";
        }
        व्यं_अव_आगे(अ);
        शब्दकोश नो = {};
        नो["प्रकार"] = "समूह";
        नो["विकल्प"] = विकल्प;
        नो["कैप्चर"] = सत्य;
        नो["क्रमांक"] = क्रमांक;
        नो["नाम"] = शून्यम्;
        परत् नो;
    }
    यदि (च == "[") { परत् व्यं_पार्स_वर्ग(अ); }
    यदि (च == ".") {
        व्यं_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "कोई_भी";
        परत् नो;
    }
    यदि (च == "^") {
        व्यं_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "आरंभ";
        परत् नो;
    }
    यदि (च == "$") {
        व्यं_अव_आगे(अ);
        शब्दकोश नो = {}; नो["प्रकार"] = "अंत";
        परत् नो;
    }
    यदि (च == "\\") {
        व्यं_अव_आगे(अ);
        परत् व्यं_पार्स_एस्केप(अ);
    }
    व्यं_अव_आगे(अ);
    शब्दकोश नो = {}; नो["प्रकार"] = "अक्षर"; नो["मान"] = च;
    परत् नो;
}

कार्य व्यं_पार्स_एस्केप(शब्दकोश अ) {
    यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: '\\' के बाद अक्षर अपेक्षित"; }
    पाठ च = व्यं_अव_वर्तमान(अ);
    व्यं_अव_आगे(अ);
    यदि (च == "d") { परत् व्यं_वर्ग_अंक(असत्य); }
    यदि (च == "D") { परत् व्यं_वर्ग_अंक(सत्य); }
    यदि (च == "w") { परत् व्यं_वर्ग_शब्द(असत्य); }
    यदि (च == "W") { परत् व्यं_वर्ग_शब्द(सत्य); }
    यदि (च == "s") { परत् व्यं_वर्ग_रिक्त(असत्य); }
    यदि (च == "S") { परत् व्यं_वर्ग_रिक्त(सत्य); }
    यदि (च == "k") {
        यदि (व्यं_अव_अंत(अ) || व्यं_अव_वर्तमान(अ) != "<") {
            प्रक्षेपः "त्रुटिः — व्यंजक: '\\k' के बाद '<नाम>' अपेक्षित (नामित backreference)";
        }
        व्यं_अव_आगे(अ);   // '<'
        पाठ नाम = व्यं_पार्स_समूह_नाम(अ);
        संख्या क्रमांक = अ["समूह_नाम"][नाम];
        यदि (क्रमांक == शून्यम्) {
            प्रक्षेपः "त्रुटिः — व्यंजक: \\k<" + नाम + "> किसी घोषित समूह को संदर्भित नहीं करता (नाम आगे भी घोषित नहीं हो सकता — यहीं तक जो \\k से पहले पार्स हो चुका)";
        }
        शब्दकोश नो_क = {};
        नो_क["प्रकार"] = "पीछे_संदर्भ";
        नो_क["क्रमांक"] = क्रमांक;
        परत् नो_क;
    }
    संख्या कोड = अक्षर_मान(च);
    यदि (कोड >= ४९ && कोड <= ५७) {   // '१'-'९' — backreference (एक-अंक, v1)
        शब्दकोश नो = {};
        नो["प्रकार"] = "पीछे_संदर्भ";
        नो["क्रमांक"] = कोड - ४८;
        परत् नो;
    }
    शब्दकोश नो = {}; नो["प्रकार"] = "अक्षर"; नो["मान"] = च;
    परत् नो;
}

कार्य व्यं_पार्स_वर्ग(शब्दकोश अ) {
    व्यं_अव_आगे(अ);   // '['
    बूल निषेध = असत्य;
    यदि (न व्यं_अव_अंत(अ) && व्यं_अव_वर्तमान(अ) == "^") {
        निषेध = सत्य;
        व्यं_अव_आगे(अ);
    }
    सूची श्रेणियाँ = [];
    मान पहला = सत्य;
    यावत् (न व्यं_अव_अंत(अ) && (व्यं_अव_वर्तमान(अ) != "]" || पहला)) {
        पहला = असत्य;
        पाठ च1 = व्यं_अव_वर्तमान(अ);
        यदि (च1 == "\\") {
            व्यं_अव_आगे(अ);
            यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: वर्ग में अधूरा escape"; }
            पाठ ई = व्यं_अव_वर्तमान(अ);
            व्यं_अव_आगे(अ);
            यदि (ई == "d") { श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("0"), अक्षर_मान("9")]); }
            अन्यथा यदि (ई == "w") {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("a"), अक्षर_मान("z")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("A"), अक्षर_मान("Z")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("0"), अक्षर_मान("9")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("_"), अक्षर_मान("_")]);
            }
            अन्यथा यदि (ई == "s") {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान(" "), अक्षर_मान(" ")]);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [अक्षर_मान("\t"), अक्षर_मान("\t")]);
            } अन्यथा {
                संख्या कोड = अक्षर_मान(ई);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड, कोड]);
            }
        } अन्यथा {
            व्यं_अव_आगे(अ);
            संख्या कोड1 = अक्षर_मान(च1);
            यदि (न व्यं_अव_अंत(अ) && व्यं_अव_वर्तमान(अ) == "-"
                && (अ["स्थिति"] + १) < अ["लंबाई"]
                && उपखंड(अ["पैटर्न"], अ["स्थिति"] + १, अ["स्थिति"] + २) != "]") {
                व्यं_अव_आगे(अ);   // '-'
                पाठ च2 = व्यं_अव_वर्तमान(अ);
                व्यं_अव_आगे(अ);
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड1, अक्षर_मान(च2)]);
            } अन्यथा {
                श्रेणियाँ = जोड़ें(श्रेणियाँ, [कोड1, कोड1]);
            }
        }
    }
    यदि (व्यं_अव_अंत(अ)) { प्रक्षेपः "त्रुटिः — व्यंजक: ']' अपेक्षित"; }
    व्यं_अव_आगे(अ);   // ']'
    परत् व्यं_वर्ग_बनाओ(श्रेणियाँ, निषेध);
}

