    यावत् (इ < ८०) {
        संख्या मिश्र = बिट_भेद(बिट_भेद(डब्ल्यू[इ - ३], डब्ल्यू[इ - ८]), बिट_भेद(डब्ल्यू[इ - १४], डब्ल्यू[इ - १६]));
        डब्ल्यू = जोड़ें(डब्ल्यू, हश_रोटर_बाएँ(मिश्र, १));
        इ = इ + १;
    }

    संख्या अ = ह[०];
    संख्या ब = ह[१];
    संख्या स = ह[२];
    संख्या द = ह[३];
    संख्या य = ह[४];

    संख्या के०० = हश_स्थि(२३१७०, ३११२९);   // 0x5A827999
    संख्या के२० = हश_स्थि(२८३७७, ६०३२१);   // 0x6ED9EBA1
    संख्या के४० = हश_स्थि(३६६३५, ४८३४८);   // 0x8F1BBCDC
    संख्या के६० = हश_स्थि(५१८१०, ४९६२२);   // 0xCA62C1D6

    इ = ०;
    यावत् (इ < ८०) {
        संख्या फ = ०;
        संख्या क = ०;
        यदि (इ < २०) {
            फ = बिट_या(बिट_और(ब, स), बिट_और(हश_नहीं32(ब), द));
            क = के००;
        } अन्यथा यदि (इ < ४०) {
            फ = बिट_भेद(बिट_भेद(ब, स), द);
            क = के२०;
        } अन्यथा यदि (इ < ६०) {
            फ = बिट_या(बिट_या(बिट_और(ब, स), बिट_और(ब, द)), बिट_और(स, द));
            क = के४०;
        } अन्यथा {
            फ = बिट_भेद(बिट_भेद(ब, स), द);
            क = के६०;
        }
        संख्या अस्थायी = हश_जोड़32(हश_जोड़32(हश_रोटर_बाएँ(अ, ५), फ), हश_जोड़32(हश_जोड़32(य, क), डब्ल्यू[इ]));
        य = द;
        द = स;
        स = हश_रोटर_बाएँ(ब, ३०);
        ब = अ;
        अ = अस्थायी;
        इ = इ + १;
    }

    ह[०] = हश_जोड़32(ह[०], अ);
