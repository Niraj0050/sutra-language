    सूची भीतरी = [];
    सूची बाहरी = [];
    संख्या इ = ०;
    यावत् (इ < ६४) {
        संख्या कुं_बाइट = ०;
        यदि (इ < लंबाई(कुं)) { कुं_बाइट = बिट_और(कुं[इ], २५५); }
        भीतरी = जोड़ें(भीतरी, बिट_भेद(कुं_बाइट, ५४));   // 0x36
        बाहरी = जोड़ें(बाहरी, बिट_भेद(कुं_बाइट, ९२));   // 0x5c
        इ = इ + १;
    }
    इ = ०;
    यावत् (इ < लंबाई(संदेश)) {
        भीतरी = जोड़ें(भीतरी, बिट_और(संदेश[इ], २५५));
        इ = इ + १;
    }
    सूची भीतरी_हैश = हश_डाइजेस्ट(भीतरी, एल्गो);
    इ = ०;
    यावत् (इ < लंबाई(भीतरी_हैश)) {
        बाहरी = जोड़ें(बाहरी, भीतरी_हैश[इ]);
        इ = इ + १;
    }
    परत् हश_डाइजेस्ट(बाहरी, एल्गो);
}

// HMAC-MD5 — कच्चे बाइट्स (कुंजी, संदेश दोनों सूची); ३२ अक्षर हेक्स
कार्य एचएमएसी_एमडी5_बाइट्स(सूची कुंजी, सूची संदेश) {
    परत् हैश_बाइट्स_से_हेक्स(हश_एचएमएसी(कुंजी, संदेश, ०));
}

// HMAC-MD5 — कुंजी और संदेश पाठ (UTF-8); ३२ अक्षर हेक्स
कार्य एचएमएसी_एमडी5(पाठ कुंजी, पाठ संदेश) {
    परत् एचएमएसी_एमडी5_बाइट्स(श256_यूटीएफ8_एन्कोड(कुंजी), श256_यूटीएफ8_एन्कोड(संदेश));
}

// HMAC-SHA1 — कच्चे बाइट्स (कुंजी, संदेश दोनों सूची); ४० अक्षर हेक्स
कार्य एचएमएसी_एसएचए1_बाइट्स(सूची कुंजी, सूची संदेश) {
    परत् हैश_बाइट्स_से_हेक्स(हश_एचएमएसी(कुंजी, संदेश, १));
}

// HMAC-SHA1 — कुंजी और संदेश पाठ (UTF-8); ४० अक्षर हेक्स
कार्य एचएमएसी_एसएचए1(पाठ कुंजी, पाठ संदेश) {
    परत् एचएमएसी_एसएचए1_बाइट्स(श256_यूटीएफ8_एन्कोड(कुंजी), श256_यूटीएफ8_एन्कोड(संदेश));
