// पुस्तकालय/हैश.सूत्र — चेकसम और पुराने हैश: CRC-32, Adler-32, FNV-1a, MD5, SHA-1 (+ HMAC)
// ============================================================
// आयात "पुस्तकालय/हैश.सूत्र";
//
//   सीआरसी32("123456789")          // 3421780262  (= 0xCBF43926, मानक check-value)
//   सीआरसी32_हेक्स("123456789")     // "cbf43926"
//   एडलर32("Wikipedia")             // 300286872   (= 0x11E60398)
//   एफएनवी1ए_32("foobar")          // 3214735720  (= 0xBF9CF968)
//   एमडी5_हैश("abc")                // "900150983cd24fb0d6963f7d28e17f72"
//   एसएचए1_हैश("abc")               // "a9993e364706816aba3e25717850c26c9cd0d89d"
//   एचएमएसी_एसएचए1("Jefe", "what do ya want for nothing?")
//                                   // "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"
//
// चेकसम (सीआरसी32 / एडलर32 / एफएनवी1ए_32) एक ३२-बिट धनात्मक संख्या लौटाते;
// `_हेक्स` संस्करण वही ८ अक्षर के लोअरकेस हेक्स पाठ में। `सीआरसी32_अद्यतन(पिछला,
// बाइट्स)` (शुरुआत पिछला = ०) और `एडलर32_अद्यतन(पिछला, बाइट्स)` (शुरुआत पिछला =
// १) zlib के crc32()/adler32() की तरह टुकड़ों में गणना करने देते — पिछला परिणाम
// अगले टुकड़े को दो, अंतिम मान पूरे डेटा का चेकसम।
// एमडी5 / एसएचए1 लोअरकेस हेक्स पाठ (३२ / ४० अक्षर) लौटाते। हर कार्य दो रूप में:
// `X(पाठ)` — पाठ पहले UTF-8 बाइट्स में बदलता (Devanagari का हैश md5sum/sha1sum
// से मेल खाए) — और `X_बाइट्स(सूची)` — कच्चे बाइट्स (०-२५५ की सूची), कोई भी
// बाइनरी डेटा। इनपुट-सूची कभी बदली नहीं जाती।
//
// ⚠️ MD5 और SHA-1 सुरक्षा के लिए टूटे हुए (collisions ज्ञात) हैं — यहाँ सिर्फ़
// अनुकूलता/चेकसम-उपयोग के लिए (git-जैसे object-id, पुराने protocol, ETag,
// फ़ाइल-अखंडता)। नया सुरक्षा-डिज़ाइन हो तो एसएचए256.सूत्र / एचएमएसी.सूत्र लो।
// CRC/Adler/FNV भी सिर्फ़ त्रुटि-पहचान/hash-table के लिए, कूट-सुरक्षा के लिए नहीं।
// HMAC-MD5/SHA-1 अब भी MAC के रूप में सुरक्षित माने जाते, पर नई योजना में
// एचएमएसी_एसएचए256 बेहतर। (तुलना-समय-स्थिर रखना caller की ज़िम्मेदारी।)
//
// ३२-बिट गणित Sutra के ६४-बिट संख्या पर हर जोड़/rotate के बाद निचले ३२ बिट पर मास्क
// करके (एसएचए256.सूत्र की तरह); २^३१ से बड़े स्थिरांक `हश_स्थि(उच्च, निम्न)`
// (दो १६-बिट आधे) से बनते क्योंकि इतने बड़े literal interpreter में अलग तरह
// पढ़े जाते। MD5 का K-सारणी floor(|sin(i+1)| × 2^32) से .NET में दोबारा निकालकर
// जाँची गई; सारे परीक्षण-मान .NET के MD5/SHA1/HMAC* वर्गों और gzip-footer CRC-32 से।
// ============================================================

आयात "पुस्तकालय/एसएचए256.सूत्र";   // श256_यूटीएफ8_एन्कोड (पाठ → UTF-8 बाइट्स) के लिए

// ===== आंतरिक: ३२-बिट गणित =====

// उच्च × 65536 + निम्न (दोनों १६-बिट) — २^३१ से बड़े स्थिरांक बनाने को
कार्य हश_स्थि(संख्या उच्च, संख्या निम्न) { परत् बाम_सरक(उच्च, १६) + निम्न; }

कार्य हश_मास्क32() { परत् बाम_सरक(१, ३२) - १; }   // 0xFFFFFFFF — literal नहीं, गणना से

कार्य हश_जोड़32(संख्या अ, संख्या ब) {
    परत् बिट_और(अ + ब, हश_मास्क32());
}

// निचले ३२ बिट का बिट-NOT
कार्य हश_नहीं32(संख्या अ) {
    परत् बिट_और(बिट_उलट(अ), हश_मास्क32());
}

// ३२-बिट बाएँ-घुमाव (rotate left), १ <= गिनती <= ३१, अ < २^३२
कार्य हश_रोटर_बाएँ(संख्या अ, संख्या गिनती) {
    संख्या ऊपर = बिट_और(बाम_सरक(अ, गिनती), हश_मास्क32());
    संख्या नीचे = दक्षिण_सरक(अ, ३२ - गिनती);
    परत् बिट_या(ऊपर, नीचे);
}

// ===== आंतरिक: हेक्स-प्रारूपण =====

कार्य हश_निबल(संख्या अंक) {
    यदि (अंक < १०) { परत् अक्षर_निर्माण(४८ + अंक); }
    परत् अक्षर_निर्माण(९७ + (अंक - १०));
}

// एक बाइट → २ लोअरकेस हेक्स अक्षर
कार्य हश_हेक्स_बाइट(संख्या बाइट) {
    पाठ फल = "";
    फल = फल + हश_निबल(दक्षिण_सरक(बाइट, ४));
    फल = फल + हश_निबल(बिट_और(बाइट, १५));
    परत् फल;
}

// ३२-बिट संख्या → ८ लोअरकेस हेक्स अक्षर (सबसे बड़ा nibble पहले)
कार्य हश_हेक्स8(संख्या मूल्य) {
    पाठ फल = "";
    संख्या इ = ७;
    यावत् (इ >= ०) {
        फल = फल + हश_निबल(बिट_और(दक्षिण_सरक(मूल्य, इ * ४), १५));
        इ = इ - १;
    }
    परत् फल;
}

// कच्चे बाइट्स (०-२५५ की सूची) → लोअरकेस हेक्स पाठ (२ अक्षर प्रति बाइट)
कार्य हैश_बाइट्स_से_हेक्स(सूची बाइट्स) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(बाइट्स)) {
        फल = फल + हश_हेक्स_बाइट(बिट_और(बाइट्स[इ], २५५));
        इ = इ + १;
    }
    परत् फल;
}

// ===== आंतरिक: padding (RFC 1321 §3.1-3.2, FIPS 180-4 §5.1.1) =====
// बाइट्स की नई प्रति + ०x८० + शून्य (जब तक लंबाई % ६४ == ५६) + ६४-बिट बिट-लंबाई।
// बड़ा_अंत सत्य → लंबाई big-endian (SHA-1); असत्य → little-endian (MD5)।
// इनपुट-सूची की सीधी प्रति बनती, ताकि जोड़ें() की aliasing से caller की सूची न बदले।
कार्य हश_पैड(सूची बाइट्स, मान बड़ा_अंत) {
    संख्या मूल_लं = लंबाई(बाइट्स);
    संख्या बिट_लं = मूल_लं * ८;
    सूची प = [];
    संख्या इ = ०;
    यावत् (इ < मूल_लं) {
        प = जोड़ें(प, बिट_और(बाइट्स[इ], २५५));
        इ = इ + १;
    }
    प = जोड़ें(प, १२८);
    यावत् ((लंबाई(प) % ६४) != ५६) {
        प = जोड़ें(प, ०);
    }
    इ = ०;
    यावत् (इ < ८) {
        // बड़ा-अंत: सबसे बड़ा बाइट पहले (इ = ०..७ ↔ शिफ्ट ७..०); छोटा-अंत: उलटा
        संख्या शिफ्ट = इ;
        यदि (बड़ा_अंत) { शिफ्ट = ७ - इ; }
        संख्या बाइट = ०;
        यदि (शिफ्ट < ४) { बाइट = बिट_और(दक्षिण_सरक(बिट_लं, शिफ्ट * ८), २५५); }
        प = जोड़ें(प, बाइट);
        इ = इ + १;
    }
    परत् प;
}

// ===== चेकसम: CRC-32 (IEEE 802.3 / zlib / PNG / gzip; बहुपद 0xEDB88320, उलटा) =====

// ४-बिट (१६-प्रविष्टि) सारणी: २५६-प्रविष्टि सारणी की जगह हर बाइट पर २ खोज — सारणी बनाना सस्ता (१६×४ चरण), छोटे इनपुट पर तेज़
कार्य हश_सीआरसी_सारणी() {
    सूची सा = [];
    संख्या बहुपद = हश_स्थि(६०८५६, ३३५६८);   // 0xEDB88320
    संख्या सं = ०;
    यावत् (सं < १६) {
        संख्या स = सं;
        संख्या क = ०;
        यावत् (क < ४) {
            यदि (बिट_और(स, १) == १) {
                स = बिट_भेद(बहुपद, दक्षिण_सरक(स, १));
            } अन्यथा {
                स = दक्षिण_सरक(स, १);
            }
            क = क + १;
        }
        सा = जोड़ें(सा, स);
        सं = सं + १;
    }
    परत् सा;
}

// पिछले CRC-32 से आगे चलाओ (zlib crc32(पिछला, डेटा) जैसा) — शुरुआत पिछला = ०
कार्य सीआरसी32_अद्यतन(संख्या पिछला, सूची बाइट्स) {
    संख्या मास्क = हश_मास्क32();
    सूची सा = हश_सीआरसी_सारणी();
    संख्या क = बिट_भेद(बिट_और(पिछला, मास्क), मास्क);
    संख्या इ = ०;
    यावत् (इ < लंबाई(बाइट्स)) {
        संख्या बाइट = बिट_और(बाइट्स[इ], २५५);
        क = बिट_भेद(सा[बिट_और(बिट_भेद(क, बाइट), १५)], दक्षिण_सरक(क, ४));
        क = बिट_भेद(सा[बिट_और(बिट_भेद(क, दक्षिण_सरक(बाइट, ४)), १५)], दक्षिण_सरक(क, ४));
        इ = इ + १;
    }
    परत् बिट_भेद(क, मास्क);
}

// कच्चे बाइट्स का CRC-32 (३२-बिट धनात्मक संख्या)
कार्य सीआरसी32_बाइट्स(सूची बाइट्स) {
    परत् सीआरसी32_अद्यतन(०, बाइट्स);
}

// पाठ (UTF-8 बाइट्स) का CRC-32
कार्य सीआरसी32(पाठ स्रोत) {
    परत् सीआरसी32_बाइट्स(श256_यूटीएफ8_एन्कोड(स्रोत));
}

// पाठ का CRC-32, ८ अक्षर लोअरकेस हेक्स
कार्य सीआरसी32_हेक्स(पाठ स्रोत) {
    परत् हश_हेक्स8(सीआरसी32(स्रोत));
}

// ===== चेकसम: Adler-32 (RFC 1950 / zlib) =====

// पिछले Adler-32 से आगे चलाओ (zlib adler32(पिछला, डेटा) जैसा) — शुरुआत पिछला = १
कार्य एडलर32_अद्यतन(संख्या पिछला, सूची बाइट्स) {
    संख्या अ = बिट_और(पिछला, ६५५३५);
    संख्या ब = बिट_और(दक्षिण_सरक(पिछला, १६), ६५५३५);
    संख्या इ = ०;
    यावत् (इ < लंबाई(बाइट्स)) {
        अ = (अ + बिट_और(बाइट्स[इ], २५५)) % ६५५२१;
        ब = (ब + अ) % ६५५२१;
        इ = इ + १;
    }
    परत् बाम_सरक(ब, १६) + अ;
}

कार्य एडलर32_बाइट्स(सूची बाइट्स) {
    परत् एडलर32_अद्यतन(१, बाइट्स);
}

कार्य एडलर32(पाठ स्रोत) {
    परत् एडलर32_बाइट्स(श256_यूटीएफ8_एन्कोड(स्रोत));
}

कार्य एडलर32_हेक्स(पाठ स्रोत) {
    परत् हश_हेक्स8(एडलर32(स्रोत));
}

// ===== चेकसम: FNV-1a (३२-बिट) — hash-table/तेज़ अंगुलिचिह्न के लिए, कूट-सुरक्षा नहीं =====

कार्य एफएनवी1ए_32_बाइट्स(सूची बाइट्स) {
    संख्या मास्क = हश_मास्क32();
    संख्या ह = हश_स्थि(३३०५२, ४०३८९);   // 0x811C9DC5 (offset basis)
    संख्या इ = ०;
    यावत् (इ < लंबाई(बाइट्स)) {
        ह = बिट_भेद(ह, बिट_और(बाइट्स[इ], २५५));
        ह = बिट_और(ह * १६७७७६१९, मास्क);   // prime 0x01000193
        इ = इ + १;
    }
    परत् ह;
}

कार्य एफएनवी1ए_32(पाठ स्रोत) {
    परत् एफएनवी1ए_32_बाइट्स(श256_यूटीएफ8_एन्कोड(स्रोत));
}

कार्य एफएनवी1ए_32_हेक्स(पाठ स्रोत) {
    परत् हश_हेक्स8(एफएनवी1ए_32(स्रोत));
}

