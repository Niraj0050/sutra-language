// पुस्तकालय/तिथि.सूत्र — तिथि / समय (शुद्ध कैलेंडर-गणित, UTC)
// ============================================================
// एक "पल" = 1970-01-01T00:00:00 UTC से बीते सेकंड (i64) — Unix युग।
// जोड़/घटाव/तुलना सीधे पूर्णांक-गणित; कैलेंडर-रूपांतरण Howard Hinnant के
// branch-रहित सूत्रों से (Gregorian, ऋणात्मक वर्ष भी सही)।
//
//   आयात "पुस्तकालय/तिथि.सूत्र";
//   संख्या प = समय_बनाओ(2026, 9, 10, 14, 30, 0);
//   लिखतु(आईएसओ(प));                       // 2026-09-10T14:30:00Z
//   लिखतु(तिथि_प्रारूप(प, "DD/MM/YYYY"));  // 10/09/2026
//   संख्या कल = जोड़_दिन(प, 1);
//   लिखतु(अंतर_दिन(प, कल));                // 1
//   लिखतु(सप्ताह_दिन_नाम(प));              // गुरुवार
//
// सीमाएँ (v1): केवल UTC — timezone/DST नहीं (TZ-database चाहिए)।
// leap-सेकंड नहीं (कोई नहीं रखता)। "अभी" का समय OS से चाहिए — वह
// syscall/FFI है, इस शुद्ध मॉड्यूल में नहीं।
// ============================================================

// ---- स्थिरांक ----
कार्य तिथि_प्रति_मिनट() { परत् 60; }
कार्य तिथि_प्रति_घंटा() { परत् 3600; }
कार्य तिथि_प्रति_दिन()  { परत् 86400; }

// ============================================================
// मूल: सिविल (वर्ष,माह,दिन) ↔ युग से बीते दिन  (Hinnant)
// ============================================================

// (वर्ष, माह[1-12], दिन[1-31]) → 1970-01-01 से बीते दिन (ऋणात्मक भी)
कार्य दिन_सिविल_से(संख्या वर्ष, संख्या माह, संख्या दिन) {
    संख्या य = वर्ष;
    यदि (माह <= 2) { य = य - 1; }
    संख्या युगक = य;
    यदि (य < 0) { युगक = य - 399; }
    युगक = युगक / 400;
    संख्या योई = य - युगक * 400;            // [0, 399]
    संख्या मस = माह + 9;
    यदि (माह > 2) { मस = माह - 3; }
    संख्या दोई = (153 * मस + 2) / 5 + दिन - 1;   // [0, 365]
    संख्या दोए = योई * 365 + योई / 4 - योई / 100 + दोई;   // [0, 146096]
    परत् युगक * 146097 + दोए - 719468;
}

// युग से बीते दिन → शब्दकोश {वर्ष, माह, दिन}
कार्य सिविल_दिन_से(संख्या दिनांक) {
    संख्या ज = दिनांक + 719468;
    संख्या युगक = ज;
    यदि (ज < 0) { युगक = ज - 146096; }
    युगक = युगक / 146097;
    संख्या दोए = ज - युगक * 146097;         // [0, 146096]
    संख्या योई = (दोए - दोए / 1460 + दोए / 36524 - दोए / 146096) / 365;   // [0, 399]
    संख्या य = योई + युगक * 400;
    संख्या दोई = दोए - (365 * योई + योई / 4 - योई / 100);   // [0, 365]
    संख्या मप = (5 * दोई + 2) / 153;        // [0, 11]
    संख्या दिन = दोई - (153 * मप + 2) / 5 + 1;   // [1, 31]
    संख्या माह = मप + 3;
    यदि (मप >= 10) { माह = मप - 9; }
    यदि (माह <= 2) { य = य + 1; }
    शब्दकोश फल = {};
    फल["वर्ष"] = य;
    फल["माह"] = माह;
    फल["दिन"] = दिन;
    परत् फल;
}

// floor-भाग / floor-शेष (ऋणात्मक-सुरक्षित; C का / % zero की ओर काटता)
कार्य तिथि_तल_भाग(संख्या अ, संख्या ब) {
    संख्या भ = अ / ब;
    यदि ((अ % ब != 0) && ((अ < 0) != (ब < 0))) { भ = भ - 1; }
    परत् भ;
}
कार्य तिथि_तल_शेष(संख्या अ, संख्या ब) {
    संख्या श = अ % ब;
    यदि (श != 0 && ((श < 0) != (ब < 0))) { श = श + ब; }
    परत् श;
}

// ============================================================
// निर्माता
// ============================================================

// आधी-रात (00:00:00) का पल
कार्य तिथि_बनाओ(संख्या वर्ष, संख्या माह, संख्या दिन) {
    परत् दिन_सिविल_से(वर्ष, माह, दिन) * 86400;
}

कार्य समय_बनाओ(संख्या वर्ष, संख्या माह, संख्या दिन, संख्या घंटा, संख्या मिनट, संख्या सेकंड) {
    परत् तिथि_बनाओ(वर्ष, माह, दिन) + घंटा * 3600 + मिनट * 60 + सेकंड;
}

// ============================================================
// अपघटन (पल → भाग)
// ============================================================

// पूरा विवरण: {वर्ष, माह, दिन, घंटा, मिनट, सेकंड, सप्ताह_दिन, वर्ष_दिन}
कार्य तिथि_अंश(संख्या पल) {
    संख्या दिनांक = तिथि_तल_भाग(पल, 86400);
    संख्या शेष = तिथि_तल_शेष(पल, 86400);
    शब्दकोश स = सिविल_दिन_से(दिनांक);
    स["घंटा"] = शेष / 3600;
    स["मिनट"] = (शेष % 3600) / 60;
    स["सेकंड"] = शेष % 60;
    // सप्ताह-दिन: 1970-01-01 गुरुवार (=4, जहाँ 0=रविवार)
    संख्या सद = तिथि_तल_शेष(दिनांक + 4, 7);
    स["सप्ताह_दिन"] = सद;
    स["वर्ष_दिन"] = (दिनांक - दिन_सिविल_से(स["वर्ष"], 1, 1)) + 1;
    परत् स;
}

कार्य वर्ष_का(संख्या पल)   { मान स = सिविल_दिन_से(तिथि_तल_भाग(पल, 86400)); परत् स["वर्ष"]; }
कार्य माह_का(संख्या पल)    { मान स = सिविल_दिन_से(तिथि_तल_भाग(पल, 86400)); परत् स["माह"]; }
कार्य दिन_का(संख्या पल)    { मान स = सिविल_दिन_से(तिथि_तल_भाग(पल, 86400)); परत् स["दिन"]; }
कार्य घंटा_का(संख्या पल)   { परत् तिथि_तल_शेष(पल, 86400) / 3600; }
कार्य मिनट_का(संख्या पल)   { परत् (तिथि_तल_शेष(पल, 86400) % 3600) / 60; }
कार्य सेकंड_का(संख्या पल)  { परत् तिथि_तल_शेष(पल, 86400) % 60; }

// 0=रविवार .. 6=शनिवार
कार्य सप्ताह_दिन(संख्या पल) {
    परत् तिथि_तल_शेष(तिथि_तल_भाग(पल, 86400) + 4, 7);
}

// वर्ष का कौन-सा दिन (1 = 1 जनवरी)
कार्य वर्ष_दिन(संख्या पल) {
    संख्या दिनांक = तिथि_तल_भाग(पल, 86400);
    शब्दकोश स = सिविल_दिन_से(दिनांक);
    परत् (दिनांक - दिन_सिविल_से(स["वर्ष"], 1, 1)) + 1;
}

// उस दिन की आधी-रात
कार्य दिन_आरंभ(संख्या पल) {
    परत् तिथि_तल_भाग(पल, 86400) * 86400;
}

// ============================================================
// कैलेंडर-प्रश्न
// ============================================================

कार्य लीप_वर्ष(संख्या वर्ष) {
    यदि (वर्ष % 4 != 0) { परत् असत्य; }
    यदि (वर्ष % 100 != 0) { परत् सत्य; }
    परत् वर्ष % 400 == 0;
}

कार्य माह_के_दिन(संख्या वर्ष, संख्या माह) {
    यदि (माह == 2) {
        यदि (लीप_वर्ष(वर्ष)) { परत् 29; }
        परत् 28;
    }
    यदि (माह == 4 || माह == 6 || माह == 9 || माह == 11) { परत् 30; }
    परत् 31;
}

// ============================================================
// अंकगणित
// ============================================================

कार्य जोड़_सेकंड(संख्या पल, संख्या न_मान) { परत् पल + न_मान; }
कार्य जोड़_मिनट(संख्या पल, संख्या न_मान)  { परत् पल + न_मान * 60; }
कार्य जोड़_घंटा(संख्या पल, संख्या न_मान)  { परत् पल + न_मान * 3600; }
कार्य जोड़_दिन(संख्या पल, संख्या न_मान)   { परत् पल + न_मान * 86400; }
कार्य जोड़_सप्ताह(संख्या पल, संख्या न_मान) { परत् पल + न_मान * 604800; }

// कैलेंडर-सजग माह-जोड़ (दिन को महीने के अंत तक सीमित करता)
कार्य जोड़_माह(संख्या पल, संख्या न_मान) {
    शब्दकोश स = तिथि_अंश(पल);
    संख्या कुल = (स["वर्ष"] * 12 + (स["माह"] - 1)) + न_मान;
    संख्या नव_वर्ष = तिथि_तल_भाग(कुल, 12);
    संख्या नव_माह = तिथि_तल_शेष(कुल, 12) + 1;
    संख्या सीमा = माह_के_दिन(नव_वर्ष, नव_माह);
    संख्या नव_दिन = स["दिन"];
    यदि (नव_दिन > सीमा) { नव_दिन = सीमा; }
    परत् समय_बनाओ(नव_वर्ष, नव_माह, नव_दिन, स["घंटा"], स["मिनट"], स["सेकंड"]);
}

कार्य जोड़_वर्ष(संख्या पल, संख्या न_मान) {
    परत् जोड़_माह(पल, न_मान * 12);
}

// ============================================================
// अंतर / तुलना
// ============================================================

कार्य अंतर_सेकंड(संख्या अ, संख्या ब) { परत् ब - अ; }
कार्य अंतर_मिनट(संख्या अ, संख्या ब)  { परत् (ब - अ) / 60; }
कार्य अंतर_घंटा(संख्या अ, संख्या ब)  { परत् (ब - अ) / 3600; }
कार्य अंतर_दिन(संख्या अ, संख्या ब) {
    परत् तिथि_तल_भाग(ब, 86400) - तिथि_तल_भाग(अ, 86400);
}

कार्य तिथि_पूर्व(संख्या अ, संख्या ब)  { परत् अ < ब; }
कार्य तिथि_बाद(संख्या अ, संख्या ब)   { परत् अ > ब; }
कार्य तिथि_समान(संख्या अ, संख्या ब)  { परत् अ == ब; }

// एक ही कैलेंडर-दिन?
कार्य एक_दिन(संख्या अ, संख्या ब) {
    परत् तिथि_तल_भाग(अ, 86400) == तिथि_तल_भाग(ब, 86400);
}

// ============================================================
// नाम
// ============================================================

कार्य माह_नाम(संख्या माह) {
    सूची नाम = ["", "जनवरी", "फ़रवरी", "मार्च", "अप्रैल", "मई", "जून",
               "जुलाई", "अगस्त", "सितंबर", "अक्टूबर", "नवंबर", "दिसंबर"];
    यदि (माह < 1 || माह > 12) { परत् ""; }
    परत् नाम[माह];
}
कार्य माह_संक्षेप(संख्या माह) {
    सूची नाम = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun",
               "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    यदि (माह < 1 || माह > 12) { परत् ""; }
    परत् नाम[माह];
}
कार्य सप्ताह_दिन_नाम(संख्या पल) {
    सूची नाम = ["रविवार", "सोमवार", "मंगलवार", "बुधवार",
               "गुरुवार", "शुक्रवार", "शनिवार"];
    परत् नाम[सप्ताह_दिन(पल)];
}
कार्य सप्ताह_दिन_संक्षेप(संख्या पल) {
    सूची नाम = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    परत् नाम[सप्ताह_दिन(पल)];
}

// ============================================================
// प्रारूपण
// ============================================================

कार्य तिथि_दो_अंक(संख्या न_मान) {
    यदि (न_मान < 10 && न_मान >= 0) { परत् "0" + ("" + न_मान); }
    परत् "" + न_मान;
}
कार्य तिथि_चार_अंक(संख्या न_मान) {
    संख्या अ = न_मान;
    पाठ चिह्न = "";
    यदि (अ < 0) { चिह्न = "-"; अ = 0 - अ; }
    पाठ स = "" + अ;
    यावत् (लंबाई(स) < 4) { स = "0" + स; }
    परत् चिह्न + स;
}

// टोकन: YYYY YY MM M DD D HH H mm m ss s DDD(वर्ष-दिन) ddd(सप्ताह-संक्षेप)
//       MMM(माह-संक्षेप) MMMM(माह-नाम) dddd(सप्ताह-नाम)
// (लंबे टोकन पहले जाँचे जाते)
कार्य तिथि_प्रारूप(संख्या पल, पाठ रूप) {
    शब्दकोश स = तिथि_अंश(पल);
    पाठ फल = "";
    संख्या इ = 0;
    संख्या लं = लंबाई(रूप);
    यावत् (इ < लं) {
        मान लिया = असत्य;

        यदि (इ + 4 <= लं) {
            पाठ ट4 = उपखंड(रूप, इ, इ + 4);
            यदि (ट4 == "YYYY") { फल = फल + तिथि_चार_अंक(स["वर्ष"]); इ = इ + 4; लिया = सत्य; }
            अन्यथा यदि (ट4 == "MMMM") { फल = फल + माह_नाम(स["माह"]); इ = इ + 4; लिया = सत्य; }
            अन्यथा यदि (ट4 == "dddd") { फल = फल + सप्ताह_दिन_नाम(पल); इ = इ + 4; लिया = सत्य; }
        }
        यदि (लिया == असत्य && इ + 3 <= लं) {
            पाठ ट3 = उपखंड(रूप, इ, इ + 3);
            यदि (ट3 == "MMM") { फल = फल + माह_संक्षेप(स["माह"]); इ = इ + 3; लिया = सत्य; }
            अन्यथा यदि (ट3 == "ddd") { फल = फल + सप्ताह_दिन_संक्षेप(पल); इ = इ + 3; लिया = सत्य; }
            अन्यथा यदि (ट3 == "DDD") { फल = फल + तिथि_दो_अंक(स["वर्ष_दिन"]); इ = इ + 3; लिया = सत्य; }
        }
        यदि (लिया == असत्य && इ + 2 <= लं) {
            पाठ ट2 = उपखंड(रूप, इ, इ + 2);
            यदि (ट2 == "YY") { फल = फल + तिथि_दो_अंक(स["वर्ष"] % 100); इ = इ + 2; लिया = सत्य; }
            अन्यथा यदि (ट2 == "MM") { फल = फल + तिथि_दो_अंक(स["माह"]); इ = इ + 2; लिया = सत्य; }
            अन्यथा यदि (ट2 == "DD") { फल = फल + तिथि_दो_अंक(स["दिन"]); इ = इ + 2; लिया = सत्य; }
            अन्यथा यदि (ट2 == "HH") { फल = फल + तिथि_दो_अंक(स["घंटा"]); इ = इ + 2; लिया = सत्य; }
            अन्यथा यदि (ट2 == "mm") { फल = फल + तिथि_दो_अंक(स["मिनट"]); इ = इ + 2; लिया = सत्य; }
            अन्यथा यदि (ट2 == "ss") { फल = फल + तिथि_दो_अंक(स["सेकंड"]); इ = इ + 2; लिया = सत्य; }
        }
        यदि (लिया == असत्य) {
            पाठ च = उपखंड(रूप, इ, इ + 1);
            यदि (च == "Y") { फल = फल + ("" + स["वर्ष"]); }
            अन्यथा यदि (च == "M") { फल = फल + ("" + स["माह"]); }
            अन्यथा यदि (च == "D") { फल = फल + ("" + स["दिन"]); }
            अन्यथा यदि (च == "H") { फल = फल + ("" + स["घंटा"]); }
            अन्यथा यदि (च == "m") { फल = फल + ("" + स["मिनट"]); }
            अन्यथा यदि (च == "s") { फल = फल + ("" + स["सेकंड"]); }
            अन्यथा { फल = फल + च; }
            इ = इ + 1;
        }
    }
    परत् फल;
}

// ISO 8601: "2026-09-10T14:30:00Z"
कार्य आईएसओ(संख्या पल) {
    परत् तिथि_प्रारूप(पल, "YYYY-MM-DD") + "T"
       + तिथि_प्रारूप(पल, "HH:mm:ss") + "Z";
}
// केवल तारीख: "2026-09-10"
कार्य आईएसओ_तिथि(संख्या पल) {
    परत् तिथि_प्रारूप(पल, "YYYY-MM-DD");
}

// ============================================================
// पार्सिंग
// ============================================================

// उपखंड को पूर्णांक में (केवल अंक; कोई अंक नहीं → 0)
कार्य तिथि_अंक_पढ़ो(पाठ स, संख्या आ, संख्या अं) {
    संख्या फल = 0;
    संख्या इ = आ;
    यावत् (इ < अं && इ < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, इ, इ + 1));
        यदि (क < 48 || क > 57) { परत् फल; }
        फल = फल * 10 + (क - 48);
        इ = इ + 1;
    }
    परत् फल;
}

// "YYYY-MM-DD" या "YYYY-MM-DDटHH:MM[:SS]" (T/space विभाजक, अंत में Z वैकल्पिक)
// → पल, या -1 अगर आकार गलत। (केवल UTC मान)
कार्य तिथि_पार्स(पाठ स) {
    यदि (लंबाई(स) < 10) { परत् 0 - 1; }
    यदि (उपखंड(स, 4, 5) != "-" || उपखंड(स, 7, 8) != "-") { परत् 0 - 1; }
    संख्या वर्ष = तिथि_अंक_पढ़ो(स, 0, 4);
    संख्या माह = तिथि_अंक_पढ़ो(स, 5, 7);
    संख्या दिन = तिथि_अंक_पढ़ो(स, 8, 10);
    यदि (माह < 1 || माह > 12) { परत् 0 - 1; }
    यदि (दिन < 1 || दिन > माह_के_दिन(वर्ष, माह)) { परत् 0 - 1; }

    संख्या घंटा = 0; संख्या मिनट = 0; संख्या सेकंड = 0;
    यदि (लंबाई(स) >= 16) {
        // स[10] = 'T' या ' '
        घंटा = तिथि_अंक_पढ़ो(स, 11, 13);
        मिनट = तिथि_अंक_पढ़ो(स, 14, 16);
        यदि (लंबाई(स) >= 19 && उपखंड(स, 16, 17) == ":") {
            सेकंड = तिथि_अंक_पढ़ो(स, 17, 19);
        }
    }
    यदि (घंटा < 0 || घंटा > 23) { परत् 0 - 1; }
    यदि (मिनट < 0 || मिनट > 59) { परत् 0 - 1; }
    यदि (सेकंड < 0 || सेकंड > 60) { परत् 0 - 1; }
    परत् समय_बनाओ(वर्ष, माह, दिन, घंटा, मिनट, सेकंड);
}
