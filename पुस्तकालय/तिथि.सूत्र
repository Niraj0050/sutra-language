// पुस्तकालय/तिथि.सूत्र — तिथि / समय (शुद्ध कैलेंडर-गणित, UTC)
// ============================================================
// एक "पल" = 1970-01-01T00:00:00 UTC से बीते सेकंड (i64) — Unix युग।
// जोड़/घटाव/तुलना सीधे पूर्णांक-गणित; कैलेंडर-रूपांतरण Howard Hinnant के
// branch-रहित सूत्रों से (Gregorian, ऋणात्मक वर्ष भी सही)।
//
//   आयात "पुस्तकालय/तिथि.सूत्र";
//   संख्या प = समय_बनाओ(२०२६, ९, १०, १४, ३०, ०);
//   लिखतु(आईएसओ(प));                       // 2026-09-10T14:30:00Z
//   लिखतु(तिथि_प्रारूप(प, "DD/MM/YYYY"));  // १०/०९/२०२६
//   संख्या कल = जोड़_दिन(प, १);
//   लिखतु(अंतर_दिन(प, कल));                // १
//   लिखतु(सप्ताह_दिन_नाम(प));              // गुरुवार
//
// सीमाएँ (v1): केवल UTC — timezone/DST नहीं (TZ-database चाहिए)।
// leap-सेकंड नहीं (कोई नहीं रखता)। "अभी" का समय OS से चाहिए — वह
// syscall/FFI है, इस शुद्ध मॉड्यूल में नहीं।
// ============================================================

// ---- स्थिरांक ----
कार्य तिथि_प्रति_मिनट() { परत् ६०; }
कार्य तिथि_प्रति_घंटा() { परत् ३६००; }
कार्य तिथि_प्रति_दिन()  { परत् ८६४००; }

// ============================================================
// मूल: सिविल (वर्ष,माह,दिन) ↔ युग से बीते दिन  (Hinnant)
// ============================================================

// (वर्ष, माह[१-१२], दिन[१-३१]) → १९७०-०१-०१ से बीते दिन (ऋणात्मक भी)
कार्य दिन_सिविल_से(संख्या वर्ष, संख्या माह, संख्या दिन) {
    संख्या य = वर्ष;
    यदि (माह <= २) { य = य - १; }
    संख्या युगक = य;
    यदि (य < ०) { युगक = य - ३९९; }
    युगक = युगक / ४००;
    संख्या योई = य - युगक * ४००;            // [०, ३९९]
    संख्या मस = माह + ९;
    यदि (माह > २) { मस = माह - ३; }
    संख्या दोई = (१५३ * मस + २) / ५ + दिन - १;   // [०, ३६५]
    संख्या दोए = योई * ३६५ + योई / ४ - योई / १०० + दोई;   // [०, १४६०९६]
    परत् युगक * १४६०९७ + दोए - ७१९४६८;
}

// युग से बीते दिन → शब्दकोश {वर्ष, माह, दिन}
कार्य सिविल_दिन_से(संख्या दिनांक) {
    संख्या ज = दिनांक + ७१९४६८;
    संख्या युगक = ज;
    यदि (ज < ०) { युगक = ज - १४६०९६; }
    युगक = युगक / १४६०९७;
    संख्या दोए = ज - युगक * १४६०९७;         // [०, १४६०९६]
    संख्या योई = (दोए - दोए / १४६० + दोए / ३६५२४ - दोए / १४६०९६) / ३६५;   // [०, ३९९]
    संख्या य = योई + युगक * ४००;
    संख्या दोई = दोए - (३६५ * योई + योई / ४ - योई / १००);   // [०, ३६५]
    संख्या मप = (५ * दोई + २) / १५३;        // [०, ११]
    संख्या दिन = दोई - (१५३ * मप + २) / ५ + १;   // [१, ३१]
    संख्या माह = मप + ३;
    यदि (मप >= १०) { माह = मप - ९; }
    यदि (माह <= २) { य = य + १; }
    शब्दकोश फल = {};
    फल["वर्ष"] = य;
    फल["माह"] = माह;
    फल["दिन"] = दिन;
    परत् फल;
}

// floor-भाग / floor-शेष (ऋणात्मक-सुरक्षित; C का / % zero की ओर काटता)
कार्य तिथि_तल_भाग(संख्या अ, संख्या ब) {
    संख्या भ = अ / ब;
    यदि ((अ % ब != ०) && ((अ < ०) != (ब < ०))) { भ = भ - १; }
    परत् भ;
}
कार्य तिथि_तल_शेष(संख्या अ, संख्या ब) {
    संख्या श = अ % ब;
    यदि (श != ० && ((श < ०) != (ब < ०))) { श = श + ब; }
    परत् श;
}

// ============================================================
// निर्माता
// ============================================================

// आधी-रात (००:००:००) का पल
कार्य तिथि_बनाओ(संख्या वर्ष, संख्या माह, संख्या दिन) {
    परत् दिन_सिविल_से(वर्ष, माह, दिन) * ८६४००;
}

कार्य समय_बनाओ(संख्या वर्ष, संख्या माह, संख्या दिन, संख्या घंटा, संख्या मिनट, संख्या सेकंड) {
    परत् तिथि_बनाओ(वर्ष, माह, दिन) + घंटा * ३६०० + मिनट * ६० + सेकंड;
}

// ============================================================
// अपघटन (पल → भाग)
// ============================================================

// पूरा विवरण: {वर्ष, माह, दिन, घंटा, मिनट, सेकंड, सप्ताह_दिन, वर्ष_दिन}
कार्य तिथि_अंश(संख्या पल) {
    संख्या दिनांक = तिथि_तल_भाग(पल, ८६४००);
    संख्या शेष = तिथि_तल_शेष(पल, ८६४००);
    शब्दकोश स = सिविल_दिन_से(दिनांक);
    स["घंटा"] = शेष / ३६००;
    स["मिनट"] = (शेष % ३६००) / ६०;
    स["सेकंड"] = शेष % ६०;
    // सप्ताह-दिन: १९७०-०१-०१ गुरुवार (=४, जहाँ ०=रविवार)
    संख्या सद = तिथि_तल_शेष(दिनांक + ४, ७);
    स["सप्ताह_दिन"] = सद;
    स["वर्ष_दिन"] = (दिनांक - दिन_सिविल_से(स["वर्ष"], १, १)) + १;
    परत् स;
}

कार्य वर्ष_का(संख्या पल)   { मान स = सिविल_दिन_से(तिथि_तल_भाग(पल, ८६४००)); परत् स["वर्ष"]; }
कार्य माह_का(संख्या पल)    { मान स = सिविल_दिन_से(तिथि_तल_भाग(पल, ८६४००)); परत् स["माह"]; }
कार्य दिन_का(संख्या पल)    { मान स = सिविल_दिन_से(तिथि_तल_भाग(पल, ८६४००)); परत् स["दिन"]; }
कार्य घंटा_का(संख्या पल)   { परत् तिथि_तल_शेष(पल, ८६४००) / ३६००; }
कार्य मिनट_का(संख्या पल)   { परत् (तिथि_तल_शेष(पल, ८६४००) % ३६००) / ६०; }
कार्य सेकंड_का(संख्या पल)  { परत् तिथि_तल_शेष(पल, ८६४००) % ६०; }

// ०=रविवार .. ६=शनिवार
कार्य सप्ताह_दिन(संख्या पल) {
    परत् तिथि_तल_शेष(तिथि_तल_भाग(पल, ८६४००) + ४, ७);
}

// वर्ष का कौन-सा दिन (१ = १ जनवरी)
कार्य वर्ष_दिन(संख्या पल) {
    संख्या दिनांक = तिथि_तल_भाग(पल, ८६४००);
    शब्दकोश स = सिविल_दिन_से(दिनांक);
    परत् (दिनांक - दिन_सिविल_से(स["वर्ष"], १, १)) + १;
}

// उस दिन की आधी-रात
कार्य दिन_आरंभ(संख्या पल) {
    परत् तिथि_तल_भाग(पल, ८६४००) * ८६४००;
}

// ============================================================
// कैलेंडर-प्रश्न
// ============================================================

कार्य लीप_वर्ष(संख्या वर्ष) {
    यदि (वर्ष % ४ != ०) { परत् असत्य; }
    यदि (वर्ष % १०० != ०) { परत् सत्य; }
    परत् वर्ष % ४०० == ०;
}

कार्य माह_के_दिन(संख्या वर्ष, संख्या माह) {
    यदि (माह == २) {
        यदि (लीप_वर्ष(वर्ष)) { परत् २९; }
        परत् २८;
    }
    यदि (माह == ४ || माह == ६ || माह == ९ || माह == ११) { परत् ३०; }
    परत् ३१;
}

// ============================================================
// अंकगणित
// ============================================================

कार्य जोड़_सेकंड(संख्या पल, संख्या न_मान) { परत् पल + न_मान; }
कार्य जोड़_मिनट(संख्या पल, संख्या न_मान)  { परत् पल + न_मान * ६०; }
कार्य जोड़_घंटा(संख्या पल, संख्या न_मान)  { परत् पल + न_मान * ३६००; }
कार्य जोड़_दिन(संख्या पल, संख्या न_मान)   { परत् पल + न_मान * ८६४००; }
कार्य जोड़_सप्ताह(संख्या पल, संख्या न_मान) { परत् पल + न_मान * ६०४८००; }

// कैलेंडर-सजग माह-जोड़ (दिन को महीने के अंत तक सीमित करता)
कार्य जोड़_माह(संख्या पल, संख्या न_मान) {
    शब्दकोश स = तिथि_अंश(पल);
    संख्या कुल = (स["वर्ष"] * १२ + (स["माह"] - १)) + न_मान;
    संख्या नव_वर्ष = तिथि_तल_भाग(कुल, १२);
    संख्या नव_माह = तिथि_तल_शेष(कुल, १२) + १;
    संख्या सीमा = माह_के_दिन(नव_वर्ष, नव_माह);
    संख्या नव_दिन = स["दिन"];
    यदि (नव_दिन > सीमा) { नव_दिन = सीमा; }
    परत् समय_बनाओ(नव_वर्ष, नव_माह, नव_दिन, स["घंटा"], स["मिनट"], स["सेकंड"]);
}

कार्य जोड़_वर्ष(संख्या पल, संख्या न_मान) {
    परत् जोड़_माह(पल, न_मान * १२);
}

// ============================================================
// अंतर / तुलना
// ============================================================

कार्य अंतर_सेकंड(संख्या अ, संख्या ब) { परत् ब - अ; }
कार्य अंतर_मिनट(संख्या अ, संख्या ब)  { परत् (ब - अ) / ६०; }
कार्य अंतर_घंटा(संख्या अ, संख्या ब)  { परत् (ब - अ) / ३६००; }
कार्य अंतर_दिन(संख्या अ, संख्या ब) {
    परत् तिथि_तल_भाग(ब, ८६४००) - तिथि_तल_भाग(अ, ८६४००);
}

कार्य तिथि_पूर्व(संख्या अ, संख्या ब)  { परत् अ < ब; }
कार्य तिथि_बाद(संख्या अ, संख्या ब)   { परत् अ > ब; }
कार्य तिथि_समान(संख्या अ, संख्या ब)  { परत् अ == ब; }

// एक ही कैलेंडर-दिन?
कार्य एक_दिन(संख्या अ, संख्या ब) {
    परत् तिथि_तल_भाग(अ, ८६४००) == तिथि_तल_भाग(ब, ८६४००);
}

// ============================================================
// नाम
// ============================================================

कार्य माह_नाम(संख्या माह) {
    सूची नाम = ["", "जनवरी", "फ़रवरी", "मार्च", "अप्रैल", "मई", "जून",
               "जुलाई", "अगस्त", "सितंबर", "अक्टूबर", "नवंबर", "दिसंबर"];
    यदि (माह < १ || माह > १२) { परत् ""; }
    परत् नाम[माह];
}
कार्य माह_संक्षेप(संख्या माह) {
    सूची नाम = ["", "Jan", "Feb", "Mar", "Apr", "May", "Jun",
               "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    यदि (माह < १ || माह > १२) { परत् ""; }
    परत् नाम[माह];
}
कार्य सप्ताह_दिन_नाम(संख्या पल) {
    सूची नाम = ["रविवार", "सोमवार", "मंगलवार", "बुधवार",
               "गुरुवार", "शुक्रवार", "शनिवार"];
    परत् नाम[सप्ताह_दिन(पल)];
}
कार्य सप्ताह_दिन_संक्षेप(संख्या पल) {
    सूची नाम = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    परत् नाम[सप्ताह_दिन(पल)];
}

// ============================================================
// प्रारूपण
// ============================================================

कार्य तिथि_दो_अंक(संख्या न_मान) {
    यदि (न_मान < १० && न_मान >= ०) { परत् "0" + ("" + न_मान); }
    परत् "" + न_मान;
}
कार्य तिथि_चार_अंक(संख्या न_मान) {
    संख्या अ = न_मान;
    पाठ चिह्न = "";
    यदि (अ < ०) { चिह्न = "-"; अ = ० - अ; }
    पाठ स = "" + अ;
    यावत् (लंबाई(स) < ४) { स = "0" + स; }
    परत् चिह्न + स;
}

// टोकन: YYYY YY MM M DD D HH H mm m ss s DDD(वर्ष-दिन) ddd(सप्ताह-संक्षेप)
//       MMM(माह-संक्षेप) MMMM(माह-नाम) dddd(सप्ताह-नाम)
// (लंबे टोकन पहले जाँचे जाते)
कार्य तिथि_प्रारूप(संख्या पल, पाठ रूप) {
    शब्दकोश स = तिथि_अंश(पल);
    पाठ फल = "";
    संख्या इ = ०;
    संख्या लं = लंबाई(रूप);
    यावत् (इ < लं) {
        मान लिया = असत्य;

        यदि (इ + ४ <= लं) {
            पाठ ट4 = उपखंड(रूप, इ, इ + ४);
            यदि (ट4 == "YYYY") { फल = फल + तिथि_चार_अंक(स["वर्ष"]); इ = इ + ४; लिया = सत्य; }
            अन्यथा यदि (ट4 == "MMMM") { फल = फल + माह_नाम(स["माह"]); इ = इ + ४; लिया = सत्य; }
            अन्यथा यदि (ट4 == "dddd") { फल = फल + सप्ताह_दिन_नाम(पल); इ = इ + ४; लिया = सत्य; }
        }
        यदि (लिया == असत्य && इ + ३ <= लं) {
            पाठ ट3 = उपखंड(रूप, इ, इ + ३);
            यदि (ट3 == "MMM") { फल = फल + माह_संक्षेप(स["माह"]); इ = इ + ३; लिया = सत्य; }
            अन्यथा यदि (ट3 == "ddd") { फल = फल + सप्ताह_दिन_संक्षेप(पल); इ = इ + ३; लिया = सत्य; }
            अन्यथा यदि (ट3 == "DDD") { फल = फल + तिथि_दो_अंक(स["वर्ष_दिन"]); इ = इ + ३; लिया = सत्य; }
        }
        यदि (लिया == असत्य && इ + २ <= लं) {
            पाठ ट2 = उपखंड(रूप, इ, इ + २);
            यदि (ट2 == "YY") { फल = फल + तिथि_दो_अंक(स["वर्ष"] % १००); इ = इ + २; लिया = सत्य; }
            अन्यथा यदि (ट2 == "MM") { फल = फल + तिथि_दो_अंक(स["माह"]); इ = इ + २; लिया = सत्य; }
            अन्यथा यदि (ट2 == "DD") { फल = फल + तिथि_दो_अंक(स["दिन"]); इ = इ + २; लिया = सत्य; }
            अन्यथा यदि (ट2 == "HH") { फल = फल + तिथि_दो_अंक(स["घंटा"]); इ = इ + २; लिया = सत्य; }
            अन्यथा यदि (ट2 == "mm") { फल = फल + तिथि_दो_अंक(स["मिनट"]); इ = इ + २; लिया = सत्य; }
            अन्यथा यदि (ट2 == "ss") { फल = फल + तिथि_दो_अंक(स["सेकंड"]); इ = इ + २; लिया = सत्य; }
        }
        यदि (लिया == असत्य) {
            पाठ च = उपखंड(रूप, इ, इ + १);
            यदि (च == "Y") { फल = फल + ("" + स["वर्ष"]); }
            अन्यथा यदि (च == "M") { फल = फल + ("" + स["माह"]); }
            अन्यथा यदि (च == "D") { फल = फल + ("" + स["दिन"]); }
            अन्यथा यदि (च == "H") { फल = फल + ("" + स["घंटा"]); }
            अन्यथा यदि (च == "m") { फल = फल + ("" + स["मिनट"]); }
            अन्यथा यदि (च == "s") { फल = फल + ("" + स["सेकंड"]); }
            अन्यथा { फल = फल + च; }
            इ = इ + १;
        }
    }
    परत् फल;
}

// ISO 8601: "2026-09-10T14:30:00Z"
कार्य आईएसओ(संख्या पल) {
    परत् तिथि_प्रारूप(पल, "YYYY-MM-DD") + "T"
       + तिथि_प्रारूप(पल, "HH:mm:ss") + "Z";
}
// केवल तारीख: "2026-09-10"
कार्य आईएसओ_तिथि(संख्या पल) {
    परत् तिथि_प्रारूप(पल, "YYYY-MM-DD");
}

// ============================================================
// पार्सिंग
// ============================================================

// उपखंड को पूर्णांक में (केवल अंक; कोई अंक नहीं → ०)
कार्य तिथि_अंक_पढ़ो(पाठ स, संख्या आ, संख्या अं) {
    संख्या फल = ०;
    संख्या इ = आ;
    यावत् (इ < अं && इ < लंबाई(स)) {
        संख्या क = अक्षर_मान(उपखंड(स, इ, इ + १));
        यदि (क < ४८ || क > ५७) { परत् फल; }
        फल = फल * १० + (क - ४८);
        इ = इ + १;
    }
    परत् फल;
}

// "YYYY-MM-DD" या "YYYY-MM-DDटHH:MM[:SS]" (T/space विभाजक, अंत में Z वैकल्पिक)
// → पल, या -१ अगर आकार गलत। (केवल UTC मान)
कार्य तिथि_पार्स(पाठ स) {
    यदि (लंबाई(स) < १०) { परत् ० - १; }
    यदि (उपखंड(स, ४, ५) != "-" || उपखंड(स, ७, ८) != "-") { परत् ० - १; }
    संख्या वर्ष = तिथि_अंक_पढ़ो(स, ०, ४);
    संख्या माह = तिथि_अंक_पढ़ो(स, ५, ७);
    संख्या दिन = तिथि_अंक_पढ़ो(स, ८, १०);
    यदि (माह < १ || माह > १२) { परत् ० - १; }
    यदि (दिन < १ || दिन > माह_के_दिन(वर्ष, माह)) { परत् ० - १; }

    संख्या घंटा = ०; संख्या मिनट = ०; संख्या सेकंड = ०;
    यदि (लंबाई(स) >= १६) {
        // स[१०] = 'T' या ' '
        घंटा = तिथि_अंक_पढ़ो(स, ११, १३);
        मिनट = तिथि_अंक_पढ़ो(स, १४, १६);
        यदि (लंबाई(स) >= १९ && उपखंड(स, १६, १७) == ":") {
            सेकंड = तिथि_अंक_पढ़ो(स, १७, १९);
        }
    }
    यदि (घंटा < ० || घंटा > २३) { परत् ० - १; }
    यदि (मिनट < ० || मिनट > ५९) { परत् ० - १; }
    यदि (सेकंड < ० || सेकंड > ६०) { परत् ० - १; }
    परत् समय_बनाओ(वर्ष, माह, दिन, घंटा, मिनट, सेकंड);
}
