विदेशी "gdi32" "SetTextColor" जी_पाठ_रंग(संख्या, संख्या);
विदेशी "gdi32" "SetBkMode" जी_पृष्ठ_मोड(संख्या, संख्या);
विदेशी "gdi32" "TextOutA" जी_पाठ_लिखो_ए(संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "gdi32" "TextOutW" जी_पाठ_लिखो_व(संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "gdi32" "Rectangle" जी_आयत(संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "gdi32" "RoundRect" जी_गोल_आयत(संख्या, संख्या, संख्या, संख्या, संख्या, संख्या, संख्या);
विदेशी "gdi32" "GetStockObject" जी_स्टॉक_वस्तु(संख्या);

// ---- स्थिरांक ----
कार्य विं_शैली_सामान्य()   { परत् १३५६५९५२; }     // WS_OVERLAPPEDWINDOW = 0x00CF0000
कार्य विं_शैली_दृश्य()     { परत् २६८४३५४५६; }     // WS_VISIBLE = 0x10000000
कार्य विं_डिफ़ॉल्ट_स्थिति() { परत् ० - २१४७४८३६४७ - १; }  // CW_USEDEFAULT = 0x80000000, बिना ≥२^३१ साहित्य के
कार्य विं_दिखा_सामान्य()   { परत् १; }              // SW_SHOWNORMAL
कार्य विं_संदेश_हटाओ_ध्वज() { परत् १; }             // PM_REMOVE
कार्य विं_पारदर्शी_मोड()   { परत् १; }              // SetBkMode मोड — TRANSPARENT
कार्य विं_कर्सर_तीर()      { परत् ३२५१२; }          // IDC_ARROW

// डिफ़ॉल्ट-प्रक्रिया का पता — WNDCLASSA.lpfnWndProc के लिए (DLL-निर्यात, तो
// GetProcAddress से रनटाइम पर मिलता; कोई नई compiler-सुविधा नहीं चाहिए)
कार्य विं_डिफ़ॉल्ट_प्रक्रिया_पता() {
    संख्या उ32 = विं_मॉड्यूल_पता(विदेशी_पता("user32.dll"));
    परत् विं_फलन_खोजो(उ32, विदेशी_पता("DefWindowProcA"));
}

// ---- UTF-8 → UTF-16LE (GDI/Window-title Unicode APIs के लिए) ----
// सूत्र_तल_यूटीएफ_चौड़ा — तल.s में पहले से मौजूद, फ़ाइल-पथ हेतु बना (मूल_रनटाइम.सूत्र
// इसे CreateFileW आदि के लिए बुलाता); यहाँ TextOutW/CreateWindowExW के लिए दुबारा।

कार्य विं_रिक्त_बफर(संख्या अक्षर_गण) {
    पाठ स = "";
    संख्या इ = ०;
    यावत् (इ < अक्षर_गण) { स = स + " "; इ = इ + १; }
    परत् स;
}

// पाठ → शब्दकोश {पता, गणना (WCHAR में), _रॉ (caller जीवित रखे)}
कार्य विं_चौड़ा_बनाओ(पाठ स) {
    पाठ बफ = विं_रिक्त_बफर(५१२);   // २५६ WCHAR क्षमता — UI-पाठ के लिए काफ़ी
    संख्या बफ_पता = विदेशी_पता(बफ);
    संख्या गणना = सूत्र_तल_यूटीएफ_चौड़ा(विदेशी_पता(स), बफ_पता, २५६);
    शब्दकोश फल = {};
    फल["_रॉ"] = बफ;
    फल["पता"] = बफ_पता;
    फल["गणना"] = गणना;
    परत् फल;
}

// ---- कच्चे बाइट-बफर सहायक (अंतर्_* पर, ४-बाइट widths) ----

कार्य विं_लिख4(संख्या पता, संख्या ऑफ, संख्या मान_) {
    अंतर्_लिख1(पता, ऑफ,     मान_ % २५६);
    अंतर्_लिख1(पता, ऑफ + १, (मान_ / २५६) % २५६);
    अंतर्_लिख1(पता, ऑफ + २, (मान_ / ६५५३६) % २५६);
    अंतर्_लिख1(पता, ऑफ + ३, (मान_ / १६७७७२१६) % २५६);
    परत् ०;
}
कार्य विं_लिख8(संख्या पता, संख्या ऑफ, संख्या मान_) {
    अंतर्_लिख8(पता, ऑफ, मान_);
    परत् ०;
}

// ---- WNDCLASSA (७२ बाइट) ----
// style@०(४) lpfnWndProc@८(८) cbClsExtra@१६(४) cbWndExtra@२०(४) hInstance@२४(८)
// hIcon@३२(८) hCursor@४०(८) hbrBackground@४८(८) lpszMenuName@५६(८) lpszClassName@६४(८)
कार्य विं_वर्ग_बनाओ(पाठ वर्ग_नाम, संख्या प्रक्रिया_पता, संख्या इंस्ट) {
    पाठ कच्चा = "                                                                        "; // ७२ स्पेस
    संख्या प = विदेशी_पता(कच्चा);
    संख्या कर्सर = विं_कर्सर_लो(०, विं_कर्सर_तीर());
    संख्या ब्रश = जी_ब्रश_बनाओ(२५००१३४);   // गहरा नीला-स्लेट पृष्ठभूमि (#0f172a बीजीआर)
    विं_लिख4(प, ०, ३);                      // style = CS_HREDRAW|CS_VREDRAW
    विं_लिख8(प, ८, प्रक्रिया_पता);
    विं_लिख4(प, १६, ०);
    विं_लिख4(प, २०, ०);
    विं_लिख8(प, २४, इंस्ट);
    विं_लिख8(प, ३२, ०);                     // hIcon = डिफ़ॉल्ट
    विं_लिख8(प, ४०, कर्सर);
    विं_लिख8(प, ४८, ब्रश);
    विं_लिख8(प, ५६, ०);                     // lpszMenuName = शून्य
    विं_लिख8(प, ६४, विदेशी_पता(वर्ग_नाम));
    शब्दकोश फल = {};
    फल["_रॉ"] = कच्चा;     // caller इसे जीवित रखे — पता तभी वैध
    फल["_ब्रश"] = ब्रश;
    फल["पता"] = प;
    परत् फल;
}

// साधारण overlapped, visible खिड़की — बीच स्क्रीन पर (CW_USEDEFAULT)। शीर्षक
// में देवनागरी सही दिखे इसलिए ...ExW + UTF-16 रूपांतरण (वर्ग-नाम शुद्ध-ASCII
// रहे तो RegisterClassA से पंजीकृत क्लास भी ...ExW से बनती — मानक व्यवहार)।
कार्य विं_खिड़की_बनाओ_सरल(पाठ वर्ग_नाम, पाठ शीर्षक, संख्या चौड़ाई, संख्या ऊँचाई, संख्या इंस्ट) {
    संख्या शैली = विं_शैली_सामान्य() + विं_शैली_दृश्य();
    शब्दकोश व_वर्ग = विं_चौड़ा_बनाओ(वर्ग_नाम);
    शब्दकोश व_शीर्षक = विं_चौड़ा_बनाओ(शीर्षक);
    परत् विं_सीडब्ल्यूई_व(
        ०,                              // dwExStyle
        व_वर्ग["पता"],
        व_शीर्षक["पता"],
        शैली,
        विं_डिफ़ॉल्ट_स्थिति(), विं_डिफ़ॉल्ट_स्थिति(),
        चौड़ाई, ऊँचाई,
        ०, ०,                           // parent, menu
        इंस्ट,
        ०                               // lpParam
    );
}

// संदेश-लूप — खिड़की के बंद होने तक चलता (~20fps poll, कोई custom WNDPROC नहीं
// चाहिए: X दबाने पर DefWindowProcA खुद खिड़की नष्ट करता, IsWindow असत्य हो जाता)
कार्य विं_लूप_चलाओ(संख्या ख) {
    पाठ संदेश_बफ = "                                                "; // ४८-बाइट MSG scratch
    संख्या मपता = विदेशी_पता(संदेश_बफ);
    यावत् (सत्य) {
        यावत् (विं_संदेश_झाँक(मपता, ०, ०, ०, विं_संदेश_हटाओ_ध्वज()) != ०) {
            विं_संदेश_अनुवाद(मपता);
            विं_संदेश_भेजो(मपता);
        }
        यदि (विं_खिड़की_है(ख) == ०) { विरामः; }
        विं_सोओ(५०);
    }
    परत् ०;
}

// ---- रंग: "#rrggbb" पाठ → COLORREF (0x00bbggrr) ----
कार्य विं_हेक्स_अंक(पाठ च) {
    संख्या क = अक्षर_मान(च);
    यदि (क >= ४८ && क <= ५७) { परत् क - ४८; }
    यदि (क >= ९७ && क <= १०२) { परत् क - ९७ + १०; }
    यदि (क >= ६५ && क <= ७०) { परत् क - ६५ + १०; }
    परत् ०;
}
कार्य विं_हेक्स_युग्म(पाठ स, संख्या इ) {
    परत् विं_हेक्स_अंक(उपखंड(स, इ, इ + १)) * १६ + विं_हेक्स_अंक(उपखंड(स, इ + १, इ + २));
}
कार्य विं_रंग(पाठ हेक्स) {
    संख्या आ = ०;
    यदि (लंबाई(हेक्स) > ० && उपखंड(हेक्स, ०, १) == "#") { आ = १; }
    संख्या ला = विं_हेक्स_युग्म(हेक्स, आ);
    संख्या हर = विं_हेक्स_युग्म(हेक्स, आ + २);
    संख्या नी = विं_हेक्स_युग्म(हेक्स, आ + ४);
    परत् नी * ६५५३६ + हर * २५६ + ला;
}

// ---- यूआई.सूत्र का चित्र_सूची (render-command list) GDI पर खींचो ----
कार्य विं_चित्र_खींचो(संख्या डीसी, सूची आदेश) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(आदेश)) {
        शब्दकोश आ = आदेश[इ];
        पाठ किस्म = आ["आदेश"];
        संख्या क्ष = आ["क्ष"]; संख्या य = आ["य"];
        यदि (किस्म == "आयत") {
            संख्या ब्रश = जी_ब्रश_बनाओ(विं_रंग(आ["रंग"]));
            संख्या पुराना = जी_वस्तु_चुनो(डीसी, ब्रश);
            संख्या कोना = आ["कोना"];
            यदि (कोना > ०) {
                जी_गोल_आयत(डीसी, क्ष, य, क्ष + आ["चौड़ाई"], य + आ["ऊँचाई"], कोना, कोना);
            } अन्यथा {
                जी_आयत(डीसी, क्ष, य, क्ष + आ["चौड़ाई"], य + आ["ऊँचाई"]);
            }
            जी_वस्तु_चुनो(डीसी, पुराना);
            जी_वस्तु_हटाओ(ब्रश);
        } अन्यथा यदि (किस्म == "पाठ") {
            जी_पाठ_रंग(डीसी, विं_रंग(आ["रंग"]));
            जी_पृष्ठ_मोड(डीसी, विं_पारदर्शी_मोड());
            शब्दकोश च = विं_चौड़ा_बनाओ(आ["सामग्री"]);   // देवनागरी glyph सही खींचे — TextOutW
            जी_पाठ_लिखो_व(डीसी, क्ष, य, च["पता"], च["गणना"]);
        } अन्यथा यदि (किस्म == "किनारा") {
            // Rectangle() हमेशा वर्तमान brush से भी भरता — सिर्फ़ रूपरेखा को
            // HOLLOW_BRUSH (stock #५) चुनकर रोका जा सकता
            संख्या कलम = जी_कलम_बनाओ(०, १, विं_रंग(आ["रंग"]));
            संख्या खाली_ब्रश = जी_स्टॉक_वस्तु(५);
            संख्या पुराना_क = जी_वस्तु_चुनो(डीसी, कलम);
            संख्या पुराना_ब = जी_वस्तु_चुनो(डीसी, खाली_ब्रश);
            जी_आयत(डीसी, क्ष, य, क्ष + आ["चौड़ाई"], य + आ["ऊँचाई"]);
            जी_वस्तु_चुनो(डीसी, पुराना_क);
            जी_वस्तु_चुनो(डीसी, पुराना_ब);
            जी_वस्तु_हटाओ(कलम);
        }
        इ = इ + १;
    }
    परत् ०;
}
