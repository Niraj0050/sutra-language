// ============================================================
// १. सदिश बीजगणित (Vector Operations)
// ============================================================

कार्य सदिश_बनाओ(संख्या आकार, दशमलव प्रारंभिक_मान) {
    सूची डेटा = [];
    संख्या इ = ०;
    यावत् (इ < आकार) {
        डेटा = जोड़ें(डेटा, प्रारंभिक_मान);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["आकार"] = आकार;
    फल["डेटा"] = डेटा;
    परत् फल;
}

कार्य सदिश_शून्य(संख्या आकार) {
    परत् सदिश_बनाओ(आकार, ०.०);
}

कार्य सदिश_एक(संख्या आकार) {
    परत् सदिश_बनाओ(आकार, १.०);
}

कार्य सदिश_से_सूची(सूची इनपुट_सूची) {
    शब्दकोश फल = {};
    फल["आकार"] = लंबाई(इनपुट_सूची);
    फल["डेटा"] = इनपुट_सूची;
    परत् फल;
}

कार्य सदिश_पाओ(शब्दकोश सदिश, संख्या सूचकांक) {
    यदि (सूचकांक < ० || सूचकांक >= सदिश["आकार"]) {
        फेको "त्रुटिः सदिश सूचकांक सीमा से बाहर";
    }
    सूची डेटा = सदिश["डेटा"];
    दशमलव मूल्य = डेटा[सूचकांक];
    परत् मूल्य;
}

कार्य सदिश_सेट(शब्दकोश सदिश, संख्या सूचकांक, दशमलव मूल्य) {
    यदि (सूचकांक < ० || सूचकांक >= सदिश["आकार"]) {
        फेको "त्रुटिः सदिश सूचकांक सीमा से बाहर";
    }
    सूची डेटा = सदिश["डेटा"];
    डेटा[सूचकांक] = मूल्य;
}

कार्य सदिश_जोड़(शब्दकोश अ, शब्दकोश ब) {
    संख्या आकार = अ["आकार"];
    यदि (आकार != ब["आकार"]) {
        फेको "त्रुटिः सदिश योग हेतु आकार असमान है";
    }
    सूची अ_डेटा = अ["डेटा"];
    सूची ब_डेटा = ब["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव योग_मूल्य = अ_डेटा[इ] + ब_डेटा[इ];
        नया_डेटा = जोड़ें(नया_डेटा, योग_मूल्य);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["आकार"] = आकार;
    फल["डेटा"] = नया_डेटा;
    परत् फल;
}

कार्य सदिश_घटाओ(शब्दकोश अ, शब्दकोश ब) {
    संख्या आकार = अ["आकार"];
    यदि (आकार != ब["आकार"]) {
        फेको "त्रुटिः सदिश घटाव हेतु आकार असमान है";
    }
    सूची अ_डेटा = अ["डेटा"];
    सूची ब_डेटा = ब["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव अंतर_मूल्य = अ_डेटा[इ] - ब_डेटा[इ];
        नया_डेटा = जोड़ें(नया_डेटा, अंतर_मूल्य);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["आकार"] = आकार;
    फल["डेटा"] = नया_डेटा;
    परत् फल;
}

कार्य सदिश_अदिश_गुणा(शब्दकोश सदिश, दशमलव अदिश) {
    संख्या आकार = सदिश["आकार"];
    सूची डेटा = सदिश["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < आकार) {
        दशमलव गुणन_मूल्य = डेटा[इ] * अदिश;
        नया_डेटा = जोड़ें(नया_डेटा, गुणन_मूल्य);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["आकार"] = आकार;
    फल["डेटा"] = नया_डेटा;
    परत् फल;
}

कार्य सदिश_बिंदु_गुणन(शब्दकोश अ, शब्दकोश ब) {
    संख्या आकार = अ["आकार"];
    यदि (आकार != ब["आकार"]) {
        फेको "त्रुटिः बिंदु गुणन हेतु सदिश आकार असमान है";
    }
    सूची अ_डेटा = अ["डेटा"];
    सूची ब_डेटा = ब["डेटा"];
    दशमलव योग = ०.०;
    संख्या इ = ०;
    यावत् (इ < आकार) {
        योग = योग + (अ_डेटा[इ] * ब_डेटा[इ]);
        इ = इ + १;
    }
    परत् योग;
}

कार्य सदिश_मानदण्ड(शब्दकोश सदिश) {
    दशमलव वर्ग_योग = सदिश_बिंदु_गुणन(सदिश, सदिश);
    परत् वर्गमूल(वर्ग_योग);
}

कार्य सदिश_मानदण्ड_एल१(शब्दकोश सदिश) {
    संख्या आकार = सदिश["आकार"];
    सूची डेटा = सदिश["डेटा"];
    दशमलव योग = ०.०;
    संख्या इ = ०;
    यावत् (इ < आकार) {
        योग = योग + निरपेक्ष(डेटा[इ]);
        इ = इ + १;
    }
    परत् योग;
}

कार्य सदिश_प्रसामान्यीकरण(शब्दकोश सदिश) {
    दशमलव परिमाण = सदिश_मानदण्ड(सदिश);
    यदि (परिमाण == ०.०) {
        परत् सदिश;
    }
    परत् सदिश_अदिश_गुणा(सदिश, १.० / परिमाण);
}

कार्य सदिश_कोज्या_सादृश्य(शब्दकोश अ, शब्दकोश ब) {
    दशमलव बिंदु = सदिश_बिंदु_गुणन(अ, ब);
    दशमलव परिमाण_अ = सदिश_मानदण्ड(अ);
    दशमलव परिमाण_ब = सदिश_मानदण्ड(ब);
    यदि (परिमाण_अ == ०.० || परिमाण_ब == ०.०) {
        परत् ०.०;
    }
    परत् बिंदु / (परिमाण_अ * परिमाण_ब);
}

कार्य सदिश_यूक्लिड_दूरी(शब्दकोश अ, शब्दकोश ब) {
    शब्दकोश अंतर = सदिश_घटाओ(अ, ब);
    परत् सदिश_मानदण्ड(अंतर);
}

// ============================================================
// २. बहु-आयामी दिशक प्रणाली (Multidimensional Tensor Engine)
// ============================================================

कार्य दिशक_डग_गणना(सूची आकार_सूची) {
    संख्या ल = लंबाई(आकार_सूची);
    यदि (ल == ०) { परत् []; }
    
    सूची डग = [];
    संख्या इ = ०;
    यावत् (इ < ल) {
        डग = जोड़ें(डग, १);
        इ = इ + १;
    }
    
    संख्या पद = ल - २;
    यावत् (पद >= ०) {
        डग[पद] = डग[पद + १] * आकार_सूची[पद + १];
        पद = पद - १;
    }
    परत् डग;
}

कार्य दिशक_कुल_तत्व(सूची आकार_सूची) {
    संख्या ल = लंबाई(आकार_सूची);
    यदि (ल == ०) { परत् ०; }
    संख्या कुल = १;
    संख्या इ = ०;
    यावत् (इ < ल) {
        कुल = कुल * आकार_सूची[इ];
        इ = इ + १;
    }
    परत् कुल;
}

कार्य दिशक_फ्लैट_सूचकांक(सूची डग_सूची, सूची सूचकांक_सूची) {
    संख्या फ्लैट = ०;
    संख्या ल = लंबाई(सूचकांक_सूची);
    संख्या इ = ०;
    यावत् (इ < ल) {
        फ्लैट = फ्लैट + (सूचकांक_सूची[इ] * डग_सूची[इ]);
        इ = इ + १;
    }
    परत् फ्लैट;
}

कार्य दिशक_बनाओ(सूची आकार_सूची, दशमलव प्रारंभिक_मूल्य) {
    संख्या कुल = दिशक_कुल_तत्व(आकार_सूची);
    सूची डग = दिशक_डग_गणना(आकार_सूची);
    
    सूची डेटा = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        डेटा = जोड़ें(डेटा, प्रारंभिक_मूल्य);
        इ = इ + १;
    }
    
    शब्दकोश फल = {};
    फल["आकार"] = आकार_सूची;
    फल["आयाम"] = लंबाई(आकार_सूची);
    फल["कुल_तत्व"] = कुल;
    फल["डग"] = डग;
    फल["डेटा"] = डेटा;
    परत् फल;
}

कार्य दिशक_शून्य(सूची आकार_सूची) {
    परत् दिशक_बनाओ(आकार_सूची, ०.०);
}

कार्य दिशक_एक(सूची आकार_सूची) {
    परत् दिशक_बनाओ(आकार_सूची, १.०);
}

कार्य दिशक_पाओ(शब्दकोश दिशक, सूची सूचकांक_सूची) {
    संख्या फ्लैट = दिशक_फ्लैट_सूचकांक(दिशक["डग"], सूचकांक_सूची);
    सूची डेटा = दिशक["डेटा"];
    दशमलव मूल्य = डेटा[फ्लैट];
    परत् मूल्य;
}

कार्य दिशक_सेट(शब्दकोश दिशक, सूची सूचकांक_सूची, दशमलव मूल्य) {
    संख्या फ्लैट = दिशक_फ्लैट_सूचकांक(दिशक["डग"], सूचकांक_सूची);
    सूची डेटा = दिशक["डेटा"];
    डेटा[फ्लैट] = मूल्य;
}

कार्य दिशक_पुनराकार(शब्दकोश दिशक, सूची नया_आकार_सूची) {
    संख्या नया_कुल = दिशक_कुल_तत्व(नया_आकार_सूची);
    यदि (नया_कुल != दिशक["कुल_तत्व"]) {
        फेको "त्रुटिः पुनराकार हेतु तत्व संख्या समान होनी चाहिए";
    }
    शब्दकोश फल = {};
    फल["आकार"] = नया_आकार_सूची;
    फल["आयाम"] = लंबाई(नया_आकार_सूची);
    फल["कुल_तत्व"] = नया_कुल;
    फल["डग"] = दिशक_डग_गणना(नया_आकार_सूची);
    फल["डेटा"] = दिशक["डेटा"];
    परत् फल;
}

कार्य दिशक_चपटा(शब्दकोश दिशक) {
    परत् दिशक_पुनराकार(दिशक, [दिशक["कुल_तत्व"]]);
}

कार्य दिशक_जोड़(शब्दकोश अ, शब्दकोश ब) {
    संख्या कुल = अ["कुल_तत्व"];
    यदि (कुल != ब["कुल_तत्व"]) {
        फेको "त्रुटिः दिशक योग हेतु आकार समान होना चाहिए";
    }
