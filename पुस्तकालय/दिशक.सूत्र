    }
    शब्दकोश फल = {};
    फल["आकार"] = अ["आकार"];
    फल["आयाम"] = अ["आयाम"];
    फल["कुल_तत्व"] = कुल;
    फल["डग"] = अ["डग"];
    फल["डेटा"] = नया_डेटा;
