    सूची अ_डेटा = अ["डेटा"];
    सूची ब_डेटा = ब["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        दशमलव गुणन_मूल्य = अ_डेटा[इ] * ब_डेटा[इ];
        नया_डेटा = जोड़ें(नया_डेटा, गुणन_मूल्य);
