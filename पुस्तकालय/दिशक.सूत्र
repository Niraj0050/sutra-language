    सूची ब_डेटा = ब["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        दशमलव योग_मूल्य = अ_डेटा[इ] + ब_डेटा[इ];
        नया_डेटा = जोड़ें(नया_डेटा, योग_मूल्य);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["आकार"] = अ["आकार"];
    फल["आयाम"] = अ["आयाम"];
    फल["कुल_तत्व"] = कुल;
    फल["डग"] = अ["डग"];
    फल["डेटा"] = नया_डेटा;
    परत् फल;
}

कार्य दिशक_घटाओ(शब्दकोश अ, शब्दकोश ब) {
    संख्या कुल = अ["कुल_तत्व"];
    यदि (कुल != ब["कुल_तत्व"]) {
