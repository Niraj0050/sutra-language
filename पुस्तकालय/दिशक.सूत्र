}

कार्य दिशक_अदिश_गुणा(शब्दकोश दिशक, दशमलव अदिश) {
    संख्या कुल = दिशक["कुल_तत्व"];
    सूची डेटा = दिशक["डेटा"];
    सूची नया_डेटा = [];
    संख्या इ = ०;
    यावत् (इ < कुल) {
        दशमलव गुणन_मूल्य = डेटा[इ] * अदिश;
        नया_डेटा = जोड़ें(नया_डेटा, गुणन_मूल्य);
        इ = इ + १;
    }
    शब्दकोश फल = {};
    फल["आकार"] = दिशक["आकार"];
    फल["आयाम"] = दिशक["आयाम"];
    फल["कुल_तत्व"] = कुल;
    फल["डग"] = दिशक["डग"];
    फल["डेटा"] = नया_डेटा;
    परत् फल;
}

कार्य दिशक_तत्व_योग(शब्दकोश दिशक) {
    संख्या कुल = दिशक["कुल_तत्व"];
    सूची डेटा = दिशक["डेटा"];
    दशमलव योग = ०.०;
    संख्या इ = ०;
    यावत् (इ < कुल) {
        योग = योग + डेटा[इ];
        इ = इ + १;
    }
    परत् योग;
}

कार्य दिशक_माध्य(शब्दकोश दिशक) {
    संख्या कुल = दिशक["कुल_तत्व"];
    यदि (कुल == ०) { परत् ०.०; }
    दशमलव योग = दिशक_तत्व_योग(दिशक);
    परत् योग / कुल;
}

कार्य दिशक_प्रसरण(शब्दकोश दिशक) {
    संख्या कुल = दिशक["कुल_तत्व"];
    यदि (कुल == ०) { परत् ०.०; }
    दशमलव माध्य_मूल्य = दिशक_माध्य(दिशक);
    सूची डेटा = दिशक["डेटा"];
    दशमलव वर्ग_योग = ०.०;
    संख्या इ = ०;
    यावत् (इ < कुल) {
        दशमलव अंतर = डेटा[इ] - माध्य_मूल्य;
        वर्ग_योग = वर्ग_योग + (अंतर * अंतर);
        इ = इ + १;
    }
    परत् वर्ग_योग / कुल;
}

कार्य दिशक_मानक_विचलन(शब्दकोश दिशक) {
    दशमलव प्रसरण = दिशक_प्रसरण(दिशक);
    परत् वर्गमूल(प्रसरण);
}

// २D आव्यूह गुणन (GEMM)
कार्य दिशक_मैटमुल_२डी(शब्दकोश अ, शब्दकोश ब) {
    यदि (अ["आयाम"] != २ || ब["आयाम"] != २) {
        फेको "त्रुटिः मैतमुल हेतु २D दिशक अपेक्षित";
    }
    संख्या अ_पं = अ["आकार"][०];
    संख्या अ_स्तं = अ["आकार"][१];
    संख्या ब_पं = ब["आकार"][०];
    संख्या ब_स्तं = ब["आकार"][१];
    
    यदि (अ_स्तं != ब_पं) {
        फेको "त्रुटिः आव्यूह गुणन हेतु विमा असंगत (A columns != B rows)";
    }
    
    शब्दकोश फल = दिशक_शून्य([अ_पं, ब_स्तं]);
    
    // i-k-j लूप क्रम (उच्च गति कैश-अनुकूल)
    संख्या इ = ०;
    यावत् (इ < अ_पं) {
        संख्या क = ०;
        यावत् (क < अ_स्तं) {
            दशमलव अ_मूल्य = दिशक_पाओ(अ, [इ, क]);
            संख्या ज = ०;
            यावत् (ज < ब_स्तं) {
                दशमलव वर्तमान = दिशक_पाओ(फल, [इ, ज]);
                दशमलव ब_मूल्य = दिशक_पाओ(ब, [क, ज]);
                दिशक_सेट(फल, [इ, ज], वर्तमान + (अ_मूल्य * ब_मूल्य));
                ज = ज + १;
            }
            क = क + १;
        }
        इ = इ + १;
    }
    परत् फल;
}
