    }
    शब्दकोश फल = {};
    फल["आकार"] = अ["आकार"];
    फल["आयाम"] = अ["आयाम"];
    फल["कुल_तत्व"] = कुल;
    फल["डग"] = अ["डग"];
    फल["डेटा"] = नया_डेटा;
    परत् फल;
}

कार्य दिशक_हडामार्ड_गुणन(शब्दकोश अ, शब्दकोश ब) {
    संख्या कुल = अ["कुल_तत्व"];
    यदि (कुल != ब["कुल_तत्व"]) {
        फेको "त्रुटिः तत्वशः गुणन हेतु आकार समान होना चाहिए";
