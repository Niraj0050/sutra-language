//
// १. सदिश (Vector) संक्रियाएं:
//    शब्दकोश स = सदिश_से_सूची([1.0, 2.0, 3.0]);
//    दशमलव डॉट = सदिश_बिंदु_गुणन(स१, स२);
//    दशमलव नॉर्म = सदिश_मानदण्ड(स);
//
// २. बहु-आयामी दिशक (Multidimensional Tensor):
//    शब्दकोश त = दिशक_शून्य([२, ३, ४]);
//    दिशक_सेट(त, [१, २, ३], ५.५);
//    दशमलव मान = दिशक_पाओ(त, [१, २, ३]);
//    शब्दकोश पुन = दिशक_पुनराकार(त, [६, ४]);
//    शब्दकोश गुणन = दिशक_मैटमुल_२डी(त१, त२);
