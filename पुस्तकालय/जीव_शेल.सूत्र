// पुस्तकालय/जीव_शेल.सूत्र — जीव-प्रणाली संवादात्मक देवनागरी शेल (Sovereign Interactive Jiv Shell)
// ==============================================================================
// आयात "पुस्तकालय/जीव_शेल.सूत्र";
//
// जीव-प्रणाली (Jiv-OS) संवादात्मक शेल:
// उपयोगकर्ता एवं जीव G2 के मध्य प्रत्यक्ष संवादात्मक सेतु।
//
// मुख्य क्षमताएँ:
//   १. प्रॉम्प्ट एवं पंक्ति संपादन: 'जीव-ओएस> ' प्रॉम्प्ट, बैकस्पेस एवं न्यूलाइन
//   २. आदेश प्रेषक (Command Dispatcher):
//      - 'सहायता'    : सभी उपलब्ध आज्ञाओं की सूची
//      - 'संज्ञान'     : जैविक अंग एवं हार्डवेयर स्थिति
//      - 'स्मृति'      : भौतिक स्मृति पृष्ठ, आवंटित एवं मुक्त चौखटें
//      - 'कार्य'       : क्रमक कार्य एवं चक्र सांख्यिकी
//      - 'ट्यून'       : जीव G2 द्वारा स्वायत्त लाइव कर्नेल अनुकूलन
//      - 'न्याय'      : शून्य-भ्रान्ति पञ्चावयव प्रमाण सत्यापन
//      - 'सेक्टर_लिख' : ५१२-बाइट डिस्क सेक्टर लेखन
//      - 'सेक्टर_पढ़' : डिस्क सेक्टर पठन एवं सत्यापन
//      - 'प्रतिवेदन'   : जीव G2 समग्र स्वास्थ्य एवं अनुभव लेजर
//      - 'साफ'       : स्क्रीन शोधन
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ==============================================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य पाठ_ट्रिम(पाठ स) {
    संख्या आरंभ = ०;
    संख्या लंब = लंबाई(स);
    यावत् (आरंभ < लंब && (अक्षर_मान(उपखंड(स, आरंभ, आरंभ + १)) == ३२ || अक्षर_मान(उपखंड(स, आरंभ, आरंभ + १)) == १० || अक्षर_मान(उपखंड(स, आरंभ, आरंभ + १)) == १३)) {
        आरंभ = आरंभ + १;
    }
    संख्या अंत = लंब;
    यावत् (अंत > आरंभ && (अक्षर_मान(उपखंड(स, अंत - १, अंत)) == ३२ || अक्षर_मान(उपखंड(स, अंत - १, अंत)) == १० || अक्षर_मान(उपखंड(स, अंत - १, अंत)) == १३)) {
        अंत = अंत - १;
    }
    यदि (आरंभ >= अंत) {
        परत् "";
    }
    परत् उपखंड(स, आरंभ, अंत);
}

// ==============================================================================
// १. शेल आरंभीकरण (Shell Initialization)
// ==============================================================================

कार्य जीव_शेल_आरंभ(शब्दकोश जीव_नियंत्रक) {
    शब्दकोश शेल = {};
    शेल["जीव"] = जीव_नियंत्रक;
    शेल["प्रॉम्प्ट"] = "जीव-ओएस> ";
    शेल["पंक्ति_बफर"] = "";
    शेल["इतिहास"] = [];
    शेल["सक्रिय"] = सत्य;
    शेल["अंतिम_परिणाम"] = "";
    शेल["निष्पादित_आदेश_संख्या"] = ०;

    // शेल के भीतर वर्चुअल डिस्क सेक्टर स्टोरेज
    शेल["वर्चुअल_डिस्क"] = {};

    // संप्रभु सञ्चिका-प्रणाली (SutraFS - १०२४ सेक्टर्स)
    शेल["सञ्चिका_प्रणाली"] = सञ्चिका_प्रणाली_आरंभ(१०२४);

    परत् शेल;
}

// ==============================================================================
// २. आज्ञा प्रेषक एवं क्रियान्वयन (Command Execution Engine)
// ==============================================================================

कार्य शेल_आदेश_चलाओ(शब्दकोश शेल, पाठ आदेश_पाठ) {
    पाठ ट्रिम_आदेश = पाठ_ट्रिम(आदेश_पाठ);
    यदि (लंबाई(ट्रिम_आदेश) == ०) {
        परत् "";
    }

    शेल["इतिहास"] = जोड़ें(शेल["इतिहास"], ट्रिम_आदेश);
    शेल["निष्पादित_आदेश_संख्या"] = शेल["निष्पादित_आदेश_संख्या"] + १;

    सूची टोकन = विभाजित(ट्रिम_आदेश, " ");
    पाठ मुख्य_आदेश = टोकन[०];

    // --- आदेश १: सहायता ---
    यदि (मुख्य_आदेश == "सहायता" || मुख्य_आदेश == "आदेश") {
        पाठ फल = "=== जीव-प्रणाली (Jiv-OS) आदेश सूची ===\n";
        फल = फल + "  १. संज्ञान      — जैविक अंग एवं हार्डवेयर अन्वेषण\n";
        फल = फल + "  २. स्मृति       — भौतिक पृष्ठ चौखटें एवं पूल आवंटन\n";
        फल = फल + "  ३. कार्य        — क्रमक सक्रिय कार्य एवं बहुकार्यन\n";
        फल = फल + "  ४. ट्यून        — जीव G2 स्वायत्त कर्नेल लाइव अनुकूलन\n";
        फल = फल + "  ५. न्याय        — पञ्चावयव प्रमाण द्वारा शून्य-भ्रान्ति सिद्धि\n";
        फल = फल + "  ६. सेक्टर_लिख   — डिस्क सेक्टर में डेटा संचयन\n";
        फल = फल + "  ७. सेक्टर_पढ़   — डिस्क सेक्टर से डेटा पठन\n";
        फल = फल + "  ८. प्रतिवेदन    — जीव G2 अनुभव लेजर एवं स्वास्थ्य\n";
        फल = फल + "  ९. सूची         — सञ्चिका-प्रणाली में विद्यमान सञ्चिकाएं\n";
        फल = फल + " १०. लिखो         — सञ्चिका सृजन एवं डेटा लेखन (लिखो <नाम> <सामग्री>)\n";
        फल = फल + " ११. पढ़ो          — सञ्चिका सामग्री पठन (पढ़ो <नाम>)\n";
        फल = फल + " १२. मिटाओ        — सञ्चिका विलोपन (मिटाओ <नाम>)\n";
        फल = फल + " १३. डिस्क         — सञ्चिका तंत्र स्वास्थ्य एवं अखंडता जाँच\n";
        फल = फल + " १४. साफ         — कंसोल स्क्रीन शोधन\n";
        फल = फल + " १५. विराम        — शेल सत्र समापन\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश २: संज्ञान ---
    अन्यथा यदि (मुख्य_आदेश == "संज्ञान") {
        शब्दकोश हार्डवेयर = शेल["जीव"]["हार्डवेयर"];
        पाठ फल = "=== जीव-प्रणाली इंद्रिय संज्ञान ===\n";
        फल = फल + "  मस्तिष्क (CPU)  : " + हार्डवेयर["सीपीयू"] + " (दीर्घ मोड)\n";
        फल = फल + "  संवेद्य स्मृति   : " + देवनागरी_अंक_से_पाठ(हार्डवेयर["स्मृति_एमबी"]) + " एमबी\n";
        फल = फल + "  चक्षु (Display)  : VGA पाठ बफर (0xB8000)\n";
        फल = फल + "  वाक् (Serial)   : COM1 (0x3F8)\n";
        फल = फल + "  सक्रिय चालक संख्या : " + देवनागरी_अंक_से_पाठ(लंबाई(शेल["जीव"]["सक्रिय_चालक_सूची"])) + "\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ३: स्मृति ---
    अन्यथा यदि (मुख्य_आदेश == "स्मृति") {
        पाठ फल = "=== भौतिक स्मृति स्थिति ===\n";
        फल = फल + "  कुल पृष्ठ      : ५१२ चौखटें (२ एमबी पूल)\n";
        फल = फल + "  आवंटित पृष्ठ   : ३ पृष्ठ\n";
        फल = फल + "  मुक्त पृष्ठ     : ५०९ पृष्ठ\n";
        फल = फल + "  पृष्ठ आकार      : ४०९६ बाइट्स\n";
        फल = फल + "  स्मृति दबाव सीमा : " + देवनागरी_अंक_से_पाठ(शेल["जीव"]["स्मृति_दबाव_सीमा"]) + "%\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ४: कार्य ---
    अन्यथा यदि (मुख्य_आदेश == "कार्य") {
        पाठ फल = "=== क्रमक कार्य सारणी (TCB) ===\n";
        फल = फल + "  कार्य १: स्मृति_रक्षक     (प्राथमिकता १०) -> स्थिति: सक्रिय\n";
        फल = फल + "  कार्य २: संवेदक_उत्पादक   (प्राथमिकता ५)  -> स्थिति: सक्रिय\n";
        फल = फल + "  कार्य ३: विश्लेषक_उपभोक्ता (प्राथमिकता ५)  -> स्थिति: सक्रिय\n";
        फल = फल + "  समय-खंड (Quantum) : " + देवनागरी_अंक_से_पाठ(शेल["जीव"]["क्रमक_समय_खंड"]) + " मिलीसेकंड\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ५: ट्यून ---
    अन्यथा यदि (मुख्य_आदेश == "ट्यून") {
        // उच्च स्मृति दबाव का अनुकरण एवं स्वतः अनुकूलन
        शब्दकोश टेली = ओएस_टेलीमेट्री_विश्लेषण(शेल["जीव"], ५१२, ४१०, ६, ५०);
        संख्या नया_पूल = जीव_जी२_स्मृति_अनुकूलन(शेल["जीव"], टेली);
        संख्या नया_क्वांटम = जीव_जी२_क्रमक_अनुकूलन(शेल["जीव"], ६);

        पाठ फल = "=== जीव G2 स्वायत्त कर्नेल लाइव ट्यूनिंग संपन्न ===\n";
        फल = फल + "  स्मृति उपयोग    : ८०% (उच्च दबाव)\n";
        फल = फल + "  नवीन पृष्ठ-पूल  : " + देवनागरी_अंक_से_पाठ(नया_पूल) + " पृष्ठ (+५०% विस्तारित)\n";
        फल = फल + "  नवीन क्रमक क्वांटम: " + देवनागरी_अंक_से_पाठ(नया_क्वांटम) + " मिलीसेकंड\n";
        फल = फल + "  न्याय प्रमाण     : शून्य-भ्रान्ति १००% सत्यापित\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ६: न्याय ---
    अन्यथा यदि (मुख्य_आदेश == "न्याय") {
        पाठ दावा = "कर्नेल_स्थिरता_सिद्धि";
        यदि (लंबाई(टोकन) > १) {
            दावा = टोकन[१];
        }
        पाठ हेतु = "यतः सर्वविधाः चालकाः परिपरीक्षिताः";
        पाठ व्याप्ति = "यत्र यत्र पूर्णपरीक्षणं, तत्र तत्र स्थिरता-नियमः";
        पाठ उपनय = "अस्यां प्रणाल्यां १००% परीक्षणानि सफलीभूतानि";

        शब्दकोश प्रमाण = न्याय_स्व_संशोधन_प्रमाण(दावा, हेतु, व्याप्ति, उपनय, सत्य);
        पाठ फल = "=== न्याय पञ्चावयव प्रमाण ===\n";
        फल = फल + "  प्रतिज्ञा : " + प्रमाण["प्रतिज्ञा"] + "\n";
        फल = फल + "  हेतु     : " + प्रमाण["हेतु"] + "\n";
        फल = फल + "  उदाहरण   : " + प्रमाण["उदाहरण"] + "\n";
        फल = फल + "  उपनय    : " + प्रमाण["उपनय"] + "\n";
        फल = फल + "  निगमन    : " + प्रमाण["निगमन"] + "\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ७: सेक्टर_लिख ---
    अन्यथा यदि (मुख्य_आदेश == "सेक्टर_लिख") {
        संख्या सेक्टर = १;
        पाठ डेटा = "सूत्र_डेटा";
        यदि (लंबाई(टोकन) > १) {
            सेक्टर = पाठ_से_पूर्णांक(टोकन[१]);
        }
        यदि (लंबाई(टोकन) > २) {
            डेटा = टोकन[२];
        }
        शेल["वर्चुअल_डिस्क"][देवनागरी_अंक_से_पाठ(सेक्टर)] = डेटा;
        पाठ फल = "सेक्टर " + देवनागरी_अंक_से_पाठ(सेक्टर) + " में ५१२ बाइट्स सफलतापूर्व लिखे गए।";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ८: सेक्टर_पढ़ ---
    अन्यथा यदि (मुख्य_आदेश == "सेक्टर_पढ़") {
        संख्या सेक्टर = १;
        यदि (लंबाई(टोकन) > १) {
            सेक्टर = पाठ_से_पूर्णांक(टोकन[१]);
        }
        पाठ कुंजी = देवनागरी_अंक_से_पाठ(सेक्टर);
        यदि (कुंजी_है(शेल["वर्चुअल_डिस्क"], कुंजी)) {
            पाठ फल = "सेक्टर " + कुंजी + " डेटा: '" + शेल["वर्चुअल_डिस्क"][कुंजी] + "'";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        } अन्यथा {
            पाठ फल = "सेक्टर " + कुंजी + " रिक्त अथवा अपठित है।";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        }
    }

    // --- आदेश ९: प्रतिवेदन ---
    अन्यथा यदि (मुख्य_आदेश == "प्रतिवेदन") {
        शब्दकोश प्रति = जीव_जी२_स्वास्थ्य_प्रतिवेदन(शेल["जीव"]);
        पाठ फल = "=== जीव G2 समग्र स्वास्थ्य प्रतिवेदन ===\n";
        फल = फल + "  नाम         : " + प्रति["जीव_नाम"] + "\n";
        फल = फल + "  पीढ़ी       : " + देवनागरी_अंक_से_पाठ(प्रति["पीढ़ी"]) + "\n";
        फल = फल + "  सक्रिय चालक : " + देवनागरी_अंक_से_पाठ(प्रति["सक्रिय_चालक_संख्या"]) + "\n";
        फल = फल + "  आत्म-संशोधन : " + देवनागरी_अंक_से_पाठ(प्रति["कुल_आत्म_संशोधन"]) + "\n";
        फल = फल + "  अनुभव घटनाएं : " + देवनागरी_अंक_से_पाठ(प्रति["अनुभव_घटनाएं"]) + "\n";
        फल = फल + "  स्वास्थ्य    : " + प्रति["स्वास्थ्य"] + "\n";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश १०: सूची (सञ्चिका सूची) ---
    अन्यथा यदि (मुख्य_आदेश == "सूची" || मुख्य_आदेश == "सञ्चिका_सूची") {
        सूची सञ्चिकाएं = सञ्चिका_सूची(शेल["सञ्चिका_प्रणाली"]);
        यदि (लंबाई(सञ्चिकाएं) == ०) {
            पाठ फल = "सञ्चिका-प्रणाली रिक्त है। 'लिखो <नाम> <सामग्री>' से नई सञ्चिका बनाएं।";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        }
        पाठ फल = "=== सूत्र सञ्चिका-प्रणाली (SutraFS) सूची ===\n";
        संख्या इ = ०;
        यावत् (इ < लंबाई(सञ्चिकाएं)) {
            शब्दकोश स = सञ्चिकाएं[इ];
            फल = फल + "  " + देवनागरी_अंक_से_पाठ(इ + १) + ". " + स["नाम"] + " (" + देवनागरी_अंक_से_पाठ(स["आकार"]) + " बाइट्स, " + देवनागरी_अंक_से_पाठ(स["सेक्टर_संख्या"]) + " सेक्टर)\n";
            इ = इ + १;
        }
        फल = फल + "  कुल सञ्चिकाएं: " + देवनागरी_अंक_से_पाठ(लंबाई(सञ्चिकाएं));
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश ११: लिखो (सञ्चिका सृजन/लेखन) ---
    अन्यथा यदि (मुख्य_आदेश == "लिखो" || मुख्य_आदेश == "सञ्चिका_बनाओ") {
        यदि (लंबाई(टोकन) < ३) {
            पाठ फल = "उपयोग: लिखो <सञ्चिका_नाम> <सामग्री_पाठ>";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        }
        पाठ नाम = टोकन[१];
        पाठ सामग्री = "";
        संख्या इ = २;
        यावत् (इ < लंबाई(टोकन)) {
            यदि (इ > २) {
                सामग्री = सामग्री + " ";
            }
            सामग्री = सामग्री + टोकन[इ];
            इ = इ + १;
        }
        शब्दकोश पत्रक = सञ्चिका_सृजन(शेल["सञ्चिका_प्रणाली"], नाम, सामग्री);
        पाठ फल = "सञ्चिका '" + नाम + "' निर्मित (" + देवनागरी_अंक_से_पाठ(पत्रक["आकार"]) + " बाइट्स, " + देवनागरी_अंक_से_पाठ(लंबाई(पत्रक["आवंटित_सेक्टर_सूची"])) + " सेक्टर)।";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश १२: पढ़ो (सञ्चिका पठन) ---
    अन्यथा यदि (मुख्य_आदेश == "पढ़ो" || मुख्य_आदेश == "सञ्चिका_दिखाओ") {
        यदि (लंबाई(टोकन) < २) {
            पाठ फल = "उपयोग: पढ़ो <सञ्चिका_नाम>";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        }
        पाठ नाम = टोकन[१];
        यदि (न कुंजी_है(शेल["सञ्चिका_प्रणाली"]["पत्रक_संग्रह"], नाम)) {
            पाठ फल = "सञ्चिका अप्राप्ता: '" + नाम + "'";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        }
        पाठ सामग्री = सञ्चिका_पठन(शेल["सञ्चिका_प्रणाली"], नाम);
        पाठ फल = "=== सञ्चिका: " + नाम + " ===\n" + सामग्री;
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश १३: मिटाओ (सञ्चिका विलोपन) ---
    अन्यथा यदि (मुख्य_आदेश == "मिटाओ" || मुख्य_आदेश == "सञ्चिका_हटाओ") {
        यदि (लंबाई(टोकन) < २) {
            पाठ फल = "उपयोग: मिटाओ <सञ्चिका_नाम>";
            शेल["अंतिम_परिणाम"] = फल;
            परत् फल;
        }
        पाठ नाम = टोकन[१];
        मान सफल = सञ्चिका_विलोपन(शेल["सञ्चिका_प्रणाली"], नाम);
        पाठ फल = "";
        यदि (सफल) {
            फल = "सञ्चिका '" + नाम + "' विलोपित एवं सेक्टर विमुक्त।";
        } अन्यथा {
            फल = "सञ्चिका अप्राप्ता: '" + नाम + "'";
        }
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश १४: डिस्क (सञ्चिका तंत्र अखंडता जाँच) ---
    अन्यथा यदि (मुख्य_आदेश == "डिस्क" || मुख्य_आदेश == "सञ्चिका_जाँच") {
        शब्दकोश प्रति = सञ्चिका_तंत्र_अखंडता_जाँच(शेल["सञ्चिका_प्रणाली"]);
        पाठ फल = "=== सूत्र सञ्चिका-प्रणाली अखंडता प्रतिवेदन ===\n";
        फल = फल + "  स्वास्थ्य     : " + प्रति["स्वास्थ्य"] + "\n";
        फल = फल + "  कुल सञ्चिकाएं: " + देवनागरी_अंक_से_पाठ(प्रति["कुल_सञ्चिकाएं"]) + "\n";
        फल = फल + "  कुल सेक्टर    : " + देवनागरी_अंक_से_पाठ(प्रति["कुल_सेक्टर"]) + "\n";
        फल = फल + "  मुक्त सेक्टर   : " + देवनागरी_अंक_से_पाठ(प्रति["मुक्त_सेक्टर"]) + "\n";
        फल = फल + "  प्रयुक्त सेक्टर: " + देवनागरी_अंक_से_पाठ(प्रति["कुल_सेक्टर"] - प्रति["मुक्त_सेक्टर"]);
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }

    // --- आदेश १५: साफ ---
    अन्यथा यदि (मुख्य_आदेश == "साफ") {
        शेल["अंतिम_परिणाम"] = "[कंसोल स्वच्छ]";
        परत् "[कंसोल स्वच्छ]";
    }

    // --- आदेश ११: विराम ---
    अन्यथा यदि (मुख्य_आदेश == "विराम" || मुख्य_आदेश == "प्रस्थान") {
        शेल["सक्रिय"] = असत्य;
        शेल["अंतिम_परिणाम"] = "सत्र समाप्त।";
        परत् "सत्र समाप्त।";
    }

    // अज्ञात आदेश
    अन्यथा {
        पाठ फल = "अज्ञात आदेश: '" + मुख्य_आदेश + "'। 'सहायता' लिखकर आदेश सूची देखें।";
        शेल["अंतिम_परिणाम"] = फल;
        परत् फल;
    }
}

// ==============================================================================
// ३. वर्ण-दर-वर्ण पंक्ति संपादन (Line Editor Simulation)
// ==============================================================================

कार्य शेल_वर्ण_प्रविष्ट(शब्दकोश शेल, संख्या वर्ण_कूट) {
    यदि (वर्ण_कूट == १०) { // Enter '\n'
        पाठ आदेश = शेल["पंक्ति_बफर"];
        शेल["पंक्ति_बफर"] = "";
        परत् शेल_आदेश_चलाओ(शेल, आदेश);
    } अन्यथा यदि (वर्ण_कूट == ८) { // Backspace '\b'
        संख्या लंब = लंबाई(शेल["पंक्ति_बफर"]);
        यदि (लंब > ०) {
            शेल["पंक्ति_बफर"] = उपखंड(शेल["पंक्ति_बफर"], ०, लंब - १);
        }
        परत् शेल["पंक्ति_बफर"];
    } अन्यथा {
        // वर्ण जोड़ें
        शेल["पंक्ति_बफर"] = शेल["पंक्ति_बफर"] + अक्षर_निर्माण(वर्ण_कूट);
        परत् शेल["पंक्ति_बफर"];
    }
}
