// पुस्तकालय/सत्यापन.सूत्र — इनपुट सत्यापन (validation)
// ============================================================
// आयात "पुस्तकालय/सत्यापन.सूत्र";
//
//   सत्यापन_आवश्यक("")                    // असत्य
//   सत्यापन_ईमेल_है("ram@example.com")     // सत्य
//   सत्यापन_भारतीय_फोन_है("+919876543210") // सत्य
//   सत्यापन_लंबाई_सीमा("पासवर्ड", ८, ६४)    // बूल
//
//   शब्दकोश फल = सत्यापन_परिणाम_बनाओ();
//   यदि (न सत्यापन_आवश्यक(नाम)) { सत्यापन_त्रुटि_जोड़ो(फल, "नाम", "आवश्यक है"); }
//   फल["वैध"]                              // सत्य/असत्य — कोई भी त्रुटि जुड़ी?
//   फल["त्रुटियाँ"]                        // सूची of {"फ़ील्ड","संदेश"}
//
// पैटर्न-आधारित जाँच (ईमेल/फोन/संख्यात्मक/पैटर्न_मेल) व्यंजक.सूत्र के
// `व्यंजक_पूर्ण_मिलान` (re.fullmatch जैसा — कोई ^/$ ज़रूरी नहीं) पर बनी।
//
// ⚠️ ईमेल-जाँच RFC 5322 का पूरा सटीक व्याकरण नहीं (वह बेहद जटिल है, कोई
// भी वास्तविक-दुनिया लाइब्रेरी शायद ही पूरा लागू करती) — व्यावहारिक
// उप-सेट: "कुछ@कुछ.कुछ", कोई खाली-जगह/दोहरा @ नहीं। ⚠️ फोन-जाँच सिर्फ़
// भारतीय मोबाइल-क्रमांक प्रारूप (१० अंक, 6-9 से शुरू, वैकल्पिक +91/91/0
// उपसर्ग) — अंतरराष्ट्रीय प्रारूपों के लिए नहीं है (यह इस पुस्तकालय की
// जानबूझकर v1 सीमा है, libphonenumber जैसे विश्व-व्यापी समाधान का
// विकल्प नहीं)।
// ============================================================

आयात "पुस्तकालय/व्यंजक.सूत्र";
आयात "पुस्तकालय/यूआरएल.सूत्र";

// ===== मूल जाँच =====

// मूल्य रिक्त नहीं है (शून्यम् भी रिक्त गिना जाता)
कार्य सत्यापन_आवश्यक(पाठ मूल्य) {
    यदि (मूल्य == शून्यम्) { परत् असत्य; }
    परत् लंबाई(मूल्य) > ०;
}

// मूल्य की लंबाई [न्यून, अधिक] के भीतर है (दोनों सम्मिलित)
कार्य सत्यापन_लंबाई_सीमा(पाठ मूल्य, संख्या न्यून, संख्या अधिक) {
    संख्या ल = लंबाई(मूल्य);
    परत् ल >= न्यून && ल <= अधिक;
}

// संख्या-मूल्य [न्यून, अधिक] के भीतर है (दोनों सम्मिलित)
कार्य सत्यापन_संख्या_सीमा(संख्या मूल्य, संख्या न्यून, संख्या अधिक) {
    परत् मूल्य >= न्यून && मूल्य <= अधिक;
}

// पाठ पूर्णांक-संख्यात्मक है (वैकल्पिक अगुआ '-', बाकी सिर्फ़ ०-९)
कार्य सत्यापन_संख्यात्मक_है(पाठ मूल्य) {
    यदि (मूल्य == शून्यम् || लंबाई(मूल्य) == ०) { परत् असत्य; }
    परत् व्यंजक_पूर्ण_मिलान("-?\\d+", मूल्य);
}

// किसी मनचाहे व्यंजक-पैटर्न से पूरा मिलान (सामान्य escape-hatch)
कार्य सत्यापन_पैटर्न_मेल(पाठ मूल्य, पाठ पैटर्न) {
    यदि (मूल्य == शून्यम्) { परत् असत्य; }
    परत् व्यंजक_पूर्ण_मिलान(पैटर्न, मूल्य);
}

// ===== विशिष्ट प्रारूप =====

// व्यावहारिक ईमेल-प्रारूप (RFC 5322 का पूरा व्याकरण नहीं — ऊपर देखो)
// ⚠ जानबूझकर regex नहीं, सीधा वर्ण-दर-वर्ण जाँच — व्यंजक-आधारित पहला
// प्रयास (`[^@\s]+@[^@\s]+`) बहु-बिंदु डोमेन जैसे इनपुट
// ("ram.sharma@mail.example.co.in") पर व्यंजक इंजन में एक वास्तविक
// स्टैक-ओवरफ़्लो क्रैश का कारण बना — नीचे भाषा-सीमा में दर्ज, अलग से
// जाँचा जाएगा। यह हाथ-रोल्ड जाँच पूरी तरह से बचती है, यूआरएल.सूत्र के
// अपने पार्सर जैसी ही शैली में।
कार्य सत्यापन_ईमेल_है(पाठ मूल्य) {
    यदि (मूल्य == शून्यम् || लंबाई(मूल्य) == ०) { परत् असत्य; }
    संख्या ऐट_गिनती = ०;
    संख्या ऐट_सू = -१;
    संख्या इ = ०;
    यावत् (इ < लंबाई(मूल्य)) {
        पाठ च = उपखंड(मूल्य, इ, इ + १);
        यदि (च == "@") {
            ऐट_गिनती = ऐट_गिनती + १;
            ऐट_सू = इ;
        } अन्यथा यदि (च == " ") {
            परत् असत्य;
        }
        इ = इ + १;
    }
    यदि (ऐट_गिनती != १) { परत् असत्य; }
    यदि (ऐट_सू == ० || ऐट_सू == लंबाई(मूल्य) - १) { परत् असत्य; }
    पाठ डोमेन = उपखंड(मूल्य, ऐट_सू + १, लंबाई(मूल्य));
    परत् खोजें(डोमेन, ".") >= ०;
}

// भारतीय मोबाइल-क्रमांक (१० अंक, 6-9 से शुरू, वैकल्पिक +91/91/0 उपसर्ग)
कार्य सत्यापन_भारतीय_फोन_है(पाठ मूल्य) {
    यदि (मूल्य == शून्यम् || लंबाई(मूल्य) == ०) { परत् असत्य; }
    परत् व्यंजक_पूर्ण_मिलान("(\\+91|91|0)?[6-9]\\d{9}", मूल्य);
}

// यूआरएल.सूत्र के व्यावहारिक (v1-सीमित) रूप से पार्स हो सकने वाला URL है
// — जो भी यूआरएल_पार्स स्वीकारता, वही यहाँ मान्य गिना जाता
कार्य सत्यापन_यूआरएल_है(पाठ मूल्य) {
    यदि (मूल्य == शून्यम् || लंबाई(मूल्य) == ०) { परत् असत्य; }
    प्रयत्न {
        शब्दकोश भाग = यूआरएल_पार्स(मूल्य);
        परत् भाग["मेज़बान"] != शून्यम् && लंबाई(भाग["मेज़बान"]) > ०;
    } पकड़ो (त्रु) {
        परत् असत्य;
    }
}

// ===== बहु-फ़ील्ड परिणाम संचयन =====

// खाली सत्यापन-परिणाम — {"वैध":सत्य, "त्रुटियाँ":[]}
कार्य सत्यापन_परिणाम_बनाओ() {
    शब्दकोश फल = {};
    फल["वैध"] = सत्य;
    फल["त्रुटियाँ"] = [];
    परत् फल;
}

// परिणाम में एक त्रुटि जोड़ो (फ़ील्ड-नाम + संदेश) — वैध को असत्य कर देता
कार्य सत्यापन_त्रुटि_जोड़ो(शब्दकोश परिणाम, पाठ फ़ील्ड, पाठ संदेश) {
    परिणाम["वैध"] = असत्य;
    शब्दकोश त्रुटि = {};
    त्रुटि["फ़ील्ड"] = फ़ील्ड;
    त्रुटि["संदेश"] = संदेश;
    परिणाम["त्रुटियाँ"] = जोड़ें(परिणाम["त्रुटियाँ"], त्रुटि);
    परत् ०;
}
