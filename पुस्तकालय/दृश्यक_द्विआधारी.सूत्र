// पुस्तकालय/दृश्यक_द्विआधारी.सूत्र — दृश्यक शून्य-जेसन द्विआधारी संजाल प्रोटोकॉल (Micro-Binary Wire Protocol)
// ============================================================
// आयात "पुस्तकालय/दृश्यक_द्विआधारी.सूत्र";
//
// पारम्परिक वेब में भारी JSON स्ट्रिंग्स और DOM serialization भारी CPU/स्मृति खाती हैं।
// दृश्यक_द्विआधारी प्रोटोकॉल शून्य-JSON प्रत्यक्ष बाइट प्रवाह (Zero-JSON Binary Wire Stream)
// प्रदान करता है, जो 120 FPS पर बिना किसी स्ट्रिंग पार्सिंग ओवरहेड के
// सीधे स्क्रीन/कैनवास ब्लिटर को बाइट्स भेजता है।
//
// बाइट विनिर्देश (Binary Protocol Specification):
// १. शीर्षलेख (Header - ८ बाइट्स):
//    [०..३] : 'SUTR' (८३, ८५, ८४, ८२)
//    [४..५] : संस्करण (०, १)
//    [६..७] : आदेश संख्या (Uint16)
// २. आदेश पेलोड (Commands Payload):
//    - संकेत १ (0x01): ३डी जाल (3D Mesh Wireframe)
//    - संकेत २ (0x02): २डी डिब्बा (2D Box)
//    - संकेत ३ (0x03): २डी लेख (2D Text)
//    - संकेत ४ (0x04): २डी बटन (2D Interactive Button)
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";

// ============================================================
// १. बाइट एवं संख्या रूपांतरण सहायक फलन (Byte Packing Utilities)
// ============================================================

// १६-बिट पूर्णांक को २ बाइट्स में पैक करना (Big-Endian)
कार्य द्विआधारी_१६बिट_पैक(संख्या मूल्य) {
    संख्या परिमाण = मूल्य;
    यदि (परिमाण < ०) {
        परिमाण = ६५५३६ + परिमाण; // २'s complement
    }
    संख्या उच्च_बाइट = दक्षिण_सरक(परिमाण, ८);
    संख्या निम्न_बाइट = बिट_और(परिमाण, २५५);
    परत् [उच्च_बाइट, निम्न_बाइट];
}

// २ बाइट्स से १६-बिट पूर्णांक अनपैक करना
कार्य द्विआधारी_१६बिट_अनपैक(सूची बाइट्स, संख्या सूचकांक) {
    संख्या उच्च = बाइट्स[सूचकांक];
    संख्या निम्न = बाइट्स[सूचकांक + १];
    संख्या संयुक्त = (उच्च * २५६) + निम्न;
    यदि (संयुक्त >= ३२७६८) {
        संयुक्त = संयुक्त - ६५५३६;
    }
    परत् संयुक्त;
}

// पाठ को बाइट सूची में बदलना (१६-बिट यूनीकोड सुरक्षित)
कार्य द्विआधारी_पाठ_पैक(पाठ स्रोत) {
    सूची फल = [];
    संख्या लं = लंबाई(स्रोत);
    सूची लं_पैक = द्विआधारी_१६बिट_पैक(लं);
    फल = जोड़ें(फल, लं_पैक[०]);
    फल = जोड़ें(फल, लं_पैक[१]);
    संख्या इ = ०;
    यावत् (इ < लं) {
        संख्या कोड = अक्षर_मान(उपखंड(स्रोत, इ, इ + १));
        सूची कोड_ब = द्विआधारी_१६बिट_पैक(कोड);
        फल = जोड़ें(फल, कोड_ब[०]);
        फल = जोड़ें(फल, कोड_ब[१]);
        इ = इ + १;
    }
    परत् फल;
}

// बाइट सूची से पाठ पुनर्निर्माण
कार्य द्विआधारी_पाठ_अनपैक(सूची बाइट्स, संख्या सूचकांक) {
    संख्या लं = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
    पाठ परिणाम = "";
    संख्या इ = ०;
    यावत् (इ < लं) {
        संख्या कोड = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २ + (इ * २));
        परिणाम = परिणाम + अक्षर_निर्माण(कोड);
        इ = इ + १;
    }
    शब्दकोश उत्तर = {};
    उत्तर["पाठ"] = परिणाम;
    उत्तर["खपत_बाइट्स"] = २ + (लं * २);
    परत् उत्तर;
}

// ============================================================
// २. द्विआधारी चौखटा एन्कोडिंग (Binary Frame Serialization)
// ============================================================

कार्य दृश्यक_द्विआधारी_एन्कोड(सूची आदेश_सूची) {
    सूची बाइट्स = [];

    // शीर्षलेख: 'SUTR' (८३, ८५, ८४, ८२)
    बाइट्स = जोड़ें(बाइट्स, ८३);
    बाइट्स = जोड़ें(बाइट्स, ८५);
    बाइट्स = जोड़ें(बाइट्स, ८४);
    बाइट्स = जोड़ें(बाइट्स, ८२);

    // संस्करण: १ (२ बाइट्स)
    बाइट्स = जोड़ें(बाइट्स, ०);
    बाइट्स = जोड़ें(बाइट्स, १);

    // कुल आदेश
    संख्या कुल = लंबाई(आदेश_सूची);
    सूची आदेश_बाइट्स = द्विआधारी_१६बिट_पैक(कुल);
    बाइट्स = जोड़ें(बाइट्स, आदेश_बाइट्स[०]);
    बाइट्स = जोड़ें(बाइट्स, आदेश_बाइट्स[१]);

    // आदेशों का क्रमिक संकुचन
    संख्या इ = ०;
    यावत् (इ < कुल) {
        शब्दकोश आदेश = आदेश_सूची[इ];
        पाठ प्रकार = आदेश["प्रकार"];

        यदि (प्रकार == "३डी_जाल") {
            // संकेत १: ३डी जाल
            बाइट्स = जोड़ें(बाइट्स, १);

            // नाम
            सूची नाम_पैक = द्विआधारी_पाठ_पैक(आदेश["नाम"]);
            संख्या नि = ०;
            यावत् (नि < लंबाई(नाम_पैक)) {
                बाइट्स = जोड़ें(बाइट्स, नाम_पैक[नि]);
                नि = नि + १;
            }

            // रंग
            पाठ रंग_पाठ = आदेश["रंग"];
            यदि (रंग_पाठ == "") { रंग_पाठ = "#00ffcc"; }
            सूची रंग_पैक = द्विआधारी_पाठ_पैक(रंग_पाठ);
            संख्या रि = ०;
            यावत् (रि < लंबाई(रंग_पैक)) {
                बाइट्स = जोड़ें(बाइट्स, रंग_पैक[रि]);
                रि = रि + १;
            }

            // शीर्ष संख्या एवं निर्देशांक
            सूची शीर्ष_सूची = आदेश["प्रक्षेपित_शीर्ष"];
            संख्या शी_कुल = लंबाई(शीर्ष_सूची);
            सूची शी_बाइट्स = द्विआधारी_१६बिट_पैक(शी_कुल);
            बाइट्स = जोड़ें(बाइट्स, शी_बाइट्स[०]);
            बाइट्स = जोड़ें(बाइट्स, शी_बाइट्स[१]);

            संख्या शी_इ = ०;
            यावत् (शी_इ < शी_कुल) {
                संख्या क्ष_मान = गोल(शीर्ष_सूची[शी_इ][०]);
                संख्या य_मान = गोल(शीर्ष_सूची[शी_इ][१]);
                सूची क्ष_बाइट्स = द्विआधारी_१६बिट_पैक(क्ष_मान);
                सूची य_बाइट्स = द्विआधारी_१६बिट_पैक(य_मान);

                बाइट्स = जोड़ें(बाइट्स, क्ष_बाइट्स[०]);
                बाइट्स = जोड़ें(बाइट्स, क्ष_बाइट्स[१]);
                बाइट्स = जोड़ें(बाइट्स, य_बाइट्स[०]);
                बाइट्स = जोड़ें(बाइट्स, य_बाइट्स[१]);
                शी_इ = शी_इ + १;
            }

            // सूचकांक
            सूची सूचकांक_सूची = आदेश["सूचकांक"];
            संख्या सू_कुल = लंबाई(सूचकांक_सूची);
            सूची सू_बाइट्स = द्विआधारी_१६बिट_पैक(सू_कुल);
            बाइट्स = जोड़ें(बाइट्स, सू_बाइट्स[०]);
            बाइट्स = जोड़ें(बाइट्स, सू_बाइट्स[१]);

            संख्या सू_इ = ०;
            यावत् (सू_इ < सू_कुल) {
                सूची सू_मान_बाइट्स = द्विआधारी_१६बिट_पैक(सूचकांक_सूची[सू_इ]);
                बाइट्स = जोड़ें(बाइट्स, सू_मान_बाइट्स[०]);
                बाइट्स = जोड़ें(बाइट्स, सू_मान_बाइट्स[१]);
                सू_इ = सू_इ + १;
            }

        } अन्यथा यदि (प्रकार == "२डी_यूआई") {
            // संकेत २: २डी यूआई जड़
            बाइट्स = जोड़ें(बाइट्स, २);
            बाइट्स = एन्कोड_यूआई_नोड(बाइट्स, आदेश["जड़"]);
            बाइट्स = जोड़ें(बाइट्स, २५५); // यूआई समाप्ति चिह्न (End-of-UI Sentinel)
        }

        इ = इ + १;
    }

    परत् बाइट्स;
}

// सहायक: २डी यूआई नोड्स को बाइट्स में चपटा (Flatten) करना
कार्य एन्कोड_यूआई_नोड(सूची बाइट्स, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् बाइट्स; }

    पाठ प्र = नोड["प्रकार"];
    सूची स्थान = नोड["स्थान"];
    संख्या क्ष = गोल(स्थान[०]);
    संख्या य = गोल(स्थान[१]);
    संख्या चौ = गोल(स्थान[२]);
    संख्या ऊँ = गोल(स्थान[३]);

    यदि (प्र == "डिब्बा") {
        बाइट्स = जोड़ें(बाइट्स, १०); // डिब्बा ओपकोड
        सूची क्ष_ब = द्विआधारी_१६बिट_पैक(क्ष);
        सूची य_ब = द्विआधारी_१६बिट_पैक(य);
        सूची चौ_ब = द्विआधारी_१६बिट_पैक(चौ);
        सूची ऊँ_ब = द्विआधारी_१६बिट_पैक(ऊँ);

        बाइट्स = जोड़ें(बाइट्स, क्ष_ब[०]); बाइट्स = जोड़ें(बाइट्स, क्ष_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, य_ब[०]); बाइट्स = जोड़ें(बाइट्स, य_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, चौ_ब[०]); बाइट्स = जोड़ें(बाइट्स, चौ_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, ऊँ_ब[०]); बाइट्स = जोड़ें(बाइट्स, ऊँ_ब[१]);

        पाठ पृष्ठ = नोड["पृष्ठ_रंग"];
        यदि (पृष्ठ == "") { पृष्ठ = "#000000"; }
        सूची पृष्ठ_पैक = द्विआधारी_पाठ_पैक(पृष्ठ);
        संख्या पि = ०;
        यावत् (पि < लंबाई(पृष्ठ_पैक)) {
            बाइट्स = जोड़ें(बाइट्स, पृष्ठ_पैक[पि]);
            पि = पि + १;
        }

        // बच्चों का पुनरावर्ती एन्कोडिंग
        यदि (कुंजी_है(नोड, "बच्चे") && नोड["बच्चे"] != शून्यम्) {
            संख्या बच_इ = ०;
            यावत् (बच_इ < लंबाई(नोड["बच्चे"])) {
                बाइट्स = एन्कोड_यूआई_नोड(बाइट्स, नोड["बच्चे"][बच_इ]);
                बच_इ = बच_इ + १;
            }
        }

    } अन्यथा यदि (प्र == "लेख") {
        बाइट्स = जोड़ें(बाइट्स, ११); // लेख ओपकोड
        सूची क्ष_ब = द्विआधारी_१६बिट_पैक(क्ष);
        सूची य_ब = द्विआधारी_१६बिट_पैक(य);
        बाइट्स = जोड़ें(बाइट्स, क्ष_ब[०]); बाइट्स = जोड़ें(बाइट्स, क्ष_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, य_ब[०]); बाइट्स = जोड़ें(बाइट्स, य_ब[१]);

        संख्या आकार = गोल(नोड["आकार"]);
        बाइट्स = जोड़ें(बाइट्स, आकार);

        पाठ रंग = नोड["रंग"];
        यदि (रंग == "") { रंग = "#ffffff"; }
        सूची रंग_पैक = द्विआधारी_पाठ_पैक(रंग);
        संख्या रि = ०;
        यावत् (रि < लंबाई(रंग_पैक)) {
            बाइट्स = जोड़ें(बाइट्स, रंग_पैक[रि]);
            रि = रि + १;
        }

        पाठ सामग्री = नोड["सामग्री"];
        सूची साम_पैक = द्विआधारी_पाठ_पैक(सामग्री);
        संख्या सि = ०;
        यावत् (सि < लंबाई(साम_पैक)) {
            बाइट्स = जोड़ें(बाइट्स, साम_पैक[सि]);
            सि = सि + १;
        }

    } अन्यथा यदि (प्र == "बटन") {
        बाइट्स = जोड़ें(बाइट्स, १२); // बटन ओपकोड
        सूची क्ष_ब = द्विआधारी_१६बिट_पैक(क्ष);
        सूची य_ब = द्विआधारी_१६बिट_पैक(य);
        सूची चौ_ब = द्विआधारी_१६बिट_पैक(चौ);
        सूची ऊँ_ब = द्विआधारी_१६बिट_पैक(ऊँ);

        बाइट्स = जोड़ें(बाइट्स, क्ष_ब[०]); बाइट्स = जोड़ें(बाइट्स, क्ष_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, य_ब[०]); बाइट्स = जोड़ें(बाइट्स, य_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, चौ_ब[०]); बाइट्स = जोड़ें(बाइट्स, चौ_ब[१]);
        बाइट्स = जोड़ें(बाइट्स, ऊँ_ब[०]); बाइट्स = जोड़ें(बाइट्स, ऊँ_ब[१]);

        पाठ लेबल = नोड["सामग्री"];
        सूची लेब_पैक = द्विआधारी_पाठ_पैक(लेबल);
        संख्या लि = ०;
        यावत् (लि < लंबाई(लेब_पैक)) {
            बाइट्स = जोड़ें(बाइट्स, लेब_पैक[लि]);
            लि = लि + १;
        }

        पाठ क्रिया = नोड["क्रिया_आईडी"];
        सूची क्रि_पैक = द्विआधारी_पाठ_पैक(क्रिया);
        संख्या कि = ०;
        यावत् (कि < लंबाई(क्रि_पैक)) {
            बाइट्स = जोड़ें(बाइट्स, क्रि_पैक[कि]);
            कि = कि + १;
        }
    }

    परत् बाइट्स;
}

// ============================================================
// ३. द्विआधारी चौखटा डीकोडिंग (Binary Frame Deserialization)
// ============================================================

कार्य दृश्यक_द्विआधारी_डीकोड(सूची बाइट्स) {
    // शीर्षलेख जाँच: 'SUTR'
    यदि (लंबाई(बाइट्स) < ८) {
        फेको "त्रुटिः द्विआधारी चौखटा अत्यंत लघु";
    }
    यदि (बाइट्स[०] != ८३ || बाइट्स[१] != ८५ || बाइट्स[२] != ८४ || बाइट्स[३] != ८२) {
        फेको "त्रुटिः अमान्य द्विआधारी SUTR हस्ताक्षर";
    }

    संख्या कुल_आदेश = द्विआधारी_१६बिट_अनपैक(बाइट्स, ६);
    सूची आदेश_सूची = [];
    संख्या सूचकांक = ८;

    संख्या इ = ०;
    यावत् (इ < कुल_आदेश && सूचकांक < लंबाई(बाइट्स)) {
        संख्या संकेत = बाइट्स[सूचकांक];
        सूचकांक = सूचकांक + १;

        यदि (संकेत == १) {
            // ३डी जाल
            शब्दकोश जाल_आदेश = {};
            जाल_आदेश["प्रकार"] = "३डी_जाल";

            // नाम
            शब्दकोश नाम_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
            जाल_आदेश["नाम"] = नाम_फल["पाठ"];
            सूचकांक = सूचकांक + नाम_फल["खपत_बाइट्स"];

            // रंग
            शब्दकोश रंग_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
            जाल_आदेश["रंग"] = रंग_फल["पाठ"];
            सूचकांक = सूचकांक + रंग_फल["खपत_बाइट्स"];

            // शीर्ष
            संख्या शी_कुल = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
            सूचकांक = सूचकांक + २;

            सूची शीर्ष_सूची = [];
            संख्या शी_इ = ०;
            यावत् (शी_इ < शी_कुल) {
                संख्या क्ष = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
                संख्या य = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);
                शीर्ष_सूची = जोड़ें(शीर्ष_सूची, [क्ष * १.०, य * १.०]);
                सूचकांक = सूचकांक + ४;
                शी_इ = शी_इ + १;
            }
            जाल_आदेश["प्रक्षेपित_शीर्ष"] = शीर्ष_सूची;

            // सूचकांक
            संख्या सू_कुल = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
            सूचकांक = सूचकांक + २;

            सूची सूचकांक_सूची = [];
            संख्या सू_इ = ०;
            यावत् (सू_इ < सू_कुल) {
                संख्या सू_मान = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
                सूचकांक_सूची = जोड़ें(सूचकांक_सूची, सू_मान);
                सूचकांक = सूचकांक + २;
                सू_इ = सू_इ + १;
            }
            जाल_आदेश["सूचकांक"] = सूचकांक_सूची;

            आदेश_सूची = जोड़ें(आदेश_सूची, जाल_आदेश);

        } अन्यथा यदि (संकेत == २) {
            // २डी यूआई जड़
            शब्दकोश यूआई_आदेश = {};
            यूआई_आदेश["प्रकार"] = "२डी_यूआई";
            
            // यूआई समाप्ति तक नोड्स पार्सिंग
            सूची नोड_सूची = [];
            यावत् (सूचकांक < लंबाई(बाइट्स) && बाइट्स[सूचकांक] != २५५) {
                संख्या नोड_संकेत = बाइट्स[सूचकांक];
                सूचकांक = सूचकांक + १;

                यदि (नोड_संकेत == १०) {
                    // डिब्बा
                    संख्या क्ष = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
                    संख्या य = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);
                    संख्या चौ = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ४);
                    संख्या ऊँ = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ६);
                    सूचकांक = सूचकांक + ८;

                    शब्दकोश पृ_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
                    सूचकांक = सूचकांक + पृ_फल["खपत_बाइट्स"];

                    शब्दकोश डिब = {};
                    डिब["प्रकार"] = "डिब्बा";
                    डिब["स्थान"] = [क्ष * १.०, य * १.०, चौ * १.०, ऊँ * १.०];
                    डिब["पृष्ठ_रंग"] = पृ_फल["पाठ"];
                    नोड_सूची = जोड़ें(नोड_सूची, डिब);

                } अन्यथा यदि (नोड_संकेत == ११) {
                    // लेख
                    संख्या क्ष = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
                    संख्या य = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);
                    संख्या आकार = बाइट्स[सूचकांक + ४];
                    सूचकांक = सूचकांक + ५;

                    शब्दकोश रंग_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
                    सूचकांक = सूचकांक + रंग_फल["खपत_बाइट्स"];

                    शब्दकोश साम_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
                    सूचकांक = सूचकांक + साम_फल["खपत_बाइट्स"];

                    शब्दकोश लेख_नोड = {};
                    लेख_नोड["प्रकार"] = "लेख";
                    लेख_नोड["स्थान"] = [क्ष * १.०, य * १.०, ०.०, ०.०];
                    लेख_नोड["आकार"] = आकार * १.०;
                    लेख_नोड["रंग"] = रंग_फल["पाठ"];
                    लेख_नोड["सामग्री"] = साम_फल["पाठ"];
                    नोड_सूची = जोड़ें(नोड_सूची, लेख_नोड);

                } अन्यथा यदि (नोड_संकेत == १२) {
                    // बटन
                    संख्या क्ष = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक);
                    संख्या य = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + २);
                    संख्या चौ = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ४);
                    संख्या ऊँ = द्विआधारी_१६बिट_अनपैक(बाइट्स, सूचकांक + ६);
                    सूचकांक = सूचकांक + ८;

                    शब्दकोश लेब_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
                    सूचकांक = सूचकांक + लेब_फल["खपत_बाइट्स"];

                    शब्दकोश क्रि_फल = द्विआधारी_पाठ_अनपैक(बाइट्स, सूचकांक);
                    सूचकांक = सूचकांक + क्रि_फल["खपत_बाइट्स"];

                    शब्दकोश बटन_नोड = {};
                    बटन_नोड["प्रकार"] = "बटन";
                    बटन_नोड["स्थान"] = [क्ष * १.०, य * १.०, चौ * १.०, ऊँ * १.०];
                    बटन_नोड["सामग्री"] = लेब_फल["पाठ"];
                    बटन_नोड["क्रिया_आईडी"] = क्रि_फल["पाठ"];
                    नोड_सूची = जोड़ें(नोड_सूची, बटन_नोड);
                }
            }

            यदि (सूचकांक < लंबाई(बाइट्स) && बाइट्स[सूचकांक] == २५५) {
                सूचकांक = सूचकांक + १; // २५५ समाप्ति चिह्न हटाना
            }

            // पहला नोड जड़ माना जाता है
            यदि (लंबाई(नोड_सूची) > ०) {
                यूआई_आदेश["जड़"] = नोड_सूची[०];
                यूआई_आदेश["सभी_नोड"] = नोड_सूची;
            } अन्यथा {
                यूआई_आदेश["जड़"] = शून्यम्;
            }

            आदेश_सूची = जोड़ें(आदेश_सूची, यूआई_आदेश);
        }

        इ = इ + १;
    }

    परत् आदेश_सूची;
}

// द्विआधारी संजाल पेलोड आकार तुलना (Binary vs JSON Size Compression Metric)
कार्य दृश्यक_द्विआधारी_तुलना(सूची आदेश_सूची) {
    सूची बाइट्स = दृश्यक_द्विआधारी_एन्कोड(आदेश_सूची);
    पाठ जेसन_स्ट्रिंग = जेसन_बनाओ(आदेश_सूची);

    संख्या बाइट_आकार = लंबाई(बाइट्स);
    संख्या जेसन_आकार = लंबाई(जेसन_स्ट्रिंग);
    दशमलव बचत_प्रतिशत = ((जेसन_आकार - बाइट_आकार) * १००.०) / (जेसन_आकार * १.०);

    शब्दकोश तुलना = {};
    तुलना["द्विआधारी_बाइट्स"] = बाइट_आकार;
    तुलना["जेसन_बाइट्स"] = जेसन_आकार;
    तुलना["बचत_प्रतिशत"] = बचत_प्रतिशत;
    परत् तुलना;
}
