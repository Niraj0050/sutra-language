// पुस्तकालय/क्रमचय.सूत्र — क्रमचय, संचय, गुणन (itertools-सम)
// ============================================================
// आयात "पुस्तकालय/क्रमचय.सूत्र";
//
// प्रथम-श्रेणी कार्य न होने से Python-itertools का lazy रूप नहीं —
// सब सूची-की-सूची तुरंत लौटाते हैं। बड़े इनपुट पर सावधान (n! विस्फोट)।
// ============================================================

// क सूची से एक तत्व हटाकर नई सूची
कार्य क्रमचय_हटाकर(सूची स, संख्या सूचकांक) {
    सूची फल = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        यदि (इ != सूचकांक) { फल = जोड़ें(फल, स[इ]); }
        इ = इ + 1;
    }
    परत् फल;
}

// सारे क्रमचय (पूर्ण लंबाई): क्रमचय([1,2,3]) → 6 सूचियाँ
कार्य क्रमचय(सूची स) {
    यदि (लंबाई(स) <= 1) { परत् [स]; }
    सूची फल = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        मान शेष = क्रमचय_हटाकर(स, इ);
        सूची उप = क्रमचय(शेष);
        संख्या ज = 0;
        यावत् (ज < लंबाई(उप)) {
            सूची एक = [स[इ]];
            संख्या क = 0;
            यावत् (क < लंबाई(उप[ज])) {
                एक = जोड़ें(एक, उप[ज][क]);
                क = क + 1;
            }
            फल = जोड़ें(फल, एक);
            ज = ज + 1;
        }
        इ = इ + 1;
    }
    परत् फल;
}

// लंबाई-र के क्रमचय: क्रमचय_र([1,2,3], 2) → 6 जोड़े
कार्य क्रमचय_र(सूची स, संख्या र) {
    यदि (र == 0) { परत् [[]]; }
    यदि (र > लंबाई(स)) { परत् []; }
    सूची फल = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        सूची उप = क्रमचय_र(क्रमचय_हटाकर(स, इ), र - 1);
        संख्या ज = 0;
        यावत् (ज < लंबाई(उप)) {
            सूची एक = [स[इ]];
            संख्या क = 0;
            यावत् (क < लंबाई(उप[ज])) { एक = जोड़ें(एक, उप[ज][क]); क = क + 1; }
            फल = जोड़ें(फल, एक);
            ज = ज + 1;
        }
        इ = इ + 1;
    }
    परत् फल;
}

// लंबाई-र के संचय (क्रम-निरपेक्ष): संचय([1,2,3,4], 2) → 6 जोड़े
कार्य संचय(सूची स, संख्या र) {
    यदि (र == 0) { परत् [[]]; }
    यदि (र > लंबाई(स)) { परत् []; }
    यदि (र == लंबाई(स)) { परत् [स]; }
    // पहला तत्व लो + बाकी से (र-1); या पहला छोड़ो + बाकी से र
    सूची शेष = क्रमचय_हटाकर(स, 0);
    सूची फल = [];
    सूची साथ = संचय(शेष, र - 1);
    संख्या ज = 0;
    यावत् (ज < लंबाई(साथ)) {
        सूची एक = [स[0]];
        संख्या क = 0;
        यावत् (क < लंबाई(साथ[ज])) { एक = जोड़ें(एक, साथ[ज][क]); क = क + 1; }
        फल = जोड़ें(फल, एक);
        ज = ज + 1;
    }
    सूची बिना = संचय(शेष, र);
    ज = 0;
    यावत् (ज < लंबाई(बिना)) {
        फल = जोड़ें(फल, बिना[ज]);
        ज = ज + 1;
    }
    परत् फल;
}

// घात-समुच्चय (सारे उपसमुच्चय): घात_समुच्चय([1,2]) → [[], [1], [2], [1,2]]
कार्य घात_समुच्चय(सूची स) {
    सूची फल = [[]];
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        संख्या वर्तमान_गण = लंबाई(फल);
        संख्या ज = 0;
        यावत् (ज < वर्तमान_गण) {
            सूची एक = [];
            संख्या क = 0;
            यावत् (क < लंबाई(फल[ज])) { एक = जोड़ें(एक, फल[ज][क]); क = क + 1; }
            एक = जोड़ें(एक, स[इ]);
            फल = जोड़ें(फल, एक);
            ज = ज + 1;
        }
        इ = इ + 1;
    }
    परत् फल;
}

// कार्तीय गुणन: कार्तीय_गुणन([[1,2],[3,4]]) → [[1,3],[1,4],[2,3],[2,4]]
कार्य कार्तीय_गुणन(सूची सूचियाँ) {
    सूची फल = [[]];
    संख्या इ = 0;
    यावत् (इ < लंबाई(सूचियाँ)) {
        सूची अगला = [];
        सूची वर्त_सूची = सूचियाँ[इ];
        संख्या ज = 0;
        यावत् (ज < लंबाई(फल)) {
            संख्या क = 0;
            यावत् (क < लंबाई(वर्त_सूची)) {
                सूची एक = [];
                संख्या ल = 0;
                यावत् (ल < लंबाई(फल[ज])) { एक = जोड़ें(एक, फल[ज][ल]); ल = ल + 1; }
                एक = जोड़ें(एक, वर्त_सूची[क]);
                अगला = जोड़ें(अगला, एक);
                क = क + 1;
            }
            ज = ज + 1;
        }
        फल = अगला;
        इ = इ + 1;
    }
    परत् फल;
}

// सरकती खिड़की: विंडो([1,2,3,4], 2) → [[1,2],[2,3],[3,4]]
कार्य विंडो(सूची स, संख्या आकार) {
    सूची फल = [];
    यदि (आकार <= 0 || आकार > लंबाई(स)) { परत् फल; }
    संख्या इ = 0;
    यावत् (इ + आकार <= लंबाई(स)) {
        सूची एक = [];
        संख्या ज = 0;
        यावत् (ज < आकार) { एक = जोड़ें(एक, स[इ + ज]); ज = ज + 1; }
        फल = जोड़ें(फल, एक);
        इ = इ + 1;
    }
    परत् फल;
}

// लगातार जोड़े: लगातार_जोड़े([1,2,3]) → [[1,2],[2,3]]
कार्य लगातार_जोड़े(सूची स) {
    परत् विंडो(स, 2);
}

// गिनती के साथ: गिनती_सहित(["अ","ब"]) → [[0,"अ"],[1,"ब"]]
कार्य गिनती_सहित(सूची स) {
    सूची फल = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        फल = जोड़ें(फल, [इ, स[इ]]);
        इ = इ + 1;
    }
    परत् फल;
}
