// पुस्तकालय/सूत्र_भार.सूत्र — सूत्र पैकेज एवं निर्भरता प्रबंधक (Sutra-Bhar Package Engine)
// ============================================================
// आयात "पुस्तकालय/सूत्र_भार.सूत्र";
//
// विकेंद्रीकृत सूत्र पैकेज प्रबंधन एवं निर्भरता समाधान प्रणाली।
// पारंपरिक भारी npm/pip से भिन्न:
// १. शून्य-प्रतीप निर्भरता सत्यापन (Deterministic DAG Dependency Resolver)
// २. संवर्जन तुलना (Semantic Versioning: प्रमुख, गौण, पैच)
// ३. वृत्ताकार निर्भरता पहचान (Cycle Detection)
// ४. सूत्र कील सञ्चिका (Sutra Lockfile Generation)
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/जेसन.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/व्याकरण.सूत्र";

// ============================================================
// १. संवर्जन विश्लेषण एवं तुलना (Semantic Versioning)
// ============================================================

कार्य पाठ_से_पूर्णांक(पाठ प) {
    संख्या परिणाम = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(प)) {
        पाठ च = उपखंड(प, इ, इ + १);
        संख्या कोड = अक्षर_मान(च);
        यदि (कोड >= २४०६ && कोड <= २४१५) {
            परिणाम = परिणाम * १० + (कोड - २४०६);
        } अन्यथा यदि (कोड >= ४८ && कोड <= ५७) {
            परिणाम = परिणाम * १० + (कोड - ४८);
        }
        इ = इ + १;
    }
    परत् परिणाम;
}

कार्य संवर्जन_पार्स(पाठ संवर्जन_पाठ) {
    // देवनागरी या लैटिन संख्याओं का समर्थन
    सूची खंड = विभाजित(संवर्जन_पाठ, ".");
    यदि (लंबाई(खंड) < ३) {
        परत् [०, ०, ०];
    }
    
    संख्या प्रमुख = पाठ_से_पूर्णांक(खंड[०]);
    संख्या गौण = पाठ_से_पूर्णांक(खंड[१]);
    संख्या पैच = पाठ_से_पूर्णांक(खंड[२]);
    
    परत् [प्रमुख, गौण, पैच];
}

// संवर्जन तुलना: सं१ > सं२ -> १, सं१ < सं२ -> -१, सं१ == सं२ -> ०
कार्य संवर्जन_तुलना(पाठ संवर्जन१, पाठ संवर्जन२) {
    सूची स१ = संवर्जन_पार्स(संवर्जन१);
    सूची स२ = संवर्जन_पार्स(संवर्जन२);
    
    // प्रमुख संस्करण तुलना
    यदि (स१[०] > स२[०]) { परत् १; }
    यदि (स१[०] < स२[०]) { परत् -१; }
    
    // गौण संस्करण तुलना
    यदि (स१[१] > स२[१]) { परत् १; }
    यदि (स१[१] < स२[१]) { परत् -१; }
    
    // पैच तुलना
    यदि (स१[२] > स२[२]) { परत् १; }
    यदि (स१[२] < स२[२]) { परत् -१; }
    
    परत् ०;
}

// संवर्जन संगतता (Compatibility check like ^1.0.0)
कार्य संवर्जन_संगत(पाठ मांग, पाठ वास्तविक) {
    यदि (पाठ_प्रारंभ_है(मांग, "^")) {
        पाठ आधार_मांग = उपखंड(मांग, १, लंबाई(मांग));
        सूची म_अंक = संवर्जन_पार्स(आधार_मांग);
        सूची व_अंक = संवर्जन_पार्स(वास्तविक);
        
        // प्रमुख संस्करण बिल्कुल समान होना चाहिए
        यदि (म_अंक[०] != व_अंक[०]) { परत् असत्य; }
        // वास्तविक संस्करण मांग से >= होना चाहिए
        परत् संवर्जन_तुलना(वास्तविक, आधार_मांग) >= ०;
    }
    
    परत् मांग == वास्तविक;
}

// ============================================================
// २. पैकेज मैनिफ़ेस्ट विश्लेषण (Manifest Parser)
// ============================================================

कार्य पैकेज_पात्र_पार्स(पाठ जेसन_पाठ) {
    शब्दकोश डेटा = जेसन_पार्स(जेसन_पाठ);
    
    यदि (न कुंजी_है(डेटा, "नाम")) {
        फेको "त्रुटिः पैकेज नाम अनिवार्य है";
    }
    यदि (न कुंजी_है(डेटा, "संवर्जन")) {
        फेको "त्रुटिः पैकेज संवर्जन अनिवार्य है";
    }
    यदि (न कुंजी_है(डेटा, "निर्भरता")) {
        डेटा["निर्भरता"] = {};
    }
    
    परत् डेटा;
}

// ============================================================
// ३. निर्भरता टोपोलॉजिकल क्रमण (Dependency Graph & Topological Sort)
// ============================================================

कार्य भार_डीएफएस_सहायक(शब्दकोश रजिस्ट्री, पाठ पैकेज_नाम, शब्दकोश दौरा_किया, शब्दकोश स्टैक_में, सूची क्रम) {
    यदि (कुंजी_है(स्टैक_में, पैकेज_नाम) && स्टैक_में[पैकेज_नाम]) {
        फेको "त्रुटिः वृत्ताकार निर्भरता पहचानी गई: " + पैकेज_नाम;
    }
    
    यदि (कुंजी_है(दौरा_किया, पैकेज_नाम) && दौरा_किया[पैकेज_नाम]) {
        परत् क्रम;
    }
    
    यदि (न कुंजी_है(रजिस्ट्री, पैकेज_नाम)) {
        फेको "त्रुटिः पैकेज रजिस्ट्री में नहीं मिला: " + पैकेज_नाम;
    }
    
    स्टैक_में[पैकेज_नाम] = सत्य;
    दौरा_किया[पैकेज_नाम] = सत्य;
    
    शब्दकोश निर्भरताएँ = रजिस्ट्री[पैकेज_नाम]["निर्भरता"];
    सूची कुंजी_सूची = कुंजियाँ(निर्भरताएँ);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुंजी_सूची)) {
        पाठ निर्भर = कुंजी_सूची[इ];
        क्रम = भार_डीएफएस_सहायक(रजिस्ट्री, निर्भर, दौरा_किया, स्टैक_में, क्रम);
        इ = इ + १;
    }
    
    स्टैक_में[पैकेज_नाम] = असत्य;
    क्रम = जोड़ें(क्रम, पैकेज_नाम);
    परत् क्रम;
}

// रजिस्ट्री: { "पैकेज_नाम": { "संवर्जन": "१.०.०", "निर्भरता": { ... } } }
कार्य निर्भरता_क्रम_सुलझाओ(शब्दकोश रजिस्ट्री, पाठ रूट_पैकेज_नाम) {
    सूची क्रम = [];
    शब्दकोश दौरा_किया = {};
    शब्दकोश स्टैक_में = {};
    
    क्रम = भार_डीएफएस_सहायक(रजिस्ट्री, रूट_पैकेज_नाम, दौरा_किया, स्टैक_में, क्रम);
    परत् क्रम;
}

// ============================================================
// ४. सूत्र कील सञ्चिका (Sutra Lockfile Generation)
// ============================================================

कार्य पैकेज_कील_बनाओ(शब्दकोश रजिस्ट्री, सूची संस्थापन_क्रम) {
    शब्दकोश कील = {};
    कील["संस्करण"] = "१.०";
    कील["समय"] = "२०२६-१०-२३";
    
    शब्दकोश पैकेज_विवरण = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(संस्थापन_क्रम)) {
        पाठ नाम = संस्थापन_क्रम[इ];
        शब्दकोश पैक = रजिस्ट्री[नाम];
        
        शब्दकोश प्रविष्टि = {};
        प्रविष्टि["संवर्जन"] = पैक["संवर्जन"];
        प्रविष्टि["निर्भरता"] = पैक["निर्भरता"];
        
        पैकेज_विवरण[नाम] = प्रविष्टि;
        इ = इ + १;
    }
    
    कील["पैकेज"] = पैकेज_विवरण;
    परत् जेसन_बनाओ(कील);
}
