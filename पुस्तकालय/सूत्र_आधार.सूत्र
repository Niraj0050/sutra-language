// पुस्तकालय/सूत्र_आधार.सूत्र — सूत्र मूल डेटाबेस एवं दस्तावेज़ भंडार (Sutra-Adhar NoSQL DB)
// ============================================================
// आयात "पुस्तकालय/सूत्र_आधार.सूत्र";
//
// पाणिनीय कारक-इंडेक्स एवं ट्रांजैक्शनल इन-मेमोरी/स्थायी नो-एसक्यूएल डेटाबेस।
// पारंपरिक भारी SQL इंजन से भिन्न:
// १. शून्य-ओवरहेड इन-मेमोरी संग्रह (Collections & Key-Value)
// २. ACID-समान ट्रांजैक्शन लॉग (शुरू, प्रतिबद्ध/कमिट, प्रत्यावर्तन/रोलबैक)
// ३. पाणिनीय कारक-आधारित अर्थगत खोज इंडेक्स
// ४. जेसन स्थायी संचयन एवं पुनर्भारण
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/जेसन.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/पाणिनीय_प्रज्ञा.सूत्र";

// ============================================================
// १. डेटाबेस संरचना एवं आरंभीकरण
// ============================================================

कार्य आधार_बनाओ(पाठ नाम) {
    शब्दकोश आधार = {};
    आधार["नाम"] = नाम;
    आधार["संग्रह"] = {};           // नाम -> दस्तावेज़ सूची
    आधार["अनुक्रमणिका"] = {};      // फ़ील्ड_नाम -> {मूल्य -> आईडी_सूची}
    आधार["कारक_अनुक्रमणिका"] = {}; // कारक -> {मूल्य -> आईडी_सूची}
    आधार["सक्रिय_सत्र"] = असत्य;
    आधार["सत्र_लॉग"] = [];         // ट्रांजैक्शन लॉग
    आधार["अंतिम_आईडी"] = ०;
    परत् आधार;
}

// संग्रह निर्माण (Create Collection)
कार्य आधार_संग्रह_बनाओ(शब्दकोश आधार, पाठ संग्रह_नाम) {
    यदि (न कुंजी_है(आधार["संग्रह"], संग्रह_नाम)) {
        आधार["संग्रह"][संग्रह_नाम] = [];
    }
}

// ============================================================
// २. दस्तावेज़ प्रविष्टि एवं अद्यतन (CRUD Operations)
// ============================================================

कार्य आधार_डालो(शब्दकोश आधार, पाठ संग्रह_नाम, शब्दकोश दस्तावेज़) {
    आधार_संग्रह_बनाओ(आधार, संग्रह_नाम);
    
    // स्वतः आईडी आवंटन यदि अनुपस्थित हो
    यदि (न कुंजी_है(दस्तावेज़, "आईडी")) {
        आधार["अंतिम_आईडी"] = आधार["अंतिम_आईडी"] + १;
        दस्तावेज़["आईडी"] = आधार["अंतिम_आईडी"];
    }
    
    // ट्रांजैक्शन लॉग यदि सत्र सक्रिय है
    यदि (आधार["सक्रिय_सत्र"]) {
        शब्दकोश लॉग_प्रविष्टि = {};
        लॉग_प्रविष्टि["प्रकार"] = "प्रविष्टि";
        लॉग_प्रविष्टि["संग्रह"] = संग्रह_नाम;
        लॉग_प्रविष्टि["आईडी"] = दस्तावेज़["आईडी"];
        आधार["सत्र_लॉग"] = जोड़ें(आधार["सत्र_लॉग"], लॉग_प्रविष्टि);
    }
    
    आधार["संग्रह"][संग्रह_नाम] = जोड़ें(आधार["संग्रह"][संग्रह_नाम], दस्तावेज़);
    
    // यदि दस्तावेज़ में संस्कृत वाक्य है, तो पाणिनीय कारक इंडेक्सिंग
    यदि (कुंजी_है(दस्तावेज़, "वाक्य")) {
        पाठ वाक्य = दस्तावेज़["वाक्य"];
        शब्दकोश ग्राफ़ = पाणिनीय_वाक्य_ग्राफ़(वाक्य);
        
        // कारक अनुक्रमणिका अद्यतन
        सूची कारक_नाम = ["कर्ता", "कर्म", "करण", "अधिकरण"];
        संख्या इ = ०;
        यावत् (इ < लंबाई(कारक_नाम)) {
            पाठ का = कारक_नाम[इ];
            पाठ पद_मूल्य = ग्राफ़[का];
            यदि (पद_मूल्य != "") {
                यदि (न कुंजी_है(आधार["कारक_अनुक्रमणिका"], का)) {
                    आधार["कारक_अनुक्रमणिका"][का] = {};
                }
                यदि (न कुंजी_है(आधार["कारक_अनुक्रमणिका"][का], पद_मूल्य)) {
                    आधार["कारक_अनुक्रमणिका"][का][पद_मूल्य] = [];
                }
                आधार["कारक_अनुक्रमणिका"][का][पद_मूल्य] = जोड़ें(आधार["कारक_अनुक्रमणिका"][का][पद_मूल्य], दस्तावेज़["आईडी"]);
            }
            इ = इ + १;
        }
    }
    
    परत् दस्तावेज़["आईडी"];
}

// आईडी से दस्तावेज़ खोज
कार्य आधार_आईडी_से_पाओ(शब्दकोश आधार, पाठ संग्रह_नाम, संख्या आईडी) {
    यदि (न कुंजी_है(आधार["संग्रह"], संग्रह_नाम)) {
        परत् शून्यम्;
    }
    सूची दस्तावेज़_सूची = आधार["संग्रह"][संग्रह_नाम];
    संख्या इ = ०;
    यावत् (इ < लंबाई(दस्तावेज़_सूची)) {
        शब्दकोश दस्ता = दस्तावेज़_सूची[इ];
        यदि (दस्ता["आईडी"] == आईडी) {
            परत् दस्ता;
        }
        इ = इ + १;
    }
    परत् शून्यम्;
}

// गुणधर्म-आधारित खोज (Filter Query)
कार्य आधार_खोज(शब्दकोश आधार, पाठ संग्रह_नाम, पाठ फ़ील्ड, पाठ मूल्य) {
    यदि (न कुंजी_है(आधार["संग्रह"], संग्रह_नाम)) {
        परत् [];
    }
    सूची दस्तावेज़_सूची = आधार["संग्रह"][संग्रह_नाम];
    सूची परिणाम = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(दस्तावेज़_सूची)) {
        शब्दकोश दस्ता = दस्तावेज़_सूची[इ];
        यदि (कुंजी_है(दस्ता, फ़ील्ड)) {
            यदि (दस्ता[फ़ील्ड] == मूल्य) {
                परिणाम = जोड़ें(परिणाम, दस्ता);
            }
        }
        इ = इ + १;
    }
    परत् परिणाम;
}

// ============================================================
// ३. पाणिनीय कारक अर्थगत अनुक्रमणिका खोज (Semantic Karaka Query)
// ============================================================

कार्य आधार_कारक_खोज(शब्दकोश आधार, पाठ कारक_नाम, पाठ मूल्य) {
    यदि (न कुंजी_है(आधार["कारक_अनुक्रमणिका"], कारक_नाम)) {
        परत् [];
    }
    शब्दकोश कारक_मानचित्र = आधार["कारक_अनुक्रमणिका"][कारक_नाम];
    यदि (न कुंजी_है(कारक_मानचित्र, मूल्य)) {
        परत् [];
    }
    परत् कारक_मानचित्र[मूल्य];
}

// ============================================================
// ४. ट्रांजैक्शन प्रबंधन (ACID Transactions)
// ============================================================

कार्य आधार_सत्र_शुरू(शब्दकोश आधार) {
    आधार["सक्रिय_सत्र"] = सत्य;
    आधार["सत्र_लॉग"] = [];
}

कार्य आधार_सत्र_प्रतिबद्ध(शब्दकोश आधार) {
    आधार["सक्रिय_सत्र"] = असत्य;
    आधार["सत्र_लॉग"] = [];
}

कार्य आधार_सत्र_प्रत्यावर्तन(शब्दकोश आधार) {
    यदि (न आधार["सक्रिय_सत्र"]) { परत् ०; }
    
    // लॉग के आधार पर डाले गए तत्वों को वापस हटाना
    सूची लॉग = आधार["सत्र_लॉग"];
    संख्या इ = लंबाई(लॉग) - १;
    यावत् (इ >= ०) {
        शब्दकोश प्रविष्टि = लॉग[इ];
        पाठ संग्रह_नाम = प्रविष्टि["संग्रह"];
        संख्या हटाओ_आईडी = प्रविष्टि["आईडी"];
        
        यदि (कुंजी_है(आधार["संग्रह"], संग्रह_नाम)) {
            सूची मूल_सूची = आधार["संग्रह"][संग्रह_नाम];
            सूची नई_सूची = [];
            संख्या ज = ०;
            यावत् (ज < लंबाई(मूल_सूची)) {
                शब्दकोश दस्ता = मूल_सूची[ज];
                यदि (दस्ता["आईडी"] != हटाओ_आईडी) {
                    नई_सूची = जोड़ें(नई_सूची, दस्ता);
                }
                ज = ज + १;
            }
            आधार["संग्रह"][संग्रह_नाम] = नई_सूची;
        }
        इ = इ - १;
    }
    
    आधार["सक्रिय_सत्र"] = असत्य;
    आधार["सत्र_लॉग"] = [];
    परत् १;
}

// ============================================================
// ५. स्थायी संचयन एवं पुनर्भारण (Persistence)
// ============================================================

कार्य आधार_निर्यात_जेसन(शब्दकोश आधार) {
    शब्दकोश डेटा = {};
    डेटा["नाम"] = आधार["नाम"];
    डेटा["संग्रह"] = आधार["संग्रह"];
    डेटा["अंतिम_आईडी"] = आधार["अंतिम_आईडी"];
    परत् जेसन_बनाओ(डेटा);
}

कार्य आधार_आयात_जेसन(पाठ जेसन_पाठ) {
    शब्दकोश डेटा = जेसन_पार्स(जेसन_पाठ);
    शब्दकोश आधार = आधार_बनाओ(डेटा["नाम"]);
    आधार["संग्रह"] = डेटा["संग्रह"];
    आधार["अंतिम_आईडी"] = डेटा["अंतिम_आईडी"];
    परत् आधार;
}
