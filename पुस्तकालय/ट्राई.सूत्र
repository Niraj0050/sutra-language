// पुस्तकालय/ट्राई.सूत्र — ट्राई (उपसर्ग-वृक्ष / prefix tree)
// ============================================================
// आयात "पुस्तकालय/ट्राई.सूत्र";
//
//   शब्दकोश ज = ट्राई_बनाओ();
//   ट्राई_जोड़ो(ज, "cat");
//   ट्राई_जोड़ो(ज, "car");
//   ट्राई_जोड़ो(ज, "card");
//   ट्राई_है(ज, "car")                // सत्य
//   ट्राई_है(ज, "ca")                 // असत्य (पूरा शब्द नहीं जोड़ा गया)
//   ट्राई_उपसर्ग_है(ज, "ca")          // सत्य
//   ट्राई_उपसर्ग_वाले(ज, "car")       // ["car", "card"] (वर्णानुक्रम में)
//   ट्राई_हटाओ(ज, "car")
//
// निरूपण: हर नोड = शब्दकोश {"बच्चे": सूची of {"अक्षर":पाठ, "नोड":शब्दकोश},
// "अंत_है": बूल}। जड़ स्वयं एक खाली नोड है, कोई अलग "जड़" प्रकार नहीं।
//
// ⚠️ "बच्चे" जानबूझकर शब्दकोश (char→node) नहीं, सूची-of-प्रविष्टि है —
// इस सत्र में एक असली, अलग से दर्ज (background task) भाषा-सीमा मिली:
// `कुंजियाँ()` native backend पर किसी शब्दकोश की चाबियाँ ग़लत लौटाता (एक
// न्यूनतम एक-चाबी वाला उदाहरण भी असफल — जाँचा-परखा, महज़ अटकल नहीं)।
// रैखिक-खोज (linear search, O(शाखा-गिनती)) यहाँ इस्तेमाल होती — ट्राई
// शाखाओं की संख्या आम तौर पर छोटी रहती, तो असली प्रदर्शन-प्रभाव नगण्य।
//
// ट्राई_हटाओ असली छँटाई (pruning) करता — सिर्फ़ "अंत_है" उतार देना काफ़ी
// नहीं होता, वरना हटाए गए शब्द का उपसर्ग `ट्राई_उपसर्ग_है` में झूठा
// "सत्य" देता रहता अगर वह उपसर्ग किसी और शब्द का हिस्सा न हो। अनावश्यक
// हो चुके (कोई बच्चे नहीं, स्वयं किसी शब्द का अंत नहीं) नोड जड़ तक वापस
// काटे जाते।
// ============================================================

आयात "पुस्तकालय/सूची.सूत्र";

// ===== आंतरिक =====

कार्य ट्रा_नोड_बनाओ() {
    शब्दकोश नोड = {};
    नोड["बच्चे"] = [];
    नोड["अंत_है"] = असत्य;
    परत् नोड;
}

// नोड के "बच्चे" में से दिए अक्षर वाला चाइल्ड-नोड (रैखिक-खोज) — न हो तो शून्यम्
कार्य ट्रा_बच्चा_खोजो(शब्दकोश नोड, पाठ अक्षर) {
    सूची बच्चे = नोड["बच्चे"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(बच्चे)) {
        यदि (बच्चे[इ]["अक्षर"] == अक्षर) { परत् बच्चे[इ]["नोड"]; }
        इ = इ + १;
    }
    परत् शून्यम्;
}

// नोड में दिए अक्षर के लिए एक नया चाइल्ड-नोड जोड़ो, वही चाइल्ड-नोड लौटाओ
कार्य ट्रा_बच्चा_बनाओ(शब्दकोश नोड, पाठ अक्षर) {
    शब्दकोश नया = ट्रा_नोड_बनाओ();
    शब्दकोश प्रविष्टि = {};
    प्रविष्टि["अक्षर"] = अक्षर;
    प्रविष्टि["नोड"] = नया;
    नोड["बच्चे"] = जोड़ें(नोड["बच्चे"], प्रविष्टि);
    परत् नया;
}

// जड़ से शब्द के रास्ते पर आख़िरी नोड — रास्ता टूटे तो शून्यम्
कार्य ट्रा_नोड_खोजो(शब्दकोश जड़, पाठ शब्द) {
    शब्दकोश वर्तमान = जड़;
    संख्या इ = ०;
    यावत् (इ < लंबाई(शब्द)) {
        पाठ च = उपखंड(शब्द, इ, इ + १);
        शब्दकोश अगला = ट्रा_बच्चा_खोजो(वर्तमान, च);
        यदि (अगला == शून्यम्) { परत् शून्यम्; }
        वर्तमान = अगला;
        इ = इ + १;
    }
    परत् वर्तमान;
}

// नोड के बच्चों के अक्षर, वर्णानुक्रम में (सूची.सूत्र का क्रमबद्ध — यह
// शुद्ध पाठ-सूची पर सही चलता, सिर्फ़ शब्दकोश-कुंजी-निष्कर्षण के साथ
// मिलाने पर समस्या है, इसलिए यहाँ शुद्ध अलग-से-बनाई सूची पर चलाया जाता)
कार्य ट्रा_अक्षर_क्रमित(शब्दकोश नोड) {
    सूची बच्चे = नोड["बच्चे"];
    सूची अक्षर_सूची = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(बच्चे)) {
        अक्षर_सूची = जोड़ें(अक्षर_सूची, बच्चे[इ]["अक्षर"]);
        इ = इ + १;
    }
    परत् क्रमबद्ध(अक्षर_सूची);
}

// नोड के नीचे के सारे पूरे शब्द इकट्ठे करो (वर्णानुक्रम में, DFS) —
// सूची-पैरामीटर स्पष्ट रूप से हर पुनरावर्ती कॉल पर लौटाई/दोबारा-असाइन
// होती है (कभी बिना reassign के मात्र-mutation पर निर्भर नहीं) — सूची
// के native-backend संदर्भ-सीमा से बचने को (देखो आलेख.सूत्र की टिप्पणी)
कार्य ट्रा_सभी_एकत्र(शब्दकोश नोड, पाठ अब_तक, सूची फल) {
    यदि (नोड["अंत_है"] == सत्य) {
        फल = जोड़ें(फल, अब_तक);
    }
    सूची अक्षर_सूची = ट्रा_अक्षर_क्रमित(नोड);
    संख्या इ = ०;
    यावत् (इ < लंबाई(अक्षर_सूची)) {
        पाठ च = अक्षर_सूची[इ];
        शब्दकोश बच्चा = ट्रा_बच्चा_खोजो(नोड, च);
        फल = ट्रा_सभी_एकत्र(बच्चा, अब_तक + च, फल);
        इ = इ + १;
    }
    परत् फल;
}

// शब्द हटाओ + रास्ते में अनावश्यक हो चुके नोड काटो। लौटाता है: क्या
// स्वयं यह "नोड" अब भी हटाने लायक है (कोई बच्चे नहीं, अंत_है नहीं) —
// माता-पिता इसी से तय करता कि अपने यहाँ से इस बच्चे की प्रविष्टि काटे या नहीं
कार्य ट्रा_हटाओ_सहायक(शब्दकोश नोड, पाठ शब्द, संख्या गहराई) {
    यदि (गहराई == लंबाई(शब्द)) {
        नोड["अंत_है"] = असत्य;
    } अन्यथा {
        पाठ च = उपखंड(शब्द, गहराई, गहराई + १);
        शब्दकोश बच्चा = ट्रा_बच्चा_खोजो(नोड, च);
        यदि (बच्चा != शून्यम्) {
            बूल बच्चा_काटो = ट्रा_हटाओ_सहायक(बच्चा, शब्द, गहराई + १);
            यदि (बच्चा_काटो) {
                सूची नई_बच्चे = [];
                सूची पुराने_बच्चे = नोड["बच्चे"];
                संख्या इ = ०;
                यावत् (इ < लंबाई(पुराने_बच्चे)) {
                    यदि (न (पुराने_बच्चे[इ]["अक्षर"] == च)) {
                        नई_बच्चे = जोड़ें(नई_बच्चे, पुराने_बच्चे[इ]);
                    }
                    इ = इ + १;
                }
                नोड["बच्चे"] = नई_बच्चे;
            }
        }
    }
    परत् लंबाई(नोड["बच्चे"]) == ० && नोड["अंत_है"] != सत्य;
}

// ===== सार्वजनिक API =====

कार्य ट्राई_बनाओ() {
    परत् ट्रा_नोड_बनाओ();
}

// शब्द को ट्राई में जोड़ो (पहले से हो तो कुछ नहीं बदलता)
कार्य ट्राई_जोड़ो(शब्दकोश जड़, पाठ शब्द) {
    शब्दकोश वर्तमान = जड़;
    संख्या इ = ०;
    यावत् (इ < लंबाई(शब्द)) {
        पाठ च = उपखंड(शब्द, इ, इ + १);
        शब्दकोश अगला = ट्रा_बच्चा_खोजो(वर्तमान, च);
        यदि (अगला == शून्यम्) {
            अगला = ट्रा_बच्चा_बनाओ(वर्तमान, च);
        }
        वर्तमान = अगला;
        इ = इ + १;
    }
    वर्तमान["अंत_है"] = सत्य;
    परत् ०;
}

// क्या यह पूरा शब्द ट्राई में मौजूद है (सिर्फ़ उपसर्ग होना काफ़ी नहीं)
कार्य ट्राई_है(शब्दकोश जड़, पाठ शब्द) {
    शब्दकोश नोड = ट्रा_नोड_खोजो(जड़, शब्द);
    परत् नोड != शून्यम् && नोड["अंत_है"] == सत्य;
}

// क्या कोई भी जोड़ा गया शब्द इस उपसर्ग से शुरू होता है
कार्य ट्राई_उपसर्ग_है(शब्दकोश जड़, पाठ उपसर्ग) {
    परत् ट्रा_नोड_खोजो(जड़, उपसर्ग) != शून्यम्;
}

// इस उपसर्ग वाले सारे शब्द (वर्णानुक्रम में सूची) — कोई मेल न हो तो []
कार्य ट्राई_उपसर्ग_वाले(शब्दकोश जड़, पाठ उपसर्ग) {
    शब्दकोश नोड = ट्रा_नोड_खोजो(जड़, उपसर्ग);
    यदि (नोड == शून्यम्) { परत् []; }
    परत् ट्रा_सभी_एकत्र(नोड, उपसर्ग, []);
}

// ट्राई में जोड़े गए सारे शब्द (वर्णानुक्रम में)
कार्य ट्राई_सभी_शब्द(शब्दकोश जड़) {
    परत् ट्रा_सभी_एकत्र(जड़, "", []);
}

// शब्द हटाओ (असली छँटाई सहित — ऊपर टिप्पणी देखो)। लौटाता है क्या शब्द
// वाक़ई मौजूद था (हटाने लायक कुछ था)
कार्य ट्राई_हटाओ(शब्दकोश जड़, पाठ शब्द) {
    यदि (न ट्राई_है(जड़, शब्द)) { परत् असत्य; }
    ट्रा_हटाओ_सहायक(जड़, शब्द, ०);
    परत् सत्य;
}
