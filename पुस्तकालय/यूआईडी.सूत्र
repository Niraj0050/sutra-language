// पुस्तकालय/यूआईडी.सूत्र — UUID (RFC 4122) संस्करण ४ — यादृच्छिक-आधारित
// ============================================================
// आयात "पुस्तकालय/यूआईडी.सूत्र";
//
//   शब्दकोश रा = यादृ_बनाओ(४२);              // यादृच्छिक.सूत्र से — कोई भी बीज
//   पाठ आ = यूआईडी_संस्करण४(रा);              // "a1b2c3d4-e5f6-4789-a123-456789abcdef"
//   यूआईडी_मान्य_है(आ)                        // सत्य
//   यूआईडी_रिक्त()                            // "00000000-0000-0000-0000-000000000000"
//
// RFC 4122 §4.4 का सटीक एल्गोरिथ्म — १२८ यादृच्छिक बिट, फिर २ जगह ओवरराइट:
// बाइट ६ का ऊपरी निबल = ०१०० (संस्करण ४), बाइट ८ के ऊपरी २ बिट = १०
// (variant — RFC 4122 खुद)। दिखाना ८-४-४-४-१२ hex-अंक + हाइफ़न (३६ अक्षर)।
//
// ⚠ यह क्रिप्टोग्राफ़िक-सुरक्षित यादृच्छिकता नहीं है (यादृच्छिक.सूत्र की
// xorshift128 PRNG इस्तेमाल होती, कोई OS CSPRNG नहीं) — session-token/
// गोपनीय-कुंजी जैसे सुरक्षा-संवेदनशील उपयोग के लिए मत इस्तेमाल करो, सिर्फ़
// DB-key/अनुरोध-id/सामान्य unique-id जैसे व्यावहारिक मामलों के लिए। बीज
// अच्छा चुनना caller की ज़िम्मेदारी — यह मॉड्यूल शुद्ध (FFI-रहित) है, इसलिए
// "अभी का समय" जैसा OS-स्रोत खुद नहीं जुटा सकता (तिथि.सूत्र जैसा ही कारण)।
// ============================================================

आयात "पुस्तकालय/यादृच्छिक.सूत्र";
आयात "पुस्तकालय/प्रारूप.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";

// एक ३२-बिट मान के ४ बाइट (०-२५५ हर एक) निकालकर मौजूदा सूची में जोड़ो —
// क्रम मनमाना है (शुद्ध यादृच्छिक डेटा में कोई अर्थपूर्ण byte-order नहीं)
कार्य यूआईडी_बाइट्स_जोड़ो(सूची स, संख्या मूल्य) {
    सूची फल = जोड़ें(स, (मूल्य / १६७७७२१६) % २५६);
    फल = जोड़ें(फल, (मूल्य / ६५५३६) % २५६);
    फल = जोड़ें(फल, (मूल्य / २५६) % २५६);
    फल = जोड़ें(फल, मूल्य % २५६);
    परत् फल;
}

// एक बाइट (०-२५५) → २-अंक zero-padded lowercase hex
कार्य यूआईडी_बाइट_हेक्स(संख्या ब) {
    परत् बाएँ_भरो(हेक्स(ब), २, "0");
}

// १६ बाइट की सूची → मानक ८-४-४-४-१२ प्रारूप
कार्य यूआईडी_प्रारूप(सूची बाइट्स) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < १६) {
        यदि (इ == ४ || इ == ६ || इ == ८ || इ == १०) { फल = फल + "-"; }
        फल = फल + यूआईडी_बाइट_हेक्स(बाइट्स[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// नया संस्करण-४ (यादृच्छिक-आधारित) UUID — रा एक यादृ_बनाओ(...) स्ट्रीम
कार्य यूआईडी_संस्करण४(शब्दकोश रा) {
    सूची बाइट्स = [];
    बाइट्स = यूआईडी_बाइट्स_जोड़ो(बाइट्स, यादृ_अगला32(रा));
    बाइट्स = यूआईडी_बाइट्स_जोड़ो(बाइट्स, यादृ_अगला32(रा));
    बाइट्स = यूआईडी_बाइट्स_जोड़ो(बाइट्स, यादृ_अगला32(रा));
    बाइट्स = यूआईडी_बाइट्स_जोड़ो(बाइट्स, यादृ_अगला32(रा));
    // संस्करण निबल (बाइट ६ का ऊपरी निबल) = ०१०० → ४
    बाइट्स[६] = (बाइट्स[६] % १६) + (४ * १६);
    // variant बिट (बाइट ८ के ऊपरी २ बिट) = १० → +१२८, निचले ६ बिट बरकरार
    बाइट्स[८] = (बाइट्स[८] % ६४) + १२८;
    परत् यूआईडी_प्रारूप(बाइट्स);
}

// सर्व-शून्य "nil UUID" (RFC 4122 §4.1.7) — खाली/अनारंभित सेंटिनल मान
कार्य यूआईडी_रिक्त() {
    परत् "00000000-0000-0000-0000-000000000000";
}

कार्य यूआईडी_हेक्स_अंक_है(पाठ च) {
    संख्या क = अक्षर_मान(च);
    परत् (क >= ४८ && क <= ५७) || (क >= ९७ && क <= १०२) || (क >= ६५ && क <= ७०);
}

// पाठ की बनावट मानक UUID जैसी है? (३६ अक्षर, सही जगह हाइफ़न, बाकी hex-अंक)
// — संस्करण/variant अंक विशेष रूप से जाँचे नहीं जाते, सिर्फ़ सामान्य
// आकार-वैधता (किसी भी संस्करण का, या हाथ से बना UUID भी मान्य गिनेगा)
कार्य यूआईडी_मान्य_है(पाठ स) {
    यदि (लंबाई(स) != ३६) { परत् असत्य; }
    संख्या इ = ०;
    यावत् (इ < ३६) {
        पाठ च = उपखंड(स, इ, इ + १);
        यदि (इ == ८ || इ == १३ || इ == १८ || इ == २३) {
            यदि (च != "-") { परत् असत्य; }
        } अन्यथा {
            यदि (न यूआईडी_हेक्स_अंक_है(च)) { परत् असत्य; }
        }
        इ = इ + १;
    }
    परत् सत्य;
}
