// पुस्तकालय/दृश्यक_संजाल.सूत्र — दृश्यक शून्य-HTML/CSS/JS संजाल एवं सूक्ष्म-ब्लिटर इंजन
// ============================================================
// आयात "पुस्तकालय/दृश्यक_संजाल.सूत्र";
//
// पारंपरिक भारी HTML/CSS/JS वेब स्टैक को विलोपित करने वाला
// सूक्ष्म-कैनवास संजाल प्रवाह (Micro-Canvas Zero-DOM Wire Stream) कोर।
//
// १. सूक्ष्म-ब्लिटर क्लाइंट पृष्ठ (Micro-Blitter Page — < 5KB, Zero JS Libraries, Zero CSS)
// २. स्थानिक चौखटा जेसन स्वरूपण (Spatial Scene JSON Payload Serializer)
// ३. संवादात्मक घटना प्रेषण (Interactive Click/Key Event Dispatcher)
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/जेसन.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";
आयात "पुस्तकालय/सूची.सूत्र";
आयात "पुस्तकालय/शब्दकोश.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/सूत्र_जाल.सूत्र";

// ============================================================
// १. सूक्ष्म-ब्लिटर क्लाइंट जनरेटर (Micro-Blitter Client Page)
// ============================================================
// यह क्लाइंट केवल एक शुद्ध कैनवास है। कोई React, Three.js, या CSS नहीं।
// केवल सूत्र द्वारा भेजे गए प्रत्यक्ष चित्रांकन आदेशों को खींचता है।

कार्य दृश्यक_सूक्ष्म_ब्लिटर_एचटीएमएल() {
    पाठ पृष्ठ = "<!DOCTYPE html>\n";
    पृष्ठ = पृष्ठ + "<html lang=\"hi\"><head><meta charset=\"UTF-8\">\n";
    पृष्ठ = पृष्ठ + "<title>सूत्र दृश्यक — Zero HTML/CSS/JS Spatial Canvas</title>\n";
    पृष्ठ = पृष्ठ + "<style>*{margin:0;padding:0;overflow:hidden;background:#050811;} canvas{display:block;width:100vw;height:100vh;}</style>\n";
    पृष्ठ = पृष्ठ + "</head><body>\n";
    पृष्ठ = पृष्ठ + "<canvas id=\"क\"></canvas>\n";
    पृष्ठ = पृष्ठ + "<script>\n";
    पृष्ठ = पृष्ठ + "const cvs=document.getElementById('क'), ctx=cvs.getContext('2d');\n";
    पृष्ठ = पृष्ठ + "function resize(){cvs.width=window.innerWidth; cvs.height=window.innerHeight;}\n";
    पृष्ठ = पृष्ठ + "window.onresize=resize; resize();\n";
    पृष्ठ = पृष्ठ + "async function pullFrame(){\n";
    पृष्ठ = पृष्ठ + "  try{\n";
    पृष्ठ = पृष्ठ + "    const r=await fetch('/चौखटा?w='+cvs.width+'&h='+cvs.height);\n";
    पृष्ठ = पृष्ठ + "    const orders=await r.json();\n";
    पृष्ठ = पृष्ठ + "    ctx.fillStyle='#050811'; ctx.fillRect(0,0,cvs.width,cvs.height);\n";
    पृष्ठ = पृष्ठ + "    for(const cmd of orders){\n";
    पृष्ठ = पृष्ठ + "      if(cmd.प्रकार==='३डी_जाल'){\n";
    पृष्ठ = पृष्ठ + "        const v=cmd.प्रक्षेपित_शीर्ष, idx=cmd.सूचकांक;\n";
    पृष्ठ = पृष्ठ + "        ctx.strokeStyle=cmd.रंग||'#00ffcc'; ctx.lineWidth=1.5;\n";
    पृष्ठ = पृष्ठ + "        for(let i=0; i<idx.length; i+=3){\n";
    पृष्ठ = पृष्ठ + "          const p0=v[idx[i]], p1=v[idx[i+1]], p2=v[idx[i+2]];\n";
    पृष्ठ = पृष्ठ + "          ctx.beginPath(); ctx.moveTo(p0[0], p0[1]); ctx.lineTo(p1[0], p1[1]);\n";
    पृष्ठ = पृष्ठ + "          ctx.lineTo(p2[0], p2[1]); ctx.closePath(); ctx.stroke();\n";
    पृष्ठ = पृष्ठ + "        }\n";
    पृष्ठ = पृष्ठ + "      } else if(cmd.प्रकार==='२डी_यूआई'){\n";
    पृष्ठ = पृष्ठ + "        render2D(cmd.जड़);\n";
    पृष्ठ = पृष्ठ + "      }\n";
    पृष्ठ = पृष्ठ + "    }\n";
    पृष्ठ = पृष्ठ + "  }catch(e){}\n";
    पृष्ठ = पृष्ठ + "  requestAnimationFrame(pullFrame);\n";
    पृष्ठ = पृष्ठ + "}\n";
    पृष्ठ = पृष्ठ + "function render2D(node){\n";
    पृष्ठ = पृष्ठ + "  if(!node) return;\n";
    पृष्ठ = पृष्ठ + "  const [x,y,w,h]=node.स्थान;\n";
    पृष्ठ = पृष्ठ + "  if(node.पृष्ठ_रंग){ ctx.fillStyle=node.पृष्ठ_रंग; ctx.fillRect(x,y,w,h); }\n";
    पृष्ठ = पृष्ठ + "  if(node.सामग्री){\n";
    पृष्ठ = पृष्ठ + "    ctx.fillStyle=node.रंग||'#ffffff'; ctx.font=(node.आकार||14)+'px sans-serif';\n";
    पृष्ठ = पृष्ठ + "    ctx.fillText(node.सामग्री, x+10, y+h/2+5);\n";
    पृष्ठ = पृष्ठ + "  }\n";
    पृष्ठ = पृष्ठ + "  if(node.बच्चे) node.बच्चे.forEach(render2D);\n";
    पृष्ठ = पृष्ठ + "}\n";
    पृष्ठ = पृष्ठ + "cvs.onclick=(e)=>{\n";
    पृष्ठ = पृष्ठ + "  fetch('/क्लिक', {method:'POST', headers:{'Content-Type':'application/json'},\n";
    पृष्ठ = पृष्ठ + "  body:JSON.stringify({x:e.clientX, y:e.clientY})});\n";
    पृष्ठ = पृष्ठ + "};\n";
    पृष्ठ = पृष्ठ + "pullFrame();\n";
    पृष्ठ = पृष्ठ + "</script></body></html>\n";
    
    परत् पृष्ठ;
}

// ============================================================
// २. स्थानिक चौखटा जेसन स्वरूपण (Spatial Frame JSON Serializer)
// ============================================================

कार्य दृश्यक_चौखटा_जेसन(शब्दकोश दृश्य, दशमलव चौड़ाई, दशमलव ऊँचाई) {
    सूची आदेश_सूची = दृश्यक_चौखटा_आदेश(दृश्य, चौड़ाई, ऊँचाई);
    परत् जेसन_बनाओ(आदेश_सूची);
}

// ============================================================
// ३. संवादात्मक २डी क्लिक पहचान (2D Click Hit-Testing)
// ============================================================

कार्य दृश्यक_क्लिक_खोज(शब्दकोश नोड, दशमलव क्लिक_क्ष, दशमलव क्लिक_य) {
    यदि (नोड == शून्यम्) { परत् ""; }

    सूची स्थान = नोड["स्थान"];
    दशमलव बाएँ = स्थान[०];
    दशमलव ऊपर = स्थान[१];
    दशमलव चौड़ाई = स्थान[२];
    दशमलव ऊँचाई = स्थान[३];

    // क्या क्लिक इस नोड के दायरे में है?
    यदि (क्लिक_क्ष >= बाएँ && क्लिक_क्ष <= बाएँ + चौड़ाई &&
        क्लिक_य >= ऊपर && क्लिक_य <= ऊपर + ऊँचाई) {

        // यदि बटन है और क्रिया_आईडी उपस्थित है
        यदि (नोड["प्रकार"] == "बटन" && कुंजी_है(नोड, "क्रिया_आईडी")) {
            परत् नोड["क्रिया_आईडी"];
        }

        // बच्चों में गहराई से खोज
        यदि (कुंजी_है(नोड, "बच्चे")) {
            सूची बच्चे = नोड["बच्चे"];
            संख्या इ = ०;
            यावत् (इ < लंबाई(बच्चे)) {
                पाठ क्रिया = दृश्यक_क्लिक_खोज(बच्चे[इ], क्लिक_क्ष, क्लिक_य);
                यदि (क्रिया != "") { परत् क्रिया; }
                इ = इ + १;
            }
        }
    }

    परत् "";
}
