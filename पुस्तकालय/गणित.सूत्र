// पुस्तकालय/गणित.सूत्र — संख्या-सिद्धांत, सांख्यिकी, उपयोगिताएँ, PRNG
// ============================================================
// आयात "पुस्तकालय/गणित.सूत्र";
//
// अंतर्निहित पहले से: वर्गमूल घात निरपेक्ष न्यूनतम अधिकतम गोल (सब दशमलव)।
// यहाँ पूर्णांक-केंद्रित + सांख्यिकी + एक बीज-योग्य PRNG (MINSTD)।
// सूत्र में बिटवार संक्रियाएँ नहीं — सब कुछ +−×÷% पर।
// ============================================================

// ===== स्थिरांक =====
कार्य पाई() { परत् 3.141592653589793; }
कार्य ई_अंक() { परत् 2.718281828459045; }

// ===== पूर्णांक उपयोगिताएँ =====

// निरपेक्ष मान (पूर्णांक)
कार्य पूर्ण_निरपेक्ष(संख्या क) {
    यदि (क < 0) { परत् 0 - क; }
    परत् क;
}

// चिह्न: -1 / 0 / 1
कार्य चिह्न(मान क) {
    यदि (क < 0) { परत् -1; }
    यदि (क > 0) { परत् 1; }
    परत् 0;
}

// क को [न्यून, उच्च] में सीमित करो
कार्य परिसीमन(मान क, मान न्यून, मान उच्च) {
    यदि (क < न्यून) { परत् न्यून; }
    यदि (क > उच्च) { परत् उच्च; }
    परत् क;
}

कार्य सम_है(संख्या क) {
    परत् (क % 2) == 0;
}
कार्य विषम_है(संख्या क) {
    परत् (क % 2) != 0;
}

// फ़्लोर-भाग (ऋणात्मक के लिए भी नीचे की ओर)
कार्य पूर्णांक_भाग(संख्या अ, संख्या ब) {
    संख्या भ = अ / ब;
    यदि ((अ % ब) != 0) {
        यदि ((अ < 0) != (ब < 0)) { परत् भ - 1; }
    }
    परत् भ;
}

// गणितीय शेष (सदा 0..|ब|-1 की ओर)
कार्य गणित_शेष(संख्या अ, संख्या ब) {
    संख्या श = अ % ब;
    यदि (श != 0) {
        यदि ((श < 0) != (ब < 0)) { परत् श + ब; }
    }
    परत् श;
}

// पूर्णांक घात (अ^घ, घ >= 0)
कार्य घातांक(संख्या अ, संख्या घ) {
    संख्या फल = 1;
    संख्या इ = 0;
    यावत् (इ < घ) {
        फल = फल * अ;
        इ = इ + 1;
    }
    परत् फल;
}

// ===== संख्या-सिद्धांत =====

// महत्तम समापवर्तक (यूक्लिड)
कार्य गसो(संख्या अ, संख्या ब) {
    संख्या क = पूर्ण_निरपेक्ष(अ);
    संख्या ख = पूर्ण_निरपेक्ष(ब);
    यावत् (ख != 0) {
        संख्या त = ख;
        ख = क % ख;
        क = त;
    }
    परत् क;
}

// लघुत्तम समापवर्त्य
कार्य लसो(संख्या अ, संख्या ब) {
    यदि (अ == 0 || ब == 0) { परत् 0; }
    परत् पूर्ण_निरपेक्ष(अ / गसो(अ, ब) * ब);
}

// गुणनखंड (क! , क >= 0)
कार्य गुणनखंड(संख्या क) {
    संख्या फल = 1;
    संख्या इ = 2;
    यावत् (इ <= क) {
        फल = फल * इ;
        इ = इ + 1;
    }
    परत् फल;
}

// क्या क अभाज्य है?
कार्य अभाज्य_है(संख्या क) {
    यदि (क < 2) { परत् असत्य; }
    यदि (क < 4) { परत् सत्य; }
    यदि ((क % 2) == 0) { परत् असत्य; }
    संख्या इ = 3;
    यावत् (इ * इ <= क) {
        यदि ((क % इ) == 0) { परत् असत्य; }
        इ = इ + 2;
    }
    परत् सत्य;
}

// अभाज्य गुणनखंड सूची: 12 → [2, 2, 3]
कार्य अभाज्य_गुणनखंड(संख्या क) {
    सूची फल = [];
    संख्या नन = पूर्ण_निरपेक्ष(क);
    संख्या भ = 2;
    यावत् (भ * भ <= नन) {
        यावत् ((नन % भ) == 0) {
            फल = जोड़ें(फल, भ);
            नन = नन / भ;
        }
        भ = भ + 1;
    }
    यदि (नन > 1) { फल = जोड़ें(फल, नन); }
    परत् फल;
}

// पहले क अभाज्य (एराटोस्थनीज़ नहीं, सरल छानना)
कार्य अभाज्य_तक(संख्या सीमा) {
    सूची फल = [];
    संख्या इ = 2;
    यावत् (इ <= सीमा) {
        यदि (अभाज्य_है(इ)) { फल = जोड़ें(फल, इ); }
        इ = इ + 1;
    }
    परत् फल;
}

// n-वाँ फ़िबोनाची (0-आधारित: 0,1,1,2,3,5,...)
कार्य फिबोनाची(संख्या क) {
    यदि (क <= 0) { परत् 0; }
    संख्या अ = 0;
    संख्या ब = 1;
    संख्या इ = 1;
    यावत् (इ < क) {
        संख्या त = अ + ब;
        अ = ब;
        ब = त;
        इ = इ + 1;
    }
    परत् ब;
}

// ===== सांख्यिकी (संख्या-सूची पर) =====

कार्य औसत(सूची स) {
    यदि (लंबाई(स) == 0) { परत् 0; }
    मान कुल = 0;
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        कुल = कुल + स[इ];
        इ = इ + 1;
    }
    परत् कुल / लंबाई(स);
}

// माध्यिका (सूची क्रमबद्ध की जाती है)
कार्य माध्यिका(सूची स) {
    संख्या नन = लंबाई(स);
    यदि (नन == 0) { परत् 0; }
    सूची क = गणित_क्रमबद्ध(स);
    संख्या म = नन / 2;
    यदि ((नन % 2) == 1) { परत् क[म]; }
    परत् (क[म - 1] + क[म]) / 2;
}

// बहुलक (सबसे बार आने वाला; टाई पर पहला)
कार्य बहुलक(सूची स) {
    यदि (लंबाई(स) == 0) { परत् शून्यम्; }
    मान श्रेष्ठ = स[0];
    संख्या श्रेष्ठ_गण = 0;
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        संख्या ग = 0;
        संख्या ज = 0;
        यावत् (ज < लंबाई(स)) {
            यदि (स[ज] == स[इ]) { ग = ग + 1; }
            ज = ज + 1;
        }
        यदि (ग > श्रेष्ठ_गण) {
            श्रेष्ठ_गण = ग;
            श्रेष्ठ = स[इ];
        }
        इ = इ + 1;
    }
    परत् श्रेष्ठ;
}

// प्रसरण (जनसंख्या)
कार्य प्रसरण(सूची स) {
    संख्या नन = लंबाई(स);
    यदि (नन == 0) { परत् 0; }
    मान मा = औसत(स);
    मान कुल = 0;
    संख्या इ = 0;
    यावत् (इ < नन) {
        मान अंतर = स[इ] - मा;
        कुल = कुल + (अंतर * अंतर);
        इ = इ + 1;
    }
    परत् कुल / नन;
}

// मानक विचलन
कार्य मानक_विचलन(सूची स) {
    परत् वर्गमूल(प्रसरण(स) * 1.0);
}

// परिसर (अधिकतम − न्यूनतम)
कार्य परिसर(सूची स) {
    यदि (लंबाई(स) == 0) { परत् 0; }
    मान न्यून = स[0];
    मान महत् = स[0];
    संख्या इ = 1;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] < न्यून) { न्यून = स[इ]; }
        यदि (स[इ] > महत्) { महत् = स[इ]; }
        इ = इ + 1;
    }
    परत् महत् - न्यून;
}

// ===== PRNG (MINSTD — बीज-योग्य, नियतात्मक) =====
// सूत्र में बिटवार संक्रिया नहीं तो xorshift संभव नहीं। MINSTD शुद्ध
// अंकगणित है: बीज = (बीज × 16807) mod (2^31 − 1)।
// पुस्तकालय-मॉड्यूल global — आयात करने वाले प्रोग्राम के __शीर्ष में
// initializer चलता है।

संख्या गणित_बीज = 16807;

// बीज सेट करो (धनात्मक अशून्य मान दो)
कार्य यादृच्छिक_बीज(संख्या मान_स) {
    संख्या ब = पूर्ण_निरपेक्ष(मान_स) % 2147483647;
    यदि (ब == 0) { ब = 1; }
    गणित_बीज = ब;
    परत् 0;
}

// अगला कच्चा यादृच्छिक: 1 .. 2^31 − 2
कार्य यादृच्छिक_अगला() {
    गणित_बीज = (गणित_बीज * 16807) % 2147483647;
    परत् गणित_बीज;
}

// [0, 1) दशमलव
कार्य यादृच्छिक() {
    परत् (यादृच्छिक_अगला() * 1.0) / 2147483647.0;
}

// पूर्णांक [न्यून, उच्च] (दोनों सम्मिलित)
कार्य यादृच्छिक_परास(संख्या न्यून, संख्या उच्च) {
    यदि (उच्च <= न्यून) { परत् न्यून; }
    संख्या चौड़ाई = उच्च - न्यून + 1;
    परत् न्यून + (यादृच्छिक_अगला() % चौड़ाई);
}

// सूची से यादृच्छिक तत्व (रिक्त → शून्यम्)
कार्य यादृच्छिक_तत्व(सूची स) {
    यदि (लंबाई(स) == 0) { परत् शून्यम्; }
    परत् स[यादृच्छिक_परास(0, लंबाई(स) - 1)];
}

// फ़िशर-येट्स फेंटना — नई सूची लौटाता है
कार्य फेंटो(सूची स) {
    सूची फल = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        फल = जोड़ें(फल, स[इ]);
        इ = इ + 1;
    }
    संख्या ज = लंबाई(फल) - 1;
    यावत् (ज > 0) {
        संख्या क = यादृच्छिक_परास(0, ज);
        मान त = फल[ज];
        फल[ज] = फल[क];
        फल[क] = त;
        ज = ज - 1;
    }
    परत् फल;
}

// ===== आंतरिक =====
// सांख्यिकी को क्रमण चाहिए पर सूची.सूत्र पर निर्भरता से बचने के लिए
// अपना छोटा मर्ज-सॉर्ट।
कार्य गणित_विलय(सूची अ, सूची ब) {
    सूची फल = [];
    संख्या इ = 0;
    संख्या ज = 0;
    यावत् (इ < लंबाई(अ) && ज < लंबाई(ब)) {
        यदि (अ[इ] <= ब[ज]) { फल = जोड़ें(फल, अ[इ]); इ = इ + 1; }
        अन्यथा { फल = जोड़ें(फल, ब[ज]); ज = ज + 1; }
    }
    यावत् (इ < लंबाई(अ)) { फल = जोड़ें(फल, अ[इ]); इ = इ + 1; }
    यावत् (ज < लंबाई(ब)) { फल = जोड़ें(फल, ब[ज]); ज = ज + 1; }
    परत् फल;
}
कार्य गणित_क्रमबद्ध(सूची स) {
    यदि (लंबाई(स) <= 1) { परत् स; }
    संख्या म = लंबाई(स) / 2;
    सूची बा = [];
    सूची दा = [];
    संख्या इ = 0;
    यावत् (इ < म) { बा = जोड़ें(बा, स[इ]); इ = इ + 1; }
    यावत् (इ < लंबाई(स)) { दा = जोड़ें(दा, स[इ]); इ = इ + 1; }
    परत् गणित_विलय(गणित_क्रमबद्ध(बा), गणित_क्रमबद्ध(दा));
}
