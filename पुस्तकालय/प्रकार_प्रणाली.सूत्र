}

// मुख्य मिलान फलन (Pattern Match Dispatcher)
कार्य मिलान_करो(मान लक्ष्य, सूची नियम_सूची) {
    संख्या इ = ०;
    यावत् (इ < लंबाई(नियम_सूची)) {
        शब्दकोश नियम = नियम_सूची[इ];
        पाठ नियम_प्रकार = नियम["प्रकार"];

        यदि (नियम_प्रकार == "मूल्य") {
            यदि (लक्ष्य == नियम["अपेक्षित"]) {
                परत् नियम["परिणाम"];
            }
        } अन्यथा यदि (नियम_प्रकार == "प्रकार") {
            यदि (प्रकार(लक्ष्य) == नियम["अपेक्षित"]) {
                परत् नियम["परिणाम"];
            }
        } अन्यथा यदि (नियम_प्रकार == "सीमा") {
            यदि (प्रकार(लक्ष्य) == "संख्या" || प्रकार(लक्ष्य) == "दशमलव") {
                यदि (लक्ष्य >= नियम["न्यूनतम"] && लक्ष्य <= नियम["अधिकतम"]) {
                    परत् नियम["परिणाम"];
                }
            }
        } अन्यथा यदि (नियम_प्रकार == "गणन") {
            यदि (प्रकार(लक्ष्य) == "शब्दकोश" && कुंजी_है(लक्ष्य, "_प्रकार")) {
                यदि (लक्ष्य["_प्रकार"] == "गणन" && गणन_तुल्य(लक्ष्य, नियम["अपेक्षित"])) {
                    परत् नियम["परिणाम"];
                }
            }
        } अन्यथा यदि (नियम_प्रकार == "एडिटी") {
            यदि (प्रकार(लक्ष्य) == "शब्दकोश" && कुंजी_है(लक्ष्य, "_प्रकार")) {
                यदि (लक्ष्य["_प्रकार"] == "एडिटी" && लक्ष्य["_विकल्प"] == नियम["विकल्प"]) {
                    परत् नियम["परिणाम"];
                }
            }
        } अन्यथा यदि (नियम_प्रकार == "संरचना") {
            यदि (प्रकार(लक्ष्य) == "शब्दकोश" && कुंजी_है(लक्ष्य, "_प्रकार")) {
                यदि (लक्ष्य["_प्रकार"] == "संरचना" && लक्ष्य["_संरचना_नाम"] == नियम["संरचना_नाम"]) {
                    परत् नियम["परिणाम"];
                }
            }
        } अन्यथा यदि (नियम_प्रकार == "सूची_लंबाई") {
            यदि (प्रकार(लक्ष्य) == "सूची" && लंबाई(लक्ष्य) == नियम["लंबाई"]) {
                परत् नियम["परिणाम"];
            }
        } अन्यथा यदि (नियम_प्रकार == "अन्यथा") {
            परत् नियम["परिणाम"];
        }

        इ = इ + १;
    }

    // यदि कोई नियम मेल नहीं खाता तो अपवाद
    फेको "त्रुटिः अपूर्ण प्रतिरूप मिलान: दिए गए लक्ष्य हेतु कोई मेल नहीं मिला।";
}

// ==============================================================================
// भाग ४: संकलन-कालीन स्थिर गणना (Comptime / Pure Memoized Execution)
// ==============================================================================

शब्दकोश वैश्विक_स्थिर_स्मृति = {};

कार्य स्थिर_गणना_प्राप्त(पाठ कुंजी) {
    यदि (कुंजी_है(वैश्विक_स्थिर_स्मृति, कुंजी)) {
        परत् वैश्विक_स्थिर_स्मृति[कुंजी];
    }
    परत् शून्यम्;
}

कार्य स्थिर_गणना_रखो(पाठ कुंजी, मान मूल्य) {
    वैश्विक_स्थिर_स्मृति[कुंजी] = मूल्य;
    परत् मूल्य;
}

कार्य स्थिर_गणना_रिक्त_करो() {
    वैश्विक_स्थिर_स्मृति = {};
    परत् सत्य;
}
