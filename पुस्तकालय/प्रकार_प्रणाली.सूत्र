}

कार्य मिलान_सूची_लंबाई(संख्या अपेक्षित_लंबाई, मान परिणाम) {
    शब्दकोश नियम = {};
    नियम["प्रकार"] = "सूची_लंबाई";
    नियम["लंबाई"] = अपेक्षित_लंबाई;
