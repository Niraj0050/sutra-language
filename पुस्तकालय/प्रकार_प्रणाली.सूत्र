कार्य गणन_रचना(पाठ गणन_नाम, सूची विकल्प_सूची) {
    शब्दकोश गणन_ढाँचा = {};
    गणन_ढाँचा["_मेटा_प्रकार"] = "गणन_परिभाषा";
    गणन_ढाँचा["नाम"] = गणन_नाम;
    गणन_ढाँचा["विकल्प"] = विकल्प_सूची;

    संख्या इ = ०;
    यावत् (इ < लंबाई(विकल्प_सूची)) {
        पाठ विक_नाम = विकल्प_सूची[इ];
        शब्दकोश रूपांतर = {};
        रूपांतर["_प्रकार"] = "गणन";
        रूपांतर["_गणन_नाम"] = गणन_नाम;
        रूपांतर["_विकल्प"] = विक_नाम;
        रूपांतर["_सूचकांक"] = इ;
        रूपांतर["डेटा"] = शून्यम्;

        गणन_ढाँचा[विक_नाम] = रूपांतर;
        इ = इ + १;
    }

    परत् गणन_ढाँचा;
}

// बीजगणितीय डेटा प्रकार (ADT with Associated Values)
कार्य एडिटी_रचना(पाठ एडिटी_नाम, सूची विकल्प_विन्यास) {
    शब्दकोश एडिटी_ढाँचा = {};
    एडिटी_ढाँचा["_मेटा_प्रकार"] = "एडिटी_परिभाषा";
    एडिटी_ढाँचा["नाम"] = एडिटी_नाम;

    शब्दकोश विकल्प_मानचित्र = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(विकल्प_विन्यास)) {
        शब्दकोश वि = विकल्प_विन्यास[इ];
        विकल्प_मानचित्र[वि["नाम"]] = वि["फ़ील्ड"];
        इ = इ + १;
    }
    एडिटी_ढाँचा["विन्यास"] = विकल्प_मानचित्र;
    परत् एडिटी_ढाँचा;
}

कार्य एडिटी_निर्माण(शब्दकोश एडिटी_ढाँचा, पाठ विकल्प_नाम, सूची मान_सूची) {
    शब्दकोश विन्यास = एडिटी_ढाँचा["विन्यास"];
    यदि (न कुंजी_है(विन्यास, विकल्प_नाम)) {
        फेको "त्रुटिः एडिटी '" + एडिटी_ढाँचा["नाम"] + "' में अज्ञात विकल्प '" + विकल्प_नाम + "'";
    }

    सूची अपेक्षित_फ़ील्ड = विन्यास[विकल्प_नाम];
    यदि (लंबाई(अपेक्षित_फ़ील्ड) != लंबाई(मान_सूची)) {
        फेको "त्रुटिः एडिटी विकल्प '" + विकल्प_नाम + "' हेतु " + लंबाई(अपेक्षित_फ़ील्ड) + " तर्कों की अपेक्षा थी।";
    }

    शब्दकोश वस्तु = {};
    वस्तु["_प्रकार"] = "एडिटी";
    वस्तु["_एडिटी_नाम"] = एडिटी_ढाँचा["नाम"];
    वस्तु["_विकल्प"] = विकल्प_नाम;

    शब्दकोश फ़ील्ड_डेटा = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(अपेक्षित_फ़ील्ड)) {
        फ़ील्ड_डेटा[अपेक्षित_फ़ील्ड[इ]] = मान_सूची[इ];
        इ = इ + १;
    }
    वस्तु["डेटा"] = फ़ील्ड_डेटा;
    परत् वस्तु;
}

कार्य गणन_तुल्य(शब्दकोश ग१, शब्दकोश ग२) {
    यदि (ग१ == शून्यम् || ग२ == शून्यम्) { परत् असत्य; }
    यदि (न कुंजी_है(ग१, "_प्रकार") || न कुंजी_है(ग२, "_प्रकार")) { परत् असत्य; }
    यदि (ग१["_प्रकार"] != ग२["_प्रकार"]) { परत् असत्य; }

    यदि (ग१["_प्रकार"] == "गणन") {
        परत् ग१["_गणन_नाम"] == ग२["_गणन_नाम"] && ग१["_विकल्प"] == ग२["_विकल्प"];
    } अन्यथा यदि (ग१["_प्रकार"] == "एडिटी") {
        परत् ग१["_एडिटी_नाम"] == ग२["_एडिटी_नाम"] && ग१["_विकल्प"] == ग२["_विकल्प"];
    }
    परत् असत्य;
}

// ==============================================================================
// भाग २: प्रयोक्ता-परिभाषित संरचना (User-Defined Structs with Validation)
