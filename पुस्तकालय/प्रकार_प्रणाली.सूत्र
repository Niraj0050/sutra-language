// नियम निर्माता (Pattern Rule Constructors)

कार्य मिलान_मान(मान अपेक्षित_मूल्य, मान परिणाम) {
    शब्दकोश नियम = {};
    नियम["प्रकार"] = "मूल्य";
    नियम["अपेक्षित"] = अपेक्षित_मूल्य;
    नियम["परिणाम"] = परिणाम;
    परत् नियम;
}

