कार्य प्रकार_सत्यापन(मान मूल्य, पाठ अपेक्षित_प्रकार) {
    पाठ वास्तविक = प्रकार(मूल्य);
    यदि (अपेक्षित_प्रकार == "मान" || अपेक्षित_प्रकार == "सर्व") {
        परत् सत्य;
    }
    यदि (अपेक्षित_प्रकार == "संख्या" && वास्तविक == "संख्या") {
        परत् सत्य;
    }
    यदि (अपेक्षित_प्रकार == "दशमलव" && (वास्तविक == "दशमलव" || वास्तविक == "संख्या")) {
        परत् सत्य;
    }
    यदि (अपेक्षित_प्रकार == "पाठ" && वास्तविक == "पाठ") {
        परत् सत्य;
    }
    यदि (अपेक्षित_प्रकार == "बूल" && वास्तविक == "बूल") {
        परत् सत्य;
    }
    यदि (अपेक्षित_प्रकार == "सूची" && वास्तविक == "सूची") {
        परत् सत्य;
    }
    यदि (अपेक्षित_प्रकार == "शब्दकोश" && वास्तविक == "शब्दकोश") {
        परत् सत्य;
    }
    परत् असत्य;
}

कार्य संरचना_रचना(पाठ संरचना_नाम, शब्दकोश स्कीमा_मानचित्र) {
    शब्दकोश संरचना_ढाँचा = {};
    संरचना_ढाँचा["_मेटा_प्रकार"] = "संरचना_परिभाषा";
    संरचना_ढाँचा["नाम"] = संरचना_नाम;
    संरचना_ढाँचा["स्कीमा"] = स्कीमा_मानचित्र;
    परत् संरचना_ढाँचा;
}

कार्य संरचना_नवीन(शब्दकोश संरचना_ढाँचा, शब्दकोश मान_मानचित्र) {
    शब्दकोश स्कीमा = संरचना_ढाँचा["स्कीमा"];
    सूची क्षेत्र_सूची = कुंजियाँ(स्कीमा);

    शब्दकोश मान्य_मान = {};
    संख्या इ = ०;
    यावत् (इ < लंबाई(क्षेत्र_सूची)) {
        पाठ क = क्षेत्र_सूची[इ];
        पाठ अपेक्षित_प्रकार = स्कीमा[क];

        यदि (न कुंजी_है(मान_मानचित्र, क)) {
            फेको "त्रुटिः संरचना '" + संरचना_ढाँचा["नाम"] + "' में आवश्यक फ़ील्ड '" + क + "' अनुपस्थित है।";
        }

        मान दिया_गया_मान = मान_मानचित्र[क];
        यदि (न प्रकार_सत्यापन(दिया_गया_मान, अपेक्षित_प्रकार)) {
            फेको "त्रुटिः संरचना '" + संरचना_ढाँचा["नाम"] + "' की फ़ील्ड '" + क + "' हेतु '" + अपेक्षित_प्रकार + "' अपेक्षित था, मिला '" + प्रकार(दिया_गया_मान) + "'";
        }

        मान्य_मान[क] = दिया_गया_मान;
        इ = इ + १;
    }

    शब्दकोश वस्तु = {};
    वस्तु["_प्रकार"] = "संरचना";
    वस्तु["_संरचना_नाम"] = संरचना_ढाँचा["नाम"];
    वस्तु["मान"] = मान्य_मान;
    परत् वस्तु;
}

कार्य संरचना_प्राप्त(शब्दकोश वस्तु, पाठ फ़ील्ड) {
    यदि (वस्तु == शून्यम् || न कुंजी_है(वस्तु, "मान")) {
        फेको "त्रुटिः अवैध संरचना उदाहरण।";
    }
    शब्दकोश मान_संग्रह = वस्तु["मान"];
    यदि (न कुंजी_है(मान_संग्रह, फ़ील्ड)) {
        फेको "त्रुटिः संरचना '" + वस्तु["_संरचना_नाम"] + "' में फ़ील्ड '" + फ़ील्ड + "' अप्राप्त।";
    }
    परत् मान_संग्रह[फ़ील्ड];
}

कार्य संरचना_निर्धारित(शब्दकोश वस्तु, शब्दकोश संरचना_ढाँचा, पाठ फ़ील्ड, मान नया_मान) {
    शब्दकोश स्कीमा = संरचना_ढाँचा["स्कीमा"];
    यदि (न कुंजी_है(स्कीमा, फ़ील्ड)) {
        फेको "त्रुटिः संरचना '" + संरचना_ढाँचा["नाम"] + "' में अज्ञात फ़ील्ड '" + फ़ील्ड + "'";
    }

    पाठ अपेक्षित = स्कीमा[फ़ील्ड];
    यदि (न प्रकार_सत्यापन(नया_मान, अपेक्षित)) {
        फेको "त्रुटिः प्रकार विसंगति: फ़ील्ड '" + फ़ील्ड + "' हेतु '" + अपेक्षित + "' अपेक्षित।";
    }

    वस्तु["मान"][फ़ील्ड] = नया_मान;
    परत् वस्तु;
}

