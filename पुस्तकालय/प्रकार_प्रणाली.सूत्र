    नियम["परिणाम"] = परिणाम;
    परत् नियम;
}

कार्य मिलान_गणन(शब्दकोश अपेक्षित_गणन, मान परिणाम) {
    शब्दकोश नियम = {};
    नियम["प्रकार"] = "गणन";
