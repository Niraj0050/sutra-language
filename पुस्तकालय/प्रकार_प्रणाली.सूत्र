}

कार्य मिलान_एडिटी(पाठ विकल्प_नाम, मान परिणाम) {
    शब्दकोश नियम = {};
    नियम["प्रकार"] = "एडिटी";
    नियम["विकल्प"] = विकल्प_नाम;
