// IAST रोमन पाठ (सिर्फ़ लोअरकेस, मानक परंपरा) → देवनागरी
कार्य रोमन_से_देवनागरी(पाठ स) {
    पाठ फल = "";
    संख्या ल = लंबाई(स);
    संख्या इ = ०;
    मान लंबित_व्यंजन = असत्य;
    यावत् (इ < ल) {
        शब्दकोश टो = द_रोमन_टोकन(स, इ);
        संख्या प्रकार = टो["प्रकार"];
        यदि (प्रकार == ०) {
            यदि (लंबित_व्यंजन) { फल = फल + "्"; }          // पिछला व्यंजन बिना स्वर — मृत
            फल = फल + द_व्यं_देव(टो["कोड"]);
            लंबित_व्यंजन = सत्य;
        } अन्यथा यदि (प्रकार == १) {
            यदि (लंबित_व्यंजन) {
                यदि (टो["कोड"] != ०) { फल = फल + द_स्वर_मात्रा_देव(टो["कोड"]); }
                // कोड==० ('a') — निहित स्वर, कुछ मत जोड़ो
            } अन्यथा {
                फल = फल + द_स्वर_इंड_देव(टो["कोड"]);
            }
            लंबित_व्यंजन = असत्य;
        } अन्यथा {
            यदि (लंबित_व्यंजन) { फल = फल + "्"; }
            लंबित_व्यंजन = असत्य;
            यदि (प्रकार == २) { फल = फल + "ं"; }
            यदि (प्रकार == ३) { फल = फल + "ः"; }
            यदि (प्रकार == ४) { फल = फल + "ँ"; }
            यदि (प्रकार == ५) { फल = फल + "ऽ"; }
            यदि (प्रकार == ६) { फल = फल + "।"; }
            यदि (प्रकार == ७) { फल = फल + "॥"; }
            यदि (प्रकार == ८) { फल = फल + देवनागरी_अंक_वर्ण(टो["कोड"]); }
            यदि (प्रकार == ९) { फल = फल + "ॐ"; }
            यदि (प्रकार == १०) { फल = फल + उपखंड(स, इ, इ + टो["लंबाई"]); }
        }
        इ = इ + टो["लंबाई"];
    }
    यदि (लंबित_व्यंजन) { फल = फल + "्"; }                    // पाठ के अंत में मृत व्यंजन
    परत् फल;
}
