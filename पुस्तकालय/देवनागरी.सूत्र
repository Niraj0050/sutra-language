// कोड ० ('a', निहित स्वर) की कोई मात्रा नहीं — खाली पाठ
कार्य द_स्वर_मात्रा_देव(संख्या कोड) {
    यदि (कोड == ०) { परत् ""; }
    यदि (कोड == १) { परत् "ा"; } यदि (कोड == २) { परत् "ि"; }
    यदि (कोड == ३) { परत् "ी"; } यदि (कोड == ४) { परत् "ु"; }
    यदि (कोड == ५) { परत् "ू"; } यदि (कोड == ६) { परत् "ृ"; }
    यदि (कोड == ७) { परत् "ॄ"; } यदि (कोड == ८) { परत् "ॢ"; }
    यदि (कोड == ९) { परत् "ॣ"; } यदि (कोड == १०) { परत् "े"; }
    यदि (कोड == ११) { परत् "ै"; } यदि (कोड == १२) { परत् "ो"; }
    यदि (कोड == १३) { परत् "ौ"; }
    परत् शून्यम्;
}

// आंतरिक: स्थिति पर एक IAST टोकन पहचानो (सबसे लंबा पहले — kh से पहले k नहीं मिलना चाहिए)।
// लौटाता है {"प्रकार", "कोड"?, "लंबाई"} — प्रकार: ०=व्यंजन १=स्वर २=अनुस्वार ३=विसर्ग
// ४=चंद्रबिंदु ५=अवग्रह ६=दंड ७=द्विदंड ८=अंक ९=ॐ १०=अपरिचित(ज्यों-का-त्यों)
कार्य द_रोमन_टोकन(पाठ स, संख्या स्थिति) {
    शब्दकोश फल = {};
    संख्या ल = लंबाई(स);
    यदि (स्थिति + २ <= ल && उपखंड(स, स्थिति, स्थिति + २) == "oṃ") {
        फल["प्रकार"] = ९; फल["लंबाई"] = २; परत् फल;
    }
    यदि (स्थिति + २ <= ल) {
        पाठ द्वि = उपखंड(स, स्थिति, स्थिति + २);
        यदि (द्वि == "kh") { फल["प्रकार"] = ०; फल["कोड"] = १; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "gh") { फल["प्रकार"] = ०; फल["कोड"] = ३; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "ch") { फल["प्रकार"] = ०; फल["कोड"] = ६; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "jh") { फल["प्रकार"] = ०; फल["कोड"] = ८; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "ṭh") { फल["प्रकार"] = ०; फल["कोड"] = ११; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "ḍh") { फल["प्रकार"] = ०; फल["कोड"] = १३; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "th") { फल["प्रकार"] = ०; फल["कोड"] = १६; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "dh") { फल["प्रकार"] = ०; फल["कोड"] = १८; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "ph") { फल["प्रकार"] = ०; फल["कोड"] = २१; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "bh") { फल["प्रकार"] = ०; फल["कोड"] = २३; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "ai") { फल["प्रकार"] = १; फल["कोड"] = ११; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "au") { फल["प्रकार"] = १; फल["कोड"] = १३; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "m̐") { फल["प्रकार"] = ४; फल["लंबाई"] = २; परत् फल; }
        यदि (द्वि == "..") { फल["प्रकार"] = ७; फल["लंबाई"] = २; परत् फल; }
    }
    पाठ च = उपखंड(स, स्थिति, स्थिति + १);
    संख्या कू = अक्षर_मान(च);
    यदि (च == "k") { फल["प्रकार"] = ०; फल["कोड"] = ०; फल["लंबाई"] = १; परत् फल; }
    यदि (च == "g") { फल["प्रकार"] = ०; फल["कोड"] = २; फल["लंबाई"] = १; परत् फल; }
    यदि (कू == १७४९) { फल["प्रकार"] = ०; फल["कोड"] = ४; फल["लंबाई"] = १; परत् फल; }
    यदि (च == "c") { फल["प्रकार"] = ०; फल["कोड"] = ५; फल["लंबाई"] = १; परत् फल; }
