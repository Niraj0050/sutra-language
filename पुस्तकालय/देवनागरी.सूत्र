// पुस्तकालय/देवनागरी.सूत्र — देवनागरी-विशिष्ट पाठ-उपयोगिताएँ
// ============================================================
// आयात "पुस्तकालय/देवनागरी.सूत्र";
//
// अक्षर (orthographic syllable / grapheme cluster) विभाजन — कोड-पॉइंट नहीं, असली
// उच्चारण-इकाई। "क्ष" (क + ् + ष, ३ कोड-पॉइंट) एक अक्षर है, "स्ते" (स + ् + त + े,
// ४ कोड-पॉइंट) भी एक। सामान्य `लंबाई`/`उपखंड` कोड-पॉइंट गिनते — संयुक्ताक्षर वाले
// पाठ में यह ग़लत "अक्षर गिनती"/उलटाव/कर्सर-चाल देता। यहाँ की गिनती असली है:
//
//   देवनागरी_अक्षर_सूची("क्षत्रिय")   // ["क्ष", "त्रि", "य"]        — ३, कोड-पॉइंट से ६
//   देवनागरी_अक्षर_सूची("नमस्ते")     // ["न", "म", "स्ते"]          — ३, कोड-पॉइंट से ६
//   देवनागरी_अक्षर_सूची("संस्कृत")    // ["सं", "स्कृ", "त"]         — ३, कोड-पॉइंट से ६
//   देवनागरी_अक्षर_गणना("सूत्र")      // २  ("सू", "त्र")
//   देवनागरी_अक्षर_पर("हिन्दी", १)    // "न्दी"
//
// अंक-रूपांतरण — पूर्णांक ⇄ देवनागरी-अंक पाठ, और आम पाठ के भीतर अंक बदलना:
//
//   देवनागरी_अंक_से_पाठ(१२३)          // "१२३"
//   देवनागरी_पाठ_से_अंक("१२३")        // १२३  (गिनकर वापस)
//   देवनागरी_अंकों_में("कमरा 12")     // "कमरा १२"   (सिर्फ़ ०-९ बदलते, बाक़ी अछूता)
//   देवनागरी_अंकों_से("कमरा १२")      // "कमरा 12"
//
// ⚠️ **यह देवनागरी-विशिष्ट है, Unicode के सामान्य UAX #29 grapheme-cluster
// एल्गोरिद्म (जो हर लिपि पर, यहाँ तक कि मिश्रित/अमान्य पाठ पर भी काम करने का
// दावा करता) की पूर्ण प्रतिकृति नहीं। असली देवनागरी पाठ (शब्द, वाक्य, संयुक्ताक्षर,
// मात्राएँ, अनुस्वार/विसर्ग/चंद्रबिंदु, नुक्ता — दोनों रूपों में, वैदिक स्वर-चिह्न)
// पर Node २४ (ICU) के `Intl.Segmenter('hi',{granularity:'grapheme'})` के विरुद्ध
// जाँचा — बराबर। अमान्य/टूटा हुआ पाठ (जैसे शुरुआत में बिना आधार-अक्षर के अकेली
// मात्रा, या देवनागरी-मात्रा सीधे किसी अंग्रेज़ी/अंक वर्ण के बाद) पर कभी-कभी अलग
// विभाजन देता (कभी क्रैश नहीं, कभी कोड-पॉइंट खोता/दोहराता नहीं — सिर्फ़ ऐसी
// निरर्थक स्थिति में समूहन की चाल Unicode के सर्व-लिपि नियम से अलग) — असली
// देवनागरी पाठ में यह अंतर कभी नहीं आता।
// ============================================================

// ===== वर्ग-वर्गीकरण (आंतरिक) =====
// कोड-पॉइंट को एक वर्ग-कूट देता — अक्षर-विभाजन का आधार।
// ० स्वतंत्र-स्वर(अ..औ आदि) १ व्यंजन(क..ह आदि) २ हलन्त(्) ३ नुक्ता(़)
// ४ ZWJ/ZWNJ ५ मात्रा ६ वैदिक-स्वर-चिह्न ७ अनुस्वार/विसर्ग/चंद्रबिंदु ८ अन्य
कार्य देवनागरी_वर्ग(संख्या कू) {
    यदि (कू >= २३०८ && कू <= २३२४) { परत् ०; }             // अ..औ (सहित पुराना ऄ)
    यदि (कू == २४०० || कू == २४०१) { परत् ०; }             // ॠ ॡ (स्वतंत्र वैदिक स्वर)
    यदि (कू >= २४१८ && कू <= २४२३) { परत् ०; }             // विस्तारित स्वतंत्र स्वर
    यदि (कू >= २३२५ && कू <= २३६१) { परत् १; }             // क..ह
    यदि (कू >= २३९२ && कू <= २३९९) { परत् १; }             // क़..य़ (पूर्व-संयोजित नुक्ता-व्यंजन)
    यदि (कू >= २४२४ && कू <= २४३१) { परत् १; }             // विस्तारित व्यंजन
    यदि (कू == २३८१) { परत् २; }                           // ् हलन्त/विराम
    यदि (कू == २३६४) { परत् ३; }                           // ़ नुक्ता (संयोजक रूप)
    यदि (कू == ८२०५ || कू == ८२०४) { परत् ४; }             // ZWJ / ZWNJ
    यदि (कू >= २३६२ && कू <= २३६३) { परत् ५; }             // कश्मीरी स्वर-चिह्न
    यदि (कू >= २३६६ && कू <= २३८०) { परत् ५; }             // मुख्य मात्राएँ
    यदि (कू == २३८२ || कू == २३८३) { परत् ५; }             // अतिरिक्त मात्राएँ
    यदि (कू >= २३८९ && कू <= २३९१) { परत् ५; }             // वैदिक स्वराघात मात्राएँ
    यदि (कू >= २४०२ && कू <= २४०३) { परत् ५; }             // वोकैलिक मात्राएँ (ऌ ॡ की)
    यदि (कू >= २३८५ && कू <= २३८८) { परत् ६; }             // वैदिक स्वर-चिह्न
    यदि (कू >= २३०४ && कू <= २३०७) { परत् ७; }             // चंद्रबिंदु/अनुस्वार/विसर्ग
    परत् ८;
}

// ===== अक्षर (orthographic syllable) विभाजन =====

// पाठ को अक्षरों की सूची में तोड़ो (हर तत्व एक पूरा उच्चारण-योग्य अक्षर, संयुक्ताक्षर सहित)
कार्य देवनागरी_अक्षर_सूची(पाठ स) {
    सूची फल = [];
    संख्या ल = लंबाई(स);
    संख्या इ = ०;
    यावत् (इ < ल) {
        संख्या व0 = देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, इ, इ + १)));
        यदि (व0 != ० && व0 != १) {
            // स्वतंत्र-स्वर/व्यंजन नहीं — पंक्चुएशन/अंक/अन्य-लिपि/भटका हुआ चिह्न: अकेला अक्षर
            फल = जोड़ें(फल, उपखंड(स, इ, इ + १));
            इ = इ + १;
            जारीरह;
        }
        संख्या ज = इ + १;
        // वैकल्पिक नुक्ता (आधार के ठीक बाद, संयोजक रूप — पूर्व-संयोजित रूप पहले ही वर्ग १ में)
        यदि (ज < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, ज, ज + १))) == ३) { ज = ज + १; }
        // संयुक्ताक्षर शृंखला: (हलन्त (ZWJ/ZWNJ)? व्यंजन (नुक्ता)?)*
        यावत् (ज < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, ज, ज + १))) == २) {
            संख्या क = ज + १;
            यदि (क < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, क, क + १))) == ४) { क = क + १; }
            यदि (क < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, क, क + १))) == १) {
                क = क + १;
                यदि (क < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, क, क + १))) == ३) { क = क + १; }
                ज = क;
            } अन्यथा {
                ज = क;   // अंतिम हलन्त (मृत व्यंजन), शायद अकेले ZWJ/ZWNJ सहित — यहीं रुको
                विरामः;
            }
        }
        // मात्रा/वैदिक-चिह्न/अनुस्वार-विसर्ग — किसी भी क्रम में, जितने भी हों (असली पाठ में
        // कभी एक से ज़्यादा मात्रा नहीं आती; यह सिर्फ़ भटके/दोहरे इनपुट पर मज़बूती के लिए)
        यावत् (ज < ल) {
            संख्या व = देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, ज, ज + १)));
            यदि (व != ५ && व != ६ && व != ७) { विरामः; }
            ज = ज + १;
        }
        फल = जोड़ें(फल, उपखंड(स, इ, ज));
        इ = ज;
    }
    परत् फल;
}

// अक्षरों की गिनती (पूरी सूची बनाए बिना — सिर्फ़ गिनना हो तो यह तेज़)
कार्य देवनागरी_अक्षर_गणना(पाठ स) {
    संख्या गिनती = ०;
    संख्या ल = लंबाई(स);
    संख्या इ = ०;
    यावत् (इ < ल) {
        संख्या व0 = देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, इ, इ + १)));
        गिनती = गिनती + १;
        यदि (व0 != ० && व0 != १) { इ = इ + १; जारीरह; }
        संख्या ज = इ + १;
        यदि (ज < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, ज, ज + १))) == ३) { ज = ज + १; }
        यावत् (ज < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, ज, ज + १))) == २) {
            संख्या क = ज + १;
            यदि (क < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, क, क + १))) == ४) { क = क + १; }
            यदि (क < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, क, क + १))) == १) {
                क = क + १;
                यदि (क < ल && देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, क, क + १))) == ३) { क = क + १; }
                ज = क;
            } अन्यथा {
                ज = क;
                विरामः;
            }
        }
        यावत् (ज < ल) {
            संख्या व = देवनागरी_वर्ग(अक्षर_मान(उपखंड(स, ज, ज + १)));
            यदि (व != ५ && व != ६ && व != ७) { विरामः; }
            ज = ज + १;
        }
        इ = ज;
    }
    परत् गिनती;
}

// सूचकांक (0-आधारित) पर का अक्षर सीधे — पूरी सूची बनाए बिना जब सिर्फ़ एक चाहिए
कार्य देवनागरी_अक्षर_पर(पाठ स, संख्या सूचकांक) {
    यदि (सूचकांक < ०) { प्रक्षेपः "त्रुटिः — देवनागरी_अक्षर_पर: ऋणात्मक सूचकांक"; }
    सूची सारे = देवनागरी_अक्षर_सूची(स);
    यदि (सूचकांक >= लंबाई(सारे)) {
        प्रक्षेपः "त्रुटिः — देवनागरी_अक्षर_पर: सूचकांक सीमा से बाहर";
    }
    परत् सारे[सूचकांक];
}

// ===== अंक-रूपांतरण =====

// क्या यह कोड-पॉइंट एक देवनागरी अंक (०-९) है
कार्य देवनागरी_अंक_है(संख्या कू) {
    परत् कू >= २४०६ && कू <= २४१५;
}

// एकल देवनागरी-अंक वर्ण → उसका मान (०-९); अमान्य → -१
कार्य देवनागरी_अंक_मान(पाठ च) {
    संख्या कू = अक्षर_मान(च);
    यदि (देवनागरी_अंक_है(कू)) { परत् कू - २४०६; }
    परत् -१;
}

// मान (०-९) → देवनागरी-अंक वर्ण
कार्य देवनागरी_अंक_वर्ण(संख्या मान_अ) {
    परत् अक्षर_निर्माण(२४०६ + मान_अ);
}

// पूर्णांक → देवनागरी-अंकों का पाठ (ऋणात्मक के लिए साधारण ASCII "-" उपसर्ग)
कार्य देवनागरी_अंक_से_पाठ(संख्या न_मान) {
    यदि (न_मान == ०) { परत् देवनागरी_अंक_वर्ण(०); }
    पाठ चिह्न_पाठ = "";
    संख्या मान_न = न_मान;
    यदि (मान_न < ०) { चिह्न_पाठ = "-"; मान_न = ० - मान_न; }
    पाठ फल = "";
    यावत् (मान_न > ०) {
        फल = देवनागरी_अंक_वर्ण(मान_न % १०) + फल;
        मान_न = मान_न / १०;
    }
    परत् चिह्न_पाठ + फल;
}

// देवनागरी-अंकों का पाठ → पूर्णांक (वैकल्पिक अगुआ "-")
कार्य देवनागरी_पाठ_से_अंक(पाठ स) {
    संख्या फल = ०;
    संख्या इ = ०;
    संख्या चिह्न_न = १;
    यदि (लंबाई(स) > ० && उपखंड(स, ०, १) == "-") { चिह्न_न = -१; इ = १; }
    यावत् (इ < लंबाई(स)) {
        संख्या म = देवनागरी_अंक_मान(उपखंड(स, इ, इ + १));
        यदि (म < ०) { प्रक्षेपः "त्रुटिः — देवनागरी_पाठ_से_अंक: अमान्य अंक"; }
        फल = फल * १० + म;
        इ = इ + १;
    }
    परत् चिह्न_न * फल;
}

// आम पाठ के भीतर के ASCII अंक (0-9) देवनागरी अंकों से बदलो, बाक़ी पाठ अछूता
कार्य देवनागरी_अंकों_में(पाठ स) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        संख्या कू = अक्षर_मान(च);
        यदि (कू >= ४८ && कू <= ५७) {
            फल = फल + देवनागरी_अंक_वर्ण(कू - ४८);
        } अन्यथा {
            फल = फल + च;
        }
        इ = इ + १;
    }
    परत् फल;
}

// आम पाठ के भीतर के देवनागरी अंक ASCII अंकों (0-9) से बदलो, बाक़ी पाठ अछूता
कार्य देवनागरी_अंकों_से(पाठ स) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        संख्या कू = अक्षर_मान(च);
        यदि (देवनागरी_अंक_है(कू)) {
            फल = फल + ("" + (कू - २४०६));
        } अन्यथा {
            फल = फल + च;
        }
        इ = इ + १;
    }
    परत् फल;
}
