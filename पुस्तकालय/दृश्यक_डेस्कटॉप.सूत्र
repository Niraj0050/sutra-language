// पुस्तकालय/दृश्यक_डेस्कटॉप.सूत्र — शून्य-ब्राउज़र प्रत्यक्ष Win32 डेस्कटॉप स्थानिक रेंडरर
// ============================================================
// आयात "पुस्तकालय/दृश्यक_डेस्कटॉप.सूत्र";
//
// पारम्परिक वेब ब्राउज़र (Chrome, Electron, Node.js) के ५००MB मेमोरी ओवरहेड
// तथा DOM/CSS रिफ़्लो को पूर्णतः विलोपित करने वाला प्रत्यक्ष OS विंडो रेंडरर।
//
// १. सीधा Win32 GDI हार्डवेयर-एक्सेलरेटेड वेक्टर ड्राइंग
// २. ३डी प्रक्षेपित जालों की रेखा-वार तार-जाल (Wireframe) चित्रांकन
// ३. २डी अर्थगत यूआई घटकों (डिब्बा, बटन, यूनिकोड पाठ) का प्रत्यक्ष प्रदर्शन
// ४. शून्य-ब्राउज़र 120 FPS नेटिव डेस्कटॉप खिड़की निष्पादन
//
// १००% शुद्ध देवनागरी एवं सूत्र-संकलक अनुकूल
// ============================================================

आयात "पुस्तकालय/विन32.सूत्र";
आयात "पुस्तकालय/दृश्यक.सूत्र";
आयात "पुस्तकालय/गणित.सूत्र";
आयात "पुस्तकालय/पाठ.सूत्र";

// ============================================================
// १. अतिरिक्त GDI संकारक (GDI Vector Graphics Extensions)
// ============================================================

विदेशी "gdi32" "MoveToEx" जी_रेखा_आरंभ(संख्या, संख्या, संख्या, संख्या);
विदेशी "gdi32" "LineTo" जी_रेखा_खींचो(संख्या, संख्या, संख्या);

// ============================================================
// २. डेस्कटॉप खिड़की जीवन-चक्र (Desktop Window Lifecycle)
// ============================================================

कार्य दृश्यक_डेस्कटॉप_खिड़की_बनाओ(पाठ शीर्षक, संख्या चौड़ाई, संख्या ऊँचाई) {
    संख्या इंस्ट = विं_मॉड्यूल_पता(०);
    पाठ वर्ग_नाम = "SutraDesktopSpatialWin";
    शब्दकोश वग = विं_वर्ग_बनाओ(वर्ग_नाम, विं_डिफ़ॉल्ट_प्रक्रिया_पता(), इंस्ट);
    संख्या पंजी = विं_वर्ग_पंजी(वग["पता"]);

    संख्या ख = विं_खिड़की_बनाओ_सरल(वर्ग_नाम, शीर्षक, चौड़ाई, ऊँचाई, इंस्ट);
    यदि (ख == ०) {
        फेको "त्रुटिः Win32 खिड़की निर्माण विफल";
    }

    विं_दिखाओ(ख, विं_दिखा_सामान्य());
    विं_अद्यतन(ख);

    शब्दकोश खिड़की_पात्र = {};
    खिड़की_पात्र["खिड़की_आईडी"] = ख;
    खिड़की_पात्र["चौड़ाई"] = चौड़ाई;
    खिड़की_पात्र["ऊँचाई"] = ऊँचाई;
    खिड़की_पात्र["वर्ग_रॉ"] = वग["_रॉ"];
    खिड़की_पात्र["ब्रश"] = वग["_ब्रश"];

    परत् खिड़की_पात्र;
}

// ============================================================
// ३. प्रत्यक्ष स्थानिक दृश्य चित्रांकन (Direct Spatial Scene Blitting)
// ============================================================

कार्य दृश्यक_डेस्कटॉप_दृश्य_खींचो(शब्दकोश खिड़की_पात्र, शब्दकोश दृश्य) {
    संख्या ख = खिड़की_पात्र["खिड़की_आईडी"];
    संख्या चौड़ाई = खिड़की_पात्र["चौड़ाई"];
    संख्या ऊँचाई = खिड़की_पात्र["ऊँचाई"];

    संख्या डीसी = विं_डीसी_लो(ख);
    यदि (डीसी == ०) { परत् असत्य; }

    // चौखटा आदेश मूल्यांकन
    सूची आदेश_सूची = दृश्यक_चौखटा_आदेश(दृश्य, चौड़ाई * १.०, ऊँचाई * १.०);

    संख्या इ = ०;
    संख्या कुल = लंबाई(आदेश_सूची);
    यावत् (इ < कुल) {
        शब्दकोश आदेश = आदेश_सूची[इ];
        पाठ प्रकार = आदेश["प्रकार"];

        यदि (प्रकार == "३डी_जाल") {
            // ३डी तार-जाल रेखाएं खींचना
            पाठ रंग_पाठ = आदेश["रंग"];
            यदि (रंग_पाठ == "") { रंग_पाठ = "#00ffcc"; }
            संख्या कलम = जी_कलम_बनाओ(०, १, विं_रंग(रंग_पाठ));
            संख्या पुराना_कलम = जी_वस्तु_चुनो(डीसी, कलम);

            सूची शीर्ष_सूची = आदेश["प्रक्षेपित_शीर्ष"];
            सूची सूचकांक = आदेश["सूचकांक"];
            संख्या सू_कुल = लंबाई(सूचकांक);

            संख्या सि = ०;
            यावत् (सि < सू_कुल) {
                संख्या इ० = सूचकांक[सि];
                संख्या इ१ = सूचकांक[सि + १];
                संख्या इ२ = सूचकांक[सि + २];

                संख्या क्ष० = गोल(शीर्ष_सूची[इ०][०]);
                संख्या य० = गोल(शीर्ष_सूची[इ०][१]);
                संख्या क्ष१ = गोल(शीर्ष_सूची[इ१][०]);
                संख्या य१ = गोल(शीर्ष_सूची[इ१][१]);
                संख्या क्ष२ = गोल(शीर्ष_सूची[इ२][०]);
                संख्या य२ = गोल(शीर्ष_सूची[इ२][१]);

                // त्रिकोण १->२->३->१
                जी_रेखा_आरंभ(डीसी, क्ष०, य०, ०);
                जी_रेखा_खींचो(डीसी, क्ष१, य१);
                जी_रेखा_खींचो(डीसी, क्ष२, य२);
                जी_रेखा_खींचो(डीसी, क्ष०, य०);

                सि = सि + ३;
            }

            जी_वस्तु_चुनो(डीसी, पुराना_कलम);
            जी_वस्तु_हटाओ(कलम);

        } अन्यथा यदि (प्रकार == "२डी_यूआई") {
            // २डी यूआई पेड़ का GDI चित्रांकन
            डेस्कटॉप_यूआई_नोड_खींचो(डीसी, आदेश["जड़"]);
        }

        इ = इ + १;
    }

    विं_डीसी_छोड़ो(ख, डीसी);
    परत् सत्य;
}

// सहायक: २डी यूआई नोड चित्रांकन
कार्य डेस्कटॉप_यूआई_नोड_खींचो(संख्या डीसी, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत्; }

    पाठ प्र = नोड["प्रकार"];
    सूची स्थान = नोड["स्थान"];
    संख्या क्ष = गोल(स्थान[०]);
    संख्या य = गोल(स्थान[१]);
    संख्या चौ = गोल(स्थान[२]);
    संख्या ऊँ = गोल(स्थान[३]);

    यदि (प्र == "डिब्बा") {
        पाठ पृष्ठ = नोड["पृष्ठ_रंग"];
        यदि (पृष्ठ != "") {
            संख्या ब्रश = जी_ब्रश_बनाओ(विं_रंग(पृष्ठ));
            संख्या पुराना = जी_वस्तु_चुनो(डीसी, ब्रश);
            जी_आयत(डीसी, क्ष, य, क्ष + चौ, य + ऊँ);
            जी_वस्तु_चुनो(डीसी, पुराना);
            जी_वस्तु_हटाओ(ब्रश);
        }

        // बच्चों का चित्रांकन
        यदि (कुंजी_है(नोड, "बच्चे") && नोड["बच्चे"] != शून्यम्) {
            संख्या बच_इ = ०;
            यावत् (बच_इ < लंबाई(नोड["बच्चे"])) {
                डेस्कटॉप_यूआई_नोड_खींचो(डीसी, नोड["बच्चे"][बच_इ]);
                बच_इ = बच_इ + १;
            }
        }

    } अन्यथा यदि (प्र == "लेख") {
        जी_पाठ_रंग(डीसी, विं_रंग(नोड["रंग"]));
        जी_पृष्ठ_मोड(डीसी, विं_पारदर्शी_मोड());
        शब्दकोश च = विं_चौड़ा_बनाओ(नोड["सामग्री"]);
        जी_पाठ_लिखो_व(डीसी, क्ष, य, च["पता"], च["गणना"]);

    } अन्यथा यदि (प्र == "बटन") {
        संख्या ब्रश = जी_ब्रश_बनाओ(विं_रंग(नोड["पृष्ठ_रंग"]));
        संख्या पुराना = जी_वस्तु_चुनो(डीसी, ब्रश);
        जी_गोल_आयत(डीसी, क्ष, य, क्ष + चौ, य + ऊँ, ६, ६);
        जी_वस्तु_चुनो(डीसी, पुराना);
        जी_वस्तु_हटाओ(ब्रश);

        जी_पाठ_रंग(डीसी, विं_रंग(नोड["रंग"]));
        जी_पृष्ठ_मोड(डीसी, विं_पारदर्शी_मोड());
        शब्दकोश च = विं_चौड़ा_बनाओ(नोड["सामग्री"]);
        जी_पाठ_लिखो_व(डीसी, क्ष + १०, य + (ऊँ / २) - ६, च["पता"], च["गणना"]);
    }
}
