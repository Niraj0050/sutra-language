// पुस्तकालय/एचएमएसी.सूत्र — HMAC-SHA256 (RFC 2104 / FIPS 198-1)
// ============================================================
// आयात "पुस्तकालय/एचएमएसी.सूत्र";
//
//   एचएमएसी_एसएचए256("key", "The quick brown fox jumps over the lazy dog")
//   // "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd"
//
// RFC 2104: HMAC(K,m) = H((K'⊕opad) || H((K'⊕ipad) || m)), H = SHA-256
// (ब्लॉक आकार B=64 बाइट, output L=32 बाइट)। K' = कुंजी को ठीक B बाइट तक
// समायोजित: कुंजी B से लंबी हो तो पहले H(कुंजी) से घटाई जाती (चूँकि हैश
// आउटपुट सदा B से छोटा होता), फिर दोनों ही स्थिति में शून्य-भरण से B
// बाइट तक। ipad = 0x36, opad = 0x5c (दोनों B बार दोहराए, कुंजी से XOR)।
//
// एसएचए256.सूत्र के ऊपर बना — उसका सार्वजनिक `एसएचए256_हैश_बाइट्स` (कच्चे
// बाइट्स लेता, पाठ नहीं) इस्तेमाल करता, क्योंकि कुंजी क्रिप्टोग्राफ़िक डेटा
// है, ज़रूरी नहीं मान्य UTF-8 पाठ हो — साथ ही उसका आंतरिक UTF-8 एन्कोडर
// (`श256_यूटीएफ8_एन्कोड`) पाठ-कुंजी/संदेश के लिए, दोहराने के बजाय।
//
// ⚠️ किसी भी क्रिप्टोग्राफ़िक तुलना (जैसे प्राप्त HMAC को अपेक्षित से
// मिलाना, signature-verification जैसे उपयोग में) समय-स्थिर (constant-
// time) तुलना से होनी चाहिए, साधारण `==` से नहीं — timing-attack से बचाव
// के लिए। यह मॉड्यूल सिर्फ़ HMAC की गणना करता, तुलना caller की ज़िम्मेदारी
// है (matches एसएचए256/बेस64/यूआईडी — "algorithm" देता, "security policy"
// नहीं थोपता)।
// ============================================================

आयात "पुस्तकालय/एसएचए256.सूत्र";
आयात "पुस्तकालय/प्रारूप.सूत्र";

संख्या एच_ब्लॉक_आकार = ६४;   // SHA-256 का ब्लॉक आकार, बाइट में

// हेक्स पाठ (एसएचए256_हैश_बाइट्स का आउटपुट) → कच्चे बाइट्स की सूची
कार्य एच_हेक्स_से_बाइट्स(पाठ हे) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(हे)) {
        संख्या ऊ = अंक_मान(उपखंड(हे, इ, इ + १));
        संख्या नी = अंक_मान(उपखंड(हे, इ + १, इ + २));
        फल = जोड़ें(फल, ऊ * १६ + नी);
        इ = इ + २;
    }
    परत् फल;
}

// कुंजी को ठीक एच_ब्लॉक_आकार बाइट तक समायोजित करो (RFC 2104 §2)
कार्य एच_कुंजी_समायोजित(सूची कुं) {
    सूची आ = कुं;
    यदि (लंबाई(आ) > एच_ब्लॉक_आकार) {
        आ = एच_हेक्स_से_बाइट्स(एसएचए256_हैश_बाइट्स(आ));
    }
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(आ)) {
        फल = जोड़ें(फल, आ[इ]);
        इ = इ + १;
    }
    यावत् (लंबाई(फल) < एच_ब्लॉक_आकार) {
        फल = जोड़ें(फल, ०);
    }
    परत् फल;
}

// बाइट-सूची को एक स्थिर मान से XOR करो (नई सूची लौटाता, मूल अछूती)
कार्य एच_सूची_एक्सओआर(सूची अ, संख्या मान_क) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        फल = जोड़ें(फल, बिट_भेद(अ[इ], मान_क));
        इ = इ + १;
    }
    परत् फल;
}

// दो बाइट-सूचियाँ जोड़ो (concat, नई सूची)
कार्य एच_सूची_जोड़ो(सूची अ, सूची ब) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(अ)) {
        फल = जोड़ें(फल, अ[इ]);
        इ = इ + १;
    }
    इ = ०;
    यावत् (इ < लंबाई(ब)) {
        फल = जोड़ें(फल, ब[इ]);
        इ = इ + १;
    }
    परत् फल;
}

// HMAC-SHA256(कुंजी, संदेश) — दोनों पाठ (UTF-8 एन्कोड होते); लौटाता है
// ६४-अक्षर लोअरकेस हेक्स पाठ (SHA-256 जैसा ही प्रारूप)
कार्य एचएमएसी_एसएचए256(पाठ कुंजी, पाठ संदेश) {
    सूची कुं_बाइट्स = एच_कुंजी_समायोजित(श256_यूटीएफ8_एन्कोड(कुंजी));
    सूची सं_बाइट्स = श256_यूटीएफ8_एन्कोड(संदेश);

    सूची भीतरी_कुं = एच_सूची_एक्सओआर(कुं_बाइट्स, ५४);   // ipad = 0x36
    सूची भीतरी_हैश = एच_हेक्स_से_बाइट्स(एसएचए256_हैश_बाइट्स(एच_सूची_जोड़ो(भीतरी_कुं, सं_बाइट्स)));

    सूची बाहरी_कुं = एच_सूची_एक्सओआर(कुं_बाइट्स, ९२);   // opad = 0x5c
    परत् एसएचए256_हैश_बाइट्स(एच_सूची_जोड़ो(बाहरी_कुं, भीतरी_हैश));
}
