// पुस्तकालय/बेस64.सूत्र — Base64 एन्कोडिंग/डिकोडिंग (RFC 4648, मानक वर्णमाला)
// ============================================================
// आयात "पुस्तकालय/बेस64.सूत्र";
//
//   पाठ ए = बेस64_एन्कोड([७२, १०१, १०८, १०८, १११]);   // "SGVsbG8="
//   सूची बा = बेस64_डिकोड(ए);                          // [७२,१०१,१०८,१०८,१११]
//
//   पाठ ए2 = बेस64_पाठ_एन्कोड("नमस्ते");   // UTF-8 एन्कोड + Base64 एन्कोड
//   पाठ वापस = बेस64_पाठ_डिकोड(ए2);        // "नमस्ते"
//
// मानक RFC 4648 बिट-पैकिंग (सार्वजनिक स्पेक — SHA-256 के FIPS 180-4 जैसा,
// किसी और का कोड कॉपी नहीं, स्पेक का गणित सीधे लिखा): हर ३ बाइट → ४ अक्षर
// (२४ बिट = चार ६-बिट टुकड़े), वर्णमाला A-Za-z0-9+/, कम बाइट बचे तो '='
// पैडिंग। पाठ-सुविधा फलनों के लिए UTF-8 एन्कोड/डिकोड संकुचन.सूत्र से
// पुनःप्रयोग (डुप्लिकेट लॉजिक नहीं)।
// ============================================================

आयात "पुस्तकालय/संकुचन.सूत्र";

कार्य बे64_वर्णमाला() {
    परत् "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}
कार्य बे64_पैड_अक्षर() { परत् "="; }

// ६-बिट मान (०-६३) → Base64 अक्षर
कार्य बे64_अंक_से_अक्षर(संख्या अंकम्) {
    परत् उपखंड(बे64_वर्णमाला(), अंकम्, अंकम् + १);
}

// Base64 अक्षर → ६-बिट मान (०-६३) — सीधे अंकगणित से (ASCII श्रेणियाँ), कोई
// दिक्शनरी-लुकअप नहीं ज़रूरी
कार्य बे64_अक्षर_से_अंक(पाठ अ) {
    संख्या कोड = अक्षर_मान(अ);
    यदि (कोड >= ६५ && कोड <= ९०) { परत् कोड - ६५; }         // A-Z → ०-२५
    यदि (कोड >= ९७ && कोड <= १२२) { परत् कोड - ९७ + २६; }   // a-z → २६-५१
    यदि (कोड >= ४८ && कोड <= ५७) { परत् कोड - ४८ + ५२; }    // ०-९ → ५२-६१
    यदि (कोड == ४३) { परत् ६२; }                              // +
    परत् ६३;                                                    // /
}

// ---- सार्वजनिक API ----

// कच्चे बाइट्स (संख्या ०-२५५ की सूची) → Base64 पाठ
कार्य बेस64_एन्कोड(सूची बाइट्स) {
    पाठ आउट = "";
    संख्या लं = लंबाई(बाइट्स);
    संख्या इ = ०;
    यावत् (इ + ३ <= लं) {
        संख्या ब0 = बाइट्स[इ];
        संख्या ब1 = बाइट्स[इ + १];
        संख्या ब2 = बाइट्स[इ + २];
        संख्या क0 = दक्षिण_सरक(ब0, २);
        संख्या क1 = बिट_या(बाम_सरक(बिट_और(ब0, ३), ४), दक्षिण_सरक(ब1, ४));
        संख्या क2 = बिट_या(बाम_सरक(बिट_और(ब1, १५), २), दक्षिण_सरक(ब2, ६));
        संख्या क3 = बिट_और(ब2, ६३);
        आउट = आउट + बे64_अंक_से_अक्षर(क0) + बे64_अंक_से_अक्षर(क1)
                   + बे64_अंक_से_अक्षर(क2) + बे64_अंक_से_अक्षर(क3);
        इ = इ + ३;
    }

    संख्या बाकी = लं - इ;
    यदि (बाकी == १) {
        संख्या ब0 = बाइट्स[इ];
        संख्या क0 = दक्षिण_सरक(ब0, २);
        संख्या क1 = बाम_सरक(बिट_और(ब0, ३), ४);
        आउट = आउट + बे64_अंक_से_अक्षर(क0) + बे64_अंक_से_अक्षर(क1)
                   + बे64_पैड_अक्षर() + बे64_पैड_अक्षर();
    } अन्यथा यदि (बाकी == २) {
        संख्या ब0 = बाइट्स[इ];
        संख्या ब1 = बाइट्स[इ + १];
        संख्या क0 = दक्षिण_सरक(ब0, २);
        संख्या क1 = बिट_या(बाम_सरक(बिट_और(ब0, ३), ४), दक्षिण_सरक(ब1, ४));
        संख्या क2 = बाम_सरक(बिट_और(ब1, १५), २);
        आउट = आउट + बे64_अंक_से_अक्षर(क0) + बे64_अंक_से_अक्षर(क1)
                   + बे64_अंक_से_अक्षर(क2) + बे64_पैड_अक्षर();
    }
    परत् आउट;
}

// Base64 पाठ → कच्चे बाइट्स। v1: सख़्त — इनपुट की लंबाई ४ का गुणज मानी जाती
// है, बीच में व्हाइटस्पेस/लाइन-रैप समर्थित नहीं (RFC का strict उप-भाग)
कार्य बेस64_डिकोड(पाठ स्रोत) {
    सूची आउट = [];
    संख्या लं = लंबाई(स्रोत);
    संख्या इ = ०;
    यावत् (इ + ४ <= लं) {
        पाठ अ0 = उपखंड(स्रोत, इ, इ + १);
        पाठ अ1 = उपखंड(स्रोत, इ + १, इ + २);
        पाठ अ2 = उपखंड(स्रोत, इ + २, इ + ३);
        पाठ अ3 = उपखंड(स्रोत, इ + ३, इ + ४);

        संख्या म0 = बे64_अक्षर_से_अंक(अ0);
        संख्या म1 = बे64_अक्षर_से_अंक(अ1);
        संख्या ब0 = बिट_या(बाम_सरक(म0, २), दक्षिण_सरक(म1, ४));
        आउट = जोड़ें(आउट, बिट_और(ब0, २५५));

        यदि (अ2 != बे64_पैड_अक्षर()) {
            संख्या म2 = बे64_अक्षर_से_अंक(अ2);
            संख्या ब1 = बिट_या(बाम_सरक(बिट_और(म1, १५), ४), दक्षिण_सरक(म2, २));
            आउट = जोड़ें(आउट, बिट_और(ब1, २५५));

            यदि (अ3 != बे64_पैड_अक्षर()) {
                संख्या म3 = बे64_अक्षर_से_अंक(अ3);
                संख्या ब2 = बिट_या(बाम_सरक(बिट_और(म2, ३), ६), म3);
                आउट = जोड़ें(आउट, बिट_और(ब2, २५५));
            }
        }
        इ = इ + ४;
    }
    परत् आउट;
}

// सुविधा — सीधे पाठ एन्कोड/डिकोड (UTF-8 एन्कोड/डिकोड शामिल, संकुचन.सूत्र से)
कार्य बेस64_पाठ_एन्कोड(पाठ स्रोत) {
    परत् बेस64_एन्कोड(सं_यूटीएफ8_एन्कोड(स्रोत));
}
कार्य बेस64_पाठ_डिकोड(पाठ बे64) {
    परत् सं_यूटीएफ8_डिकोड(बेस64_डिकोड(बे64));
}
