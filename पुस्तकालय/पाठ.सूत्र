// पुस्तकालय/पाठ.सूत्र — पाठ (string) उपयोगिता-कार्य
// ============================================================
// आयात "पुस्तकालय/पाठ.सूत्र";
//
// अंतर्निहित: लंबाई, उपखंड, खोजें, बदलें, विभाजित, संयोजित, छाँटें,
//   आरंभिक, अंतिम, उच्च, निम्न, अक्षर_मान, अक्षर_निर्माण।
// यहाँ: दोहराओ, बाएँ_भरो, दाएँ_भरो, उलटा_पाठ, पंक्तियाँ, है_रिक्त,
//   समाहित_पाठ, गिनो_पाठ, बड़ा_प्रथम, अक्षर_पर, अक्षर_सूची, आदि।
// ============================================================

// स को गिन बार दोहराओ
कार्य दोहराओ(पाठ स, संख्या गिन) {
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < गिन) {
        फल = फल + स;
        इ = इ + १;
    }
    परत् फल;
}

// बाईं ओर भरण-अक्षर से लंबाई तक भरो
कार्य बाएँ_भरो(पाठ स, संख्या लक्ष्य_लंबाई, पाठ भरण) {
    पाठ फल = स;
    यावत् (लंबाई(फल) < लक्ष्य_लंबाई) {
        फल = भरण + फल;
    }
    परत् फल;
}

// दाईं ओर भरण-अक्षर से लंबाई तक भरो
कार्य दाएँ_भरो(पाठ स, संख्या लक्ष्य_लंबाई, पाठ भरण) {
    पाठ फल = स;
    यावत् (लंबाई(फल) < लक्ष्य_लंबाई) {
        फल = फल + भरण;
    }
    परत् फल;
}

// अक्षरों का उल्टा क्रम
कार्य उलटा_पाठ(पाठ स) {
    पाठ फल = "";
    संख्या इ = लंबाई(स) - १;
    यावत् (इ >= ०) {
        फल = फल + उपखंड(स, इ, इ + १);
        इ = इ - १;
    }
    परत् फल;
}

// नई-पंक्ति पर विभाजित
कार्य पंक्तियाँ(पाठ स) {
    परत् विभाजित(स, अक्षर_निर्माण(१०));
}

// रिक्त या केवल श्वेत-स्थान?
कार्य है_रिक्त(पाठ स) {
    परत् लंबाई(छाँटें(स)) == ०;
}

// क्या उप-पाठ स में है?
कार्य समाहित_पाठ(पाठ स, पाठ उप) {
    परत् खोजें(स, उप) != -१;
}

// उप कितनी बार आता है (अतिव्यापी नहीं)
कार्य गिनो_पाठ(पाठ स, पाठ उप) {
    यदि (लंबाई(उप) == ०) { परत् ०; }
    संख्या ग = ०;
    पाठ शेष = स;
    यावत् (सत्य) {
        संख्या प = खोजें(शेष, उप);
        यदि (प == -१) { विरामः; }
        ग = ग + १;
        शेष = उपखंड(शेष, प + लंबाई(उप), लंबाई(शेष));
    }
    परत् ग;
}

// पहला अक्षर बड़ा, बाकी वैसा ही
कार्य बड़ा_प्रथम(पाठ स) {
    यदि (लंबाई(स) == ०) { परत् स; }
    परत् उच्च(उपखंड(स, ०, १)) + उपखंड(स, १, लंबाई(स));
}

// शीर्षक-रूप: हर शब्द का पहला अक्षर बड़ा
कार्य शीर्षक_रूप(पाठ स) {
    सूची शब्द = विभाजित(स, " ");
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(शब्द)) {
        फल = जोड़ें(फल, बड़ा_प्रथम(शब्द[इ]));
        इ = इ + १;
    }
    परत् संयोजित(फल, " ");
}

// अनुक्रमांक पर एक-अक्षर पाठ (सीमा-बाहर → "")
कार्य अक्षर_पर(पाठ स, संख्या सूचकांक) {
    यदि (सूचकांक < ० || सूचकांक >= लंबाई(स)) { परत् ""; }
    परत् उपखंड(स, सूचकांक, सूचकांक + १);
}

// पाठ → एक-अक्षर पाठों की सूची
कार्य अक्षर_सूची(पाठ स) {
    सूची फल = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        फल = जोड़ें(फल, उपखंड(स, इ, इ + १));
        इ = इ + १;
    }
    परत् फल;
}

// उपसर्ग हो तो हटाओ
कार्य उपसर्ग_हटाओ(पाठ स, पाठ उपसर्ग) {
    यदि (आरंभिक(स, उपसर्ग)) {
        परत् उपखंड(स, लंबाई(उपसर्ग), लंबाई(स));
    }
    परत् स;
}

// प्रत्यय हो तो हटाओ
कार्य प्रत्यय_हटाओ(पाठ स, पाठ प्रत्यय) {
    यदि (अंतिम(स, प्रत्यय)) {
        परत् उपखंड(स, ०, लंबाई(स) - लंबाई(प्रत्यय));
    }
    परत् स;
}

// सारी उपस्थितियाँ बदलो (बदलें एक ही बदलता तो लूप)
कार्य सब_बदलो(पाठ स, पाठ पुराना, पाठ नया) {
    यदि (लंबाई(पुराना) == ०) { परत् स; }
    पाठ फल = "";
    पाठ शेष = स;
    यावत् (सत्य) {
        संख्या प = खोजें(शेष, पुराना);
        यदि (प == -१) {
            फल = फल + शेष;
            विरामः;
        }
        फल = फल + उपखंड(शेष, ०, प) + नया;
        शेष = उपखंड(शेष, प + लंबाई(पुराना), लंबाई(शेष));
    }
    परत् फल;
}
