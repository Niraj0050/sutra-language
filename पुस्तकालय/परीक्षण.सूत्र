// पुस्तकालय/परीक्षण.सूत्र — छोटा परीक्षण-ढाँचा (mini test framework)
// ============================================================
// आयात "पुस्तकालय/परीक्षण.सूत्र";
//
//   कार्य मुख्य() {
//       जाँच("जोड़", 2 + 3, 5);
//       जाँच_सत्य("धनात्मक", 5 > 0);
//       जाँच_निकट("भाग", 10.0 / 3.0, 3.333, 0.01);
//       परत् परीक्षण_सारांश();   // 0 = सब पास, 1 = कोई विफल
//   }
//
// प्रथम-श्रेणी कार्य नहीं तो हर जाँच सीधे बुलानी पड़ती (Python-style
// decorator/discovery नहीं)। बूल-लौटाने वाले helper native में 1/0
// छापते — इसलिए यहाँ helper सीधे लिखतु करते, लौटाते नहीं।
// ============================================================

संख्या परीक्षण_पास = 0;
संख्या परीक्षण_विफल = 0;

// आंतरिक — किसी भी मान को छापने-योग्य पाठ में
कार्य परीक्षण_दिखाओ(मान म) {
    पाठ त = प्रकार(म);
    यदि (त == "पाठ") { परत् "\"" + म + "\""; }
    यदि (त == "सूची") {
        पाठ फल = "[";
        संख्या इ = 0;
        यावत् (इ < लंबाई(म)) {
            यदि (इ > 0) { फल = फल + ", "; }
            फल = फल + परीक्षण_दिखाओ(म[इ]);
            इ = इ + 1;
        }
        परत् फल + "]";
    }
    यदि (त == "बूल") {
        यदि (म) { परत् "सत्य"; }
        परत् "असत्य";
    }
    यदि (त == "शून्यम्") { परत् "शून्यम्"; }
    परत् "" + म;
}

// समानता — गहरी (सूची तत्व-वार)
कार्य परीक्षण_समान(मान अ, मान ब) {
    पाठ ता = प्रकार(अ);
    पाठ तब = प्रकार(ब);
    यदि (ता == "सूची" && तब == "सूची") {
        यदि (लंबाई(अ) != लंबाई(ब)) { परत् असत्य; }
        संख्या इ = 0;
        यावत् (इ < लंबाई(अ)) {
            यदि (न परीक्षण_समान(अ[इ], ब[इ])) { परत् असत्य; }
            इ = इ + 1;
        }
        परत् सत्य;
    }
    परत् अ == ब;
}

// ===== सार्वजनिक जाँचें =====

// वास्तविक == अपेक्षित ?
कार्य जाँच(पाठ नाम, मान वास्तविक, मान अपेक्षित) {
    यदि (परीक्षण_समान(वास्तविक, अपेक्षित)) {
        परीक्षण_पास = परीक्षण_पास + 1;
        लिखतु("  ✓ " + नाम);
    } अन्यथा {
        परीक्षण_विफल = परीक्षण_विफल + 1;
        लिखतु("  ✗ " + नाम + "  — अपेक्षित " + परीक्षण_दिखाओ(अपेक्षित)
            + ", मिला " + परीक्षण_दिखाओ(वास्तविक));
    }
    परत् 0;
}

कार्य जाँच_सत्य(पाठ नाम, मान शर्त) {
    यदि (शर्त) {
        परीक्षण_पास = परीक्षण_पास + 1;
        लिखतु("  ✓ " + नाम);
    } अन्यथा {
        परीक्षण_विफल = परीक्षण_विफल + 1;
        लिखतु("  ✗ " + नाम + "  — सत्य अपेक्षित");
    }
    परत् 0;
}

कार्य जाँच_असत्य(पाठ नाम, मान शर्त) {
    यदि (न शर्त) {
        परीक्षण_पास = परीक्षण_पास + 1;
        लिखतु("  ✓ " + नाम);
    } अन्यथा {
        परीक्षण_विफल = परीक्षण_विफल + 1;
        लिखतु("  ✗ " + नाम + "  — असत्य अपेक्षित");
    }
    परत् 0;
}

// दशमलव: |वास्तविक − अपेक्षित| <= सहनशीलता
कार्य जाँच_निकट(पाठ नाम, दशमलव वास्तविक, दशमलव अपेक्षित, दशमलव सहनशीलता) {
    दशमलव अंतर = वास्तविक - अपेक्षित;
    यदि (अंतर < 0.0) { अंतर = 0.0 - अंतर; }
    यदि (अंतर <= सहनशीलता) {
        परीक्षण_पास = परीक्षण_पास + 1;
        लिखतु("  ✓ " + नाम);
    } अन्यथा {
        परीक्षण_विफल = परीक्षण_विफल + 1;
        लिखतु("  ✗ " + नाम + "  — " + ("" + अपेक्षित) + " ± " + ("" + सहनशीलता)
            + " अपेक्षित, मिला " + ("" + वास्तविक));
    }
    परत् 0;
}

// समूह-शीर्षक
कार्य परीक्षण_समूह(पाठ नाम) {
    लिखतु("");
    लिखतु("== " + नाम + " ==");
    परत् 0;
}

// सारांश छापो; लौटाता है 0 (सब पास) या 1 (कोई विफल) — मुख्य से परत् करो
कार्य परीक्षण_सारांश() {
    लिखतु("");
    लिखतु("पास: " + परीक्षण_पास + "   विफल: " + परीक्षण_विफल);
    यदि (परीक्षण_विफल == 0) {
        लिखतु("सब परीक्षण पास ✓");
        परत् 0;
    }
    लिखतु("कुछ परीक्षण विफल ✗");
    परत् 1;
}
