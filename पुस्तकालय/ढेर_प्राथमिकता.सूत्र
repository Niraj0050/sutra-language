// पुस्तकालय/ढेर_प्राथमिकता.सूत्र — द्विआधारी न्यून-ढेर (min-heap / priority queue)
// ============================================================
// आयात "पुस्तकालय/ढेर_प्राथमिकता.सूत्र";
//   मान प = नवीन ढेर_प्राथमिकता();
//   प.डालो(5); प.डालो(1); प.डालो(3);
//   प.शिखर()     → 1   (सबसे छोटा; हटता नहीं)
//   प.निकालो()   → 1   (हट जाता है)
//   प.आकार();  प.खाली_है();
//
// तत्व तुलनीय होने चाहिए (संख्या या पाठ — < अब दोनों पर सही चलता)।
// सूत्र में `स्व.क्षेत्र[i] = v` असमर्थित — भीतर सूची-संदर्भ स्थानीय में लेकर
// उस पर काम किया जाता (सूची reference है, तो क्षेत्र भी बदल जाता)।
// ============================================================

// सूची अरे में सूचकांक अ ↔ ब की अदला-बदली
कार्य ढेप_बदलो(सूची अरे, संख्या अ, संख्या ब) {
    मान त = अरे[अ];
    अरे[अ] = अरे[ब];
    अरे[ब] = त;
    परत् 0;
}

वर्ग ढेर_प्राथमिकता {
    मान तत्व_क = 0;

    कार्य रचना() {
        स्व.तत्व_क = [];
    }

    कार्य डालो(मान म) {
        मान अरे = स्व.तत्व_क;
        अरे = जोड़ें(अरे, म);
        स्व.तत्व_क = अरे;
        संख्या इ = लंबाई(अरे) - 1;
        यावत् (इ > 0) {
            संख्या जनक = (इ - 1) / 2;
            यदि (अरे[इ] < अरे[जनक]) {
                ढेप_बदलो(अरे, इ, जनक);
                इ = जनक;
            } अन्यथा {
                विरामः;
            }
        }
    }

    कार्य शिखर() {
        मान अरे = स्व.तत्व_क;
        यदि (लंबाई(अरे) == 0) { परत् शून्यम्; }
        परत् अरे[0];
    }

    कार्य निकालो() {
        मान अरे = स्व.तत्व_क;
        संख्या गिन = लंबाई(अरे);
        यदि (गिन == 0) { परत् शून्यम्; }
        मान शीर्ष = अरे[0];
        यदि (गिन == 1) {
            स्व.तत्व_क = [];
            परत् शीर्ष;
        }
        अरे[0] = अरे[गिन - 1];
        अरे = निकालें(अरे);
        स्व.तत्व_क = अरे;
        संख्या इ = 0;
        संख्या न_गिन = लंबाई(अरे);
        यावत् (सत्य) {
            संख्या बायाँ = 2 * इ + 1;
            संख्या दायाँ = 2 * इ + 2;
            संख्या सबसे_छोटा = इ;
            यदि (बायाँ < न_गिन) {
                यदि (अरे[बायाँ] < अरे[सबसे_छोटा]) { सबसे_छोटा = बायाँ; }
            }
            यदि (दायाँ < न_गिन) {
                यदि (अरे[दायाँ] < अरे[सबसे_छोटा]) { सबसे_छोटा = दायाँ; }
            }
            यदि (सबसे_छोटा == इ) { विरामः; }
            ढेप_बदलो(अरे, इ, सबसे_छोटा);
            इ = सबसे_छोटा;
        }
        परत् शीर्ष;
    }

    कार्य आकार() {
        परत् लंबाई(स्व.तत्व_क);
    }

    कार्य खाली_है() {
        परत् लंबाई(स्व.तत्व_क) == 0;
    }
}

// ढेर-सॉर्ट: सूची → क्रमबद्ध सूची (आरोही)।
// (ढेर को इसी फलन में बनाना ज़रूरी — `मान v = f()` पर v.विधि() native में
//  नहीं चलता; `मान v = नवीन X()` पर type-inference से चलता।)
कार्य ढेर_क्रम(सूची स) {
    मान प = नवीन ढेर_प्राथमिकता();
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        प.डालो(स[इ]);
        इ = इ + 1;
    }
    सूची फल = [];
    यावत् (न प.खाली_है()) {
        फल = जोड़ें(फल, प.निकालो());
    }
    परत् फल;
}
