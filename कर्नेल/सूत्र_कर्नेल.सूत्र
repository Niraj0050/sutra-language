// कर्नेल/सूत्र_कर्नेल.सूत्र — सूत्र स्वायत्त ऑपरेटिंग सिस्टम (SutraOS Microkernel)
// ==============================================================================
// शून्य-C, शून्य-POSIX, शून्य-HTML/CSS/JS — 100% शुद्ध पाणिनीय सूत्र x86-64 कर्नेल
//
// वास्तुशिल्प (Architecture):
//   1. कंसोल उपप्रणाली: VGA 80x25 टेक्स्ट बफर (0xB8000), रंग, कर्सर, स्क्रोलिंग
//   2. भौतिक स्मृति प्रबंधक: 4KB पृष्ठ-चौखट आवंटक (Page Frame Allocator), बिटमैप
//   3. कार्य प्रबंधक एवं क्रमक: सहकारी बहुकार्यन (Cooperative TCB Scheduler)
//   4. अंतर्-प्रक्रिया संवाद: वलय-बफर संदेश पेटी (IPC Ring-Buffer Mailbox)
//   5. तंत्र-आह्वान प्रेषक: 10 मानक कर्नेल तंत्र-आह्वान (Syscall Dispatcher)
//   6. स्वायत्त कर्नेल कार्य: स्मृति-रक्षक, संवेदक-उत्पादक, विश्लेषक-उपभोक्ता
// ==============================================================================

// ------------------------------------------------------------------------------
// भाग १: VGA कंसोल एवं स्क्रीन नियंत्रण (0xB8000)
// ------------------------------------------------------------------------------

कार्य कंसोल_तल_पता() {
    परत् 753664; // 0xB8000
}

कार्य राज्य_पता() {
    परत् 131072; // 0x20000 — कर्नेल वैश्विक स्थिति आधार
}

कार्य कंसोल_पंक्ति_लो() {
    परत् अंतर्_पढ़8(राज्य_पता(), 8);
}

कार्य कंसोल_पंक्ति_रखो(संख्या पंक्ति) {
    अंतर्_लिख8(राज्य_पता(), 8, पंक्ति);
    परत् 0;
}

कार्य कंसोल_स्तंभ_लो() {
    परत् अंतर्_पढ़8(राज्य_पता(), 16);
}

कार्य कंसोल_स्तंभ_रखो(संख्या स्तंभ) {
    अंतर्_लिख8(राज्य_पता(), 16, स्तंभ);
    परत् 0;
}

कार्य कंसोल_रंग_लो() {
    परत् अंतर्_पढ़8(राज्य_पता(), 24);
}

कार्य कंसोल_रंग_रखो(संख्या रंग) {
    अंतर्_लिख8(राज्य_पता(), 24, रंग);
    परत् 0;
}

कार्य कंसोल_साफ_करो() {
    संख्या तल = कंसोल_तल_पता();
    संख्या रंग = कंसोल_रंग_लो();
    संख्या इ = 0;
    यावत् (इ < 2000) {
        अंतर्_लिख1(तल, इ * 2, 32);     // रिक्त स्थान (Space)
        अंतर्_लिख1(तल, इ * 2 + 1, रंग); // पृष्ठभूमि व अग्रभूमि रंग
        इ = इ + 1;
    }
    कंसोल_पंक्ति_रखो(0);
    कंसोल_स्तंभ_रखो(0);
    परत् 0;
}

कार्य कंसोल_स्क्रोल() {
    संख्या तल = कंसोल_तल_पता();
    संख्या रंग = कंसोल_रंग_लो();
    संख्या पंक्ति = 0;
    यावत् (पंक्ति < 24) {
        संख्या स्तंभ = 0;
        यावत् (स्तंभ < 80) {
            संख्या स्रोत_स्थान = ((पंक्ति + 1) * 80 + स्तंभ) * 2;
            संख्या लक्ष्य_स्थान = (पंक्ति * 80 + स्तंभ) * 2;
            संख्या वर्ण = अंतर्_पढ़1(तल, स्रोत_स्थान);
            संख्या वर्ण_रंग = अंतर्_पढ़1(तल, स्रोत_स्थान + 1);
            अंतर्_लिख1(तल, लक्ष्य_स्थान, वर्ण);
            अंतर्_लिख1(तल, लक्ष्य_स्थान + 1, वर्ण_रंग);
            स्तंभ = स्तंभ + 1;
        }
        पंक्ति = पंक्ति + 1;
    }
    // अंतिम पंक्ति (२४) को रिक्त करो
    संख्या स्तंभ२ = 0;
    यावत् (स्तंभ२ < 80) {
        संख्या अंतिम_स्थान = (24 * 80 + स्तंभ२) * 2;
        अंतर्_लिख1(तल, अंतिम_स्थान, 32);
        अंतर्_लिख1(तल, अंतिम_स्थान + 1, रंग);
        स्तंभ२ = स्तंभ२ + 1;
    }
    कंसोल_पंक्ति_रखो(24);
    कंसोल_स्तंभ_रखो(0);
    परत् 0;
}

कार्य कंसोल_लिख_अक्षर(संख्या वर्ण) {
    संख्या तल = कंसोल_तल_पता();
    संख्या पंक्ति = कंसोल_पंक्ति_लो();
    संख्या स्तंभ = कंसोल_स्तंभ_लो();
    संख्या रंग = कंसोल_रंग_लो();

    यदि (वर्ण == 10) { // '\n' (नयी पंक्ति)
        कंसोल_स्तंभ_रखो(0);
        पंक्ति = पंक्ति + 1;
        यदि (पंक्ति >= 25) {
            कंसोल_स्क्रोल();
        } अन्यथा {
            कंसोल_पंक्ति_रखो(पंक्ति);
        }
        परत् 0;
    }

    यदि (वर्ण >= 32) {
        संख्या स्थान = (पंक्ति * 80 + स्तंभ) * 2;
        अंतर्_लिख1(तल, स्थान, वर्ण);
        अंतर्_लिख1(तल, स्थान + 1, रंग);

        स्तंभ = स्तंभ + 1;
        यदि (स्तंभ >= 80) {
            कंसोल_स्तंभ_रखो(0);
            पंक्ति = पंक्ति + 1;
            यदि (पंक्ति >= 25) {
                कंसोल_स्क्रोल();
            } अन्यथा {
                कंसोल_पंक्ति_रखो(पंक्ति);
            }
        } अन्यथा {
            कंसोल_स्तंभ_रखो(स्तंभ);
        }
    }
    परत् 0;
}

कार्य लिख_स्थान() {
    कंसोल_लिख_अक्षर(32);
    परत् 0;
}

कार्य लिख_विराम() {
    कंसोल_लिख_अक्षर(10);
    परत् 0;
}

कार्य लिख_विभाजक() {
    संख्या इ = 0;
    यावत् (इ < 72) {
        कंसोल_लिख_अक्षर(61); // '='
        इ = इ + 1;
    }
    लिख_विराम();
    परत् 0;
}

कार्य लिख_उप_विभाजक() {
    संख्या इ = 0;
    यावत् (इ < 72) {
        कंसोल_लिख_अक्षर(45); // '-'
        इ = इ + 1;
    }
    लिख_विराम();
    परत् 0;
}

कार्य कंसोल_लिख_संख्या(संख्या मूल्य) {
    यदि (मूल्य == 0) {
        कंसोल_लिख_अक्षर(48); // '0'
        परत् 0;
    }
    यदि (मूल्य < 0) {
        कंसोल_लिख_अक्षर(45); // '-'
        मूल्य = 0 - मूल्य;
    }

    संख्या बफर_आधार = 133120; // 0x20800 (स्क्रैच मेमोरी)
    संख्या सूचक = 0;
    यावत् (मूल्य > 0) {
        संख्या शेष = मूल्य % 10;
        अंतर्_लिख1(बफर_आधार, सूचक, 48 + शेष);
        सूचक = सूचक + 1;
        मूल्य = मूल्य / 10;
    }

    यावत् (सूचक > 0) {
        सूचक = सूचक - 1;
        संख्या अंक = अंतर्_पढ़1(बफर_आधार, सूचक);
        कंसोल_लिख_अक्षर(अंक);
    }
    परत् 0;
}

कार्य कंसोल_लिख_षोडश(संख्या मूल्य) {
    कंसोल_लिख_अक्षर(48);  // '0'
    कंसोल_लिख_अक्षर(120); // 'x'

    यदि (मूल्य == 0) {
        कंसोल_लिख_अक्षर(48);
        परत् 0;
    }

    संख्या बफर_आधार = 133152; // 0x20820
    संख्या सूचक = 0;
    यावत् (मूल्य > 0) {
        संख्या नीबल = बिट_और(मूल्य, 15);
        संख्या वर्ण = 48 + नीबल;
        यदि (नीबल >= 10) {
            वर्ण = 65 + (नीबल - 10); // 'A'..'F'
        }
        अंतर्_लिख1(बफर_आधार, सूचक, वर्ण);
        सूचक = सूचक + 1;
        मूल्य = दक्षिण_सरक(मूल्य, 4);
    }

    यावत् (सूचक > 0) {
        सूचक = सूचक - 1;
        संख्या वर्ण२ = अंतर्_पढ़1(बफर_आधार, सूचक);
        कंसोल_लिख_अक्षर(वर्ण२);
    }
    परत् 0;
}

// ------------------------------------------------------------------------------
// भाग २: भौतिक स्मृति प्रबंधक (Physical Memory & Frame Allocator)
// ------------------------------------------------------------------------------
// स्मृति विभाजन:
//   0x000000 - 0x01FFFF: बूटलोडर, कर्नेल कोड एवं डेटा
//   0x020000 - 0x020FFF: कर्नेल वैश्विक स्थिति (Global State)
//   0x021000 - 0x021FFF: पृष्ठ बिटमैप (512 पृष्ठ = 2MB भौतिक स्मृति)
//   0x024000 - 0x025FFF: कार्य नियंत्रण खंड सारणी (TCB Table)
//   0x026000 - 0x027FFF: अंतर्-प्रक्रिया संवाद संदेश पेटिका (IPC Mailboxes)
//   0x200000 (2MB)+    : गतिशील भौतिक पृष्ठ आवंटन क्षेत्र (Free Frames Pool)

कार्य बिटमैप_आधार_पता() {
    परत् 135168; // 0x21000
}

कार्य गतिशील_स्मृति_आरंभ_पता() {
    परत् 2097152; // 0x200000 (2MB)
}

कार्य भौतिक_स्मृति_शुरू(संख्या कुल_पृष्ठ_संख्या) {
    // वैश्विक स्थिति में जादुई संख्या एवं स्मृति सीमा अंकित करो
    अंतर्_लिख8(राज्य_पता(), 0, 1414417233); // जादुई पहचान
    अंतर्_लिख8(राज्य_पता(), 32, 0);          // टिक गणना = 0
    अंतर्_लिख8(राज्य_पता(), 40, कुल_पृष्ठ_संख्या); // कुल पृष्ठ
    अंतर्_लिख8(राज्य_पता(), 48, 0);          // आवंटित पृष्ठ = 0
    अंतर्_लिख8(राज्य_पता(), 56, 0);          // सक्रिय कार्य = 0
    अंतर्_लिख8(राज्य_पता(), 64, 0);          // तंत्र-आह्वान गणना = 0

    // बिटमैप को शून्य करो (प्रत्येक बिट = 0 अर्थात पृष्ठ मुक्त है)
    संख्या बिटमैप = बिटमैप_आधार_पता();
    संख्या शब्द_संख्या = (कुल_पृष्ठ_संख्या + 63) / 64;
    संख्या इ = 0;
    यावत् (इ < शब्द_संख्या) {
        अंतर्_लिख8(बिटमैप, इ * 8, 0);
        इ = इ + 1;
    }
    परत् 0;
}

कार्य पृष्ठ_आवंटन() {
    संख्या कुल_पृष्ठ = अंतर्_पढ़8(राज्य_पता(), 40);
    संख्या बिटमैप = बिटमैप_आधार_पता();
    संख्या शब्द_संख्या = (कुल_पृष्ठ + 63) / 64;

    संख्या शब्द_इ = 0;
    यावत् (शब्द_इ < शब्द_संख्या) {
        संख्या शब्द = अंतर्_पढ़8(बिटमैप, शब्द_इ * 8);
        यदि (शब्द != 0 - 1) { // यदि कम से कम एक बिट 0 है
            संख्या बिट_इ = 0;
            यावत् (बिट_इ < 64) {
                संख्या मास्क = बाम_सरक(1, बिट_इ);
                यदि (बिट_और(शब्द, मास्क) == 0) {
                    // मुक्त पृष्ठ मिला! बिट को 1 करो
                    अंतर्_लिख8(बिटमैप, शब्द_इ * 8, बिट_या(शब्द, मास्क));
                    संख्या आवंटित = अंतर्_पढ़8(राज्य_पता(), 48);
                    अंतर्_लिख8(राज्य_पता(), 48, आवंटित + 1);

                    संख्या पृष्ठ_क्रमांक = शब्द_इ * 64 + बिट_इ;
                    संख्या भौतिक_पता = गतिशील_स्मृति_आरंभ_पता() + (पृष्ठ_क्रमांक * 4096);
                    परत् भौतिक_पता;
                }
                बिट_इ = बिट_इ + 1;
            }
        }
        शब्द_इ = शब्द_इ + 1;
    }
    परत् 0; // स्मृति समाप्त (Out of memory)
}

कार्य पृष्ठ_मुक्त(संख्या भौतिक_पता) {
    संख्या गतिशील_आरंभ = गतिशील_स्मृति_आरंभ_पता();
    यदि (भौतिक_पता < गतिशील_आरंभ) {
        परत् 0 - 1; // अवैध पता
    }

    संख्या ऑफसेट = भौतिक_पता - गतिशील_आरंभ;
    संख्या पृष्ठ_क्रमांक = ऑफसेट / 4096;
    संख्या शब्द_इ = पृष्ठ_क्रमांक / 64;
    संख्या बिट_इ = पृष्ठ_क्रमांक % 64;

    संख्या बिटमैप = बिटमैप_आधार_पता();
    संख्या शब्द = अंतर्_पढ़8(बिटमैप, शब्द_इ * 8);
    संख्या मास्क = बाम_सरक(1, बिट_इ);

    यदि (बिट_और(शब्द, मास्क) != 0) {
        अंतर्_लिख8(बिटमैप, शब्द_इ * 8, बिट_और(शब्द, बिट_उलट(मास्क)));
        संख्या आवंटित = अंतर्_पढ़8(राज्य_पता(), 48);
        यदि (आवंटित > 0) {
            अंतर्_लिख8(राज्य_पता(), 48, आवंटित - 1);
        }
        परत् 1; // सफलता
    }
    परत् 0; // पहले से मुक्त था
}

// ------------------------------------------------------------------------------
// भाग ३: कार्य प्रबंधन एवं सहकारी क्रमक (Task Scheduler)
// ------------------------------------------------------------------------------
// TCB संरचना (प्रति कार्य 64 बाइट्स, अधिकतम 8 कार्य):
//   +0 : कार्य आईडी (1..8, 0 = रिक्त)
//   +8 : कार्य स्थिति (0 = शून्य, 1 = सज्जित, 2 = प्रतीक्षारत, 3 = पूर्ण)
//   +16: कार्य प्राथमिकता (1..10)
//   +24: निष्पादित चक्र (Tick count)
//   +32: कार्य प्रावस्था (State-machine phase: 0, 1, 2, ...)
//   +40: कार्य डेटा मूल्य (Accumulator / state register)
//   +48: कार्य संदेश गणना (Messages processed)
//   +56: कार्य आवंटित पृष्ठ (Private 4KB memory page address)

कार्य कार्य_सारणी_पता() {
    परत् 147456; // 0x24000
}

कार्य कार्य_प्रणाली_आरंभ() {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या इ = 0;
    यावत् (इ < 8) {
        संख्या ऑफसेट = इ * 64;
        अंतर्_लिख8(सारणी, ऑफसेट + 0, 0);  // आईडी = 0
        अंतर्_लिख8(सारणी, ऑफसेट + 8, 0);  // स्थिति = निष्क्रिय
        अंतर्_लिख8(सारणी, ऑफसेट + 16, 0); // प्राथमिकता
        अंतर्_लिख8(सारणी, ऑफसेट + 24, 0); // चक्र
        अंतर्_लिख8(सारणी, ऑफसेट + 32, 0); // प्रावस्था
        अंतर्_लिख8(सारणी, ऑफसेट + 40, 0); // डेटा
        अंतर्_लिख8(सारणी, ऑफसेट + 48, 0); // संदेश
        अंतर्_लिख8(सारणी, ऑफसेट + 56, 0); // पृष्ठ पता
        इ = इ + 1;
    }
    अंतर्_लिख8(राज्य_पता(), 56, 0); // सक्रिय कार्य संख्या = 0
    परत् 0;
}

कार्य कार्य_सृजन(संख्या आईडी, संख्या प्राथमिकता, संख्या प्रारंभिक_डेटा) {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या इ = 0;
    यावत् (इ < 8) {
        संख्या ऑफसेट = इ * 64;
        यदि (अंतर्_पढ़8(सारणी, ऑफसेट + 0) == 0) { // रिक्त स्थान मिला
            संख्या निजी_पृष्ठ = पृष्ठ_आवंटन();
            अंतर्_लिख8(सारणी, ऑफसेट + 0, आईडी);
            अंतर्_लिख8(सारणी, ऑफसेट + 8, 1); // सज्जित (Ready)
            अंतर्_लिख8(सारणी, ऑफसेट + 16, प्राथमिकता);
            अंतर्_लिख8(सारणी, ऑफसेट + 24, 0);
            अंतर्_लिख8(सारणी, ऑफसेट + 32, 0); // प्रावस्था = 0
            अंतर्_लिख8(सारणी, ऑफसेट + 40, प्रारंभिक_डेटा);
            अंतर्_लिख8(सारणी, ऑफसेट + 48, 0);
            अंतर्_लिख8(सारणी, ऑफसेट + 56, निजी_पृष्ठ);

            संख्या सक्रिय = अंतर्_पढ़8(राज्य_पता(), 56);
            अंतर्_लिख8(राज्य_पता(), 56, सक्रिय + 1);
            परत् आईडी;
        }
        इ = इ + 1;
    }
    परत् 0; // सारणी पूर्ण है
}

कार्य कार्य_समाप्त(संख्या आईडी) {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या इ = 0;
    यावत् (इ < 8) {
        संख्या ऑफसेट = इ * 64;
        यदि (अंतर्_पढ़8(सारणी, ऑफसेट + 0) == आईडी) {
            अंतर्_लिख8(सारणी, ऑफसेट + 8, 3); // स्थिति = पूर्ण (Dead)
            संख्या निजी_पृष्ठ = अंतर्_पढ़8(सारणी, ऑफसेट + 56);
            यदि (निजी_पृष्ठ > 0) {
                पृष्ठ_मुक्त(निजी_पृष्ठ);
                अंतर्_लिख8(सारणी, ऑफसेट + 56, 0);
            }
            संख्या सक्रिय = अंतर्_पढ़8(राज्य_पता(), 56);
            यदि (सक्रिय > 0) {
                अंतर्_लिख8(राज्य_पता(), 56, सक्रिय - 1);
            }
            परत् 1;
        }
        इ = इ + 1;
    }
    परत् 0;
