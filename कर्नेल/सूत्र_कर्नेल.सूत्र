// ------------------------------------------------------------------------------
// भाग ४: अंतर्-प्रक्रिया संवाद (IPC Ring-Buffer Mailbox)
// ------------------------------------------------------------------------------
// प्रति कार्य डाकपेटिका (160 बाइट्स):
//   +0 : सिर (Head: 0..3)
//   +8 : पूंछ (Tail: 0..3)
//   +16: संदेश संख्या (0..4)
//   +32..+159: ४ संदेश कक्ष (प्रत्येक ३२ बाइट्स):
//       +0: प्रेषक आईडी
//       +8: संदेश प्रकार (100=संकेत, 200=डेटा, 300=स्वीकृति)
//       +16: तर्क १
//       +24: तर्क २

कार्य संवाद_सारणी_पता() {
    परत् 155648; // 0x26000
}

कार्य संवाद_प्रणाली_आरंभ() {
    संख्या सारणी = संवाद_सारणी_पता();
    संख्या कार्य_इ = 0;
    यावत् (कार्य_इ < 8) {
        संख्या पेटी_ऑफसेट = कार्य_इ * 160;
        अंतर्_लिख8(सारणी, पेटी_ऑफसेट + 0, 0);  // सिर = 0
        अंतर्_लिख8(सारणी, पेटी_ऑफसेट + 8, 0);  // पूंछ = 0
        अंतर्_लिख8(सारणी, पेटी_ऑफसेट + 16, 0); // संदेश गणना = 0
        कार्य_इ = कार्य_इ + 1;
    }
    परत् 0;
}

कार्य संदेश_प्रेषण(संख्या प्रेषक_आईडी, संख्या प्रापक_आईडी, संख्या प्रकार, संख्या डेटा१, संख्या डेटा२) {
    यदि (प्रापक_आईडी < 1 || प्रापक_आईडी > 8) { परत् 0; }
    संख्या प्रापक_इ = प्रापक_आईडी - 1;
    संख्या सारणी = संवाद_सारणी_पता();
    संख्या पेटी = सारणी + (प्रापक_इ * 160);

    संख्या गणना = अंतर्_पढ़8(पेटी, 16);
    यदि (गणना >= 4) {
        परत् 0; // पेटी भरी है (Mailbox full)
    }

    संख्या पूंछ = अंतर्_पढ़8(पेटी, 8);
    संख्या संदेश_कक्ष = पेटी + 32 + (पूंछ * 32);

    अंतर्_लिख8(संदेश_कक्ष, 0, प्रेषक_आईडी);
    अंतर्_लिख8(संदेश_कक्ष, 8, प्रकार);
    अंतर्_लिख8(संदेश_कक्ष, 16, डेटा१);
    अंतर्_लिख8(संदेश_कक्ष, 24, डेटा२);

    अंतर्_लिख8(पेटी, 8, (पूंछ + 1) % 4);
    अंतर्_लिख8(पेटी, 16, गणना + 1);
    परत् 1; // प्रेषण सफल
}

कार्य संदेश_ग्रहण(संख्या प्रापक_आईडी, संख्या बफर_पता) {
    यदि (प्रापक_आईडी < 1 || प्रापक_आईडी > 8) { परत् 0; }
    संख्या प्रापक_इ = प्रापक_आईडी - 1;
    संख्या सारणी = संवाद_सारणी_पता();
    संख्या पेटी = सारणी + (प्रापक_इ * 160);

    संख्या गणना = अंतर्_पढ़8(पेटी, 16);
    यदि (गणना == 0) {
        परत् 0; // कोई संदेश नहीं
    }

    संख्या सिर = अंतर्_पढ़8(पेटी, 0);
    संख्या संदेश_कक्ष = पेटी + 32 + (सिर * 32);

    // बफर में संदेश के चारों क्षेत्र प्रतिलिपि करो
    अंतर्_लिख8(बफर_पता, 0, अंतर्_पढ़8(संदेश_कक्ष, 0));
    अंतर्_लिख8(बफर_पता, 8, अंतर्_पढ़8(संदेश_कक्ष, 8));
    अंतर्_लिख8(बफर_पता, 16, अंतर्_पढ़8(संदेश_कक्ष, 16));
    अंतर्_लिख8(बफर_पता, 24, अंतर्_पढ़8(संदेश_कक्ष, 24));

    अंतर्_लिख8(पेटी, 0, (सिर + 1) % 4);
    अंतर्_लिख8(पेटी, 16, गणना - 1);
    परत् 1; // संदेश प्राप्त
}

