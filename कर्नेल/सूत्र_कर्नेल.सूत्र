कार्य तंत्र_आह्वान(संख्या कूट, संख्या तर्क१, संख्या तर्क२, संख्या तर्क३) {
    संख्या गणना = अंतर्_पढ़8(राज्य_पता(), 64);
    अंतर्_लिख8(राज्य_पता(), 64, गणना + 1);

    यदि (कूट == 1) { // लिख अक्षर
        कंसोल_लिख_अक्षर(तर्क१);
        परत् 0;
    } अन्यथा यदि (कूट == 2) { // लिख संख्या
        कंसोल_लिख_संख्या(तर्क१);
        परत् 0;
    } अन्यथा यदि (कूट == 3) { // लिख षोडश
        कंसोल_लिख_षोडश(तर्क१);
        परत् 0;
    } अन्यथा यदि (कूट == 4) { // पृष्ठ आवंटन
        परत् पृष्ठ_आवंटन();
    } अन्यथा यदि (कूट == 5) { // पृष्ठ मुक्त
        परत् पृष्ठ_मुक्त(तर्क१);
    } अन्यथा यदि (कूट == 6) { // कार्य सृजन
        परत् कार्य_सृजन(तर्क१, तर्क२, तर्क३);
    } अन्यथा यदि (कूट == 7) { // कार्य समाप्त
        परत् कार्य_समाप्त(तर्क१);
    } अन्यथा यदि (कूट == 8) { // संदेश प्रेषण (प्रेषक, प्रापक, प्रकार, डेटा१ -> तर्क३ पता)
        संख्या डेटा१ = अंतर्_पढ़8(तर्क३, 0);
        संख्या डेटा२ = अंतर्_पढ़8(तर्क३, 8);
        परत् संदेश_प्रेषण(तर्क१, तर्क२, 200, डेटा१, डेटा२);
    } अन्यथा यदि (कूट == 9) { // संदेश ग्रहण (प्रापक, बफर)
        परत् संदेश_ग्रहण(तर्क१, तर्क२);
    } अन्यथा यदि (कूट == 10) { // स्थिति जाँच
        यदि (तर्क१ == 1) { परत् अंतर्_पढ़8(राज्य_पता(), 32); } // टिक
        यदि (तर्क१ == 2) { परत् अंतर्_पढ़8(राज्य_पता(), 48); } // आवंटित पृष्ठ
        यदि (तर्क१ == 3) { परत् अंतर्_पढ़8(राज्य_पता(), 56); } // सक्रिय कार्य
    }
    परत् 0 - 1; // अज्ञात तंत्र-आह्वान
}

