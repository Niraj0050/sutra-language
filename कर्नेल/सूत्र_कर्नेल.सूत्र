// कर्नेल/सूत्र_कर्नेल.सूत्र — सूत्र स्वायत्त ऑपरेटिंग सिस्टम (SutraOS Microkernel)
// ==============================================================================
// शून्य-C, शून्य-POSIX, शून्य-HTML/CSS/JS — १००% शुद्ध पाणिनीय सूत्र x86-६४ कर्नेल
//
// वास्तुशिल्प (Architecture):
//   १. कंसोल उपप्रणाली: VGA 80x25 टेक्स्ट बफर (0xB8000), रंग, कर्सर, स्क्रोलिंग
//   २. भौतिक स्मृति प्रबंधक: 4KB पृष्ठ-चौखट आवंटक (Page Frame Allocator), बिटमैप
//   ३. कार्य प्रबंधक एवं क्रमक: सहकारी बहुकार्यन (Cooperative TCB Scheduler)
//   ४. अंतर्-प्रक्रिया संवाद: वलय-बफर संदेश पेटी (IPC Ring-Buffer Mailbox)
//   ५. तंत्र-आह्वान प्रेषक: १० मानक कर्नेल तंत्र-आह्वान (Syscall Dispatcher)
//   ६. स्वायत्त कर्नेल कार्य: स्मृति-रक्षक, संवेदक-उत्पादक, विश्लेषक-उपभोक्ता
// ==============================================================================

// ------------------------------------------------------------------------------
// भाग १: VGA कंसोल एवं स्क्रीन नियंत्रण (0xB8000)
// ------------------------------------------------------------------------------

कार्य कंसोल_तल_पता() {
    परत् ७५३६६४; // 0xB8000
}

कार्य राज्य_पता() {
    परत् १३१०७२; // 0x20000 — कर्नेल वैश्विक स्थिति आधार
}

कार्य कंसोल_पंक्ति_लो() {
    परत् अंतर्_पढ़8(राज्य_पता(), ८);
}

कार्य कंसोल_पंक्ति_रखो(संख्या पंक्ति) {
    अंतर्_लिख8(राज्य_पता(), ८, पंक्ति);
    परत् ०;
}

कार्य कंसोल_स्तंभ_लो() {
    परत् अंतर्_पढ़8(राज्य_पता(), १६);
}

कार्य कंसोल_स्तंभ_रखो(संख्या स्तंभ) {
    अंतर्_लिख8(राज्य_पता(), १६, स्तंभ);
    परत् ०;
}

कार्य कंसोल_रंग_लो() {
    परत् अंतर्_पढ़8(राज्य_पता(), २४);
}

कार्य कंसोल_रंग_रखो(संख्या रंग) {
    अंतर्_लिख8(राज्य_पता(), २४, रंग);
    परत् ०;
}

कार्य कंसोल_साफ_करो() {
    संख्या तल = कंसोल_तल_पता();
    संख्या रंग = कंसोल_रंग_लो();
    संख्या इ = ०;
    यावत् (इ < २०००) {
        अंतर्_लिख1(तल, इ * २, ३२);     // रिक्त स्थान (Space)
        अंतर्_लिख1(तल, इ * २ + १, रंग); // पृष्ठभूमि व अग्रभूमि रंग
        इ = इ + १;
    }
    कंसोल_पंक्ति_रखो(०);
    कंसोल_स्तंभ_रखो(०);
    परत् ०;
}

कार्य कंसोल_स्क्रोल() {
    संख्या तल = कंसोल_तल_पता();
    संख्या रंग = कंसोल_रंग_लो();
    संख्या पंक्ति = ०;
    यावत् (पंक्ति < २४) {
        संख्या स्तंभ = ०;
        यावत् (स्तंभ < ८०) {
            संख्या स्रोत_स्थान = ((पंक्ति + १) * ८० + स्तंभ) * २;
            संख्या लक्ष्य_स्थान = (पंक्ति * ८० + स्तंभ) * २;
            संख्या वर्ण = अंतर्_पढ़1(तल, स्रोत_स्थान);
            संख्या वर्ण_रंग = अंतर्_पढ़1(तल, स्रोत_स्थान + १);
            अंतर्_लिख1(तल, लक्ष्य_स्थान, वर्ण);
            अंतर्_लिख1(तल, लक्ष्य_स्थान + १, वर्ण_रंग);
            स्तंभ = स्तंभ + १;
        }
        पंक्ति = पंक्ति + १;
    }
    // अंतिम पंक्ति (२४) को रिक्त करो
    संख्या स्तंभ२ = ०;
    यावत् (स्तंभ२ < ८०) {
        संख्या अंतिम_स्थान = (२४ * ८० + स्तंभ२) * २;
        अंतर्_लिख1(तल, अंतिम_स्थान, ३२);
        अंतर्_लिख1(तल, अंतिम_स्थान + १, रंग);
        स्तंभ२ = स्तंभ२ + १;
    }
    कंसोल_पंक्ति_रखो(२४);
    कंसोल_स्तंभ_रखो(०);
    परत् ०;
}

कार्य कंसोल_लिख_अक्षर(संख्या वर्ण) {
    संख्या तल = कंसोल_तल_पता();
    संख्या पंक्ति = कंसोल_पंक्ति_लो();
    संख्या स्तंभ = कंसोल_स्तंभ_लो();
    संख्या रंग = कंसोल_रंग_लो();

    यदि (वर्ण == १०) { // '\n' (नयी पंक्ति)
        कंसोल_स्तंभ_रखो(०);
        पंक्ति = पंक्ति + १;
        यदि (पंक्ति >= २५) {
            कंसोल_स्क्रोल();
        } अन्यथा {
            कंसोल_पंक्ति_रखो(पंक्ति);
        }
        परत् ०;
    }

    यदि (वर्ण >= ३२) {
        संख्या स्थान = (पंक्ति * ८० + स्तंभ) * २;
        अंतर्_लिख1(तल, स्थान, वर्ण);
        अंतर्_लिख1(तल, स्थान + १, रंग);

        स्तंभ = स्तंभ + १;
        यदि (स्तंभ >= ८०) {
            कंसोल_स्तंभ_रखो(०);
            पंक्ति = पंक्ति + १;
            यदि (पंक्ति >= २५) {
                कंसोल_स्क्रोल();
            } अन्यथा {
                कंसोल_पंक्ति_रखो(पंक्ति);
            }
        } अन्यथा {
            कंसोल_स्तंभ_रखो(स्तंभ);
        }
    }
    परत् ०;
}

कार्य लिख_स्थान() {
    कंसोल_लिख_अक्षर(३२);
    परत् ०;
}

कार्य लिख_विराम() {
    कंसोल_लिख_अक्षर(१०);
    परत् ०;
}

कार्य लिख_विभाजक() {
    संख्या इ = ०;
    यावत् (इ < ७२) {
        कंसोल_लिख_अक्षर(६१); // '='
        इ = इ + १;
    }
    लिख_विराम();
    परत् ०;
}

कार्य लिख_उप_विभाजक() {
    संख्या इ = ०;
    यावत् (इ < ७२) {
        कंसोल_लिख_अक्षर(४५); // '-'
        इ = इ + १;
    }
    लिख_विराम();
    परत् ०;
}

कार्य कंसोल_लिख_संख्या(संख्या मूल्य) {
    यदि (मूल्य == ०) {
        कंसोल_लिख_अक्षर(४८); // '०'
        परत् ०;
    }
    यदि (मूल्य < ०) {
        कंसोल_लिख_अक्षर(४५); // '-'
        मूल्य = ० - मूल्य;
    }

    संख्या बफर_आधार = १३३१२०; // 0x20800 (स्क्रैच मेमोरी)
    संख्या सूचक = ०;
    यावत् (मूल्य > ०) {
        संख्या शेष = मूल्य % १०;
        अंतर्_लिख1(बफर_आधार, सूचक, ४८ + शेष);
        सूचक = सूचक + १;
        मूल्य = मूल्य / १०;
    }

    यावत् (सूचक > ०) {
        सूचक = सूचक - १;
        संख्या अंक = अंतर्_पढ़1(बफर_आधार, सूचक);
        कंसोल_लिख_अक्षर(अंक);
    }
    परत् ०;
}

कार्य कंसोल_लिख_षोडश(संख्या मूल्य) {
    कंसोल_लिख_अक्षर(४८);  // '०'
    कंसोल_लिख_अक्षर(१२०); // 'x'

    यदि (मूल्य == ०) {
        कंसोल_लिख_अक्षर(४८);
        परत् ०;
    }

    संख्या बफर_आधार = १३३१५२; // 0x20820
    संख्या सूचक = ०;
    यावत् (मूल्य > ०) {
        संख्या नीबल = बिट_और(मूल्य, १५);
        संख्या वर्ण = ४८ + नीबल;
        यदि (नीबल >= १०) {
            वर्ण = ६५ + (नीबल - १०); // 'A'..'F'
        }
        अंतर्_लिख1(बफर_आधार, सूचक, वर्ण);
        सूचक = सूचक + १;
        मूल्य = दक्षिण_सरक(मूल्य, ४);
    }

    यावत् (सूचक > ०) {
        सूचक = सूचक - १;
        संख्या वर्ण२ = अंतर्_पढ़1(बफर_आधार, सूचक);
        कंसोल_लिख_अक्षर(वर्ण२);
    }
    परत् ०;
}

// ------------------------------------------------------------------------------
// भाग २: भौतिक स्मृति प्रबंधक (Physical Memory & Frame Allocator)
// ------------------------------------------------------------------------------
// स्मृति विभाजन:
//   0x000000 - 0x01FFFF: बूटलोडर, कर्नेल कोड एवं डेटा
//   0x020000 - 0x020FFF: कर्नेल वैश्विक स्थिति (Global State)
//   0x021000 - 0x021FFF: पृष्ठ बिटमैप (५१२ पृष्ठ = 2MB भौतिक स्मृति)
//   0x024000 - 0x025FFF: कार्य नियंत्रण खंड सारणी (TCB Table)
//   0x026000 - 0x027FFF: अंतर्-प्रक्रिया संवाद संदेश पेटिका (IPC Mailboxes)
//   0x200000 (2MB)+    : गतिशील भौतिक पृष्ठ आवंटन क्षेत्र (Free Frames Pool)

कार्य बिटमैप_आधार_पता() {
    परत् १३५१६८; // 0x21000
}

कार्य गतिशील_स्मृति_आरंभ_पता() {
    परत् २०९७१५२; // 0x200000 (2MB)
}

कार्य भौतिक_स्मृति_शुरू(संख्या कुल_पृष्ठ_संख्या) {
    // वैश्विक स्थिति में जादुई संख्या एवं स्मृति सीमा अंकित करो
    अंतर्_लिख8(राज्य_पता(), ०, १४१४४१७२३३); // जादुई पहचान
    अंतर्_लिख8(राज्य_पता(), ३२, ०);          // टिक गणना = ०
    अंतर्_लिख8(राज्य_पता(), ४०, कुल_पृष्ठ_संख्या); // कुल पृष्ठ
    अंतर्_लिख8(राज्य_पता(), ४८, ०);          // आवंटित पृष्ठ = ०
    अंतर्_लिख8(राज्य_पता(), ५६, ०);          // सक्रिय कार्य = ०
    अंतर्_लिख8(राज्य_पता(), ६४, ०);          // तंत्र-आह्वान गणना = ०

    // बिटमैप को शून्य करो (प्रत्येक बिट = ० अर्थात पृष्ठ मुक्त है)
    संख्या बिटमैप = बिटमैप_आधार_पता();
    संख्या शब्द_संख्या = (कुल_पृष्ठ_संख्या + ६३) / ६४;
    संख्या इ = ०;
    यावत् (इ < शब्द_संख्या) {
        अंतर्_लिख8(बिटमैप, इ * ८, ०);
        इ = इ + १;
    }
    परत् ०;
}

कार्य पृष्ठ_आवंटन() {
    संख्या कुल_पृष्ठ = अंतर्_पढ़8(राज्य_पता(), ४०);
    संख्या बिटमैप = बिटमैप_आधार_पता();
    संख्या शब्द_संख्या = (कुल_पृष्ठ + ६३) / ६४;

    संख्या शब्द_इ = ०;
    यावत् (शब्द_इ < शब्द_संख्या) {
        संख्या शब्द = अंतर्_पढ़8(बिटमैप, शब्द_इ * ८);
        यदि (शब्द != ० - १) { // यदि कम से कम एक बिट ० है
            संख्या बिट_इ = ०;
            यावत् (बिट_इ < ६४) {
                संख्या मास्क = बाम_सरक(१, बिट_इ);
                यदि (बिट_और(शब्द, मास्क) == ०) {
                    // मुक्त पृष्ठ मिला! बिट को १ करो
                    अंतर्_लिख8(बिटमैप, शब्द_इ * ८, बिट_या(शब्द, मास्क));
                    संख्या आवंटित = अंतर्_पढ़8(राज्य_पता(), ४८);
                    अंतर्_लिख8(राज्य_पता(), ४८, आवंटित + १);

                    संख्या पृष्ठ_क्रमांक = शब्द_इ * ६४ + बिट_इ;
                    संख्या भौतिक_पता = गतिशील_स्मृति_आरंभ_पता() + (पृष्ठ_क्रमांक * ४०९६);
                    परत् भौतिक_पता;
                }
                बिट_इ = बिट_इ + १;
            }
        }
        शब्द_इ = शब्द_इ + १;
    }
    परत् ०; // स्मृति समाप्त (Out of memory)
}

कार्य पृष्ठ_मुक्त(संख्या भौतिक_पता) {
    संख्या गतिशील_आरंभ = गतिशील_स्मृति_आरंभ_पता();
    यदि (भौतिक_पता < गतिशील_आरंभ) {
        परत् ० - १; // अवैध पता
    }

    संख्या ऑफसेट = भौतिक_पता - गतिशील_आरंभ;
    संख्या पृष्ठ_क्रमांक = ऑफसेट / ४०९६;
    संख्या शब्द_इ = पृष्ठ_क्रमांक / ६४;
    संख्या बिट_इ = पृष्ठ_क्रमांक % ६४;

    संख्या बिटमैप = बिटमैप_आधार_पता();
    संख्या शब्द = अंतर्_पढ़8(बिटमैप, शब्द_इ * ८);
    संख्या मास्क = बाम_सरक(१, बिट_इ);

    यदि (बिट_और(शब्द, मास्क) != ०) {
        अंतर्_लिख8(बिटमैप, शब्द_इ * ८, बिट_और(शब्द, बिट_उलट(मास्क)));
        संख्या आवंटित = अंतर्_पढ़8(राज्य_पता(), ४८);
        यदि (आवंटित > ०) {
            अंतर्_लिख8(राज्य_पता(), ४८, आवंटित - १);
        }
        परत् १; // सफलता
    }
    परत् ०; // पहले से मुक्त था
}

// ------------------------------------------------------------------------------
// भाग ३: कार्य प्रबंधन एवं सहकारी क्रमक (Task Scheduler)
// ------------------------------------------------------------------------------
// TCB संरचना (प्रति कार्य ६४ बाइट्स, अधिकतम ८ कार्य):
//   +० : कार्य आईडी (१..८, ० = रिक्त)
//   +८ : कार्य स्थिति (० = शून्य, १ = सज्जित, २ = प्रतीक्षारत, ३ = पूर्ण)
//   +१६: कार्य प्राथमिकता (१..१०)
//   +२४: निष्पादित चक्र (Tick count)
//   +३२: कार्य प्रावस्था (State-machine phase: ०, १, २, ...)
//   +४०: कार्य डेटा मूल्य (Accumulator / state register)
//   +४८: कार्य संदेश गणना (Messages processed)
//   +५६: कार्य आवंटित पृष्ठ (Private 4KB memory page address)

कार्य कार्य_सारणी_पता() {
    परत् १४७४५६; // 0x24000
}

कार्य कार्य_प्रणाली_आरंभ() {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या इ = ०;
    यावत् (इ < ८) {
        संख्या ऑफसेट = इ * ६४;
        अंतर्_लिख8(सारणी, ऑफसेट + ०, ०);  // आईडी = ०
        अंतर्_लिख8(सारणी, ऑफसेट + ८, ०);  // स्थिति = निष्क्रिय
        अंतर्_लिख8(सारणी, ऑफसेट + १६, ०); // प्राथमिकता
        अंतर्_लिख8(सारणी, ऑफसेट + २४, ०); // चक्र
        अंतर्_लिख8(सारणी, ऑफसेट + ३२, ०); // प्रावस्था
        अंतर्_लिख8(सारणी, ऑफसेट + ४०, ०); // डेटा
        अंतर्_लिख8(सारणी, ऑफसेट + ४८, ०); // संदेश
        अंतर्_लिख8(सारणी, ऑफसेट + ५६, ०); // पृष्ठ पता
        इ = इ + १;
    }
    अंतर्_लिख8(राज्य_पता(), ५६, ०); // सक्रिय कार्य संख्या = ०
    परत् ०;
}

कार्य कार्य_सृजन(संख्या आईडी, संख्या प्राथमिकता, संख्या प्रारंभिक_डेटा) {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या इ = ०;
    यावत् (इ < ८) {
        संख्या ऑफसेट = इ * ६४;
        यदि (अंतर्_पढ़8(सारणी, ऑफसेट + ०) == ०) { // रिक्त स्थान मिला
            संख्या निजी_पृष्ठ = पृष्ठ_आवंटन();
            अंतर्_लिख8(सारणी, ऑफसेट + ०, आईडी);
            अंतर्_लिख8(सारणी, ऑफसेट + ८, १); // सज्जित (Ready)
            अंतर्_लिख8(सारणी, ऑफसेट + १६, प्राथमिकता);
            अंतर्_लिख8(सारणी, ऑफसेट + २४, ०);
            अंतर्_लिख8(सारणी, ऑफसेट + ३२, ०); // प्रावस्था = ०
            अंतर्_लिख8(सारणी, ऑफसेट + ४०, प्रारंभिक_डेटा);
            अंतर्_लिख8(सारणी, ऑफसेट + ४८, ०);
            अंतर्_लिख8(सारणी, ऑफसेट + ५६, निजी_पृष्ठ);

            संख्या सक्रिय = अंतर्_पढ़8(राज्य_पता(), ५६);
            अंतर्_लिख8(राज्य_पता(), ५६, सक्रिय + १);
            परत् आईडी;
        }
        इ = इ + १;
    }
    परत् ०; // सारणी पूर्ण है
}

कार्य कार्य_समाप्त(संख्या आईडी) {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या इ = ०;
    यावत् (इ < ८) {
        संख्या ऑफसेट = इ * ६४;
        यदि (अंतर्_पढ़8(सारणी, ऑफसेट + ०) == आईडी) {
            अंतर्_लिख8(सारणी, ऑफसेट + ८, ३); // स्थिति = पूर्ण (Dead)
            संख्या निजी_पृष्ठ = अंतर्_पढ़8(सारणी, ऑफसेट + ५६);
            यदि (निजी_पृष्ठ > ०) {
                पृष्ठ_मुक्त(निजी_पृष्ठ);
                अंतर्_लिख8(सारणी, ऑफसेट + ५६, ०);
            }
            संख्या सक्रिय = अंतर्_पढ़8(राज्य_पता(), ५६);
            यदि (सक्रिय > ०) {
                अंतर्_लिख8(राज्य_पता(), ५६, सक्रिय - १);
            }
            परत् १;
        }
        इ = इ + १;
    }
    परत् ०;
}

// ------------------------------------------------------------------------------
// भाग ४: अंतर्-प्रक्रिया संवाद (IPC Ring-Buffer Mailbox)
// ------------------------------------------------------------------------------
// प्रति कार्य डाकपेटिका (१६० बाइट्स):
//   +० : सिर (Head: ०..३)
//   +८ : पूंछ (Tail: ०..३)
//   +१६: संदेश संख्या (०..४)
//   +३२..+१५९: ४ संदेश कक्ष (प्रत्येक ३२ बाइट्स):
//       +०: प्रेषक आईडी
//       +८: संदेश प्रकार (१००=संकेत, २००=डेटा, ३००=स्वीकृति)
//       +१६: तर्क १
//       +२४: तर्क २

कार्य संवाद_सारणी_पता() {
    परत् १५५६४८; // 0x26000
}

कार्य संवाद_प्रणाली_आरंभ() {
    संख्या सारणी = संवाद_सारणी_पता();
    संख्या कार्य_इ = ०;
    यावत् (कार्य_इ < ८) {
        संख्या पेटी_ऑफसेट = कार्य_इ * १६०;
        अंतर्_लिख8(सारणी, पेटी_ऑफसेट + ०, ०);  // सिर = ०
        अंतर्_लिख8(सारणी, पेटी_ऑफसेट + ८, ०);  // पूंछ = ०
        अंतर्_लिख8(सारणी, पेटी_ऑफसेट + १६, ०); // संदेश गणना = ०
        कार्य_इ = कार्य_इ + १;
    }
    परत् ०;
}

कार्य संदेश_प्रेषण(संख्या प्रेषक_आईडी, संख्या प्रापक_आईडी, संख्या प्रकार, संख्या डेटा१, संख्या डेटा२) {
    यदि (प्रापक_आईडी < १ || प्रापक_आईडी > ८) { परत् ०; }
    संख्या प्रापक_इ = प्रापक_आईडी - १;
    संख्या सारणी = संवाद_सारणी_पता();
    संख्या पेटी = सारणी + (प्रापक_इ * १६०);

    संख्या गणना = अंतर्_पढ़8(पेटी, १६);
    यदि (गणना >= ४) {
        परत् ०; // पेटी भरी है (Mailbox full)
    }

    संख्या पूंछ = अंतर्_पढ़8(पेटी, ८);
    संख्या संदेश_कक्ष = पेटी + ३२ + (पूंछ * ३२);

    अंतर्_लिख8(संदेश_कक्ष, ०, प्रेषक_आईडी);
    अंतर्_लिख8(संदेश_कक्ष, ८, प्रकार);
    अंतर्_लिख8(संदेश_कक्ष, १६, डेटा१);
    अंतर्_लिख8(संदेश_कक्ष, २४, डेटा२);

    अंतर्_लिख8(पेटी, ८, (पूंछ + १) % ४);
    अंतर्_लिख8(पेटी, १६, गणना + १);
    परत् १; // प्रेषण सफल
}

कार्य संदेश_ग्रहण(संख्या प्रापक_आईडी, संख्या बफर_पता) {
    यदि (प्रापक_आईडी < १ || प्रापक_आईडी > ८) { परत् ०; }
    संख्या प्रापक_इ = प्रापक_आईडी - १;
    संख्या सारणी = संवाद_सारणी_पता();
    संख्या पेटी = सारणी + (प्रापक_इ * १६०);

    संख्या गणना = अंतर्_पढ़8(पेटी, १६);
    यदि (गणना == ०) {
        परत् ०; // कोई संदेश नहीं
    }

    संख्या सिर = अंतर्_पढ़8(पेटी, ०);
    संख्या संदेश_कक्ष = पेटी + ३२ + (सिर * ३२);

    // बफर में संदेश के चारों क्षेत्र प्रतिलिपि करो
    अंतर्_लिख8(बफर_पता, ०, अंतर्_पढ़8(संदेश_कक्ष, ०));
    अंतर्_लिख8(बफर_पता, ८, अंतर्_पढ़8(संदेश_कक्ष, ८));
    अंतर्_लिख8(बफर_पता, १६, अंतर्_पढ़8(संदेश_कक्ष, १६));
    अंतर्_लिख8(बफर_पता, २४, अंतर्_पढ़8(संदेश_कक्ष, २४));

    अंतर्_लिख8(पेटी, ०, (सिर + १) % ४);
    अंतर्_लिख8(पेटी, १६, गणना - १);
    परत् १; // संदेश प्राप्त
}

// ------------------------------------------------------------------------------
// भाग ५: तंत्र-आह्वान प्रेषक (Syscall Dispatcher)
// ------------------------------------------------------------------------------

कार्य तंत्र_आह्वान(संख्या कूट, संख्या तर्क१, संख्या तर्क२, संख्या तर्क३) {
    संख्या गणना = अंतर्_पढ़8(राज्य_पता(), ६४);
    अंतर्_लिख8(राज्य_पता(), ६४, गणना + १);

    यदि (कूट == १) { // लिख अक्षर
        कंसोल_लिख_अक्षर(तर्क१);
        परत् ०;
    } अन्यथा यदि (कूट == २) { // लिख संख्या
        कंसोल_लिख_संख्या(तर्क१);
        परत् ०;
    } अन्यथा यदि (कूट == ३) { // लिख षोडश
        कंसोल_लिख_षोडश(तर्क१);
        परत् ०;
    } अन्यथा यदि (कूट == ४) { // पृष्ठ आवंटन
        परत् पृष्ठ_आवंटन();
    } अन्यथा यदि (कूट == ५) { // पृष्ठ मुक्त
        परत् पृष्ठ_मुक्त(तर्क१);
    } अन्यथा यदि (कूट == ६) { // कार्य सृजन
        परत् कार्य_सृजन(तर्क१, तर्क२, तर्क३);
    } अन्यथा यदि (कूट == ७) { // कार्य समाप्त
        परत् कार्य_समाप्त(तर्क१);
    } अन्यथा यदि (कूट == ८) { // संदेश प्रेषण (प्रेषक, प्रापक, प्रकार, डेटा१ -> तर्क३ पता)
        संख्या डेटा१ = अंतर्_पढ़8(तर्क३, ०);
        संख्या डेटा२ = अंतर्_पढ़8(तर्क३, ८);
        परत् संदेश_प्रेषण(तर्क१, तर्क२, २००, डेटा१, डेटा२);
    } अन्यथा यदि (कूट == ९) { // संदेश ग्रहण (प्रापक, बफर)
        परत् संदेश_ग्रहण(तर्क१, तर्क२);
    } अन्यथा यदि (कूट == १०) { // स्थिति जाँच
        यदि (तर्क१ == १) { परत् अंतर्_पढ़8(राज्य_पता(), ३२); } // टिक
        यदि (तर्क१ == २) { परत् अंतर्_पढ़8(राज्य_पता(), ४८); } // आवंटित पृष्ठ
        यदि (तर्क१ == ३) { परत् अंतर्_पढ़8(राज्य_पता(), ५६); } // सक्रिय कार्य
    }
    परत् ० - १; // अज्ञात तंत्र-आह्वान
}

