// कार्य १: स्मृति रक्षक (Watchdog) — पृष्ठ आवंटित करता, जाँचता, मुक्त करता है
कार्य कदम_स्मृति_रक्षक(संख्या कार्य_ऑफसेट) {
    संख्या प्रावस्था = अंतर्_पढ़8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 32);
    संख्या डेटा = अंतर्_पढ़8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40);

    यदि (प्रावस्था == 0) {
        // नया पृष्ठ माँगो
        संख्या पृष्ठ = तंत्र_आह्वान(4, 0, 0, 0);
        यदि (पृष्ठ > 0) {
            // परीक्षण मान लिखो
            अंतर्_लिख8(पृष्ठ, 0, 12345678);
            अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40, पृष्ठ);
            अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 32, 1);
        }
    } अन्यथा यदि (प्रावस्था == 1) {
        // डेटा अखंडता जाँचो एवं मुक्त करो
        संख्या पृष्ठ२ = अंतर्_पढ़8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40);
        यदि (पृष्ठ२ > 0) {
            संख्या पृष्ठ_मूल्य = अंतर्_पढ़8(पृष्ठ२, 0);
            यदि (पृष्ठ_मूल्य == 12345678) {
                // सफल परीक्षण — मुक्त करो
                तंत्र_आह्वान(5, पृष्ठ२, 0, 0);
                अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40, 0);
                अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 32, 0);
            }
        }
    }
    परत् 0;
}

// कार्य २: संवेदक उत्पादक (Sensor Producer) — मान बनाता एवं कार्य ३ को भेजता है
कार्य कदम_संवेदक(संख्या कार्य_ऑफसेट) {
    संख्या टिक = अंतर्_पढ़8(राज्य_पता(), 32);
    संख्या डेटा = अंतर्_पढ़8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40) + 7;
    अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40, डेटा);

    // स्क्रैच मेमोरी में पेलोड रखो (133200)
    अंतर्_लिख8(133200, 0, टिक);
    अंतर्_लिख8(133200, 8, डेटा);

    // कार्य ३ को संदेश भेजो (Syscall 8)
    तंत्र_आह्वान(8, 2, 3, 133200);
    परत् 0;
}

// कार्य ३: विश्लेषक उपभोक्ता (Analyzer Consumer) — संदेश प्राप्त करता व पुष्टि करता है
कार्य कदम_विश्लेषक(संख्या कार्य_ऑफसेट) {
    संख्या बफर = 133250;
    संख्या मिला = तंत्र_आह्वान(9, 3, बफर, 0);
    यदि (मिला == 1) {
        संख्या प्रेषक = अंतर्_पढ़8(बफर, 0);
        संख्या प्रकार = अंतर्_पढ़8(बफर, 8);
        संख्या टिक = अंतर्_पढ़8(बफर, 16);
        संख्या डेटा = अंतर्_पढ़8(बफर, 24);

        संख्या कुल_संदेश = अंतर्_पढ़8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 48);
        अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 48, कुल_संदेश + 1);
        अंतर्_लिख8(कार्य_सारणी_पता(), कार्य_ऑफसेट + 40, डेटा);
    }
    परत् 0;
}

कार्य कार्य_कदम_चलाओ(संख्या सूचक) {
    संख्या सारणी = कार्य_सारणी_पता();
    संख्या ऑफसेट = सूचक * 64;
    संख्या आईडी = अंतर्_पढ़8(सारणी, ऑफसेट + 0);
    संख्या स्थिति = अंतर्_पढ़8(सारणी, ऑफसेट + 8);

    यदि (आईडी > 0 && स्थिति == 1) { // सक्रिय व सज्जित
        संख्या चक्र = अंतर्_पढ़8(सारणी, ऑफसेट + 24);
        अंतर्_लिख8(सारणी, ऑफसेट + 24, चक्र + 1);

        यदि (आईडी == 1) {
            कदम_स्मृति_रक्षक(ऑफसेट);
        } अन्यथा यदि (आईडी == 2) {
            कदम_संवेदक(ऑफसेट);
        } अन्यथा यदि (आईडी == 3) {
            कदम_विश्लेषक(ऑफसेट);
        }
    }
    परत् 0;
}

