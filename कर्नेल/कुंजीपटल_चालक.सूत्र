// कर्नेल/कुंजीपटल_चालक.सूत्र — सूत्र स्वायत्त कुंजीपटल चालक (PS/2 Keyboard Driver)
// ==============================================================================
// शून्य-C, शून्य-POSIX — १००% शुद्ध पाणिनीय सूत्र x86-64 कर्नेल इनपुट चालक
//
// वास्तुशिल्प (Architecture):
//   १. वृत्ताकार रिंग बफर (०x२A००० / १७२०३२)
//   २. PS/2 स्कैन-कोड सेट १ डिकोडर (Scan Code Set 1: दबाना व छोड़ना)
//   ३. शिफ्ट एवं नियंत्रण स्थिति (Shift & Control Modifier Tracking)
//   ४. गैर-अवरोधक पठन (Non-blocking Keyboard Read API)
//   ५. देवनागरी/ASCII वर्ण प्रतिचित्रण
// ==============================================================================

// कुंजीपटल स्थिति आधार (०x२A०००)
कार्य कुंजीपटल_आधार_पता() {
    परत् १७२०३२; // ०x२A०००
}

कार्य कुंजीपटल_जादुई_पहचान() {
    परत् १२६३८८२५७८; // 'KEYB'
}

// ------------------------------------------------------------------------------
// भाग १: कुंजीपटल चालक आरंभीकरण
// ------------------------------------------------------------------------------

कार्य कुंजीपटल_आरंभ() {
    संख्या आधार = कुंजीपटल_आधार_पता();
    अंतर्_लिख8(आधार, ०, कुंजीपटल_जादुई_पहचान());
    अंतर्_लिख8(आधार, ८, ०);   // शीर्ष (Head)
    अंतर्_लिख8(आधार, १६, ०);  // पुच्छ (Tail)
    अंतर्_लिख8(आधार, २४, ६४); // क्षमता (Capacity = ६४ bytes)
    अंतर्_लिख8(आधार, ३२, ०);  // शिफ्ट स्थिति (Shift = ०)
    अंतर्_लिख8(आधार, ४०, ०);  // कुल कुंजी गणना
    अंतर्_लिख8(आधार, ४८, ०);  // अंतिम वर्ण

    // बफर शून्य करो
    संख्या इ = ०;
    यावत् (इ < ६४) {
        अंतर्_लिख1(आधार, ६४ + इ, ०);
        इ = इ + १;
    }
    परत् ०;
}

// ------------------------------------------------------------------------------
// भाग २: स्कैन-कोड सेट १ डिकोडर (Scancode Decoder)
// ------------------------------------------------------------------------------

कार्य स्कैन_कोड_से_वर्ण(संख्या स्कैन_कोड, संख्या शिफ्ट_सक्रिय) {
    // ०x१E = 'A' (६५ / ९७)
    यदि (स्कैन_कोड == ३०) { यदि (शिफ्ट_सक्रिय == १) { परत् ६५; } अन्यथा { परत् ९७; } }
    // ०x३० = 'B'
    यदि (स्कैन_कोड == ४८) { यदि (शिफ्ट_सक्रिय == १) { परत् ६६; } अन्यथा { परत् ९८; } }
    // ०x२E = 'C'
    यदि (स्कैन_कोड == ४६) { यदि (शिफ्ट_सक्रिय == १) { परत् ६७; } अन्यथा { परत् ९९; } }
    // ०x२० = 'D'
    यदि (स्कैन_कोड == ३२) { यदि (शिफ्ट_सक्रिय == १) { परत् ६८; } अन्यथा { परत् १००; } }
    // ०x१२ = 'E'
    यदि (स्कैन_कोड == १८) { यदि (शिफ्ट_सक्रिय == १) { परत् ६९; } अन्यथा { परत् १०१; } }
    // ०x२१ = 'F'
    यदि (स्कैन_कोड == ३३) { यदि (शिफ्ट_सक्रिय == १) { परत् ७०; } अन्यथा { परत् १०२; } }
    // ०x२२ = 'G'
    यदि (स्कैन_कोड == ३४) { यदि (शिफ्ट_सक्रिय == १) { परत् ७१; } अन्यथा { परत् १०३; } }
    // ०x२३ = 'H'
    यदि (स्कैन_कोड == ३५) { यदि (शिफ्ट_सक्रिय == १) { परत् ७२; } अन्यथा { परत् १०४; } }
    // ०x१७ = 'I'
    यदि (स्कैन_कोड == २३) { यदि (शिफ्ट_सक्रिय == १) { परत् ७३; } अन्यथा { परत् १०५; } }
    // ०x२४ = 'J'
    यदि (स्कैन_कोड == ३६) { यदि (शिफ्ट_सक्रिय == १) { परत् ७४; } अन्यथा { परत् १०६; } }
    // ०x२५ = 'K'
    यदि (स्कैन_कोड == ३७) { यदि (शिफ्ट_सक्रिय == १) { परत् ७५; } अन्यथा { परत् १०७; } }
    // ०x२६ = 'L'
    यदि (स्कैन_कोड == ३८) { यदि (शिफ्ट_सक्रिय == १) { परत् ७६; } अन्यथा { परत् १०८; } }
    // ०x३२ = 'M'
    यदि (स्कैन_कोड == ५०) { यदि (शिफ्ट_सक्रिय == १) { परत् ७७; } अन्यथा { परत् १०९; } }
    // ०x३१ = 'N'
    यदि (स्कैन_कोड == ४९) { यदि (शिफ्ट_सक्रिय == १) { परत् ७८; } अन्यथा { परत् ११०; } }
    // ०x१८ = 'O'
    यदि (स्कैन_कोड == २४) { यदि (शिफ्ट_सक्रिय == १) { परत् ७९; } अन्यथा { परत् १११; } }
    // ०x१९ = 'P'
    यदि (स्कैन_कोड == २५) { यदि (शिफ्ट_सक्रिय == १) { परत् ८०; } अन्यथा { परत् ११२; } }
    // ०x१० = 'Q'
    यदि (स्कैन_कोड == १६) { यदि (शिफ्ट_सक्रिय == १) { परत् ८१; } अन्यथा { परत् ११३; } }
    // ०x१३ = 'R'
    यदि (स्कैन_कोड == १९) { यदि (शिफ्ट_सक्रिय == १) { परत् ८२; } अन्यथा { परत् ११४; } }
    // ०x१F = 'S'
    यदि (स्कैन_कोड == ३१) { यदि (शिफ्ट_सक्रिय == १) { परत् ८३; } अन्यथा { परत् ११५; } }
    // ०x१४ = 'T'
    यदि (स्कैन_कोड == २०) { यदि (शिफ्ट_सक्रिय == १) { परत् ८४; } अन्यथा { परत् ११६; } }
    // ०x१६ = 'U'
    यदि (स्कैन_कोड == २२) { यदि (शिफ्ट_सक्रिय == १) { परत् ८५; } अन्यथा { परत् ११७; } }
    // ०x२F = 'V'
    यदि (स्कैन_कोड == ४७) { यदि (शिफ्ट_सक्रिय == १) { परत् ८६; } अन्यथा { परत् ११८; } }
    // ०x११ = 'W'
    यदि (स्कैन_कोड == १७) { यदि (शिफ्ट_सक्रिय == १) { परत् ८७; } अन्यथा { परत् ११९; } }
    // ०x२D = 'X'
    यदि (स्कैन_कोड == ४५) { यदि (शिफ्ट_सक्रिय == १) { परत् ८८; } अन्यथा { परत् १२०; } }
    // ०x१५ = 'Y'
    यदि (स्कैन_कोड == २१) { यदि (शिफ्ट_सक्रिय == १) { परत् ८९; } अन्यथा { परत् १२१; } }
    // ०x२C = 'Z'
    यदि (स्कैन_कोड == ४४) { यदि (शिफ्ट_सक्रिय == १) { परत् ९०; } अन्यथा { परत् १२२; } }

    // अंक (०x०२..०x०B = '1'..'9', '0')
    यदि (स्कैन_कोड >= २ && स्कैन_कोड <= १०) {
        परत् ४७ + स्कैन_कोड; // '1'..'9'
    }
    यदि (स्कैन_कोड == ११) { परत् ४८; } // '0'

    // विशेष कुंजियाँ
    यदि (स्कैन_कोड == २८) { परत् १०; } // Enter / Newline '\n'
    यदि (स्कैन_कोड == ५७) { परत् ३२; } // Space ' '
    यदि (स्कैन_कोड == १४) { परत् ८; }  // Backspace '\b'

    परत् ०; // अज्ञात अथवा गैर-मुद्रण योग्य
}

// ------------------------------------------------------------------------------
// भाग ३: बफर में कुंजी डालना एवं निकालना (Enqueue & Dequeue)
// ------------------------------------------------------------------------------

कार्य कुंजी_डालो(संख्या स्कैन_कोड) {
    संख्या आधार = कुंजीपタル_आधार_पता();

    // शिफ्ट कुंजी का पता लगाना: ०x२A (Left Shift down), ०x३६ (Right Shift down)
    यदि (स्कैन_कोड == ४२ || स्कैन_कोड == ५४) {
        अंतर्_लिख8(आधार, ३२, १);
        परत् ०;
    }
    // शिफ्ट कुंजी छोड़ना: ०xAA (०x२A + ०x८०), ०xB६ (०x३६ + ०x८०)
    यदि (स्कैन_कोड == १७० || स्कैन_कोड == १८२) {
        अंतर्_लिख8(आधार, ३२, ०);
        परत् ०;
    }

    // यदि कुंजी छोड़ने (Release: code >= १२८) का संकेत है तो उपेक्षा करो
    यदि (स्कैन_कोड >= १२८) {
        परत् ०;
    }

    संख्या शिफ्ट = अंतर्_पढ़8(आधार, ३२);
    संख्या वर्ण = स्कैन_कोड_से_वर्ण(स्कैन_कोड, शिफ्ट);
    यदि (वर्ण == ०) {
        परत् ०;
    }

    संख्या शीर्ष = अंतर्_पढ़8(आधार, ८);
    संख्या पुच्छ = अंतर्_पढ़8(आधार, १६);
    संख्या क्षमता = अंतर्_पढ़8(आधार, २४);

    संख्या अगला_शीर्ष = (शीर्ष + १) % क्षमता;
    यदि (अगला_शीर्ष != पुच्छ) { // यदि बफर भरा नहीं है
        अंतर्_लिख1(आधार, ६४ + शीर्ष, वर्ण);
        अंतर्_लिख8(आधार, ८, अगला_शीर्ष);

        संख्या कुल = अंतर्_पढ़8(आधार, ४०);
        अंतर्_लिख8(आधार, ४०, कुल + १);
        अंतर्_लिख8(आधार, ४८, वर्ण);
        परत् १;
    }
    परत् ०; // बफर पूर्ण
}

कार्य कुंजी_निकालो() {
    संख्या आधार = कुंजीपटल_आधार_पता();
    संख्या शीर्ष = अंतर्_पढ़8(आधार, ८);
    संख्या पुच्छ = अंतर्_पढ़8(आधार, १६);
    संख्या क्षमता = अंतर्_पढ़8(आधार, २४);

    यदि (शीर्ष == पुच्छ) {
        परत् ०; // बफर रिक्त है
    }

    संख्या वर्ण = अंतर्_पढ़1(आधार, ६४ + पुच्छ);
    संख्या अगला_पुच्छ = (पुच्छ + १) % क्षमता;
    अंतर्_लिख8(आधार, १६, अगला_पुच्छ);
    परत् वर्ण;
}

कार्य कुंजी_उपलब्ध_है() {
    संख्या आधार = कुंजीपटल_आधार_पता();
    संख्या शीर्ष = अंतर्_पढ़8(आधार, ८);
    संख्या पुच्छ = अंतर्_पढ़8(आधार, १६);
    यदि (शीर्ष != पुच्छ) {
        परत् १;
    }
    परत् ०;
}
