// कर्नेल/कुंजीपटल_चालक.सूत्र — सूत्र स्वायत्त कुंजीपटल चालक (PS/2 Keyboard Driver)
// ==============================================================================
// शून्य-C, शून्य-POSIX — 100% शुद्ध पाणिनीय सूत्र x86-64 कर्नेल इनपुट चालक
//
// वास्तुशिल्प (Architecture):
//   1. वृत्ताकार रिंग बफर (Circular Buffer at 0x2A000 / 172032)
//   2. PS/2 स्कैन-कोड सेट १ डिकोडर (Scan Code Set 1: दबाना व छोड़ना)
//   3. शिफ्ट एवं नियंत्रण स्थिति (Shift & Control Modifier Tracking)
//   4. गैर-अवरोधक पठन (Non-blocking Keyboard Read API)
//   5. देवनागरी/ASCII वर्ण प्रतिचित्रण
// ==============================================================================

// कुंजीपटल स्थिति आधार (0x2A000)
कार्य कुंजीपटल_आधार_पता() {
    परत् 172032; // 0x2A000
}

कार्य कुंजीपटल_जादुई_पहचान() {
    परत् 1263882578; // 'KEYB'
}

// ------------------------------------------------------------------------------
// भाग १: कुंजीपटल चालक आरंभीकरण
// ------------------------------------------------------------------------------

कार्य कुंजीपटल_आरंभ() {
    संख्या आधार = कुंजीपटल_आधार_पता();
    अंतर्_लिख8(आधार, 0, कुंजीपटल_जादुई_पहचान());
    अंतर्_लिख8(आधार, 8, 0);   // शीर्ष (Head)
    अंतर्_लिख8(आधार, 16, 0);  // पुच्छ (Tail)
    अंतर्_लिख8(आधार, 24, 64); // क्षमता (Capacity = 64 bytes)
    अंतर्_लिख8(आधार, 32, 0);  // शिफ्ट स्थिति (Shift = 0)
    अंतर्_लिख8(आधार, 40, 0);  // कुल कुंजी गणना
    अंतर्_लिख8(आधार, 48, 0);  // अंतिम वर्ण

    // बफर शून्य करो
    संख्या इ = 0;
    यावत् (इ < 64) {
        अंतर्_लिख1(आधार, 64 + इ, 0);
        इ = इ + 1;
    }
    परत् 0;
}

// ------------------------------------------------------------------------------
// भाग २: स्कैन-कोड सेट १ डिकोडर (Scancode Decoder)
// ------------------------------------------------------------------------------

कार्य स्कैन_कोड_से_वर्ण(संख्या स्कैन_कोड, संख्या शिफ्ट_सक्रिय) {
    // 0x1E = 'A' (65 / 97)
    यदि (स्कैन_कोड == 30) { यदि (शिफ्ट_सक्रिय == 1) { परत् 65; } अन्यथा { परत् 97; } }
    // 0x30 = 'B'
    यदि (स्कैन_कोड == 48) { यदि (शिफ्ट_सक्रिय == 1) { परत् 66; } अन्यथा { परत् 98; } }
    // 0x2E = 'C'
    यदि (स्कैन_कोड == 46) { यदि (शिफ्ट_सक्रिय == 1) { परत् 67; } अन्यथा { परत् 99; } }
    // 0x20 = 'D'
    यदि (स्कैन_कोड == 32) { यदि (शिफ्ट_सक्रिय == 1) { परत् 68; } अन्यथा { परत् 100; } }
    // 0x12 = 'E'
    यदि (स्कैन_कोड == 18) { यदि (शिफ्ट_सक्रिय == 1) { परत् 69; } अन्यथा { परत् 101; } }
    // 0x21 = 'F'
    यदि (स्कैन_कोड == 33) { यदि (शिफ्ट_सक्रिय == 1) { परत् 70; } अन्यथा { परत् 102; } }
    // 0x22 = 'G'
    यदि (स्कैन_कोड == 34) { यदि (शिफ्ट_सक्रिय == 1) { परत् 71; } अन्यथा { परत् 103; } }
    // 0x23 = 'H'
    यदि (स्कैन_कोड == 35) { यदि (शिफ्ट_सक्रिय == 1) { परत् 72; } अन्यथा { परत् 104; } }
    // 0x17 = 'I'
    यदि (स्कैन_कोड == 23) { यदि (शिफ्ट_सक्रिय == 1) { परत् 73; } अन्यथा { परत् 105; } }
    // 0x24 = 'J'
    यदि (स्कैन_कोड == 36) { यदि (शिफ्ट_सक्रिय == 1) { परत् 74; } अन्यथा { परत् 106; } }
    // 0x25 = 'K'
    यदि (स्कैन_कोड == 37) { यदि (शिफ्ट_सक्रिय == 1) { परत् 75; } अन्यथा { परत् 107; } }
    // 0x26 = 'L'
    यदि (स्कैन_कोड == 38) { यदि (शिफ्ट_सक्रिय == 1) { परत् 76; } अन्यथा { परत् 108; } }
    // 0x32 = 'M'
    यदि (स्कैन_कोड == 50) { यदि (शिफ्ट_सक्रिय == 1) { परत् 77; } अन्यथा { परत् 109; } }
    // 0x31 = 'N'
    यदि (स्कैन_कोड == 49) { यदि (शिफ्ट_सक्रिय == 1) { परत् 78; } अन्यथा { परत् 110; } }
    // 0x18 = 'O'
    यदि (स्कैन_कोड == 24) { यदि (शिफ्ट_सक्रिय == 1) { परत् 79; } अन्यथा { परत् 111; } }
    // 0x19 = 'P'
    यदि (स्कैन_कोड == 25) { यदि (शिफ्ट_सक्रिय == 1) { परत् 80; } अन्यथा { परत् 112; } }
    // 0x10 = 'Q'
    यदि (स्कैन_कोड == 16) { यदि (शिफ्ट_सक्रिय == 1) { परत् 81; } अन्यथा { परत् 113; } }
    // 0x13 = 'R'
    यदि (स्कैन_कोड == 19) { यदि (शिफ्ट_सक्रिय == 1) { परत् 82; } अन्यथा { परत् 114; } }
    // 0x1F = 'S'
    यदि (स्कैन_कोड == 31) { यदि (शिफ्ट_सक्रिय == 1) { परत् 83; } अन्यथा { परत् 115; } }
    // 0x14 = 'T'
    यदि (स्कैन_कोड == 20) { यदि (शिफ्ट_सक्रिय == 1) { परत् 84; } अन्यथा { परत् 116; } }
    // 0x16 = 'U'
    यदि (स्कैन_कोड == 22) { यदि (शिफ्ट_सक्रिय == 1) { परत् 85; } अन्यथा { परत् 117; } }
    // 0x2F = 'V'
    यदि (स्कैन_कोड == 47) { यदि (शिफ्ट_सक्रिय == 1) { परत् 86; } अन्यथा { परत् 118; } }
    // 0x11 = 'W'
    यदि (स्कैन_कोड == 17) { यदि (शिफ्ट_सक्रिय == 1) { परत् 87; } अन्यथा { परत् 119; } }
    // 0x2D = 'X'
    यदि (स्कैन_कोड == 45) { यदि (शिफ्ट_सक्रिय == 1) { परत् 88; } अन्यथा { परत् 120; } }
    // 0x15 = 'Y'
    यदि (स्कैन_कोड == 21) { यदि (शिफ्ट_सक्रिय == 1) { परत् 89; } अन्यथा { परत् 121; } }
    // 0x2C = 'Z'
    यदि (स्कैन_कोड == 44) { यदि (शिफ्ट_सक्रिय == 1) { परत् 90; } अन्यथा { परत् 122; } }

    // अंक (0x02..0x0B = '1'..'9', '0')
    यदि (स्कैन_कोड >= 2 && स्कैन_कोड <= 10) {
        परत् 47 + स्कैन_कोड; // '1'..'9'
    }
    यदि (स्कैन_कोड == 11) { परत् 48; } // '0'

    // विशेष कुंजियाँ
    यदि (स्कैन_कोड == 28) { परत् 10; } // Enter / Newline '\n'
    यदि (स्कैन_कोड == 57) { परत् 32; } // Space ' '
    यदि (स्कैन_कोड == 14) { परत् 8; }  // Backspace '\b'

    परत् 0; // अज्ञात अथवा गैर-मुद्रण योग्य
}

// ------------------------------------------------------------------------------
// भाग ३: बफर में कुंजी डालना एवं निकालना (Enqueue & Dequeue)
// ------------------------------------------------------------------------------

कार्य कुंजी_डालो(संख्या स्कैन_कोड) {
    संख्या आधार = कुंजीपटल_आधार_पता();

    // शिफ्ट कुंजी का पता लगाना: 0x2A (Left Shift down), 0x36 (Right Shift down)
    यदि (स्कैन_कोड == 42 || स्कैन_कोड == 54) {
        अंतर्_लिख8(आधार, 32, 1);
        परत् 0;
    }
    // शिफ्ट कुंजी छोड़ना: 0xAA (0x2A + 0x80), 0xB6 (0x36 + 0x80)
    यदि (स्कैन_कोड == 170 || स्कैन_कोड == 182) {
        अंतर्_लिख8(आधार, 32, 0);
        परत् 0;
    }

    // यदि कुंजी छोड़ने (Release: code >= 128) का संकेत है तो उपेक्षा करो
    यदि (स्कैन_कोड >= 128) {
        परत् 0;
    }

    संख्या शिफ्ट = अंतर्_पढ़8(आधार, 32);
    संख्या वर्ण = स्कैन_कोड_से_वर्ण(स्कैन_कोड, शिफ्ट);
    यदि (वर्ण == 0) {
        परत् 0;
    }

    संख्या शीर्ष = अंतर्_पढ़8(आधार, 8);
    संख्या पुच्छ = अंतर्_पढ़8(आधार, 16);
    संख्या क्षमता = अंतर्_पढ़8(आधार, 24);

    संख्या अगला_शीर्ष = (शीर्ष + 1) % क्षमता;
    यदि (अगला_शीर्ष != पुच्छ) { // यदि बफर भरा नहीं है
        अंतर्_लिख1(आधार, 64 + शीर्ष, वर्ण);
        अंतर्_लिख8(आधार, 8, अगला_शीर्ष);

        संख्या कुल = अंतर्_पढ़8(आधार, 40);
        अंतर्_लिख8(आधार, 40, कुल + 1);
        अंतर्_लिख8(आधार, 48, वर्ण);
        परत् 1;
    }
    परत् 0; // बफर पूर्ण
}

कार्य कुंजी_निकालो() {
    संख्या आधार = कुंजीपटल_आधार_पता();
    संख्या शीर्ष = अंतर्_पढ़8(आधार, 8);
    संख्या पुच्छ = अंतर्_पढ़8(आधार, 16);
    संख्या क्षमता = अंतर्_पढ़8(आधार, 24);

    यदि (शीर्ष == पुच्छ) {
        परत् 0; // बफर रिक्त है
    }

    संख्या वर्ण = अंतर्_पढ़1(आधार, 64 + पुच्छ);
    संख्या अगला_पुच्छ = (पुच्छ + 1) % क्षमता;
    अंतर्_लिख8(आधार, 16, अगला_पुच्छ);
    परत् वर्ण;
}

कार्य कुंजी_उपलब्ध_है() {
    संख्या आधार = कुंजीपटल_आधार_पता();
    संख्या शीर्ष = अंतर्_पढ़8(आधार, 8);
    संख्या पुच्छ = अंतर्_पढ़8(आधार, 16);
    यदि (शीर्ष != पुच्छ) {
        परत् 1;
    }
    परत् 0;
}
