// मूल_उत्सर्जक.सूत्र — मध्यम IR → x86-64 GAS assembly  [Phase 1e]
// ============================================================
// इनपुट: IR एकक जो lower + अनुकूलक + रजि_नियतक से गुज़र चुका।
// आउटपुट: .s पाठ (मूल_सर्जक जैसा — उसी runtime से link होता है)।
//
// रजिस्टर उपयोग:
//   rax   — परिणाम / भाग / परत्-मान
//   rcx rdx r8 r9 — कॉल तर्क (Windows x64)
//   r10 r11 — उत्सर्जक scratch (binary ops, parallel-move)
//   rbx rsi rdi r12-r15 — रजि_नियतक का pool (callee-saved)
//
// अभी संकलक में wire नहीं — मूल_उत्सर्जक_परीक्षण.सूत्र से जाँचा।
// स्थगित: floats, अनुक्रम/क्षेत्र पढ़/लिख, नव_*, विधि_बुलाओ, परिवर्तन,
//         प्रकार_है, फेंको, precise GC roots (1f)।
// ============================================================

आयात "मध्यम.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "रजि_नियतक.सूत्र";


// ---- पाठ-निर्माता (chunk सूची; O(n²) concat नहीं) ----
कार्य उब_नया() { शब्दकोश ब = {}; ब["ट"] = []; परत् ब; }
कार्य उगल(शब्दकोश ब, पाठ स) { ब["ट"] = जोड़ें(ब["ट"], स); परत् 0; }
कार्य उगपं(शब्दकोश ब, पाठ स) {
    ब["ट"] = जोड़ें(ब["ट"], स);
    ब["ट"] = जोड़ें(ब["ट"], अक्षर_निर्माण(10));
    परत् 0;
}
कार्य उब_पाठ(शब्दकोश ब) { परत् संयोजित(ब["ट"], ""); }


// ---- GAS string escape (मूल_सर्जक से) ----
कार्य उत्_एस्केप(पाठ मूल) {
    मान परिणाम = "";
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(मूल)) {
        मान वर्ण = मूल[सूचक];
        संख्या कोड = अक्षर_मान(वर्ण);
        यदि (कोड == 92) { परिणाम = परिणाम + अक्षर_निर्माण(92) + अक्षर_निर्माण(92); }
        अन्यथा यदि (कोड == 34) { परिणाम = परिणाम + अक्षर_निर्माण(92) + अक्षर_निर्माण(34); }
        अन्यथा यदि (कोड == 10) { परिणाम = परिणाम + अक्षर_निर्माण(92) + अक्षर_निर्माण(110); }
        अन्यथा यदि (कोड >= 32 && कोड < 127) { परिणाम = परिणाम + वर्ण; }
        अन्यथा {
            सूची बाइट्स = [];
            यदि (कोड <= 127) { बाइट्स = जोड़ें(बाइट्स, कोड); }
            अन्यथा यदि (कोड <= 2047) {
                बाइट्स = जोड़ें(बाइट्स, 192 + (कोड / 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            } अन्यथा यदि (कोड <= 65535) {
                बाइट्स = जोड़ें(बाइट्स, 224 + (कोड / 4096));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 64) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            } अन्यथा {
                बाइट्स = जोड़ें(बाइट्स, 240 + (कोड / 262144));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 4096) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 64) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            }
            संख्या ब_सूचक = 0;
            यावत् (ब_सूचक < लंबाई(बाइट्स)) {
                संख्या ब = बाइट्स[ब_सूचक];
                परिणाम = परिणाम + अक्षर_निर्माण(92) + (ब / 64) + ((ब % 64) / 8) + (ब % 8);
                ब_सूचक = ब_सूचक + 1;
            }
        }
        सूचक = सूचक + 1;
    }
    परत् परिणाम;
}

कार्य उत्_बाइट_लंबाई(पाठ प) {
    मान कुल = 0;
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(प)) {
        संख्या कोड = अक्षर_मान(प[सूचक]);
        यदि (कोड <= 127) { कुल = कुल + 1; }
        अन्यथा यदि (कोड <= 2047) { कुल = कुल + 2; }
        अन्यथा यदि (कोड <= 65535) { कुल = कुल + 3; }
        अन्यथा { कुल = कुल + 4; }
        सूचक = सूचक + 1;
    }
    परत् कुल;
}


// ============================================================
// फ्रेम-लेआउट + मान-स्थान
// ============================================================
// callee-saved reg i  →  -8*(i+1)(%rbp)  में सुरक्षित
// spill slot 'ऑफसेट'  →  -(8*N_saved + 16 + ऑफसेट)(%rbp)
// FRAME = align16(8*N_saved + 16 + ढेर_आकार)

कार्य उत्_फ्रेम_आकार(शब्दकोश फलन) {
    संख्या न_सुर = लंबाई(फलन["प्रयुक्त_सुरक्षित"]);
    संख्या कच्चा = 8 * न_सुर + 16 + फलन["ढेर_आकार"];
    परत् ((कच्चा + 15) / 16) * 16;
}

कार्य उत्_सुरक्षित_स्थान(संख्या क्रमांक) {
    परत् (0 - (8 * (क्रमांक + 1))) + "(%rbp)";
}

// मान-id → operand पाठ ("%r12" या "-40(%rbp)")
कार्य उत्_स्थान(शब्दकोश फलन, संख्या आईडी) {
    शब्दकोश नि = फलन["रजि_नियतन"];
    मान अ = नि[आईडी];
    यदि (अ == शून्यम्) { परत् "%r15"; }   // fallback (नहीं होना चाहिए)
    यदि (अ["प्रकार"] == "रजि") { परत् "%" + अ["नाम"]; }
    संख्या न_सुर = लंबाई(फलन["प्रयुक्त_सुरक्षित"]);
    संख्या ऑफ = 8 * न_सुर + 16 + अ["ऑफसेट"];
    परत् (0 - ऑफ) + "(%rbp)";
}

// क्या यह स्थान memory है?
कार्य उत्_मेम_है(पाठ स्थान) {
    परत् खोजें(स्थान, "(%rbp)") >= 0;
}

// पूर्णांक-साहित्य को स्थान में भरो। `movq $imm, mem` का immediate केवल
// signed-32-बिट है → बड़ा मान (±2³¹ के बाहर) + memory-गंतव्य पर movabsq से
// register में लाकर फिर store। register-गंतव्य पर as खुद movabs चुन लेता।
कार्य उत्_सम32(संख्या म) {
    परत् म <= 2147483647 && म >= (0 - 2147483647);
}
कार्य उत्_पूर्ण_भरो(शब्दकोश बफ, संख्या म, पाठ दस्थ) {
    यदि (उत्_सम32(म) || न उत्_मेम_है(दस्थ)) {
        उगपं(बफ, "  movq $" + म + ", " + दस्थ);
    } अन्यथा {
        उगपं(बफ, "  movabsq $" + म + ", %r10");
        उगपं(बफ, "  movq %r10, " + दस्थ);
    }
    परत् 0;
}

// GC-जड़ स्लॉट (Phase 1f) — spill-क्षेत्र में एक समर्पित 8-बाइट स्लॉट
कार्य उत्_जड़_स्थान(शब्दकोश फलन, संख्या ऑफ) {
    संख्या न_सुर = लंबाई(फलन["प्रयुक्त_सुरक्षित"]);
    परत् (0 - (8 * न_सुर + 16 + ऑफ)) + "(%rbp)";
}

// जो जड़ मान इस स्थान पर मरते हैं — उनके स्लॉट 0 कर दो (मृत मान वस्तु को
// जीवित न रखे — interpreter जैसा precise व्यवहार)
कार्य उत्_जड़_मृत्यु(शब्दकोश बफ, शब्दकोश फलन, संख्या पद) {
    मान मप = फलन["जीसी_मृत्यु_पद"];
    यदि (मप == शून्यम्) { परत् 0; }
    मान सू = मप[पद];
    यदि (सू == शून्यम्) { परत् 0; }
    संख्या इक = 0;
    यावत् (इक < लंबाई(सू)) {
        उगपं(बफ, "  movq $0, " + उत्_जड़_स्थान(फलन, सू[इक]));
        इक = इक + 1;
    }
    परत् 0;
}

// एक मान (def के तुरंत बाद) उसके GC-जड़ स्लॉट में store करो — यदि वह जड़ है
कार्य उत्_जड़_संचय(शब्दकोश बफ, शब्दकोश फलन, संख्या आईडी) {
    मान नक = फलन["जीसी_जड़_नक्शा"];
    यदि (नक == शून्यम्) { परत् 0; }
    मान ऑफ = नक[आईडी];
    यदि (ऑफ == शून्यम्) { परत् 0; }
    पाठ स्रोत = उत्_स्थान(फलन, आईडी);
    पाठ जड़ = उत्_जड़_स्थान(फलन, ऑफ);
    यदि (उत्_मेम_है(स्रोत)) {
        उगपं(बफ, "  movq " + स्रोत + ", %r11");
        उगपं(बफ, "  movq %r11, " + जड़);
    } अन्यथा {
        उगपं(बफ, "  movq " + स्रोत + ", " + जड़);
    }
    परत् 0;
}


// ============================================================
// खंड-लेबल
// ============================================================
कार्य उत्_लेबल(पाठ कार्य_नाम, पाठ खंड_लेबल) {
    परत् ".L_" + कार्य_नाम + "__" + खंड_लेबल;
}
कार्य उत्_एपिलॉग(पाठ कार्य_नाम) {
    परत् ".L_epilogue_" + कार्य_नाम;
}


// ============================================================
// एक निर्देश का उत्सर्जन
// ============================================================
कार्य उत्_निर्देश(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश एकक, शब्दकोश निर्देश) {
    पाठ कोड = निर्देश["कोड"];
    संख्या दस = निर्देश["आईडी"];

    यदि (कोड == "स्थिर") {
        उत्_स्थिर(बफ, फलन, एकक, निर्देश);
        परत् 0;
    }
    यदि (कोड == "योग" || कोड == "अंतर" || कोड == "गुणा") {
        पाठ विधि = "पूर्ण";
        यदि (निर्देश["अंश"]["विधि"] != शून्यम्) { विधि = निर्देश["अंश"]["विधि"]; }
        यदि (कोड == "योग" && विधि == "पाठ") {
            उत्_रॉ_कॉल(बफ, "पाठ_जोड़",
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        यदि (कोड == "योग" && विधि == "मान") {
            उत्_रॉ_कॉल(बफ, "पाठ_योग_गतिक",
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        यदि (कोड == "योग" && (विधि == "दश_दायाँ" || विधि == "दश_बायाँ")) {
            // प्रकार_प्रसार-चिह्नित: पाठ + दशमलव-bits — helper दशमलव_से_पाठ कर जोड़ता
            पाठ हसिम = "पाठ_दश_दायाँ";
            यदि (विधि == "दश_बायाँ") { हसिम = "पाठ_दश_बायाँ"; }
            उत्_रॉ_कॉल(बफ, हसिम,
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        यदि (विधि == "दशमलव") {
            पाठ फसिम = "sutra_float_add";
            यदि (कोड == "अंतर") { फसिम = "sutra_float_sub"; }
            यदि (कोड == "गुणा") { फसिम = "sutra_float_mul"; }
            उत्_रॉ_कॉल(बफ, फसिम,
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        पाठ यंत्र = "addq";
        यदि (कोड == "अंतर") { यंत्र = "subq"; }
        यदि (कोड == "गुणा") { यंत्र = "imulq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  " + यंत्र + " " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि ((कोड == "भाग" || कोड == "शेष") && निर्देश["अंश"]["विधि"] == "दशमलव") {
        उत्_रॉ_कॉल(बफ, "sutra_float_div",
            [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "भाग" || कोड == "शेष") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %rax");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  cqto");
        उगपं(बफ, "  idivq %r10");
        यदि (कोड == "भाग") { उगपं(बफ, "  movq %rax, " + उत्_स्थान(फलन, दस)); }
        अन्यथा { उगपं(बफ, "  movq %rdx, " + उत्_स्थान(फलन, दस)); }
        परत् 0;
    }
    यदि (उत्_तुलना_है(कोड)) {
        पाठ तविधि = "पूर्ण";
        यदि (निर्देश["अंश"]["विधि"] != शून्यम्) { तविधि = निर्देश["अंश"]["विधि"]; }
        // दशमलव तुलना → sutra_float_*
        यदि (तविधि == "दशमलव") {
            उत्_रॉ_कॉल(बफ, उत्_फ्लोट_तुलना_सिम(कोड),
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        // dynamic == / != → पाठ_तुल्य (int pointer-eq भी सही, string भी)
        यदि (तविधि == "मान" && (कोड == "सम" || कोड == "असम")) { तविधि = "पाठ"; }
        // dynamic < > <= >= → सामान्य_* (पाठ हो तो कोडबिंदु-वार, वरना पूर्णांक)
        यदि (तविधि == "मान") {
            उत्_रॉ_कॉल(बफ, उत्_सामान्य_तुलना_सिम(कोड),
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        यदि (तविधि == "पाठ") {
            उत्_रॉ_कॉल(बफ, उत्_पाठ_तुलना_सिम(कोड),
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            यदि (कोड == "असम") {
                उगपं(बफ, "  movq " + उत्_स्थान(फलन, दस) + ", %r10");
                उगपं(बफ, "  cmpq $0, %r10");
                उगपं(बफ, "  sete %al");
                उगपं(बफ, "  movzbq %al, %r10");
                उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
            }
            परत् 0;
        }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  cmpq " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  " + उत्_सेट_यंत्र(कोड) + " %al");
        उगपं(बफ, "  movzbq %al, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "और" || कोड == "या") {
        पाठ यंत्र = "andq";
        यदि (कोड == "या") { यंत्र = "orq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  " + यंत्र + " " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  cmpq $0, %r10");
        उगपं(बफ, "  setne %al");
        उगपं(बफ, "  movzbq %al, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "नकार") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  cmpq $0, %r10");
        उगपं(बफ, "  sete %al");
        उगपं(बफ, "  movzbq %al, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "ऋणात्मक") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        यदि (निर्देश["प्रकार"] == "दशमलव") {
            उगपं(बफ, "  btcq $63, %r10");   // f64 चिह्न-बिट पलटो (negq पूर्णांक होगा)
        } अन्यथा {
            उगपं(बफ, "  negq %r10");
        }
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "पढ़_वैश्विक") {
        उगपं(बफ, "  movq sutra_glob_" + निर्देश["अंश"]["नाम"] + "(%rip), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "लिख_वैश्विक") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  movq %r10, sutra_glob_" + निर्देश["अंश"]["नाम"] + "(%rip)");
        परत् 0;
    }
    यदि (कोड == "बुलाओ") {
        उत्_कॉल(बफ, फलन, निर्देश["अंश"]["लक्ष्य"], निर्देश["संचालक"], दस);
        परत् 0;
    }
    यदि (कोड == "फलन_सूचक") {
        // किसी फलन (user-फलन या विदेशी दोनों) का पता — थ्रेड-प्रारंभ/callback FFI हेतु
        उगपं(बफ, "  leaq " + निर्देश["अंश"]["नाम"] + "(%rip), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "अंतर्") {
        उत्_अंतर्(बफ, फलन, निर्देश);
        परत् 0;
    }
    यदि (कोड == "लंबाई") {
        उत्_रॉ_कॉल(बफ, "दैशिक_लंबाई", [उत्_स्थान(फलन, निर्देश["संचालक"][0])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "पढ़_अनुक्रम") {
        पाठ आप = "मान";
        यदि (निर्देश["अंश"]["आधार_प्रकार"] != शून्यम्) { आप = निर्देश["अंश"]["आधार_प्रकार"]; }
        पाठ सिम = "सूची_सूचकांक";
        यदि (आप == "पाठ") { सिम = "पाठ_सूचकांक"; }
        उत्_रॉ_कॉल(बफ, सिम, [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "लिख_अनुक्रम") {
        उत्_रॉ_कॉल(बफ, "सूची_सूचकांक_सेट",
            [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1]), उत्_स्थान(फलन, निर्देश["संचालक"][2])], "");
        परत् 0;
    }
    यदि (कोड == "नव_सूची") {
        सूची तत्व = निर्देश["संचालक"];
        उत्_रॉ_कॉल(बफ, "सूची_रचना", ["$" + लंबाई(तत्व)], उत्_स्थान(फलन, दस));
        उत्_जड़_संचय(बफ, फलन, दस);   // fill से पहले रूट करो (fill GC trigger कर सकता)
        संख्या इक = 0;
        यावत् (इक < लंबाई(तत्व)) {
            उत्_रॉ_कॉल(बफ, "सूची_सूचकांक_सेट", [उत्_स्थान(फलन, दस), "$" + इक, उत्_स्थान(फलन, तत्व[इक])], "");
            इक = इक + 1;
        }
        परत् 0;
    }
    यदि (कोड == "नव_शब्दकोश") {
        सूची जोड़े = निर्देश["संचालक"];
        उत्_रॉ_कॉल(बफ, "शब्दकोश_रचना", [], उत्_स्थान(फलन, दस));
        उत्_जड़_संचय(बफ, फलन, दस);   // fill (dict grow) से पहले रूट करो
        संख्या इक = 0;
        यावत् (इक + 1 < लंबाई(जोड़े)) {
            उत्_रॉ_कॉल(बफ, "शब्दकोश_सेट",
                [उत्_स्थान(फलन, दस), उत्_स्थान(फलन, जोड़े[इक]), उत्_स्थान(फलन, जोड़े[इक + 1])], "");
            इक = इक + 2;
        }
        परत् 0;
    }
    यदि (कोड == "पढ़_क्षेत्र") {
        संख्या सूच = 0;
        यदि (निर्देश["अंश"]["सूचकांक"] != शून्यम्) { सूच = निर्देश["अंश"]["सूचकांक"]; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  movq " + (16 + सूच * 8) + "(%r10), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "लिख_क्षेत्र") {
        संख्या सूच = 0;
        यदि (निर्देश["अंश"]["सूचकांक"] != शून्यम्) { सूच = निर्देश["अंश"]["सूचकांक"]; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r11");
        उगपं(बफ, "  movq %r11, " + (16 + सूच * 8) + "(%r10)");
        परत् 0;
    }
    यदि (कोड == "नव_वस्तु") {
        संख्या क्षेत्र_गण = 0;
        यदि (निर्देश["अंश"]["क्षेत्र_गण"] != शून्यम्) { क्षेत्र_गण = निर्देश["अंश"]["क्षेत्र_गण"]; }
        पाठ दस्थ = उत्_स्थान(फलन, दस);
        उत्_रॉ_कॉल(बफ, "वस्तु_रचना", ["$" + क्षेत्र_गण], दस्थ);
        उत्_जड़_संचय(बफ, फलन, दस);   // रचना कॉल से पहले रूट करो (constructor allocate कर सकता)
        // रचना कॉल: (obj, तर्क...) — परिणाम obj ही रहता है
        सूची कतर्क = [दस्थ];
        संख्या इक = 0;
        यावत् (इक < लंबाई(निर्देश["संचालक"])) {
            कतर्क = जोड़ें(कतर्क, उत्_स्थान(फलन, निर्देश["संचालक"][इक]));
            इक = इक + 1;
        }
        उत्_रॉ_कॉल(बफ, निर्देश["अंश"]["रचना"], कतर्क, "");
        परत् 0;
    }
    यदि (कोड == "प्रकार_है") {
        पाठ ज = निर्देश["अंश"]["जाँच"];
        पाठ सिम = "रन_क्या_पाठ";
        यदि (ज == "शब्दकोश") { सिम = "रन_क्या_शब्दकोश"; }
        यदि (ज == "सूची") { सिम = "रन_क्या_सूची"; }
        उत्_रॉ_कॉल(बफ, सिम, [उत्_स्थान(फलन, निर्देश["संचालक"][0])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "अमृत" || कोड == "स्लॉट") { परत् 0; }

    // अभी-भी-स्थगित opcodes — टिप्पणी छोड़ो
    उगपं(बफ, "  # स्थगित: " + कोड);
    परत् 0;
}

// निम्न-स्तर कॉल — तर्क पहले से operand-पाठ (value-id नहीं)
कार्य उत्_रॉ_कॉल(शब्दकोश बफ, पाठ प्रतीक, सूची तर्क_स्थान, पाठ दस्थ) {
    सूची अरजि = ["%rcx", "%rdx", "%r8", "%r9"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(तर्क_स्थान) && इक < 4) {
        उगपं(बफ, "  movq " + तर्क_स्थान[इक] + ", " + अरजि[इक]);
        इक = इक + 1;
    }
    उगपं(बफ, "  subq $32, %rsp");
    उगपं(बफ, "  call " + प्रतीक);
    उगपं(बफ, "  addq $32, %rsp");
    यदि (दस्थ != "") { उगपं(बफ, "  movq %rax, " + दस्थ); }
    परत् 0;
}

कार्य उत्_तुलना_है(पाठ कोड) {
    परत् कोड == "सम" || कोड == "असम" || कोड == "लघु" || कोड == "गुरु"
        || कोड == "लघुसम" || कोड == "गुरुसम";
}
कार्य उत्_फ्लोट_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "सम") { परत् "sutra_float_eq"; }
    यदि (कोड == "असम") { परत् "sutra_float_ne"; }
    यदि (कोड == "लघु") { परत् "sutra_float_lt"; }
    यदि (कोड == "गुरु") { परत् "sutra_float_gt"; }
    यदि (कोड == "लघुसम") { परत् "sutra_float_le"; }
    परत् "sutra_float_ge";
}

// dynamic (मान) < > <= >= → सामान्य_* runtime symbol
कार्य उत्_सामान्य_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "लघु") { परत् "सामान्य_न्यून"; }
    यदि (कोड == "गुरु") { परत् "सामान्य_अधिक"; }
    यदि (कोड == "लघुसम") { परत् "सामान्य_न्यून_सम"; }
    परत् "सामान्य_अधिक_सम";
}

// पाठ-तुलना → runtime symbol (सम/असम दोनों पाठ_तुल्य से; असम बाद में उलटा)
कार्य उत्_पाठ_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "सम" || कोड == "असम") { परत् "पाठ_तुल्य"; }
    यदि (कोड == "लघु") { परत् "पाठ_न्यून"; }
    यदि (कोड == "गुरु") { परत् "पाठ_अधिक"; }
    यदि (कोड == "लघुसम") { परत् "पाठ_न्यून_सम"; }
    परत् "पाठ_अधिक_सम";
}

कार्य उत्_सेट_यंत्र(पाठ कोड) {
    यदि (कोड == "सम") { परत् "sete"; }
    यदि (कोड == "असम") { परत् "setne"; }
    यदि (कोड == "लघु") { परत् "setl"; }
    यदि (कोड == "गुरु") { परत् "setg"; }
    यदि (कोड == "लघुसम") { परत् "setle"; }
    परत् "setge";
}

कार्य उत्_स्थिर(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश एकक, शब्दकोश निर्देश) {
    पाठ मप = निर्देश["अंश"]["मान_प्रकार"];
    पाठ दस्थ = उत्_स्थान(फलन, निर्देश["आईडी"]);
    यदि (मप == "पूर्ण") {
        उत्_पूर्ण_भरो(बफ, निर्देश["अंश"]["मान"], दस्थ);
        परत् 0;
    }
    यदि (मप == "दशमलव") {
        संख्या अनु = मध्यम_दशमलव_स्थिरांक(एकक, निर्देश["अंश"]["मान"]);
        उगपं(बफ, "  movq .LC_dbl_" + अनु + "(%rip), %r10");
        उगपं(बफ, "  movq %r10, " + दस्थ);
        परत् 0;
    }
    यदि (मप == "बूल") {
        मान म = निर्देश["अंश"]["मान"];
        यदि (म == सत्य || म == 1) { उगपं(बफ, "  movq $1, " + दस्थ); }
        अन्यथा { उगपं(बफ, "  movq $0, " + दस्थ); }
        परत् 0;
    }
    यदि (मप == "शून्यम्") {
        उगपं(बफ, "  movq $0, " + दस्थ);
        परत् 0;
    }
    यदि (मप == "पाठ") {
        संख्या अनु = निर्देश["अंश"]["मान"];   // पाठ_स्थिरांक तालिका अनुक्रमांक
        // §4c: main-program में पाठ-साहित्य startup पर एक बार बनते हैं
        // (सूत्र_पाठ_तालिका_आरंभ), फिर यहाँ सिर्फ़ table-load — 1 निर्देश
        // बनाम 7 + alloc। साहित्य immutable + स्थायी GC-जड़ → साझा सुरक्षित।
        यदि (एकक["_पाठ_तालिका"] == सत्य) {
            उगपं(बफ, "  movq .LC_strtab+" + (8 * अनु) + "(%rip), %r10");
            उगपं(बफ, "  movq %r10, " + दस्थ);
            परत् 0;
        }
        उगपं(बफ, "  leaq .LC_str_" + अनु + "(%rip), %rcx");
        उगपं(बफ, "  movq .LC_str_" + अनु + "_len(%rip), %rdx");
        उगपं(बफ, "  subq $32, %rsp");
        उगपं(बफ, "  call पाठ_रचना");
        उगपं(बफ, "  addq $32, %rsp");
        उगपं(बफ, "  movq %rax, " + दस्थ);
        परत् 0;
    }
    उगपं(बफ, "  movq $0, " + दस्थ);
    परत् 0;
}

कार्य उत्_कॉल(शब्दकोश बफ, शब्दकोश फलन, पाठ लक्ष्य, सूची तर्क, संख्या दस) {
    यदि (लक्ष्य == "मुख्य") { लक्ष्य = "sutra_main"; }   // परिभाषा-नाम से मेल (उत्_कार्य)
    सूची अरजि = ["%rcx", "%rdx", "%r8", "%r9"];
    संख्या ढेर_तर्क = 0;
    यदि (लंबाई(तर्क) > 4) { ढेर_तर्क = लंबाई(तर्क) - 4; }

    // ढेर-तर्क push करने से rsp %16 बदल जाता (शरीर में rsp≡0)। विषम push
    // पर 8-बाइट pad चाहिए — यह pad पुश से *पहले* आता है, ताकि args callee
    // को standard offset (16 + i*8(%rbp)) पर दिखें (pad को shadow+args के
    // बीच रखने से offset 8 खिसक जाता — असली bug था)।
    संख्या पैड = 0;
    यदि ((ढेर_तर्क % 2) == 1) { पैड = 8; }
    यदि (पैड > 0) { उगपं(बफ, "  subq $8, %rsp"); }

    // 5वें+ तर्क — उल्टे क्रम में push (v1 में दुर्लभ)
    संख्या जक = लंबाई(तर्क) - 1;
    यावत् (जक >= 4) {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, तर्क[जक]) + ", %r11");
        उगपं(बफ, "  pushq %r11");
        जक = जक - 1;
    }
    // तर्क 0..3 → rcx/rdx/r8/r9 । स्रोत pool-रजि/spill हैं, ABI रजि कभी नहीं
    // → कोई चक्र नहीं, सीधी mov।
    संख्या इक = 0;
    यावत् (इक < लंबाई(तर्क) && इक < 4) {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, तर्क[इक]) + ", " + अरजि[इक]);
        इक = इक + 1;
    }
    उगपं(बफ, "  subq $32, %rsp");                          // सिर्फ़ shadow
    उगपं(बफ, "  call " + लक्ष्य);
    उगपं(बफ, "  addq $" + (32 + 8 * ढेर_तर्क + पैड) + ", %rsp");   // shadow+पुश+pad
    यदि (दस >= 1) {
        उगपं(बफ, "  movq %rax, " + उत्_स्थान(फलन, दस));
    }
    परत् 0;
}

कार्य उत्_अंतर्(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश निर्देश) {
    पाठ नाम = निर्देश["अंश"]["नाम"];
    सूची स = निर्देश["संचालक"];
    संख्या दस = निर्देश["आईडी"];
    यदि (नाम == "अंतर्_पढ़8" || नाम == "अंतर्_पढ़1") {
        पाठ यंत्र = "movq";
        यदि (नाम == "अंतर्_पढ़1") { यंत्र = "movzbq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[1]) + ", %r11");
        उगपं(बफ, "  " + यंत्र + " (%r10,%r11), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (नाम == "अंतर्_लिख8" || नाम == "अंतर्_लिख1") {
        पाठ रस = "%r8";
        पाठ यंत्र = "movq";
        यदि (नाम == "अंतर्_लिख1") { यंत्र = "movb"; रस = "%r8b"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[1]) + ", %r11");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[2]) + ", %r8");
        उगपं(बफ, "  " + यंत्र + " " + रस + ", (%r10,%r11)");
        यदि (दस >= 1) { उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[2]) + ", " + उत्_स्थान(फलन, दस)); }
        परत् 0;
    }
    यदि (नाम == "अंतर्_मुद्रण") {
        // (आधार, ऑफसेट, लंबाई) → सूत्र_तल_मुद्रण(आधार+ऑफसेट, लंबाई)  [WriteFile]
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %rcx");
        उगपं(बफ, "  addq " + उत्_स्थान(फलन, स[1]) + ", %rcx");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[2]) + ", %rdx");
        उगपं(बफ, "  subq $32, %rsp");
        उगपं(बफ, "  call सूत्र_तल_मुद्रण");
        उगपं(बफ, "  addq $32, %rsp");
        परत् 0;
    }
    // बिटवार — inline (r10 scratch; shift-गणना cl में, rcx pool में नहीं)
    यदि (नाम == "अंतर्_बिट_और" || नाम == "अंतर्_बिट_या" || नाम == "अंतर्_बिट_भेद") {
        पाठ यं = "andq";
        यदि (नाम == "अंतर्_बिट_या") { यं = "orq"; }
        यदि (नाम == "अंतर्_बिट_भेद") { यं = "xorq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[1]) + ", %r11");
        उगपं(बफ, "  " + यं + " %r11, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (नाम == "अंतर्_बिट_उलट") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  notq %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (नाम == "अंतर्_बाम_सरक" || नाम == "अंतर्_दक्षिण_सरक") {
        पाठ यं2 = "shlq";
        यदि (नाम == "अंतर्_दक्षिण_सरक") { यं2 = "shrq"; }   // तार्किक (unsigned)
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[1]) + ", %rcx");
        उगपं(बफ, "  " + यं2 + " %cl, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    // अन्य अंतर्_* → C helper कॉल (नाम ही symbol)
    उत्_कॉल(बफ, फलन, उत्_अंतर्_प्रतीक(नाम), स, दस);
    परत् 0;
}

कार्य उत्_अंतर्_प्रतीक(पाठ नाम) {
    यदि (नाम == "अंतर्_क्षेत्र_आवंटन") { परत् "सूत्र_तल_आवंटन"; }
    यदि (नाम == "अंतर्_क्षेत्र_मुक्त") { परत् "सूत्र_तल_मुक्त"; }
    यदि (नाम == "अंतर्_निकास") { परत् "सूत्र_तल_निकास"; }
    यदि (नाम == "अंतर्_क्या_पाठ") { परत् "रन_क्या_पाठ"; }
    यदि (नाम == "अंतर्_क्या_शब्दकोश") { परत् "रन_क्या_शब्दकोश"; }
    यदि (नाम == "अंतर्_जड़_संख्या") { परत् "sutra_gc_root_count"; }   // तल.s (asm)
    यदि (नाम == "अंतर्_जड़_मान") { परत् "sutra_gc_root_deref"; }      // तल.s (asm)
    यदि (नाम == "अंतर्_सक्रिय_अपवाद") { परत् "सक्रिय_अपवाद_लो"; }     // मूल_रनटाइम.सूत्र
    परत् नाम;
}


// operand-पाठ की सामग्री-समानता — compiler के == के string/pointer
// व्यवहार पर निर्भर नहीं (पुराना मूल_सर्जक codegen कभी pointer से तुलता,
// जिससे "%rbx" != "%rbx" सच हो जाता → phantom cycle-break)।
कार्य उत्_सम_पाठ(पाठ अ, पाठ ब) {
    यदि (लंबाई(अ) != लंबाई(ब)) { परत् असत्य; }
    यदि (लंबाई(अ) == 0) { परत् सत्य; }
    परत् खोजें(अ, ब) == 0;
}

// ============================================================
// समानांतर चाल (parallel move) — चक्र-सुरक्षित, कर्षक (scratch) से
// जोड़े = [[स्रोत, लक्ष्य], ...] ; स्रोत/लक्ष्य = operand पाठ
// ============================================================
कार्य उत्_चालें(शब्दकोश बफ, सूची जोड़े, पाठ कर्षक) {
    // पहचान-चालें हटाओ
    सूची शेष = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(जोड़े)) {
        यदि (न उत्_सम_पाठ(जोड़े[इक][0], जोड़े[इक][1])) { शेष = जोड़ें(शेष, जोड़े[इक]); }
        इक = इक + 1;
    }
    यावत् (लंबाई(शेष) > 0) {
        // ऐसा जोड़ा ढूँढो जिसका लक्ष्य किसी बचे स्रोत में नहीं
        संख्या मिला = 0 - 1;
        इक = 0;
        यावत् (इक < लंबाई(शेष)) {
            यदि (न उत्_स्रोत_में(शेष, शेष[इक][1])) { मिला = इक; }
            इक = इक + 1;
        }
        यदि (मिला >= 0) {
            उत्_एक_चाल(बफ, शेष[मिला][0], शेष[मिला][1], कर्षक);
            शेष = उत्_सूची_हटाओ(शेष, मिला);
        } अन्यथा {
            // चक्र — पहला जोड़ा तोड़ो
            पाठ पुराना_लक्ष्य = शेष[0][1];
            उगपं(बफ, "  movq " + पुराना_लक्ष्य + ", " + कर्षक);
            // हर जोड़ा जिसका स्रोत == पुराना_लक्ष्य → स्रोत = कर्षक
            सूची नया = [];
            इक = 0;
            यावत् (इक < लंबाई(शेष)) {
                यदि (उत्_सम_पाठ(शेष[इक][0], पुराना_लक्ष्य)) { नया = जोड़ें(नया, [कर्षक, शेष[इक][1]]); }
                अन्यथा { नया = जोड़ें(नया, शेष[इक]); }
                इक = इक + 1;
            }
            शेष = नया;
        }
    }
    परत् 0;
}
// mem→mem को कर्षक से route करो
कार्य उत्_एक_चाल(शब्दकोश बफ, पाठ स्रोत, पाठ लक्ष्य, पाठ कर्षक) {
    यदि (उत्_सम_पाठ(स्रोत, लक्ष्य)) { परत् 0; }
    यदि (उत्_मेम_है(स्रोत) && उत्_मेम_है(लक्ष्य)) {
        उगपं(बफ, "  movq " + स्रोत + ", " + कर्षक);
        उगपं(बफ, "  movq " + कर्षक + ", " + लक्ष्य);
    } अन्यथा {
        उगपं(बफ, "  movq " + स्रोत + ", " + लक्ष्य);
    }
    परत् 0;
}

कार्य उत्_स्रोत_में(सूची शेष, पाठ लक्ष्य) {
    संख्या इक = 0;
    यावत् (इक < लंबाई(शेष)) {
        यदि (उत्_सम_पाठ(शेष[इक][0], लक्ष्य)) { परत् सत्य; }
        इक = इक + 1;
    }
    परत् असत्य;
}
कार्य उत्_सूची_हटाओ(सूची स, संख्या सूचकांक) {
    सूची फल = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(स)) {
        यदि (इक != सूचकांक) { फल = जोड़ें(फल, स[इक]); }
        इक = इक + 1;
    }
    परत् फल;
}


// ============================================================
// फाई-चालें (edge पर)
// ============================================================
कार्य उत्_फाई_चालें(शब्दकोश बफ, शब्दकोश फलन, पाठ पूर्व_लेबल, शब्दकोश गंतव्य_खंड) {
    सूची फाई_सूची = गंतव्य_खंड["फाई"];
    सूची स्रोत = [];
    सूची लक्ष्य = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(फाई_सूची)) {
        शब्दकोश फ = फाई_सूची[इक];
        सूची पर_सूची = फ["अंश"]["स्रोत"];
        संख्या जक = 0;
        यावत् (जक < लंबाई(पर_सूची)) {
            यदि (पर_सूची[जक][0] == पूर्व_लेबल) {
                संख्या मव = पर_सूची[जक][1];
                यदि (मव >= 1) {
                    स्रोत = जोड़ें(स्रोत, उत्_स्थान(फलन, मव));
                    लक्ष्य = जोड़ें(लक्ष्य, उत्_स्थान(फलन, फ["आईडी"]));
                }
            }
            जक = जक + 1;
        }
        इक = इक + 1;
    }
    // चक्र-सुरक्षित parallel move
    सूची जोड़े = [];
    इक = 0;
    यावत् (इक < लंबाई(लक्ष्य)) {
        जोड़े = जोड़ें(जोड़े, [स्रोत[इक], लक्ष्य[इक]]);
        इक = इक + 1;
    }
    उत्_चालें(बफ, जोड़े, "%r11");
    परत् 0;
}


// ============================================================
// टर्मिनेटर
// ============================================================
कार्य उत्_टर्मिनेटर(शब्दकोश बफ, शब्दकोश फलन, पाठ कार्य_नाम, शब्दकोश खंड, शब्दकोश धारक) {
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम्) {
        उगपं(बफ, "  jmp " + उत्_एपिलॉग(कार्य_नाम));
        परत् 0;
    }
    पाठ कोड = अंत["कोड"];
    पाठ यह_लेबल = खंड["लेबल"];

    यदि (कोड == "वापस") {
        यदि (लंबाई(अंत["संचालक"]) > 0) {
            उगपं(बफ, "  movq " + उत्_स्थान(फलन, अंत["संचालक"][0]) + ", %rax");
        } अन्यथा {
            उगपं(बफ, "  movq $0, %rax");
        }
        उगपं(बफ, "  jmp " + उत्_एपिलॉग(कार्य_नाम));
        परत् 0;
    }
    यदि (कोड == "जाओ") {
        पाठ ग = अंत["अंश"]["लक्ष्य"];
        उत्_फाई_चालें(बफ, फलन, यह_लेबल, अनु_खंड_खोजें(फलन, ग));
        उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, ग));
        परत् 0;
    }
    यदि (कोड == "यदि_जाओ") {
        पाठ सत्य_ग = अंत["अंश"]["सत्य"];
        पाठ असत्य_ग = अंत["अंश"]["असत्य"];
        शब्दकोश असत्य_खंड = अनु_खंड_खोजें(फलन, असत्य_ग);

        उगपं(बफ, "  movq " + उत्_स्थान(फलन, अंत["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  cmpq $0, %r10");

        // असत्य-गंतव्य पर कोई फाई ही नहीं → उस किनारे पर कोई parallel-move
        // कभी नहीं बनेगा (उत्_फाई_चालें खाली रहेगा) — तो बीच का
        // .L_किनारा_N label+jmp हॉप छोड़ो, सीधे je असली लक्ष्य पर।
        यदि (असत्य_खंड == शून्यम् || लंबाई(असत्य_खंड["फाई"]) == 0) {
            उगपं(बफ, "  je " + उत्_लेबल(कार्य_नाम, असत्य_ग));
            उत्_फाई_चालें(बफ, फलन, यह_लेबल, अनु_खंड_खोजें(फलन, सत्य_ग));
            उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, सत्य_ग));
            परत् 0;
        }

        संख्या क्रम = धारक["किनारा"];
        धारक["किनारा"] = क्रम + 1;
        पाठ अ_किनारा = ".L_किनारा_" + कार्य_नाम + "_" + क्रम;
        उगपं(बफ, "  je " + अ_किनारा);
        // सत्य किनारा
        उत्_फाई_चालें(बफ, फलन, यह_लेबल, अनु_खंड_खोजें(फलन, सत्य_ग));
        उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, सत्य_ग));
        // असत्य किनारा
        उगपं(बफ, अ_किनारा + ":");
        उत्_फाई_चालें(बफ, फलन, यह_लेबल, असत्य_खंड);
        उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, असत्य_ग));
        परत् 0;
    }
    यदि (कोड == "फेंको") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, अंत["संचालक"][0]) + ", %rcx");
        उगपं(बफ, "  subq $32, %rsp");
        उगपं(बफ, "  call फेंको");
        उगपं(बफ, "  addq $32, %rsp");
        परत् 0;
    }
    उगपं(बफ, "  jmp " + उत्_एपिलॉग(कार्य_नाम));
    परत् 0;
}


// ============================================================
// एक कार्य
// ============================================================
कार्य उत्_कार्य(शब्दकोश बफ, शब्दकोश एकक, शब्दकोश फलन) {
    पाठ नाम = फलन["नाम"];
    यदि (नाम == "मुख्य") { नाम = "sutra_main"; }
    संख्या फ्रेम = उत्_फ्रेम_आकार(फलन);
    सूची सुर = फलन["प्रयुक्त_सुरक्षित"];

    उगपं(बफ, "  .text");
    उगपं(बफ, "  .globl " + नाम);
    उगपं(बफ, "  .def " + नाम + "; .scl 2; .type 32; .endef");
    उगपं(बफ, नाम + ":");
    उगपं(बफ, "  pushq %rbp");
    उगपं(बफ, "  movq %rsp, %rbp");
    उगपं(बफ, "  subq $" + फ्रेम + ", %rsp");
    // callee-saved सुरक्षित
    संख्या इक = 0;
    यावत् (इक < लंबाई(सुर)) {
        उगपं(बफ, "  movq %" + सुर[इक] + ", " + उत्_सुरक्षित_स्थान(इक));
        इक = इक + 1;
    }
    // पैरामीटर → नियत स्थान
    सूची अरजि = ["%rcx", "%rdx", "%r8", "%r9"];
    सूची पैरा = फलन["पैरामीटर"];
    इक = 0;
    यावत् (इक < लंबाई(पैरा)) {
        पाठ दस्थ = उत्_स्थान(फलन, पैरा[इक]["आईडी"]);
        यदि (इक < 4) {
            यदि (("%" + दस्थ) != अरजि[इक] && दस्थ != अरजि[इक]) {
                उगपं(बफ, "  movq " + अरजि[इक] + ", " + दस्थ);
            }
        } अन्यथा {
            उगपं(बफ, "  movq " + (16 + (इक) * 8) + "(%rbp), %r10");
            उगपं(बफ, "  movq %r10, " + दस्थ);
        }
        इक = इक + 1;
    }

    // GC जड़ें (Phase 1f): zero-init → gc_roots[] में inline पंजीकरण →
    // जड़ params को उनके स्लॉट में। सुरक्षा-बिंदु से पहले हर जड़ मान अपने
    // स्लॉट में रहता है ताकि संग्राहक उसे देख सके।
    मान जड़ें = फलन["जीसी_जड़ें"];
    संख्या ज_गण = 0;
    यदि (जड़ें != शून्यम्) { ज_गण = लंबाई(जड़ें); }
    यदि (ज_गण > 0) {
        शब्दकोश ज_नक्शा = फलन["जीसी_जड़_नक्शा"];
        संख्या ज = 0;
        यदि (ज_गण <= 4) {
            // थोड़ी जड़ें — सीधा (कोई शाखा नहीं)
            यावत् (ज < ज_गण) {
                उगपं(बफ, "  movq $0, " + उत्_जड़_स्थान(फलन, ज_नक्शा[जड़ें[ज]]));
                ज = ज + 1;
            }
            उगपं(बफ, "  movl gc_roots_count(%rip), %eax");
            उगपं(बफ, "  leaq gc_roots(%rip), %r10");
            ज = 0;
            यावत् (ज < ज_गण) {
                उगपं(बफ, "  leaq " + उत्_जड़_स्थान(फलन, ज_नक्शा[जड़ें[ज]]) + ", %r11");
                उगपं(बफ, "  movq %r11, (%r10,%rax,8)");
                उगपं(बफ, "  incl %eax");
                ज = ज + 1;
            }
            उगपं(बफ, "  movl %eax, gc_roots_count(%rip)");
        } अन्यथा {
            // जड़-स्लॉट सन्निहित हैं (रजि_जीसी_जड़ें क्रमशः ढेर, ढेर+8, …) —
            // उच्च ऑफ = नीचा पता। एक ही लूप में शून्य + पंजीकरण; N सीधे
            // movq/leaq त्रिक नहीं (icache + प्रति-कॉल लागत)।
            पाठ शीर्ष_स्लॉट = उत्_जड़_स्थान(फलन, ज_नक्शा[जड़ें[0]]);
            उगपं(बफ, "  movl gc_roots_count(%rip), %eax");
            उगपं(बफ, "  leaq gc_roots(%rip), %r10");
            उगपं(बफ, "  leaq " + शीर्ष_स्लॉट + ", %r11");
            उगपं(बफ, "  movl $" + ज_गण + ", %ecx");
            उगपं(बफ, ".Lजड़_" + नाम + ":");
            उगपं(बफ, "  movq $0, (%r11)");
            उगपं(बफ, "  movq %r11, (%r10,%rax,8)");
            उगपं(बफ, "  incl %eax");
            उगपं(बफ, "  subq $8, %r11");
            उगपं(बफ, "  decl %ecx");
            उगपं(बफ, "  jnz .Lजड़_" + नाम);
            उगपं(बफ, "  movl %eax, gc_roots_count(%rip)");
        }
        // जड़ params
        ज = 0;
        यावत् (ज < लंबाई(पैरा)) {
            उत्_जड़_संचय(बफ, फलन, पैरा[ज]["आईडी"]);
            ज = ज + 1;
        }
    }
    उगपं(बफ, "");

    // खंड (RPO क्रम में)
    सूची क्रम = अनु_विपक्रम(फलन);
    शब्दकोश धारक = {};
    धारक["किनारा"] = 0;
    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, क्रम[कक]);
        उगपं(बफ, उत्_लेबल(नाम, क्रम[कक]) + ":");
        // फाई-परिणाम (pred edge से आए) → GC-जड़ स्लॉट
        संख्या फप = 0;
        यावत् (फप < लंबाई(खंड["फाई"])) {
            उत्_जड़_संचय(बफ, फलन, खंड["फाई"][फप]["आईडी"]);
            फप = फप + 1;
        }
        संख्या नि = 0;
        यावत् (नि < लंबाई(खंड["निर्देश"])) {
            उत्_निर्देश(बफ, फलन, एकक, खंड["निर्देश"][नि]);
            यदि (खंड["निर्देश"][नि]["आईडी"] >= 1) {
                उत्_जड़_संचय(बफ, फलन, खंड["निर्देश"][नि]["आईडी"]);
            }
            उत्_जड़_मृत्यु(बफ, फलन, खंड["निर्देश"][नि]["_pos"]);
            नि = नि + 1;
        }
        उत्_टर्मिनेटर(बफ, फलन, नाम, खंड, धारक);
        कक = कक + 1;
    }

    // एपिलॉग
    उगपं(बफ, उत्_एपिलॉग(नाम) + ":");
    यदि (ज_गण > 0) {
        उगपं(बफ, "  subl $" + ज_गण + ", gc_roots_count(%rip)");
    }
    इक = 0;
    यावत् (इक < लंबाई(सुर)) {
        उगपं(बफ, "  movq " + उत्_सुरक्षित_स्थान(इक) + ", %" + सुर[इक]);
        इक = इक + 1;
    }
    उगपं(बफ, "  movq %rbp, %rsp");
    उगपं(बफ, "  popq %rbp");
    उगपं(बफ, "  ret");
    उगपं(बफ, "");
    परत् 0;
}


// ============================================================
// एकक → पूर्ण .s
// ============================================================
कार्य उत्सर्जक_एकक(शब्दकोश एकक) {
    शब्दकोश बफ = उब_नया();

    // §4c: main-program → पाठ-साहित्य साझा तालिका (उत्_स्थिर इसे देखता)
    यदि (एकक["मुख्य_है"] == सत्य || एकक["शीर्ष_है"] == सत्य) {
        एकक["_पाठ_तालिका"] = सत्य;
    }

    // हर कार्य पर regalloc (यदि पहले नहीं हुआ)
    सूची कस = एकक["कार्य_सूची"];

    // freestanding: sutra_main को .text में हमेशा सबसे पहले रखो — कोई
    // main:/entry wrapper नहीं होता (देखो ऊपर), इसलिए काढ़ी गई flat binary
    // का byte 0 ही असली entry point मानी जाती (कर्नेल/boot.asm सीधे
    // वहीं call करता)। स्रोत में मुख्य कहीं भी घोषित हो, क्रम यहीं तय होता।
    यदि (एकक["फ्रीस्टैंडिंग"] == सत्य) {
        सूची क्रमबद्ध = [];
        संख्या पइ = 0;
        यावत् (पइ < लंबाई(कस)) {
            यदि (कस[पइ]["नाम"] == "मुख्य") { क्रमबद्ध = जोड़ें(क्रमबद्ध, कस[पइ]); }
            पइ = पइ + 1;
        }
        पइ = 0;
        यावत् (पइ < लंबाई(कस)) {
            यदि (कस[पइ]["नाम"] != "मुख्य") { क्रमबद्ध = जोड़ें(क्रमबद्ध, कस[पइ]); }
            पइ = पइ + 1;
        }
        कस = क्रमबद्ध;
    }

    संख्या इक = 0;
    यावत् (इक < लंबाई(कस)) {
        यदि (कस[इक]["रजि_नियतन"] == शून्यम्) {
            कस[इक]["_स्थिर_पाठ_स्थायी"] = एकक["_पाठ_तालिका"];
            रजि_नियतक_कार्य(कस[इक]);
        }
        उत्_कार्य(बफ, एकक, कस[इक]);
        इक = इक + 1;
    }

    // §4c: पाठ-साहित्य तालिका init routine (main-program में ही)
    यदि (एकक["_पाठ_तालिका"] == सत्य) {
        उत्_पाठ_तालिका_आरंभ(बफ, एकक);
    }

    // main प्रविष्टि — केवल जब एकक में मुख्य या शीर्ष-स्तरीय कोड हो।
    // पुस्तकालय-मॉड्यूल (मूल_रनटाइम / मूल_आवंटक — सिर्फ़ कार्य + globals) को
    // main नहीं चाहिए; वरना linker में `multiple definition of main`।
    सूची वस = एकक["वैश्विक_सूची"];
    यदि ((एकक["मुख्य_है"] == सत्य || एकक["शीर्ष_है"] == सत्य) && एकक["फ्रीस्टैंडिंग"] != सत्य) {
        उगपं(बफ, "  .text");
        उगपं(बफ, "  .globl main");
        उगपं(बफ, "  .def main; .scl 2; .type 32; .endef");
        उगपं(बफ, "main:");
        उगपं(बफ, "  pushq %rbp");
        उगपं(बफ, "  movq %rsp, %rbp");
        उगपं(बफ, "  subq $32, %rsp");
        // §4c: पाठ-साहित्य तालिका सबसे पहले (auto-GC से पूर्व → निर्माण
        // के दौरान कोई GC नहीं; फिर slots स्थायी जड़)
        यदि (लंबाई(एकक["पाठ_स्थिरांक"]) > 0) {
            उगपं(बफ, "  call सूत्र_पाठ_तालिका_आरंभ");
        }
        // तर्क अब आलसी (मूल_रनटाइम.सूत्र का तर्क_सूची_रन पहली कॉल पर पढ़ता)
        इक = 0;
        यावत् (इक < लंबाई(वस)) {
            उगपं(बफ, "  leaq sutra_glob_" + वस[इक]["नाम"] + "(%rip), %rcx");
            उगपं(बफ, "  call sutra_gc_push_root");
            इक = इक + 1;
        }
        // IR backend में precise roots हैं → auto-GC सुरक्षित है (opt-in)
        उगपं(बफ, "  call सूत्र_स्वजीसी_आरंभ");
        यदि (एकक["शीर्ष_है"] == सत्य) { उगपं(बफ, "  call __शीर्ष"); }
        यदि (एकक["मुख्य_है"] == सत्य) { उगपं(बफ, "  call sutra_main"); }
        इक = लंबाई(वस) - 1;
        यावत् (इक >= 0) {
            उगपं(बफ, "  leaq sutra_glob_" + वस[इक]["नाम"] + "(%rip), %rcx");
            उगपं(बफ, "  call sutra_gc_pop_root");
            इक = इक - 1;
        }
        उगपं(बफ, "  xorl %eax, %eax");
        उगपं(बफ, "  movq %rbp, %rsp");
        उगपं(बफ, "  popq %rbp");
        उगपं(बफ, "  ret");
        उगपं(बफ, "");
    }

    // .data — वैश्विक चर
    यदि (लंबाई(वस) > 0) {
        उगपं(बफ, "  .data");
        इक = 0;
        यावत् (इक < लंबाई(वस)) {
            उगपं(बफ, "  .globl sutra_glob_" + वस[इक]["नाम"]);
            उगपं(बफ, "sutra_glob_" + वस[इक]["नाम"] + ":");
            उगपं(बफ, "  .quad 0");
            इक = इक + 1;
        }
    }

    // .rdata — पाठ + दशमलव स्थिरांक
    उगपं(बफ, "  .section .rdata,\"dr\"");
    सूची दस्ू = एकक["दशमलव_स्थिरांक"];
    इक = 0;
    यावत् (इक < लंबाई(दस्ू)) {
        उगपं(बफ, "  .align 8");
        उगपं(बफ, ".LC_dbl_" + इक + ":");
        उगपं(बफ, "  .double " + दस्ू[इक]);
        इक = इक + 1;
    }
    सूची पस = एकक["पाठ_स्थिरांक"];
    इक = 0;
    यावत् (इक < लंबाई(पस)) {
        उगपं(बफ, ".LC_str_" + इक + ":");
        उगपं(बफ, "  .ascii \"" + उत्_एस्केप(पस[इक]) + "\\0\"");
        उगपं(बफ, ".LC_str_" + इक + "_len:");
        उगपं(बफ, "  .quad " + उत्_बाइट_लंबाई(पस[इक]));
        इक = इक + 1;
    }
    उगपं(बफ, "");

    // §4c: पाठ-साहित्य साझा तालिका (.bss) — startup पर भरती है
    यदि (एकक["_पाठ_तालिका"] == सत्य && लंबाई(पस) > 0) {
        उगपं(बफ, "  .bss");
        उगपं(बफ, "  .align 8");
        उगपं(बफ, ".LC_strtab:");
        उगपं(बफ, "  .space " + (8 * लंबाई(पस)));
        उगपं(बफ, "");
    }

    परत् उब_पाठ(बफ);
}

// §4c: main-program के हर पाठ-साहित्य को startup पर एक बार बनाकर
// .LC_strtab में रखो + हर slot स्थायी GC-जड़ (कभी pop नहीं — साहित्य
// प्रोग्राम-भर जीवित)। उत्_स्थिर फिर सिर्फ़ table-load देता।
कार्य उत्_पाठ_तालिका_आरंभ(शब्दकोश बफ, शब्दकोश एकक) {
    सूची पस = एकक["पाठ_स्थिरांक"];
    संख्या नग = लंबाई(पस);
    यदि (नग == 0) { परत् 0; }
    उगपं(बफ, "  .text");
    उगपं(बफ, "  .globl सूत्र_पाठ_तालिका_आरंभ");
    उगपं(बफ, "  .def सूत्र_पाठ_तालिका_आरंभ; .scl 2; .type 32; .endef");
    उगपं(बफ, "सूत्र_पाठ_तालिका_आरंभ:");
    उगपं(बफ, "  pushq %rbp");
    उगपं(बफ, "  movq %rsp, %rbp");
    उगपं(बफ, "  subq $32, %rsp");
    संख्या इक = 0;
    यावत् (इक < नग) {
        उगपं(बफ, "  leaq .LC_str_" + इक + "(%rip), %rcx");
        उगपं(बफ, "  movq .LC_str_" + इक + "_len(%rip), %rdx");
        उगपं(बफ, "  call पाठ_रचना");
        उगपं(बफ, "  movq %rax, .LC_strtab+" + (8 * इक) + "(%rip)");
        इक = इक + 1;
    }
    // सारे slots एक-साथ स्थायी GC-जड़ बनाओ
    उगपं(बफ, "  movl gc_roots_count(%rip), %eax");
    उगपं(बफ, "  leaq gc_roots(%rip), %r10");
    उगपं(बफ, "  leaq .LC_strtab(%rip), %r11");
    उगपं(बफ, "  movl $" + नग + ", %ecx");
    उगपं(बफ, ".Lस्ट्रटैब_जड़:");
    उगपं(बफ, "  movq %r11, (%r10,%rax,8)");
    उगपं(बफ, "  incl %eax");
    उगपं(बफ, "  addq $8, %r11");
    उगपं(बफ, "  decl %ecx");
    उगपं(बफ, "  jnz .Lस्ट्रटैब_जड़");
    उगपं(बफ, "  movl %eax, gc_roots_count(%rip)");
    उगपं(बफ, "  movq %rbp, %rsp");
    उगपं(बफ, "  popq %rbp");
    उगपं(बफ, "  ret");
    उगपं(बफ, "");
    परत् 0;
}
