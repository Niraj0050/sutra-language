// मूल_उत्सर्जक.सूत्र — मध्यम IR → x86-64 GAS assembly  [Phase 1e]
// ============================================================
// इनपुट: IR एकक जो lower + अनुकूलक + रजि_नियतक से गुज़र चुका।
// आउटपुट: .s पाठ (मूल_सर्जक जैसा — उसी runtime से link होता है)।
//
// रजिस्टर उपयोग:
//   rax   — परिणाम / भाग / परत्-मान
//   rcx rdx r8 r9 — कॉल तर्क (Windows x64)
//   r10 r11 — उत्सर्जक scratch (binary ops, parallel-move)
//   rbx rsi rdi r12-r15 — रजि_नियतक का pool (callee-saved)
//
// अभी संकलक में wire नहीं — मूल_उत्सर्जक_परीक्षण.सूत्र से जाँचा।
// स्थगित: floats, अनुक्रम/क्षेत्र पढ़/लिख, नव_*, विधि_बुलाओ, परिवर्तन,
//         प्रकार_है, फेंको, precise GC roots (1f)।
// ============================================================

आयात "मध्यम.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "रजि_नियतक.सूत्र";


// ---- पाठ-निर्माता (chunk सूची; O(n²) concat नहीं) ----
कार्य उब_नया() { शब्दकोश ब = {}; ब["ट"] = []; परत् ब; }
कार्य उगल(शब्दकोश ब, पाठ स) { ब["ट"] = जोड़ें(ब["ट"], स); परत् 0; }
कार्य उगपं(शब्दकोश ब, पाठ स) {
    ब["ट"] = जोड़ें(ब["ट"], स);
    ब["ट"] = जोड़ें(ब["ट"], अक्षर_निर्माण(10));
    परत् 0;
}
कार्य उब_पाठ(शब्दकोश ब) { परत् संयोजित(ब["ट"], ""); }


// ---- GAS string escape (मूल_सर्जक से) ----
कार्य उत्_एस्केप(पाठ मूल) {
    मान परिणाम = "";
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(मूल)) {
        मान वर्ण = मूल[सूचक];
        संख्या कोड = अक्षर_मान(वर्ण);
        यदि (कोड == 92) { परिणाम = परिणाम + अक्षर_निर्माण(92) + अक्षर_निर्माण(92); }
        अन्यथा यदि (कोड == 34) { परिणाम = परिणाम + अक्षर_निर्माण(92) + अक्षर_निर्माण(34); }
        अन्यथा यदि (कोड == 10) { परिणाम = परिणाम + अक्षर_निर्माण(92) + अक्षर_निर्माण(110); }
        अन्यथा यदि (कोड >= 32 && कोड < 127) { परिणाम = परिणाम + वर्ण; }
        अन्यथा {
            सूची बाइट्स = [];
            यदि (कोड <= 127) { बाइट्स = जोड़ें(बाइट्स, कोड); }
            अन्यथा यदि (कोड <= 2047) {
                बाइट्स = जोड़ें(बाइट्स, 192 + (कोड / 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            } अन्यथा यदि (कोड <= 65535) {
                बाइट्स = जोड़ें(बाइट्स, 224 + (कोड / 4096));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 64) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            } अन्यथा {
                बाइट्स = जोड़ें(बाइट्स, 240 + (कोड / 262144));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 4096) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 64) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            }
            संख्या ब_सूचक = 0;
            यावत् (ब_सूचक < लंबाई(बाइट्स)) {
                संख्या ब = बाइट्स[ब_सूचक];
                परिणाम = परिणाम + अक्षर_निर्माण(92) + (ब / 64) + ((ब % 64) / 8) + (ब % 8);
                ब_सूचक = ब_सूचक + 1;
            }
        }
        सूचक = सूचक + 1;
    }
    परत् परिणाम;
}

कार्य उत्_बाइट_लंबाई(पाठ प) {
    मान कुल = 0;
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(प)) {
        संख्या कोड = अक्षर_मान(प[सूचक]);
        यदि (कोड <= 127) { कुल = कुल + 1; }
        अन्यथा यदि (कोड <= 2047) { कुल = कुल + 2; }
        अन्यथा यदि (कोड <= 65535) { कुल = कुल + 3; }
        अन्यथा { कुल = कुल + 4; }
        सूचक = सूचक + 1;
    }
    परत् कुल;
}


// ============================================================
// फ्रेम-लेआउट + मान-स्थान
// ============================================================
// callee-saved reg i  →  -8*(i+1)(%rbp)  में सुरक्षित
// spill slot 'ऑफसेट'  →  -(8*N_saved + 16 + ऑफसेट)(%rbp)
// FRAME = align16(8*N_saved + 16 + ढेर_आकार)

कार्य उत्_फ्रेम_आकार(शब्दकोश फलन) {
    संख्या न_सुर = लंबाई(फलन["प्रयुक्त_सुरक्षित"]);
    संख्या कच्चा = 8 * न_सुर + 16 + फलन["ढेर_आकार"];
    परत् ((कच्चा + 15) / 16) * 16;
}

कार्य उत्_सुरक्षित_स्थान(संख्या क्रमांक) {
    परत् (0 - (8 * (क्रमांक + 1))) + "(%rbp)";
}

// मान-id → operand पाठ ("%r12" या "-40(%rbp)")
कार्य उत्_स्थान(शब्दकोश फलन, संख्या आईडी) {
    शब्दकोश नि = फलन["रजि_नियतन"];
    मान अ = नि[आईडी];
    यदि (अ == शून्यम्) { परत् "%r15"; }   // fallback (नहीं होना चाहिए)
    यदि (अ["प्रकार"] == "रजि") { परत् "%" + अ["नाम"]; }
    संख्या न_सुर = लंबाई(फलन["प्रयुक्त_सुरक्षित"]);
    संख्या ऑफ = 8 * न_सुर + 16 + अ["ऑफसेट"];
    परत् (0 - ऑफ) + "(%rbp)";
}

// क्या यह स्थान memory है?
कार्य उत्_मेम_है(पाठ स्थान) {
    परत् खोजें(स्थान, "(%rbp)") >= 0;
}


// ============================================================
// खंड-लेबल
// ============================================================
कार्य उत्_लेबल(पाठ कार्य_नाम, पाठ खंड_लेबल) {
    परत् ".L_" + कार्य_नाम + "__" + खंड_लेबल;
}
कार्य उत्_एपिलॉग(पाठ कार्य_नाम) {
    परत् ".L_epilogue_" + कार्य_नाम;
}


// ============================================================
// एक निर्देश का उत्सर्जन
// ============================================================
कार्य उत्_निर्देश(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश एकक, शब्दकोश निर्देश) {
    पाठ कोड = निर्देश["कोड"];
    संख्या दस = निर्देश["आईडी"];

    यदि (कोड == "स्थिर") {
        उत्_स्थिर(बफ, फलन, एकक, निर्देश);
        परत् 0;
    }
    यदि (कोड == "योग" || कोड == "अंतर" || कोड == "गुणा") {
        पाठ विधि = "पूर्ण";
        यदि (निर्देश["अंश"]["विधि"] != शून्यम्) { विधि = निर्देश["अंश"]["विधि"]; }
        यदि (कोड == "योग" && विधि == "पाठ") {
            उत्_रॉ_कॉल(बफ, "sutra_str_concat",
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        यदि (कोड == "योग" && विधि == "मान") {
            उत्_रॉ_कॉल(बफ, "sutra_add_dynamic",
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            परत् 0;
        }
        पाठ यंत्र = "addq";
        यदि (कोड == "अंतर") { यंत्र = "subq"; }
        यदि (कोड == "गुणा") { यंत्र = "imulq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  " + यंत्र + " " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "भाग" || कोड == "शेष") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %rax");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  cqto");
        उगपं(बफ, "  idivq %r10");
        यदि (कोड == "भाग") { उगपं(बफ, "  movq %rax, " + उत्_स्थान(फलन, दस)); }
        अन्यथा { उगपं(बफ, "  movq %rdx, " + उत्_स्थान(फलन, दस)); }
        परत् 0;
    }
    यदि (उत्_तुलना_है(कोड)) {
        पाठ तविधि = "पूर्ण";
        यदि (निर्देश["अंश"]["विधि"] != शून्यम्) { तविधि = निर्देश["अंश"]["विधि"]; }
        // dynamic == / != → पाठ_तुल्य (int pointer-eq भी सही, string भी)
        यदि (तविधि == "मान" && (कोड == "सम" || कोड == "असम")) { तविधि = "पाठ"; }
        यदि (तविधि == "पाठ") {
            उत्_रॉ_कॉल(बफ, उत्_पाठ_तुलना_सिम(कोड),
                [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
            यदि (कोड == "असम") {
                उगपं(बफ, "  movq " + उत्_स्थान(फलन, दस) + ", %r10");
                उगपं(बफ, "  cmpq $0, %r10");
                उगपं(बफ, "  sete %al");
                उगपं(बफ, "  movzbq %al, %r10");
                उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
            }
            परत् 0;
        }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  cmpq " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  " + उत्_सेट_यंत्र(कोड) + " %al");
        उगपं(बफ, "  movzbq %al, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "और" || कोड == "या") {
        पाठ यंत्र = "andq";
        यदि (कोड == "या") { यंत्र = "orq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  " + यंत्र + " " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r10");
        उगपं(बफ, "  cmpq $0, %r10");
        उगपं(बफ, "  setne %al");
        उगपं(बफ, "  movzbq %al, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "नकार") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  cmpq $0, %r10");
        उगपं(बफ, "  sete %al");
        उगपं(बफ, "  movzbq %al, %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "ऋणात्मक") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  negq %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "पढ़_वैश्विक") {
        उगपं(बफ, "  movq sutra_glob_" + निर्देश["अंश"]["नाम"] + "(%rip), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "लिख_वैश्विक") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  movq %r10, sutra_glob_" + निर्देश["अंश"]["नाम"] + "(%rip)");
        परत् 0;
    }
    यदि (कोड == "बुलाओ") {
        उत्_कॉल(बफ, फलन, निर्देश["अंश"]["लक्ष्य"], निर्देश["संचालक"], दस);
        परत् 0;
    }
    यदि (कोड == "अंतर्") {
        उत्_अंतर्(बफ, फलन, निर्देश);
        परत् 0;
    }
    यदि (कोड == "लंबाई") {
        उत्_रॉ_कॉल(बफ, "दैशिक_लंबाई", [उत्_स्थान(फलन, निर्देश["संचालक"][0])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "पढ़_अनुक्रम") {
        पाठ आप = "मान";
        यदि (निर्देश["अंश"]["आधार_प्रकार"] != शून्यम्) { आप = निर्देश["अंश"]["आधार_प्रकार"]; }
        पाठ सिम = "sutra_arr_get";
        यदि (आप == "पाठ") { सिम = "sutra_str_get"; }
        उत्_रॉ_कॉल(बफ, सिम, [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "लिख_अनुक्रम") {
        उत्_रॉ_कॉल(बफ, "sutra_arr_set",
            [उत्_स्थान(फलन, निर्देश["संचालक"][0]), उत्_स्थान(फलन, निर्देश["संचालक"][1]), उत्_स्थान(फलन, निर्देश["संचालक"][2])], "");
        परत् 0;
    }
    यदि (कोड == "नव_सूची") {
        सूची तत्व = निर्देश["संचालक"];
        उत्_रॉ_कॉल(बफ, "sutra_arr_create", ["$" + लंबाई(तत्व)], उत्_स्थान(फलन, दस));
        संख्या इक = 0;
        यावत् (इक < लंबाई(तत्व)) {
            उत्_रॉ_कॉल(बफ, "sutra_arr_set", [उत्_स्थान(फलन, दस), "$" + इक, उत्_स्थान(फलन, तत्व[इक])], "");
            इक = इक + 1;
        }
        परत् 0;
    }
    यदि (कोड == "नव_शब्दकोश") {
        सूची जोड़े = निर्देश["संचालक"];
        उत्_रॉ_कॉल(बफ, "sutra_dict_create", [], उत्_स्थान(फलन, दस));
        संख्या इक = 0;
        यावत् (इक + 1 < लंबाई(जोड़े)) {
            उत्_रॉ_कॉल(बफ, "sutra_dict_set",
                [उत्_स्थान(फलन, दस), उत्_स्थान(फलन, जोड़े[इक]), उत्_स्थान(फलन, जोड़े[इक + 1])], "");
            इक = इक + 2;
        }
        परत् 0;
    }
    यदि (कोड == "पढ़_क्षेत्र") {
        संख्या सूच = 0;
        यदि (निर्देश["अंश"]["सूचकांक"] != शून्यम्) { सूच = निर्देश["अंश"]["सूचकांक"]; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  movq " + (16 + सूच * 8) + "(%r10), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "लिख_क्षेत्र") {
        संख्या सूच = 0;
        यदि (निर्देश["अंश"]["सूचकांक"] != शून्यम्) { सूच = निर्देश["अंश"]["सूचकांक"]; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, निर्देश["संचालक"][1]) + ", %r11");
        उगपं(बफ, "  movq %r11, " + (16 + सूच * 8) + "(%r10)");
        परत् 0;
    }
    यदि (कोड == "नव_वस्तु") {
        संख्या क्षेत्र_गण = 0;
        यदि (निर्देश["अंश"]["क्षेत्र_गण"] != शून्यम्) { क्षेत्र_गण = निर्देश["अंश"]["क्षेत्र_गण"]; }
        पाठ दस्थ = उत्_स्थान(फलन, दस);
        उत्_रॉ_कॉल(बफ, "sutra_obj_alloc", ["$" + क्षेत्र_गण], दस्थ);
        // रचना कॉल: (obj, तर्क...) — परिणाम obj ही रहता है
        सूची कतर्क = [दस्थ];
        संख्या इक = 0;
        यावत् (इक < लंबाई(निर्देश["संचालक"])) {
            कतर्क = जोड़ें(कतर्क, उत्_स्थान(फलन, निर्देश["संचालक"][इक]));
            इक = इक + 1;
        }
        उत्_रॉ_कॉल(बफ, निर्देश["अंश"]["रचना"], कतर्क, "");
        परत् 0;
    }
    यदि (कोड == "प्रकार_है") {
        पाठ ज = निर्देश["अंश"]["जाँच"];
        पाठ सिम = "sutra_native_is_string";
        यदि (ज == "शब्दकोश") { सिम = "sutra_is_dict"; }
        यदि (ज == "सूची") { सिम = "sutra_native_is_array"; }
        उत्_रॉ_कॉल(बफ, सिम, [उत्_स्थान(फलन, निर्देश["संचालक"][0])], उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (कोड == "अमृत" || कोड == "स्लॉट") { परत् 0; }

    // अभी-भी-स्थगित opcodes — टिप्पणी छोड़ो
    उगपं(बफ, "  # स्थगित: " + कोड);
    परत् 0;
}

// निम्न-स्तर कॉल — तर्क पहले से operand-पाठ (value-id नहीं)
कार्य उत्_रॉ_कॉल(शब्दकोश बफ, पाठ प्रतीक, सूची तर्क_स्थान, पाठ दस्थ) {
    सूची अरजि = ["%rcx", "%rdx", "%r8", "%r9"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(तर्क_स्थान) && इक < 4) {
        उगपं(बफ, "  movq " + तर्क_स्थान[इक] + ", " + अरजि[इक]);
        इक = इक + 1;
    }
    उगपं(बफ, "  subq $32, %rsp");
    उगपं(बफ, "  call " + प्रतीक);
    उगपं(बफ, "  addq $32, %rsp");
    यदि (दस्थ != "") { उगपं(बफ, "  movq %rax, " + दस्थ); }
    परत् 0;
}

कार्य उत्_तुलना_है(पाठ कोड) {
    परत् कोड == "सम" || कोड == "असम" || कोड == "लघु" || कोड == "गुरु"
        || कोड == "लघुसम" || कोड == "गुरुसम";
}
// पाठ-तुलना → runtime symbol (सम/असम दोनों पाठ_तुल्य से; असम बाद में उलटा)
कार्य उत्_पाठ_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "सम" || कोड == "असम") { परत् "पाठ_तुल्य"; }
    यदि (कोड == "लघु") { परत् "पाठ_न्यून"; }
    यदि (कोड == "गुरु") { परत् "पाठ_अधिक"; }
    यदि (कोड == "लघुसम") { परत् "पाठ_न्यून_सम"; }
    परत् "पाठ_अधिक_सम";
}

कार्य उत्_सेट_यंत्र(पाठ कोड) {
    यदि (कोड == "सम") { परत् "sete"; }
    यदि (कोड == "असम") { परत् "setne"; }
    यदि (कोड == "लघु") { परत् "setl"; }
    यदि (कोड == "गुरु") { परत् "setg"; }
    यदि (कोड == "लघुसम") { परत् "setle"; }
    परत् "setge";
}

कार्य उत्_स्थिर(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश एकक, शब्दकोश निर्देश) {
    पाठ मप = निर्देश["अंश"]["मान_प्रकार"];
    पाठ दस्थ = उत्_स्थान(फलन, निर्देश["आईडी"]);
    यदि (मप == "पूर्ण") {
        उगपं(बफ, "  movq $" + निर्देश["अंश"]["मान"] + ", " + दस्थ);
        परत् 0;
    }
    यदि (मप == "बूल") {
        मान म = निर्देश["अंश"]["मान"];
        यदि (म == सत्य || म == 1) { उगपं(बफ, "  movq $1, " + दस्थ); }
        अन्यथा { उगपं(बफ, "  movq $0, " + दस्थ); }
        परत् 0;
    }
    यदि (मप == "शून्यम्") {
        उगपं(बफ, "  movq $0, " + दस्थ);
        परत् 0;
    }
    यदि (मप == "पाठ") {
        संख्या अनु = निर्देश["अंश"]["मान"];   // पाठ_स्थिरांक तालिका अनुक्रमांक
        उगपं(बफ, "  leaq .LC_str_" + अनु + "(%rip), %rcx");
        उगपं(बफ, "  movq .LC_str_" + अनु + "_len(%rip), %rdx");
        उगपं(बफ, "  subq $32, %rsp");
        उगपं(बफ, "  call sutra_str_alloc");
        उगपं(बफ, "  addq $32, %rsp");
        उगपं(बफ, "  movq %rax, " + दस्थ);
        परत् 0;
    }
    उगपं(बफ, "  movq $0, " + दस्थ);
    परत् 0;
}

कार्य उत्_कॉल(शब्दकोश बफ, शब्दकोश फलन, पाठ लक्ष्य, सूची तर्क, संख्या दस) {
    सूची अरजि = ["%rcx", "%rdx", "%r8", "%r9"];
    संख्या ढेर_तर्क = 0;
    यदि (लंबाई(तर्क) > 4) { ढेर_तर्क = लंबाई(तर्क) - 4; }
    संख्या छाया = 32 + ढेर_तर्क * 8;
    यदि (छाया % 16 != 0) { छाया = छाया + 8; }

    // 5वें+ तर्क — उल्टे क्रम में push (v1 में दुर्लभ)
    संख्या जक = लंबाई(तर्क) - 1;
    यावत् (जक >= 4) {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, तर्क[जक]) + ", %r11");
        उगपं(बफ, "  pushq %r11");
        जक = जक - 1;
    }
    // तर्क 0..3 → rcx/rdx/r8/r9 । स्रोत pool-रजि/spill हैं, ABI रजि कभी नहीं
    // → कोई चक्र नहीं, सीधी mov।
    संख्या इक = 0;
    यावत् (इक < लंबाई(तर्क) && इक < 4) {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, तर्क[इक]) + ", " + अरजि[इक]);
        इक = इक + 1;
    }
    उगपं(बफ, "  subq $32, %rsp");
    उगपं(बफ, "  call " + लक्ष्य);
    उगपं(बफ, "  addq $" + छाया + ", %rsp");
    यदि (दस >= 1) {
        उगपं(बफ, "  movq %rax, " + उत्_स्थान(फलन, दस));
    }
    परत् 0;
}

कार्य उत्_अंतर्(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश निर्देश) {
    पाठ नाम = निर्देश["अंश"]["नाम"];
    सूची स = निर्देश["संचालक"];
    संख्या दस = निर्देश["आईडी"];
    यदि (नाम == "अंतर्_पढ़8" || नाम == "अंतर्_पढ़1") {
        पाठ यंत्र = "movq";
        यदि (नाम == "अंतर्_पढ़1") { यंत्र = "movzbq"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[1]) + ", %r11");
        उगपं(बफ, "  " + यंत्र + " (%r10,%r11), %r10");
        उगपं(बफ, "  movq %r10, " + उत्_स्थान(फलन, दस));
        परत् 0;
    }
    यदि (नाम == "अंतर्_लिख8" || नाम == "अंतर्_लिख1") {
        पाठ रस = "%r8";
        पाठ यंत्र = "movq";
        यदि (नाम == "अंतर्_लिख1") { यंत्र = "movb"; रस = "%r8b"; }
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[0]) + ", %r10");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[1]) + ", %r11");
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[2]) + ", %r8");
        उगपं(बफ, "  " + यंत्र + " " + रस + ", (%r10,%r11)");
        यदि (दस >= 1) { उगपं(बफ, "  movq " + उत्_स्थान(फलन, स[2]) + ", " + उत्_स्थान(फलन, दस)); }
        परत् 0;
    }
    // अन्य अंतर्_* → C helper कॉल (नाम ही symbol)
    उत्_कॉल(बफ, फलन, उत्_अंतर्_प्रतीक(नाम), स, दस);
    परत् 0;
}

कार्य उत्_अंतर्_प्रतीक(पाठ नाम) {
    यदि (नाम == "अंतर्_क्षेत्र_आवंटन") { परत् "सूत्र_तल_आवंटन"; }
    यदि (नाम == "अंतर्_क्षेत्र_मुक्त") { परत् "सूत्र_तल_मुक्त"; }
    यदि (नाम == "अंतर्_निकास") { परत् "सूत्र_तल_निकास"; }
    यदि (नाम == "अंतर्_क्या_पाठ") { परत् "sutra_native_is_string"; }
    यदि (नाम == "अंतर्_क्या_शब्दकोश") { परत् "sutra_is_dict"; }
    परत् नाम;
}


// ============================================================
// समानांतर चाल (parallel move) — चक्र-सुरक्षित, कर्षक (scratch) से
// जोड़े = [[स्रोत, लक्ष्य], ...] ; स्रोत/लक्ष्य = operand पाठ
// ============================================================
कार्य उत्_चालें(शब्दकोश बफ, सूची जोड़े, पाठ कर्षक) {
    // पहचान-चालें हटाओ
    सूची शेष = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(जोड़े)) {
        यदि (जोड़े[इक][0] != जोड़े[इक][1]) { शेष = जोड़ें(शेष, जोड़े[इक]); }
        इक = इक + 1;
    }
    यावत् (लंबाई(शेष) > 0) {
        // ऐसा जोड़ा ढूँढो जिसका लक्ष्य किसी बचे स्रोत में नहीं
        संख्या मिला = 0 - 1;
        इक = 0;
        यावत् (इक < लंबाई(शेष)) {
            यदि (न उत्_स्रोत_में(शेष, शेष[इक][1])) { मिला = इक; }
            इक = इक + 1;
        }
        यदि (मिला >= 0) {
            उत्_एक_चाल(बफ, शेष[मिला][0], शेष[मिला][1], कर्षक);
            शेष = उत्_सूची_हटाओ(शेष, मिला);
        } अन्यथा {
            // चक्र — पहला जोड़ा तोड़ो
            पाठ पुराना_लक्ष्य = शेष[0][1];
            उगपं(बफ, "  movq " + पुराना_लक्ष्य + ", " + कर्षक);
            // हर जोड़ा जिसका स्रोत == पुराना_लक्ष्य → स्रोत = कर्षक
            सूची नया = [];
            इक = 0;
            यावत् (इक < लंबाई(शेष)) {
                यदि (शेष[इक][0] == पुराना_लक्ष्य) { नया = जोड़ें(नया, [कर्षक, शेष[इक][1]]); }
                अन्यथा { नया = जोड़ें(नया, शेष[इक]); }
                इक = इक + 1;
            }
            शेष = नया;
        }
    }
    परत् 0;
}
// mem→mem को कर्षक से route करो
कार्य उत्_एक_चाल(शब्दकोश बफ, पाठ स्रोत, पाठ लक्ष्य, पाठ कर्षक) {
    यदि (स्रोत == लक्ष्य) { परत् 0; }
    यदि (उत्_मेम_है(स्रोत) && उत्_मेम_है(लक्ष्य)) {
        उगपं(बफ, "  movq " + स्रोत + ", " + कर्षक);
        उगपं(बफ, "  movq " + कर्षक + ", " + लक्ष्य);
    } अन्यथा {
        उगपं(बफ, "  movq " + स्रोत + ", " + लक्ष्य);
    }
    परत् 0;
}

कार्य उत्_स्रोत_में(सूची शेष, पाठ लक्ष्य) {
    संख्या इक = 0;
    यावत् (इक < लंबाई(शेष)) {
        यदि (शेष[इक][0] == लक्ष्य) { परत् सत्य; }
        इक = इक + 1;
    }
    परत् असत्य;
}
कार्य उत्_सूची_हटाओ(सूची स, संख्या सूचकांक) {
    सूची फल = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(स)) {
        यदि (इक != सूचकांक) { फल = जोड़ें(फल, स[इक]); }
        इक = इक + 1;
    }
    परत् फल;
}


// ============================================================
// फाई-चालें (edge पर)
// ============================================================
कार्य उत्_फाई_चालें(शब्दकोश बफ, शब्दकोश फलन, पाठ पूर्व_लेबल, शब्दकोश गंतव्य_खंड) {
    सूची फाई_सूची = गंतव्य_खंड["फाई"];
    सूची स्रोत = [];
    सूची लक्ष्य = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(फाई_सूची)) {
        शब्दकोश फ = फाई_सूची[इक];
        सूची पर_सूची = फ["अंश"]["स्रोत"];
        संख्या जक = 0;
        यावत् (जक < लंबाई(पर_सूची)) {
            यदि (पर_सूची[जक][0] == पूर्व_लेबल) {
                संख्या मव = पर_सूची[जक][1];
                यदि (मव >= 1) {
                    स्रोत = जोड़ें(स्रोत, उत्_स्थान(फलन, मव));
                    लक्ष्य = जोड़ें(लक्ष्य, उत्_स्थान(फलन, फ["आईडी"]));
                }
            }
            जक = जक + 1;
        }
        इक = इक + 1;
    }
    // चक्र-सुरक्षित parallel move
    सूची जोड़े = [];
    इक = 0;
    यावत् (इक < लंबाई(लक्ष्य)) {
        जोड़े = जोड़ें(जोड़े, [स्रोत[इक], लक्ष्य[इक]]);
        इक = इक + 1;
    }
    उत्_चालें(बफ, जोड़े, "%r11");
    परत् 0;
}


// ============================================================
// टर्मिनेटर
// ============================================================
कार्य उत्_टर्मिनेटर(शब्दकोश बफ, शब्दकोश फलन, पाठ कार्य_नाम, शब्दकोश खंड, शब्दकोश धारक) {
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम्) {
        उगपं(बफ, "  jmp " + उत्_एपिलॉग(कार्य_नाम));
        परत् 0;
    }
    पाठ कोड = अंत["कोड"];
    पाठ यह_लेबल = खंड["लेबल"];

    यदि (कोड == "वापस") {
        यदि (लंबाई(अंत["संचालक"]) > 0) {
            उगपं(बफ, "  movq " + उत्_स्थान(फलन, अंत["संचालक"][0]) + ", %rax");
        } अन्यथा {
            उगपं(बफ, "  movq $0, %rax");
        }
        उगपं(बफ, "  jmp " + उत्_एपिलॉग(कार्य_नाम));
        परत् 0;
    }
    यदि (कोड == "जाओ") {
        पाठ ग = अंत["अंश"]["लक्ष्य"];
        उत्_फाई_चालें(बफ, फलन, यह_लेबल, अनु_खंड_खोजें(फलन, ग));
        उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, ग));
        परत् 0;
    }
    यदि (कोड == "यदि_जाओ") {
        पाठ सत्य_ग = अंत["अंश"]["सत्य"];
        पाठ असत्य_ग = अंत["अंश"]["असत्य"];
        संख्या क्रम = धारक["किनारा"];
        धारक["किनारा"] = क्रम + 1;
        पाठ अ_किनारा = ".L_किनारा_" + कार्य_नाम + "_" + क्रम;

        उगपं(बफ, "  movq " + उत्_स्थान(फलन, अंत["संचालक"][0]) + ", %r10");
        उगपं(बफ, "  cmpq $0, %r10");
        उगपं(बफ, "  je " + अ_किनारा);
        // सत्य किनारा
        उत्_फाई_चालें(बफ, फलन, यह_लेबल, अनु_खंड_खोजें(फलन, सत्य_ग));
        उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, सत्य_ग));
        // असत्य किनारा
        उगपं(बफ, अ_किनारा + ":");
        उत्_फाई_चालें(बफ, फलन, यह_लेबल, अनु_खंड_खोजें(फलन, असत्य_ग));
        उगपं(बफ, "  jmp " + उत्_लेबल(कार्य_नाम, असत्य_ग));
        परत् 0;
    }
    यदि (कोड == "फेंको") {
        उगपं(बफ, "  movq " + उत्_स्थान(फलन, अंत["संचालक"][0]) + ", %rcx");
        उगपं(बफ, "  subq $32, %rsp");
        उगपं(बफ, "  call sutra_throw");
        उगपं(बफ, "  addq $32, %rsp");
        परत् 0;
    }
    उगपं(बफ, "  jmp " + उत्_एपिलॉग(कार्य_नाम));
    परत् 0;
}


// ============================================================
// एक कार्य
// ============================================================
कार्य उत्_कार्य(शब्दकोश बफ, शब्दकोश एकक, शब्दकोश फलन) {
    पाठ नाम = फलन["नाम"];
    यदि (नाम == "मुख्य") { नाम = "sutra_main"; }
    संख्या फ्रेम = उत्_फ्रेम_आकार(फलन);
    सूची सुर = फलन["प्रयुक्त_सुरक्षित"];

    उगपं(बफ, "  .text");
    उगपं(बफ, "  .globl " + नाम);
    उगपं(बफ, "  .def " + नाम + "; .scl 2; .type 32; .endef");
    उगपं(बफ, नाम + ":");
    उगपं(बफ, "  pushq %rbp");
    उगपं(बफ, "  movq %rsp, %rbp");
    उगपं(बफ, "  subq $" + फ्रेम + ", %rsp");
    // callee-saved सुरक्षित
    संख्या इक = 0;
    यावत् (इक < लंबाई(सुर)) {
        उगपं(बफ, "  movq %" + सुर[इक] + ", " + उत्_सुरक्षित_स्थान(इक));
        इक = इक + 1;
    }
    // पैरामीटर → नियत स्थान
    सूची अरजि = ["%rcx", "%rdx", "%r8", "%r9"];
    सूची पैरा = फलन["पैरामीटर"];
    इक = 0;
    यावत् (इक < लंबाई(पैरा)) {
        पाठ दस्थ = उत्_स्थान(फलन, पैरा[इक]["आईडी"]);
        यदि (इक < 4) {
            यदि (("%" + दस्थ) != अरजि[इक] && दस्थ != अरजि[इक]) {
                उगपं(बफ, "  movq " + अरजि[इक] + ", " + दस्थ);
            }
        } अन्यथा {
            उगपं(बफ, "  movq " + (16 + (इक) * 8) + "(%rbp), %r10");
            उगपं(बफ, "  movq %r10, " + दस्थ);
        }
        इक = इक + 1;
    }
    उगपं(बफ, "");

    // खंड (RPO क्रम में)
    सूची क्रम = अनु_विपक्रम(फलन);
    शब्दकोश धारक = {};
    धारक["किनारा"] = 0;
    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, क्रम[कक]);
        उगपं(बफ, उत्_लेबल(नाम, क्रम[कक]) + ":");
        संख्या नि = 0;
        यावत् (नि < लंबाई(खंड["निर्देश"])) {
            उत्_निर्देश(बफ, फलन, एकक, खंड["निर्देश"][नि]);
            नि = नि + 1;
        }
        उत्_टर्मिनेटर(बफ, फलन, नाम, खंड, धारक);
        कक = कक + 1;
    }

    // एपिलॉग
    उगपं(बफ, उत्_एपिलॉग(नाम) + ":");
    इक = 0;
    यावत् (इक < लंबाई(सुर)) {
        उगपं(बफ, "  movq " + उत्_सुरक्षित_स्थान(इक) + ", %" + सुर[इक]);
        इक = इक + 1;
    }
    उगपं(बफ, "  movq %rbp, %rsp");
    उगपं(बफ, "  popq %rbp");
    उगपं(बफ, "  ret");
    उगपं(बफ, "");
    परत् 0;
}


// ============================================================
// एकक → पूर्ण .s
// ============================================================
कार्य उत्सर्जक_एकक(शब्दकोश एकक) {
    शब्दकोश बफ = उब_नया();

    // हर कार्य पर regalloc (यदि पहले नहीं हुआ)
    सूची कस = एकक["कार्य_सूची"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(कस)) {
        यदि (कस[इक]["रजि_नियतन"] == शून्यम्) {
            रजि_नियतक_कार्य(कस[इक]);
        }
        उत्_कार्य(बफ, एकक, कस[इक]);
        इक = इक + 1;
    }

    // main प्रविष्टि
    सूची वस = एकक["वैश्विक_सूची"];
    उगपं(बफ, "  .text");
    उगपं(बफ, "  .globl main");
    उगपं(बफ, "  .def main; .scl 2; .type 32; .endef");
    उगपं(बफ, "main:");
    उगपं(बफ, "  pushq %rbp");
    उगपं(बफ, "  movq %rsp, %rbp");
    उगपं(बफ, "  subq $32, %rsp");
    उगपं(बफ, "  call sutra_init_args");
    इक = 0;
    यावत् (इक < लंबाई(वस)) {
        उगपं(बफ, "  leaq sutra_glob_" + वस[इक]["नाम"] + "(%rip), %rcx");
        उगपं(बफ, "  call sutra_gc_push_root");
        इक = इक + 1;
    }
    यदि (एकक["शीर्ष_है"] == सत्य) { उगपं(बफ, "  call __शीर्ष"); }
    यदि (एकक["मुख्य_है"] == सत्य) { उगपं(बफ, "  call sutra_main"); }
    इक = लंबाई(वस) - 1;
    यावत् (इक >= 0) {
        उगपं(बफ, "  leaq sutra_glob_" + वस[इक]["नाम"] + "(%rip), %rcx");
        उगपं(बफ, "  call sutra_gc_pop_root");
        इक = इक - 1;
    }
    उगपं(बफ, "  xorl %eax, %eax");
    उगपं(बफ, "  movq %rbp, %rsp");
    उगपं(बफ, "  popq %rbp");
    उगपं(बफ, "  ret");
    उगपं(बफ, "");

    // .data — वैश्विक चर
    यदि (लंबाई(वस) > 0) {
        उगपं(बफ, "  .data");
        इक = 0;
        यावत् (इक < लंबाई(वस)) {
            उगपं(बफ, "  .globl sutra_glob_" + वस[इक]["नाम"]);
            उगपं(बफ, "sutra_glob_" + वस[इक]["नाम"] + ":");
            उगपं(बफ, "  .quad 0");
            इक = इक + 1;
        }
    }

    // .rdata — पाठ-स्थिरांक
    उगपं(बफ, "  .section .rdata,\"dr\"");
    सूची पस = एकक["पाठ_स्थिरांक"];
    इक = 0;
    यावत् (इक < लंबाई(पस)) {
        उगपं(बफ, ".LC_str_" + इक + ":");
        उगपं(बफ, "  .ascii \"" + उत्_एस्केप(पस[इक]) + "\\0\"");
        उगपं(बफ, ".LC_str_" + इक + "_len:");
        उगपं(बफ, "  .quad " + उत्_बाइट_लंबाई(पस[इक]));
        इक = इक + 1;
    }
    उगपं(बफ, "");

    परत् उब_पाठ(बफ);
}
