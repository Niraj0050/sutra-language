// मध्यम.सूत्र — सूत्र मध्यवर्ती प्रतिनिधित्व (Intermediate Representation)
// ============================================================
// typed SSA। प्रवाह:  AST → [मध्यम] → अनुकूलक → x86-64 / LLVM
//
// यह Phase 1a है — केवल data model + builders + printer। कुछ भी
// संकलक में wire नहीं होता; मूल_संकलन.सूत्र अछूता रहता है।
//
// ---- मान-प्रकार टैग (हर SSA मान का type) ----
//   "पूर्ण"     i64
//   "दशमलव"    f64
//   "पाठ"      string*        (हिडन header [cap][len][utf8][\0])
//   "सूची"     array*
//   "शब्दकोश"  dict*
//   "वस्तु"    object*
//   "बूल"      i1 (i64 के रूप में संग्रहीत)
//   "शून्य"    void  — कोई मान नहीं (statement, या void call)
//   "मान"      dynamic — runtime-typed / boxed (जब static अनुमान विफल)
//
// ---- निर्देश (instruction) — शब्दकोश ----
//   {
//     "कोड":       पाठ            निर्देश-कोड (नीचे सूची)
//     "आईडी":     पूर्ण           SSA परिणाम मान-आईडी  (-1 = कुछ नहीं लौटाता)
//     "प्रकार":   पाठ            परिणाम का प्रकार-टैग
//     "संचालक":  [पूर्ण...]      operand मान-आईडी की सूची
//     "अंश":      शब्दकोश        कोड-विशिष्ट payload (स्थिरांक मान, लक्ष्य नाम, …)
//   }
//
// ---- खंड (basic block) — शब्दकोश ----
//   { "लेबल": पाठ, "फाई": [निर्देश...], "निर्देश": [निर्देश...], "अंत": निर्देश }
//   फाई नोड्स ब्लॉक के आरंभ में अलग सूची में; "अंत" terminator (नीचे)।
//
// ---- फलन — शब्दकोश ----
//   { "नाम": पाठ, "पैरामीटर": [{नाम,प्रकार,आईडी}...], "परत्_प्रकार": पाठ,
//     "खंड_सूची": [खंड...], "अगला_आईडी": पूर्ण, "अगला_लेबल": पूर्ण }
//
// ---- एकक (module) — शब्दकोश ----
//   { "कार्य_सूची": [फलन...], "वैश्विक_सूची": [{नाम,प्रकार}...],
//     "पाठ_स्थिरांक": [पाठ...] }
// ============================================================


// ============================================================
// निर्देश-कोड (opcodes)
// ============================================================
// स्थिरांक:
//   "स्थिर"          अंश:{ "मान_प्रकार":"पूर्ण"/"दशमलव"/"पाठ"/"बूल"/"शून्यम्",
//                          "मान": <literal>,  ("पाठ" के लिए "मान" = string-const index) }
// अंकगणित (परिणाम-प्रकार operands से):
//   "योग" "अंतर" "गुणा" "भाग" "शेष"        संचालक:[अ,ब]
//   "ऋणात्मक"                              संचालक:[अ]
// तुलना (परिणाम "बूल"):
//   "सम" "असम" "लघु" "गुरु" "लघुसम" "गुरुसम"   संचालक:[अ,ब]
// तार्किक (bitwise; operands पहले से बूल):
//   "और" "या"                              संचालक:[अ,ब]
//   "नकार"                                 संचालक:[अ]
//   // टिप्पणी: सूत्र-स्तर पर && / || short-circuit करते हैं — वह
//   // AST→मध्यम (1b) में शाखाओं + फाई से बनता है, यहाँ नहीं।
// स्थानीय चर (mem2reg से पहले):
//   "स्लॉट"          अंश:{"नाम":पाठ}       — एक local slot आरक्षित; परिणाम = handle
//   "पढ़_स्लॉट"      संचालक:[slot]
//   "लिख_स्लॉट"     संचालक:[slot, मान]    परिणाम-प्रकार "शून्य"
// वैश्विक चर:
//   "पढ़_वैश्विक"    अंश:{"नाम":पाठ}
//   "लिख_वैश्विक"   अंश:{"नाम":पाठ}       संचालक:[मान]           परिणाम "शून्य"
// समुच्चय पहुँच:
//   "पढ़_अनुक्रम"    संचालक:[आधार, अनुक्रमणिका]      (arr[i] / dict[k] / str[i])
//   "लिख_अनुक्रम"   संचालक:[आधार, अनुक्रमणिका, मान]  परिणाम "शून्य"
//   "पढ़_क्षेत्र"    अंश:{"क्षेत्र":पाठ}   संचालक:[आधार]           (obj.field)
//   "लिख_क्षेत्र"   अंश:{"क्षेत्र":पाठ}   संचालक:[आधार, मान]      परिणाम "शून्य"
//   "लंबाई"         संचालक:[आधार]
// आवंटन:
//   "नव_पाठ"        संचालक:[बाइट-मान...]  या  अंश:{"स्थिरांक": idx}
//   "नव_सूची"       संचालक:[तत्व...]
//   "नव_शब्दकोश"    संचालक:[कुं1,मा1, कुं2,मा2, ...]
//   "नव_वस्तु"      अंश:{"वर्ग":पाठ}       संचालक:[क्षेत्र-मान...]
// कॉल:
//   "बुलाओ"         अंश:{"लक्ष्य":पाठ}     संचालक:[तर्क...]
//   "अंतर्"         अंश:{"नाम":पाठ}        संचालक:[तर्क...]   (अंतर्_पढ़8 आदि)
//   "विधि_बुलाओ"   अंश:{"वर्ग":पाठ,"विधि":पाठ}   संचालक:[स्व, तर्क...]
// प्रकार:
//   "परिवर्तन"      अंश:{"से":पाठ,"को":पाठ}   संचालक:[मान]   (int↔float, box/unbox)
//   "प्रकार_है"     अंश:{"जाँच":"पाठ"/"शब्दकोश"/…}  संचालक:[मान]   परिणाम "बूल"
// SSA:
//   "फाई"          अंश:{"स्रोत":[[लेबल,आईडी]...]}
// टर्मिनेटर (खंड["अंत"] में):
//   "वापस"         संचालक:[मान] या []
//   "जाओ"          अंश:{"लक्ष्य":लेबल}
//   "यदि_जाओ"      संचालक:[शर्त]   अंश:{"सत्य":लेबल,"असत्य":लेबल}
//   "फेंको"        संचालक:[अपवाद]
//   "अगम्य"        — unreachable (कोई terminator नहीं होना चाहिए यहाँ)
// अपवाद (आरक्षित — 1b/बाद में wire):
//   "पकड़_आरंभ" "पकड़_अंत"


// ============================================================
// निर्माता (builders)
// ============================================================

कार्य मध्यम_नव_एकक() {
    शब्दकोश ए = {};
    ए["कार्य_सूची"] = [];
    ए["वैश्विक_सूची"] = [];
    ए["पाठ_स्थिरांक"] = [];
    परत् ए;
}

// एकक में पाठ-स्थिरांक जोड़ो (deduplicate), उसका अनुक्रमांक लौटाओ
कार्य मध्यम_पाठ_स्थिरांक(शब्दकोश एकक, पाठ मानः) {
    सूची तालिका = एकक["पाठ_स्थिरांक"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(तालिका)) {
        यदि (तालिका[सूचक] == मानः) { परत् सूचक; }
        सूचक = सूचक + 1;
    }
    एकक["पाठ_स्थिरांक"] = जोड़ें(तालिका, मानः);
    परत् लंबाई(तालिका);
}

कार्य मध्यम_नव_कार्य(पाठ नाम, पाठ परत्_प्रकार) {
    शब्दकोश क = {};
    क["नाम"] = नाम;
    क["परत्_प्रकार"] = परत्_प्रकार;
    क["पैरामीटर"] = [];
    क["खंड_सूची"] = [];
    क["अगला_आईडी"] = 0;
    क["अगला_लेबल"] = 0;
    परत् क;
}

कार्य मध्यम_ताजा_आईडी(शब्दकोश फलन) {
    संख्या नत = फलन["अगला_आईडी"];
    फलन["अगला_आईडी"] = नत + 1;
    परत् नत;
}

// पैरामीटर जोड़ो — उसका SSA मान-आईडी लौटाओ
कार्य मध्यम_पैरामीटर(शब्दकोश फलन, पाठ नाम, पाठ प्रकार) {
    संख्या आईडी = मध्यम_ताजा_आईडी(फलन);
    शब्दकोश प = {};
    प["नाम"] = नाम;
    प["प्रकार"] = प्रकार;
    प["आईडी"] = आईडी;
    फलन["पैरामीटर"] = जोड़ें(फलन["पैरामीटर"], प);
    परत् आईडी;
}

// नया खंड — फलन में जोड़ो, उसे लौटाओ
कार्य मध्यम_नव_खंड(शब्दकोश फलन, पाठ संकेत) {
    संख्या नत = फलन["अगला_लेबल"];
    फलन["अगला_लेबल"] = नत + 1;
    शब्दकोश ख = {};
    ख["लेबल"] = संकेत + "_" + नत;
    ख["फाई"] = [];
    ख["निर्देश"] = [];
    ख["अंत"] = शून्यम्;
    फलन["खंड_सूची"] = जोड़ें(फलन["खंड_सूची"], ख);
    परत् ख;
}

// निर्देश बनाओ (helper — सीधे उपयोग कम, नीचे wrappers)
कार्य मध्यम_निर्देश_बनाओ(पाठ कोड, संख्या आईडी, पाठ प्रकार, सूची संचालक, शब्दकोश अंश) {
    शब्दकोश नत = {};
    नत["कोड"] = कोड;
    नत["आईडी"] = आईडी;
    नत["प्रकार"] = प्रकार;
    नत["संचालक"] = संचालक;
    नत["अंश"] = अंश;
    परत् नत;
}

// मान-उत्पादक निर्देश खंड में जोड़ो — नया SSA आईडी लौटाओ
कार्य मध्यम_जोड़(शब्दकोश फलन, शब्दकोश खंड, पाठ कोड, पाठ प्रकार, सूची संचालक, शब्दकोश अंश) {
    संख्या आईडी = मध्यम_ताजा_आईडी(फलन);
    शब्दकोश नत = मध्यम_निर्देश_बनाओ(कोड, आईडी, प्रकार, संचालक, अंश);
    खंड["निर्देश"] = जोड़ें(खंड["निर्देश"], नत);
    परत् आईडी;
}

// प्रभाव-मात्र निर्देश (लिख_*, कॉल void) — आईडी = -1
कार्य मध्यम_जोड़_प्रभाव(शब्दकोश खंड, पाठ कोड, सूची संचालक, शब्दकोश अंश) {
    शब्दकोश नत = मध्यम_निर्देश_बनाओ(कोड, 0 - 1, "शून्य", संचालक, अंश);
    खंड["निर्देश"] = जोड़ें(खंड["निर्देश"], नत);
    परत् 0;
}

// फाई नोड खंड के आरंभ में — नया SSA आईडी लौटाओ
कार्य मध्यम_फाई(शब्दकोश फलन, शब्दकोश खंड, पाठ प्रकार, सूची स्रोत) {
    संख्या आईडी = मध्यम_ताजा_आईडी(फलन);
    शब्दकोश अंश = {};
    अंश["स्रोत"] = स्रोत;   // [[लेबल, मान-आईडी], ...]
    शब्दकोश नत = मध्यम_निर्देश_बनाओ("फाई", आईडी, प्रकार, [], अंश);
    खंड["फाई"] = जोड़ें(खंड["फाई"], नत);
    परत् आईडी;
}

// ---- terminators ----
कार्य मध्यम_वापस(शब्दकोश खंड, संख्या मान_आईडी) {
    सूची संचालक = [];
    यदि (मान_आईडी >= 0) { संचालक = [मान_आईडी]; }
    खंड["अंत"] = मध्यम_निर्देश_बनाओ("वापस", 0 - 1, "शून्य", संचालक, {});
    परत् 0;
}
कार्य मध्यम_जाओ(शब्दकोश खंड, पाठ लक्ष्य) {
    शब्दकोश अंश = {};
    अंश["लक्ष्य"] = लक्ष्य;
    खंड["अंत"] = मध्यम_निर्देश_बनाओ("जाओ", 0 - 1, "शून्य", [], अंश);
    परत् 0;
}
कार्य मध्यम_यदि_जाओ(शब्दकोश खंड, संख्या शर्त_आईडी, पाठ सत्य_लेबल, पाठ असत्य_लेबल) {
    शब्दकोश अंश = {};
    अंश["सत्य"] = सत्य_लेबल;
    अंश["असत्य"] = असत्य_लेबल;
    खंड["अंत"] = मध्यम_निर्देश_बनाओ("यदि_जाओ", 0 - 1, "शून्य", [शर्त_आईडी], अंश);
    परत् 0;
}
कार्य मध्यम_फेंको(शब्दकोश खंड, संख्या अपवाद_आईडी) {
    खंड["अंत"] = मध्यम_निर्देश_बनाओ("फेंको", 0 - 1, "शून्य", [अपवाद_आईडी], {});
    परत् 0;
}


// ============================================================
// सुविधा-निर्माता (common opcodes)
// ============================================================

कार्य मध्यम_स्थिर_पूर्ण(शब्दकोश फलन, शब्दकोश खंड, संख्या मानः) {
    शब्दकोश अंश = {};
    अंश["मान_प्रकार"] = "पूर्ण";
    अंश["मान"] = मानः;
    परत् मध्यम_जोड़(फलन, खंड, "स्थिर", "पूर्ण", [], अंश);
}
कार्य मध्यम_स्थिर_बूल(शब्दकोश फलन, शब्दकोश खंड, मान मानः) {
    शब्दकोश अंश = {};
    अंश["मान_प्रकार"] = "बूल";
    अंश["मान"] = मानः;
    परत् मध्यम_जोड़(फलन, खंड, "स्थिर", "बूल", [], अंश);
}
कार्य मध्यम_स्थिर_शून्यम्(शब्दकोश फलन, शब्दकोश खंड) {
    शब्दकोश अंश = {};
    अंश["मान_प्रकार"] = "शून्यम्";
    परत् मध्यम_जोड़(फलन, खंड, "स्थिर", "मान", [], अंश);
}
// पाठ-साहित्य: एकक की स्थिरांक-तालिका में डालकर अनुक्रमांक store करो
कार्य मध्यम_स्थिर_पाठ(शब्दकोश एकक, शब्दकोश फलन, शब्दकोश खंड, पाठ मानः) {
    संख्या अनु = मध्यम_पाठ_स्थिरांक(एकक, मानः);
    शब्दकोश अंश = {};
    अंश["मान_प्रकार"] = "पाठ";
    अंश["मान"] = अनु;
    परत् मध्यम_जोड़(फलन, खंड, "स्थिर", "पाठ", [], अंश);
}

कार्य मध्यम_द्विआधारी(शब्दकोश फलन, शब्दकोश खंड, पाठ कोड, पाठ प्रकार, संख्या अ, संख्या ब) {
    परत् मध्यम_जोड़(फलन, खंड, कोड, प्रकार, [अ, ब], {});
}
कार्य मध्यम_तुलना(शब्दकोश फलन, शब्दकोश खंड, पाठ कोड, संख्या अ, संख्या ब) {
    परत् मध्यम_जोड़(फलन, खंड, कोड, "बूल", [अ, ब], {});
}

कार्य मध्यम_स्लॉट(शब्दकोश फलन, शब्दकोश खंड, पाठ नाम) {
    शब्दकोश अंश = {};
    अंश["नाम"] = नाम;
    परत् मध्यम_जोड़(फलन, खंड, "स्लॉट", "मान", [], अंश);
}
कार्य मध्यम_पढ़_स्लॉट(शब्दकोश फलन, शब्दकोश खंड, पाठ प्रकार, संख्या स्लॉट) {
    परत् मध्यम_जोड़(फलन, खंड, "पढ़_स्लॉट", प्रकार, [स्लॉट], {});
}
कार्य मध्यम_लिख_स्लॉट(शब्दकोश खंड, संख्या स्लॉट, संख्या मानः) {
    परत् मध्यम_जोड़_प्रभाव(खंड, "लिख_स्लॉट", [स्लॉट, मानः], {});
}

कार्य मध्यम_बुलाओ(शब्दकोश फलन, शब्दकोश खंड, पाठ लक्ष्य, पाठ परत्_प्रकार, सूची तर्क) {
    शब्दकोश अंश = {};
    अंश["लक्ष्य"] = लक्ष्य;
    परत् मध्यम_जोड़(फलन, खंड, "बुलाओ", परत्_प्रकार, तर्क, अंश);
}
कार्य मध्यम_अंतर्(शब्दकोश फलन, शब्दकोश खंड, पाठ नाम, पाठ परत्_प्रकार, सूची तर्क) {
    शब्दकोश अंश = {};
    अंश["नाम"] = नाम;
    परत् मध्यम_जोड़(फलन, खंड, "अंतर्", परत्_प्रकार, तर्क, अंश);
}


// ============================================================
// मुद्रक (pretty-printer) — debugging
// ============================================================

कार्य मध्यम_मान_नाम(संख्या आईडी) {
    यदि (आईडी < 0) { परत् "_"; }
    परत् "v" + आईडी;
}

कार्य मध्यम_संचालक_सूची(सूची संचालक) {
    पाठ स = "";
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(संचालक)) {
        यदि (सूचक > 0) { स = स + ", "; }
        स = स + मध्यम_मान_नाम(संचालक[सूचक]);
        सूचक = सूचक + 1;
    }
    परत् स;
}

कार्य मध्यम_अंश_सार(शब्दकोश निर्देश) {
    पाठ कोड = निर्देश["कोड"];
    शब्दकोश अंश = निर्देश["अंश"];
    यदि (कोड == "स्थिर") {
        पाठ मप = अंश["मान_प्रकार"];
        यदि (मप == "शून्यम्") { परत् " शून्यम्"; }
        परत् " " + मप + ":" + अंश["मान"];
    }
    यदि (कोड == "बुलाओ") { परत् " @" + अंश["लक्ष्य"]; }
    यदि (कोड == "अंतर्") { परत् " #" + अंश["नाम"]; }
    यदि (कोड == "विधि_बुलाओ") { परत् " " + अंश["वर्ग"] + "." + अंश["विधि"]; }
    यदि (कोड == "पढ़_वैश्विक" || कोड == "लिख_वैश्विक" || कोड == "स्लॉट") { परत् " " + अंश["नाम"]; }
    यदि (कोड == "पढ़_क्षेत्र" || कोड == "लिख_क्षेत्र") { परत् " ." + अंश["क्षेत्र"]; }
    यदि (कोड == "नव_वस्तु") { परत् " " + अंश["वर्ग"]; }
    यदि (कोड == "प्रकार_है") { परत् " " + अंश["जाँच"]; }
    यदि (कोड == "परिवर्तन") { परत् " " + अंश["से"] + "->" + अंश["को"]; }
    यदि (कोड == "जाओ") { परत् " " + अंश["लक्ष्य"]; }
    यदि (कोड == "यदि_जाओ") { परत् " ? " + अंश["सत्य"] + " : " + अंश["असत्य"]; }
    परत् "";
}

कार्य मध्यम_निर्देश_पंक्ति(शब्दकोश निर्देश) {
    पाठ स = "    ";
    संख्या आईडी = निर्देश["आईडी"];
    यदि (आईडी >= 0) {
        स = स + मध्यम_मान_नाम(आईडी) + " = ";
    }
    स = स + निर्देश["कोड"];
    पाठ ऑप्स = मध्यम_संचालक_सूची(निर्देश["संचालक"]);
    यदि (ऑप्स != "") { स = स + " " + ऑप्स; }
    स = स + मध्यम_अंश_सार(निर्देश);
    यदि (आईडी >= 0 && निर्देश["प्रकार"] != "शून्य") {
        स = स + "  : " + निर्देश["प्रकार"];
    }
    परत् स;
}

कार्य मध्यम_फाई_पंक्ति(शब्दकोश निर्देश) {
    पाठ स = "    " + मध्यम_मान_नाम(निर्देश["आईडी"]) + " = फाई";
    सूची स्रोत = निर्देश["अंश"]["स्रोत"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(स्रोत)) {
        यदि (सूचक > 0) { स = स + ","; }
        स = स + " [" + स्रोत[सूचक][0] + ": " + मध्यम_मान_नाम(स्रोत[सूचक][1]) + "]";
        सूचक = सूचक + 1;
    }
    स = स + "  : " + निर्देश["प्रकार"];
    परत् स;
}

कार्य मध्यम_छापो_कार्य(शब्दकोश फलन) {
    पाठ स = "फलन " + फलन["नाम"] + "(";
    सूची पैरा = फलन["पैरामीटर"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(पैरा)) {
        यदि (सूचक > 0) { स = स + ", "; }
        स = स + मध्यम_मान_नाम(पैरा[सूचक]["आईडी"]) + ": " + पैरा[सूचक]["प्रकार"];
        सूचक = सूचक + 1;
    }
    स = स + ") -> " + फलन["परत्_प्रकार"] + " {" + अक्षर_निर्माण(10);

    सूची खंड_सूची = फलन["खंड_सूची"];
    संख्या ख_सूचक = 0;
    यावत् (ख_सूचक < लंबाई(खंड_सूची)) {
        शब्दकोश खंड = खंड_सूची[ख_सूचक];
        स = स + "  " + खंड["लेबल"] + ":" + अक्षर_निर्माण(10);

        सूची फाई_सूची = खंड["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फाई_सूची)) {
            स = स + मध्यम_फाई_पंक्ति(फाई_सूची[फ]) + अक्षर_निर्माण(10);
            फ = फ + 1;
        }
        सूची निर्देश_सूची = खंड["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निर्देश_सूची)) {
            स = स + मध्यम_निर्देश_पंक्ति(निर्देश_सूची[नि]) + अक्षर_निर्माण(10);
            नि = नि + 1;
        }
        यदि (खंड["अंत"] != शून्यम्) {
            स = स + मध्यम_निर्देश_पंक्ति(खंड["अंत"]) + अक्षर_निर्माण(10);
        } अन्यथा {
            स = स + "    ; <कोई terminator नहीं>" + अक्षर_निर्माण(10);
        }
        ख_सूचक = ख_सूचक + 1;
    }
    स = स + "}" + अक्षर_निर्माण(10);
    परत् स;
}

कार्य मध्यम_छापो_एकक(शब्दकोश एकक) {
    पाठ स = "";
    सूची पस = एकक["पाठ_स्थिरांक"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(पस)) {
        स = स + "पाठ_स्थिरांक[" + सूचक + "] = \"" + पस[सूचक] + "\"" + अक्षर_निर्माण(10);
        सूचक = सूचक + 1;
    }
    सूची कस = एकक["कार्य_सूची"];
    संख्या क = 0;
    यावत् (क < लंबाई(कस)) {
        स = स + अक्षर_निर्माण(10) + मध्यम_छापो_कार्य(कस[क]);
        क = क + 1;
    }
    परत् स;
}
