कार्य स्थिर_तह(शब्दकोश फलन) {
    // value-id -> स्थिर निर्देश (केवल पूर्ण/बूल)
    शब्दकोश स्थिरांक = {};
    // बीजगणितीय renames — पढ़ते समय अनु_हल से resolve, apply अंत में एक बार
    शब्दकोश पुनर्नाम = {};
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        सूची खस = फलन["खंड_सूची"];
        संख्या ख = 0;
        यावत् (ख < लंबाई(खस)) {
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = 0;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश निर्देश = निस[नि];
                पाठ कोड = निर्देश["कोड"];
                यदि (कोड == "स्थिर") {
                    मान मप = निर्देश["अंश"]["मान_प्रकार"];
                    यदि (मप == "पूर्ण" || मप == "बूल") {
                        स्थिरांक[निर्देश["आईडी"]] = निर्देश;
                    }
                } अन्यथा यदि (स्थिर_तह_योग्य(कोड)) {
                    सूची संच = निर्देश["संचालक"];
                    यदि (लंबाई(संच) == 2) {
                        संख्या ओ0 = अनु_हल(पुनर्नाम, संच[0]);
                        संख्या ओ1 = अनु_हल(पुनर्नाम, संच[1]);
                        मान अ = स्थिरांक[ओ0];
                        मान ब = स्थिरांक[ओ1];
                        यदि (अ != शून्यम् && ब != शून्यम्) {
                            मान नया_मान = स्थिर_गणना(कोड, अ["अंश"]["मान"], ब["अंश"]["मान"]);
                            यदि (नया_मान != शून्यम्) {
                                स्थिर_में_बदलो(निर्देश, स्थिर_परिणाम_प्रकार(कोड), नया_मान);
                                स्थिरांक[निर्देश["आईडी"]] = निर्देश;
                                बदला = सत्य;
                            }
                        } अन्यथा {
                            // बीजगणितीय सरलीकरण: एक operand स्थिर
                            संख्या अन्य = बीज_सरल(निर्देश, कोड, अ, ब, [ओ0, ओ1]);
                            यदि (अन्य >= 1) {
                                पुनर्नाम[निर्देश["आईडी"]] = अन्य;
                                निर्देश["कोड"] = "अमृत";   // no-op — DCE हटाएगा; पुनः-trigger न हो
                                निर्देश["संचालक"] = [];
                                बदला = सत्य;
                            }
                        }
                    }
                } अन्यथा यदि (कोड == "ऋणात्मक" || कोड == "नकार") {
                    सूची संच = निर्देश["संचालक"];
                    यदि (लंबाई(संच) == 1) {
                        मान अ = स्थिरांक[अनु_हल(पुनर्नाम, संच[0])];
                        यदि (अ != शून्यम्) {
                            मान अमान = अ["अंश"]["मान"];
                            यदि (कोड == "ऋणात्मक") {
                                स्थिर_में_बदलो(निर्देश, "पूर्ण", 0 - अमान);
                            } अन्यथा {
                                संख्या नप = 0;
                                यदि (अमान == 0 || अमान == असत्य) { नप = 1; }
                                स्थिर_में_बदलो(निर्देश, "बूल", नप);
                            }
                            स्थिरांक[निर्देश["आईडी"]] = निर्देश;
                            बदला = सत्य;
                        }
                    }
                } अन्यथा यदि (कोड == "अंतर्" && बिट_अंतर्_है(निर्देश)) {
                    पाठ बनाम = निर्देश["अंश"]["नाम"];
                    सूची संच = निर्देश["संचालक"];
                    संख्या चाहिए = 2;
                    यदि (बनाम == "अंतर्_बिट_उलट") { चाहिए = 1; }
                    यदि (लंबाई(संच) == चाहिए) {
                        मान अ = स्थिरांक[अनु_हल(पुनर्नाम, संच[0])];
                        मान ब = शून्यम्;
                        यदि (चाहिए == 2) { ब = स्थिरांक[अनु_हल(पुनर्नाम, संच[1])]; }
                        मान तैयार = असत्य;
                        यदि (चाहिए == 1 && अ != शून्यम्) { तैयार = सत्य; }
                        यदि (चाहिए == 2 && अ != शून्यम् && ब != शून्यम्) { तैयार = सत्य; }
                        यदि (तैयार) {
                            संख्या बमान = 0;
                            यदि (ब != शून्यम्) { बमान = ब["अंश"]["मान"]; }
                            मान नम = स्थिर_गणना_बिट(बनाम, अ["अंश"]["मान"], बमान);
                            यदि (नम != शून्यम्) {
                                स्थिर_में_बदलो(निर्देश, "पूर्ण", नम);
                                स्थिरांक[निर्देश["आईडी"]] = निर्देश;
                                बदला = सत्य;
                            }
                        }
                    }
                }
                नि = नि + 1;
            }
            ख = ख + 1;
        }
    }
    अनु_बहु_बदलो(फलन, पुनर्नाम);
    परत् 0;
}

// निर्देश को जगह पर स्थिर-निर्देश में बदलो (fold का साझा भाग)
कार्य स्थिर_में_बदलो(शब्दकोश निर्देश, पाठ मप, मान मानः) {
    निर्देश["कोड"] = "स्थिर";
    शब्दकोश नअंश = {};
    नअंश["मान_प्रकार"] = मप;
    नअंश["मान"] = मानः;
    निर्देश["अंश"] = नअंश;
    निर्देश["संचालक"] = [];
    निर्देश["प्रकार"] = मप;
    परत् 0;
}

// क्या यह अंतर्-निर्देश एक बिटवार बिल्टिन है (§3a)?
कार्य बिट_अंतर्_है(शब्दकोश निर्देश) {
    यदि (निर्देश["अंश"] == शून्यम्) { परत् असत्य; }
    पाठ बनाम = निर्देश["अंश"]["नाम"];
    परत् बनाम == "अंतर्_बिट_और" || बनाम == "अंतर्_बिट_या" || बनाम == "अंतर्_बिट_भेद"
        || बनाम == "अंतर्_बिट_उलट" || बनाम == "अंतर्_बाम_सरक" || बनाम == "अंतर्_दक्षिण_सरक";
}

// बिटवार बिल्टिन का संकलन-काल मूल्यांकन (§3a/§3b से बिट_* बिल्टिन उपलब्ध)
कार्य स्थिर_गणना_बिट(पाठ नाम, संख्या अ, संख्या ब) {
    यदि (नाम == "अंतर्_बिट_और") { परत् बिट_और(अ, ब); }
    यदि (नाम == "अंतर्_बिट_या") { परत् बिट_या(अ, ब); }
    यदि (नाम == "अंतर्_बिट_भेद") { परत् बिट_भेद(अ, ब); }
    यदि (नाम == "अंतर्_बिट_उलट") { परत् बिट_उलट(अ); }
    यदि (नाम == "अंतर्_बाम_सरक") { परत् बाम_सरक(अ, ब); }
    यदि (नाम == "अंतर्_दक्षिण_सरक") { परत् दक्षिण_सरक(अ, ब); }
    परत् शून्यम्;
}

// एक operand स्थिर → दूसरे operand की value-id लौटाओ (कोई नहीं तो -1)
// x+0, 0+x, x-0, x*1, 1*x  →  x
कार्य बीज_सरल(शब्दकोश निर्देश, पाठ कोड, मान अ_स्थिर, मान ब_स्थिर, सूची संच) {
    // पूर्व-मौजूद bug (§4a से नहीं, यहीं मिला): x+0→x जैसी पहचान केवल शुद्ध
    // पूर्णांक-अंकगणित पर सच है। "विधि" गतिशील/पाठ हो तो योग वास्तव में
    // पाठ_योग_गतिक (या दशमलव जोड़) है — वहाँ ब=0 केवल हटाया नहीं जा सकता
    // (उदा॰ "x" + 0 = "x0", "x" नहीं)। निम्नक हर द्विआधारी पर "विधि" डालता
    // (मूल_निम्नक.सूत्र निम्नक_द्विआधारी) — बिना विधि (शून्यम्) को भी असुरक्षित मानो।
    मान विधि = निर्देश["अंश"]["विधि"];
    यदि (विधि != "पूर्ण") { परत् 0 - 1; }
    // अ स्थिर?
    यदि (अ_स्थिर != शून्यम्) {
        संख्या अ_मान = अ_स्थिर["अंश"]["मान"];
        यदि (कोड == "योग" && अ_मान == 0) { परत् संच[1]; }
        यदि (कोड == "गुणा" && अ_मान == 1) { परत् संच[1]; }
    }
    यदि (ब_स्थिर != शून्यम्) {
        संख्या ब_मान = ब_स्थिर["अंश"]["मान"];
        यदि (कोड == "योग" && ब_मान == 0) { परत् संच[0]; }
        यदि (कोड == "अंतर" && ब_मान == 0) { परत् संच[0]; }
        यदि (कोड == "गुणा" && ब_मान == 1) { परत् संच[0]; }
    }
    परत् 0 - 1;
}

कार्य स्थिर_तह_योग्य(पाठ कोड) {
    परत् कोड == "योग" || कोड == "अंतर" || कोड == "गुणा" || कोड == "भाग" || कोड == "शेष"
        || कोड == "सम" || कोड == "असम" || कोड == "लघु" || कोड == "गुरु"
        || कोड == "लघुसम" || कोड == "गुरुसम" || कोड == "और" || कोड == "या";
}

कार्य स्थिर_परिणाम_प्रकार(पाठ कोड) {
    यदि (कोड == "योग" || कोड == "अंतर" || कोड == "गुणा" || कोड == "भाग" || कोड == "शेष") {
        परत् "पूर्ण";
    }
    परत् "बूल";
}

कार्य स्थिर_गणना(पाठ कोड, संख्या अ, संख्या ब) {
    यदि (कोड == "योग") { परत् अ + ब; }
    यदि (कोड == "अंतर") { परत् अ - ब; }
    यदि (कोड == "गुणा") { परत् अ * ब; }
    यदि (कोड == "भाग") { यदि (ब == 0) { परत् शून्यम्; } परत् अ / ब; }
    यदि (कोड == "शेष") { यदि (ब == 0) { परत् शून्यम्; } परत् अ % ब; }
    यदि (कोड == "सम") { यदि (अ == ब) { परत् 1; } परत् 0; }
    यदि (कोड == "असम") { यदि (अ != ब) { परत् 1; } परत् 0; }
    यदि (कोड == "लघु") { यदि (अ < ब) { परत् 1; } परत् 0; }
    यदि (कोड == "गुरु") { यदि (अ > ब) { परत् 1; } परत् 0; }
    यदि (कोड == "लघुसम") { यदि (अ <= ब) { परत् 1; } परत् 0; }
    यदि (कोड == "गुरुसम") { यदि (अ >= ब) { परत् 1; } परत् 0; }
    यदि (कोड == "और") { यदि (अ != 0 && ब != 0) { परत् 1; } परत् 0; }
    यदि (कोड == "या") { यदि (अ != 0 || ब != 0) { परत् 1; } परत् 0; }
    परत् शून्यम्;
}


// ============================================================
// DCE — मृत निर्देश + अगम्य खंड
// ============================================================

कार्य क्या_दुष्प्रभावी(पाठ कोड) {
    परत् कोड == "लिख_स्लॉट" || कोड == "लिख_वैश्विक" || कोड == "लिख_अनुक्रम"
        || कोड == "लिख_क्षेत्र" || कोड == "बुलाओ" || कोड == "अंतर्"
        || कोड == "विधि_बुलाओ" || कोड == "नव_पाठ" || कोड == "नव_सूची"
        || कोड == "नव_शब्दकोश" || कोड == "नव_वस्तु";
}

// फाई-मान जीवित हैं या नहीं — असली (non-फाई) उपयोग से mark-sweep।
// roots = हर non-फाई निर्देश-संचालक + हर टर्मिनेटर-संचालक; फिर जीवित फाई के
// स्रोत-मान traverse। जो फाई इस तरह न पहुँचे — मृत (भले ही कोई दूसरा मृत
// फाई उसे reference करे)।
कार्य अनु_फाई_जीवित(शब्दकोश फलन) {
    सूची खस = फलन["खंड_सूची"];
    // फाई-आईडी → स्रोत-मान-सूची
    शब्दकोश फाई_स्रोत = {};
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            सूची इड = [];
            सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
            संख्या ज = 0;
            यावत् (ज < लंबाई(स्रोत)) {
                यदि (स्रोत[ज][1] >= 1) { इड = जोड़ें(इड, स्रोत[ज][1]); }
                ज = ज + 1;
            }
            फाई_स्रोत[फस[फ]["आईडी"]] = इड;
            फ = फ + 1;
        }
        ख = ख + 1;
    }
    // roots: non-फाई निर्देश + टर्मिनेटर संचालक
    सूची कार्यसूची = [];
    ख = 0;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        सूची निस = खंड["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            सूची संच = निस[नि]["संचालक"];
            संख्या स = 0;
            यावत् (स < लंबाई(संच)) {
                यदि (संच[स] >= 1) { कार्यसूची = जोड़ें(कार्यसूची, संच[स]); }
                स = स + 1;
            }
            नि = नि + 1;
        }
        यदि (खंड["अंत"] != शून्यम्) {
            सूची संचत = खंड["अंत"]["संचालक"];
            संख्या सत = 0;
            यावत् (सत < लंबाई(संचत)) {
                यदि (संचत[सत] >= 1) { कार्यसूची = जोड़ें(कार्यसूची, संचत[सत]); }
                सत = सत + 1;
            }
        }
        ख = ख + 1;
    }
    शब्दकोश जीवित = {};
    संख्या कप = 0;
    यावत् (कप < लंबाई(कार्यसूची)) {
        संख्या व = कार्यसूची[कप];
        कप = कप + 1;
        यदि (जीवित[व] != सत्य) {
            जीवित[व] = सत्य;
            मान स्रोत = फाई_स्रोत[व];
            यदि (स्रोत != शून्यम्) {
                संख्या ज = 0;
                यावत् (ज < लंबाई(स्रोत)) {
                    कार्यसूची = जोड़ें(कार्यसूची, स्रोत[ज]);
                    ज = ज + 1;
                }
            }
        }
    }
    परत् जीवित;
}

कार्य मृत_कोड_हटाओ(शब्दकोश फलन) {
    // 1. अगम्य खंड
    सूची क्रम = अनु_विपक्रम(फलन);
    शब्दकोश पहुँच = {};
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(क्रम)) {
        पहुँच[क्रम[सूचक]] = सत्य;
        सूचक = सूचक + 1;
    }
    सूची नए_खंड = [];
    सूची खस = फलन["खंड_सूची"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(खस)) {
        यदि (पहुँच[खस[सूचक]["लेबल"]] == सत्य) {
            नए_खंड = जोड़ें(नए_खंड, खस[सूचक]);
        }
        सूचक = सूचक + 1;
    }
    फलन["खंड_सूची"] = नए_खंड;

    // 2. मृत निर्देश (fixpoint)
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        शब्दकोश उपयोग = अनु_उपयोग_गणना(फलन);
        // फाई-जीवितता mark-sweep — असली (non-फाई) उपयोग से शुरू, फाई→फाई
        // कड़ियाँ traverse। केवल use-गणना काफ़ी नहीं: दो मृत फाई एक-दूसरे को
        // reference करें (लूप-वेरिएबल जो header में merge हो पर बाहर मृत) तो
        // दोनों की गिनती > 0 रहती — अमान्य SSA चक्र emitter तक पहुँच जाता।
        शब्दकोश फाई_जीवित = अनु_फाई_जीवित(फलन);
        खस = फलन["खंड_सूची"];
        संख्या ख = 0;
        यावत् (ख < लंबाई(खस)) {
            शब्दकोश खंड = खस[ख];
            // फाई
            सूची नई_फाई = [];
            संख्या फस_इ = 0;
            यावत् (फस_इ < लंबाई(खंड["फाई"])) {
                शब्दकोश फनोड = खंड["फाई"][फस_इ];
                यदि (फाई_जीवित[फनोड["आईडी"]] == सत्य) {
                    नई_फाई = जोड़ें(नई_फाई, फनोड);
                } अन्यथा { बदला = सत्य; }
                फस_इ = फस_इ + 1;
            }
            खंड["फाई"] = नई_फाई;
            // निर्देश
            सूची नई_निर्देश = [];
            संख्या नि = 0;
            यावत् (नि < लंबाई(खंड["निर्देश"])) {
                शब्दकोश निर = खंड["निर्देश"][नि];
                मान गिनती = उपयोग[निर["आईडी"]];
                यदि (गिनती == शून्यम्) { गिनती = 0; }
                यदि (क्या_दुष्प्रभावी(निर["कोड"]) || गिनती > 0) {
                    नई_निर्देश = जोड़ें(नई_निर्देश, निर);
                } अन्यथा { बदला = सत्य; }
                नि = नि + 1;
            }
            खंड["निर्देश"] = नई_निर्देश;
            ख = ख + 1;
        }
    }
    परत् 0;
}

कार्य अनु_उपयोग_गणना(शब्दकोश फलन) {
    शब्दकोश गिन = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        अनु_गिनो_निर्देश_सूची(खंड["फाई"], गिन);
        अनु_गिनो_निर्देश_सूची(खंड["निर्देश"], गिन);
        यदि (खंड["अंत"] != शून्यम्) {
            अनु_गिनो_एक(खंड["अंत"], गिन);
        }
        ख = ख + 1;
    }
    परत् गिन;
}

कार्य अनु_गिनो_निर्देश_सूची(सूची निस, शब्दकोश गिन) {
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(निस)) {
        अनु_गिनो_एक(निस[सूचक], गिन);
        सूचक = सूचक + 1;
    }
    परत् 0;
}

कार्य अनु_गिनो_एक(शब्दकोश निर्देश, शब्दकोश गिन) {
    सूची संच = निर्देश["संचालक"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(संच)) {
        संख्या वक = संच[सूचक];
        मान गक = गिन[वक];
        यदि (गक == शून्यम्) { गिन[वक] = 1; }
        अन्यथा { गिन[वक] = गक + 1; }
        सूचक = सूचक + 1;
    }
    यदि (निर्देश["कोड"] == "फाई") {
        सूची स्रोत = निर्देश["अंश"]["स्रोत"];
        सूचक = 0;
        यावत् (सूचक < लंबाई(स्रोत)) {
            संख्या वक = स्रोत[सूचक][1];
            मान गक = गिन[वक];
            यदि (गक == शून्यम्) { गिन[वक] = 1; }
            अन्यथा { गिन[वक] = गक + 1; }
            सूचक = सूचक + 1;
        }
    }
    परत् 0;
}


// ============================================================
// जाओ_सरल — jump-to-jump threading (खाली if/elif-join खंड हटाना)
//
// if/elif chain का हर खंड `जाओ if_अंत_N` से खत्म होता, और `if_अंत_N`
// अक्सर खुद सिर्फ़ `जाओ if_अंत_(N-1)` होता — pure chain, कोई काम नहीं।
// जो खंड किसी फाई का स्रोत-लेबल नहीं (कोई value वहाँ merge नहीं होता),
// उसे transitively बायपास करना safe है — DCE बाद में उसे हटा देगा।
// (फाई-referenced खंड को कभी नहीं छूता — value-merge ambiguity से बचने को।)
// ============================================================

// हर वह लेबल जो कहीं भी किसी फाई का स्रोत है — इन खंडों को मत छुओ
कार्य जाओ_सरल_फाई_लेबल(शब्दकोश फलन) {
    शब्दकोश सेट = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
            संख्या ज = 0;
            यावत् (ज < लंबाई(स्रोत)) {
                सेट[स्रोत[ज][0]] = सत्य;
                ज = ज + 1;
            }
            फ = फ + 1;
        }
        ख = ख + 1;
    }
    परत् सेट;
}

// खंड सचमुच खाली + बिना-शर्त जाओ है, और किसी फाई का स्रोत नहीं?
कार्य जाओ_सरल_तुच्छ_है(शब्दकोश खंड, शब्दकोश फाई_लेबल) {
    यदि (लंबाई(खंड["फाई"]) > 0 || लंबाई(खंड["निर्देश"]) > 0) { परत् असत्य; }
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम् || अंत["कोड"] != "जाओ") { परत् असत्य; }
    यदि (फाई_लेबल[खंड["लेबल"]] == सत्य) { परत् असत्य; }
    परत् सत्य;
}

// लेबल को transitively उसके असली गंतव्य तक हल करो (चक्र-सुरक्षा सहित)
कार्य जाओ_सरल_हल(शब्दकोश फलन, शब्दकोश फाई_लेबल, पाठ लेबल) {
    पाठ वर्त = लेबल;
    शब्दकोश देखे = {};
    संख्या रक्षक = 0;
    यावत् (रक्षक < 10000) {
        यदि (देखे[वर्त] == सत्य) { परत् वर्त; }   // चक्र — जहाँ हैं वहीं रुको
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, वर्त);
        यदि (खंड == शून्यम् || न जाओ_सरल_तुच्छ_है(खंड, फाई_लेबल)) { परत् वर्त; }
        देखे[वर्त] = सत्य;
        वर्त = खंड["अंत"]["अंश"]["लक्ष्य"];
        रक्षक = रक्षक + 1;
    }
    परत् वर्त;
}

कार्य जाओ_सरल(शब्दकोश फलन) {
    शब्दकोश फाई_लेबल = जाओ_सरल_फाई_लेबल(फलन);
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        मान अंत = खस[ख]["अंत"];
        यदि (अंत != शून्यम्) {
            यदि (अंत["कोड"] == "जाओ") {
                अंत["अंश"]["लक्ष्य"] = जाओ_सरल_हल(फलन, फाई_लेबल, अंत["अंश"]["लक्ष्य"]);
            } अन्यथा यदि (अंत["कोड"] == "यदि_जाओ") {
                पाठ नसत्य = जाओ_सरल_हल(फलन, फाई_लेबल, अंत["अंश"]["सत्य"]);
                पाठ नअसत्य = जाओ_सरल_हल(फलन, फाई_लेबल, अंत["अंश"]["असत्य"]);
                यदि (नसत्य == नअसत्य) {
                    // दोनों शाखाएँ एक ही जगह — शर्त की अब ज़रूरत नहीं
                    शब्दकोश नअंश = {};
                    नअंश["लक्ष्य"] = नसत्य;
                    खस[ख]["अंत"] = मध्यम_निर्देश_बनाओ("जाओ", 0 - 1, "शून्य", [], नअंश);
                } अन्यथा {
                    अंत["अंश"]["सत्य"] = नसत्य;
                    अंत["अंश"]["असत्य"] = नअसत्य;
                }
            }
        }
        ख = ख + 1;
    }
    परत् 0;
}


// ============================================================
// चालक — सारे pass एक कार्य पर
// ============================================================

कार्य अनुकूलक_कार्य(शब्दकोश फलन) {
    स्लॉट_उन्नयन(फलन);
    संख्या दौर = 0;
    यावत् (दौर < 5) {
        स्थिर_तह(फलन);
        जाओ_सरल(फलन);
        मृत_कोड_हटाओ(फलन);
        दौर = दौर + 1;
    }
    परत् 0;
}

कार्य अनुकूलक_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(कस)) {
        अनुकूलक_कार्य(कस[सूचक]);
        सूचक = सूचक + 1;
    }
    परत् एकक;
}
