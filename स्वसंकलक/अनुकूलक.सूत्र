// अनुकूलक.सूत्र — मध्यम (IR) पर optimization passes  [Phase 1c]
// ============================================================
// हर pass: IR कार्य लेता है, उसी को जगह पर बदलता है।
// क्रम:  mem2reg → (const-fold ↔ DCE ↔ trivial-phi) fixpoint तक।
//
// अभी संकलक में wire नहीं — अनुकूलक_परीक्षण.सूत्र से जाँचा।
// ============================================================

आयात "मध्यम.सूत्र";


// ============================================================
// CFG सहायक
// ============================================================

// खंड के terminator से उत्तराधिकारी लेबल
कार्य अनु_उत्तराधिकारी(शब्दकोश खंड) {
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम्) { परत् []; }
    पाठ कोड = अंत["कोड"];
    यदि (कोड == "जाओ") { परत् [अंत["अंश"]["लक्ष्य"]]; }
    यदि (कोड == "यदि_जाओ") { परत् [अंत["अंश"]["सत्य"], अंत["अंश"]["असत्य"]]; }
    परत् [];   // वापस / फेंको / अगम्य
}

कार्य अनु_खंड_खोजें(शब्दकोश फलन, पाठ लेबल) {
    सूची खस = फलन["खंड_सूची"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(खस)) {
        यदि (खस[सूचक]["लेबल"] == लेबल) { परत् खस[सूचक]; }
        सूचक = सूचक + 1;
    }
    परत् शून्यम्;
}

// पूर्ववर्ती-नक्शा: लेबल -> [पूर्व लेबल...]
कार्य अनु_पूर्ववर्ती(शब्दकोश फलन) {
    शब्दकोश पूर्व = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(खस)) {
        पूर्व[खस[सूचक]["लेबल"]] = [];
        सूचक = सूचक + 1;
    }
    सूचक = 0;
    यावत् (सूचक < लंबाई(खस)) {
        पाठ यहाँ = खस[सूचक]["लेबल"];
        सूची उत्त = अनु_उत्तराधिकारी(खस[सूचक]);
        संख्या ज = 0;
        यावत् (ज < लंबाई(उत्त)) {
            मान सूची_प = पूर्व[उत्त[ज]];
            यदि (सूची_प != शून्यम्) {
                पूर्व[उत्त[ज]] = जोड़ें(सूची_प, यहाँ);
            }
            ज = ज + 1;
        }
        सूचक = सूचक + 1;
    }
    परत् पूर्व;
}

// entry से DFS — विपरीत-पश्च-क्रम (RPO)
कार्य अनु_विपक्रम(शब्दकोश फलन) {
    सूची खस = फलन["खंड_सूची"];
    यदि (लंबाई(खस) == 0) { परत् []; }
    शब्दकोश देखे = {};
    शब्दकोश धारक = {};
    धारक["सूची"] = [];   // पश्च-क्रम (function-call सीमा पार करने के लिए holder)
    अनु_विपक्रम_गहन(फलन, खस[0]["लेबल"], देखे, धारक);
    सूची पश्च = धारक["सूची"];
    सूची परिणाम = [];
    संख्या सूचक = लंबाई(पश्च) - 1;
    यावत् (सूचक >= 0) {
        परिणाम = जोड़ें(परिणाम, पश्च[सूचक]);
        सूचक = सूचक - 1;
    }
    परत् परिणाम;
}

कार्य अनु_विपक्रम_गहन(शब्दकोश फलन, पाठ लेबल, शब्दकोश देखे, शब्दकोश धारक) {
    यदि (देखे[लेबल] == सत्य) { परत् 0; }
    देखे[लेबल] = सत्य;
    शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
    यदि (खंड != शून्यम्) {
        सूची उत्त = अनु_उत्तराधिकारी(खंड);
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(उत्त)) {
            अनु_विपक्रम_गहन(फलन, उत्त[सूचक], देखे, धारक);
            सूचक = सूचक + 1;
        }
    }
    धारक["सूची"] = जोड़ें(धारक["सूची"], लेबल);
    परत् 0;
}


// ============================================================
// मान-संदर्भ बदलना
// ============================================================

// एक निर्देश के सारे operand-संदर्भ पुराना→नया
कार्य अनु_निर्देश_बदलो(शब्दकोश निर्देश, संख्या पुराना, संख्या नया) {
    सूची संच = निर्देश["संचालक"];
    सूची नयी = [];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(संच)) {
        यदि (संच[सूचक] == पुराना) { नयी = जोड़ें(नयी, नया); }
        अन्यथा { नयी = जोड़ें(नयी, संच[सूचक]); }
        सूचक = सूचक + 1;
    }
    निर्देश["संचालक"] = नयी;
    // फाई स्रोत
    यदि (निर्देश["कोड"] == "फाई") {
        सूची स्रोत = निर्देश["अंश"]["स्रोत"];
        सूची नस = [];
        सूचक = 0;
        यावत् (सूचक < लंबाई(स्रोत)) {
            सूची युगल = स्रोत[सूचक];
            संख्या मव = युगल[1];
            यदि (मव == पुराना) { मव = नया; }
            नस = जोड़ें(नस, [युगल[0], मव]);
            सूचक = सूचक + 1;
        }
        निर्देश["अंश"]["स्रोत"] = नस;
    }
    परत् 0;
}

कार्य अनु_हर_उपयोग_बदलो(शब्दकोश फलन, संख्या पुराना, संख्या नया) {
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        संख्या फ = 0;
        सूची फस = खंड["फाई"];
        यावत् (फ < लंबाई(फस)) {
            अनु_निर्देश_बदलो(फस[फ], पुराना, नया);
            फ = फ + 1;
        }
        संख्या नि = 0;
        सूची निस = खंड["निर्देश"];
        यावत् (नि < लंबाई(निस)) {
            अनु_निर्देश_बदलो(निस[नि], पुराना, नया);
            नि = नि + 1;
        }
        यदि (खंड["अंत"] != शून्यम्) {
            अनु_निर्देश_बदलो(खंड["अंत"], पुराना, नया);
        }
        ख = ख + 1;
    }
    परत् 0;
}


// ============================================================
// mem2reg — स्लॉट/पढ़_स्लॉट/लिख_स्लॉट → SSA मान + फाई
// ============================================================

कार्य स्लॉट_उन्नयन(शब्दकोश फलन) {
    शब्दकोश पूर्व = अनु_पूर्ववर्ती(फलन);
    सूची क्रम = अनु_विपक्रम(फलन);

    // slot-id -> प्रकार-टैग
    शब्दकोश स्लॉट_प्रकार = {};
    // "slot|label" -> value-id  (उस खंड के अंत में slot का मान)
    शब्दकोश अंत_मान = {};
    // holders (function-call सीमा पार list-append)
    शब्दकोश धारक = {};
    धारक["टाले"] = [];    // back-edge फाई operands: [[फाई, slot, पूप], ...]
    धारक["बने_फाई"] = []; // इस pass में बने सारे फाई: [[खंड, फाई, slot], ...]

    // पहले सब स्लॉट-घोषणाएँ ढूँढो
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["कोड"] == "स्लॉट") {
                स्लॉट_प्रकार[निस[नि]["आईडी"]] = "मान";
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }

    // RPO क्रम में हर खंड process करो
    संख्या क = 0;
    यावत् (क < लंबाई(क्रम)) {
        पाठ लेबल = क्रम[क];
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
        सूची पूर्वज = पूर्व[लेबल];

        // प्रत्येक स्लॉट का प्रवेश-मान
        शब्दकोश प्रवेश_मान = {};   // slot -> value-id
        मान स_सूची = मेम_स्लॉट_सूची(स्लॉट_प्रकार);
        संख्या सक = 0;
        यावत् (सक < लंबाई(स_सूची)) {
            संख्या स्लॉट = स_सूची[सक];
            संख्या मव = मेम_प्रवेश_मान(फलन, खंड, स्लॉट, पूर्वज, क्रम, क, अंत_मान, धारक);
            यदि (मव >= 0) { प्रवेश_मान[स्लॉट] = मव; }
            सक = सक + 1;
        }

        // खंड के निर्देश चलाओ
        शब्दकोश वर्तमान = {};   // slot -> value-id (इस खंड में अब तक)
        सक = 0;
        यावत् (सक < लंबाई(स_सूची)) {
            यदि (प्रवेश_मान[स_सूची[सक]] != शून्यम्) {
                वर्तमान[स_सूची[सक]] = प्रवेश_मान[स_सूची[सक]];
            }
            सक = सक + 1;
        }

        सूची निस = खंड["निर्देश"];
        सूची रखे = [];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश निर्देश = निस[नि];
            पाठ कोड = निर्देश["कोड"];
            यदि (कोड == "स्लॉट") {
                // हटाओ
            } अन्यथा यदि (कोड == "लिख_स्लॉट") {
                संख्या स्लॉट = निर्देश["संचालक"][0];
                संख्या मव = निर्देश["संचालक"][1];
                वर्तमान[स्लॉट] = मव;
                // हटाओ
            } अन्यथा यदि (कोड == "पढ़_स्लॉट") {
                संख्या स्लॉट = निर्देश["संचालक"][0];
                मान मव = वर्तमान[स्लॉट];
                यदि (मव != शून्यम्) {
                    अनु_हर_उपयोग_बदलो(फलन, निर्देश["आईडी"], मव);
                }
                // हटाओ
            } अन्यथा {
                रखे = जोड़ें(रखे, निर्देश);
            }
            नि = नि + 1;
        }
        खंड["निर्देश"] = रखे;

        // खंड-अंत मान रिकॉर्ड करो
        सक = 0;
        यावत् (सक < लंबाई(स_सूची)) {
            यदि (वर्तमान[स_सूची[सक]] != शून्यम्) {
                अंत_मान[स_सूची[सक] + "|" + लेबल] = वर्तमान[स_सूची[सक]];
            }
            सक = सक + 1;
        }
        क = क + 1;
    }

    // टाले हुए back-edge फाई operands भरो
    सूची टाले = धारक["टाले"];
    संख्या टक = 0;
    यावत् (टक < लंबाई(टाले)) {
        सूची प्रविष्टि = टाले[टक];
        शब्दकोश फाई = प्रविष्टि[0];
        संख्या स्लॉट = प्रविष्टि[1];
        पाठ पूप = प्रविष्टि[2];
        मान मव = अंत_मान[स्लॉट + "|" + पूप];
        संख्या असल = 0 - 1;
        यदि (मव != शून्यम्) { असल = मव; }
        सूची स्रोत = फाई["अंश"]["स्रोत"];
        फाई["अंश"]["स्रोत"] = जोड़ें(स्रोत, [पूप, असल]);
        टक = टक + 1;
    }

    // तुच्छ फाई हटाओ (सब operand समान → वही मान)
    मेम_तुच्छ_फाई_हटाओ(फलन, धारक["बने_फाई"]);
    परत् 0;
}

कार्य मेम_स्लॉट_सूची(शब्दकोश स्लॉट_प्रकार) {
    सूची स = [];
    सूची कुं = कुंजियाँ(स्लॉट_प्रकार);
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(कुं)) {
        स = जोड़ें(स, कुं[सूचक]);
        सूचक = सूचक + 1;
    }
    परत् स;
}

// खंड के प्रवेश पर स्लॉट का मान तय करो (फाई बना सकता है)
कार्य मेम_प्रवेश_मान(शब्दकोश फलन, शब्दकोश खंड, संख्या स्लॉट, सूची पूर्वज,
                     सूची क्रम, संख्या क_सूचक, शब्दकोश अंत_मान, शब्दकोश धारक) {
    यदि (लंबाई(पूर्वज) == 0) { परत् 0 - 1; }   // entry — मान नहीं

    यदि (लंबाई(पूर्वज) == 1) {
        मान मव = अंत_मान[स्लॉट + "|" + पूर्वज[0]];
        यदि (मव == शून्यम्) { परत् 0 - 1; }
        परत् मव;
    }

    // ≥2 पूर्वज → फाई
    संख्या फाई_आईडी = मध्यम_ताजा_आईडी(फलन);
    शब्दकोश अंश = {};
    अंश["स्रोत"] = [];
    शब्दकोश फाई = मध्यम_निर्देश_बनाओ("फाई", फाई_आईडी, "मान", [], अंश);
    खंड["फाई"] = जोड़ें(खंड["फाई"], फाई);
    धारक["बने_फाई"] = जोड़ें(धारक["बने_फाई"], [खंड, फाई, स्लॉट]);

    संख्या पक = 0;
    यावत् (पक < लंबाई(पूर्वज)) {
        पाठ पूप = पूर्वज[पक];
        यदि (मेम_पहले_आया(क्रम, क_सूचक, पूप)) {
            मान मव = अंत_मान[स्लॉट + "|" + पूप];
            संख्या असल = 0 - 1;
            यदि (मव != शून्यम्) { असल = मव; }
            फाई["अंश"]["स्रोत"] = जोड़ें(फाई["अंश"]["स्रोत"], [पूप, असल]);
        } अन्यथा {
            // back-edge — बाद में भरो
            धारक["टाले"] = जोड़ें(धारक["टाले"], [फाई, स्लॉट, पूप]);
        }
        पक = पक + 1;
    }
    परत् फाई_आईडी;
}

कार्य मेम_पहले_आया(सूची क्रम, संख्या क_सूचक, पाठ लेबल) {
    संख्या सूचक = 0;
    यावत् (सूचक < क_सूचक) {
        यदि (क्रम[सूचक] == लेबल) { परत् सत्य; }
        सूचक = सूचक + 1;
    }
    परत् असत्य;
}

कार्य मेम_तुच्छ_फाई_हटाओ(शब्दकोश फलन, सूची बने_फाई) {
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        संख्या इक = 0;
        यावत् (इक < लंबाई(बने_फाई)) {
            सूची प्रविष्टि = बने_फाई[इक];
            शब्दकोश खंड = प्रविष्टि[0];
            शब्दकोश फाई = प्रविष्टि[1];
            यदि (फाई["हटाया"] != सत्य) {
                सूची स्रोत = फाई["अंश"]["स्रोत"];
                // अद्वितीय non-self operand गिनो
                संख्या एकमात्र = 0 - 1;
                मान तुच्छ = सत्य;
                संख्या जक = 0;
                यावत् (जक < लंबाई(स्रोत)) {
                    संख्या मव = स्रोत[जक][1];
                    यदि (मव != फाई["आईडी"] && मव >= 1) {
                        यदि (एकमात्र < 0) { एकमात्र = मव; }
                        अन्यथा यदि (एकमात्र != मव) { तुच्छ = असत्य; }
                    }
                    जक = जक + 1;
                }
                यदि (तुच्छ && एकमात्र >= 1) {
                    अनु_हर_उपयोग_बदलो(फलन, फाई["आईडी"], एकमात्र);
                    खंड["फाई"] = मेम_फाई_निकालो(खंड["फाई"], फाई["आईडी"]);
                    फाई["हटाया"] = सत्य;
                    बदला = सत्य;
                }
            }
            इक = इक + 1;
        }
    }
    परत् 0;
}

कार्य मेम_फाई_निकालो(सूची फाई_सूची, संख्या आईडी) {
    सूची नयी = [];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(फाई_सूची)) {
        यदि (फाई_सूची[सूचक]["आईडी"] != आईडी) {
            नयी = जोड़ें(नयी, फाई_सूची[सूचक]);
        }
        सूचक = सूचक + 1;
    }
    परत् नयी;
}


// ============================================================
// const-fold
// ============================================================

कार्य स्थिर_तह(शब्दकोश फलन) {
    // value-id -> स्थिर निर्देश (केवल पूर्ण/बूल)
    शब्दकोश स्थिरांक = {};
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        सूची खस = फलन["खंड_सूची"];
        संख्या ख = 0;
        यावत् (ख < लंबाई(खस)) {
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = 0;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश निर्देश = निस[नि];
                पाठ कोड = निर्देश["कोड"];
                यदि (कोड == "स्थिर") {
                    मान मप = निर्देश["अंश"]["मान_प्रकार"];
                    यदि (मप == "पूर्ण" || मप == "बूल") {
                        स्थिरांक[निर्देश["आईडी"]] = निर्देश;
                    }
                } अन्यथा यदि (स्थिर_तह_योग्य(कोड)) {
                    सूची संच = निर्देश["संचालक"];
                    यदि (लंबाई(संच) == 2) {
                        मान अ = स्थिरांक[संच[0]];
                        मान ब = स्थिरांक[संच[1]];
                        यदि (अ != शून्यम् && ब != शून्यम्) {
                            मान नया_मान = स्थिर_गणना(कोड, अ["अंश"]["मान"], ब["अंश"]["मान"]);
                            यदि (नया_मान != शून्यम्) {
                                निर्देश["कोड"] = "स्थिर";
                                शब्दकोश नअंश = {};
                                नअंश["मान_प्रकार"] = स्थिर_परिणाम_प्रकार(कोड);
                                नअंश["मान"] = नया_मान;
                                निर्देश["अंश"] = नअंश;
                                निर्देश["संचालक"] = [];
                                निर्देश["प्रकार"] = नअंश["मान_प्रकार"];
                                स्थिरांक[निर्देश["आईडी"]] = निर्देश;
                                बदला = सत्य;
                            }
                        } अन्यथा {
                            // बीजगणितीय सरलीकरण: एक operand स्थिर
                            संख्या अन्य = बीज_सरल(निर्देश, कोड, अ, ब, संच);
                            यदि (अन्य >= 1) {
                                अनु_हर_उपयोग_बदलो(फलन, निर्देश["आईडी"], अन्य);
                                निर्देश["कोड"] = "अमृत";   // no-op — DCE हटाएगा; पुनः-trigger न हो
                                निर्देश["संचालक"] = [];
                                बदला = सत्य;
                            }
                        }
                    }
                }
                नि = नि + 1;
            }
            ख = ख + 1;
        }
    }
    परत् 0;
}

// एक operand स्थिर → दूसरे operand की value-id लौटाओ (कोई नहीं तो -1)
// x+0, 0+x, x-0, x*1, 1*x  →  x
कार्य बीज_सरल(शब्दकोश निर्देश, पाठ कोड, मान अ_स्थिर, मान ब_स्थिर, सूची संच) {
    // अ स्थिर?
    यदि (अ_स्थिर != शून्यम्) {
        संख्या अ_मान = अ_स्थिर["अंश"]["मान"];
        यदि (कोड == "योग" && अ_मान == 0) { परत् संच[1]; }
        यदि (कोड == "गुणा" && अ_मान == 1) { परत् संच[1]; }
    }
    यदि (ब_स्थिर != शून्यम्) {
        संख्या ब_मान = ब_स्थिर["अंश"]["मान"];
        यदि (कोड == "योग" && ब_मान == 0) { परत् संच[0]; }
        यदि (कोड == "अंतर" && ब_मान == 0) { परत् संच[0]; }
        यदि (कोड == "गुणा" && ब_मान == 1) { परत् संच[0]; }
    }
    परत् 0 - 1;
}

कार्य स्थिर_तह_योग्य(पाठ कोड) {
    परत् कोड == "योग" || कोड == "अंतर" || कोड == "गुणा" || कोड == "भाग" || कोड == "शेष"
        || कोड == "सम" || कोड == "असम" || कोड == "लघु" || कोड == "गुरु"
        || कोड == "लघुसम" || कोड == "गुरुसम" || कोड == "और" || कोड == "या";
}

कार्य स्थिर_परिणाम_प्रकार(पाठ कोड) {
    यदि (कोड == "योग" || कोड == "अंतर" || कोड == "गुणा" || कोड == "भाग" || कोड == "शेष") {
        परत् "पूर्ण";
    }
    परत् "बूल";
}

कार्य स्थिर_गणना(पाठ कोड, संख्या अ, संख्या ब) {
    यदि (कोड == "योग") { परत् अ + ब; }
    यदि (कोड == "अंतर") { परत् अ - ब; }
    यदि (कोड == "गुणा") { परत् अ * ब; }
    यदि (कोड == "भाग") { यदि (ब == 0) { परत् शून्यम्; } परत् अ / ब; }
    यदि (कोड == "शेष") { यदि (ब == 0) { परत् शून्यम्; } परत् अ % ब; }
    यदि (कोड == "सम") { यदि (अ == ब) { परत् 1; } परत् 0; }
    यदि (कोड == "असम") { यदि (अ != ब) { परत् 1; } परत् 0; }
    यदि (कोड == "लघु") { यदि (अ < ब) { परत् 1; } परत् 0; }
    यदि (कोड == "गुरु") { यदि (अ > ब) { परत् 1; } परत् 0; }
    यदि (कोड == "लघुसम") { यदि (अ <= ब) { परत् 1; } परत् 0; }
    यदि (कोड == "गुरुसम") { यदि (अ >= ब) { परत् 1; } परत् 0; }
    यदि (कोड == "और") { यदि (अ != 0 && ब != 0) { परत् 1; } परत् 0; }
    यदि (कोड == "या") { यदि (अ != 0 || ब != 0) { परत् 1; } परत् 0; }
    परत् शून्यम्;
}


// ============================================================
// DCE — मृत निर्देश + अगम्य खंड
// ============================================================

कार्य क्या_दुष्प्रभावी(पाठ कोड) {
    परत् कोड == "लिख_स्लॉट" || कोड == "लिख_वैश्विक" || कोड == "लिख_अनुक्रम"
        || कोड == "लिख_क्षेत्र" || कोड == "बुलाओ" || कोड == "अंतर्"
        || कोड == "विधि_बुलाओ" || कोड == "नव_पाठ" || कोड == "नव_सूची"
        || कोड == "नव_शब्दकोश" || कोड == "नव_वस्तु";
}

कार्य मृत_कोड_हटाओ(शब्दकोश फलन) {
    // 1. अगम्य खंड
    सूची क्रम = अनु_विपक्रम(फलन);
    शब्दकोश पहुँच = {};
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(क्रम)) {
        पहुँच[क्रम[सूचक]] = सत्य;
        सूचक = सूचक + 1;
    }
    सूची नए_खंड = [];
    सूची खस = फलन["खंड_सूची"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(खस)) {
        यदि (पहुँच[खस[सूचक]["लेबल"]] == सत्य) {
            नए_खंड = जोड़ें(नए_खंड, खस[सूचक]);
        }
        सूचक = सूचक + 1;
    }
    फलन["खंड_सूची"] = नए_खंड;

    // 2. मृत निर्देश (fixpoint)
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        शब्दकोश उपयोग = अनु_उपयोग_गणना(फलन);
        खस = फलन["खंड_सूची"];
        संख्या ख = 0;
        यावत् (ख < लंबाई(खस)) {
            शब्दकोश खंड = खस[ख];
            // फाई
            सूची नई_फाई = [];
            संख्या फस_इ = 0;
            यावत् (फस_इ < लंबाई(खंड["फाई"])) {
                शब्दकोश फनोड = खंड["फाई"][फस_इ];
                यदि (उपयोग[फनोड["आईडी"]] != शून्यम् && उपयोग[फनोड["आईडी"]] > 0) {
                    नई_फाई = जोड़ें(नई_फाई, फनोड);
                } अन्यथा { बदला = सत्य; }
                फस_इ = फस_इ + 1;
            }
            खंड["फाई"] = नई_फाई;
            // निर्देश
            सूची नई_निर्देश = [];
            संख्या नि = 0;
            यावत् (नि < लंबाई(खंड["निर्देश"])) {
                शब्दकोश निर = खंड["निर्देश"][नि];
                मान गिनती = उपयोग[निर["आईडी"]];
                यदि (गिनती == शून्यम्) { गिनती = 0; }
                यदि (क्या_दुष्प्रभावी(निर["कोड"]) || गिनती > 0) {
                    नई_निर्देश = जोड़ें(नई_निर्देश, निर);
                } अन्यथा { बदला = सत्य; }
                नि = नि + 1;
            }
            खंड["निर्देश"] = नई_निर्देश;
            ख = ख + 1;
        }
    }
    परत् 0;
}

कार्य अनु_उपयोग_गणना(शब्दकोश फलन) {
    शब्दकोश गिन = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        अनु_गिनो_निर्देश_सूची(खंड["फाई"], गिन);
        अनु_गिनो_निर्देश_सूची(खंड["निर्देश"], गिन);
        यदि (खंड["अंत"] != शून्यम्) {
            अनु_गिनो_एक(खंड["अंत"], गिन);
        }
        ख = ख + 1;
    }
    परत् गिन;
}

कार्य अनु_गिनो_निर्देश_सूची(सूची निस, शब्दकोश गिन) {
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(निस)) {
        अनु_गिनो_एक(निस[सूचक], गिन);
        सूचक = सूचक + 1;
    }
    परत् 0;
}

कार्य अनु_गिनो_एक(शब्दकोश निर्देश, शब्दकोश गिन) {
    सूची संच = निर्देश["संचालक"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(संच)) {
        संख्या वक = संच[सूचक];
        मान गक = गिन[वक];
        यदि (गक == शून्यम्) { गिन[वक] = 1; }
        अन्यथा { गिन[वक] = गक + 1; }
        सूचक = सूचक + 1;
    }
    यदि (निर्देश["कोड"] == "फाई") {
        सूची स्रोत = निर्देश["अंश"]["स्रोत"];
        सूचक = 0;
        यावत् (सूचक < लंबाई(स्रोत)) {
            संख्या वक = स्रोत[सूचक][1];
            मान गक = गिन[वक];
            यदि (गक == शून्यम्) { गिन[वक] = 1; }
            अन्यथा { गिन[वक] = गक + 1; }
            सूचक = सूचक + 1;
        }
    }
    परत् 0;
}


// ============================================================
// चालक — सारे pass एक कार्य पर
// ============================================================

कार्य अनुकूलक_कार्य(शब्दकोश फलन) {
    स्लॉट_उन्नयन(फलन);
    संख्या दौर = 0;
    यावत् (दौर < 5) {
        स्थिर_तह(फलन);
        मृत_कोड_हटाओ(फलन);
        दौर = दौर + 1;
    }
    परत् 0;
}

कार्य अनुकूलक_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(कस)) {
        अनुकूलक_कार्य(कस[सूचक]);
        सूचक = सूचक + 1;
    }
    परत् एकक;
}
