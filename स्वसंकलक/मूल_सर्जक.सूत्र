        मान ऑफसेट = -८ * (सूचक + १);
        स = स + "  leaq " + ऑफसेट + "(%rbp), %rcx" + नई_पंक्ति();
        स = स + "  call sutra_gc_pop_root" + नई_पंक्ति();
        सूचक = सूचक - १;
    }
    
    स = स + "  movq 32(%rsp), %rax" + नई_पंक्ति();
    स = स + "  addq $48, %rsp" + नई_पंक्ति();
    स = स + "  movq %rbp, %rsp" + नई_पंक्ति();
    स = स + "  popq %rbp" + नई_पंक्ति();
    स = स + "  ret" + नई_पंक्ति();
    स = स + नई_पंक्ति();
    
    चालू_वर्ग_नाम = "";
    परत् स;
}

// ===== मुख्य प्रोग्राम उत्पादन =====
 कार्य मूल_सर्जक_प्रोग्राम(शब्दकोश प्रोग्राम_नोड) {
    मूल_वैश्विक_चर = [];
    मूल_स्ट्रिंग_शाब्दिक = [];
    मूल_स्ट्रिंग_आँकड़े = [];
    मूल_दशमलव_शाब्दिक = [];
    मूल_विभाजन_लेबल_गणक = ०;
    मूल_चर_नक्शा = {};
    चालू_चर_प्रकार = {};
    मूल_मुख्य_है = असत्य;
    मूल_कार्य_परत्_प्रकार = {};
    मूल_वर्ग_नक्शा = {};
    
    सूची वर्ग_सूची = प्रोग्राम_नोड["वर्ग_सूची"];
    
    संख्या व_सूचक = ०;
    यावत् (व_सूचक < लंबाई(वर्ग_सूची)) {
        शब्दकोश वर्ग_नोड = वर्ग_सूची[व_सूचक];
        पाठ वर्ग_नाम = वर्ग_नोड["नाम"];
        सूची चर_सूची = वर्ग_नोड["चर_सूची"];
        सूची क्षेत्र_सूची = [];
        संख्या क्षेत्र_सूचक = ०;
        यावत् (क्षेत्र_सूचक < लंबाई(चर_सूची)) {
            क्षेत्र_सूची = जोड़ें(क्षेत्र_सूची, चर_सूची[क्षेत्र_सूचक]["नाम"]);
            क्षेत्र_सूचक = क्षेत्र_सूचक + १;
        }
        मूल_वर्ग_नक्शा[वर्ग_नाम] = क्षेत्र_सूची;
        व_सूचक = व_सूचक + १;
    }
    
    सूची कार्य_सूची = प्रोग्राम_नोड["कार्य_सूची"];
    // दो पास — ताकि f() जो g() को बुलाता है, g के बाद परिभाषित होने पर भी हल हो
    संख्या पास = ०;
    यावत् (पास < २) {
        संख्या का_चेक = ०;
        यावत् (का_चेक < लंबाई(कार्य_सूची)) {
            यदि (कार्य_सूची[का_चेक]["नाम"] == "मुख्य") {
                मूल_मुख्य_है = सत्य;
            }
            यदि (क्या_दशमलव_परत्_है(कार्य_सूची[का_चेक]["देह"])) {
                मूल_कार्य_परत्_प्रकार[कार्य_सूची[का_चेक]["नाम"]] = "दशमलव";
            } अन्यथा यदि (क्या_पाठ_परत्_है(कार्य_सूची[का_चेक]["देह"])) {
                मूल_कार्य_परत्_प्रकार[कार्य_सूची[का_चेक]["नाम"]] = "पाठ";
            }
            का_चेक = का_चेक + १;
        }
        पास = पास + १;
    }
    
    व_सूचक = ०;
    यावत् (व_सूचक < लंबाई(वर्ग_सूची)) {
        शब्दकोश वर्ग_नोड = वर्ग_सूची[व_सूचक];
        पाठ वर्ग_नाम = वर्ग_नोड["नाम"];
        सूची वर्ग_कार्य_सूची = वर्ग_नोड["कार्य_सूची"];
        संख्या का_सूचक = ०;
        यावत् (का_सूचक < लंबाई(वर्ग_कार्य_सूची)) {
            शब्दकोश कार्य_नोड = वर्ग_कार्य_सूची[का_सूचक];
            पाठ मूल_नाम = कार्य_नोड["नाम"];
            पाठ सी_नाम = "";
            यदि (मूल_नाम == अक्षर_सूची_से_पाठ([२३५२, २३३०, २३४४, २३६६])) {
                सी_नाम = वर्ग_नाम + "_रचना";
            } अन्यथा {
                सी_नाम = "वर्ग_" + वर्ग_नाम + "_" + मूल_नाम;
            }
            यदि (क्या_दशमलव_परत्_है(कार्य_नोड["देह"])) {
                मूल_कार्य_परत्_प्रकार[सी_नाम] = "दशमलव";
            }
            का_सूचक = का_सूचक + १;
        }
        व_सूचक = व_सूचक + १;
    }
    
    सूची वैश्विक_कथन = प्रोग्राम_नोड["वैश्विक_कथन"];
    
    संख्या वै_सूचक = ०;
    यावत् (वै_सूचक < लंबाई(वैश्विक_कथन)) {
        मूल_वैश्विक_चर = मूल_चर_संग्रह(वैश्विक_कथन[वै_सूचक], मूल_वैश्विक_चर);
        वै_सूचक = वै_सूचक + १;
    }
    
    मान कार्य_कोड = "";
    संख्या का_सूचक = ०;
    यावत् (का_सूचक < लंबाई(कार्य_सूची)) {
        कार्य_कोड = कार्य_कोड + मूल_कार्य_सर्जक(कार्य_सूची[का_सूचक]);
        का_सूचक = का_सूचक + १;
    }
    
    व_सूचक = ०;
    यावत् (व_सूचक < लंबाई(वर्ग_सूची)) {
        शब्दकोश वर्ग_नोड = वर्ग_सूची[व_सूचक];
        पाठ वर्ग_नाम = वर्ग_नोड["नाम"];
        सूची वर्ग_कार्य_सूची = वर्ग_नोड["कार्य_सूची"];
        संख्या का_विधि_सूचक = ०;
        यावत् (का_विधि_सूचक < लंबाई(वर्ग_कार्य_सूची)) {
            शब्दकोश कार्य_नोड = वर्ग_कार्य_सूची[का_विधि_सूचक];
            कार्य_कोड = कार्य_कोड + मूल_विधि_सर्जक(कार्य_नोड, वर्ग_नाम);
            का_विधि_सूचक = का_विधि_सूचक + १;
        }
        व_सूचक = व_सूचक + १;
    }
    
    चालू_कार्य_नाम = "main";
    मूल_चर_नक्शा = {};
    मान कथन_कोड = "";
    वै_सूचक = ०;
    यावत् (वै_सूचक < लंबाई(वैश्विक_कथन)) {
        कथन_कोड = कथन_कोड + मूल_कठन_सर्जक(वैश्विक_कथन[वै_सूचक]);
        वै_सूचक = वै_सूचक + १;
    }
    
    मान परिणाम = "";
    परिणाम = परिणाम + मूल_शीर्षलेख();
    परिणाम = परिणाम + मूल_आँकड़ा_खंड();
    परिणाम = परिणाम + कार्य_कोड;
    // पुस्तकालय-रूप: न मुख्य, और हर शीर्ष-स्तर कथन केवल चर-घोषणा
    // (वैश्विक चर .data में .quad ० के रूप में शून्य-आरंभित होते हैं, अतः
    //  main आवरण की आवश्यकता नहीं)। रनटाइम-मॉड्यूल (मूल_रनटाइम / मूल_आवंटक)
    //  के लिए — ताकि main प्रतीक न टकराए।
    मान पुस्तकालय_रूप = न मूल_मुख्य_है;
    संख्या पु_सूचक = ०;
    यावत् (पु_सूचक < लंबाई(वैश्विक_कथन)) {
        यदि (वैश्विक_कथन[पु_सूचक]["नोड_प्रकारः"] != "कठन_चर_घोषणा") {
            पुस्तकालय_रूप = असत्य;
        }
        पु_सूचक = पु_सूचक + १;
    }
    यदि (न पुस्तकालय_रूप) {
        परिणाम = परिणाम + मूल_मुख्य_प्रविष्टि(कथन_कोड);
    }

    परत् परिणाम;
}

// ===== मुख्य प्रविष्टि आवरण =====
कार्य मूल_मुख्य_प्रविष्टि(पाठ कथन_कोड) {
    संख्या फ्रेम_आकार = ३२;
    मान स = "";
    स = स + "  .text" + नई_पंक्ति();
    स = स + नई_पंक्ति();
    स = स + "  .globl main" + नई_पंक्ति();
    स = स + "  .def main; .scl 2; .type 32; .endef" + नई_पंक्ति();
    स = स + "main:" + नई_पंक्ति();
    स = स + "  pushq %rbp" + नई_पंक्ति();
    स = स + "  movq %rsp, %rbp" + नई_पंक्ति();
    स = स + "  subq $" + फ्रेम_आकार + ", %rsp" + नई_पंक्ति();
    स = स + नई_पंक्ति();
    स = स + "  call sutra_init_args" + नई_पंक्ति();
    स = स + नई_पंक्ति();
    संख्या चर_संख्या = लंबाई(मूल_वैश्विक_चर);
    संख्या सूचक = ०;
    यावत् (सूचक < चर_संख्या) {
        पाठ नाम = मूल_वैश्विक_चर[सूचक];
        स = स + "  leaq sutra_glob_" + नाम + "(%rip), %rcx" + नई_पंक्ति();
        स = स + "  call sutra_gc_push_root" + नई_पंक्ति();
        सूचक = सूचक + १;
    }
    स = स + नई_पंक्ति();
    स = स + कथन_कोड;
    यदि (मूल_मुख्य_है) {
        स = स + "  call sutra_main" + नई_पंक्ति();
    }
    सूचक = चर_संख्या - १;
    यावत् (सूचक >= ०) {
        पाठ नाम = मूल_वैश्विक_चर[सूचक];
        स = स + "  leaq sutra_glob_" + नाम + "(%rip), %rcx" + नई_पंक्ति();
        स = स + "  call sutra_gc_pop_root" + नई_पंक्ति();
        सूचक = सूचक - १;
    }
    स = स + "  xorl %eax, %eax" + नई_पंक्ति();
    स = स + "  movq %rbp, %rsp" + नई_पंक्ति();
    स = स + "  popq %rbp" + नई_पंक्ति();
    स = स + "  ret" + नई_पंक्ति();
    परत् स;
}

