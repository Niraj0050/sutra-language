                परत् मूल_स्ट्रिंग_शाब्दिक_सर्जक("दशमलव");
            } अन्यथा यदि (क्या_बूल_अभिव्यक्ति_है(तर्क)) {
                परत् मूल_स्ट्रिंग_शाब्दिक_सर्जक("बूल");
            } अन्यथा यदि (क्या_पाठ_अभिव्यक्ति_है(तर्क)) {
                परत् मूल_स्ट्रिंग_शाब्दिक_सर्जक("पाठ");
            } अन्यथा यदि (क्या_सूची_अभिव्यक्ति_है(तर्क)) {
                परत् मूल_स्ट्रिंग_शाब्दिक_सर्जक("सूची");
            } अन्यथा यदि (क्या_शब्दकोश_अभिव्यक्ति_है(तर्क)) {
                परत् मूल_स्ट्रिंग_शाब्दिक_सर्जक("शब्दकोश");
            } अन्यथा यदि (क्या_शून्य_अभिव्यक्ति_है(तर्क)) {
