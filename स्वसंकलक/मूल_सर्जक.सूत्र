        }
        
        सूचक = ४;
        यावत् (सूचक < म) {
            मान स्रोत_ढेर_ऑफसेट = आवश्यक_आवंटन + ८ * (म - १ - सूचक);
            मान लक्ष्य_ढेर_ऑफसेट = ३२ + (सूचक - ४) * ८;
