// ===== कथन =====
कार्य मूल_कठन_सर्जक(शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् ""; }
    पाठ प्रकार = नोड["नोड_प्रकारः"];
    
    यदि (प्रकार == "कठन_चर_घोषणा") {
        पाठ नाम = नोड["नाम"];
        मान प्रारंभिक = नोड["प्रारंभिक"];
        मान प्रकार_नाम = नोड["प्रकार_नाम"];
        
        // प्रकार पंजीकरण — दशमलव/बूल/वर्ग/शून्य जाँच के लिए
        // शून्यम् आरम्भिक मान होने पर चर अभी शून्य है, चाहे प्रकार_नाम कुछ भी लिखा हो
        मान चर_प्रकार = "अजनक";
        यदि (प्रारंभिक != शून्यम् && प्रारंभिक["नोड_प्रकारः"] == "अभिव्यक्ति_स्थिरांक" && प्रारंभिक["स्थिरांक_प्रकारः"] == "शून्यम्") {
            चर_प्रकार = "शून्यम्";
        } अन्यथा यदि (प्रकार_नाम == "बूल") {
            चर_प्रकार = "बूल";
        } अन्यथा यदि (प्रकार_नाम == "दशमलव") {
            चर_प्रकार = "दशमलव";
        } अन्यथा यदि (प्रकार_नाम != "मान") {
            चर_प्रकार = प्रकार_नाम;
        } अन्यथा यदि (प्रारंभिक != शून्यम्) {
            यदि (क्या_बूल_अभिव्यक्ति_है(प्रारंभिक)) {
                चर_प्रकार = "बूल";
            } अन्यथा यदि (क्या_दशमलव_अभिव्यक्ति_है(प्रारंभिक)) {
                चर_प्रकार = "दशमलव";
            } अन्यथा यदि (प्रारंभिक["नोड_प्रकारः"] == "अभिव्यक्ति_नवीन") {
                चर_प्रकार = प्रारंभिक["वर्ग_नाम"];
            }
        }
        चालू_चर_प्रकार[नाम] = चर_प्रकार;

        मान स = "";
        यदि (प्रारंभिक != शून्यम्) {
            स = स + मूल_अभिव्यक्ति_सर्जक(प्रारंभिक);
        } अन्यथा {
            स = स +  अक्षर_सूची_से_पाठ([३२,३२,१२०,१११,११४,११३,३२,३७,११४,९७,१२०,४४,३२,३७,११४,९७,१२०]) + नई_पंक्ति();
        }
        
        // Write to stack offset or global variable
        यदि (मूल_चर_नक्शा[नाम] != शून्यम्) {
            मान ऑफसेट = मूल_चर_नक्शा[नाम];
            // "  movq %rax, -<off>(%rbp)\n"
            स = स +  अक्षर_सूची_से_पाठ([३२,३२,१०९,१११,११८,११३,३२,३७,११४,९७,१२०,४४,३२]) + ऑफसेट +  अक्षर_सूची_से_पाठ([४०,३७,११४,९८,११२,४१]) + नई_पंक्ति();
        } अन्यथा {
            // Write to global variable
            // "  movq %rax, sutra_glob_<name>(%rip)\n"
            स = स +  अक्षर_सूची_से_पाठ([३२,३२,१०९,१११,११८,११३,३२,३७,११४,९७,१२०,४४,३२,११५,११७,११६,११४,९७,९५,१०३,१०८,१११,९८,९५]) + नाम +  अक्षर_सूची_से_पाठ([४०,३७,११४,१०५,११२,४१]) + नई_पंक्ति();
