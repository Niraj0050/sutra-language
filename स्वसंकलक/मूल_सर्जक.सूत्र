// ===== कथन =====
कार्य मूल_कठन_सर्जक(शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् ""; }
    पाठ प्रकार = नोड["नोड_प्रकारः"];
    
    यदि (प्रकार == "कठन_चर_घोषणा") {
        पाठ नाम = नोड["नाम"];
        मान प्रारंभिक = नोड["प्रारंभिक"];
        मान प्रकार_नाम = नोड["प्रकार_नाम"];
        
        // प्रकार पंजीकरण — दशमलव/बूल/वर्ग/शून्य जाँच के लिए
        // शून्यम् आरम्भिक मान होने पर चर अभी शून्य है, चाहे प्रकार_नाम कुछ भी लिखा हो
        मान चर_प्रकार = "अजनक";
        यदि (प्रारंभिक != शून्यम् && प्रारंभिक["नोड_प्रकारः"] == "अभिव्यक्ति_स्थिरांक" && प्रारंभिक["स्थिरांक_प्रकारः"] == "शून्यम्") {
            चर_प्रकार = "शून्यम्";
        } अन्यथा यदि (प्रकार_नाम == "बूल") {
            चर_प्रकार = "बूल";
        } अन्यथा यदि (प्रकार_नाम == "दशमलव") {
            चर_प्रकार = "दशमलव";
        } अन्यथा यदि (प्रकार_नाम != "मान") {
            चर_प्रकार = प्रकार_नाम;
        } अन्यथा यदि (प्रारंभिक != शून्यम्) {
            यदि (क्या_बूल_अभिव्यक्ति_है(प्रारंभिक)) {
                चर_प्रकार = "बूल";
            } अन्यथा यदि (क्या_दशमलव_अभिव्यक्ति_है(प्रारंभिक)) {
                चर_प्रकार = "दशमलव";
