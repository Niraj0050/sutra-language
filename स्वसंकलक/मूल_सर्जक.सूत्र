            } अन्यथा यदि (मानः != शून्यम् && मानः["नोड_प्रकारः"] == "अभिव्यक्ति_नवीन") {
                चर_प्रकार = मानः["वर्ग_नाम"];
            }
            चालू_चर_प्रकार[नाम] = चर_प्रकार;
