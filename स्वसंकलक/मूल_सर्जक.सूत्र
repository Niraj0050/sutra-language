        यदि (म > ४) {
            ढेर_तर्क_संख्या = म - ४;
        }
        संख्या कच्चे_आकार = ३२ + (ढेर_तर्क_संख्या * ८);
        संख्या कुल_आवश्यक = कुल_पुश_आकार + कच्चे_आकार;
        संख्या संरेखित_कुल = ((कुल_आवश्यक + १५) / १६) * १६;
