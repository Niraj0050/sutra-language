        स = स + "  subq $32, %rsp" + नई_पंक्ति();
        स = स + "  call sutra_exception_get_jmp_buf" + नई_पंक्ति();
        स = स + "  addq $32, %rsp" + नई_पंक्ति();
        स = स + "  movq %rax, %rcx" + नई_पंक्ति();
        स = स + "  movq $0, %rdx" + नई_पंक्ति();
        स = स + "  subq $32, %rsp" + नई_पंक्ति();
        स = स + "  call _setjmp" + नई_पंक्ति();
        स = स + "  addq $32, %rsp" + नई_पंक्ति();
        स = स + "  testq %rax, %rax" + नई_पंक्ति();
        स = स + "  jnz " + ले_पकड़ो + नई_पंक्ति();
        
        स = स + मूल_कठन_सर्जक(प्रयत्न_ब्लॉक);
        स = स + "  subq $32, %rsp" + नई_पंक्ति();
        स = स + "  call sutra_exception_pop" + नई_पंक्ति();
        स = स + "  addq $32, %rsp" + नई_पंक्ति();
        स = स + "  jmp " + ले_मत + नई_पंक्ति();
        
        स = स + ले_पकड़ो + ":" + नई_पंक्ति();
        स = स + "  subq $32, %rsp" + नई_पंक्ति();
        स = स + "  call sutra_get_exception_value" + नई_पंक्ति();
        स = स + "  addq $32, %rsp" + नई_पंक्ति();
        यदि (त्रुटि_चर != "") {
