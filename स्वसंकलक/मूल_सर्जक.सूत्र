        स = स + "  call " + वर्ग_नाम + "_रचना" + नई_पंक्ति();
        स = स + "  movq " + (आवश्यक_आवंटन + ८ * म) + "(%rsp), %rax" + नई_पंक्ति();
        स = स + "  addq $" + संरेखित_कुल + ", %rsp" + नई_पंक्ति();
