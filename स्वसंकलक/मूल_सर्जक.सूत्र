    सूची स्थानीय_चर = [];
    स्थानीय_चर = मूल_चर_संग्रह(कार्य_नोड["देह"], स्थानीय_चर);
    
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः)) {
        मूल_चर_नक्शा[तर्काः[सूचक]["नाम"]] = -8 * (सूचक + 1);
        यदि (तर्काः[सूचक]["नाम"] == "स्व") {
            चालू_चर_प्रकार["स्व"] = "अजनक";
        } अन्यथा {
            मान प्र_नाम = तर्काः[सूचक]["प्रकार_नाम"];
            यदि (प्र_नाम != "मान" && प्र_नाम != शून्यम्) {
                चालू_चर_प्रकार[तर्काः[सूचक]["नाम"]] = प्र_नाम;
            } अन्यथा {
                चालू_चर_प्रकार[तर्काः[सूचक]["नाम"]] = "अजनक";
            }
        }
        सूचक = सूचक + 1;
    }
    
    संख्या ल_सूचक = 0;
    यावत् (ल_सूचक < लंबाई(स्थानीय_चर)) {
        पाठ  चर_नाम = स्थानीय_चर[ल_सूचक];
        यदि (मूल_चर_नक्शा[चर_नाम] == शून्यम्) {
            मूल_चर_नक्शा[चर_नाम] = -8 * (लंबाई(तर्काः) + ल_सूचक + 1);
        }
        ल_सूचक = ल_सूचक + 1;
    }
    
    संख्या कुल_चर_संख्या = लंबाई(तर्काः) + लंबाई(स्थानीय_चर);
    
    संख्या कच्चे_आकार = (कुल_चर_संख्या * 8) + 32;
    संख्या फ्रेम_आकार = ((कच्चे_आकार + 15) / 16) * 16;
    
    मान स = "";
    स = स + "  .text" + नई_पंक्ति();
    स = स + "  .globl " + नाम + नई_पंक्ति();
    स = स + "  .def " + नाम + "; .scl 2; .type 32; .endef" + नई_पंक्ति();
    स = स + नाम + ":" + नई_पंक्ति();
    
    स = स + "  pushq %rbp" + नई_पंक्ति();
    स = स + "  movq %rsp, %rbp" + नई_पंक्ति();
    स = स + "  subq $" + फ्रेम_आकार + ", %rsp" + नई_पंक्ति();
    स = स + नई_पंक्ति();
    
    सूचक = 0;
    यावत् (सूचक < कुल_चर_संख्या) {
        मान ऑफसेट = -8 * (सूचक + 1);
        स = स + "  movq $0, " + ऑफसेट + "(%rbp)" + नई_पंक्ति();
        सूचक = सूचक + 1;
    }
    
    सूची रजिस्टर_तर्क = ["%rcx", "%rdx", "%r8", "%r9"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः)) {
        मान ऑफसेट = मूल_चर_नक्शा[तर्काः[सूचक]["नाम"]];
        यदि (सूचक < 4) {
            स = स + "  movq " + रजिस्टर_तर्क[सूचक] + ", " + ऑफसेट + "(%rbp)" + नई_पंक्ति();
        } अन्यथा {
            मान स्रोत_ढेर_ऑफसेट = 48 + (सूचक - 4) * 8;
            स = स + "  movq " + स्रोत_ढेर_ऑफसेट + "(%rbp), %rax" + नई_पंक्ति();
            स = स + "  movq %rax, " + ऑफसेट + "(%rbp)" + नई_पंक्ति();
        }
        सूचक = सूचक + 1;
    }
    
    सूचक = 0;
    यावत् (सूचक < कुल_चर_संख्या) {
        मान ऑफसेट = -8 * (सूचक + 1);
        स = स + "  leaq " + ऑफसेट + "(%rbp), %rcx" + नई_पंक्ति();
        स = स + "  call sutra_gc_push_root" + नई_पंक्ति();
        सूचक = सूचक + 1;
    }
    स = स + नई_पंक्ति();
    
    स = स + मूल_कठन_सर्जक(कार्य_नोड["देह"]);
    
    स = स + ".L_epilogue_" + नाम + ":" + नई_पंक्ति(); // fixed below
    स = स + "  subq $48, %rsp" + नई_पंक्ति();
    स = स + "  movq %rax, 32(%rsp)" + नई_पंक्ति();
    
    सूचक = कुल_चर_संख्या - 1;
    यावत् (सूचक >= 0) {
        मान ऑफसेट = -8 * (सूचक + 1);
        स = स + "  leaq " + ऑफसेट + "(%rbp), %rcx" + नई_पंक्ति();
        स = स + "  call sutra_gc_pop_root" + नई_पंक्ति();
        सूचक = सूचक - 1;
    }
    
    स = स + "  movq 32(%rsp), %rax" + नई_पंक्ति();
    स = स + "  addq $48, %rsp" + नई_पंक्ति();
    स = स + "  movq %rbp, %rsp" + नई_पंक्ति();
    स = स + "  popq %rbp" + नई_पंक्ति();
    स = स + "  ret" + नई_पंक्ति();
    स = स + नई_पंक्ति();
    
    परत् स;
}

