// ===== Assembly आँकड़ा खंड =====
कार्य मूल_आँकड़ा_खंड() {
    मान स = "";

    // Global variables
    यदि (लंबाई(मूल_वैश्विक_चर) > ०) {
        स = स + "  .data" + नई_पंक्ति();
        संख्या ग_सूचक = ०;
        यावत् (ग_सूचक < लंबाई(मूल_वैश्विक_चर)) {
            स = स + "  .globl sutra_glob_" + मूल_वैश्विक_चर[ग_सूचक] + नई_पंक्ति();
            स = स + "sutra_glob_" + मूल_वैश्विक_चर[ग_सूचक] + ":" + नई_पंक्ति();
            स = स + "  .quad 0" + नई_पंक्ति();
            ग_सूचक = ग_सूचक + १;
        }
        स = स + नई_पंक्ति();
    }
    
    // Read-only data section for decimals and strings
    // "  .section .rdata,\"dr\""
    स = स + अक्षर_सूची_से_पाठ([३२,३२,४६,११५,१०१,९९,११६,१०५,१११,११०,३२,४६,११४,१००,९७,११६,९७,४४,३२,३४,१००,११४,३४]) + नई_पंक्ति();
    
    // Decimal literals
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(मूल_दशमलव_शाब्दिक)) {
        // ".LC_dbl_<idx>:"
        स = स +  अक्षर_सूची_से_पाठ([४६,७६,६७,९५,१००,९८,१०८,९५]) + सूचक + ":" + नई_पंक्ति();
        // "  .double <val_string>"
        स = स +  अक्षर_सूची_से_पाठ([३२,३२,४६,१००,१११,११७,९८,१०८,१०१,३२]) + मूल_दशमलव_शाब्दिक[सूचक] + नई_पंक्ति();
        सूचक = सूचक + १;
    }

    // String literals
    सूचक = ०;
    यावत् (सूचक < लंबाई(मूल_स्ट्रिंग_शाब्दिक)) {
        // ".LC_str_<idx>:"
        स = स +  अक्षर_सूची_से_पाठ([४६,७६,६७,९५,११५,११६,११४,९५]) + सूचक + ":" + नई_पंक्ति();
        // "  .ascii \"<data>\0\""
        स = स +  अक्षर_सूची_से_पाठ([३२,३२,४६,९७,११५,९९,१०५,१०५,३२,३४]) + मूल_स्ट्रिंग_आँकड़े[सूचक] +  अक्षर_सूची_से_पाठ([९२,४८,३४]) + नई_पंक्ति();
        // ".LC_str_<idx>_len:"
        स = स +  अक्षर_सूची_से_पाठ([४६,७६,६७,९५,११५,११६,११४,९५]) + सूचक +  अक्षर_सूची_से_पाठ([९५,१०८,१०१,११०,५८]) + नई_पंक्ति();
        // "  .quad <len>"
        स = स +  अक्षर_सूची_से_पाठ([३२,३२,४६,११३,११७,९७,१००,३२]) + मूल_स्ट्रिंग_शाब्दिक[सूचक] + नई_पंक्ति();
        सूचक = सूचक + १;
    }
    स = स + नई_पंक्ति();

    परत् स;
}

// Float promotion helper in assembly: promotes integer to double bits
कार्य मूल_प्रोमोशन_कोड(पाठ लक्ष्य_रजिस्टर) {
    मान स = "";
    // Pass register to %rcx for conversion
    स = स +  अक्षर_सूची_से_पाठ([३२,३२,१०९,१११,११८,११३,३२]) + लक्ष्य_रजिस्टर +  अक्षर_सूची_से_पाठ([४४,३२,३७,११४,९९,१२०]) + नई_पंक्ति();
    // "  subq $32, %rsp\n"
    स = स +  अक्षर_सूची_से_पाठ([३२,३२,११५,११७,९८,११३,३२,३६,५१,५०,४४,३२,३७,११४,११५,११२]) + नई_पंक्ति();
    // "  call sutra_int_to_float\n"
    स = स +  अक्षर_सूची_से_पाठ([३२,३२,९९,९७,१०८,१०८,३२,११५,११७,११६,११४,९७,९५,१०५,११०,११६,९५,११६,१११,९५,१०२,१०८,१११,९७,११६]) + नई_पंक्ति();
    // "  addq $32, %rsp\n"
    स = स +  अक्षर_सूची_से_पाठ([३२,३२,९७,१००,१००,११३,३२,३६,५१,५०,४४,३२,३७,११४,११५,११२]) + नई_पंक्ति();
    // Move result from %rax back to लक्ष्य_रजिस्टर
    स = स +  अक्षर_सूची_से_पाठ([३२,३२,१०९,१११,११८,११३,३२,३७,११४,९७,१२०,४४,३२]) + लक्ष्य_रजिस्टर + नई_पंक्ति();
    परत् स;
}

// ===== अभिव्यक्ति — परिणाम %rax में =====
कार्य मूल_अभिव्यक्ति_सर्जक(शब्दकोश नोड) {
    यदि (नोड == शून्यम्) {
        // "  xorq %rax, %rax\n"
        परत्  अक्षर_सूची_से_पाठ([३२,३२,१२०,१११,११४,११३,३२,३७,११४,९७,१२०,४४,३२,३७,११४,९७,१२०]) + नई_पंक्ति();
    }
    पाठ प्रकार = नोड["नोड_प्रकारः"];
    यदि (प्रकार == "अभिव्यक्ति_स्थिरांक") {
        पाठ स्थिरांक_प्रकार = नोड["स्थिरांक_प्रकारः"];
        यदि (स्थिरांक_प्रकार == "संख्या" || स्थिरांक_प्रकार == "पूर्णाङ्क") {
            मान मान_संख्या = नोड["मानः"];
            // check length to avoid immediate range overflow in assembler
            यदि (बाइट_लंबाई(मान_संख्या) > ९) {
                // "  movabsq $<val>, %rax\n"
                परत्  अक्षर_सूची_से_पाठ([३२,३२,१०९,१११,११८,९७,९८,११५,११३,३२,३६]) + मान_संख्या +  अक्षर_सूची_से_पाठ([४४,३२,३७,११४,९७,१२०]) + नई_पंक्ति();
