            }
        }
        चालू_चर_प्रकार[नाम] = चर_प्रकार;

        मान स = "";
        यदि (प्रारंभिक != शून्यम्) {
            स = स + मूल_अभिव्यक्ति_सर्जक(प्रारंभिक);
        } अन्यथा {
            स = स +  अक्षर_सूची_से_पाठ([32,32,120,111,114,113,32,37,114,97,120,44,32,37,114,97,120]) + नई_पंक्ति();
        }
        
        // Write to stack offset or global variable
        यदि (मूल_चर_नक्शा[नाम] != शून्यम्) {
            मान ऑफसेट = मूल_चर_नक्शा[नाम];
            // "  movq %rax, -<off>(%rbp)\n"
            स = स +  अक्षर_सूची_से_पाठ([32,32,109,111,118,113,32,37,114,97,120,44,32]) + ऑफसेट +  अक्षर_सूची_से_पाठ([40,37,114,98,112,41]) + नई_पंक्ति();
        } अन्यथा {
            // Write to global variable
            // "  movq %rax, sutra_glob_<name>(%rip)\n"
            स = स +  अक्षर_सूची_से_पाठ([32,32,109,111,118,113,32,37,114,97,120,44,32,115,117,116,114,97,95,103,108,111,98,95]) + नाम +  अक्षर_सूची_से_पाठ([40,37,114,105,112,41]) + नई_पंक्ति();
        }
        परत् स;
        
    } अन्यथा यदि (प्रकार == "कठन_असाइनमेंट") {
        पाठ नाम = नोड["नाम"];
