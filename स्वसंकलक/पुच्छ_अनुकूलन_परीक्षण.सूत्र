// पुच्छ_अनुकूलन_परीक्षण.सूत्र — TCO (tail-call optimization) का test
// असली parser → lower → अनुकूलक_एकक → पुच्छ_अनुकूलन_एकक → IR डंप जाँचो
// (लूप_अनुकूलन_परीक्षण जैसा ही तरीका — hand-built IR नहीं)

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "लूप_अनुकूलन.सूत्र";
आयात "पुच्छ_अनुकूलन.सूत्र";

मान विफल = ०;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + १; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= ०; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}

// parse → lower → सामान्य अनुकूलक (mem2reg+const-fold+DCE) → TCO → छापो
कार्य पूर्ण_अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    पुच्छ_अनुकूलन_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

कार्य मुख्य() {
    // १. मूल — accumulator-शैली पुच्छ-पुनरावृत्ति
    पाठ द1 = पूर्ण_अनुकूलित(
        "कार्य योगसह(संख्या अ, संख्या स) { यदि (अ <= 0) { परत् स; } परत् योगसह(अ - 1, स + अ); }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 @योगसह कॉल गायब (TCO हुआ)", न है(द1, "@योगसह"));
    जाँच("1 tco_सिर ब्लॉक बना", है(द1, "tco_सिर"));
    जाँच("1 phi (फाई) बना", है(द1, "फाई"));

    // २. नकारात्मक — non-tail self-recursion (fib-शैली, कॉल के बाद गुणा होता)
    पाठ द2 = पूर्ण_अनुकूलित(
        "कार्य गैरपुच्छ(संख्या अ) { यदि (अ <= 1) { परत् अ; } परत् अ * गैरपुच्छ(अ - 1); }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 non-tail self-recursion अछूता रहा", है(द2, "@गैरपुच्छ"));
    जाँच("2 tco_सिर नहीं बना", न है(द2, "tco_सिर"));

    // ३. नकारात्मक — mutual recursion (self नहीं) — TCO से बाहर
    पाठ द3 = पूर्ण_अनुकूलित(
        "कार्य मरैक(संख्या अ) { यदि (अ <= 0) { परत् 0; } परत् मबैक(अ - 1); } " +
        "कार्य मबैक(संख्या अ) { यदि (अ <= 0) { परत् 0; } परत् मरैक(अ - 1); }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 mutual recursion अछूता (मबैक कॉल मौजूद)", है(द3, "@मबैक"));
    जाँच("3 mutual recursion अछूता (मरैक कॉल मौजूद)", है(द3, "@मरैक"));

    // ४. कई tail-call स्थल — दोनों एक ही tco_सिर पर मिलें
    पाठ द4 = पूर्ण_अनुकूलित(
        "कार्य बहुस्थल(संख्या अ, संख्या स) { " +
        "  यदि (अ <= 0) { परत् स; } " +
        "  यदि (अ > 100) { परत् बहुस्थल(अ - 10, स + 10); } " +
        "  परत् बहुस्थल(अ - 1, स + 1); }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 दोनों @बहुस्थल कॉल गायब", न है(द4, "@बहुस्थल"));
    जाँच("4 tco_सिर बना", है(द4, "tco_सिर"));

    // ५. नकारात्मक — non-recursive फलन बिल्कुल अछूता
    पाठ द5 = पूर्ण_अनुकूलित("कार्य सादा(संख्या अ) { परत् अ + 1; }");
    लिखतु("--- 5 ---"); लिखतु(द5);
    जाँच("5 non-recursive फलन अछूता", न है(द5, "tco_सिर"));

    लिखतु("");
    यदि (विफल == ०) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
