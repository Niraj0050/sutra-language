// कार्य / एकक lowering
// ============================================================

कार्य निम्नक_कार्य(शब्दकोश एकक, शब्दकोश कार्य_नोड, शब्दकोश वैश्विक, शब्दकोश कार्य_परत्) {
    पाठ नाम = कार्य_नोड["नाम"];
    मान परत्_त = कार्य_परत्[नाम];
    पाठ रत = "मान";
    यदि (परत्_त != शून्यम्) { रत = परत्_त; }
    शब्दकोश फलन = मध्यम_नव_कार्य(नाम, रत);

    शब्दकोश संदर्भ = {};
    संदर्भ["एकक"] = एकक;
    संदर्भ["फलन"] = फलन;
    संदर्भ["चर_स्लॉट"] = {};
    संदर्भ["वैश्विक"] = वैश्विक;
    संदर्भ["कार्य_परत्"] = कार्य_परत्;
    संदर्भ["विराम_ढेर"] = [];
    संदर्भ["जारी_ढेर"] = [];
    संदर्भ["मान_प्रकार"] = {};

    शब्दकोश प्रवेश = मध्यम_नव_खंड(फलन, "प्रवेश");
    संदर्भ["वर्तमान_खंड"] = प्रवेश;

    // पैरामीटर → SSA मान (पहले सब, ताकि id v0..v(n-1) क्रमिक रहें)
    सूची तर्काः = कार्य_नोड["तर्काः"];
    सूची पम_सूची = [];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः)) {
        शब्दकोश तर्क = तर्काः[सूचक];
        पाठ पटैग = निम्नक_प्रकार_टैग(तर्क["प्रकार_नाम"]);
        संख्या पम = मध्यम_पैरामीटर(फलन, तर्क["नाम"], पटैग);
        संदर्भ["मान_प्रकार"][पम] = पटैग;
        पम_सूची = जोड़ें(पम_सूची, पम);
        सूचक = सूचक + 1;
    }
    // फिर हर पैरामीटर के लिए स्लॉट + प्रारंभिक store (पुनः-असाइनमेंट के लिए)
    सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः)) {
        शब्दकोश तर्क = तर्काः[सूचक];
        पाठ पनाम = तर्क["नाम"];
        पाठ पटैग = निम्नक_प्रकार_टैग(तर्क["प्रकार_नाम"]);
        संख्या स्लॉट_आईडी = मध्यम_स्लॉट(फलन, प्रवेश, पनाम);
        शब्दकोश जानकारी = {};
        जानकारी["स्लॉट"] = स्लॉट_आईडी;
        जानकारी["प्रकार"] = पटैग;
        संदर्भ["चर_स्लॉट"][पनाम] = जानकारी;
        मध्यम_जोड़_प्रभाव(प्रवेश, "लिख_स्लॉट", [स्लॉट_आईडी, पम_सूची[सूचक]], {});
        सूचक = सूचक + 1;
    }

    निम्नक_कथन(संदर्भ, कार्य_नोड["देह"]);

    // अंतिम खंड में terminator न हो तो implicit return
    यदि (न नि_समाप्त_है(संदर्भ)) {
        यदि (रत == "शून्य" || रत == "मान") {
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], 0 - 1);
        } अन्यथा {
            संख्या श = मध्यम_स्थिर_शून्यम्(फलन, संदर्भ["वर्तमान_खंड"]);
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], श);
        }
    }
    परत् फलन;
}

कार्य निम्नक_एकक(शब्दकोश प्रोग्राम) {
    शब्दकोश एकक = मध्यम_नव_एकक();

    // कार्य परत्-प्रकार तालिका (आगे-संदर्भ के लिए पहले बनाओ)
    शब्दकोश कार्य_परत् = {};
    सूची कार्य_सूची = प्रोग्राम["कार्य_सूची"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        // AST में कार्य का घोषित परत्-प्रकार नहीं होता — "मान" रख दो;
        // बाद में semantic info से भरा जा सकता है।
        कार्य_परत्[कार्य_सूची[सूचक]["नाम"]] = "मान";
        सूचक = सूचक + 1;
    }

    // वैश्विक चर — वैश्विक_कथन से नाम इकट्ठा करो
    शब्दकोश वैश्विक = {};
    सूची वैश्विक_कथन = प्रोग्राम["वैश्विक_कथन"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(वैश्विक_कथन)) {
        शब्दकोश क = वैश्विक_कथन[सूचक];
        यदि (क["नोड_प्रकारः"] == "कठन_चर_घोषणा") {
            पाठ गनाम = क["नाम"];
            वैश्विक[गनाम] = निम्नक_प्रकार_टैग(क["प्रकार_नाम"]);
            शब्दकोश जी = {};
            जी["नाम"] = गनाम;
            जी["प्रकार"] = वैश्विक[गनाम];
            एकक["वैश्विक_सूची"] = जोड़ें(एकक["वैश्विक_सूची"], जी);
        }
        सूचक = सूचक + 1;
    }

    // हर कार्य lower करो
    सूचक = 0;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        शब्दकोश फलन = निम्नक_कार्य(एकक, कार्य_सूची[सूचक], वैश्विक, कार्य_परत्);
        एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], फलन);
        सूचक = सूचक + 1;
    }

    परत् एकक;
}
