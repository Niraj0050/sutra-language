// मूल_निम्नक.सूत्र — AST → मध्यम (IR) lowering  [Phase 1b]
// ============================================================
// प्रोग्राम-नोड (विश्लेषक का output) लेकर मध्यम.सूत्र का IR एकक बनाता है।
// अभी संकलक में wire नहीं — standalone, मूल_निम्नक_परीक्षण.सूत्र से जाँचा।
//
// रणनीति: हर स्थानीय चर = एक "स्लॉट" (alloca)। पढ़ना = पढ़_स्लॉट,
// लिखना = लिख_स्लॉट। SSA-निर्माण lowering में नहीं — mem2reg pass (1c)
// स्लॉट्स को SSA मानों में बदलेगा। इससे lowering सरल रहती है।
//
// संदर्भ (lowering context) — शब्दकोश:
//   { "एकक", "फलन", "वर्तमान_खंड",
//     "चर_स्लॉट": {नाम -> {"स्लॉट":id, "प्रकार":tag}},
//     "वैश्विक": {नाम -> प्रकार-tag},
//     "कार्य_परत्": {नाम -> परत्_प्रकार-tag},
//     "विराम_ढेर": [लेबल...], "जारी_ढेर": [लेबल...],
//     "मान_प्रकार": {मान-id -> tag} }
// ============================================================

आयात "मध्यम.सूत्र";

// ---- प्रकार मानचित्रण ----

कार्य निम्नक_प्रकार_टैग(पाठ नाम) {
    यदि (नाम == "संख्या" || नाम == "पूर्णाङ्क") { परत् "पूर्ण"; }
    यदि (नाम == "दशमलव") { परत् "दशमलव"; }
    यदि (नाम == "पाठ") { परत् "पाठ"; }
    यदि (नाम == "बूल") { परत् "बूल"; }
    यदि (नाम == "सूची") { परत् "सूची"; }
    यदि (नाम == "शब्दकोश") { परत् "शब्दकोश"; }
    यदि (नाम == "शून्यम्" || नाम == "शून्य") { परत् "शून्य"; }
    परत् "मान";
}

// ---- संदर्भ helpers ----

कार्य नि_ताजा_मान(शब्दकोश संदर्भ) {
    परत् मध्यम_ताजा_आईडी(संदर्भ["फलन"]);
}

// मान-उत्पादक निर्देश जोड़ो + उसका प्रकार रिकॉर्ड करो
कार्य नि_जोड़(शब्दकोश संदर्भ, पाठ कोड, पाठ प्रकार, सूची संचालक, शब्दकोश अंश) {
    संख्या आईडी = मध्यम_जोड़(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], कोड, प्रकार, संचालक, अंश);
    संदर्भ["मान_प्रकार"][आईडी] = प्रकार;
    परत् आईडी;
}

कार्य नि_प्रभाव(शब्दकोश संदर्भ, पाठ कोड, सूची संचालक, शब्दकोश अंश) {
    परत् मध्यम_जोड़_प्रभाव(संदर्भ["वर्तमान_खंड"], कोड, संचालक, अंश);
}

कार्य नि_मान_प्रकार(शब्दकोश संदर्भ, संख्या आईडी) {
    मान त = संदर्भ["मान_प्रकार"][आईडी];
    यदि (त == शून्यम्) { परत् "मान"; }
    परत् त;
}

कार्य नि_समाप्त_है(शब्दकोश संदर्भ) {
    परत् संदर्भ["वर्तमान_खंड"]["अंत"] != शून्यम्;
}

कार्य नि_नया_खंड(शब्दकोश संदर्भ, पाठ संकेत) {
    परत् मध्यम_नव_खंड(संदर्भ["फलन"], संकेत);
}

कार्य नि_खंड_पर(शब्दकोश संदर्भ, शब्दकोश खंड) {
    संदर्भ["वर्तमान_खंड"] = खंड;
    परत् 0;
}


// ============================================================
// अभिव्यक्ति lowering — SSA मान-id लौटाता है
// ============================================================

कार्य निम्नक_अभिव्यक्ति(शब्दकोश संदर्भ, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् मध्यम_स्थिर_शून्यम्(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"]); }
    पाठ प्रकार = नोड["नोड_प्रकारः"];

    यदि (प्रकार == "अभिव्यक्ति_स्थिरांक") {
        परत् निम्नक_स्थिरांक(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_पहचान") {
        परत् निम्नक_पहचान(संदर्भ, नोड["नाम"]);
    }
    यदि (प्रकार == "अभिव्यक्ति_द्विआधारी") {
        परत् निम्नक_द्विआधारी(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_एकल") {
        परत् निम्नक_एकल(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_कॉल") {
        परत् निम्नक_कॉल(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_अनुक्रमणिका") {
        संख्या आधार = निम्नक_अभिव्यक्ति(संदर्भ, नोड["आधार"]);
        संख्या अनु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["अनुक्रमणिका"]);
        परत् नि_जोड़(संदर्भ, "पढ़_अनुक्रम", "मान", [आधार, अनु], {});
    }
    यदि (प्रकार == "अभिव्यक्ति_सभ्य") {
        संख्या वस्तु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वस्तु"]);
        शब्दकोश अंश = {};
        अंश["क्षेत्र"] = नोड["नाम"];
        परत् नि_जोड़(संदर्भ, "पढ़_क्षेत्र", "मान", [वस्तु], अंश);
    }
    यदि (प्रकार == "अभिव्यक्ति_सूची_स्थिरांक") {
        सूची तत्व_आईडी = [];
        सूची तत्व = नोड["तत्व"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            तत्व_आईडी = जोड़ें(तत्व_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तत्व[सूचक]));
            सूचक = सूचक + 1;
        }
        परत् नि_जोड़(संदर्भ, "नव_सूची", "सूची", तत्व_आईडी, {});
    }
    यदि (प्रकार == "अभिव्यक्ति_शब्दकोश_स्थिरांक") {
        सूची जोड़े = [];
        सूची तत्व = नोड["तत्व"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            सूची युगल = तत्व[सूचक];
            जोड़े = जोड़ें(जोड़े, निम्नक_अभिव्यक्ति(संदर्भ, युगल[0]));
            जोड़े = जोड़ें(जोड़े, निम्नक_अभिव्यक्ति(संदर्भ, युगल[1]));
            सूचक = सूचक + 1;
        }
        परत् नि_जोड़(संदर्भ, "नव_शब्दकोश", "शब्दकोश", जोड़े, {});
    }
    यदि (प्रकार == "अभिव्यक्ति_स्व") {
        परत् निम्नक_पहचान(संदर्भ, "स्व");
    }
    यदि (प्रकार == "अभिव्यक्ति_नवीन") {
        सूची तर्क_आईडी = [];
        सूची तर्काः = नोड["तर्काः"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तर्काः)) {
            तर्क_आईडी = जोड़ें(तर्क_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तर्काः[सूचक]));
            सूचक = सूचक + 1;
        }
        शब्दकोश अंश = {};
        अंश["वर्ग"] = नोड["वर्ग_नाम"];
        परत् नि_जोड़(संदर्भ, "नव_वस्तु", "वस्तु", तर्क_आईडी, अंश);
    }
    यदि (प्रकार == "अभिव्यक्ति_विधि_कॉल") {
        संख्या वस्तु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वस्तु"]);
        सूची तर्क_आईडी = [वस्तु];
        सूची तर्काः = नोड["तर्काः"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तर्काः)) {
            तर्क_आईडी = जोड़ें(तर्क_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तर्काः[सूचक]));
            सूचक = सूचक + 1;
        }
        शब्दकोश अंश = {};
        अंश["वर्ग"] = "?";
        अंश["विधि"] = नोड["नाम"];
        परत् नि_जोड़(संदर्भ, "विधि_बुलाओ", "मान", तर्क_आईडी, अंश);
    }

    // अज्ञात — शून्यम् स्थिरांक (सुरक्षित fallback)
    परत् मध्यम_स्थिर_शून्यम्(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"]);
}

कार्य निम्नक_स्थिरांक(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ कप = नोड["स्थिरांक_प्रकारः"];
    पाठ मव = नोड["मानः"];
    यदि (कप == "पाठ") {
        परत् मध्यम_स्थिर_पाठ(संदर्भ["एकक"], संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], मव);
    }
    यदि (कप == "बूल") {
        मान ब = असत्य;
        यदि (मव == "सत्य") { ब = सत्य; }
        संख्या आईडी = मध्यम_स्थिर_बूल(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], ब);
        संदर्भ["मान_प्रकार"][आईडी] = "बूल";
        परत् आईडी;
    }
    यदि (कप == "शून्यम्") {
        परत् मध्यम_स्थिर_शून्यम्(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"]);
    }
    यदि (कप == "दशमलव") {
        शब्दकोश अंश = {};
        अंश["मान_प्रकार"] = "दशमलव";
        अंश["मान"] = मव;
        परत् नि_जोड़(संदर्भ, "स्थिर", "दशमलव", [], अंश);
    }
    // पूर्णाङ्क / संख्या
    संख्या आईडी = मध्यम_स्थिर_पूर्ण(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], अंक_से_पूर्ण(मव));
    संदर्भ["मान_प्रकार"][आईडी] = "पूर्ण";
    परत् आईडी;
}

// पाठ → पूर्णांक (सरल; ऋण-चिह्न सहित)
कार्य अंक_से_पूर्ण(पाठ स) {
    संख्या मानः = 0;
    संख्या सूचक = 0;
    मान ऋण = असत्य;
    यदि (लंबाई(स) > 0) {
        यदि (स[0] == "-") { ऋण = सत्य; सूचक = 1; }
    }
    यावत् (सूचक < लंबाई(स)) {
        संख्या क = अक्षर_मान(स[सूचक]);
        यदि (क >= 48 && क <= 57) {
            मानः = मानः * 10 + (क - 48);
        }
        सूचक = सूचक + 1;
    }
    यदि (ऋण) { परत् 0 - मानः; }
    परत् मानः;
}

कार्य निम्नक_पहचान(शब्दकोश संदर्भ, पाठ नाम) {
    मान स्लॉट = संदर्भ["चर_स्लॉट"][नाम];
    यदि (स्लॉट != शून्यम्) {
        परत् नि_जोड़(संदर्भ, "पढ़_स्लॉट", स्लॉट["प्रकार"], [स्लॉट["स्लॉट"]], {});
    }
    // वैश्विक
    मान गप्र = संदर्भ["वैश्विक"][नाम];
    पाठ टैग = "मान";
    यदि (गप्र != शून्यम्) { टैग = गप्र; }
    शब्दकोश अंश = {};
    अंश["नाम"] = नाम;
    परत् नि_जोड़(संदर्भ, "पढ़_वैश्विक", टैग, [], अंश);
}

// अनुमानित परिणाम-प्रकार (द्विआधारी)
कार्य निम्नक_द्विआधारी_प्रकार(पाठ सञ्चालक, पाठ बायाँ, पाठ दायाँ) {
    यदि (सञ्चालक == "समानता (==)" || सञ्चालक == "असमानता (!=)"
        || सञ्चालक == "लघुतर (<)" || सञ्चालक == "गुरुतर (>)"
        || सञ्चालक == "लघुतर-समान (<=)" || सञ्चालक == "गुरुतर-समान (>=)"
        || सञ्चालक == "तथा-संयोजक (&&)" || सञ्चालक == "अथवा-संयोजक (||)"
        || सञ्चालक == "मुख्यशब्द_तथा" || सञ्चालक == "मुख्यशब्द_अथवा") {
        परत् "बूल";
    }
    यदि (सञ्चालक == "धन (+)") {
        यदि (बायाँ == "पाठ" || दायाँ == "पाठ") { परत् "पाठ"; }
    }
    यदि (बायाँ == "दशमलव" || दायाँ == "दशमलव") { परत् "दशमलव"; }
    यदि (बायाँ == "पूर्ण" && दायाँ == "पूर्ण") { परत् "पूर्ण"; }
    परत् "मान";
}

कार्य निम्नक_संचालक_कोड(पाठ सञ्चालक) {
    यदि (सञ्चालक == "धन (+)") { परत् "योग"; }
    यदि (सञ्चालक == "ऋण (-)") { परत् "अंतर"; }
    यदि (सञ्चालक == "गुणा (*)") { परत् "गुणा"; }
    यदि (सञ्चालक == "भाग (/)") { परत् "भाग"; }
    यदि (सञ्चालक == "शेष (%)") { परत् "शेष"; }
    यदि (सञ्चालक == "समानता (==)") { परत् "सम"; }
    यदि (सञ्चालक == "असमानता (!=)") { परत् "असम"; }
    यदि (सञ्चालक == "लघुतर (<)") { परत् "लघु"; }
    यदि (सञ्चालक == "गुरुतर (>)") { परत् "गुरु"; }
    यदि (सञ्चालक == "लघुतर-समान (<=)") { परत् "लघुसम"; }
    यदि (सञ्चालक == "गुरुतर-समान (>=)") { परत् "गुरुसम"; }
    परत् "योग";
}

कार्य निम्नक_द्विआधारी(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ सञ्चालक = नोड["सञ्चालक"];

    // && / || — short-circuit (शाखाएँ + फाई)
    यदि (सञ्चालक == "तथा-संयोजक (&&)" || सञ्चालक == "मुख्यशब्द_तथा") {
        परत् निम्नक_लघुपथ(संदर्भ, नोड["वाम"], नोड["दक्षिण"], सत्य);
    }
    यदि (सञ्चालक == "अथवा-संयोजक (||)" || सञ्चालक == "मुख्यशब्द_अथवा") {
        परत् निम्नक_लघुपथ(संदर्भ, नोड["वाम"], नोड["दक्षिण"], असत्य);
    }

    संख्या बायाँ_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वाम"]);
    संख्या दायाँ_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["दक्षिण"]);
    पाठ बत = नि_मान_प्रकार(संदर्भ, बायाँ_आईडी);
    पाठ दत = नि_मान_प्रकार(संदर्भ, दायाँ_आईडी);
    पाठ परिणाम_प्रकार = निम्नक_द्विआधारी_प्रकार(सञ्चालक, बत, दत);
    पाठ कोड = निम्नक_संचालक_कोड(सञ्चालक);
    परत् नि_जोड़(संदर्भ, कोड, परिणाम_प्रकार, [बायाँ_आईडी, दायाँ_आईडी], {});
}

// लघुपथ: तथा_है सत्य => &&, असत्य => ||
कार्य निम्नक_लघुपथ(शब्दकोश संदर्भ, शब्दकोश वाम, शब्दकोश दक्षिण, मान तथा_है) {
    संख्या ला = निम्नक_अभिव्यक्ति(संदर्भ, वाम);
    शब्दकोश आरंभ_खंड = संदर्भ["वर्तमान_खंड"];
    शब्दकोश दायाँ_खंड = नि_नया_खंड(संदर्भ, "sc_दायाँ");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "sc_अंत");

    यदि (तथा_है) {
        मध्यम_यदि_जाओ(आरंभ_खंड, ला, दायाँ_खंड["लेबल"], अंत_खंड["लेबल"]);
    } अन्यथा {
        मध्यम_यदि_जाओ(आरंभ_खंड, ला, अंत_खंड["लेबल"], दायाँ_खंड["लेबल"]);
    }

    नि_खंड_पर(संदर्भ, दायाँ_खंड);
    संख्या लब = निम्नक_अभिव्यक्ति(संदर्भ, दक्षिण);
    शब्दकोश दायाँ_अंत = संदर्भ["वर्तमान_खंड"];
    मध्यम_जाओ(दायाँ_अंत, अंत_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, अंत_खंड);
    // आरंभ-शाखा से लघु-परिपथ मान:  && => असत्य,  || => सत्य
    मान लप_मान = सत्य;
    यदि (तथा_है) { लप_मान = असत्य; }
    संख्या स्थिर_आईडी = मध्यम_स्थिर_बूल(संदर्भ["फलन"], आरंभ_खंड, लप_मान);
    // ध्यान: स्थिर आरंभ_खंड में जुड़ा — terminator से पहले क्रम में नहीं;
    // 1c/emitter phi से पहले इसे उठाते हैं। सरलता के लिए अभी स्वीकार्य।
    सूची स्रोत = [[आरंभ_खंड["लेबल"], स्थिर_आईडी], [दायाँ_अंत["लेबल"], लब]];
    संख्या फल = मध्यम_फाई(संदर्भ["फलन"], अंत_खंड, "बूल", स्रोत);
    संदर्भ["मान_प्रकार"][फल] = "बूल";
    परत् फल;
}

कार्य निम्नक_एकल(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ सञ्चालक = नोड["सञ्चालक"];
    संख्या भीतर = निम्नक_अभिव्यक्ति(संदर्भ, नोड["संख्या"]);
    यदि (सञ्चालक == "ऋण (-)") {
        पाठ त = नि_मान_प्रकार(संदर्भ, भीतर);
        यदि (त != "दशमलव") { त = "पूर्ण"; }
        परत् नि_जोड़(संदर्भ, "ऋणात्मक", त, [भीतर], {});
    }
    // न (not)
    परत् नि_जोड़(संदर्भ, "नकार", "बूल", [भीतर], {});
}

कार्य निम्नक_कॉल(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ नाम = नोड["नाम"];
    सूची तर्क_आईडी = [];
    सूची तर्काः = नोड["तर्काः"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः)) {
        तर्क_आईडी = जोड़ें(तर्क_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तर्काः[सूचक]));
        सूचक = सूचक + 1;
    }
    // अंतर्_* = intrinsic
    यदि (लंबाई(नाम) >= 6) {
        यदि (उपखंड(नाम, 0, 6) == "अंतर्_") {
            शब्दकोश अंश = {};
            अंश["नाम"] = नाम;
            परत् नि_जोड़(संदर्भ, "अंतर्", "पूर्ण", तर्क_आईडी, अंश);
        }
    }
    मान परत्_त = संदर्भ["कार्य_परत्"][नाम];
    पाठ टैग = "मान";
    यदि (परत्_त != शून्यम्) { टैग = परत्_त; }
    शब्दकोश अंश = {};
    अंश["लक्ष्य"] = नाम;
    परत् नि_जोड़(संदर्भ, "बुलाओ", टैग, तर्क_आईडी, अंश);
}


// ============================================================
// कथन lowering
// ============================================================

कार्य निम्नक_कथन(शब्दकोश संदर्भ, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् 0; }
    यदि (नि_समाप्त_है(संदर्भ)) { परत् 0; }   // dead code — छोड़ो
    पाठ प्रकार = नोड["नोड_प्रकारः"];

    यदि (प्रकार == "कठन_ब्लॉक") {
        सूची कसू = नोड["कठन_सूची"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(कसू)) {
            निम्नक_कथन(संदर्भ, कसू[सूचक]);
            सूचक = सूचक + 1;
        }
        परत् 0;
    }
    यदि (प्रकार == "कठन_चर_घोषणा") {
        पाठ नाम = नोड["नाम"];
        पाठ टैग = निम्नक_प्रकार_टैग(नोड["प्रकार_नाम"]);
        संख्या स्लॉट_आईडी = मध्यम_स्लॉट(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], नाम);
        शब्दकोश जानकारी = {};
        जानकारी["स्लॉट"] = स्लॉट_आईडी;
        जानकारी["प्रकार"] = टैग;
        संदर्भ["चर_स्लॉट"][नाम] = जानकारी;
        मान प्रारंभिक = नोड["प्रारंभिक"];
        यदि (प्रारंभिक != शून्यम्) {
            संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, प्रारंभिक);
            यदि (टैग == "मान") {
                जानकारी["प्रकार"] = नि_मान_प्रकार(संदर्भ, मान_आईडी);
                संदर्भ["चर_स्लॉट"][नाम] = जानकारी;
            }
            नि_प्रभाव(संदर्भ, "लिख_स्लॉट", [स्लॉट_आईडी, मान_आईडी], {});
        }
        परत् 0;
    }
    यदि (प्रकार == "कठन_असाइनमेंट") {
        पाठ नाम = नोड["नाम"];
        संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        मान स्लॉट = संदर्भ["चर_स्लॉट"][नाम];
        यदि (स्लॉट != शून्यम्) {
            नि_प्रभाव(संदर्भ, "लिख_स्लॉट", [स्लॉट["स्लॉट"], मान_आईडी], {});
        } अन्यथा {
            शब्दकोश अंश = {};
            अंश["नाम"] = नाम;
            नि_प्रभाव(संदर्भ, "लिख_वैश्विक", [मान_आईडी], अंश);
        }
        परत् 0;
    }
    यदि (प्रकार == "कठन_अनुक्रमणिका_असाइनमेंट") {
        संख्या आधार = निम्नक_पहचान(संदर्भ, नोड["नाम"]);
        सूची अनु_सूची = नोड["अनुक्रमणिका_सूची"];
        // बहु-स्तर a[i][j] = v  →  क्रमिक पढ़_अनुक्रम, अंतिम लिख_अनुक्रम
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(अनु_सूची) - 1) {
            संख्या अनु = निम्नक_अभिव्यक्ति(संदर्भ, अनु_सूची[सूचक]);
            आधार = नि_जोड़(संदर्भ, "पढ़_अनुक्रम", "मान", [आधार, अनु], {});
            सूचक = सूचक + 1;
        }
        संख्या अंतिम_अनु = निम्नक_अभिव्यक्ति(संदर्भ, अनु_सूची[लंबाई(अनु_सूची) - 1]);
        संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        नि_प्रभाव(संदर्भ, "लिख_अनुक्रम", [आधार, अंतिम_अनु, मान_आईडी], {});
        परत् 0;
    }
    यदि (प्रकार == "कठन_सभ्य_असाइनमेंट") {
        संख्या वस्तु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वस्तु"]);
        संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        शब्दकोश अंश = {};
        अंश["क्षेत्र"] = नोड["नाम"];
        नि_प्रभाव(संदर्भ, "लिख_क्षेत्र", [वस्तु, मान_आईडी], अंश);
        परत् 0;
    }
    यदि (प्रकार == "कठन_अभिव्यक्ति") {
        निम्नक_अभिव्यक्ति(संदर्भ, नोड["अभिव्यक्ति"]);
        परत् 0;
    }
    यदि (प्रकार == "कठन_लिखतु") {
        निम्नक_लिखतु(संदर्भ, नोड["अभिव्यक्ति"]);
        परत् 0;
    }
    यदि (प्रकार == "कठन_परत्") {
        मान मानः = नोड["मानः"];
        यदि (मानः == शून्यम्) {
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], 0 - 1);
        } अन्यथा {
            संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, मानः);
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], मान_आईडी);
        }
        परत् 0;
    }
    यदि (प्रकार == "कठन_यदि") {
        निम्नक_यदि(संदर्भ, नोड);
        परत् 0;
    }
    यदि (प्रकार == "कठन_यावत्") {
        निम्नक_यावत्(संदर्भ, नोड);
        परत् 0;
    }
    यदि (प्रकार == "कठन_पुनरावृत्ति") {
        निम्नक_पुनरावृत्ति(संदर्भ, नोड);
        परत् 0;
    }
    यदि (प्रकार == "कठन_विराम") {
        सूची ढेर = संदर्भ["विराम_ढेर"];
        यदि (लंबाई(ढेर) > 0) {
            मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], ढेर[लंबाई(ढेर) - 1]);
        }
        परत् 0;
    }
    यदि (प्रकार == "कठन_जारी") {
        सूची ढेर = संदर्भ["जारी_ढेर"];
        यदि (लंबाई(ढेर) > 0) {
            मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], ढेर[लंबाई(ढेर) - 1]);
        }
        परत् 0;
    }
    यदि (प्रकार == "कठन_फेको" || प्रकार == "कठन_प्रक्षेपः") {
        संख्या अप = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        मध्यम_फेंको(संदर्भ["वर्तमान_खंड"], अप);
        परत् 0;
    }
    // कठन_प्रयत्न — बाद में (1b follow-up)
    परत् 0;
}

कार्य निम्नक_लिखतु(शब्दकोश संदर्भ, शब्दकोश अभि) {
    संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, अभि);   // अभि == शून्यम् → भीतर शून्यम्-स्थिर
    पाठ टैग = नि_मान_प्रकार(संदर्भ, मान_आईडी);
    पाठ लक्ष्य = "sutra_print_dynamic";
    यदि (टैग == "बूल") { लक्ष्य = "sutra_print_bool"; }
    यदि (टैग == "दशमलव") { लक्ष्य = "sutra_print_float"; }
    यदि (टैग == "शून्य") { लक्ष्य = "sutra_print_null"; }
    शब्दकोश अंश = {};
    अंश["लक्ष्य"] = लक्ष्य;
    नि_प्रभाव(संदर्भ, "बुलाओ", [मान_आईडी], अंश);
    परत् 0;
}

कार्य निम्नक_यदि(शब्दकोश संदर्भ, शब्दकोश नोड) {
    संख्या शर्त = निम्नक_अभिव्यक्ति(संदर्भ, नोड["शर्त"]);
    शब्दकोश आरंभ = संदर्भ["वर्तमान_खंड"];
    मान अन्यथा_नोड = नोड["शाखा_अन्यथा"];

    शब्दकोश सत्य_खंड = नि_नया_खंड(संदर्भ, "if_सत्य");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "if_अंत");
    शब्दकोश असत्य_खंड = अंत_खंड;
    यदि (अन्यथा_नोड != शून्यम्) {
        असत्य_खंड = नि_नया_खंड(संदर्भ, "if_असत्य");
    }
    मध्यम_यदि_जाओ(आरंभ, शर्त, सत्य_खंड["लेबल"], असत्य_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, सत्य_खंड);
    निम्नक_कथन(संदर्भ, नोड["शाखा_सत्य"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अंत_खंड["लेबल"]); }

    यदि (अन्यथा_नोड != शून्यम्) {
        नि_खंड_पर(संदर्भ, असत्य_खंड);
        निम्नक_कथन(संदर्भ, अन्यथा_नोड);
        यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अंत_खंड["लेबल"]); }
    }

    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् 0;
}

कार्य निम्नक_यावत्(शब्दकोश संदर्भ, शब्दकोश नोड) {
    शब्दकोश शर्त_खंड = नि_नया_खंड(संदर्भ, "wh_शर्त");
    शब्दकोश देह_खंड = नि_नया_खंड(संदर्भ, "wh_देह");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "wh_अंत");

    मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]);
    नि_खंड_पर(संदर्भ, शर्त_खंड);
    संख्या शर्त = निम्नक_अभिव्यक्ति(संदर्भ, नोड["शर्त"]);
    मध्यम_यदि_जाओ(संदर्भ["वर्तमान_खंड"], शर्त, देह_खंड["लेबल"], अंत_खंड["लेबल"]);

    संदर्भ["जारी_ढेर"] = जोड़ें(संदर्भ["जारी_ढेर"], शर्त_खंड["लेबल"]);
    संदर्भ["विराम_ढेर"] = जोड़ें(संदर्भ["विराम_ढेर"], अंत_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, देह_खंड);
    निम्नक_कथन(संदर्भ, नोड["देह"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]); }

    संदर्भ["जारी_ढेर"] = निकालें(संदर्भ["जारी_ढेर"]);
    संदर्भ["विराम_ढेर"] = निकालें(संदर्भ["विराम_ढेर"]);
    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् 0;
}

कार्य निम्नक_पुनरावृत्ति(शब्दकोश संदर्भ, शब्दकोश नोड) {
    // प्रारंभ; यावत् शर्त { देह; अद्यतन }
    निम्नक_कथन(संदर्भ, नोड["प्रारंभ"]);
    शब्दकोश शर्त_खंड = नि_नया_खंड(संदर्भ, "for_शर्त");
    शब्दकोश देह_खंड = नि_नया_खंड(संदर्भ, "for_देह");
    शब्दकोश अद्यतन_खंड = नि_नया_खंड(संदर्भ, "for_अद्यतन");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "for_अंत");

    मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]);
    नि_खंड_पर(संदर्भ, शर्त_खंड);
    मान शर्त_नोड = नोड["शर्त"];
    यदि (शर्त_नोड == शून्यम्) {
        मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], देह_खंड["लेबल"]);
    } अन्यथा {
        संख्या शर्त = निम्नक_अभिव्यक्ति(संदर्भ, शर्त_नोड);
        मध्यम_यदि_जाओ(संदर्भ["वर्तमान_खंड"], शर्त, देह_खंड["लेबल"], अंत_खंड["लेबल"]);
    }

    संदर्भ["जारी_ढेर"] = जोड़ें(संदर्भ["जारी_ढेर"], अद्यतन_खंड["लेबल"]);
    संदर्भ["विराम_ढेर"] = जोड़ें(संदर्भ["विराम_ढेर"], अंत_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, देह_खंड);
    निम्नक_कथन(संदर्भ, नोड["देह"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अद्यतन_खंड["लेबल"]); }

    नि_खंड_पर(संदर्भ, अद्यतन_खंड);
    निम्नक_कथन(संदर्भ, नोड["अद्यतन"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]); }

    संदर्भ["जारी_ढेर"] = निकालें(संदर्भ["जारी_ढेर"]);
    संदर्भ["विराम_ढेर"] = निकालें(संदर्भ["विराम_ढेर"]);
    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् 0;
}


