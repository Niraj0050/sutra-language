// मूल_निम्नक.सूत्र — AST → मध्यम (IR) lowering  [Phase 1b]
// ============================================================
// प्रोग्राम-नोड (विश्लेषक का output) लेकर मध्यम.सूत्र का IR एकक बनाता है।
// अभी संकलक में wire नहीं — standalone, मूल_निम्नक_परीक्षण.सूत्र से जाँचा।
//
// रणनीति: हर स्थानीय चर = एक "स्लॉट" (alloca)। पढ़ना = पढ़_स्लॉट,
// लिखना = लिख_स्लॉट। SSA-निर्माण lowering में नहीं — mem2reg pass (1c)
// स्लॉट्स को SSA मानों में बदलेगा। इससे lowering सरल रहती है।
//
// संदर्भ (lowering context) — शब्दकोश:
//   { "एकक", "फलन", "वर्तमान_खंड",
//     "चर_स्लॉट": {नाम -> {"स्लॉट":id, "प्रकार":tag}},
//     "वैश्विक": {नाम -> प्रकार-tag},
//     "कार्य_परत्": {नाम -> परत्_प्रकार-tag},
//     "विराम_ढेर": [लेबल...], "जारी_ढेर": [लेबल...],
//     "मान_प्रकार": {मान-id -> tag} }
// ============================================================

आयात "मध्यम.सूत्र";

// ---- प्रकार मानचित्रण ----

कार्य निम्नक_प्रकार_टैग(पाठ नाम) {
    यदि (नाम == "संख्या" || नाम == "पूर्णाङ्क") { परत् "पूर्ण"; }
    यदि (नाम == "दशमलव") { परत् "दशमलव"; }
    यदि (नाम == "पाठ") { परत् "पाठ"; }
    यदि (नाम == "बूल") { परत् "बूल"; }
    यदि (नाम == "सूची") { परत् "सूची"; }
    यदि (नाम == "शब्दकोश") { परत् "शब्दकोश"; }
    यदि (नाम == "शून्यम्" || नाम == "शून्य") { परत् "शून्य"; }
    यदि (नाम == "मान" || नाम == "" || नाम == शून्यम्) { परत् "मान"; }
    परत् नाम;   // वर्ग-नाम (custom प्रकार) — यथावत्
}

// ---- संदर्भ helpers ----

कार्य नि_ताजा_मान(शब्दकोश संदर्भ) {
    परत् मध्यम_ताजा_आईडी(संदर्भ["फलन"]);
}

// मान-उत्पादक निर्देश जोड़ो + उसका प्रकार रिकॉर्ड करो
कार्य नि_जोड़(शब्दकोश संदर्भ, पाठ कोड, पाठ प्रकार, सूची संचालक, शब्दकोश अंश) {
    संख्या आईडी = मध्यम_जोड़(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], कोड, प्रकार, संचालक, अंश);
    संदर्भ["मान_प्रकार"][आईडी] = प्रकार;
    परत् आईडी;
}

कार्य नि_प्रभाव(शब्दकोश संदर्भ, पाठ कोड, सूची संचालक, शब्दकोश अंश) {
    परत् मध्यम_जोड़_प्रभाव(संदर्भ["वर्तमान_खंड"], कोड, संचालक, अंश);
}

कार्य नि_मान_प्रकार(शब्दकोश संदर्भ, संख्या आईडी) {
    मान त = संदर्भ["मान_प्रकार"][आईडी];
    यदि (त == शून्यम्) { परत् "मान"; }
    परत् त;
}

कार्य नि_समाप्त_है(शब्दकोश संदर्भ) {
    परत् संदर्भ["वर्तमान_खंड"]["अंत"] != शून्यम्;
}

कार्य नि_नया_खंड(शब्दकोश संदर्भ, पाठ संकेत) {
    परत् मध्यम_नव_खंड(संदर्भ["फलन"], संकेत);
}

कार्य नि_खंड_पर(शब्दकोश संदर्भ, शब्दकोश खंड) {
    संदर्भ["वर्तमान_खंड"] = खंड;
    परत् 0;
}


// ============================================================
// अभिव्यक्ति lowering — SSA मान-id लौटाता है
// ============================================================

कार्य निम्नक_अभिव्यक्ति(शब्दकोश संदर्भ, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् मध्यम_स्थिर_शून्यम्(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"]); }
    पाठ प्रकार = नोड["नोड_प्रकारः"];

    यदि (प्रकार == "अभिव्यक्ति_स्थिरांक") {
        परत् निम्नक_स्थिरांक(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_पहचान") {
        परत् निम्नक_पहचान(संदर्भ, नोड["नाम"]);
    }
    यदि (प्रकार == "अभिव्यक्ति_द्विआधारी") {
        परत् निम्नक_द्विआधारी(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_एकल") {
        परत् निम्नक_एकल(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_कॉल") {
        परत् निम्नक_कॉल(संदर्भ, नोड);
    }
    यदि (प्रकार == "अभिव्यक्ति_अनुक्रमणिका") {
        संख्या आधार = निम्नक_अभिव्यक्ति(संदर्भ, नोड["आधार"]);
        संख्या अनु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["अनुक्रमणिका"]);
        शब्दकोश अंश = {};
        अंश["आधार_प्रकार"] = नि_मान_प्रकार(संदर्भ, आधार);
        पाठ फल_प्रकार = "मान";
        यदि (अंश["आधार_प्रकार"] == "पाठ") { फल_प्रकार = "पाठ"; }
        परत् नि_जोड़(संदर्भ, "पढ़_अनुक्रम", फल_प्रकार, [आधार, अनु], अंश);
    }
    यदि (प्रकार == "अभिव्यक्ति_सभ्य") {
        संख्या वस्तु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वस्तु"]);
        शब्दकोश अंश = {};
        अंश["क्षेत्र"] = नोड["नाम"];
        अंश["सूचकांक"] = निम्नक_क्षेत्र_सूचकांक(संदर्भ, नोड["वस्तु"], नोड["नाम"]);
        परत् नि_जोड़(संदर्भ, "पढ़_क्षेत्र", "मान", [वस्तु], अंश);
    }
    यदि (प्रकार == "अभिव्यक्ति_सूची_स्थिरांक") {
        सूची तत्व_आईडी = [];
        सूची तत्व = नोड["तत्व"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            तत्व_आईडी = जोड़ें(तत्व_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तत्व[सूचक]));
            सूचक = सूचक + 1;
        }
        परत् नि_जोड़(संदर्भ, "नव_सूची", "सूची", तत्व_आईडी, {});
    }
    यदि (प्रकार == "अभिव्यक्ति_शब्दकोश_स्थिरांक") {
        सूची जोड़े = [];
        सूची तत्व = नोड["तत्व"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            सूची युगल = तत्व[सूचक];
            जोड़े = जोड़ें(जोड़े, निम्नक_अभिव्यक्ति(संदर्भ, युगल[0]));
            जोड़े = जोड़ें(जोड़े, निम्नक_अभिव्यक्ति(संदर्भ, युगल[1]));
            सूचक = सूचक + 1;
        }
        परत् नि_जोड़(संदर्भ, "नव_शब्दकोश", "शब्दकोश", जोड़े, {});
    }
    यदि (प्रकार == "अभिव्यक्ति_स्व") {
        परत् निम्नक_पहचान(संदर्भ, "स्व");
    }
    यदि (प्रकार == "अभिव्यक्ति_नवीन") {
        सूची तर्क_आईडी = [];
        सूची तर्काः = नोड["तर्काः"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तर्काः)) {
            तर्क_आईडी = जोड़ें(तर्क_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तर्काः[सूचक]));
            सूचक = सूचक + 1;
        }
        पाठ वनाम = नोड["वर्ग_नाम"];
        संख्या क्षेत्र_गण = 0;
        यदि (संदर्भ["वर्ग_क्षेत्र"][वनाम] != शून्यम्) { क्षेत्र_गण = लंबाई(संदर्भ["वर्ग_क्षेत्र"][वनाम]); }
        शब्दकोश अंश = {};
        अंश["वर्ग"] = वनाम;
        अंश["क्षेत्र_गण"] = क्षेत्र_गण;
        अंश["रचना"] = वनाम + "_रचना";
        परत् नि_जोड़(संदर्भ, "नव_वस्तु", वनाम, तर्क_आईडी, अंश);
    }
    यदि (प्रकार == "अभिव्यक्ति_विधि_कॉल") {
        संख्या वस्तु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वस्तु"]);
        सूची तर्क_आईडी = [वस्तु];
        सूची तर्काः = नोड["तर्काः"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तर्काः)) {
            तर्क_आईडी = जोड़ें(तर्क_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तर्काः[सूचक]));
            सूचक = सूचक + 1;
        }
        पाठ ववर्ग = निम्नक_वस्तु_वर्ग(संदर्भ, नोड["वस्तु"]);
        शब्दकोश अंश = {};
        अंश["लक्ष्य"] = "वर्ग_" + ववर्ग + "_" + नोड["नाम"];
        परत् नि_जोड़(संदर्भ, "बुलाओ", "मान", तर्क_आईडी, अंश);
    }

    // अज्ञात — शून्यम् स्थिरांक (सुरक्षित fallback)
    परत् मध्यम_स्थिर_शून्यम्(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"]);
}

कार्य निम्नक_स्थिरांक(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ कप = नोड["स्थिरांक_प्रकारः"];
    पाठ मव = नोड["मानः"];
    यदि (कप == "पाठ") {
        संख्या पआईडी = मध्यम_स्थिर_पाठ(संदर्भ["एकक"], संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], मव);
        संदर्भ["मान_प्रकार"][पआईडी] = "पाठ";
        परत् पआईडी;
    }
    यदि (कप == "बूल") {
        मान ब = असत्य;
        यदि (मव == "सत्य") { ब = सत्य; }
        संख्या आईडी = मध्यम_स्थिर_बूल(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], ब);
        संदर्भ["मान_प्रकार"][आईडी] = "बूल";
        परत् आईडी;
    }
    यदि (कप == "शून्यम्") {
        संख्या शआईडी = मध्यम_स्थिर_शून्यम्(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"]);
        संदर्भ["मान_प्रकार"][शआईडी] = "शून्य";
        परत् शआईडी;
    }
    यदि (कप == "दशमलव") {
        शब्दकोश अंश = {};
        अंश["मान_प्रकार"] = "दशमलव";
        अंश["मान"] = मव;
        परत् नि_जोड़(संदर्भ, "स्थिर", "दशमलव", [], अंश);
    }
    // पूर्णाङ्क / संख्या
    संख्या आईडी = मध्यम_स्थिर_पूर्ण(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], अंक_से_पूर्ण(मव));
    संदर्भ["मान_प्रकार"][आईडी] = "पूर्ण";
    परत् आईडी;
}

// पाठ → पूर्णांक (सरल; ऋण-चिह्न सहित)
कार्य अंक_से_पूर्ण(पाठ स) {
    संख्या मानः = 0;
    संख्या सूचक = 0;
    मान ऋण = असत्य;
    यदि (लंबाई(स) > 0) {
        यदि (स[0] == "-") { ऋण = सत्य; सूचक = 1; }
    }
    यावत् (सूचक < लंबाई(स)) {
        संख्या क = अक्षर_मान(स[सूचक]);
        यदि (क >= 48 && क <= 57) {
            मानः = मानः * 10 + (क - 48);
        }
        सूचक = सूचक + 1;
    }
    यदि (ऋण) { परत् 0 - मानः; }
    परत् मानः;
}

// वस्तु-अभिव्यक्ति का static वर्ग-नाम (न मिले तो "अजनक")
कार्य निम्नक_वस्तु_वर्ग(शब्दकोश संदर्भ, शब्दकोश वस्तु_नोड) {
    यदि (वस्तु_नोड == शून्यम्) { परत् "अजनक"; }
    पाठ पप = वस्तु_नोड["नोड_प्रकारः"];
    यदि (पप == "अभिव्यक्ति_स्व") {
        यदि (संदर्भ["चालू_वर्ग"] != "") { परत् संदर्भ["चालू_वर्ग"]; }
        परत् "अजनक";
    }
    यदि (पप == "अभिव्यक्ति_पहचान") {
        पाठ वनाम = वस्तु_नोड["नाम"];
        मान स्लॉट = संदर्भ["चर_स्लॉट"][वनाम];
        यदि (स्लॉट != शून्यम्) {
            यदि (स्लॉट["प्रकार"] != शून्यम्) { परत् स्लॉट["प्रकार"]; }
        }
        // वैश्विक चर का inferred वर्ग
        मान गप्र = संदर्भ["वैश्विक"][वनाम];
        यदि (गप्र != शून्यम्) {
            यदि (गप्र != "मान" && गप्र != "पूर्ण" && गप्र != "पाठ" && गप्र != "बूल"
                 && गप्र != "सूची" && गप्र != "शब्दकोश" && गप्र != "दशमलव" && गप्र != "शून्य") {
                परत् गप्र;
            }
        }
    }
    यदि (पप == "अभिव्यक्ति_नवीन") { परत् वस्तु_नोड["वर्ग_नाम"]; }
    परत् "अजनक";
}

कार्य निम्नक_वर्ग_प्रकार_है(शब्दकोश संदर्भ, पाठ टैग) {
    यदि (संदर्भ["वर्ग_क्षेत्र"][टैग] != शून्यम्) { परत् सत्य; }
    परत् असत्य;
}

// क्षेत्र-नाम → वस्तु-विन्यास में सूचकांक
कार्य निम्नक_क्षेत्र_सूचकांक(शब्दकोश संदर्भ, शब्दकोश वस्तु_नोड, पाठ क्षेत्र_नाम) {
    पाठ ववर्ग = निम्नक_वस्तु_वर्ग(संदर्भ, वस्तु_नोड);
    मान क्षेत्र_सू = संदर्भ["वर्ग_क्षेत्र"][ववर्ग];
    यदि (क्षेत्र_सू != शून्यम्) {
        संख्या इक = 0;
        यावत् (इक < लंबाई(क्षेत्र_सू)) {
            यदि (क्षेत्र_सू[इक] == क्षेत्र_नाम) { परत् इक; }
            इक = इक + 1;
        }
    }
    परत् 0;   // fallback
}

कार्य निम्नक_पहचान(शब्दकोश संदर्भ, पाठ नाम) {
    मान स्लॉट = संदर्भ["चर_स्लॉट"][नाम];
    यदि (स्लॉट != शून्यम्) {
        परत् नि_जोड़(संदर्भ, "पढ़_स्लॉट", स्लॉट["प्रकार"], [स्लॉट["स्लॉट"]], {});
    }
    // वैश्विक
    मान गप्र = संदर्भ["वैश्विक"][नाम];
    पाठ टैग = "मान";
    यदि (गप्र != शून्यम्) { टैग = गप्र; }
    शब्दकोश अंश = {};
    अंश["नाम"] = नाम;
    परत् नि_जोड़(संदर्भ, "पढ़_वैश्विक", टैग, [], अंश);
}

// अनुमानित परिणाम-प्रकार (द्विआधारी)
कार्य निम्नक_द्विआधारी_प्रकार(पाठ सञ्चालक, पाठ बायाँ, पाठ दायाँ) {
    यदि (सञ्चालक == "समानता (==)" || सञ्चालक == "असमानता (!=)"
        || सञ्चालक == "लघुतर (<)" || सञ्चालक == "गुरुतर (>)"
        || सञ्चालक == "लघुतर-समान (<=)" || सञ्चालक == "गुरुतर-समान (>=)"
        || सञ्चालक == "तथा-संयोजक (&&)" || सञ्चालक == "अथवा-संयोजक (||)"
        || सञ्चालक == "मुख्यशब्द_तथा" || सञ्चालक == "मुख्यशब्द_अथवा") {
        परत् "बूल";
    }
    यदि (सञ्चालक == "धन (+)") {
        यदि (बायाँ == "पाठ" || दायाँ == "पाठ") { परत् "पाठ"; }
    }
    यदि (बायाँ == "दशमलव" || दायाँ == "दशमलव") { परत् "दशमलव"; }
    यदि (बायाँ == "पूर्ण" && दायाँ == "पूर्ण") { परत् "पूर्ण"; }
    परत् "मान";
}

कार्य निम्नक_संचालक_कोड(पाठ सञ्चालक) {
    यदि (सञ्चालक == "धन (+)") { परत् "योग"; }
    यदि (सञ्चालक == "ऋण (-)") { परत् "अंतर"; }
    यदि (सञ्चालक == "गुणा (*)") { परत् "गुणा"; }
    यदि (सञ्चालक == "भाग (/)") { परत् "भाग"; }
    यदि (सञ्चालक == "शेष (%)") { परत् "शेष"; }
    यदि (सञ्चालक == "समानता (==)") { परत् "सम"; }
    यदि (सञ्चालक == "असमानता (!=)") { परत् "असम"; }
    यदि (सञ्चालक == "लघुतर (<)") { परत् "लघु"; }
    यदि (सञ्चालक == "गुरुतर (>)") { परत् "गुरु"; }
    यदि (सञ्चालक == "लघुतर-समान (<=)") { परत् "लघुसम"; }
    यदि (सञ्चालक == "गुरुतर-समान (>=)") { परत् "गुरुसम"; }
    परत् "योग";
}

// स्थिर-रूप से ज्ञात प्रकार वाले मान को पाठ-मान में बदलो (str-concat हेतु)।
// अज्ञात ("मान") या पहले से पाठ → अपरिवर्तित (add_dynamic संभालेगा / ज़रूरत नहीं)।
कार्य निम्नक_पाठ_में_बदलो(शब्दकोश संदर्भ, संख्या आईडी, पाठ टैग) {
    यदि (टैग == "बूल") {
        शब्दकोश अ = {};
        अ["लक्ष्य"] = "बूल_से_पाठ";
        परत् नि_जोड़(संदर्भ, "बुलाओ", "पाठ", [आईडी], अ);
    }
    यदि (टैग == "शून्य") {
        शब्दकोश अ = {};
        अ["लक्ष्य"] = "शून्य_से_पाठ";
        परत् नि_जोड़(संदर्भ, "बुलाओ", "पाठ", [], अ);
    }
    यदि (टैग == "दशमलव") {
        शब्दकोश अ = {};
        अ["लक्ष्य"] = "sutra_float_to_str";
        परत् नि_जोड़(संदर्भ, "बुलाओ", "पाठ", [आईडी], अ);
    }
    परत् आईडी;
}

कार्य निम्नक_द्विआधारी(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ सञ्चालक = नोड["सञ्चालक"];

    // && / || — short-circuit (शाखाएँ + फाई)
    यदि (सञ्चालक == "तथा-संयोजक (&&)" || सञ्चालक == "मुख्यशब्द_तथा") {
        परत् निम्नक_लघुपथ(संदर्भ, नोड["वाम"], नोड["दक्षिण"], सत्य);
    }
    यदि (सञ्चालक == "अथवा-संयोजक (||)" || सञ्चालक == "मुख्यशब्द_अथवा") {
        परत् निम्नक_लघुपथ(संदर्भ, नोड["वाम"], नोड["दक्षिण"], असत्य);
    }

    संख्या बायाँ_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वाम"]);
    संख्या दायाँ_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["दक्षिण"]);
    पाठ बत = नि_मान_प्रकार(संदर्भ, बायाँ_आईडी);
    पाठ दत = नि_मान_प्रकार(संदर्भ, दायाँ_आईडी);
    पाठ परिणाम_प्रकार = निम्नक_द्विआधारी_प्रकार(सञ्चालक, बत, दत);
    पाठ कोड = निम्नक_संचालक_कोड(सञ्चालक);

    // पाठ + (बूल|शून्य|दशमलव): non-पाठ operand को स्थिर-रूप से पाठ में
    // बदलो, फिर sutra_str_concat — sutra_add_dynamic बूल/शून्य/f64-bits को
    // सादा पूर्णांक मान लेता ("1"/"0"/कचरा), interpreter "सत्य"/"शून्यम्"/"1.5"।
    यदि (कोड == "योग") {
        यदि (बत == "पाठ" || दत == "पाठ") {
            यदि (बत != "पाठ") {
                बायाँ_आईडी = निम्नक_पाठ_में_बदलो(संदर्भ, बायाँ_आईडी, बत);
                बत = नि_मान_प्रकार(संदर्भ, बायाँ_आईडी);
            }
            यदि (दत != "पाठ") {
                दायाँ_आईडी = निम्नक_पाठ_में_बदलो(संदर्भ, दायाँ_आईडी, दत);
                दत = नि_मान_प्रकार(संदर्भ, दायाँ_आईडी);
            }
        }
    }

    // विधि-संकेत: उत्सर्जक को बताओ int/float/पाठ/dynamic
    पाठ विधि = "पूर्ण";
    यदि (बत == "पाठ" && दत == "पाठ") { विधि = "पाठ"; }
    अन्यथा यदि (बत == "पाठ" || दत == "पाठ") { विधि = "मान"; }   // मिश्रित → add_dynamic
    अन्यथा यदि (बत == "दशमलव" || दत == "दशमलव") { विधि = "दशमलव"; }
    अन्यथा यदि (बत == "मान" || दत == "मान") { विधि = "मान"; }

    // दशमलव मिश्रण: पूर्ण operand → int_to_float
    यदि (विधि == "दशमलव") {
        यदि (बत == "पूर्ण") {
            शब्दकोश पअंश = {};
            पअंश["लक्ष्य"] = "sutra_int_to_float";
            बायाँ_आईडी = नि_जोड़(संदर्भ, "बुलाओ", "दशमलव", [बायाँ_आईडी], पअंश);
        }
        यदि (दत == "पूर्ण") {
            शब्दकोश पअंश = {};
            पअंश["लक्ष्य"] = "sutra_int_to_float";
            दायाँ_आईडी = नि_जोड़(संदर्भ, "बुलाओ", "दशमलव", [दायाँ_आईडी], पअंश);
        }
    }
    शब्दकोश अंश = {};
    अंश["विधि"] = विधि;
    परत् नि_जोड़(संदर्भ, कोड, परिणाम_प्रकार, [बायाँ_आईडी, दायाँ_आईडी], अंश);
}

// लघुपथ: तथा_है सत्य => &&, असत्य => ||
// आरंभ → (यदि_जाओ) → दायाँ_खंड | लघु_खंड ; दोनों → अंत_खंड (फाई)
// लघु_खंड एक समर्पित ब्लॉक है जो सिर्फ़ लघु-परिपथ स्थिरांक रखता — पहले
// स्थिरांक आरंभ_खंड में terminator के बाद जोड़ा जाता था (bug: emitter/regalloc
// उलझते थे → garbage phi source)।
कार्य निम्नक_लघुपथ(शब्दकोश संदर्भ, शब्दकोश वाम, शब्दकोश दक्षिण, मान तथा_है) {
    संख्या ला = निम्नक_अभिव्यक्ति(संदर्भ, वाम);
    शब्दकोश आरंभ_खंड = संदर्भ["वर्तमान_खंड"];
    शब्दकोश दायाँ_खंड = नि_नया_खंड(संदर्भ, "sc_दायाँ");
    शब्दकोश लघु_खंड = नि_नया_खंड(संदर्भ, "sc_लघु");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "sc_अंत");

    यदि (तथा_है) {
        मध्यम_यदि_जाओ(आरंभ_खंड, ला, दायाँ_खंड["लेबल"], लघु_खंड["लेबल"]);
    } अन्यथा {
        मध्यम_यदि_जाओ(आरंभ_खंड, ला, लघु_खंड["लेबल"], दायाँ_खंड["लेबल"]);
    }

    // लघु-परिपथ शाखा: स्थिरांक ( && => असत्य, || => सत्य ) फिर अंत को
    नि_खंड_पर(संदर्भ, लघु_खंड);
    मान लप_मान = सत्य;
    यदि (तथा_है) { लप_मान = असत्य; }
    संख्या स्थिर_आईडी = मध्यम_स्थिर_बूल(संदर्भ["फलन"], लघु_खंड, लप_मान);
    मध्यम_जाओ(लघु_खंड, अंत_खंड["लेबल"]);

    // दायाँ शाखा: दक्षिण का मूल्यांकन
    नि_खंड_पर(संदर्भ, दायाँ_खंड);
    संख्या लब = निम्नक_अभिव्यक्ति(संदर्भ, दक्षिण);
    शब्दकोश दायाँ_अंत = संदर्भ["वर्तमान_खंड"];
    मध्यम_जाओ(दायाँ_अंत, अंत_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, अंत_खंड);
    सूची स्रोत = [[लघु_खंड["लेबल"], स्थिर_आईडी], [दायाँ_अंत["लेबल"], लब]];
    संख्या फल = मध्यम_फाई(संदर्भ["फलन"], अंत_खंड, "बूल", स्रोत);
    संदर्भ["मान_प्रकार"][फल] = "बूल";
    परत् फल;
}

कार्य निम्नक_एकल(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ सञ्चालक = नोड["सञ्चालक"];
    संख्या भीतर = निम्नक_अभिव्यक्ति(संदर्भ, नोड["संख्या"]);
    यदि (सञ्चालक == "ऋण (-)") {
        पाठ त = नि_मान_प्रकार(संदर्भ, भीतर);
        यदि (त != "दशमलव") { त = "पूर्ण"; }
        परत् नि_जोड़(संदर्भ, "ऋणात्मक", त, [भीतर], {});
    }
    // न (not)
    परत् नि_जोड़(संदर्भ, "नकार", "बूल", [भीतर], {});
}

कार्य निम्नक_कॉल(शब्दकोश संदर्भ, शब्दकोश नोड) {
    पाठ नाम = नोड["नाम"];
    सूची तर्क_आईडी = [];
    सूची तर्काः = नोड["तर्काः"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः)) {
        तर्क_आईडी = जोड़ें(तर्क_आईडी, निम्नक_अभिव्यक्ति(संदर्भ, तर्काः[सूचक]));
        सूचक = सूचक + 1;
    }
    // अंतर्_* = intrinsic
    यदि (लंबाई(नाम) >= 6) {
        यदि (उपखंड(नाम, 0, 6) == "अंतर्_") {
            शब्दकोश अंश = {};
            अंश["नाम"] = नाम;
            परत् नि_जोड़(संदर्भ, "अंतर्", "पूर्ण", तर्क_आईडी, अंश);
        }
    }
    // लंबाई → दैशिक_लंबाई (special)
    यदि (नाम == "लंबाई") {
        परत् नि_जोड़(संदर्भ, "लंबाई", "पूर्ण", तर्क_आईडी, {});
    }
    // प्रकार(x) — static रूप से ज्ञात हो तो पाठ-स्थिरांक में fold
    यदि (नाम == "प्रकार" && लंबाई(तर्क_आईडी) == 1) {
        पाठ अत = नि_मान_प्रकार(संदर्भ, तर्क_आईडी[0]);
        पाठ नामप = निम्नक_प्रकार_का_नाम(अत);
        यदि (नामप != "") {
            संख्या पिड = मध्यम_स्थिर_पाठ(संदर्भ["एकक"], संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], नामप);
            संदर्भ["मान_प्रकार"][पिड] = "पाठ";
            परत् पिड;
        }
        शब्दकोश अंश = {};
        अंश["लक्ष्य"] = "sutra_dynamic_type";
        परत् नि_जोड़(संदर्भ, "बुलाओ", "पाठ", तर्क_आईडी, अंश);
    }
    // builtin → C-runtime symbol
    पाठ लक्ष्य_नाम = निम्नक_कॉल_लक्ष्य(नाम);
    मान परत्_त = संदर्भ["कार्य_परत्"][नाम];
    पाठ टैग = "मान";
    यदि (परत्_त != शून्यम्) {
        टैग = परत्_त;   // उपयोगकर्ता-कार्य / विधि
    } अन्यथा {
        पाठ बिल्टिन_त = निम्नक_अंतर्निहित_परत्(नाम);
        यदि (बिल्टिन_त != "") { टैग = बिल्टिन_त; }
    }
    शब्दकोश अंश = {};
    अंश["लक्ष्य"] = लक्ष्य_नाम;
    परत् नि_जोड़(संदर्भ, "बुलाओ", टैग, तर्क_आईडी, अंश);
}

// अंतर्निहित (builtin) कार्य का परत्-प्रकार। float-गणित builtins `_f` संस्करण
// पर mapped हैं → परिणाम f64-bits है; "दशमलव" टैग के बिना लिखतु/जोड़ इसे कच्चा
// पूर्णांक मान लेता। अज्ञात → "" (→ "मान")।
कार्य निम्नक_अंतर्निहित_परत्(पाठ नाम) {
    यदि (नाम == "वर्गमूल" || नाम == "घात" || नाम == "निरपेक्ष"
        || नाम == "न्यूनतम" || नाम == "अधिकतम") {
        परत् "दशमलव";
    }
    यदि (नाम == "गोल") { परत् "पूर्ण"; }   // sutra_math_round_f असल पूर्णांक लौटाता
    परत् "";
}

// प्रकार-टैग → सूत्र प्रकार-नाम (प्रकार() के लिए); अज्ञात → ""
कार्य निम्नक_प्रकार_का_नाम(पाठ टैग) {
    यदि (टैग == "पूर्ण") { परत् "संख्या"; }
    यदि (टैग == "दशमलव") { परत् "दशमलव"; }
    यदि (टैग == "पाठ") { परत् "पाठ"; }
    यदि (टैग == "बूल") { परत् "बूल"; }
    यदि (टैग == "शून्य") { परत् "शून्यम्"; }
    यदि (टैग == "सूची") { परत् "सूची"; }
    यदि (टैग == "शब्दकोश") { परत् "शब्दकोश"; }
    परत् "";
}

// सूत्र builtin नाम → C-runtime / सूत्र-runtime symbol
कार्य निम्नक_कॉल_लक्ष्य(पाठ नाम) {
    यदि (नाम == "लिखतु" || नाम == "दर्शयतु" || नाम == "पंक्तिं") { परत् "sutra_print_dynamic"; }
    यदि (नाम == "प्रकार") { परत् "sutra_dynamic_type"; }
    यदि (नाम == "तर्काः") { परत् "sutra_args_get"; }
