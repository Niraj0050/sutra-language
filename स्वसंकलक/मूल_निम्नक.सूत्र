// कथन lowering
// ============================================================

कार्य निम्नक_कथन(शब्दकोश संदर्भ, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) { परत् ०; }
    यदि (नि_समाप्त_है(संदर्भ)) { परत् ०; }   // dead code — छोड़ो
    पाठ प्रकार = नोड["नोड_प्रकारः"];

    यदि (प्रकार == "कठन_ब्लॉक") {
        सूची कसू = नोड["कठन_सूची"];
        संख्या सूचक = ०;
        यावत् (सूचक < लंबाई(कसू)) {
            निम्नक_कथन(संदर्भ, कसू[सूचक]);
            सूचक = सूचक + १;
        }
        परत् ०;
    }
    यदि (प्रकार == "कठन_चर_घोषणा") {
        पाठ नाम = नोड["नाम"];
        पाठ टैग = निम्नक_प्रकार_टैग(नोड["प्रकार_नाम"]);
        // शीर्ष-स्तर पर घोषित वैश्विक चर का initializer → लिख_वैश्विक (slot नहीं)
        यदि (संदर्भ["शीर्ष_स्तर"] == सत्य && संदर्भ["वैश्विक"][नाम] != शून्यम्) {
            मान प्रा = नोड["प्रारंभिक"];
            यदि (प्रा != शून्यम्) {
                संख्या मआ = ०;
                यदि (टैग == "दशमलव") { मआ = निम्नक_अभिव्यक्ति_दशम(संदर्भ, प्रा); }
                अन्यथा { मआ = निम्नक_अभिव्यक्ति(संदर्भ, प्रा); }
                // initializer से वैश्विक का प्रकार सुधारो (वर्ग-प्रकार के लिए)
                यदि (टैग == "मान") {
                    संदर्भ["वैश्विक"][नाम] = नि_मान_प्रकार(संदर्भ, मआ);
                }
                शब्दकोश अंश = {};
                अंश["नाम"] = नाम;
                नि_प्रभाव(संदर्भ, "लिख_वैश्विक", [मआ], अंश);
            }
            परत् ०;
        }
        संख्या स्लॉट_आईडी = मध्यम_स्लॉट(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], नाम);
        शब्दकोश जानकारी = {};
        जानकारी["स्लॉट"] = स्लॉट_आईडी;
        जानकारी["प्रकार"] = टैग;
        // स्पष्ट-घोषित दशमलव (initializer से अनुमानित नहीं) — दशमलव-संदर्भ अंकगणित हेतु
        यदि (टैग == "दशमलव") { जानकारी["घोषित_दशमलव"] = सत्य; }
        संदर्भ["चर_स्लॉट"][नाम] = जानकारी;
        मान प्रारंभिक = नोड["प्रारंभिक"];
        यदि (प्रारंभिक != शून्यम्) {
            संख्या मान_आईडी = ०;
            यदि (टैग == "दशमलव") { मान_आईडी = निम्नक_अभिव्यक्ति_दशम(संदर्भ, प्रारंभिक); }
            अन्यथा { मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, प्रारंभिक); }
            पाठ मत = नि_मान_प्रकार(संदर्भ, मान_आईडी);
            // घोषित प्रकार चाहे कुछ भी — null/वर्ग initializer से सुधारो
            यदि (टैग == "मान" || मत == "शून्य" || (मत != "मान" && निम्नक_वर्ग_प्रकार_है(संदर्भ, मत))) {
                जानकारी["प्रकार"] = मत;
                संदर्भ["चर_स्लॉट"][नाम] = जानकारी;
            }
            नि_प्रभाव(संदर्भ, "लिख_स्लॉट", [स्लॉट_आईडी, मान_आईडी], {});
        }
        परत् ०;
    }
    यदि (प्रकार == "कठन_असाइनमेंट") {
        पाठ नाम = नोड["नाम"];
        मान स्लॉट = संदर्भ["चर_स्लॉट"][नाम];
        संख्या मान_आईडी = ०;
        यदि (स्लॉट != शून्यम् && स्लॉट["घोषित_दशमलव"] == सत्य) {
            मान_आईडी = निम्नक_अभिव्यक्ति_दशम(संदर्भ, नोड["मानः"]);
        } अन्यथा {
            मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        }
        यदि (स्लॉट != शून्यम्) {
            नि_प्रभाव(संदर्भ, "लिख_स्लॉट", [स्लॉट["स्लॉट"], मान_आईडी], {});
        } अन्यथा {
            शब्दकोश अंश = {};
            अंश["नाम"] = नाम;
            नि_प्रभाव(संदर्भ, "लिख_वैश्विक", [मान_आईडी], अंश);
        }
        परत् ०;
    }
    यदि (प्रकार == "कठन_अनुक्रमणिका_असाइनमेंट") {
        संख्या आधार = निम्नक_पहचान(संदर्भ, नोड["नाम"]);
        सूची अनु_सूची = नोड["अनुक्रमणिका_सूची"];
        // बहु-स्तर a[i][j] = v  →  क्रमिक पढ़_अनुक्रम, अंतिम लिख_अनुक्रम
        संख्या सूचक = ०;
        यावत् (सूचक < लंबाई(अनु_सूची) - १) {
            संख्या अनु = निम्नक_अभिव्यक्ति(संदर्भ, अनु_सूची[सूचक]);
            आधार = नि_जोड़(संदर्भ, "पढ़_अनुक्रम", "मान", [आधार, अनु], {});
            सूचक = सूचक + १;
        }
        संख्या अंतिम_अनु = निम्नक_अभिव्यक्ति(संदर्भ, अनु_सूची[लंबाई(अनु_सूची) - १]);
        संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        नि_प्रभाव(संदर्भ, "लिख_अनुक्रम", [आधार, अंतिम_अनु, मान_आईडी], {});
        परत् ०;
    }
    यदि (प्रकार == "कठन_सभ्य_असाइनमेंट") {
        संख्या वस्तु = निम्नक_अभिव्यक्ति(संदर्भ, नोड["वस्तु"]);
        संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, नोड["मानः"]);
        शब्दकोश अंश = {};
        अंश["क्षेत्र"] = नोड["नाम"];
        अंश["सूचकांक"] = निम्नक_क्षेत्र_सूचकांक(संदर्भ, नोड["वस्तु"], नोड["नाम"]);
        नि_प्रभाव(संदर्भ, "लिख_क्षेत्र", [वस्तु, मान_आईडी], अंश);
        परत् ०;
    }
    यदि (प्रकार == "कठन_अभिव्यक्ति") {
        निम्नक_अभिव्यक्ति(संदर्भ, नोड["अभिव्यक्ति"]);
        परत् ०;
    }
    यदि (प्रकार == "कठन_लिखतु") {
        निम्नक_लिखतु(संदर्भ, नोड["अभिव्यक्ति"]);
        परत् ०;
    }
    यदि (प्रकार == "कठन_परत्") {
        मान मानः = नोड["मानः"];
        यदि (मानः == शून्यम्) {
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], ० - १);
        } अन्यथा {
            संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, मानः);
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], मान_आईडी);
        }
        परत् ०;
    }
    यदि (प्रकार == "कठन_यदि") {
        निम्नक_यदि(संदर्भ, नोड);
        परत् ०;
    }
    यदि (प्रकार == "कठन_यावत्") {
        निम्नक_यावत्(संदर्भ, नोड);
        परत् ०;
    }
    यदि (प्रकार == "कठन_पुनरावृत्ति") {
        निम्नक_पुनरावृत्ति(संदर्भ, नोड);
        परत् ०;
    }
    यदि (प्रकार == "कठन_विराम") {
        सूची ढेर = संदर्भ["विराम_ढेर"];
        यदि (लंबाई(ढेर) > ०) {
            मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], ढेर[लंबाई(ढेर) - १]);
        }
        परत् ०;
    }
    यदि (प्रकार == "कठन_जारी") {
        सूची ढेर = संदर्भ["जारी_ढेर"];
        यदि (लंबाई(ढेर) > ०) {
            मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], ढेर[लंबाई(ढेर) - १]);
        }
        परत् ०;
    }
    यदि (प्रकार == "कठन_फेको" || प्रकार == "कठन_प्रक्षेपः") {
        मान फे_अभि = नोड["अभिव्यक्ति"];
        यदि (फे_अभि == शून्यम्) { फे_अभि = नोड["मानः"]; }
        संख्या अप = निम्नक_अभिव्यक्ति(संदर्भ, फे_अभि);
        मध्यम_फेंको(संदर्भ["वर्तमान_खंड"], अप);
        परत् ०;
    }
    यदि (प्रकार == "कठन_प्रयत्न") {
        निम्नक_प्रयत्न(संदर्भ, नोड);
        परत् ०;
    }
    परत् ०;
}

// प्रयत्न / पकड़ो — रनटाइम setjmp/longjmp ABI पर।
//   jbuf = sutra_exception_get_jmp_buf()      (try_stack push + gc_roots_count सहेजो)
//   sjr  = _setjmp(jbuf, ०)                   (० = सीधा, ≠० = longjmp वापसी)
//   यदि_जाओ sjr≠० → पकड़ो_खंड : प्रयत्न_खंड
//   प्रयत्न_खंड: <देह> ; सामान्य निकास पर sutra_exception_pop ; जाओ अंत
//   पकड़ो_खंड: e = sutra_get_exception_value() → स्लॉट ; <देह> ; जाओ अंत
// पकड़ो_खंड का एकमात्र CFG पूर्ववर्ती setjmp-खंड है — इसलिए mem2reg पकड़ो
// में पढ़े गए बाहरी चरों को try-से-पहले वाला मान देता (longjmp के बाद
// callee-saved रजिस्टर/spill वैसे भी उसी मान पर restore होते)।
// सीमा (पुराने codegen जैसी): try-देह के अंदर सीधा `परत्` exception frame
// pop नहीं करता — driver इस राह पर नहीं जाता।
कार्य निम्नक_प्रयत्न(शब्दकोश संदर्भ, शब्दकोश नोड) {
    शब्दकोश ज_अंश = {};
    ज_अंश["लक्ष्य"] = "अपवाद_बफ_लो";   // मूल_रनटाइम.सूत्र (§2m)
    संख्या जबफ = नि_जोड़(संदर्भ, "बुलाओ", "मान", [], ज_अंश);

    संख्या शून्य_आईडी = मध्यम_स्थिर_पूर्ण(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], ०);
    शब्दकोश स_अंश = {};
    स_अंश["लक्ष्य"] = "_setjmp";
    संख्या सजर = नि_जोड़(संदर्भ, "बुलाओ", "पूर्ण", [जबफ, शून्य_आईडी], स_अंश);

    शब्दकोश सेट_खंड = संदर्भ["वर्तमान_खंड"];
    शब्दकोश प्रयत्न_खंड = नि_नया_खंड(संदर्भ, "try_देह");
    शब्दकोश पकड़ो_खंड = नि_नया_खंड(संदर्भ, "try_पकड़ो");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "try_अंत");

    मध्यम_यदि_जाओ(सेट_खंड, सजर, पकड़ो_खंड["लेबल"], प्रयत्न_खंड["लेबल"]);

    // --- प्रयत्न देह ---
    नि_खंड_पर(संदर्भ, प्रयत्न_खंड);
    निम्नक_कथन(संदर्भ, नोड["प्रयत्न_ब्लॉक"]);
    यदि (न नि_समाप्त_है(संदर्भ)) {
        शब्दकोश प_अंश = {};
        प_अंश["लक्ष्य"] = "अपवाद_पॉप";
        नि_प्रभाव(संदर्भ, "बुलाओ", [], प_अंश);
        मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अंत_खंड["लेबल"]);
    }

    // --- पकड़ो देह ---
    नि_खंड_पर(संदर्भ, पकड़ो_खंड);
    शब्दकोश ग_अंश = {};
    ग_अंश["लक्ष्य"] = "सक्रिय_अपवाद_लो";
    संख्या त्रुटि_मान = नि_जोड़(संदर्भ, "बुलाओ", "मान", [], ग_अंश);
    मान त्रुटि_चर = नोड["त्रुटि_चर"];
    यदि (त्रुटि_चर != शून्यम् && त्रुटि_चर != "") {
        संख्या स्लॉट_आईडी = मध्यम_स्लॉट(संदर्भ["फलन"], संदर्भ["वर्तमान_खंड"], त्रुटि_चर);
        शब्दकोश जानकारी = {};
        जानकारी["स्लॉट"] = स्लॉट_आईडी;
        जानकारी["प्रकार"] = "मान";
        संदर्भ["चर_स्लॉट"][त्रुटि_चर] = जानकारी;
        नि_प्रभाव(संदर्भ, "लिख_स्लॉट", [स्लॉट_आईडी, त्रुटि_मान], {});
    }
    निम्नक_कथन(संदर्भ, नोड["पकड़ो_ब्लॉक"]);
    यदि (न नि_समाप्त_है(संदर्भ)) {
        मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अंत_खंड["लेबल"]);
    }

    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् ०;
}

कार्य निम्नक_लिखतु(शब्दकोश संदर्भ, शब्दकोश अभि) {
    संख्या मान_आईडी = निम्नक_अभिव्यक्ति(संदर्भ, अभि);   // अभि == शून्यम् → भीतर शून्यम्-स्थिर
    पाठ टैग = नि_मान_प्रकार(संदर्भ, मान_आईडी);
    पाठ लक्ष्य = "गतिशील_छापो";
    यदि (टैग == "बूल") { लक्ष्य = "बूल_छापो"; }
    यदि (टैग == "दशमलव") { लक्ष्य = "दशमलव_छापो"; }   // मूल_रनटाइम.सूत्र (पूर्व C)
    यदि (टैग == "शून्य") { लक्ष्य = "शून्य_छापो"; }
    शब्दकोश अंश = {};
    अंश["लक्ष्य"] = लक्ष्य;
    नि_प्रभाव(संदर्भ, "बुलाओ", [मान_आईडी], अंश);
    परत् ०;
}

कार्य निम्नक_यदि(शब्दकोश संदर्भ, शब्दकोश नोड) {
    संख्या शर्त = निम्नक_अभिव्यक्ति(संदर्भ, नोड["शर्त"]);
    शब्दकोश आरंभ = संदर्भ["वर्तमान_खंड"];
    मान अन्यथा_नोड = नोड["शाखा_अन्यथा"];

    शब्दकोश सत्य_खंड = नि_नया_खंड(संदर्भ, "if_सत्य");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "if_अंत");
    शब्दकोश असत्य_खंड = अंत_खंड;
    यदि (अन्यथा_नोड != शून्यम्) {
        असत्य_खंड = नि_नया_खंड(संदर्भ, "if_असत्य");
    }
    मध्यम_यदि_जाओ(आरंभ, शर्त, सत्य_खंड["लेबल"], असत्य_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, सत्य_खंड);
    निम्नक_कथन(संदर्भ, नोड["शाखा_सत्य"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अंत_खंड["लेबल"]); }

    यदि (अन्यथा_नोड != शून्यम्) {
        नि_खंड_पर(संदर्भ, असत्य_खंड);
        निम्नक_कथन(संदर्भ, अन्यथा_नोड);
        यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अंत_खंड["लेबल"]); }
    }

    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् ०;
}

कार्य निम्नक_यावत्(शब्दकोश संदर्भ, शब्दकोश नोड) {
    शब्दकोश शर्त_खंड = नि_नया_खंड(संदर्भ, "wh_शर्त");
    शब्दकोश देह_खंड = नि_नया_खंड(संदर्भ, "wh_देह");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "wh_अंत");

    मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]);
    नि_खंड_पर(संदर्भ, शर्त_खंड);
    संख्या शर्त = निम्नक_अभिव्यक्ति(संदर्भ, नोड["शर्त"]);
    मध्यम_यदि_जाओ(संदर्भ["वर्तमान_खंड"], शर्त, देह_खंड["लेबल"], अंत_खंड["लेबल"]);

    संदर्भ["जारी_ढेर"] = जोड़ें(संदर्भ["जारी_ढेर"], शर्त_खंड["लेबल"]);
    संदर्भ["विराम_ढेर"] = जोड़ें(संदर्भ["विराम_ढेर"], अंत_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, देह_खंड);
    निम्नक_कथन(संदर्भ, नोड["देह"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]); }

    संदर्भ["जारी_ढेर"] = निकालें(संदर्भ["जारी_ढेर"]);
    संदर्भ["विराम_ढेर"] = निकालें(संदर्भ["विराम_ढेर"]);
    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् ०;
}

कार्य निम्नक_पुनरावृत्ति(शब्दकोश संदर्भ, शब्दकोश नोड) {
    // प्रारंभ; यावत् शर्त { देह; अद्यतन }
    निम्नक_कथन(संदर्भ, नोड["प्रारंभ"]);
    शब्दकोश शर्त_खंड = नि_नया_खंड(संदर्भ, "for_शर्त");
    शब्दकोश देह_खंड = नि_नया_खंड(संदर्भ, "for_देह");
    शब्दकोश अद्यतन_खंड = नि_नया_खंड(संदर्भ, "for_अद्यतन");
    शब्दकोश अंत_खंड = नि_नया_खंड(संदर्भ, "for_अंत");

    मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]);
    नि_खंड_पर(संदर्भ, शर्त_खंड);
    मान शर्त_नोड = नोड["शर्त"];
    यदि (शर्त_नोड == शून्यम्) {
        मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], देह_खंड["लेबल"]);
    } अन्यथा {
        संख्या शर्त = निम्नक_अभिव्यक्ति(संदर्भ, शर्त_नोड);
        मध्यम_यदि_जाओ(संदर्भ["वर्तमान_खंड"], शर्त, देह_खंड["लेबल"], अंत_खंड["लेबल"]);
    }

    संदर्भ["जारी_ढेर"] = जोड़ें(संदर्भ["जारी_ढेर"], अद्यतन_खंड["लेबल"]);
    संदर्भ["विराम_ढेर"] = जोड़ें(संदर्भ["विराम_ढेर"], अंत_खंड["लेबल"]);

    नि_खंड_पर(संदर्भ, देह_खंड);
    निम्नक_कथन(संदर्भ, नोड["देह"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], अद्यतन_खंड["लेबल"]); }

    नि_खंड_पर(संदर्भ, अद्यतन_खंड);
    निम्नक_कथन(संदर्भ, नोड["अद्यतन"]);
    यदि (न नि_समाप्त_है(संदर्भ)) { मध्यम_जाओ(संदर्भ["वर्तमान_खंड"], शर्त_खंड["लेबल"]); }

    संदर्भ["जारी_ढेर"] = निकालें(संदर्भ["जारी_ढेर"]);
    संदर्भ["विराम_ढेर"] = निकालें(संदर्भ["विराम_ढेर"]);
    नि_खंड_पर(संदर्भ, अंत_खंड);
    परत् ०;
}


