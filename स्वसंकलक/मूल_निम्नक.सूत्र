कार्य निम्नक_कार्य(शब्दकोश एकक, शब्दकोश कार्य_नोड, शब्दकोश वैश्विक, शब्दकोश कार्य_परत्, शब्दकोश वर्ग_क्षेत्र, पाठ चालू_वर्ग, पाठ प्रतीक_नाम) {
    पाठ नाम = प्रतीक_नाम;
    मान परत्_त = कार्य_परत्[नाम];
    पाठ रत = "मान";
    यदि (परत्_त != शून्यम्) { रत = परत्_त; }
    शब्दकोश फलन = मध्यम_नव_कार्य(नाम, रत);

    शब्दकोश संदर्भ = {};
    संदर्भ["एकक"] = एकक;
    संदर्भ["फलन"] = फलन;
    संदर्भ["चर_स्लॉट"] = {};
    संदर्भ["वैश्विक"] = वैश्विक;
    संदर्भ["कार्य_परत्"] = कार्य_परत्;
    संदर्भ["वर्ग_क्षेत्र"] = वर्ग_क्षेत्र;
    संदर्भ["चालू_वर्ग"] = चालू_वर्ग;
    संदर्भ["विराम_ढेर"] = [];
    संदर्भ["जारी_ढेर"] = [];
    संदर्भ["मान_प्रकार"] = {};
    संदर्भ["शीर्ष_स्तर"] = असत्य;
    यदि (नाम == "__शीर्ष") { संदर्भ["शीर्ष_स्तर"] = सत्य; }

    शब्दकोश प्रवेश = मध्यम_नव_खंड(फलन, "प्रवेश");
    संदर्भ["वर्तमान_खंड"] = प्रवेश;

    // पैरामीटर → SSA मान (पहले सब, ताकि id v0..v(n-१) क्रमिक रहें)
    सूची तर्काः = कार्य_नोड["तर्काः"];
    यदि (चालू_वर्ग != "") {
        // विधि → 'स्व' पहला तर्क
        शब्दकोश स्व_तर्क = {};
        स्व_तर्क["नाम"] = "स्व";
        स्व_तर्क["प्रकार_नाम"] = चालू_वर्ग;
        सूची नई_तर्काः = [स्व_तर्क];
        संख्या स_सूचक = ०;
        यावत् (स_सूचक < लंबाई(तर्काः)) {
            नई_तर्काः = जोड़ें(नई_तर्काः, तर्काः[स_सूचक]);
            स_सूचक = स_सूचक + १;
        }
        तर्काः = नई_तर्काः;
    }
    सूची पम_सूची = [];
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(तर्काः)) {
        शब्दकोश तर्क = तर्काः[सूचक];
        पाठ पटैग = निम्नक_प्रकार_टैग(तर्क["प्रकार_नाम"]);
        संख्या पम = मध्यम_पैरामीटर(फलन, तर्क["नाम"], पटैग);
        संदर्भ["मान_प्रकार"][पम] = पटैग;
        पम_सूची = जोड़ें(पम_सूची, पम);
        सूचक = सूचक + १;
    }
    // फिर हर पैरामीटर के लिए स्लॉट + प्रारंभिक store (पुनः-असाइनमेंट के लिए)
    सूचक = ०;
    यावत् (सूचक < लंबाई(तर्काः)) {
        शब्दकोश तर्क = तर्काः[सूचक];
        पाठ पनाम = तर्क["नाम"];
        पाठ पटैग = निम्नक_प्रकार_टैग(तर्क["प्रकार_नाम"]);
        संख्या स्लॉट_आईडी = मध्यम_स्लॉट(फलन, प्रवेश, पनाम);
        शब्दकोश जानकारी = {};
        जानकारी["स्लॉट"] = स्लॉट_आईडी;
        जानकारी["प्रकार"] = पटैग;
        यदि (पटैग == "दशमलव") { जानकारी["घोषित_दशमलव"] = सत्य; }
        संदर्भ["चर_स्लॉट"][पनाम] = जानकारी;
        मध्यम_जोड़_प्रभाव(प्रवेश, "लिख_स्लॉट", [स्लॉट_आईडी, पम_सूची[सूचक]], {});
        सूचक = सूचक + १;
    }

    निम्नक_कथन(संदर्भ, कार्य_नोड["देह"]);

    // अंतिम खंड में terminator न हो तो implicit return
    यदि (न नि_समाप्त_है(संदर्भ)) {
        यदि (रत == "शून्य" || रत == "मान") {
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], ० - १);
        } अन्यथा {
            संख्या श = मध्यम_स्थिर_शून्यम्(फलन, संदर्भ["वर्तमान_खंड"]);
            मध्यम_वापस(संदर्भ["वर्तमान_खंड"], श);
        }
    }
    परत् फलन;
}

कार्य निम्नक_एकक(शब्दकोश प्रोग्राम) {
    शब्दकोश एकक = मध्यम_नव_एकक();

    // कार्य परत्-प्रकार तालिका (आगे-संदर्भ के लिए पहले बनाओ)
    शब्दकोश कार्य_परत् = {};
    सूची कार्य_सूची = प्रोग्राम["कार्य_सूची"];
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        कार्य_परत्[कार्य_सूची[सूचक]["नाम"]] = "मान";
        सूचक = सूचक + १;
    }

    // हर उपयोगकर्ता-कार्य के पैरामीटर-प्रकार टैग — दशमलव-घोषित पैरामीटर का तर्क
    // दशमलव-संदर्भ में lower होता (निम्नक_कॉल)। विदेशी_नक्शा जैसा unit-स्तर सहायक-क्षेत्र।
    शब्दकोश तर्क_प्रकार_नक्शा = {};
    सूचक = ०;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        सूची तर्क_सू = कार्य_सूची[सूचक]["तर्काः"];
        सूची टैग_सू = [];
        संख्या तक = ०;
        यावत् (तक < लंबाई(तर्क_सू)) {
            टैग_सू = जोड़ें(टैग_सू, निम्नक_प्रकार_टैग(तर्क_सू[तक]["प्रकार_नाम"]));
            तक = तक + १;
        }
        तर्क_प्रकार_नक्शा[कार्य_सूची[सूचक]["नाम"]] = टैग_सू;
        सूचक = सूचक + १;
    }
    एकक["तर्क_प्रकार_नक्शा"] = तर्क_प्रकार_नक्शा;

    // वर्ग-क्षेत्र मानचित्र + विधि परत्-प्रकार
    शब्दकोश वर्ग_क्षेत्र = {};
    सूची वर्ग_सूची = प्रोग्राम["वर्ग_सूची"];
    सूचक = ०;
    यावत् (सूचक < लंबाई(वर्ग_सूची)) {
        शब्दकोश वनोड = वर्ग_सूची[सूचक];
        सूची क्षेत्र_नाम = [];
        सूची चर_सू = वनोड["चर_सूची"];
        संख्या जक = ०;
        यावत् (जक < लंबाई(चर_सू)) {
            क्षेत्र_नाम = जोड़ें(क्षेत्र_नाम, चर_सू[जक]["नाम"]);
            जक = जक + १;
        }
        वर्ग_क्षेत्र[वनोड["नाम"]] = क्षेत्र_नाम;
        सूची विधि_सू = वनोड["कार्य_सूची"];
        जक = ०;
        यावत् (जक < लंबाई(विधि_सू)) {
            पाठ मन = विधि_सू[जक]["नाम"];
            यदि (मन == "रचना") { कार्य_परत्[वनोड["नाम"] + "_रचना"] = वनोड["नाम"]; }
            अन्यथा { कार्य_परत्["वर्ग_" + वनोड["नाम"] + "_" + मन] = "मान"; }
            जक = जक + १;
        }
        सूचक = सूचक + १;
    }

    // विदेशी (FFI) घोषणाएँ — नक्शा + पुस्तकालय-सूची बनाओ, फिर वैश्विक_कथन से हटाओ
    शब्दकोश विदेशी_नक्शा = {};
    सूची विदेशी_पुस्तकालय = [];
    सूची कच्चा_वैश्विक = प्रोग्राम["वैश्विक_कथन"];
    सूची वैश्विक_कथन = [];
    सूचक = ०;
    यावत् (सूचक < लंबाई(कच्चा_वैश्विक)) {
        शब्दकोश क0 = कच्चा_वैश्विक[सूचक];
        यदि (क0["नोड_प्रकारः"] == "कठन_विदेशी") {
            शब्दकोश वप्र = {};
            वप्र["प्रतीक"] = क0["प्रतीक"];
            वप्र["गण"] = क0["तर्क_गण"];
            विदेशी_नक्शा[क0["नाम"]] = वप्र;
            मान पुस_मिला = असत्य;
            संख्या पज = ०;
            यावत् (पज < लंबाई(विदेशी_पुस्तकालय)) {
                यदि (विदेशी_पुस्तकालय[पज] == क0["पुस्तकालय"]) { पुस_मिला = सत्य; }
                पज = पज + १;
            }
            यदि (न पुस_मिला) { विदेशी_पुस्तकालय = जोड़ें(विदेशी_पुस्तकालय, क0["पुस्तकालय"]); }
        } अन्यथा {
            वैश्विक_कथन = जोड़ें(वैश्विक_कथन, क0);
        }
        सूचक = सूचक + १;
    }
    एकक["विदेशी_नक्शा"] = विदेशी_नक्शा;
    एकक["विदेशी_पुस्तकालय"] = विदेशी_पुस्तकालय;

    // वैश्विक चर — वैश्विक_कथन से नाम इकट्ठा करो
    शब्दकोश वैश्विक = {};
    सूचक = ०;
    यावत् (सूचक < लंबाई(वैश्विक_कथन)) {
        शब्दकोश क = वैश्विक_कथन[सूचक];
        यदि (क["नोड_प्रकारः"] == "कठन_चर_घोषणा") {
            पाठ गनाम = क["नाम"];
            वैश्विक[गनाम] = निम्नक_प्रकार_टैग(क["प्रकार_नाम"]);
            शब्दकोश जी = {};
            जी["नाम"] = गनाम;
            जी["प्रकार"] = वैश्विक[गनाम];
            एकक["वैश्विक_सूची"] = जोड़ें(एकक["वैश्विक_सूची"], जी);
        }
        सूचक = सूचक + १;
    }

    // हर कार्य lower करो
    एकक["मुख्य_है"] = असत्य;
    सूचक = ०;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        यदि (कार्य_सूची[सूचक]["नाम"] == "मुख्य") { एकक["मुख्य_है"] = सत्य; }
        शब्दकोश फलन = निम्नक_कार्य(एकक, कार्य_सूची[सूचक], वैश्विक, कार्य_परत्, वर्ग_क्षेत्र, "", कार्य_सूची[सूचक]["नाम"]);
        एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], फलन);
        सूचक = सूचक + १;
    }

    // हर वर्ग की विधियाँ lower करो
    सूचक = ०;
    यावत् (सूचक < लंबाई(वर्ग_सूची)) {
        शब्दकोश वनोड = वर्ग_सूची[सूचक];
        सूची विधि_सू = वनोड["कार्य_सूची"];
        संख्या जक = ०;
        यावत् (जक < लंबाई(विधि_सू)) {
            पाठ मन = विधि_सू[जक]["नाम"];
            पाठ प्रतीक = "वर्ग_" + वनोड["नाम"] + "_" + मन;
            यदि (मन == "रचना") { प्रतीक = वनोड["नाम"] + "_रचना"; }
            शब्दकोश मफलन = निम्नक_कार्य(एकक, विधि_सू[जक], वैश्विक, कार्य_परत्, वर्ग_क्षेत्र, वनोड["नाम"], प्रतीक);
            एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], मफलन);
            जक = जक + १;
        }
        सूचक = सूचक + १;
    }

    // शीर्ष-स्तरीय कथन → synthetic __शीर्ष कार्य (main इसे बुलाएगा)।
    // पुस्तकालय-मॉड्यूल (मूल_रनटाइम / मूल_आवंटक — शीर्ष-स्तर पर सिर्फ़
    // कठन_चर_घोषणा, कोई मुख्य) → कोई __शीर्ष / main नहीं; वैश्विक चर .data में
    // .quad ० रहते (initializer सूत्र_स्वजीसी_आरंभ में सेट होते)। वरना
    // linker में `multiple definition of main`।
    एकक["शीर्ष_है"] = असत्य;
    मान केवल_घोषणाएँ = सत्य;
    संख्या पुस = ०;
    यावत् (पुस < लंबाई(वैश्विक_कथन)) {
        यदि (वैश्विक_कथन[पुस]["नोड_प्रकारः"] != "कठन_चर_घोषणा") { केवल_घोषणाएँ = असत्य; }
        पुस = पुस + १;
    }
    यदि (लंबाई(वैश्विक_कथन) > ० && (एकक["मुख्य_है"] == सत्य || न केवल_घोषणाएँ)) {
        शब्दकोश शीर्ष_नोड = {};
        शीर्ष_नोड["नाम"] = "__शीर्ष";
        शीर्ष_नोड["तर्काः"] = [];
        शब्दकोश देह = {};
        देह["नोड_प्रकारः"] = "कठन_ब्लॉक";
        देह["कठन_सूची"] = वैश्विक_कथन;
        शीर्ष_नोड["देह"] = देह;
        शब्दकोश शफलन = निम्नक_कार्य(एकक, शीर्ष_नोड, वैश्विक, कार्य_परत्, वर्ग_क्षेत्र, "", "__शीर्ष");
        एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], शफलन);
        एकक["शीर्ष_है"] = सत्य;
    }

    परत् एकक;
}
