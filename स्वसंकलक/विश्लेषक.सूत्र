कार्य मूल_मार्ग_प्राप्त_करो(पाठ सञ्चिका_मार्ग) {
    मान विभाजक_अनुक्रमणिका = -1;
    मान लंबाई_मार्ग = लंबाई(सञ्चिका_मार्ग);
    मान सूचक = लंबाई_मार्ग - 1;
    यावत् (सूचक >= 0) {
        मान क = अक्षर_मान(सञ्चिका_मार्ग[सूचक]);
        यदि (क == 47 || क == 92) {
            विभाजक_अनुक्रमणिका = सूचक;
            विरामः;
        }
        सूचक = सूचक - 1;
    }

    यदि (विभाजक_अनुक्रमणिका == -1) {
        परत् "";
    }
    परत् उपखंड(सञ्चिका_मार्ग, 0, विभाजक_अनुक्रमणिका + 1);
}

कार्य प्रोग्राम_पार्स(शब्दकोश अवस्था, शब्दकोश आयातित_सञ्चिकाः, पाठ सञ्चिका_मार्ग) {
    यदि (सञ्चिका_मार्ग != "") {
        आयातित_सञ्चिकाः[सञ्चिका_मार्ग] = सत्य;
    }

    सूची वर्ग_सूची = [];
    सूची कार्य_सूची = [];
    सूची वैश्विक_कथन = [];

    यावत् (न अन्त_है(अवस्था)) {
        यदि (जाँचो(अवस्था, "मुख्यशब्द_आयात")) {
            मान पिछला_पद = वर्तमान(अवस्था);
            संख्या पङ्क्ति = पिछला_पद["पङ्क्तिः"];
            संख्या स्तम्भ = पिछला_पद["स्तम्भः"];
            शब्दकोश आयात_नोड = कथन_आयात_पार्स(अवस्था);
            पाठ आयात_मार्ग = आयात_नोड["मार्गः"];

            पाठ मूल_मार्ग = मूल_मार्ग_प्राप्त_करो(सञ्चिका_मार्ग);
            पाठ संकल्पित_मार्ग = मूल_मार्ग + आयात_मार्ग;

            यदि (खोजें(संकल्पित_मार्ग, ".सूत्र") == -1) {
                संकल्पित_मार्ग = संकल्पित_मार्ग + ".सूत्र";
            }

            यदि (न सञ्चिका_अस्ति(संकल्पित_मार्ग)) {
                संकल्पित_मार्ग = आयात_मार्ग;
                यदि (खोजें(संकल्पित_मार्ग, ".सूत्र") == -1) {
                    संकल्पित_मार्ग = संकल्पित_मार्ग + ".सूत्र";
                }
                यदि (न सञ्चिका_अस्ति(संकल्पित_मार्ग)) {
                    प्रक्षेपः "त्रुटिः [पङ्क्तिः " + पङ्क्ति + ", स्तम्भः " + स्तम्भ + "]: आयात-सञ्चिका न प्राप्ता: '" + आयात_मार्ग + "'";
                }
            }

            यदि (न (आयातित_सञ्चिकाः[संकल्पित_मार्ग] == सत्य)) {
                आयातित_सञ्चिकाः[संकल्पित_मार्ग] = सत्य;

                पाठ कोड = सञ्चिका_पठतु(संकल्पित_मार्ग);
                सूची उप_पद_सूची = पद_विच्छेदन(कोड);

                शब्दकोश उप_अवस्था = {};
                उप_अवस्था["पद_सूची"] = उप_पद_सूची;
                उप_अवस्था["अनुक्रमणिका"] = 0;
                उप_अवस्था["कुल_पद"] = लंबाई(उप_पद_सूची);

                शब्दकोश उप_प्रोग्राम = प्रोग्राम_पार्स(उप_अवस्था, आयातित_सञ्चिकाः, संकल्पित_मार्ग);

                सूची उप_वर्ग = उप_प्रोग्राम["वर्ग_सूची"];
                सूची उप_कार्य = उप_प्रोग्राम["कार्य_सूची"];
                सूची उप_वैश्विक = उप_प्रोग्राम["वैश्विक_कथन"];

                संख्या सूचक_वर्ग = 0;
                यावत् (सूचक_वर्ग < लंबाई(उप_वर्ग)) {
                    वर्ग_सूची = जोड़ें(वर्ग_सूची, उप_वर्ग[सूचक_वर्ग]);
                    सूचक_वर्ग = सूचक_वर्ग + 1;
                }

                संख्या सूचक_कार्य = 0;
                यावत् (सूचक_कार्य < लंबाई(उप_कार्य)) {
                    कार्य_सूची = जोड़ें(कार्य_सूची, उप_कार्य[सूचक_कार्य]);
                    सूचक_कार्य = सूचक_कार्य + 1;
                }

                संख्या सूचक_वैश्विक = 0;
                यावत् (सूचक_वैश्विक < लंबाई(उप_वैश्विक)) {
                    वैश्विक_कथन = जोड़ें(वैश्विक_कथन, उप_वैश्विक[सूचक_वैश्विक]);
                    सूचक_वैश्विक = सूचक_वैश्विक + 1;
                }
            }
        } अन्यथा यदि (जाँचो(अवस्था, "मुख्यशब्द_वर्ग")) {
            वर्ग_सूची = जोड़ें(वर्ग_सूची, वर्ग_पार्स(अवस्था));
        } अन्यथा यदि (जाँचो(अवस्था, "मुख्यशब्द_कार्य")) {
            कार्य_सूची = जोड़ें(कार्य_सूची, कार्य_पार्स(अवस्था));
        } अन्यथा यदि (जाँचो(अवस्था, "मुख्यशब्द_विदेशी")) {
            वैश्विक_कथन = जोड़ें(वैश्विक_कथन, कथन_विदेशी_पार्स(अवस्था));
        } अन्यथा {
            वैश्विक_कथन = जोड़ें(वैश्विक_कथन, कथन_पार्स(अवस्था));
        }
    }

    परत् नोड_प्रोग्राम(वर्ग_सूची, कार्य_सूची, वैश्विक_कथन);
}





