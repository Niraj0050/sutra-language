// आभासी_धावक.सूत्र — सूत्र आभासी यंत्र (SVM) एवं संकर निष्पादक CLI
// ============================================================
// सूत्र स्रोत या अष्टक-संकेत (.सूत्रक) को SVM में निष्पादित करने वाला स्वतंत्र धावक।
// उपयोग:
//   sutra_svm.exe <सञ्चिका.सूत्र>
//   sutra_svm.exe <सञ्चिका.सूत्रक>
//   sutra_svm.exe --विच्छेद <सञ्चिका.सूत्र | सञ्चिका.सूत्रक>
//   sutra_svm.exe --उत्सर्जन <सञ्चिका.सूत्र> [निर्गम.सूत्रक]
//   sutra_svm.exe --संकर <सञ्चिका.सूत्र>
// ============================================================

आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अष्टक_संकेत.सूत्र";
आयात "अष्टक_उत्सर्जक.सूत्र";
आयात "आभासी_यंत्र.सूत्र";

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) <= १) {
        लिखतु("==================================================");
        लिखतु("  🕉️ सूत्र आभासी यंत्र (SVM) एवं संकर निष्पादक CLI");
        लिखतु("==================================================");
        लिखतु("उपयोग: sutra_svm.exe [विकल्प] <मार्ग.सूत्र | मार्ग.सूत्रक>\n");
        लिखतु("विकल्पानि:");
        लिखतु("  --विच्छेद            अष्टक-संकेत विच्छेदन दृश्य");
        लिखतु("  --उत्सर्जन [मार्ग]   .सूत्रक बाइनरी पात्र में संकलन एवं सहेजना");
        लिखतु("  --संकर               संकर निष्पादन (SVM + JIT) निर्णय");
        परत्;
    }
    
    मान मार्गः = "";
    मान निर्गम_मार्गः = "";
    मान विच्छेद = असत्य;
    मान संकर = असत्य;
    मान उत्सर्जन = असत्य;
    
    संख्या तइ = १;
    यावत् (तइ < लंबाई(तर्काः_सूची)) {
        पाठ त = तर्काः_सूची[तइ];
        यदि (त == "--विच्छेद" || त == "--disasm") {
            विच्छेद = सत्य;
        } अन्यथा यदि (त == "--संकर" || त == "--hybrid") {
            संकर = सत्य;
        } अन्यथा यदि (त == "--उत्सर्जन" || त == "--emit") {
            उत्सर्जन = सत्य;
        } अन्यथा यदि (त == "-o" || त == "--आउटपुट") {
            उत्सर्जन = सत्य;
            यदि (तइ + १ < लंबाई(तर्काः_सूची)) {
                तइ = तइ + १;
                निर्गम_मार्गः = तर्काः_सूची[तइ];
            }
        } अन्यथा यदि (लंबाई(त) > ० && उपखंड(त, ०, १) != "-") {
            यदि (मार्गः == "") {
                मार्गः = त;
            } अन्यथा यदि (निर्गम_मार्गः == "") {
                निर्गम_मार्गः = त;
            }
        }
        तइ = तइ + १;
    }
    
    यदि (मार्गः == "") {
        लिखतु("त्रुटिः सञ्चिका मार्गः न निर्दिष्टः।");
        परत्;
    }
    
    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        लिखतु("त्रुटिः सञ्चिका न प्राप्ता: " + मार्गः);
        परत्;
    }

    शब्दकोश एसवीएम_प्रोग्राम = शून्यम्;

    // यदि सञ्चिका पहले से .सूत्रक बाइनरी कंटेनर है:
    बूल सूत्रक_है = असत्य;
    यदि (खोजें(मार्गः, ".सूत्रक") >= ०) {
        सूत्रक_है = सत्य;
    }

    यदि (सूत्रक_है) {
        // सीधे बाइटकोड कंटेनर से त्वरित लोड (शून्य पार्सिंग अधिभार)
        एसवीएम_प्रोग्राम = अष्टक_सञ्चिका_लोड(मार्गः);
    } अन्यथा {
        // स्रोत कोड से संकलन
        पाठ स्रोत_पाठ = सञ्चिका_पठतु(मार्गः);
        
        // १. पद विच्छेदन
        सूची पद_सूची = पद_विच्छेदन(स्रोत_पाठ);
        
        // २. विश्लेषण
        शब्दकोश अवस्था = {};
        अवस्था["पद_सूची"] = पद_सूची;
        अवस्था["अनुक्रमणिका"] = ०;
        अवस्था["कुल_पद"] = लंबाई(पद_सूची);
        शब्दकोश आयातित = {};
        शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित, मार्गः);
        
        // २.५ सार्थक विश्लेषण
        मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
        
        // ३. IR Lowering
        शब्दकोश एकक = निम्नक_एकक(प्रोग्राम_नोड);
        
        // ४. अष्टक-संकेत उत्सर्जक
        एसवीएम_प्रोग्राम = अष्टक_उत्सर्जक_एकक(एकक);

        // यदि --उत्सर्जन विकल्प दिया गया है तो .सूत्रक सञ्चिका सहेजें
        यदि (उत्सर्जन) {
            पाठ लक्ष्य_मार्ग = मार्गः + "क";
            यदि (निर्गम_मार्गः != "") {
                लक्ष्य_मार्ग = निर्गम_मार्गः;
            }
            अष्टक_सञ्चिका_सहेजें(एसवीएम_प्रोग्राम, लक्ष्य_मार्ग);
            लिखतु("[सफल] अष्टक-संकेत बाइनरी पात्र सृजित: " + लक्ष्य_मार्ग);
            परत्;
        }
    }
    
    // यदि संकर मोड सक्रिय है:
    यदि (संकर) {
        लिखतु("=== संकर निष्पादन (Hybrid Execution) निर्णय ===");
        पाठ वर्तमान_यंत्र = "x86_64_windows";
        पाठ लक्ष्य_यंत्र = एसवीएम_प्रोग्राम["लक्ष्य_यंत्र"];
        
        यदि (लक्ष्य_यंत्र == वर्तमान_यंत्र) {
            लिखतु("निर्णय: १ (एकम्) — वर्तमान यंत्र अनुरूपम्! प्रत्यक्ष निष्पादन।");
        } अन्यथा {
            लिखतु("निर्णय: ० (शून्यम्) — सार्वत्रिक/भिन्न यंत्र! सूत्र आभासी यंत्र (SVM) द्वारा निष्पादन।");
        }
    }
    
    // यदि विच्छेदन दृश्य मांगा गया है:
    यदि (विच्छेद) {
        लिखतु("\n==================================================");
        लिखतु("  अष्टक-संकेत विच्छेदन दृश्य (Sanskrit Binary ०/१)");
        लिखतु("==================================================");
        शब्दकोश फनक्शा = एसवीएम_प्रोग्राम["फलन_मानचित्र"];
        सूची फकुंजियाँ = कुंजियाँ(फनक्शा);
        संख्या फइ = ०;
        यावत् (फइ < लंबाई(फकुंजियाँ)) {
            पाठ फनाम = फकुंजियाँ[फइ];
            लिखतु("\n[फलन: " + फनाम + "]");
            सूची फआज्ञा = फनक्शा[फनाम]["आज्ञा_सूची"];
            संख्या आइ = ०;
            यावत् (आइ < लंबाई(फआज्ञा)) {
                लिखतु("  " + अष्टक_आज्ञा_विच्छेद(आइ, फआज्ञा[आइ]));
                आइ = आइ + १;
            }
            फइ = फइ + १;
        }
        लिखतु("\n==================================================");
    }
    
    // ५. आभासी यंत्र में निष्पादन
    शब्दकोश यंत्र = आभासी_यंत्र_नव(एसवीएम_प्रोग्राम);
    मान परिणाम = आभासी_यंत्र_चलाओ(यंत्र);
    परत् परिणाम;
}
