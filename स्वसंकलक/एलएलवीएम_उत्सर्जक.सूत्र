// एलएलवीएम_उत्सर्जक.सूत्र — मध्यम IR → LLVM IR पाठ (.ll)  [LLVM backend, Increment 1]
// ============================================================
// इनपुट: IR एकक जो lower + अनुकूलक + परत्_प्रकार_अनुमान + पुच्छ_अनुकूलन +
// अंतर्वेशन से गुज़र चुका (मूल_उत्सर्जक्.सूत्र जैसा ही चरण)। आउटपुट: .ll पाठ,
// जो llc -filetype=obj → gcc -nostdlib (मूल_संकलन.सूत्र जैसा ही link) से
// चलने-लायक .exe बनता।
//
// रजिस्टर-नियतन (रजि_नियतन) पूरी तरह अनदेखा — LLVM अपना regalloc करता।
// रजि_नियतक_कार्य फिर भी चलाया जाता — सिर्फ़ उसका GC-root-चयन साइड-इफ़ेक्ट
// (जीसी_जड़ें/जीसी_जड़_नक्शा/जीसी_मृत्यु_पद) इस्तेमाल होता, black-box.
//
// फाई सीधे LLVM phi बनता — x86 उत्सर्जक की parallel-move/cycle-break/
// edge-splitting मशीनरी (उत्_फाई_चालें आदि) यहाँ पूरी तरह अनावश्यक, क्योंकि
// LLVM का अपना phi elimination यह काम करता।
//
// दायरा: बिल्कुल वही opcode-सेट जो मूल_उत्सर्जक.सूत्र आज संभालता (देखें
// docs/PERFORMANCE_ROADMAP.md — "LLVM release backend"). विधि_बुलाओ/
// परिवर्तन/नव_पाठ(byte-form)/पकड़_आरंभ/पकड़_अंत/अगम्य — निम्नक कभी emit
// नहीं करता, इसलिए यहाँ भी नहीं संभाले (dead code वहाँ भी)।
//
// अभी कहीं wire नहीं — केवल एलएलवीएम_चालक.सूत्र + verify_ir_llvm.sh से जाँचा।
// ============================================================

आयात "मध्यम.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "रजि_नियतक.सूत्र";


// ============================================================
// पाठ-निर्माता (मूल_उत्सर्जक जैसा ही chunk-सूची पैटर्न)
// ============================================================
कार्य एउ_नया() { शब्दकोश ब = {}; ब["ट"] = []; परत् ब; }
कार्य एउ_ल(शब्दकोश ब, पाठ स) {
    ब["ट"] = जोड़ें(ब["ट"], स);
    ब["ट"] = जोड़ें(ब["ट"], अक्षर_निर्माण(10));
    परत् 0;
}
कार्य एउ_पाठ(शब्दकोश ब) { परत् संयोजित(ब["ट"], ""); }


// ============================================================
// LLVM string-literal escape + UTF-8 बाइट-लंबाई (मूल_उत्सर्जक के
// उत्_एस्केप/उत्_बाइट_लंबाई जैसा ही ढाँचा — बस octal की जगह \XX hex)
// ============================================================
कार्य एउ_हेक्स_अंक(संख्या अ) {
    यदि (अ < 10) { परत् अक्षर_निर्माण(48 + अ); }
    परत् अक्षर_निर्माण(65 + (अ - 10));
}
कार्य एउ_हेक्स2(संख्या ब) { परत् एउ_हेक्स_अंक(ब / 16) + एउ_हेक्स_अंक(ब % 16); }

कार्य एउ_एस्केप(पाठ मूल) {
    मान परिणाम = "";
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(मूल)) {
        मान वर्ण = मूल[सूचक];
        संख्या कोड = अक्षर_मान(वर्ण);
        यदि (कोड == 92) { परिणाम = परिणाम + "\\5C"; }
        अन्यथा यदि (कोड == 34) { परिणाम = परिणाम + "\\22"; }
        अन्यथा यदि (कोड >= 32 && कोड < 127) { परिणाम = परिणाम + वर्ण; }
        अन्यथा {
            सूची बाइट्स = [];
            यदि (कोड <= 127) { बाइट्स = जोड़ें(बाइट्स, कोड); }
            अन्यथा यदि (कोड <= 2047) {
                बाइट्स = जोड़ें(बाइट्स, 192 + (कोड / 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            } अन्यथा यदि (कोड <= 65535) {
                बाइट्स = जोड़ें(बाइट्स, 224 + (कोड / 4096));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 64) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            } अन्यथा {
                बाइट्स = जोड़ें(बाइट्स, 240 + (कोड / 262144));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 4096) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + ((कोड / 64) % 64));
                बाइट्स = जोड़ें(बाइट्स, 128 + (कोड % 64));
            }
            संख्या ब_सूचक = 0;
            यावत् (ब_सूचक < लंबाई(बाइट्स)) {
                परिणाम = परिणाम + "\\" + एउ_हेक्स2(बाइट्स[ब_सूचक]);
                ब_सूचक = ब_सूचक + 1;
            }
        }
        सूचक = सूचक + 1;
    }
    परत् परिणाम;
}

कार्य एउ_बाइट_लंबाई(पाठ प) {
    मान कुल = 0;
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(प)) {
        संख्या कोड = अक्षर_मान(प[सूचक]);
        यदि (कोड <= 127) { कुल = कुल + 1; }
        अन्यथा यदि (कोड <= 2047) { कुल = कुल + 2; }
        अन्यथा यदि (कोड <= 65535) { कुल = कुल + 3; }
        अन्यथा { कुल = कुल + 4; }
        सूचक = सूचक + 1;
    }
    परत् कुल;
}


// ============================================================
// प्रकार-अनुवाद: सूत्र टैग → LLVM प्रकार
// एकसमान i64 मॉडल — हर मान 64-बिट शब्द (पूर्ण/दशमलव-बिट्स/बूल/pointer-बिट्स),
// x86 के "raw word" मॉडल जैसा। केवल शून्य = void। heap-pointer को असल
// ptr चाहिए वहीं (GEP/load/store) inttoptr पुल। इससे phi/call में कभी
// प्रकार-असंगति नहीं — "मान" phi जो पाठ merge करे वो सब i64 रहता।
// ============================================================
कार्य एउ_प्रकार(पाठ सूत्र_प्रकार) {
    यदि (सूत्र_प्रकार == "शून्य") { परत् "void"; }
    परत् "i64";
}

कार्य एउ_प्रकार_या(शब्दकोश टीएन, संख्या आईडी, पाठ डिफ़ॉल्ट) {
    मान त = टीएन[आईडी];
    यदि (त == शून्यम्) { परत् डिफ़ॉल्ट; }
    परत् त;
}

// value-id → LLVM-प्रकार नक्शा (बिं_प्रकार_नक्शा जैसा ढाँचा, स्थानीय कॉपी —
// बिंदु_विश्लेषण.सूत्र की भारी dependency से बचने को)
कार्य एउ_मान_प्रकार_नक्शा(शब्दकोश फलन) {
    शब्दकोश नक्शा = {};
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = 0;
    यावत् (प < लंबाई(पैरा)) { नक्शा[पैरा[प]["आईडी"]] = एउ_प्रकार(पैरा[प]["प्रकार"]); प = प + 1; }
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        सूची फस = खंड["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) { नक्शा[फस[फ]["आईडी"]] = एउ_प्रकार(फस[फ]["प्रकार"]); फ = फ + 1; }
        सूची निस = खंड["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] >= 1) { नक्शा[निस[नि]["आईडी"]] = एउ_प्रकार(निस[नि]["प्रकार"]); }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    परत् नक्शा;
}

कार्य एउ_टाइप्ड(शब्दकोश टीएन, संख्या आईडी) {
    परत् एउ_प्रकार_या(टीएन, आईडी, "i64") + " %v" + आईडी;
}

// value-id → कच्चा सूत्र-टैग (टीएन collapse कर देता i64 में — यहाँ मूल टैग
// चाहिए ताकि "मान"-विधि अंकगणित जिसके दोनों operand सिद्ध रूप से पूर्ण/बूल
// हों उसे native int-op बनाया जा सके, dynamic runtime कॉल नहीं)
कार्य एउ_कच्चा_प्रकार_नक्शा(शब्दकोश फलन) {
    शब्दकोश नक्शा = {};
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = 0;
    यावत् (प < लंबाई(पैरा)) { नक्शा[पैरा[प]["आईडी"]] = पैरा[प]["प्रकार"]; प = प + 1; }
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) { नक्शा[फस[फ]["आईडी"]] = फस[फ]["प्रकार"]; फ = फ + 1; }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] >= 1) { नक्शा[निस[नि]["आईडी"]] = निस[नि]["प्रकार"]; }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    परत् नक्शा;
}
कार्य एउ_पूर्ण_जैसा(शब्दकोश कच्चा, संख्या आईडी) {
    मान त = कच्चा[आईडी];
    परत् त == "पूर्ण" || त == "बूल";
}


// ============================================================
// GC-जड़ें — चयन रजि_नियतक_कार्य से (black box), उत्सर्जन यहाँ नया
// ============================================================
कार्य एउ_जड़_सेट(शब्दकोश फलन) {
    शब्दकोश से = {};
    मान जड़ें = फलन["जीसी_जड़ें"];
    यदि (जड़ें == शून्यम्) { परत् से; }
    संख्या इ = 0;
    यावत् (इ < लंबाई(जड़ें)) { से[जड़ें[इ]] = सत्य; इ = इ + 1; }
    परत् से;
}
कार्य एउ_जड़_नाम(संख्या आईडी) { परत् "%root_v" + आईडी; }

// जीसी_जड़_नक्शा (आईडी->ऑफसेट) उल्टा करके जीसी_मृत्यु_पद (पद->[ऑफसेट...]) को
// पद->[आईडी...] में बदलो — क्योंकि यहाँ हर जड़ की अपनी named alloca है,
// x86 जैसा ऑफसेट-इंडेक्स्ड स्लॉट नहीं।
कार्य एउ_मृत्यु_नक्शा(शब्दकोश फलन) {
    शब्दकोश ऑफ_से_आईडी = {};
    मान जनक = फलन["जीसी_जड़_नक्शा"];
    यदि (जनक != शून्यम्) {
        सूची कुं = कुंजियाँ(जनक);
        संख्या इ = 0;
        यावत् (इ < लंबाई(कुं)) {
            संख्या वि = कुं[इ];
            ऑफ_से_आईडी[जनक[वि]] = वि;
            इ = इ + 1;
        }
    }
    शब्दकोश परिणाम = {};
    मान मृत्_पद = फलन["जीसी_मृत्यु_पद"];
    यदि (मृत्_पद != शून्यम्) {
        सूची पद_सूची = कुंजियाँ(मृत्_पद);
        संख्या ज = 0;
        यावत् (ज < लंबाई(पद_सूची)) {
            संख्या पद = पद_सूची[ज];
            सूची ऑफसेट्स = मृत्_पद[पद];
            सूची आईडीज = [];
            संख्या क = 0;
            यावत् (क < लंबाई(ऑफसेट्स)) {
                आईडीज = जोड़ें(आईडीज, ऑफ_से_आईडी[ऑफसेट्स[क]]);
                क = क + 1;
            }
            परिणाम[पद] = आईडीज;
            ज = ज + 1;
        }
    }
    परत् परिणाम;
}

// def के तुरंत बाद: मान को उसके जड़-स्लॉट में store करो (यदि वह जड़ है)
कार्य एउ_जड़_संचय(शब्दकोश बफ, शब्दकोश जड़_से, शब्दकोश टीएन, संख्या आईडी) {
    यदि (जड़_से[आईडी] != सत्य) { परत् 0; }
    एउ_ल(बफ, "  store i64 %v" + आईडी + ", ptr " + एउ_जड़_नाम(आईडी));
    परत् 0;
}

कार्य एउ_जड़_मृत्यु(शब्दकोश बफ, शब्दकोश मृत्यु_नक्शा, संख्या पद) {
    मान आईडीज = मृत्यु_नक्शा[पद];
    यदि (आईडीज == शून्यम्) { परत् 0; }
    संख्या इ = 0;
    यावत् (इ < लंबाई(आईडीज)) {
        एउ_ल(बफ, "  store i64 0, ptr " + एउ_जड़_नाम(आईडीज[इ]));
        इ = इ + 1;
    }
    परत् 0;
}

// प्रवेश-खंड में: हर जड़ के लिए alloca+शून्य-आरंभ, फिर gc_roots[] में
// पंजीकरण (x86 का inline movl/leaq पैटर्न — कोई call नहीं)
कार्य एउ_जड़_प्रोलॉग(शब्दकोश बफ, शब्दकोश फलन) {
    मान जड़ें = फलन["जीसी_जड़ें"];
    संख्या ज_गण = 0;
    यदि (जड़ें != शून्यम्) { ज_गण = लंबाई(जड़ें); }
    यदि (ज_गण == 0) { परत् 0; }
    संख्या इ = 0;
    यावत् (इ < ज_गण) {
        पाठ स्लॉट = एउ_जड़_नाम(जड़ें[इ]);
        एउ_ल(बफ, "  " + स्लॉट + " = alloca i64");
        एउ_ल(बफ, "  store i64 0, ptr " + स्लॉट);
        इ = इ + 1;
    }
    इ = 0;
    यावत् (इ < ज_गण) {
        पाठ स्लॉट = एउ_जड़_नाम(जड़ें[इ]);
        एउ_ल(बफ, "  %gc_c" + इ + " = load i32, ptr @gc_roots_count");
        एउ_ल(बफ, "  %gc_i" + इ + " = sext i32 %gc_c" + इ + " to i64");
        एउ_ल(बफ, "  %gc_s" + इ + " = getelementptr [1000000 x ptr], ptr @gc_roots, i64 0, i64 %gc_i" + इ);
        एउ_ल(बफ, "  store ptr " + स्लॉट + ", ptr %gc_s" + इ);
        एउ_ल(बफ, "  %gc_c" + इ + "n = add i32 %gc_c" + इ + ", 1");
        एउ_ल(बफ, "  store i32 %gc_c" + इ + "n, ptr @gc_roots_count");
        इ = इ + 1;
    }
    परत् 0;
}

// हर वापसी-स्थल पर दोहराई जाने वाली gc_roots_count घटाओ (साझा एपिलॉग नहीं —
// Increment-1 के लिए सरल, कम-जोखिम विकल्प — देखें योजना)
कार्य एउ_जड़_पॉप(शब्दकोश बफ, शब्दकोश फलन, पाठ टैग) {
    मान जड़ें = फलन["जीसी_जड़ें"];
    संख्या ज_गण = 0;
    यदि (जड़ें != शून्यम्) { ज_गण = लंबाई(जड़ें); }
    यदि (ज_गण == 0) { परत् 0; }
    एउ_ल(बफ, "  %gcp_" + टैग + " = load i32, ptr @gc_roots_count");
    एउ_ल(बफ, "  %gcp_" + टैग + "n = sub i32 %gcp_" + टैग + ", " + ज_गण);
    एउ_ल(बफ, "  store i32 %gcp_" + टैग + "n, ptr @gc_roots_count");
    परत् 0;
}


// ============================================================
// तर्क-प्रकार पुल (mismatch पर ptrtoint/inttoptr)
// ============================================================
कार्य एउ_कास्ट_तर्क(शब्दकोश बफ, शब्दकोश टीएन, संख्या आईडी, पाठ चाहा, पाठ टैग) {
    पाठ अपना = एउ_प्रकार_या(टीएन, आईडी, "i64");
    यदि (अपना == चाहा) { परत् चाहा + " %v" + आईडी; }
    पाठ अस्थायी = "%vc" + टैग;
    यदि (अपना == "ptr" && चाहा == "i64") {
        एउ_ल(बफ, "  " + अस्थायी + " = ptrtoint ptr %v" + आईडी + " to i64");
        परत् "i64 " + अस्थायी;
    }
    यदि (अपना == "i64" && चाहा == "ptr") {
        एउ_ल(बफ, "  " + अस्थायी + " = inttoptr i64 %v" + आईडी + " to ptr");
        परत् "ptr " + अस्थायी;
    }
    परत् अपना + " %v" + आईडी;
}


// ============================================================
// फलन-हस्ताक्षर तालिकाएँ (call-site type-checking के लिए ज़रूरी — LLVM
// GAS जैसा untyped नहीं, हर call को सही प्रकार चाहिए)
// ============================================================
कार्य एउ_स्थानीय_सिग्(सूची कस) {
    शब्दकोश सिग् = {};
    संख्या इक = 0;
    यावत् (इक < लंबाई(कस)) {
        शब्दकोश फ = कस[इक];
        पाठ नाम = फ["नाम"];
        यदि (नाम == "मुख्य") { नाम = "sutra_main"; }
        शब्दकोश एस = {};
        एस["परत्"] = एउ_प्रकार(फ["परत्_प्रकार"]);
        सूची पैरा_प्रकार = [];
        सूची पैरा = फ["पैरामीटर"];
        संख्या ज = 0;
        यावत् (ज < लंबाई(पैरा)) {
            पैरा_प्रकार = जोड़ें(पैरा_प्रकार, एउ_प्रकार(पैरा[ज]["प्रकार"]));
            ज = ज + 1;
        }
        एस["पैरा"] = पैरा_प्रकार;
        सिग्[नाम] = एस;
        इक = इक + 1;
    }
    परत् सिग्;
}

कार्य एउ_सिग्_जोड़ो(शब्दकोश सिग्, पाठ नाम, पाठ वापसी, सूची पैरा) {
    शब्दकोश एस = {};
    एस["परत्"] = वापसी;
    एस["पैरा"] = पैरा;
    एस["गुण"] = "";
    सिग्[नाम] = एस;
    परत् 0;
}
कार्य एउ_सिग्_शुद्ध(शब्दकोश सिग्, पाठ नाम, पाठ गुण) {
    यदि (सिग्[नाम] != शून्यम्) { सिग्[नाम]["गुण"] = गुण; }
    परत् 0;
}
// शुद्ध (side-effect-free) runtime helpers पर LLVM attributes — ताकि
// clang -O2 इन्हें loop से hoist / CSE / DCE कर सके (inline न भी हो तो)।
// memory(none) = args-only pure; memory(read) = heap पढ़ता, लिखता नहीं,
// allocate नहीं करता, throw नहीं करता।
कार्य एउ_शुद्ध_चिह्न(शब्दकोश सिग्) {
    पाठ रीड = " memory(read) nounwind willreturn";
