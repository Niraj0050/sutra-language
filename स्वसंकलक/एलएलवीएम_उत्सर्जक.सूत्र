// "निश्चित रूप से सूची" value-id set — statically-typed सूची access का
// तेज़-पथ चुनने को। बीज: नव_सूची / सूची_रचना परिणाम, और किसी भी
// पढ़/लिख_अनुक्रम का base जिसका आधार_प्रकार "सूची" हो। fixpoint: phi
// जिसके सारे (non-undef) source set में, और बुलाओ जोड़ें जिसका पहला
// तर्क set में (`स = जोड़ें(स, x)` pattern)।
कार्य एउ_सूची_सेट(शब्दकोश फलन) {
    शब्दकोश सेट = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            यदि (को == "नव_सूची" && इ["आईडी"] >= 1) { सेट[इ["आईडी"]] = सत्य; }
            यदि (को == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_रचना" && इ["आईडी"] >= 1) { सेट[इ["आईडी"]] = सत्य; }
            यदि ((को == "पढ़_अनुक्रम" || को == "लिख_अनुक्रम") && इ["अंश"]["आधार_प्रकार"] == "सूची") {
                यदि (इ["संचालक"][0] >= 1) { सेट[इ["संचालक"][0]] = सत्य; }
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = 0;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = 0;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                यदि (पिड >= 1 && सेट[पिड] != सत्य) {
                    सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                    मान सब = सत्य;
                    संख्या स = 0;
                    यावत् (स < लंबाई(स्रोत)) {
                        संख्या सिड = स्रोत[स][1];
                        यदि (सिड >= 1 && सिड != पिड && सेट[सिड] != सत्य) { सब = असत्य; }
                        स = स + 1;
                    }
                    यदि (लंबाई(स्रोत) > 0 && सब) { सेट[पिड] = सत्य; बदला = सत्य; }
                }
                फ = फ + 1;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = 0;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                यदि (इ["कोड"] == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़" && इ["आईडी"] >= 1 && सेट[इ["आईडी"]] != सत्य) {
                    यदि (लंबाई(इ["संचालक"]) > 0 && सेट[इ["संचालक"][0]] == सत्य) { सेट[इ["आईडी"]] = सत्य; बदला = सत्य; }
                }
                नि = नि + 1;
            }
            ख = ख + 1;
        }
    }
    परत् सेट;
}

// कौन-से runtime कॉल सूची-तर्क को केवल पढ़ते (escape नहीं कराते)
कार्य एउ_सूची_पठन_सुरक्षित(पाठ लक्ष्य) {
    परत् लक्ष्य == "सूची_तत्व_तेज़" || लक्ष्य == "सूची_सूचकांक" ||
         लक्ष्य == "सूची_लंबाई_तेज़" || लक्ष्य == "दैशिक_लंबाई" ||
         लक्ष्य == "सञ्चय_गणना" || लक्ष्य == "लंबाई";
}

कार्य एउ_ठोस_गैर_पूर्ण(मान त) {
    परत् त == "पाठ" || त == "सूची" || त == "शब्दकोश" || त == "दशमलव" || त == "शून्य";
}
// किस opcode का परिणाम अपारदर्शी (pointer हो सकता) जब कच्चा-टैग "मान" हो
कार्य एउ_अपारदर्शी_उत्पादक(पाठ को) {
    परत् को == "बुलाओ" || को == "विधि_बुलाओ" || को == "परिवर्तन" ||
         को == "पढ़_वैश्विक" || को == "पढ़_स्लॉट" ||
         को == "नव_सूची" || को == "नव_शब्दकोश" || को == "नव_वस्तु";
}

// आशावादी पूर्णत्व-अनुमान — mem2reg phi और "मान"-अंकगणित के लिए कच्चा-टैग
// में पूर्ण-प्रकार भर देता ताकि लूप-संचायक `कुल = कुल + x` native `add i64`
// बने, dynamic `पाठ_योग_गतिक` कॉल नहीं (वह opaque कॉल clang की LICM रोक देता,
// container-heavy कोड को C++ से 20x+ पीछे रखता)।
//
// विधि: हर मान आशावादी "पूर्ण-जैसा"; केवल इन स्रोतों से नहीं[]:
//   - कच्चा में ठोस गैर-पूर्ण प्रकार (पाठ/सूची/शब्दकोश/दशमलव/शून्य)
//   - अपारदर्शी उत्पादक (बुलाओ/पढ़_वैश्विक/नव_* …) जिसका टैग "मान"
//   - अ-टाइप किया पैरामीटर
//   - गैर-पूर्ण-तत्व वाली सूची से पढ़_अनुक्रम, या अ-स्थानीय सूची / पाठ से
//   - ऐसे स्रोत से phi; ऐसे operand से "मान"-अंकगणित
// नहीं[] monotone (केवल बढ़ता) → fixpoint; बचे derived मान → सिद्ध पूर्ण।
कार्य एउ_पूर्णत्व_अनुमान(शब्दकोश फलन, शब्दकोश सूचीसेट, शब्दकोश कच्चा) {
    शब्दकोश नहीं = {};       // id -> सत्य: सिद्ध रूप से पूर्ण/बूल नहीं
    शब्दकोश स्थानीय = {};    // listId -> सत्य: स्थानीय-जन्म सूची (नव_सूची/सूची_जोड़/phi)
    शब्दकोश सूचि_बुरी = {};  // listId -> सत्य: उसमें कोई गैर-पूर्ण तत्व डाला गया
    सूची खस = फलन["खंड_सूची"];

    // ---- बीज: अ-टाइप पैरामीटर ----
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = 0;
    यावत् (प < लंबाई(पैरा)) {
        मान पत = पैरा[प]["प्रकार"];
        यदि (पत != "पूर्ण" && पत != "बूल") { नहीं[पैरा[प]["आईडी"]] = सत्य; }
        प = प + 1;
    }

    // ---- बीज: ठोस गैर-पूर्ण + अपारदर्शी-"मान" उत्पादक; स्थानीय-सूची चिह्न ----
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            यदि (एउ_ठोस_गैर_पूर्ण(फस[फ]["प्रकार"])) { नहीं[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + 1;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            पाठ को = इ["कोड"];
            यदि (आ >= 1) {
                मान त = इ["प्रकार"];
                यदि (एउ_ठोस_गैर_पूर्ण(त)) { नहीं[आ] = सत्य; }
                अन्यथा यदि ((त == "मान" || त == शून्यम्) && एउ_अपारदर्शी_उत्पादक(को)) {
                    // पढ़_अनुक्रम अपवाद: fixpoint में जँचता (स्थानीय पूर्ण-सूची से ठीक)
                    नहीं[आ] = सत्य;
                }
                यदि (को == "नव_सूची") { स्थानीय[आ] = सत्य; }
                यदि (को == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़") { स्थानीय[आ] = सत्य; }
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    // सूची-phi स्थानीय तभी जब सब स्रोत स्थानीय (fixpoint नीचे संभालता — यहाँ
    // आशावादी सत्य दे दो जिन phi का कोई-न-कोई स्रोत स्थानीय)
    ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            यदि (सूचीसेट[फस[फ]["आईडी"]] == सत्य) { स्थानीय[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + 1;
        }
        ख = ख + 1;
    }

    // ---- संयुक्त monotone fixpoint ----
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = 0;
        यावत् (ख < लंबाई(खस)) {
            // phi: कोई स्रोत नहीं[] → phi नहीं[]; कोई स्रोत अ-स्थानीय → phi अ-स्थानीय
            सूची फस = खस[ख]["फाई"];
            संख्या फ = 0;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                संख्या स = 0;
                यावत् (स < लंबाई(स्रोत)) {
                    संख्या सिड = स्रोत[स][1];
                    यदि (सिड >= 1 && सिड != पिड) {
                        यदि (नहीं[सिड] == सत्य && नहीं[पिड] != सत्य) { नहीं[पिड] = सत्य; बदला = सत्य; }
                        यदि (स्थानीय[पिड] == सत्य && स्थानीय[सिड] != सत्य) { स्थानीय[पिड] = असत्य; बदला = सत्य; }
                        यदि (सूचि_बुरी[सिड] == सत्य && सूचि_बुरी[पिड] != सत्य) { सूचि_बुरी[पिड] = सत्य; बदला = सत्य; }
                        यदि (सूचि_बुरी[पिड] == सत्य && सूचि_बुरी[सिड] != सत्य) { सूचि_बुरी[सिड] = सत्य; बदला = सत्य; }
                    }
                    स = स + 1;
                }
                फ = फ + 1;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = 0;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                पाठ को = इ["कोड"];
                संख्या आ = इ["आईडी"];
                सूची ऑप = इ["संचालक"];
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष") {
                    मान त = इ["प्रकार"];
                    यदि ((त == "मान" || त == शून्यम्) && आ >= 1 && नहीं[आ] != सत्य) {
                        यदि (लंबाई(ऑप) >= 2 && (नहीं[ऑप[0]] == सत्य || नहीं[ऑप[1]] == सत्य)) { नहीं[आ] = सत्य; बदला = सत्य; }
                    }
                }
                अन्यथा यदि (को == "पढ़_अनुक्रम" && आ >= 1 && नहीं[आ] != सत्य) {
                    मान ठीक = असत्य;
                    यदि (लंबाई(ऑप) >= 1) {
                        संख्या आधार = ऑप[0];
                        यदि (इ["अंश"]["आधार_प्रकार"] == "सूची" && स्थानीय[आधार] == सत्य && सूचि_बुरी[आधार] != सत्य) { ठीक = सत्य; }
                    }
                    यदि (न ठीक) { नहीं[आ] = सत्य; बदला = सत्य; }
                }
                अन्यथा यदि (को == "नव_सूची" && आ >= 1 && स्थानीय[आ] == सत्य && सूचि_बुरी[आ] != सत्य) {
                    संख्या क = 0;
                    यावत् (क < लंबाई(ऑप)) {
                        यदि (नहीं[ऑप[क]] == सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                        क = क + 1;
                    }
                }
                अन्यथा यदि (को == "लिख_अनुक्रम" && लंबाई(ऑप) >= 3) {
                    यदि (स्थानीय[ऑप[0]] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य && नहीं[ऑप[2]] == सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                }
                अन्यथा यदि (को == "बुलाओ") {
                    पाठ लक्ष्य = इ["अंश"]["लक्ष्य"];
                    यदि (लक्ष्य == "सूची_जोड़") {
                        यदि (लंबाई(ऑप) >= 2 && स्थानीय[ऑप[0]] == सत्य) {
                            यदि (नहीं[ऑप[1]] == सत्य) {
                                यदि (सूचि_बुरी[ऑप[0]] != सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                                यदि (आ >= 1 && सूचि_बुरी[आ] != सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                            }
                            // आ = ऑप[0] ∪ {x}: वर्ग-एकीकरण
                            यदि (आ >= 1) {
                                यदि (सूचि_बुरी[ऑप[0]] == सत्य && सूचि_बुरी[आ] != सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                                यदि (सूचि_बुरी[आ] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                                यदि (स्थानीय[ऑप[0]] != सत्य && स्थानीय[आ] == सत्य) { स्थानीय[आ] = असत्य; बदला = सत्य; }
                            }
                        }
                    }
                    अन्यथा यदि (लक्ष्य == "सूची_तत्व_सेट_तेज़" || लक्ष्य == "सूची_सूचकांक_सेट") {
                        यदि (लंबाई(ऑप) >= 3 && स्थानीय[ऑप[0]] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य && नहीं[ऑप[2]] == सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                    }
                    अन्यथा यदि (न एउ_सूची_पठन_सुरक्षित(लक्ष्य)) {
                        // सूची-तर्क किसी अन्य कॉल में → escape, caller गैर-पूर्ण डाल सकता
                        संख्या क = 0;
                        यावत् (क < लंबाई(ऑप)) {
                            यदि (स्थानीय[ऑप[क]] == सत्य && सूचि_बुरी[ऑप[क]] != सत्य) { सूचि_बुरी[ऑप[क]] = सत्य; बदला = सत्य; }
                            क = क + 1;
                        }
                    }
                }
                नि = नि + 1;
            }
            ख = ख + 1;
        }
    }

    // ---- कच्चा उन्नयन: derived मान जो नहीं[] में नहीं बचे → "पूर्ण" ----
    ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            संख्या पिड = फस[फ]["आईडी"];
            यदि (पिड >= 1 && नहीं[पिड] != सत्य) {
                मान वर्त = कच्चा[पिड];
                यदि (वर्त == शून्यम् || वर्त == "मान") { कच्चा[पिड] = "पूर्ण"; }
            }
            फ = फ + 1;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            संख्या आ = इ["आईडी"];
            यदि (आ >= 1 && नहीं[आ] != सत्य) {
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष" || को == "पढ़_अनुक्रम") {
                    मान वर्त = कच्चा[आ];
                    यदि (वर्त == शून्यम् || वर्त == "मान") { कच्चा[आ] = "पूर्ण"; }
                }
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    परत् 0;
}

// ============================================================
// तुलना/अंकगणित सिम्बल-तालिकाएँ (मूल_उत्सर्जक के उत्_*_तुलना_सिम जैसा)
// ============================================================
कार्य एउ_फ्लोट_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "सम") { परत् "sutra_float_eq"; }
    यदि (कोड == "असम") { परत् "sutra_float_ne"; }
    यदि (कोड == "लघु") { परत् "sutra_float_lt"; }
    यदि (कोड == "गुरु") { परत् "sutra_float_gt"; }
    यदि (कोड == "लघुसम") { परत् "sutra_float_le"; }
    परत् "sutra_float_ge";
}
// LLVM fcmp predicate — तल.s के sutra_float_* से byte-parity:
// eq=oeq (ordered), ne=une (unordered), बाकी ordered
कार्य एउ_फ्लोट_आइसीएमपी(पाठ कोड) {
    यदि (कोड == "सम") { परत् "oeq"; }
    यदि (कोड == "असम") { परत् "une"; }
    यदि (कोड == "लघु") { परत् "olt"; }
    यदि (कोड == "गुरु") { परत् "ogt"; }
    यदि (कोड == "लघुसम") { परत् "ole"; }
    परत् "oge";
}
कार्य एउ_सामान्य_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "लघु") { परत् "सामान्य_न्यून"; }
    यदि (कोड == "गुरु") { परत् "सामान्य_अधिक"; }
    यदि (कोड == "लघुसम") { परत् "सामान्य_न्यून_सम"; }
    परत् "सामान्य_अधिक_सम";
}
कार्य एउ_पाठ_तुलना_सिम(पाठ कोड) {
    यदि (कोड == "सम" || कोड == "असम") { परत् "पाठ_तुल्य"; }
    यदि (कोड == "लघु") { परत् "पाठ_न्यून"; }
    यदि (कोड == "गुरु") { परत् "पाठ_अधिक"; }
    यदि (कोड == "लघुसम") { परत् "पाठ_न्यून_सम"; }
    परत् "पाठ_अधिक_सम";
}
कार्य एउ_आइसीएमपी(पाठ कोड) {
    यदि (कोड == "सम") { परत् "eq"; }
    यदि (कोड == "असम") { परत् "ne"; }
    यदि (कोड == "लघु") { परत् "slt"; }
    यदि (कोड == "गुरु") { परत् "sgt"; }
    यदि (कोड == "लघुसम") { परत् "sle"; }
    परत् "sge";
}
कार्य एउ_तुलना_है(पाठ कोड) {
    परत् कोड == "सम" || कोड == "असम" || कोड == "लघु" || कोड == "गुरु"
        || कोड == "लघुसम" || कोड == "गुरुसम";
}
कार्य एउ_अंतर्_प्रतीक(पाठ नाम) {
    यदि (नाम == "अंतर्_क्षेत्र_आवंटन") { परत् "सूत्र_तल_आवंटन"; }
    यदि (नाम == "अंतर्_क्षेत्र_मुक्त") { परत् "सूत्र_तल_मुक्त"; }
    यदि (नाम == "अंतर्_निकास") { परत् "सूत्र_तल_निकास"; }
    यदि (नाम == "अंतर्_क्या_पाठ") { परत् "रन_क्या_पाठ"; }
    यदि (नाम == "अंतर्_क्या_शब्दकोश") { परत् "रन_क्या_शब्दकोश"; }
    यदि (नाम == "अंतर्_जड़_संख्या") { परत् "sutra_gc_root_count"; }
    यदि (नाम == "अंतर्_जड़_मान") { परत् "sutra_gc_root_deref"; }
    यदि (नाम == "अंतर्_सक्रिय_अपवाद") { परत् "सक्रिय_अपवाद_लो"; }
    परत् नाम;
}


// ============================================================
// कॉल — स्थानीय/रनटाइम हस्ताक्षर से प्रकार लो, mismatch पर कास्ट।
// अज्ञात प्रतीक: use-site के प्रकारों से declare-हस्ताक्षर अनुमान।
// ============================================================
कार्य एउ_सिम_दर्ज(शब्दकोश बुलाए_सिम, शब्दकोश स्था_सिग्, शब्दकोश रन_सिग्,
                  पाठ नाम, पाठ वापसी_अनुमान, सूची पैरा_अनुमान) {
    यदि (स्था_सिग्[नाम] != शून्यम्) { परत् 0; }
    यदि (बुलाए_सिम[नाम] != शून्यम्) { परत् 0; }
    मान ज्ञात = रन_सिग्[नाम];
    यदि (ज्ञात != शून्यम्) {
        बुलाए_सिम[नाम] = ज्ञात;
        परत् 0;
    }
    शब्दकोश एस = {};
    एस["परत्"] = वापसी_अनुमान;
    एस["पैरा"] = पैरा_अनुमान;
    बुलाए_सिम[नाम] = एस;
    परत् 0;
}

कार्य एउ_कॉल_उत्सर्जन(शब्दकोश बफ, शब्दकोश टीएन, शब्दकोश स्था_सिग्, शब्दकोश रन_सिग्,
                       शब्दकोश बुलाए_सिम, पाठ लक्ष्य, सूची तर्क, संख्या दस) {
    यदि (लक्ष्य == "मुख्य") { लक्ष्य = "sutra_main"; }
    मान सिग् = स्था_सिग्[लक्ष्य];
    यदि (सिग् == शून्यम्) { सिग् = रन_सिग्[लक्ष्य]; }
    पाठ वापसी_प्रकार = एउ_प्रकार_या(टीएन, दस, "void");
    सूची पैरा_प्रकार = शून्यम्;
    यदि (सिग् != शून्यम्) {
        यदि (सिग्["परत्"] != शून्यम्) { वापसी_प्रकार = सिग्["परत्"]; }
        पैरा_प्रकार = सिग्["पैरा"];
    }

    पाठ तर्क_पाठ = "";
    सूची अनु_पैरा = [];
    संख्या इ = 0;
    यावत् (इ < लंबाई(तर्क)) {
        पाठ पप = एउ_प्रकार_या(टीएन, तर्क[इ], "i64");
        यदि (पैरा_प्रकार != शून्यम् && इ < लंबाई(पैरा_प्रकार)) { पप = पैरा_प्रकार[इ]; }
        अनु_पैरा = जोड़ें(अनु_पैरा, पप);
        यदि (इ > 0) { तर्क_पाठ = तर्क_पाठ + ", "; }
        तर्क_पाठ = तर्क_पाठ + एउ_कास्ट_तर्क(बफ, टीएन, तर्क[इ], पप, दस + "_" + इ);
        इ = इ + 1;
    }
    एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, लक्ष्य, वापसी_प्रकार, अनु_पैरा);

    यदि (वापसी_प्रकार == "void" || दस < 1) {
        एउ_ल(बफ, "  call void @\"" + लक्ष्य + "\"(" + तर्क_पाठ + ")");
    } अन्यथा {
        एउ_ल(बफ, "  %v" + दस + " = call " + वापसी_प्रकार + " @\"" + लक्ष्य + "\"(" + तर्क_पाठ + ")");
    }
    परत् 0;
}


// ============================================================
// एक निर्देश
// ============================================================
कार्य एउ_निर्देश(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश एकक, शब्दकोश टीएन, शब्दकोश कच्चा, शब्दकोश जड़_से,
                 शब्दकोश स्था_सिग्, शब्दकोश रन_सिग्, शब्दकोश बुलाए_सिम, शब्दकोश संचित, शब्दकोश नि) {
    पाठ कोड = नि["कोड"];
    संख्या दस = नि["आईडी"];
    सूची स = नि["संचालक"];
    // अद्वितीय अस्थायी-उपसर्ग: मान-उत्पादक → v<id>, प्रभाव-मात्र → t<pos>
    पाठ अनुप = "v" + दस;
    यदि (दस < 1) { अनुप = "t" + नि["_pos"]; }

    यदि (कोड == "स्थिर") { एउ_स्थिर(बफ, फलन, एकक, नि); परत् 0; }

    यदि (कोड == "योग" || कोड == "अंतर" || कोड == "गुणा") {
        पाठ विधि = "पूर्ण";
        यदि (नि["अंश"]["विधि"] != शून्यम्) { विधि = नि["अंश"]["विधि"]; }
        // "मान"-विधि पर भी: यदि दोनों operand सिद्ध रूप से पूर्ण/बूल हैं
        // (return-type-inference call-tag update करता पर downstream अंकगणित
        // की विधि नहीं) → native int-op, dynamic runtime कॉल नहीं
        यदि (विधि == "मान" && एउ_पूर्ण_जैसा(कच्चा, स[0]) && एउ_पूर्ण_जैसा(कच्चा, स[1])) { विधि = "पूर्ण"; }
        यदि (विधि == "मान" && कच्चा[स[0]] == "दशमलव" && कच्चा[स[1]] == "दशमलव") { विधि = "दशमलव"; }
        यदि (कोड == "योग" && विधि == "पाठ") {
            एउ_ल(बफ, "  %v" + दस + " = call i64 @\"पाठ_जोड़\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
            परत् 0;
        }
        यदि (कोड == "योग" && विधि == "मान") {
            एउ_ल(बफ, "  %v" + दस + " = call i64 @\"पाठ_योग_गतिक\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
            परत् 0;
        }
        यदि (विधि == "दशमलव") {
            // native double अंकगणित (bitcast i64↔double boundary पर) —
            // sutra_float_* runtime कॉल नहीं, ताकि LLVM autovectorize कर सके
            पाठ ऑप = "fadd";
            यदि (कोड == "अंतर") { ऑप = "fsub"; }
            यदि (कोड == "गुणा") { ऑप = "fmul"; }
            एउ_ल(बफ, "  %v" + दस + "_fa = bitcast i64 %v" + स[0] + " to double");
            एउ_ल(बफ, "  %v" + दस + "_fb = bitcast i64 %v" + स[1] + " to double");
            एउ_ल(बफ, "  %v" + दस + "_fr = " + ऑप + " double %v" + दस + "_fa, %v" + दस + "_fb");
            एउ_ल(बफ, "  %v" + दस + " = bitcast double %v" + दस + "_fr to i64");
            परत् 0;
        }
        पाठ यं = "add";
        यदि (कोड == "अंतर") { यं = "sub"; }
        यदि (कोड == "गुणा") { यं = "mul"; }
        एउ_ल(बफ, "  %v" + दस + " = " + यं + " i64 %v" + स[0] + ", %v" + स[1]);
        परत् 0;
    }
    यदि ((कोड == "भाग" || कोड == "शेष") && नि["अंश"]["विधि"] == "दशमलव") {
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"sutra_float_div\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
        परत् 0;
    }
    यदि (कोड == "भाग") {
        एउ_ल(बफ, "  %v" + दस + " = sdiv i64 %v" + स[0] + ", %v" + स[1]);
        परत् 0;
    }
    यदि (कोड == "शेष") {
        एउ_ल(बफ, "  %v" + दस + " = srem i64 %v" + स[0] + ", %v" + स[1]);
        परत् 0;
    }
    यदि (एउ_तुलना_है(कोड)) {
        पाठ तविधि = "पूर्ण";
        यदि (नि["अंश"]["विधि"] != शून्यम्) { तविधि = नि["अंश"]["विधि"]; }
        यदि (तविधि == "मान" && एउ_पूर्ण_जैसा(कच्चा, स[0]) && एउ_पूर्ण_जैसा(कच्चा, स[1])) { तविधि = "पूर्ण"; }
        यदि (तविधि == "मान" && कच्चा[स[0]] == "दशमलव" && कच्चा[स[1]] == "दशमलव") { तविधि = "दशमलव"; }
        // दोनों operand सिद्ध रूप से पाठ हों तो सुरक्षित तेज़-पथ। "पाठ" तविधि
        // (जब निम्नक ने दोनों को पाठ माना) भी सुरक्षित। "मान"→"पाठ" reroute
        // (नीचे) असुरक्षित — operand int हो सकता, guarded पाठ_तुल्य चाहिए।
        मान पाठ_सुरक्षित = असत्य;
        यदि (तविधि == "पाठ") { पाठ_सुरक्षित = सत्य; }
        यदि (तविधि == "मान" && कच्चा[स[0]] == "पाठ" && कच्चा[स[1]] == "पाठ") { तविधि = "पाठ"; पाठ_सुरक्षित = सत्य; }
        यदि (तविधि == "दशमलव") {
            // native ordered fcmp — sutra_float_* runtime कॉल की जगह
            // (sutra_float_eq = oeq, _ne = une, बाकी ordered; तल.s के
            //  ucomisd+sete/setnp आदि से सत्यापित)
            एउ_ल(बफ, "  %v" + दस + "_fa = bitcast i64 %v" + स[0] + " to double");
            एउ_ल(बफ, "  %v" + दस + "_fb = bitcast i64 %v" + स[1] + " to double");
            एउ_ल(बफ, "  %v" + दस + "_fc = fcmp " + एउ_फ्लोट_आइसीएमपी(कोड) + " double %v" + दस + "_fa, %v" + दस + "_fb");
            एउ_ल(बफ, "  %v" + दस + " = zext i1 %v" + दस + "_fc to i64");
            परत् 0;
        }
        यदि (तविधि == "मान" && (कोड == "सम" || कोड == "असम")) { तविधि = "पाठ"; }
        यदि (तविधि == "मान") {
            एउ_ल(बफ, "  %v" + दस + " = call i64 @\"" + एउ_सामान्य_तुलना_सिम(कोड) + "\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
            परत् 0;
        }
        यदि (तविधि == "पाठ") {
            पाठ तुसिम = "पाठ_तुल्य";
            यदि (पाठ_सुरक्षित) { तुसिम = "पाठ_तुल्य_तेज़"; }   // छोटा, clang inline करता
            यदि (कोड == "सम") {
                एउ_ल(बफ, "  %v" + दस + " = call i64 @\"" + तुसिम + "\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
                परत् 0;
            }
            यदि (कोड == "असम") {
                एउ_ल(बफ, "  %v" + दस + "_eq = call i64 @\"" + तुसिम + "\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
                एउ_ल(बफ, "  %v" + दस + "_z = icmp eq i64 %v" + दस + "_eq, 0");
                एउ_ल(बफ, "  %v" + दस + " = zext i1 %v" + दस + "_z to i64");
                परत् 0;
            }
            एउ_ल(बफ, "  %v" + दस + " = call i64 @\"" + एउ_पाठ_तुलना_सिम(कोड) + "\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
            परत् 0;
        }
        एउ_ल(बफ, "  %v" + दस + "_c = icmp " + एउ_आइसीएमपी(कोड) + " i64 %v" + स[0] + ", %v" + स[1]);
        एउ_ल(बफ, "  %v" + दस + " = zext i1 %v" + दस + "_c to i64");
        परत् 0;
    }
    यदि (कोड == "और" || कोड == "या") {
        पाठ यं = "and";
        यदि (कोड == "या") { यं = "or"; }
        एउ_ल(बफ, "  %v" + दस + "_r = " + यं + " i64 %v" + स[0] + ", %v" + स[1]);
        एउ_ल(बफ, "  %v" + दस + "_c = icmp ne i64 %v" + दस + "_r, 0");
        एउ_ल(बफ, "  %v" + दस + " = zext i1 %v" + दस + "_c to i64");
        परत् 0;
    }
    यदि (कोड == "नकार") {
        एउ_ल(बफ, "  %v" + दस + "_c = icmp eq i64 %v" + स[0] + ", 0");
        एउ_ल(बफ, "  %v" + दस + " = zext i1 %v" + दस + "_c to i64");
        परत् 0;
    }
    यदि (कोड == "ऋणात्मक") {
        यदि (नि["प्रकार"] == "दशमलव") {
            एउ_ल(बफ, "  %v" + दस + " = xor i64 %v" + स[0] + ", -9223372036854775808");
        } अन्यथा {
            एउ_ल(बफ, "  %v" + दस + " = sub i64 0, %v" + स[0]);
        }
        परत् 0;
    }
    यदि (कोड == "पढ़_वैश्विक") {
        एउ_ल(बफ, "  %v" + दस + " = load i64, ptr @\"sutra_glob_" + नि["अंश"]["नाम"] + "\"");
        परत् 0;
    }
    यदि (कोड == "लिख_वैश्विक") {
        एउ_ल(बफ, "  store i64 %v" + स[0] + ", ptr @\"sutra_glob_" + नि["अंश"]["नाम"] + "\"");
        परत् 0;
    }
    यदि (कोड == "बुलाओ") {
        पाठ लक्ष्य = नि["अंश"]["लक्ष्य"];
        // int↔float coercion — native sitofp/fptosi, runtime कॉल नहीं
        यदि (लक्ष्य == "sutra_int_to_float") {
            एउ_ल(बफ, "  %v" + दस + "_ff = sitofp i64 %v" + स[0] + " to double");
            एउ_ल(बफ, "  %v" + दस + " = bitcast double %v" + दस + "_ff to i64");
            परत् 0;
        }
        यदि (लक्ष्य == "sutra_float_to_int") {
            एउ_ल(बफ, "  %v" + दस + "_fd = bitcast i64 %v" + स[0] + " to double");
            एउ_ल(बफ, "  %v" + दस + " = fptosi double %v" + दस + "_fd to i64");
            परत् 0;
        }
        एउ_कॉल_उत्सर्जन(बफ, टीएन, स्था_सिग्, रन_सिग्, बुलाए_सिम, लक्ष्य, स, दस);
        परत् 0;
    }
    यदि (कोड == "अंतर्") { एउ_अंतर्(बफ, टीएन, स्था_सिग्, रन_सिग्, बुलाए_सिम, नि); परत् 0; }
    मान सूचीसेट = फलन["_सूचीसेट"];
    यदि (कोड == "लंबाई") {
        पाठ लसिम = "दैशिक_लंबाई";
        यदि (कच्चा[स[0]] == "सूची" || सूचीसेट[स[0]] == सत्य) { लसिम = "सूची_लंबाई_तेज़"; }
        अन्यथा यदि (कच्चा[स[0]] == "पाठ") { लसिम = "पाठ_लंबाई_तेज़"; }
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"" + लसिम + "\"(i64 %v" + स[0] + ")");
        परत् 0;
    }
    यदि (कोड == "पढ़_अनुक्रम") {
        पाठ आप = "मान";
        यदि (नि["अंश"]["आधार_प्रकार"] != शून्यम्) { आप = नि["अंश"]["आधार_प्रकार"]; }
        पाठ सिम = "सूची_सूचकांक";
        यदि (आप == "पाठ") { सिम = "पाठ_सूचकांक"; }
        // base निश्चित रूप से सूची → type-dispatch-रहित तेज़-पथ (clang inline)
        अन्यथा यदि (आप == "सूची" || कच्चा[स[0]] == "सूची" || सूचीसेट[स[0]] == सत्य) { सिम = "सूची_तत्व_तेज़"; }
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"" + सिम + "\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ")");
        परत् 0;
    }
    यदि (कोड == "लिख_अनुक्रम") {
        पाठ ससिम = "सूची_सूचकांक_सेट";
        पाठ अप = "मान";
        यदि (नि["अंश"]["आधार_प्रकार"] != शून्यम्) { अप = नि["अंश"]["आधार_प्रकार"]; }
        यदि (अप == "सूची" || कच्चा[स[0]] == "सूची" || सूचीसेट[स[0]] == सत्य) { ससिम = "सूची_तत्व_सेट_तेज़"; }
        एउ_ल(बफ, "  call void @\"" + ससिम + "\"(i64 %v" + स[0] + ", i64 %v" + स[1] + ", i64 %v" + स[2] + ")");
        परत् 0;
    }
    यदि (कोड == "नव_सूची") {
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"सूची_रचना\"(i64 " + लंबाई(स) + ")");
        एउ_जड़_संचय(बफ, जड़_से, टीएन, दस);
        संचित[दस] = सत्य;
        संख्या इ = 0;
        यावत् (इ < लंबाई(स)) {
            एउ_ल(बफ, "  call void @\"सूची_सूचकांक_सेट\"(i64 %v" + दस + ", i64 " + इ + ", i64 %v" + स[इ] + ")");
            इ = इ + 1;
        }
        परत् 0;
    }
    यदि (कोड == "नव_शब्दकोश") {
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"शब्दकोश_रचना\"()");
        एउ_जड़_संचय(बफ, जड़_से, टीएन, दस);
        संचित[दस] = सत्य;
        संख्या इ = 0;
        यावत् (इ + 1 < लंबाई(स)) {
            एउ_ल(बफ, "  call void @\"शब्दकोश_सेट\"(i64 %v" + दस + ", i64 %v" + स[इ] + ", i64 %v" + स[इ + 1] + ")");
            इ = इ + 2;
        }
        परत् 0;
    }
    यदि (कोड == "पढ़_क्षेत्र") {
        संख्या सूच = 0;
        यदि (नि["अंश"]["सूचकांक"] != शून्यम्) { सूच = नि["अंश"]["सूचकांक"]; }
        एउ_ल(बफ, "  %v" + दस + "_bp = inttoptr i64 %v" + स[0] + " to ptr");
        एउ_ल(बफ, "  %v" + दस + "_p = getelementptr i8, ptr %v" + दस + "_bp, i64 " + (16 + सूच * 8));
        एउ_ल(बफ, "  %v" + दस + " = load i64, ptr %v" + दस + "_p");
        परत् 0;
    }
    यदि (कोड == "लिख_क्षेत्र") {
        संख्या सूच = 0;
        यदि (नि["अंश"]["सूचकांक"] != शून्यम्) { सूच = नि["अंश"]["सूचकांक"]; }
        एउ_ल(बफ, "  %" + अनुप + "_bp = inttoptr i64 %v" + स[0] + " to ptr");
        एउ_ल(बफ, "  %" + अनुप + "_p = getelementptr i8, ptr %" + अनुप + "_bp, i64 " + (16 + सूच * 8));
        एउ_ल(बफ, "  store i64 %v" + स[1] + ", ptr %" + अनुप + "_p");
        परत् 0;
    }
    यदि (कोड == "नव_वस्तु") {
        संख्या क्षेत्र_गण = 0;
        यदि (नि["अंश"]["क्षेत्र_गण"] != शून्यम्) { क्षेत्र_गण = नि["अंश"]["क्षेत्र_गण"]; }
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"वस्तु_रचना\"(i64 " + क्षेत्र_गण + ")");
        एउ_जड़_संचय(बफ, जड़_से, टीएन, दस);
        संचित[दस] = सत्य;
        एउ_कॉल_उत्सर्जन(बफ, टीएन, स्था_सिग्, रन_सिग्, बुलाए_सिम, नि["अंश"]["रचना"],
                        एउ_सूची_आगे_जोड़ो(दस, स), 0 - 1);
        परत् 0;
    }
    यदि (कोड == "प्रकार_है") {
        पाठ ज = नि["अंश"]["जाँच"];
        पाठ सिम = "रन_क्या_पाठ";
        यदि (ज == "शब्दकोश") { सिम = "रन_क्या_शब्दकोश"; }
        यदि (ज == "सूची") { सिम = "रन_क्या_सूची"; }
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"" + सिम + "\"(i64 %v" + स[0] + ")");
        परत् 0;
    }
    यदि (कोड == "अमृत" || कोड == "स्लॉट") { परत् 0; }
    परत् 0;   // स्थगित opcode — bugs की तरह, LLVM verifier खुद पकड़ लेगा
}

// [दस, स[0], स[1], ...] — रचना-कॉल के लिए (obj पहला तर्क)
कार्य एउ_सूची_आगे_जोड़ो(संख्या पहला, सूची शेष) {
    सूची फल = [पहला];
    संख्या इ = 0;
    यावत् (इ < लंबाई(शेष)) { फल = जोड़ें(फल, शेष[इ]); इ = इ + 1; }
    परत् फल;
}


कार्य एउ_स्थिर(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश एकक, शब्दकोश नि) {
    पाठ मप = नि["अंश"]["मान_प्रकार"];
    संख्या दस = नि["आईडी"];
    यदि (मप == "पूर्ण") {
        एउ_ल(बफ, "  %v" + दस + " = add i64 " + नि["अंश"]["मान"] + ", 0");
        परत् 0;
    }
    यदि (मप == "बूल") {
        मान म = नि["अंश"]["मान"];
        संख्या मव = 0;
        यदि (म == सत्य || म == 1) { मव = 1; }
        एउ_ल(बफ, "  %v" + दस + " = add i64 " + मव + ", 0");
        परत् 0;
    }
    यदि (मप == "शून्यम्") {
        एउ_ल(बफ, "  %v" + दस + " = add i64 0, 0");
        परत् 0;
    }
    यदि (मप == "दशमलव") {
        संख्या अनु = मध्यम_दशमलव_स्थिरांक(एकक, नि["अंश"]["मान"]);
        एउ_ल(बफ, "  %v" + दस + "_f = load double, ptr @.LC_dbl_" + अनु);
        एउ_ल(बफ, "  %v" + दस + " = bitcast double %v" + दस + "_f to i64");
        परत् 0;
    }
    यदि (मप == "पाठ") {
        संख्या अनु = नि["अंश"]["मान"];
        यदि (एकक["_पाठ_तालिका"] == सत्य) {
            एउ_ल(बफ, "  %v" + दस + " = load i64, ptr @.LC_strtab_" + अनु);
            परत् 0;
        }
        संख्या ब_लं = एउ_बाइट_लंबाई(एकक["पाठ_स्थिरांक"][अनु]);
        एउ_ल(बफ, "  %v" + दस + "_sp = ptrtoint ptr @.LC_str_" + अनु + " to i64");
        एउ_ल(बफ, "  %v" + दस + " = call i64 @\"पाठ_रचना\"(i64 %v" + दस + "_sp, i64 " + ब_लं + ")");
        परत् 0;
    }
    एउ_ल(बफ, "  %v" + दस + " = add i64 0, 0");
    परत् 0;
}


कार्य एउ_अंतर्(शब्दकोश बफ, शब्दकोश टीएन, शब्दकोश स्था_सिग्, शब्दकोश रन_सिग्, शब्दकोश बुलाए_सिम, शब्दकोश नि) {
    पाठ नाम = नि["अंश"]["नाम"];
    सूची स = नि["संचालक"];
    संख्या दस = नि["आईडी"];
    यदि (नाम == "अंतर्_पढ़8" || नाम == "अंतर्_पढ़1") {
        एउ_ल(बफ, "  %v" + दस + "_bp = inttoptr i64 %v" + स[0] + " to ptr");
        एउ_ल(बफ, "  %v" + दस + "_p = getelementptr i8, ptr %v" + दस + "_bp, i64 %v" + स[1]);
        यदि (नाम == "अंतर्_पढ़1") {
            एउ_ल(बफ, "  %v" + दस + "_b = load i8, ptr %v" + दस + "_p");
            एउ_ल(बफ, "  %v" + दस + " = zext i8 %v" + दस + "_b to i64");
        } अन्यथा {
            एउ_ल(बफ, "  %v" + दस + " = load i64, ptr %v" + दस + "_p");
        }
        परत् 0;
    }
    यदि (नाम == "अंतर्_लिख8" || नाम == "अंतर्_लिख1") {
        पाठ लप = "v" + दस;
        यदि (दस < 1) { लप = "t" + नि["_pos"]; }
        एउ_ल(बफ, "  %" + लप + "_bp = inttoptr i64 %v" + स[0] + " to ptr");
        एउ_ल(बफ, "  %" + लप + "_p = getelementptr i8, ptr %" + लप + "_bp, i64 %v" + स[1]);
        यदि (नाम == "अंतर्_लिख1") {
            एउ_ल(बफ, "  %" + लप + "_b = trunc i64 %v" + स[2] + " to i8");
            एउ_ल(बफ, "  store i8 %" + लप + "_b, ptr %" + लप + "_p");
        } अन्यथा {
            एउ_ल(बफ, "  store i64 %v" + स[2] + ", ptr %" + लप + "_p");
        }
        यदि (दस >= 1) { एउ_ल(बफ, "  %v" + दस + " = add i64 %v" + स[2] + ", 0"); }
        परत् 0;
    }
    यदि (नाम == "अंतर्_मुद्रण") {
        एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, "सूत्र_तल_मुद्रण", "void", ["i64", "i64"]);
        पाठ मप = "v" + दस;
        यदि (दस < 1) { मप = "t" + नि["_pos"]; }
        एउ_ल(बफ, "  %" + मप + "_addr = add i64 %v" + स[0] + ", %v" + स[1]);
        एउ_ल(बफ, "  call void @\"सूत्र_तल_मुद्रण\"(i64 %" + मप + "_addr, i64 %v" + स[2] + ")");
        परत् 0;
    }
    यदि (नाम == "अंतर्_बिट_और" || नाम == "अंतर्_बिट_या" || नाम == "अंतर्_बिट_भेद") {
        पाठ यं = "and";
        यदि (नाम == "अंतर्_बिट_या") { यं = "or"; }
        यदि (नाम == "अंतर्_बिट_भेद") { यं = "xor"; }
        एउ_ल(बफ, "  %v" + दस + " = " + यं + " i64 %v" + स[0] + ", %v" + स[1]);
        परत् 0;
    }
    यदि (नाम == "अंतर्_बिट_उलट") {
        एउ_ल(बफ, "  %v" + दस + " = xor i64 %v" + स[0] + ", -1");
        परत् 0;
    }
    यदि (नाम == "अंतर्_बाम_सरक" || नाम == "अंतर्_दक्षिण_सरक") {
        पाठ यं = "shl";
        यदि (नाम == "अंतर्_दक्षिण_सरक") { यं = "lshr"; }
        एउ_ल(बफ, "  %v" + दस + " = " + यं + " i64 %v" + स[0] + ", %v" + स[1]);
        परत् 0;
    }
    एउ_कॉल_उत्सर्जन(बफ, टीएन, स्था_सिग्, रन_सिग्, बुलाए_सिम, एउ_अंतर्_प्रतीक(नाम), स, दस);
    परत् 0;
}


// ============================================================
// टर्मिनेटर — LLVM phi खुद संभालता, edge-splitting/parallel-move अनावश्यक
// ============================================================
कार्य एउ_टर्मिनेटर(शब्दकोश बफ, शब्दकोश फलन, शब्दकोश टीएन, शब्दकोश खंड, पाठ वापसी_प्रकार,
                   शब्दकोश लेबल_नक्शा, शब्दकोश बुलाए_सिम, शब्दकोश स्था_सिग्, शब्दकोश रन_सिग्) {
    पाठ बीब = एउ_बीब(लेबल_नक्शा, खंड["लेबल"]);
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम्) {
        एउ_जड़_पॉप(बफ, फलन, "uf_" + बीब);
        एउ_वापसी_डिफ़ॉल्ट(बफ, वापसी_प्रकार);
        परत् 0;
    }
    पाठ कोड = अंत["कोड"];
    यदि (कोड == "वापस") {
        एउ_जड़_पॉप(बफ, फलन, "r_" + बीब);
        यदि (वापसी_प्रकार == "void") {
            एउ_ल(बफ, "  ret void");
        } अन्यथा यदि (लंबाई(अंत["संचालक"]) > 0) {
            एउ_ल(बफ, "  ret " + एउ_कास्ट_तर्क(बफ, टीएन, अंत["संचालक"][0], वापसी_प्रकार, "ret_" + बीब));
        } अन्यथा {
            एउ_वापसी_डिफ़ॉल्ट(बफ, वापसी_प्रकार);
        }
        परत् 0;
    }
    यदि (कोड == "जाओ") {
        एउ_ल(बफ, "  br label %" + एउ_बीब(लेबल_नक्शा, अंत["अंश"]["लक्ष्य"]));
        परत् 0;
    }
    यदि (कोड == "यदि_जाओ") {
        संख्या शर्त = अंत["संचालक"][0];
        एउ_ल(बफ, "  %c" + शर्त + "_" + बीब + " = icmp ne i64 %v" + शर्त + ", 0");
        एउ_ल(बफ, "  br i1 %c" + शर्त + "_" + बीब + ", label %" + एउ_बीब(लेबल_नक्शा, अंत["अंश"]["सत्य"])
              + ", label %" + एउ_बीब(लेबल_नक्शा, अंत["अंश"]["असत्य"]));
        परत् 0;
    }
    यदि (कोड == "फेंको") {
        पाठ थ_तर्क = एउ_कास्ट_तर्क(बफ, टीएन, अंत["संचालक"][0], "i64", "th_" + बीब);
        एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, "फेंको", "void", ["i64"]);
        एउ_ल(बफ, "  call void @\"फेंको\"(" + थ_तर्क + ")");
        एउ_ल(बफ, "  unreachable");
        परत् 0;
    }
    एउ_जड़_पॉप(बफ, फलन, "d_" + बीब);
    एउ_वापसी_डिफ़ॉल्ट(बफ, वापसी_प्रकार);
    परत् 0;
}
कार्य एउ_बीब(शब्दकोश लेबल_नक्शा, पाठ मूल) {
    मान ब = लेबल_नक्शा[मूल];
    यदि (ब == शून्यम्) { परत् मूल; }
    परत् ब;
}
कार्य एउ_वापसी_डिफ़ॉल्ट(शब्दकोश बफ, पाठ वापसी_प्रकार) {
    यदि (वापसी_प्रकार == "void") { एउ_ल(बफ, "  ret void"); परत् 0; }
    यदि (वापसी_प्रकार == "ptr") { एउ_ल(बफ, "  ret ptr null"); परत् 0; }
    एउ_ल(बफ, "  ret i64 0");
    परत् 0;
}


// ============================================================
// एक फलन → LLVM define
// ============================================================
कार्य एउ_कार्य(शब्दकोश बफ, शब्दकोश एकक, शब्दकोश फलन, शब्दकोश स्था_सिग्, शब्दकोश रन_सिग्, शब्दकोश बुलाए_सिम) {
    पाठ नाम = फलन["नाम"];
    यदि (नाम == "मुख्य") { नाम = "sutra_main"; }
    शब्दकोश टीएन = एउ_मान_प्रकार_नक्शा(फलन);
    शब्दकोश कच्चा = एउ_कच्चा_प्रकार_नक्शा(फलन);
    फलन["_सूचीसेट"] = एउ_सूची_सेट(फलन);
    एउ_पूर्णत्व_अनुमान(फलन, फलन["_सूचीसेट"], कच्चा);
    शब्दकोश जड़_से = एउ_जड़_सेट(फलन);
    शब्दकोश मृत्यु_नक्शा = एउ_मृत्यु_नक्शा(फलन);
    शब्दकोश संचित = {};
    पाठ वापसी_प्रकार = एउ_प्रकार(फलन["परत्_प्रकार"]);

    पाठ पैरा_पाठ = "";
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = 0;
    यावत् (प < लंबाई(पैरा)) {
        यदि (प > 0) { पैरा_पाठ = पैरा_पाठ + ", "; }
        पैरा_पाठ = पैरा_पाठ + एउ_टाइप्ड(टीएन, पैरा[प]["आईडी"]);
        प = प + 1;
    }
    // लेबल → ASCII नक्शा (LLVM unquoted पहचान में Devanagari अमान्य)
    शब्दकोश लेबल_नक्शा = {};
    सूची सारे_खंड = फलन["खंड_सूची"];
    संख्या लि = 0;
    यावत् (लि < लंबाई(सारे_खंड)) {
        लेबल_नक्शा[सारे_खंड[लि]["लेबल"]] = "bb" + लि;
        लि = लि + 1;
    }

    // whole-program #4: user-program मॉड्यूल की हर फलन internal — llvm-link के
    // बाद merged module में @main के सिवा कुछ बाहर से नहीं बुलाया जाता, तो clang
    // -O3 उन पर DCE/विशेषीकरण/aggressive-inline कर सकता। runtime मॉड्यूल
    // (library-mode) external रहते — उनके प्रतीक user मॉड्यूल के declare को
    // llvm-link के समय satisfy करने पड़ते (internal तब invisible होता)।
    पाठ कड़ी = "";
    यदि (एकक["मुख्य_है"] == सत्य || एकक["शीर्ष_है"] == सत्य) { कड़ी = "internal "; }
    एउ_ल(बफ, "define " + कड़ी + वापसी_प्रकार + " @\"" + नाम + "\"(" + पैरा_पाठ + ") {");
    एउ_ल(बफ, "entry:");
    एउ_जड़_प्रोलॉग(बफ, फलन);
    प = 0;
    यावत् (प < लंबाई(पैरा)) {
        एउ_जड़_संचय(बफ, जड़_से, टीएन, पैरा[प]["आईडी"]);
        प = प + 1;
    }
    यदि (लंबाई(सारे_खंड) > 0) {
        एउ_ल(बफ, "  br label %" + एउ_बीब(लेबल_नक्शा, सारे_खंड[0]["लेबल"]));
    }

    शब्दकोश अशक्त = एउ_अशक्त_फाई_सेट(फलन);
    सूची क्रम = अनु_विपक्रम(फलन);
    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, क्रम[कक]);
        एउ_ल(बफ, एउ_बीब(लेबल_नक्शा, क्रम[कक]) + ":");
        // पास 1: सारे phi सबसे ऊपर (LLVM नियम: phi खंड के आरंभ में समूहित)
        संख्या फप = 0;
        सूची फस = खंड["फाई"];
        यावत् (फप < लंबाई(फस)) {
            एउ_फाई(बफ, टीएन, लेबल_नक्शा, अशक्त, फस[फप]);
            फप = फप + 1;
        }
        // पास 2: phi-परिणाम root-store (अशक्त phi छोड़कर — वो emit ही नहीं हुए)
        फप = 0;
        यावत् (फप < लंबाई(फस)) {
            यदि (अशक्त[फस[फप]["आईडी"]] != सत्य) {
                एउ_जड़_संचय(बफ, जड़_से, टीएन, फस[फप]["आईडी"]);
            }
            फप = फप + 1;
        }
        संख्या नि = 0;
        सूची निस = खंड["निर्देश"];
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश निर्देश = निस[नि];
            एउ_निर्देश(बफ, फलन, एकक, टीएन, कच्चा, जड़_से, स्था_सिग्, रन_सिग्, बुलाए_सिम, संचित, निर्देश);
            यदि (निर्देश["आईडी"] >= 1 && संचित[निर्देश["आईडी"]] != सत्य) {
                एउ_जड़_संचय(बफ, जड़_से, टीएन, निर्देश["आईडी"]);
            }
            एउ_जड़_मृत्यु(बफ, मृत्यु_नक्शा, निर्देश["_pos"]);
            नि = नि + 1;
        }
        एउ_टर्मिनेटर(बफ, फलन, टीएन, खंड, वापसी_प्रकार, लेबल_नक्शा, बुलाए_सिम, स्था_सिग्, रन_सिग्);
        कक = कक + 1;
    }
    एउ_ल(बफ, "}");
    एउ_ल(बफ, "");
    परत् 0;
}

// "पूर्णतः अशक्त" phi-set — जिन phi के सारे source undef हों (id<1, या
// self-सन्दर्भ, या transitively किसी और अशक्त phi का)। ऐसे phi का मान
// अर्थहीन (सिर्फ़ undef) पर mem2reg उन्हें पूरी तरह नहीं हटा पाया, और उनका
// cross-block उपयोग LLVM की strict SSA-dominance जाँच तोड़ देता (x86 का
// edge-move lowering सहन कर लेता)। इन्हें emit ही नहीं करते और इनका हर
// संदर्भ undef कर देते। fixpoint जब तक set बढ़ना बंद न हो।
कार्य एउ_अशक्त_फाई_सेट(शब्दकोश फलन) {
    शब्दकोश सेट = {};
    सूची खस = फलन["खंड_सूची"];
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        संख्या ख = 0;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = 0;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                यदि (सेट[पिड] != सत्य) {
                    सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                    मान सब_अशक्त = सत्य;
                    संख्या स = 0;
                    यावत् (स < लंबाई(स्रोत)) {
                        संख्या सिड = स्रोत[स][1];
                        यदि (सिड >= 1 && सिड != पिड && सेट[सिड] != सत्य) { सब_अशक्त = असत्य; }
                        स = स + 1;
                    }
                    यदि (लंबाई(स्रोत) > 0 && सब_अशक्त) { सेट[पिड] = सत्य; बदला = सत्य; }
                }
                फ = फ + 1;
            }
            ख = ख + 1;
        }
    }
    परत् सेट;
}

कार्य एउ_फाई(शब्दकोश बफ, शब्दकोश टीएन, शब्दकोश लेबल_नक्शा, शब्दकोश अशक्त, शब्दकोश फ) {
    संख्या दस = फ["आईडी"];
    यदि (अशक्त[दस] == सत्य) { परत् 0; }   // पूर्णतः-अशक्त phi — emit नहीं
    पाठ प्रकार_त = एउ_प्रकार_या(टीएन, दस, "i64");
    सूची स्रोत = फ["अंश"]["स्रोत"];
    पाठ स्रोत_पाठ = "";
    संख्या इ = 0;
    यावत् (इ < लंबाई(स्रोत)) {
        यदि (इ > 0) { स्रोत_पाठ = स्रोत_पाठ + ", "; }
        पाठ मव_पाठ = "%v" + स्रोत[इ][1];
        // अनारंभित पथ (id<1), self-सन्दर्भ (तुच्छ phi), या किसी अशक्त phi
        // का संदर्भ → undef
        यदि (स्रोत[इ][1] < 1 || स्रोत[इ][1] == दस || अशक्त[स्रोत[इ][1]] == सत्य) { मव_पाठ = "undef"; }
        स्रोत_पाठ = स्रोत_पाठ + "[ " + मव_पाठ + ", %" + एउ_बीब(लेबल_नक्शा, स्रोत[इ][0]) + " ]";
        इ = इ + 1;
    }
    एउ_ल(बफ, "  %v" + दस + " = phi " + प्रकार_त + " " + स्रोत_पाठ);
    परत् 0;
}


// ============================================================
// __main (mingw target हर 'main' नाम के फलन में स्वतः इसे बुलाता — देखें
// टिप्पणी: सूत्र में C++-शैली static ctor नहीं, इसलिए no-op काफ़ी)
// ============================================================
कार्य एउ___मुख्य_स्टब(शब्दकोश बफ) {
    एउ_ल(बफ, "define void @__main() {");
    एउ_ल(बफ, "entry:");
    एउ_ल(बफ, "  ret void");
    एउ_ल(बफ, "}");
    एउ_ल(बफ, "");
    परत् 0;
}


// ============================================================
// पाठ-साहित्य startup — हर स्थिरांक एक बार बनाओ, अलग स्थायी global में
// रखो (सन्निहित .bss array नहीं — separate globals सरल/पर्याप्त), फिर
// स्थायी GC-जड़ पंजीकरण (कभी pop नहीं)
// ============================================================
कार्य एउ_पाठ_तालिका_आरंभ(शब्दकोश बफ, शब्दकोश एकक) {
    सूची पस = एकक["पाठ_स्थिरांक"];
    संख्या नग = लंबाई(पस);
    यदि (नग == 0) { परत् 0; }
    एउ_ल(बफ, "define internal void @\"सूत्र_पाठ_तालिका_आरंभ\"() {");
    एउ_ल(बफ, "entry:");
    संख्या इक = 0;
    यावत् (इक < नग) {
        संख्या ब_लं = एउ_बाइट_लंबाई(पस[इक]);
        एउ_ल(बफ, "  %sp" + इक + " = ptrtoint ptr @.LC_str_" + इक + " to i64");
        एउ_ल(बफ, "  %s" + इक + " = call i64 @\"पाठ_रचना\"(i64 %sp" + इक + ", i64 " + ब_लं + ")");
        एउ_ल(बफ, "  store i64 %s" + इक + ", ptr @.LC_strtab_" + इक);
        एउ_ल(बफ, "  %cnt" + इक + " = load i32, ptr @gc_roots_count");
        एउ_ल(बफ, "  %idx" + इक + " = sext i32 %cnt" + इक + " to i64");
        एउ_ल(बफ, "  %slot" + इक + " = getelementptr [1000000 x ptr], ptr @gc_roots, i64 0, i64 %idx" + इक);
        एउ_ल(बफ, "  store ptr @.LC_strtab_" + इक + ", ptr %slot" + इक);
        एउ_ल(बफ, "  %cnt" + इक + "n = add i32 %cnt" + इक + ", 1");
        एउ_ल(बफ, "  store i32 %cnt" + इक + "n, ptr @gc_roots_count");
        इक = इक + 1;
    }
    एउ_ल(बफ, "  ret void");
    एउ_ल(बफ, "}");
    एउ_ल(बफ, "");
    परत् 0;
}


// ============================================================
// असली PE main — .exe का वास्तविक प्रवेश-बिंदु (mainCRTStartup, तल.s
// में, "main" नाम से इसे बुलाता — बदला नहीं जा सकता, frozen runtime)
// ============================================================
कार्य एउ_मुख्य(शब्दकोश बफ, शब्दकोश एकक, शब्दकोश स्था_सिग्) {
    सूची वस = एकक["वैश्विक_सूची"];
    एउ_ल(बफ, "define i32 @main() {");
    एउ_ल(बफ, "entry:");
    यदि (लंबाई(एकक["पाठ_स्थिरांक"]) > 0) {
        एउ_ल(बफ, "  call void @\"सूत्र_पाठ_तालिका_आरंभ\"()");
    }
    संख्या इक = 0;
    यावत् (इक < लंबाई(वस)) {
        एउ_ल(बफ, "  call void @sutra_gc_push_root(ptr @\"sutra_glob_" + वस[इक]["नाम"] + "\")");
        इक = इक + 1;
    }
    एउ_ल(बफ, "  call void @\"सूत्र_स्वजीसी_आरंभ\"()");
    यदि (एकक["शीर्ष_है"] == सत्य) { एउ_शून्य_तर्क_कॉल(बफ, स्था_सिग्, "__शीर्ष", "top"); }
    यदि (एकक["मुख्य_है"] == सत्य) { एउ_शून्य_तर्क_कॉल(बफ, स्था_सिग्, "sutra_main", "smain"); }
    इक = लंबाई(वस) - 1;
    यावत् (इक >= 0) {
        एउ_ल(बफ, "  call void @sutra_gc_pop_root(ptr @\"sutra_glob_" + वस[इक]["नाम"] + "\")");
        इक = इक - 1;
    }
    एउ_ल(बफ, "  ret i32 0");
    एउ_ल(बफ, "}");
    एउ_ल(बफ, "");
    परत् 0;
}
कार्य एउ_शून्य_तर्क_कॉल(शब्दकोश बफ, शब्दकोश स्था_सिग्, पाठ नाम, पाठ अ_टैग) {
    मान सिग् = स्था_सिग्[नाम];
    पाठ वापसी_प्रकार = "void";
    यदि (सिग् != शून्यम् && सिग्["परत्"] != शून्यम्) { वापसी_प्रकार = सिग्["परत्"]; }
    यदि (वापसी_प्रकार == "void") {
        एउ_ल(बफ, "  call void @\"" + नाम + "\"()");
    } अन्यथा {
        एउ_ल(बफ, "  %discard_" + अ_टैग + " = call " + वापसी_प्रकार + " @\"" + नाम + "\"()");
    }
    परत् 0;
}


// ============================================================
// रनटाइम घोषणाएँ (declare) — केवल असल में बुलाए गए बाहरी प्रतीक
// (LLVM पाठ IR forward-ref की अनुमति देता — declare अंत में ठीक)
// ============================================================
कार्य एउ_घोषणाएं(शब्दकोश बफ, शब्दकोश बुलाए_सिम) {
    एउ_ल(बफ, "");
    एउ_ल(बफ, "@gc_roots = external global [1000000 x ptr]");
    एउ_ल(बफ, "@gc_roots_count = external global i32");
    सूची नाम_सू = कुंजियाँ(बुलाए_सिम);
    संख्या इ = 0;
    यावत् (इ < लंबाई(नाम_सू)) {
        पाठ नाम = नाम_सू[इ];
        शब्दकोश सिग् = बुलाए_सिम[नाम];
        पाठ पैरा_पाठ = संयोजित(सिग्["पैरा"], ", ");
        पाठ गुण_पाठ = "";
        यदि (सिग्["गुण"] != शून्यम्) { गुण_पाठ = सिग्["गुण"]; }
        एउ_ल(बफ, "declare " + सिग्["परत्"] + " @\"" + नाम + "\"(" + पैरा_पाठ + ")" + गुण_पाठ);
        इ = इ + 1;
    }
    एउ_ल(बफ, "");
    परत् 0;
}


// ============================================================
// एकक → पूर्ण .ll
// ============================================================
कार्य एलएलवीएम_उत्सर्जक_एकक(शब्दकोश एकक) {
    शब्दकोश बफ = एउ_नया();

    यदि (एकक["मुख्य_है"] == सत्य || एकक["शीर्ष_है"] == सत्य) {
        एकक["_पाठ_तालिका"] = सत्य;
    }

    सूची कस = एकक["कार्य_सूची"];
    शब्दकोश स्था_सिग् = एउ_स्थानीय_सिग्(कस);
    शब्दकोश रन_सिग् = एउ_रनटाइम_सिग्();
    शब्दकोश बुलाए_सिम = {};

    संख्या इक = 0;
    यावत् (इक < लंबाई(कस)) {
        यदि (कस[इक]["रजि_नियतन"] == शून्यम्) { रजि_नियतक_कार्य(कस[इक]); }
        इक = इक + 1;
    }

    // हमेशा-ज़रूरी प्रतीक पहले से दर्ज
    मान मुख्य_या_शीर्ष = एकक["मुख्य_है"] == सत्य || एकक["शीर्ष_है"] == सत्य;
    यदि (मुख्य_या_शीर्ष) {
        एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, "सूत्र_स्वजीसी_आरंभ", "void", []);
        यदि (लंबाई(एकक["वैश्विक_सूची"]) > 0) {
            एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, "sutra_gc_push_root", "void", ["i64"]);
            एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, "sutra_gc_pop_root", "void", ["i64"]);
        }
        यदि (लंबाई(एकक["पाठ_स्थिरांक"]) > 0) {
            एउ_सिम_दर्ज(बुलाए_सिम, स्था_सिग्, रन_सिग्, "पाठ_रचना", "i64", ["i64", "i64"]);
        }
    }

    // @__main स्टब सिर्फ़ तभी जब @main निकलेगा (mingw उसी में call @__main
    // घुसाता) — library-mode module (runtime bitcode) में नहीं, वरना user
    // program के @__main से टकराव
    यदि (मुख्य_या_शीर्ष) { एउ___मुख्य_स्टब(बफ); }

    इक = 0;
    यावत् (इक < लंबाई(कस)) {
        एउ_कार्य(बफ, एकक, कस[इक], स्था_सिग्, रन_सिग्, बुलाए_सिम);
        इक = इक + 1;
    }

    यदि (एकक["_पाठ_तालिका"] == सत्य && लंबाई(एकक["पाठ_स्थिरांक"]) > 0) {
        एउ_पाठ_तालिका_आरंभ(बफ, एकक);
    }

    यदि (मुख्य_या_शीर्ष) {
        एउ_मुख्य(बफ, एकक, स्था_सिग्);
    }

    सूची वस = एकक["वैश्विक_सूची"];
    इक = 0;
    यावत् (इक < लंबाई(वस)) {
        पाठ प्र = एउ_प्रकार(वस[इक]["प्रकार"]);
        पाठ शुरू = "0";
        यदि (प्र == "ptr") { शुरू = "null"; }
        एउ_ल(बफ, "@\"sutra_glob_" + वस[इक]["नाम"] + "\" = global " + प्र + " " + शुरू);
        इक = इक + 1;
    }

    सूची दस्ू = एकक["दशमलव_स्थिरांक"];
    इक = 0;
    यावत् (इक < लंबाई(दस्ू)) {
        एउ_ल(बफ, "@.LC_dbl_" + इक + " = private unnamed_addr constant double " + दस्ू[इक]);
        इक = इक + 1;
    }

    सूची पस = एकक["पाठ_स्थिरांक"];
    इक = 0;
    यावत् (इक < लंबाई(पस)) {
        संख्या ब_लं = एउ_बाइट_लंबाई(पस[इक]);
        एउ_ल(बफ, "@.LC_str_" + इक + " = private unnamed_addr constant [" + ब_लं + " x i8] c\""
              + एउ_एस्केप(पस[इक]) + "\"");
        यदि (एकक["_पाठ_तालिका"] == सत्य) {
            एउ_ल(बफ, "@.LC_strtab_" + इक + " = global i64 0");
        }
        इक = इक + 1;
    }

    // सारे ज्ञात runtime प्रतीक declare कर दो (अप्रयुक्त declare हानिरहित) —
    // hardcoded call-स्थल जो एउ_कॉल_उत्सर्जन से नहीं गुज़रते, वो भी ढँक जाते
    सूची रन_नाम = कुंजियाँ(रन_सिग्);
    संख्या रि = 0;
    यावत् (रि < लंबाई(रन_नाम)) {
        पाठ रनम = रन_नाम[रि];
        यदि (बुलाए_सिम[रनम] == शून्यम् && स्था_सिग्[रनम] == शून्यम्) {
            बुलाए_सिम[रनम] = रन_सिग्[रनम];
        }
        रि = रि + 1;
    }

    एउ_घोषणाएं(बफ, बुलाए_सिम);
    परत् एउ_पाठ(बफ);
}
