// गहन_अंतर्वेशन.सूत्र — bounded self-recursive inlining [§4 perf]
// ============================================================
// लक्ष्य: fib(35)-शैली non-tail self-recursion (न TCO का पुच्छ-दायरा,
// न अंतर्वेशन v1 का non-self दायरा छूता) — self-recursive कॉल को
// अपने ही फलन की एक क्लोन-प्रति से एक स्तर गहराई तक splice करना, ताकि
// call-tree के आख़िरी स्तर का call-overhead कटे।
//
// अंतर्वेशन.सूत्र (v1) सिर्फ़ single-block, non-self callee संभालता —
// fib खुद multi-block (यदि/अन्यथा) है, तो यहाँ असली CFG-सर्जरी चाहिए:
// कॉलर-ब्लॉक को कॉल पर तोड़ना + callee के सारे ब्लॉक क्लोन करना + हर
// callee "वापस" को एक नए "जारी" continuation-ब्लॉक पर phi-merge करना।
// यह दोनों तरकीबें इसी सत्र में पहले से बनी और जाँची जा चुकी हैं —
// single-block clone-and-rename (अंतर्वेशन.सूत्र की अवे_क्लोन_करो/
// अवे_अंश_प्रति/अवे_संचालक_अनुवाद, यहाँ पुनः इस्तेमाल), और
// multi-source phi-at-a-merge-point (पुच्छ_अनुकूलन.सूत्र का loop-header
// पैटर्न, यहाँ continuation-ब्लॉक पर)।
//
// v1 दायरा — सख़्ती से बंधित, कोई पुनरावृत्ति नहीं:
//   - सिर्फ़ self-recursion (लक्ष्य == फलन का अपना नाम)।
//   - फलन का कुल आकार (सारे ब्लॉक मिलाकर) <= 15 निर्देश।
//   - अधिकतम 2 self-recursive कॉल-स्थल (fib जैसा आकार)।
//   - हर ब्लॉक का अंत सिर्फ़ वापस/जाओ/यदि_जाओ (अन्य टर्मिनेटर = अयोग्य)।
//   - बिल्कुल एक ही pass, कोई fixpoint नहीं — हर उम्मीदवार हमेशा फलन की
//     *मूल, अपरिवर्तित* ब्लॉक-सूची से क्लोन होता (कभी नए-splice किए
//     कोड से नहीं) — यही गहराई-1 की सीमा को पक्का बाँधता, कोई राउंड-
//     गिनती ग़लत होने का जोखिम नहीं। उम्मीदवार पीछे से आगे प्रोसेस होते
//     ताकि एक स्थल का splice पहले वाले स्थलों के ब्लॉक-संदर्भ न बिगाड़े।
//
// अभी कहीं wire नहीं — केवल गहन_अंतर्वेशन_परीक्षण.सूत्र से जाँचा।
// ============================================================

आयात "अनुकूलक.सूत्र";
आयात "अंतर्वेशन.सूत्र";

कार्य गअ_सीमा() { परत् १५; }

// क्या फलन के हर ब्लॉक का अंत सिर्फ़ वापस/जाओ/यदि_जाओ में से एक है?
कार्य गअ_टर्मिनेटर_सुरक्षित(सूची खस) {
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        मान अंत = खस[ख]["अंत"];
        यदि (अंत == शून्यम्) { परत् असत्य; }
        पाठ कोड = अंत["कोड"];
        यदि (कोड != "वापस" && कोड != "जाओ" && कोड != "यदि_जाओ") { परत् असत्य; }
        ख = ख + १;
    }
    परत् सत्य;
}

// callee के पूरे ब्लॉक-सेट (मूल_खंड_सूची) को कॉलर-फलन में क्लोन करो —
// फ्रेश labels + फ्रेश ids, पैरामीटर argument से replace, हर "वापस" को
// "जाओ जारी" में बदलकर उसका मान जारी-phi का एक स्रोत बना दो।
// लौटाता है {"प्रवेश_लेबल", "वापस_स्रोत"}
कार्य गअ_बहु_खंड_क्लोन(शब्दकोश फलन, सूची मूल_खंड_सूची, शब्दकोश बुलाओ_नि, शब्दकोश जारी) {
    सूची तर्क = बुलाओ_नि["संचालक"];
    सूची पैरा = फलन["पैरामीटर"];

    // पास 1 — लेबल-नक्शा + मान-नक्शा दोनों (पूरे मूल_खंड_सूची पर) बनाओ
    शब्दकोश लेबल_नक्शा = {};
    शब्दकोश मान_नक्शा = {};
    संख्या प = ०;
    यावत् (प < लंबाई(पैरा)) {
        मान_नक्शा[पैरा[प]["आईडी"]] = तर्क[प];
        प = प + १;
    }
    संख्या ख = ०;
    यावत् (ख < लंबाई(मूल_खंड_सूची)) {
        शब्दकोश मूल_खंड = मूल_खंड_सूची[ख];
        शब्दकोश नया_खंड = मध्यम_नव_खंड(फलन, "गहन_क्लोन");
        लेबल_नक्शा[मूल_खंड["लेबल"]] = नया_खंड["लेबल"];
        सूची फस = मूल_खंड["फाई"];
        संख्या फि = ०;
        यावत् (फि < लंबाई(फस)) {
            मान_नक्शा[फस[फि]["आईडी"]] = मध्यम_ताजा_आईडी(फलन);
            फि = फि + १;
        }
        सूची निस = मूल_खंड["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] >= १) { मान_नक्शा[निस[नि]["आईडी"]] = मध्यम_ताजा_आईडी(फलन); }
            नि = नि + १;
        }
        ख = ख + १;
    }

    // पास 2 — हर मूल ब्लॉक को उसके (पास 1 में बने) क्लोन-ब्लॉक में भरो
    सूची वापस_स्रोत = [];
    ख = ०;
    यावत् (ख < लंबाई(मूल_खंड_सूची)) {
        शब्दकोश मूल_खंड = मूल_खंड_सूची[ख];
        शब्दकोश नया_खंड = अनु_खंड_खोजें(फलन, लेबल_नक्शा[मूल_खंड["लेबल"]]);

        सूची फस = मूल_खंड["फाई"];
        सूची नई_फाई = [];
        संख्या फि = ०;
        यावत् (फि < लंबाई(फस)) {
            शब्दकोश मूल_फाई = फस[फि];
            संख्या नई_आईडी = मान_नक्शा[मूल_फाई["आईडी"]];
            सूची पुराने_स्रोत = मूल_फाई["अंश"]["स्रोत"];
            सूची नए_स्रोत = [];
            संख्या सि = ०;
            यावत् (सि < लंबाई(पुराने_स्रोत)) {
                पाठ स्रोत_लेबल = पुराने_स्रोत[सि][०];
                संख्या स्रोत_मव = पुराने_स्रोत[सि][१];
                पाठ नया_स्रोत_लेबल = स्रोत_लेबल;
                यदि (लेबल_नक्शा[स्रोत_लेबल] != शून्यम्) { नया_स्रोत_लेबल = लेबल_नक्शा[स्रोत_लेबल]; }
                संख्या नया_मव = स्रोत_मव;
                यदि (स्रोत_मव >= १ && मान_नक्शा[स्रोत_मव] != शून्यम्) { नया_मव = मान_नक्शा[स्रोत_मव]; }
                नए_स्रोत = जोड़ें(नए_स्रोत, [नया_स्रोत_लेबल, नया_मव]);
                सि = सि + १;
            }
            शब्दकोश नया_अंश = {};
            नया_अंश["स्रोत"] = नए_स्रोत;
            शब्दकोश नई_फाई_नि = मध्यम_निर्देश_बनाओ("फाई", नई_आईडी, मूल_फाई["प्रकार"], [], नया_अंश);
            नई_फाई = जोड़ें(नई_फाई, नई_फाई_नि);
            फि = फि + १;
        }
        नया_खंड["फाई"] = नई_फाई;

        सूची निस = मूल_खंड["निर्देश"];
        सूची नई_निस = [];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश मूल_नि = निस[नि];
            संख्या नई_आईडी = ० - १;
            यदि (मूल_नि["आईडी"] >= १) { नई_आईडी = मान_नक्शा[मूल_नि["आईडी"]]; }
            सूची नए_संचालक = अवे_संचालक_अनुवाद(मूल_नि["संचालक"], मान_नक्शा);
            शब्दकोश नई_नि = मध्यम_निर्देश_बनाओ(मूल_नि["कोड"], नई_आईडी, मूल_नि["प्रकार"],
                                               नए_संचालक, अवे_अंश_प्रति(मूल_नि["अंश"]));
            नई_निस = जोड़ें(नई_निस, नई_नि);
            नि = नि + १;
        }
        नया_खंड["निर्देश"] = नई_निस;

        मान मूल_अंत = मूल_खंड["अंत"];
        यदि (मूल_अंत["कोड"] == "वापस") {
            सूची वा_संच = मूल_अंत["संचालक"];
            संख्या अनूदित_मान = ० - १;
            यदि (लंबाई(वा_संच) > ०) {
                संख्या मूल_मव = वा_संच[०];
                यदि (मूल_मव >= १ && मान_नक्शा[मूल_मव] != शून्यम्) { अनूदित_मान = मान_नक्शा[मूल_मव]; }
                अन्यथा { अनूदित_मान = मूल_मव; }
            }
            वापस_स्रोत = जोड़ें(वापस_स्रोत, [नया_खंड["लेबल"], अनूदित_मान]);
            मध्यम_जाओ(नया_खंड, जारी["लेबल"]);
        } अन्यथा यदि (मूल_अंत["कोड"] == "जाओ") {
            पाठ लक्ष्य = मूल_अंत["अंश"]["लक्ष्य"];
            यदि (लेबल_नक्शा[लक्ष्य] != शून्यम्) { लक्ष्य = लेबल_नक्शा[लक्ष्य]; }
            मध्यम_जाओ(नया_खंड, लक्ष्य);
        } अन्यथा यदि (मूल_अंत["कोड"] == "यदि_जाओ") {
            संख्या शर्त_आईडी = मूल_अंत["संचालक"][०];
            यदि (शर्त_आईडी >= १ && मान_नक्शा[शर्त_आईडी] != शून्यम्) { शर्त_आईडी = मान_नक्शा[शर्त_आईडी]; }
            पाठ सत्य_लेबल = मूल_अंत["अंश"]["सत्य"];
            यदि (लेबल_नक्शा[सत्य_लेबल] != शून्यम्) { सत्य_लेबल = लेबल_नक्शा[सत्य_लेबल]; }
            पाठ असत्य_लेबल = मूल_अंत["अंश"]["असत्य"];
            यदि (लेबल_नक्शा[असत्य_लेबल] != शून्यम्) { असत्य_लेबल = लेबल_नक्शा[असत्य_लेबल]; }
            मध्यम_यदि_जाओ(नया_खंड, शर्त_आईडी, सत्य_लेबल, असत्य_लेबल);
        }

        ख = ख + १;
    }

    शब्दकोश परिणाम = {};
    परिणाम["प्रवेश_लेबल"] = लेबल_नक्शा[मूल_खंड_सूची[०]["लेबल"]];
    परिणाम["वापस_स्रोत"] = वापस_स्रोत;
    परत् परिणाम;
}

// एक self-recursive कॉल-स्थल को splice करो — कॉलर-खंड को कॉल पर तोड़ो,
// callee की मूल (अपरिवर्तित) ब्लॉक-सूची क्लोन करो, "जारी" पर मिलाओ।
// ध्यान: स्नैपशॉट लेबल/फाई/निर्देश/अंत की स्वतंत्र प्रतियों वाला होना चाहिए
// (नीचे गहन_अंतर्वेशन_फलन में बना) — असली फलन["खंड_सूची"] के block-object
// नहीं, क्योंकि यह फलन खंड को जगह पर बदलता (mutate) है, और वही block-object
// एक से अधिक candidate के बीच साझा हो सकता है (जैसे फिब — दोनों self-कॉल
// एक ही ब्लॉक में)। जगह-पर mutation (नीचे) हमेशा क्लोनिंग (ऊपर) के बाद ही।
//
// रीनेम (अनु_हर_उपयोग_बदलो) यहीं नहीं लगाया जाता — सिर्फ़ [पुराना_id, नया_id]
// जोड़ी लौटाई जाती है, कॉलर बाद में लागू करे। कारण: अनु_हर_उपयोग_बदलो किसी
// निर्देश के "संचालक" को जगह पर mutate करता है, और वो instruction-object
// (जैसे बाद में जारी में गया मूल "योग" निर्देश) उसी dict-object को स्नैपशॉट
// भी संदर्भित करता है (स्नैपशॉट सिर्फ़ block-level कॉपी है, हर निर्देश की
// अलग कॉपी नहीं) — अगर रीनेम यहीं तुरंत लगे, तो अगले candidate की क्लोनिंग
// (जो अभी भी उसी स्नैपशॉट से पढ़ती) एक बदला हुआ (गलत) operand पढ़ लेगी।
// इसलिए: पहले सारे candidate splice+clone हों, रीनेम सबसे आख़िर में एक साथ।
कार्य गअ_स्थल_बदलो(शब्दकोश फलन, शब्दकोश खंड, शब्दकोश बुलाओ_नि, सूची स्नैपशॉट) {
    सूची निस = खंड["निर्देश"];
    संख्या स्थिति = ० - १;
    संख्या इ = ०;
    यावत् (इ < लंबाई(निस) && स्थिति < ०) {
        यदि (निस[इ]["आईडी"] == बुलाओ_नि["आईडी"]) { स्थिति = इ; }
        इ = इ + १;
    }
    यदि (स्थिति < ०) { परत् शून्यम्; }

    सूची पहले = [];
    सूची बाद = [];
    इ = ०;
    यावत् (इ < स्थिति) { पहले = जोड़ें(पहले, निस[इ]); इ = इ + १; }
    इ = स्थिति + १;
    यावत् (इ < लंबाई(निस)) { बाद = जोड़ें(बाद, निस[इ]); इ = इ + १; }

    शब्दकोश जारी = मध्यम_नव_खंड(फलन, "गहन_जारी");
    जारी["निर्देश"] = बाद;
    जारी["अंत"] = खंड["अंत"];
    जारी["फाई"] = [];

    शब्दकोश क्लोन_जानकारी = गअ_बहु_खंड_क्लोन(फलन, स्नैपशॉट, बुलाओ_नि, जारी);

    // अब जाके असली खंड को mutate करो — क्लोनिंग स्नैपशॉट से पूरी हो चुकी
    खंड["निर्देश"] = पहले;
    मध्यम_जाओ(खंड, क्लोन_जानकारी["प्रवेश_लेबल"]);

    सूची वापस_स्रोत = क्लोन_जानकारी["वापस_स्रोत"];
    यदि (लंबाई(वापस_स्रोत) > ०) {
        संख्या फाई_आईडी = मध्यम_ताजा_आईडी(फलन);
        शब्दकोश अंश = {};
        अंश["स्रोत"] = वापस_स्रोत;
        शब्दकोश जारी_फाई_नि = मध्यम_निर्देश_बनाओ("फाई", फाई_आईडी, "मान", [], अंश);
        जारी["फाई"] = जोड़ें(जारी["फाई"], जारी_फाई_नि);
        यदि (बुलाओ_नि["आईडी"] >= १) {
            परत् [बुलाओ_नि["आईडी"], फाई_आईडी];
        }
    }
    परत् शून्यम्;
}

कार्य गहन_अंतर्वेशन_फलन(शब्दकोश फलन) {
    सूची मूल_खंड_सूची = फलन["खंड_सूची"];

    यदि (न गअ_टर्मिनेटर_सुरक्षित(मूल_खंड_सूची)) { परत् असत्य; }

    संख्या कुल_आकार = ०;
    संख्या ख = ०;
    यावत् (ख < लंबाई(मूल_खंड_सूची)) {
        कुल_आकार = कुल_आकार + लंबाई(मूल_खंड_सूची[ख]["निर्देश"]);
        ख = ख + १;
    }
    यदि (कुल_आकार > गअ_सीमा()) { परत् असत्य; }

    सूची उम्मीदवार = [];
    ख = ०;
    यावत् (ख < लंबाई(मूल_खंड_सूची)) {
        सूची निस = मूल_खंड_सूची[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["कोड"] == "बुलाओ" && निस[नि]["अंश"]["लक्ष्य"] == फलन["नाम"]) {
                उम्मीदवार = जोड़ें(उम्मीदवार, [मूल_खंड_सूची[ख], निस[नि]]);
            }
            नि = नि + १;
        }
        ख = ख + १;
    }

    यदि (लंबाई(उम्मीदवार) == ० || लंबाई(उम्मीदवार) > २) { परत् असत्य; }

    // असली, स्वतंत्र स्नैपशॉट — हर मूल ब्लॉक के लेबल/फाई/निर्देश/अंत की अभी
    // की स्थिति को अलग रिकॉर्ड में कैप्चर करो। ज़रूरी क्योंकि गअ_स्थल_बदलो
    // असली ब्लॉक-object को जगह पर mutate करता है (split करके), और वही
    // block-object एक से अधिक candidate में साझा हो सकता है (जैसे फिब —
    // दोनों self-कॉल एक ही ब्लॉक में) — बिना इस स्नैपशॉट के, पहले वाले
    // candidate का mutation दूसरे candidate की क्लोनिंग को बिगाड़ देता।
    सूची स्नैपशॉट = [];
    ख = ०;
    यावत् (ख < लंबाई(मूल_खंड_सूची)) {
        शब्दकोश म = मूल_खंड_सूची[ख];
        शब्दकोश प्र = {};
        प्र["लेबल"] = म["लेबल"];
        प्र["फाई"] = म["फाई"];
        प्र["निर्देश"] = म["निर्देश"];
        प्र["अंत"] = म["अंत"];
        स्नैपशॉट = जोड़ें(स्नैपशॉट, प्र);
        ख = ख + १;
    }

    // पीछे से आगे — ताकि एक स्थल का splice पहले वाले स्थलों के
    // ब्लॉक-संदर्भ (अभी तक अछूते) न बिगाड़े। रीनेम अभी नहीं — इकट्ठा करो,
    // सारे splice/clone पूरे होने के बाद एक साथ लागू करो (ऊपर गअ_स्थल_बदलो
    // की टिप्पणी देखें — वजह)।
    सूची लंबित_नामकरण = [];
    संख्या उइ = लंबाई(उम्मीदवार) - १;
    यावत् (उइ >= ०) {
        मान जोड़ी = गअ_स्थल_बदलो(फलन, उम्मीदवार[उइ][०], उम्मीदवार[उइ][१], स्नैपशॉट);
        यदि (जोड़ी != शून्यम्) { लंबित_नामकरण = जोड़ें(लंबित_नामकरण, जोड़ी); }
        उइ = उइ - १;
    }
    संख्या नि2 = ०;
    यावत् (नि2 < लंबाई(लंबित_नामकरण)) {
        सूची जोड़ी = लंबित_नामकरण[नि2];
        अनु_हर_उपयोग_बदलो(फलन, जोड़ी[०], जोड़ी[१]);
        नि2 = नि2 + १;
    }
    परत् सत्य;
}

कार्य गहन_अंतर्वेशन_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कस)) {
        शब्दकोश फलन = कस[इ];
        यदि (गहन_अंतर्वेशन_फलन(फलन)) {
            अनुकूलक_कार्य(फलन);
        }
        इ = इ + १;
    }
    परत् एकक;
}
