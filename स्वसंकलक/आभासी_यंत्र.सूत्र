// आभासी_यंत्र.सूत्र — सूत्र आभासी यंत्र (Sutra Virtual Machine - SVM)
// ============================================================
// अष्टक-संकेत (Bytecode) को निष्पादित करने वाला कल्पित यंत्र।
// द्वि-अंक (०/१) आधारित स्थिति, धारक (Registers), एवं आह्वान-स्तूप।
// ============================================================

आयात "अष्टक_संकेत.सूत्र";

// ------------------------------------------------------------
// आभासी यंत्र अवस्था निर्माता (SVM State Builder)
// ------------------------------------------------------------
कार्य आभासी_यंत्र_नव(शब्दकोश प्रोग्राम) {
    शब्दकोश यंत्र = {};
    यंत्र["प्रोग्राम"] = प्रोग्राम;
    यंत्र["फलन_मानचित्र"] = प्रोग्राम["फलन_मानचित्र"];
    यंत्र["वैश्विक"] = {};
    यदि (प्रोग्राम["वैश्विक"] != शून्यम्) {
        यंत्र["वैश्विक"] = प्रोग्राम["वैश्विक"];
    }
    पाठ प्रारंभ_फलन = "मुख्य";
    यदि (प्रोग्राम["प्रारंभ_फलन"] != शून्यम्) {
        प्रारंभ_फलन = प्रोग्राम["प्रारंभ_फलन"];
    } अन्यथा यदि (प्रोग्राम["फलन_मानचित्र"]["__शीर्ष"] != शून्यम्) {
        प्रारंभ_फलन = "__शीर्ष";
    }
    यंत्र["वर्तमान_फलन"] = प्रारंभ_फलन;
    यदि (प्रोग्राम["फलन_मानचित्र"][प्रारंभ_फलन] != शून्यम्) {
        यंत्र["आज्ञा_सूची"] = प्रोग्राम["फलन_मानचित्र"][प्रारंभ_फलन]["आज्ञा_सूची"];
    } अन्यथा {
        यंत्र["आज्ञा_सूची"] = [];
    }
    यंत्र["निर्देश_सूचक"] = ०;
    यंत्र["आह्वान_स्तूप"] = [];
    
    // धारक सरणी (Registers: क० से क६३)
    सूची धारक_सूची = [];
    संख्या इ = ०;
    यावत् (इ < ६४) {
        धारक_सूची = जोड़ें(धारक_सूची, शून्यम्);
        इ = इ + १;
    }
    यंत्र["धारक"] = धारक_सूची;
    यंत्र["अंतिम_परिणाम"] = शून्यम्;
    यंत्र["चल_रहा_है"] = सत्य;
    परत् यंत्र;
}

// ------------------------------------------------------------
// धारक मान आवंटन (Register Set Helper)
// ------------------------------------------------------------
कार्य आभासी_धारक_लिख(शब्दकोश यंत्र, संख्या अनुक्रमांक, मान मूल्य) {
    सूची ध = यंत्र["धारक"];
    यावत् (लंबाई(ध) <= अनुक्रमांक) {
        ध = जोड़ें(ध, शून्यम्);
    }
    ध[अनुक्रमांक] = मूल्य;
    यंत्र["धारक"] = ध;
}

// ------------------------------------------------------------
// धारक मान पठन (Register Get Helper)
// ------------------------------------------------------------
कार्य आभासी_धारक_पढ़(शब्दकोश यंत्र, संख्या अनुक्रमांक) {
    सूची ध = यंत्र["धारक"];
    यदि (अनुक्रमांक < ० || अनुक्रमांक >= लंबाई(ध)) {
        परत् शून्यम्;
    }
    परत् ध[अनुक्रमांक];
}

// ------------------------------------------------------------
// आभासी यंत्र निष्पादन चक्र (SVM Execution Loop)
// ------------------------------------------------------------
कार्य आभासी_यंत्र_चलाओ(शब्दकोश यंत्र) {
    यावत् (यंत्र["चल_रहा_है"]) {
        सूची आज्ञा_सूची = यंत्र["आज्ञा_सूची"];
        संख्या सूचक = यंत्र["निर्देश_सूचक"];
        
        यदि (सूचक >= लंबाई(आज्ञा_सूची)) {
            // यदि वर्तमान फलन समाप्त हो गया
            सूची स्तूप = यंत्र["आह्वान_स्तूप"];
            यदि (लंबाई(स्तूप) > ०) {
                // पिछले आह्वान पर वापस लौटें
                शब्दकोश पूर्व = स्तूप[लंबाई(स्तूप) - १];
                // pop स्तूप
                सूची नवीन_स्तूप = [];
                संख्या स्तूप_इ = ०;
                यावत् (स्तूप_इ < लंबाई(स्तूप) - १) {
                    नवीन_स्तूप = जोड़ें(नवीन_स्तूप, स्तूप[स्तूप_इ]);
                    स्तूप_इ = स्तूप_इ + १;
                }
                यंत्र["आह्वान_स्तूप"] = नवीन_स्तूप;
                यंत्र["वर्तमान_फलन"] = पूर्व["फलन_नाम"];
                यंत्र["आज्ञा_सूची"] = पूर्व["आज्ञा_सूची"];
                यंत्र["निर्देश_सूचक"] = पूर्व["निर्देश_सूचक"];
                यंत्र["धारक"] = पूर्व["धारक"];
                जारीरह;
            } अन्यथा {
                यंत्र["चल_रहा_है"] = असत्य;
                विरामः;
            }
        }
        
        शब्दकोश आज्ञा = आज्ञा_सूची[सूचक];
        संख्या कूट = आज्ञा["कूट"];
        संख्या लक्ष्य = आज्ञा["लक्ष्य"];
        संख्या प्र१ = आज्ञा["प्र१"];
        संख्या प्र२ = आज्ञा["प्र२"];
        
        // 1. विराम (Halt)
        यदि (कूट == आज्ञा_विराम) {
            यंत्र["चल_रहा_है"] = असत्य;
            विरामः;
        }
        
        // 2. स्थिर (Load Constant)
        अन्यथा यदि (कूट == आज्ञा_स्थिर) {
            आभासी_धारक_लिख(यंत्र, लक्ष्य, आज्ञा["स्थिरांक"]);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 3. चाल (Move)
        अन्यथा यदि (कूट == आज्ञा_चाल) {
            मान मूल्य = आभासी_धारक_पढ़(यंत्र, प्र१);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, मूल्य);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 4. योग (+)
        अन्यथा यदि (कूट == आज्ञा_योग) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, मान१ + मान२);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 5. अंतर (-)
        अन्यथा यदि (कूट == आज्ञा_अंतर) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, मान१ - मान२);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 6. गुणा (*)
        अन्यथा यदि (कूट == आज्ञा_गुणा) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, मान१ * मान२);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 7. भाग (/)
        अन्यथा यदि (कूट == आज्ञा_भाग) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, मान१ / मान२);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 8. शेष (%)
        अन्यथा यदि (कूट == आज्ञा_शेष) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, मान१ % मान२);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 9. सम (==)
        अन्यथा यदि (कूट == आज्ञा_सम) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            यदि (मान१ == मान२) {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, १);
            } अन्यथा {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, ०);
            }
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 10. असम (!=)
        अन्यथा यदि (कूट == आज्ञा_असम) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            यदि (मान१ != मान२) {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, १);
            } अन्यथा {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, ०);
            }
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 11. लघु (<)
        अन्यथा यदि (कूट == आज्ञा_लघु) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            यदि (मान१ < मान२) {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, १);
            } अन्यथा {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, ०);
            }
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 12. गुरु (>)
        अन्यथा यदि (कूट == आज्ञा_गुरु) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            यदि (मान१ > मान२) {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, १);
            } अन्यथा {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, ०);
            }
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 13. लघुसम (<=)
        अन्यथा यदि (कूट == आज्ञा_लघुसम) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            यदि (मान१ <= मान२) {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, १);
            } अन्यथा {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, ०);
            }
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 14. गुरुसम (>=)
        अन्यथा यदि (कूट == आज्ञा_गुरुसम) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            यदि (मान१ >= मान२) {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, १);
            } अन्यथा {
                आभासी_धारक_लिख(यंत्र, लक्ष्य, ०);
            }
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 15. और (&)
        अन्यथा यदि (कूट == आज्ञा_और) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, बिट_और(मान१, मान२));
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 16. या (|)
        अन्यथा यदि (कूट == आज्ञा_या) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान मान२ = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, बिट_या(मान१, मान२));
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 17. जाओ (Unconditional Jump)
        अन्यथा यदि (कूट == आज्ञा_जाओ) {
            यंत्र["निर्देश_सूचक"] = प्र१;
        }
        
        // 18. यदि_जाओ (Jump if True / १)
        अन्यथा यदि (कूट == आज्ञा_यदि_जाओ) {
            मान शर्त = आभासी_धारक_पढ़(यंत्र, प्र१);
            यदि (शर्त == १ || शर्त == सत्य) {
                यंत्र["निर्देश_सूचक"] = प्र२;
            } अन्यथा {
                यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
            }
        }
        
        // 19. यदि_न_जाओ (Jump if False / ०)
        अन्यथा यदि (कूट == आज्ञा_यदि_न_जाओ) {
            मान शर्त = आभासी_धारक_पढ़(यंत्र, प्र१);
            यदि (शर्त == ० || शर्त == असत्य || शर्त == शून्यम्) {
                यंत्र["निर्देश_सूचक"] = प्र२;
            } अन्यथा {
                यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
            }
        }
        
        // २०. छापो (Print / लिखतु)
        अन्यथा यदि (कूट == आज्ञा_छापो) {
            मान मूल्य = आभासी_धारक_पढ़(यंत्र, प्र१);
            लिखतु(अष्टक_मान_देवनागरी(मूल्य));
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 21. नव_सूची
        अन्यथा यदि (कूट == आज्ञा_नव_सूची) {
            आभासी_धारक_लिख(यंत्र, लक्ष्य, []);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 22. नव_शब्दकोश
        अन्यथा यदि (कूट == आज्ञा_नव_शब्दकोश) {
            आभासी_धारक_लिख(यंत्र, लक्ष्य, {});
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 23. पढ़_अनुक्रम (arr[i] / dict[k])
        अन्यथा यदि (कूट == आज्ञा_पढ़_अनुक्रम) {
            मान आधार = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान सूचक_मान = आभासी_धारक_पढ़(यंत्र, प्र२);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, आधार[सूचक_मान]);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 24. लिख_अनुक्रम (arr[i] = val)
        अन्यथा यदि (कूट == आज्ञा_लिख_अनुक्रम) {
            मान आधार = आभासी_धारक_पढ़(यंत्र, प्र१);
            मान सूचक_मान = आभासी_धारक_पढ़(यंत्र, प्र२);
            मान नया_मान = आभासी_धारक_पढ़(यंत्र, लक्ष्य);
            आधार[सूचक_मान] = नया_मान;
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 25. लंबाई
        अन्यथा यदि (कूट == आज्ञा_लंबाई) {
            मान आधार = आभासी_धारक_पढ़(यंत्र, प्र१);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, लंबाई(आधार));
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 26. बुलाओ (Call Function)
        अन्यथा यदि (कूट == आज्ञा_बुलाओ) {
            पाठ लक्ष्य_फलन = आज्ञा["स्थिरांक"];
            शब्दकोश फलन_नक्शा = यंत्र["फलन_मानचित्र"];
            
            यदि (फलन_नक्शा[लक्ष्य_फलन] == शून्यम्) {
                लिखतु("त्रुटिः अज्ञात फलन: " + लक्ष्य_फलन);
                यंत्र["चल_रहा_है"] = असत्य;
                विरामः;
            }
            
            // स्तूप पर वर्तमान फ्रेम सुरक्षित करो
            शब्दकोश फ्रेम = {};
            फ्रेम["फलन_नाम"] = यंत्र["वर्तमान_फलन"];
            फ्रेम["आज्ञा_सूची"] = यंत्र["आज्ञा_सूची"];
            फ्रेम["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
            फ्रेम["धारक"] = यंत्र["धारक"];
            फ्रेम["परिणाम_लक्ष्य"] = लक्ष्य;
            यंत्र["आह्वान_स्तूप"] = जोड़ें(यंत्र["आह्वान_स्तूप"], फ्रेम);
            
            // नए फलन के लिए नया धारक सरणी (पर्याप्त आकार)
            सूची नया_धारक = [];
            संख्या धारक_इ = ०;
            यावत् (धारक_इ < १२८) {
                नया_धारक = जोड़ें(नया_धारक, शून्यम्);
                धारक_इ = धारक_इ + १;
            }
            
            // तर्क पास करें (धारक [१००..१००+N-१] में, बिना किसी टकराव के)
            संख्या तर्क_संख्या = प्र१;
            संख्या तर्क_स्रोत = प्र२;
            संख्या त = ०;
            यावत् (त < तर्क_संख्या) {
                मान तर्क_मान = आभासी_धारक_पढ़(यंत्र, तर्क_स्रोत + त);
                नया_धारक[१०० + त] = तर्क_मान;
                त = त + १;
            }
            
            यंत्र["धारक"] = नया_धारक;
            यंत्र["वर्तमान_फलन"] = लक्ष्य_फलन;
            यंत्र["आज्ञा_सूची"] = फलन_नक्शा[लक्ष्य_फलन]["आज्ञा_सूची"];
            यंत्र["निर्देश_सूचक"] = ०;
        }
        
        // 27. वापस (Return)
        अन्यथा यदि (कूट == आज्ञा_वापस) {
            मान परत्_मान = शून्यम्;
            यदि (प्र१ >= ०) {
                परत्_मान = आभासी_धारक_पढ़(यंत्र, प्र१);
            }
            
            यंत्र["अंतिम_परिणाम"] = परत्_मान;
            
            सूची स्तूप = यंत्र["आह्वान_स्तूप"];
            यदि (लंबाई(स्तूप) > ०) {
                शब्दकोश पूर्व = स्तूप[लंबाई(स्तूप) - १];
                
                // pop स्तूप
                सूची नवीन_स्तूप = [];
                संख्या स्तूप_इ = ०;
                यावत् (स्तूप_इ < लंबाई(स्तूप) - १) {
                    नवीन_स्तूप = जोड़ें(नवीन_स्तूप, स्तूप[स्तूप_इ]);
                    स्तूप_इ = स्तूप_इ + १;
                }
                यंत्र["आह्वान_स्तूप"] = नवीन_स्तूप;
                यंत्र["वर्तमान_फलन"] = पूर्व["फलन_नाम"];
                यंत्र["आज्ञा_सूची"] = पूर्व["आज्ञा_सूची"];
                यंत्र["निर्देश_सूचक"] = पूर्व["निर्देश_सूचक"];
                यंत्र["धारक"] = पूर्व["धारक"];
                
                // कॉलर के लक्ष्य धारक में मान लिखो
                यदि (पूर्व["परिणाम_लक्ष्य"] >= ०) {
                    आभासी_धारक_लिख(यंत्र, पूर्व["परिणाम_लक्ष्य"], परत्_मान);
                }
            } अन्यथा {
                यंत्र["चल_रहा_है"] = असत्य;
                विरामः;
            }
        }
        
        // 28. ऋणात्मक (Unary Minus)
        अन्यथा यदि (कूट == आज्ञा_ऋणात्मक) {
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            आभासी_धारक_लिख(यंत्र, लक्ष्य, ० - मान१);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 29. पढ़_वैश्विक
        अन्यथा यदि (कूट == आज्ञा_पढ़_वैश्विक) {
            पाठ चर_नाम = आज्ञा["स्थिरांक"];
            आभासी_धारक_लिख(यंत्र, लक्ष्य, यंत्र["वैश्विक"][चर_नाम]);
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        
        // 30. लिख_वैश्विक
        अन्यथा यदि (कूट == आज्ञा_लिख_वैश्विक) {
            पाठ चर_नाम = आज्ञा["स्थिरांक"];
            मान मान१ = आभासी_धारक_पढ़(यंत्र, प्र१);
            यंत्र["वैश्विक"][चर_नाम] = मान१;
            यंत्र["निर्देश_सूचक"] = यंत्र["निर्देश_सूचक"] + १;
        }
        अन्यथा {
            लिखतु("त्रुटिः अज्ञात आज्ञा कूट: " + कूट);
            यंत्र["चल_रहा_है"] = असत्य;
            विरामः;
        }
    }
    
    परत् यंत्र["अंतिम_परिणाम"];
}
