                मान अगला = अक्षर_मान(अवस्था["स्रोत"][सहायक_अनुक्रमणिका + 1]);
                यदि (अङ्क_है(अगला)) {
                    दशमलव_है = सत्य;
                    पद_पाठ = पद_पाठ + ".";
                    अक्षरम्_अग्रिमम्(अवस्था);
                } अन्यथा {
