// ============================================================

कार्य देवनागरी_वर्ण_है(क) {
    परत् (क >= २३०८ && क <= २३६१) ||
         (क >= २३९२ && क <= २४०१) ||
         (क >= २४१८ && क <= २४३१);
}

कार्य देवनागरी_संयोग_है(क) {
    परत् (क >= २३०४ && क <= २३०७) ||
         (क == २३६४) ||
         (क >= २३६६ && क <= २३८३) ||
         (क >= २३८५ && क <= २३९१) ||
         (क >= २४०२ && क <= २४०३);
}

कार्य देवनागरी_अङ्क_है(क) {
    परत् (क >= २४०६ && क <= २४१५);
}

कार्य अङ्क_है(क) {
    परत् (क >= ४८ && क <= ५७) || देवनागरी_अङ्क_है(क);
}

कार्य रिक्त_है(क) {
    परत् (क == ३२) || (क == ९) || (क == १३) || (क == १०) || (क == ६५२७९);
}

कार्य नाम_आरम्भ_है(क) {
    परत् देवनागरी_वर्ण_है(क);
}

कार्य नाम_अनुवृत्ति_है(क) {
    परत् देवनागरी_वर्ण_है(क) || देवनागरी_संयोग_है(क) ||
         देवनागरी_अङ्क_सहायक(क) || (क >= ४८ && क <= ५७) || (क == ९५);
}

कार्य देवनागरी_अङ्क_सहायक(क) {
    परत् देवनागरी_अङ्क_है(क);
}

कार्य अङ्क_सामान्यीकरण(क) {
    यदि (क >= २४०६ && क <= २४१५) {
        मान मानः = क - २४०६;
        परत् अक्षर_निर्माण(४८ + मानः);
    }
    परत् अक्षर_निर्माण(क);
}

// लीड-बाइट से UTF-8 अक्षर की बाइट-चौड़ाई — रनटाइम के अक्षर_बाइट_चौड़ाई की प्रतिलिपि,
// किन्तु पाठ + बाइट-ऑफसेट लेकर (लेक्सर बाइट-कर्सर के साथ लॉकस्टेप में रहे)।
कार्य लेखक_चौड़ाई(पाठ स्रोत, संख्या ब) {
    मान लीड = अंतर्_पढ़1(स्रोत, १६ + ब);
    यदि (लीड < १२८) { परत् १; }
    यदि (लीड >= १९२ && लीड < २२४) { परत् २; }
    यदि (लीड >= २२४ && लीड < २४०) { परत् ३; }
    यदि (लीड >= २४० && लीड < २४८) { परत् ४; }
    परत् १;
}

// स्रोत के बाइट-ऑफसेट ब पर UTF-8 कोडबिंदु — रनटाइम के अक्षर_कोडबिंदु/कोडबिंदु_मान
// की प्रतिलिपि। well-formed UTF-8 पर अक्षर_मान(स्रोत[i]) के समान मान लौटाता।
// अशुद्ध लीड (सतत-बाइट 128-191, या 248+) → 65533 (प्रतिस्थापन अक्षर)।
कार्य लेखक_कोडबिंदु(पाठ स्रोत, संख्या ब) {
    मान क1 = अंतर्_पढ़1(स्रोत, १६ + ब);
    यदि (क1 < १२८) { परत् क1; }
    यदि (क1 >= २४० && क1 < २४८) {
        परत् ((क1 - २४०) * २६२१४४) + ((अंतर्_पढ़1(स्रोत, १७ + ब) % ६४) * ४०९६) + ((अंतर्_पढ़1(स्रोत, १८ + ब) % ६४) * ६४) + (अंतर्_पढ़1(स्रोत, १९ + ब) % ६४);
    }
    यदि (क1 >= २२४ && क1 < २४०) {
        परत् ((क1 - २२४) * ४०९६) + ((अंतर्_पढ़1(स्रोत, १७ + ब) % ६४) * ६४) + (अंतर्_पढ़1(स्रोत, १८ + ब) % ६४);
    }
    यदि (क1 >= १९२ && क1 < २२४) {
        परत् ((क1 - १९२) * ६४) + (अंतर्_पढ़1(स्रोत, १७ + ब) % ६४);
    }
    परत् ६५५३३;
}

// देवनागरी अंक-सामान्यीकरण केवल तभी जब बाइट-खंड में कोई गैर-ASCII बाइट हो।
// सामान्य ASCII संख्या-अक्षर → खंड अपरिवर्तित लौटता (शून्य पुनरावंटन)।
कार्य अंक_सामान्य(पाठ कच्चा) {
    मान बल = अंतर्_पढ़8(कच्चा, ८);
    मान इ = ०;
    मान देव_मिला = असत्य;
    यावत् (इ < बल) {
        यदि (अंतर्_पढ़1(कच्चा, १६ + इ) >= १२८) {
            देव_मिला = सत्य;
            विरामः;
        }
        इ = इ + १;
    }
    यदि (न देव_मिला) {
        परत् कच्चा;
    }
    मान टुकड़े = [];
    मान ज = ०;
    यावत् (ज < लंबाई(कच्चा)) {
        मान सीपी = अक्षर_मान(कच्चा[ज]);
        यदि (सीपी >= २४०६ && सीपी <= २४१५) {
            टुकड़े = जोड़ें(टुकड़े, अक्षर_निर्माण(४८ + (सीपी - २४०६)));
        } अन्यथा {
            टुकड़े = जोड़ें(टुकड़े, अक्षर_निर्माण(सीपी));
        }
        ज = ज + १;
    }
    परत् संयोजित(टुकड़े, "");
}

