कार्य रिक्त_टिप्पणी_छोड़ो(शब्दकोश अवस्था) {
    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"]) {
        मान क = अक्षरम्_दृश्यताम्(अवस्था);
        यदि ( रिक्त_है(क) ) {
            अक्षरम्_अग्रिमम्(अवस्था);
            जारीरह;
        }
        
        यदि (क == 47) {
            मान सहायक_अनुक्रमणिका = अवस्था["अनुक्रमणिका"];
            मान स्रो_लंबाई = अवस्था["स्रोत_लंबाई"];
            पाठ स्रो = अवस्था["स्रोत"];
            यदि (सहायक_अनुक्रमणिका + 1 < स्रो_लंबाई) {
                मान अगला = अक्षर_मान(स्रो[सहायक_अनुक्रमणिका + 1]);
                यदि (अगला == 47) {
                    अक्षरम्_अग्रिमम्(अवस्था);
                    अक्षरम्_अग्रिमम्(अवस्था);
                    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"] && अक्षरम्_दृश्यताम्(अवस्था) != 10) {
                        अक्षरम्_अग्रिमम्(अवस्था);
                    }
                    जारीरह;
                } अन्यथा यदि (अगला == 42) {
                    अक्षरम्_अग्रिमम्(अवस्था);
                    अक्षरम्_अग्रिमम्(अवस्था);
                    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"]) {
                        मान च = अक्षरम्_अग्रिमम्(अवस्था);
                        यदि (च == 42 && अक्षरम्_दृश्यताम्(अवस्था) == 47) {
                            अक्षरम्_अग्रिमम्(अवस्था);
                            विरामः;
                        }
                    }
                    जारीरह;
                }
            }
        }
        विरामः;
    }
}

कार्य पहचान_लिखो(शब्दकोश अवस्था) {
    मान आरम्भ_पङ्क्ति = अवस्था["पङ्क्ति"];
    मान आरम्भ_स्तम्भ = अवस्था["स्तम्भ"];
    पाठ स्रोत = अवस्था["स्रोत"];
    
    मान पद_पाठ = "";
    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"]) {
        मान क = अक्षरम्_दृश्यताम्(अवस्था);
        यदि (नाम_अनुवृत्ति_है(क)) {
             पद_पाठ = पद_पाठ + स्रोत[अवस्था["अनुक्रमणिका"]];
            अक्षरम्_अग्रिमम्(अवस्था);
        } अन्यथा {
            विरामः;
        }
    }
    
    मान प्रकारः = "संकेतनाम";
    शब्दकोश आरक्षित = अवस्था["आरक्षित_शब्द"];
    यदि (कुंजी_है(आरक्षित, पद_पाठ)) {
        प्रकारः = आरक्षित[पद_पाठ];
    }
    परत् पद_रचना(प्रकारः, पद_पाठ, आरम्भ_पङ्क्ति, आरम्भ_स्तम्भ);
}

