कार्य देवनागरी_वर्ण_है(क) {
    परत् (क >= 2308 && क <= 2361) ||
         (क >= 2392 && क <= 2401) ||
         (क >= 2418 && क <= 2431);
}

कार्य देवनागरी_संयोग_है(क) {
    परत् (क >= 2304 && क <= 2307) ||
         (क == 2364) ||
         (क >= 2366 && क <= 2383) ||
         (क >= 2385 && क <= 2391) ||
         (क >= 2402 && क <= 2403);
}

कार्य देवनागरी_अङ्क_है(क) {
    परत् (क >= 2406 && क <= 2415);
}

कार्य अङ्क_है(क) {
    परत् (क >= 48 && क <= 57) || देवनागरी_अङ्क_है(क);
}

कार्य रिक्त_है(क) {
    परत् (क == 32) || (क == 9) || (क == 13) || (क == 10) || (क == 65279);
}

कार्य नाम_आरम्भ_है(क) {
    परत् देवनागरी_वर्ण_है(क);
}

कार्य नाम_अनुवृत्ति_है(क) {
    परत् देवनागरी_वर्ण_है(क) || देवनागरी_संयोग_है(क) ||
         देवनागरी_अङ्क_सहायक(क) || (क >= 48 && क <= 57) || (क == 95);
}

कार्य देवनागरी_अङ्क_सहायक(क) {
    परत् देवनागरी_अङ्क_है(क);
}

कार्य अङ्क_सामान्यीकरण(क) {
    यदि (क >= 2406 && क <= 2415) {
        मान मानः = क - 2406;
        परत् अक्षर_निर्माण(48 + मानः);
    }
    परत् अक्षर_निर्माण(क);
}

// लीड-बाइट से UTF-8 अक्षर की बाइट-चौड़ाई — रनटाइम के अक्षर_बाइट_चौड़ाई की प्रतिलिपि,
// किन्तु पाठ + बाइट-ऑफसेट लेकर (लेक्सर बाइट-कर्सर के साथ लॉकस्टेप में रहे)।
कार्य लेखक_चौड़ाई(पाठ स्रोत, संख्या ब) {
    मान लीड = अंतर्_पढ़1(स्रोत, 16 + ब);
    यदि (लीड < 128) { परत् 1; }
    यदि (लीड >= 192 && लीड < 224) { परत् 2; }
    यदि (लीड >= 224 && लीड < 240) { परत् 3; }
    यदि (लीड >= 240 && लीड < 248) { परत् 4; }
    परत् 1;
}

// स्रोत के बाइट-ऑफसेट ब पर UTF-8 कोडबिंदु — रनटाइम के अक्षर_कोडबिंदु/कोडबिंदु_मान
// की प्रतिलिपि। well-formed UTF-8 पर अक्षर_मान(स्रोत[i]) के समान मान लौटाता।
// अशुद्ध लीड (सतत-बाइट 128-191, या 248+) → 65533 (प्रतिस्थापन अक्षर)।
कार्य लेखक_कोडबिंदु(पाठ स्रोत, संख्या ब) {
    मान क1 = अंतर्_पढ़1(स्रोत, 16 + ब);
    यदि (क1 < 128) { परत् क1; }
    यदि (क1 >= 240 && क1 < 248) {
        परत् ((क1 - 240) * 262144) + ((अंतर्_पढ़1(स्रोत, 17 + ब) % 64) * 4096) + ((अंतर्_पढ़1(स्रोत, 18 + ब) % 64) * 64) + (अंतर्_पढ़1(स्रोत, 19 + ब) % 64);
    }
    यदि (क1 >= 224 && क1 < 240) {
        परत् ((क1 - 224) * 4096) + ((अंतर्_पढ़1(स्रोत, 17 + ब) % 64) * 64) + (अंतर्_पढ़1(स्रोत, 18 + ब) % 64);
    }
    यदि (क1 >= 192 && क1 < 224) {
        परत् ((क1 - 192) * 64) + (अंतर्_पढ़1(स्रोत, 17 + ब) % 64);
    }
    परत् 65533;
}

// देवनागरी अंक-सामान्यीकरण केवल तभी जब बाइट-खंड में कोई गैर-ASCII बाइट हो।
// सामान्य ASCII संख्या-अक्षर → खंड अपरिवर्तित लौटता (शून्य पुनरावंटन)।
कार्य अंक_सामान्य(पाठ कच्चा) {
    मान बल = अंतर्_पढ़8(कच्चा, 8);
    मान इ = 0;
    मान देव_मिला = असत्य;
    यावत् (इ < बल) {
        यदि (अंतर्_पढ़1(कच्चा, 16 + इ) >= 128) {
            देव_मिला = सत्य;
            विरामः;
        }
        इ = इ + 1;
    }
    यदि (न देव_मिला) {
        परत् कच्चा;
    }
    मान टुकड़े = [];
    मान ज = 0;
    यावत् (ज < लंबाई(कच्चा)) {
        मान सीपी = अक्षर_मान(कच्चा[ज]);
        यदि (सीपी >= 2406 && सीपी <= 2415) {
            टुकड़े = जोड़ें(टुकड़े, अक्षर_निर्माण(48 + (सीपी - 2406)));
        } अन्यथा {
            टुकड़े = जोड़ें(टुकड़े, अक्षर_निर्माण(सीपी));
        }
        ज = ज + 1;
    }
    परत् संयोजित(टुकड़े, "");
}

