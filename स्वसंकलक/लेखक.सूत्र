कार्य देवनागरी_वर्ण_है(क) {
    परत् (क >= 2308 && क <= 2361) ||
         (क >= 2392 && क <= 2401) ||
         (क >= 2418 && क <= 2431);
}

कार्य देवनागरी_संयोग_है(क) {
    परत् (क >= 2304 && क <= 2307) ||
         (क == 2364) ||
         (क >= 2366 && क <= 2383) ||
         (क >= 2385 && क <= 2391) ||
         (क >= 2402 && क <= 2403);
}

कार्य देवनागरी_अङ्क_है(क) {
    परत् (क >= 2406 && क <= 2415);
}

कार्य अङ्क_है(क) {
    परत् (क >= 48 && क <= 57) || देवनागरी_अङ्क_है(क);
}

कार्य रिक्त_है(क) {
    परत् (क == 32) || (क == 9) || (क == 13) || (क == 10) || (क == 65279);
}

कार्य नाम_आरम्भ_है(क) {
    परत् देवनागरी_वर्ण_है(क);
}

कार्य नाम_अनुवृत्ति_है(क) {
    परत् देवनागरी_वर्ण_है(क) || देवनागरी_संयोग_है(क) ||
         देवनागरी_अङ्क_सहायक(क) || (क >= 48 && क <= 57) || (क == 95);
}

कार्य देवनागरी_अङ्क_सहायक(क) {
    परत् देवनागरी_अङ्क_है(क);
}

कार्य अङ्क_सामान्यीकरण(क) {
    यदि (क >= 2406 && क <= 2415) {
        मान मानः = क - 2406;
        परत् अक्षर_निर्माण(48 + मानः);
    }
    परत् अक्षर_निर्माण(क);
}

