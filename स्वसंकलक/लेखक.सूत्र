कार्य रिक्त_टिप्पणी_छोड़ो(शब्दकोश अवस्था) {
    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"]) {
        मान क = अक्षरम्_दृश्यताम्(अवस्था);
        यदि ( रिक्त_है(क) ) {
            अक्षरम्_अग्रिमम्(अवस्था);
            जारीरह;
        }
        
        यदि (क == ४७) {
            यदि (अवस्था["अनुक्रमणिका"] + १ < अवस्था["स्रोत_लंबाई"]) {
                मान अगला = अक्षरम्_दृश्यताम्_आगे(अवस्था);
                यदि (अगला == ४७) {
                    अक्षरम्_अग्रिमम्(अवस्था);
                    अक्षरम्_अग्रिमम्(अवस्था);
                    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"] && अक्षरम्_दृश्यताम्(अवस्था) != १०) {
                        अक्षरम्_अग्रिमम्(अवस्था);
                    }
                    जारीरह;
                } अन्यथा यदि (अगला == ४२) {
                    अक्षरम्_अग्रिमम्(अवस्था);
                    अक्षरम्_अग्रिमम्(अवस्था);
                    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"]) {
                        मान च = अक्षरम्_अग्रिमम्(अवस्था);
                        यदि (च == ४२ && अक्षरम्_दृश्यताम्(अवस्था) == ४७) {
                            अक्षरम्_अग्रिमम्(अवस्था);
                            विरामः;
                        }
                    }
                    जारीरह;
                }
            }
        }
        विरामः;
    }
}

कार्य पहचान_लिखो(शब्दकोश अवस्था) {
    मान आरम्भ_पङ्क्ति = अवस्था["पङ्क्ति"];
    मान आरम्भ_स्तम्भ = अवस्था["स्तम्भ"];
    पाठ स्रोत = अवस्था["स्रोत"];
    
    मान प्रारंभ_बाइट = अवस्था["बाइट_अनु"];
    यावत् (अवस्था["अनुक्रमणिका"] < अवस्था["स्रोत_लंबाई"]) {
        मान क = अक्षरम्_दृश्यताम्(अवस्था);
        यदि (नाम_अनुवृत्ति_है(क)) {
            अक्षरम्_अग्रिमम्(अवस्था);
        } अन्यथा {
            विरामः;
        }
    }

    मान पद_पाठ = पाठ_उपखंड_बाइट(स्रोत, प्रारंभ_बाइट, अवस्था["बाइट_अनु"] - प्रारंभ_बाइट);

    मान प्रकारः = "संकेतनाम";
    शब्दकोश आरक्षित = अवस्था["आरक्षित_शब्द"];
