कार्य अक्षरम्_दृश्यताम्(शब्दकोश अवस्था) {
    यदि (अवस्था["अनुक्रमणिका"] >= अवस्था["स्रोत_लंबाई"]) {
        परत् 0;
    }
    परत् लेखक_कोडबिंदु(अवस्था["स्रोत"], अवस्था["बाइट_अनु"]);
}

// वर्तमान अक्षर के अगले अक्षर की झलक (कर्सर अपरिवर्तित)।
// पूर्व के स्रोत[i+1] lookahead की जगह — कोई 1-अक्षर पाठ आवंटन नहीं।
कार्य अक्षरम्_दृश्यताम्_आगे(शब्दकोश अवस्था) {
    यदि (अवस्था["अनुक्रमणिका"] + 1 >= अवस्था["स्रोत_लंबाई"]) {
        परत् 0;
    }
    पाठ स्रोत = अवस्था["स्रोत"];
    मान ब2 = अवस्था["बाइट_अनु"] + लेखक_चौड़ाई(स्रोत, अवस्था["बाइट_अनु"]);
    परत् लेखक_कोडबिंदु(स्रोत, ब2);
}

कार्य अक्षरम्_अग्रिमम्(शब्दकोश अवस्था) {
    मान अनुक्रमणिका = अवस्था["अनुक्रमणिका"];
    यदि (अनुक्रमणिका >= अवस्था["स्रोत_लंबाई"]) {
        परत् 0;
    }
    पाठ स्रोत = अवस्था["स्रोत"];
    मान ब = अवस्था["बाइट_अनु"];
    मान क1 = अंतर्_पढ़1(स्रोत, 16 + ब);
    मान क = क1;
    मान चौ = 1;
    यदि (क1 >= 128) {
        यदि (क1 >= 240 && क1 < 248) {
            चौ = 4;
            क = ((क1 - 240) * 262144) + ((अंतर्_पढ़1(स्रोत, 17 + ब) % 64) * 4096) + ((अंतर्_पढ़1(स्रोत, 18 + ब) % 64) * 64) + (अंतर्_पढ़1(स्रोत, 19 + ब) % 64);
        } अन्यथा यदि (क1 >= 224 && क1 < 240) {
            चौ = 3;
            क = ((क1 - 224) * 4096) + ((अंतर्_पढ़1(स्रोत, 17 + ब) % 64) * 64) + (अंतर्_पढ़1(स्रोत, 18 + ब) % 64);
        } अन्यथा यदि (क1 >= 192 && क1 < 224) {
            चौ = 2;
            क = ((क1 - 192) * 64) + (अंतर्_पढ़1(स्रोत, 17 + ब) % 64);
        } अन्यथा {
            क = 65533;
        }
    }

    अवस्था["अनुक्रमणिका"] = अनुक्रमणिका + 1;
    अवस्था["बाइट_अनु"] = ब + चौ;
    यदि (क == 10) {
        अवस्था["पङ्क्ति"] = अवस्था["पङ्क्ति"] + 1;
        अवस्था["स्तम्भ"] = 1;
    } अन्यथा {
        अवस्था["स्तम्भ"] = अवस्था["स्तम्भ"] + 1;
    }

    परत् क;
}

