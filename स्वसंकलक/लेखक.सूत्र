            } अन्यथा यदि (क == १२४) {
                यदि (अक्षरम्_दृश्यताम्(अवस्था) == १२४) {
                    अक्षरम्_अग्रिमम्(अवस्था);
                    पद_सूची = जोड़ें(पद_सूची, पद_रचना("अथवा-संयोजक (||)", "||", आरम्भ_पङ्क्ति, आरम्भ_स्तम्भ));
                } अन्यथा {
                    त्रुटि_फेको("अमान्यः प्रतीकः '|'", आरम्भ_पङ्क्ति, आरम्भ_स्तम्भ);
                }
            } अन्यथा {
                त्रुटि_फेको("अघातः वर्णः '" + अक्षर_निर्माण(क) + "'", आरम्भ_पङ्क्ति, आरम्भ_स्तम्भ);
            }
        }
    }
    
    पद_सूची = जोड़ें(पद_सूची, पद_रचना("सञ्चिका-अन्त", "", अवस्था["पङ्क्ति"], अवस्था["स्तम्भ"]));
    
    परत् पद_सूची;
}
