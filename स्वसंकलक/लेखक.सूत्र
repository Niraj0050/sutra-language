// अवस्था संचालनम्
// ============================================================

कार्य अक्षरम्_दृश्यताम्(शब्दकोश अवस्था) {
    यदि (अवस्था["अनुक्रमणिका"] >= अवस्था["स्रोत_लंबाई"]) {
        परत् ०;
    }
    परत् लेखक_कोडबिंदु(अवस्था["स्रोत"], अवस्था["बाइट_अनु"]);
}

// वर्तमान अक्षर के अगले अक्षर की झलक (कर्सर अपरिवर्तित)।
// पूर्व के स्रोत[i+1] lookahead की जगह — कोई 1-अक्षर पाठ आवंटन नहीं।
कार्य अक्षरम्_दृश्यताम्_आगे(शब्दकोश अवस्था) {
    यदि (अवस्था["अनुक्रमणिका"] + १ >= अवस्था["स्रोत_लंबाई"]) {
        परत् ०;
    }
    पाठ स्रोत = अवस्था["स्रोत"];
    मान ब2 = अवस्था["बाइट_अनु"] + लेखक_चौड़ाई(स्रोत, अवस्था["बाइट_अनु"]);
    परत् लेखक_कोडबिंदु(स्रोत, ब2);
}

कार्य अक्षरम्_अग्रिमम्(शब्दकोश अवस्था) {
    मान अनुक्रमणिका = अवस्था["अनुक्रमणिका"];
    यदि (अनुक्रमणिका >= अवस्था["स्रोत_लंबाई"]) {
        परत् ०;
    }
    पाठ स्रोत = अवस्था["स्रोत"];
    मान ब = अवस्था["बाइट_अनु"];
    मान क1 = अंतर्_पढ़1(स्रोत, १६ + ब);
    मान क = क1;
    मान चौ = १;
    यदि (क1 >= १२८) {
        यदि (क1 >= २४० && क1 < २४८) {
            चौ = ४;
            क = ((क1 - २४०) * २६२१४४) + ((अंतर्_पढ़1(स्रोत, १७ + ब) % ६४) * ४०९६) + ((अंतर्_पढ़1(स्रोत, १८ + ब) % ६४) * ६४) + (अंतर्_पढ़1(स्रोत, १९ + ब) % ६४);
        } अन्यथा यदि (क1 >= २२४ && क1 < २४०) {
            चौ = ३;
            क = ((क1 - २२४) * ४०९६) + ((अंतर्_पढ़1(स्रोत, १७ + ब) % ६४) * ६४) + (अंतर्_पढ़1(स्रोत, १८ + ब) % ६४);
        } अन्यथा यदि (क1 >= १९२ && क1 < २२४) {
            चौ = २;
            क = ((क1 - १९२) * ६४) + (अंतर्_पढ़1(स्रोत, १७ + ब) % ६४);
        } अन्यथा {
            क = ६५५३३;
        }
    }

    अवस्था["अनुक्रमणिका"] = अनुक्रमणिका + १;
    अवस्था["बाइट_अनु"] = ब + चौ;
    यदि (क == १०) {
        अवस्था["पङ्क्ति"] = अवस्था["पङ्क्ति"] + १;
        अवस्था["स्तम्भ"] = १;
    } अन्यथा {
        अवस्था["स्तम्भ"] = अवस्था["स्तम्भ"] + १;
    }

    परत् क;
}

