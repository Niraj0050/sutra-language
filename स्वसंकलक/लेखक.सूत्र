    अक्षरम्_अग्रिमम्(अवस्था);
    
    मान पद_पाठ = "";
    मान बन्द_हुआ = असत्य;
    
    यावत् (अवस्था["अनुक्रमणिका"] < स्रोत_लंबाई) {
        मान क = अक्षरम्_अग्रिमम्(अवस्था);
        यदि (क == 34) {
            बन्द_हुआ = सत्य;
            विरामः;
        } अन्यथा यदि (क == 92) {
            यदि (अवस्था["अनुक्रमणिका"] >= स्रोत_लंबाई) {
                विरामः;
            }
            मान अगला = अक्षरम्_अग्रिमम्(अवस्था);
            यदि (अगला == 2344 || अगला == 110) {
                पद_पाठ = पद_पाठ + "\न";
            } अन्यथा यदि (अगला == 2352 || अगला == 114) {
                पद_पाठ = पद_पाठ + "\र";
