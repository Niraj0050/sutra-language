// अंतर्वेशन_परीक्षण.सूत्र — फलन-inlining (v1) का test
// असली parser → lower → अनुकूलक_एकक → अंतर्वेशन_एकक → IR डंप जाँचो
// (लूप_अनुकूलन_परीक्षण.सूत्र जैसा ही तरीका — hand-built IR नहीं)

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "अंतर्वेशन.सूत्र";

मान विफल = ०;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + १; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= ०; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}

// parse → lower → सामान्य अनुकूलक (mem2reg+const-fold+DCE) → अंतर्वेशन → छापो
कार्य पूर्ण_अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    अंतर्वेशन_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

// N बार "ब = ब + 1;" दोहराओ (oversized-callee test के लिए)
कार्य दोहराओ(पाठ खंड, संख्या गिनती) {
    पाठ स = "";
    संख्या इ = ०;
    यावत् (इ < गिनती) { स = स + खंड; इ = इ + १; }
    परत् स;
}

कार्य मुख्य() {
    // १. मूल — छोटा non-recursive helper, एक बार बुलाया → splice हो जाए
    पाठ द1 = पूर्ण_अनुकूलित(
        "कार्य वर्गफल(संख्या अ) { परत् अ * अ; } " +
        "कार्य मुख्य1() { संख्या ब = वर्गफल(5); परत् ब; }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 @वर्गफल कॉल गायब (inline हुआ)", न है(द1, "@वर्गफल"));
    जाँच("1 callee का गुणा आ गया", है(द1, "गुणा"));

    // २. दो अलग call-site — दोनों स्वतंत्र रूप से inline हों
    पाठ द2 = पूर्ण_अनुकूलित(
        "कार्य वर्गफल(संख्या अ) { परत् अ * अ; } " +
        "कार्य मुख्य2() { संख्या ब = वर्गफल(5); संख्या स = वर्गफल(7); परत् ब + स; }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 दोनों call-site पर @वर्गफल गायब", न है(द2, "@वर्गफल"));

    // ३. नकारात्मक — self-recursive callee कभी inline न हो
    पाठ द3 = पूर्ण_अनुकूलित(
        "कार्य क्रमगुणित(संख्या अ) { यदि (अ <= 1) { परत् 1; } परत् अ * क्रमगुणित(अ - 1); }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 self-recursive कॉल जस-का-तस रहा", है(द3, "@क्रमगुणित"));

    // ४. नकारात्मक — multi-block callee (अंदर यदि) v1-दायरे से बाहर
    पाठ द4 = पूर्ण_अनुकूलित(
        "कार्य मेरा_अधिकतम(संख्या अ, संख्या ब) { यदि (अ > ब) { परत् अ; } परत् ब; } " +
        "कार्य मुख्य4() { परत् मेरा_अधिकतम(3, 5); }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 multi-block callee inline नहीं हुआ", है(द4, "@मेरा_अधिकतम"));

    // ५. नकारात्मक — आकार-सीमा से बड़ा callee inline नहीं होना चाहिए
    पाठ बड़ा_देह = दोहराओ("ब = ब + 1; ", २५);
    पाठ द5 = पूर्ण_अनुकूलित(
        "कार्य बड़ा(संख्या अ) { संख्या ब = अ; " + बड़ा_देह + " परत् ब; } " +
        "कार्य मुख्य5() { परत् बड़ा(1); }");
    लिखतु("--- 5 ---"); लिखतु(द5);
    जाँच("5 oversized callee inline नहीं हुआ", है(द5, "@बड़ा"));

    // असली निष्पादन-सत्यापन यहाँ नहीं — जब यह pass अस्थायी रूप से
    // मूल_संकलन.सूत्र में wire होगा (measurement चरण), तब full_verify.sh
    // पूरी भाषा_परीक्षण/compiler + भाषा_परीक्षण/stdlib सुइट पर interp==native जाँच खुद
    // ही करेगी — यह किसी एक हाथ-लिखे टेस्ट से कहीं ज़्यादा मज़बूत सबूत है
    // (दर्जनों असली प्रोग्राम, कोई भी गलत rename वहीं पकड़ में आ जाएगा)।

    लिखतु("");
    यदि (विफल == ०) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
