// निदान_चालक.सूत्र — अग्र_चालक का चरण-दर-चरण timing diagnostic
// हर चरण के बाद marker छापता है (लिखतु flush करता है) — बाहर से timestamp लो।
आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) < 2) { लिखतु("# प्रयोग: निदान_चालक <file>"); परत्; }
    पाठ मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - 1];
    पाठ स्रोत = सञ्चिका_पठतु(मार्गः);
    लिखतु("MARK शुरू");

    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    लिखतु("MARK पद_विच्छेदन " + लंबाई(पद_सूची));

    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश प्रोग्राम = प्रोग्राम_पार्स(अवस्था, {}, मार्गः);
    लिखतु("MARK प्रोग्राम_पार्स");

    मूल_सार्थक_विश्लेषण(प्रोग्राम);
    लिखतु("MARK सार्थक_विश्लेषण");

    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम);
    लिखतु("MARK निम्नक_एकक कार्य=" + लंबाई(एकक["कार्य_सूची"]));

    अनुकूलक_एकक(एकक);
    लिखतु("MARK अनुकूलक_एकक");
}
