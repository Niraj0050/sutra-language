// परीक्षण_पार्स.सूत्र — parser + निम्नक (IR-compiled) — bug hunt
आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) < 2) { लिखतु("प्रयोग: परीक्षण_पार्स <file>"); परत्; }
    पाठ मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - 1];
    पाठ स्रोत = सञ्चिका_पठतु(मार्गः);
    लिखतु("पद_विच्छेदन...");
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    लिखतु("पद: " + लंबाई(पद_सूची));
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश प्रोग्राम = प्रोग्राम_पार्स(अवस्था, {}, मार्गः);
    लिखतु("पार्स सफल — कार्य: " + लंबाई(प्रोग्राम["कार्य_सूची"]) + " वर्ग: " + लंबाई(प्रोग्राम["वर्ग_सूची"]));
    मूल_सार्थक_विश्लेषण(प्रोग्राम);
    लिखतु("सार्थक सफल");
    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम);
    लिखतु("निम्नक सफल — IR कार्य: " + लंबाई(एकक["कार्य_सूची"]));
}
