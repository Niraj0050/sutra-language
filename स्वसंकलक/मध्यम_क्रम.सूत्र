// मध्यम_क्रम.सूत्र — मध्यम IR एकक ⇄ compact text (frontend/backend split)
// ============================================================
// अग्र_चालक (parse+lower+opt) IR को इस format में लिखता है;
// पश्च_चालक (regalloc+emit) इसे वापस पढ़कर एकक बनाता है।
// इससे कोई एक चालक ६ module import नहीं करता — पुराने O(n²) संकलक की
// स्मृति-सीमा में fit हो जाता है।
//
// format (line-oriented, space-separated tokens; string-const table
// escaped):
//   एकक
//   पाठ_स्थिरांक <n> ; फिर n पंक्तियाँ escape किया साहित्य
//   दशमलव_स्थिरांक <n> ; फिर n पंक्तियाँ
//   वैश्विक <n> ; फिर n पंक्तियाँ "<नाम> <प्रकार>"
//   ध्वज <मुख्य_है ०|१> <शीर्ष_है ०|१>
//   कार्य <नाम> <परत्_प्रकार> <अगला_आईडी> <अगला_लेबल> <पैरा_गण>
//     पैरा <नाम> <प्रकार> <आईडी>   (× पैरा_गण)
//     खंड <लेबल> <फाई_गण> <निर्देश_गण> <अंत? ०|१>
//       फाई <आईडी> <प्रकार> <स्रोत_गण> [<लेबल> <vid>]×
//       नि <कोड> <आईडी> <प्रकार> <op_गण> [op]× <अंश_गण> [<k> <v>]×
//       अंत <कोड> <op_गण> [op]× <अंश_गण> [<k> <v>]×
//     खंड-अंत
//   कार्य-अंत
//   एकक-अंत
// ============================================================

आयात "मध्यम.सूत्र";


// ---- escape / unescape (newline, backslash) ----
कार्य क्रम_एस्केप(पाठ स) {
    पाठ फल = "";
    संख्या इक = ०;
    यावत् (इक < लंबाई(स)) {
        पाठ च = स[इक];
        यदि (अक्षर_मान(च) == ९२) { फल = फल + अक्षर_निर्माण(९२) + अक्षर_निर्माण(९२); }
        अन्यथा यदि (अक्षर_मान(च) == १०) { फल = फल + अक्षर_निर्माण(९२) + "n"; }
        अन्यथा { फल = फल + च; }
        इक = इक + १;
    }
    परत् फल;
}
कार्य क्रम_अनएस्केप(पाठ स) {
    पाठ फल = "";
    संख्या इक = ०;
    यावत् (इक < लंबाई(स)) {
        पाठ च = स[इक];
        यदि (अक्षर_मान(च) == ९२ && इक + १ < लंबाई(स)) {
            पाठ अगला = स[इक + १];
            यदि (अक्षर_मान(अगला) == ११०) { फल = फल + अक्षर_निर्माण(१०); इक = इक + २; }
            अन्यथा यदि (अक्षर_मान(अगला) == ९२) { फल = फल + अक्षर_निर्माण(९२); इक = इक + २; }
            अन्यथा { फल = फल + च; इक = इक + १; }
        } अन्यथा { फल = फल + च; इक = इक + १; }
    }
    परत् फल;
}


// ============================================================
// क्रमबद्धीकरण (serialize)
// ============================================================
कार्य क्रम_रेखा(शब्दकोश बफ, पाठ स) {
    बफ["ट"] = जोड़ें(बफ["ट"], स);
    बफ["ट"] = जोड़ें(बफ["ट"], अक्षर_निर्माण(१०));
    परत् ०;
}

कार्य क्रम_संचालक_सूची(सूची संच) {
    पाठ स = "";
    संख्या इक = ०;
    यावत् (इक < लंबाई(संच)) {
        स = स + " " + संच[इक];
        इक = इक + १;
    }
    परत् स;
}

कार्य क्रम_अंश(शब्दकोश अंश) {
    यदि (अंश == शून्यम्) { परत् " 0"; }
    सूची कुं = कुंजियाँ(अंश);
    // 'स्रोत' (फाई) अलग से — यहाँ छोड़ो
    सूची असल = [];
    संख्या इक = ०;
    यावत् (इक < लंबाई(कुं)) {
        यदि (कुं[इक] != "स्रोत") { असल = जोड़ें(असल, कुं[इक]); }
        इक = इक + १;
    }
    पाठ स = " " + लंबाई(असल);
    इक = ०;
    यावत् (इक < लंबाई(असल)) {
        पाठ की = असल[इक];
        स = स + " " + की + " " + क्रम_अंश_मान(की, अंश);
        इक = इक + १;
    }
    परत् स;
}
// अंश-मान को token में बदलो। शून्य/बूल probing value पर नहीं, key+मान_प्रकार
// पर आधारित — ताकि पूर्णांक ० "@शून्य" न बन जाए।
कार्य क्रम_अंश_मान(पाठ की, शब्दकोश अंश) {
    मान म = अंश[की];
    यदि (की == "मान") {
        मान मप = अंश["मान_प्रकार"];
        यदि (मप == "बूल") {
            यदि (म == सत्य) { परत् "1"; }
            यदि (म == १) { परत् "1"; }
            परत् "0";
        }
        परत् "" + म;   // पूर्ण / पाठ-अनुक्रमांक → पूर्ण; दशमलव → पाठ
    }
    परत् "" + म;   // बाकी: नाम/लक्ष्य/क्षेत्र/लेबल (पाठ) या सूचकांक/क्षेत्र_गण (पूर्ण)
}

कार्य मध्यम_क्रमबद्ध(शब्दकोश एकक) {
    शब्दकोश बफ = {};
    बफ["ट"] = [];
    क्रम_रेखा(बफ, "एकक");

    सूची पस = एकक["पाठ_स्थिरांक"];
    क्रम_रेखा(बफ, "पाठ_स्थिरांक " + लंबाई(पस));
    संख्या इक = ०;
    यावत् (इक < लंबाई(पस)) { क्रम_रेखा(बफ, क्रम_एस्केप(पस[इक])); इक = इक + १; }

    मान दस = एकक["दशमलव_स्थिरांक"];
    यदि (दस == शून्यम्) { दस = []; }
    क्रम_रेखा(बफ, "दशमलव_स्थिरांक " + लंबाई(दस));
    इक = ०;
    यावत् (इक < लंबाई(दस)) { क्रम_रेखा(बफ, दस[इक]); इक = इक + १; }

    सूची वस = एकक["वैश्विक_सूची"];
    क्रम_रेखा(बफ, "वैश्विक " + लंबाई(वस));
    इक = ०;
    यावत् (इक < लंबाई(वस)) { क्रम_रेखा(बफ, वस[इक]["नाम"] + " " + वस[इक]["प्रकार"]); इक = इक + १; }

    // विदेशी (FFI) पुस्तकालय-सूची — लिंक-चरण को चाहिए (नक्शे की ज़रूरत नहीं,
    // सारी कॉल lowering में ही असली प्रतीक पर हल हो चुकीं)
    मान विप = एकक["विदेशी_पुस्तकालय"];
    यदि (विप == शून्यम्) { विप = []; }
    क्रम_रेखा(बफ, "विदेशी_पुस्तकालय " + लंबाई(विप));
    इक = ०;
    यावत् (इक < लंबाई(विप)) { क्रम_रेखा(बफ, विप[इक]); इक = इक + १; }

    संख्या मध = ०;
    यदि (एकक["मुख्य_है"] == सत्य) { मध = १; }
    संख्या शी = ०;
    यदि (एकक["शीर्ष_है"] == सत्य) { शी = १; }
    क्रम_रेखा(बफ, "ध्वज " + मध + " " + शी);

    सूची कस = एकक["कार्य_सूची"];
    इक = ०;
    यावत् (इक < लंबाई(कस)) {
        क्रम_कार्य(बफ, कस[इक]);
        इक = इक + १;
    }
    क्रम_रेखा(बफ, "एकक-अंत");
    परत् संयोजित(बफ["ट"], "");
}

कार्य क्रम_कार्य(शब्दकोश बफ, शब्दकोश फलन) {
    सूची पैरा = फलन["पैरामीटर"];
    क्रम_रेखा(बफ, "कार्य " + फलन["नाम"] + " " + फलन["परत्_प्रकार"] + " "
        + फलन["अगला_आईडी"] + " " + फलन["अगला_लेबल"] + " " + लंबाई(पैरा));
    संख्या इक = ०;
    यावत् (इक < लंबाई(पैरा)) {
        क्रम_रेखा(बफ, "पैरा " + पैरा[इक]["नाम"] + " " + पैरा[इक]["प्रकार"] + " " + पैरा[इक]["आईडी"]);
        इक = इक + १;
    }
    सूची खस = फलन["खंड_सूची"];
    इक = ०;
    यावत् (इक < लंबाई(खस)) {
        शब्दकोश ख = खस[इक];
        संख्या अंतध्व = ०;
        यदि (ख["अंत"] != शून्यम्) { अंतध्व = १; }
        क्रम_रेखा(बफ, "खंड " + ख["लेबल"] + " " + लंबाई(ख["फाई"]) + " " + लंबाई(ख["निर्देश"]) + " " + अंतध्व);
        संख्या जक = ०;
        यावत् (जक < लंबाई(ख["फाई"])) {
            शब्दकोश फ = ख["फाई"][जक];
            सूची स्रोत = फ["अंश"]["स्रोत"];
            पाठ ल = "फाई " + फ["आईडी"] + " " + फ["प्रकार"] + " " + लंबाई(स्रोत);
            संख्या क = ०;
            यावत् (क < लंबाई(स्रोत)) { ल = ल + " " + स्रोत[क][०] + " " + स्रोत[क][१]; क = क + १; }
            क्रम_रेखा(बफ, ल);
            जक = जक + १;
        }
        जक = ०;
        यावत् (जक < लंबाई(ख["निर्देश"])) {
            शब्दकोश नि = ख["निर्देश"][जक];
            क्रम_रेखा(बफ, "नि " + नि["कोड"] + " " + नि["आईडी"] + " " + नि["प्रकार"] + " "
                + लंबाई(नि["संचालक"]) + क्रम_संचालक_सूची(नि["संचालक"]) + क्रम_अंश(नि["अंश"]));
            जक = जक + १;
        }
        यदि (ख["अंत"] != शून्यम्) {
            शब्दकोश अ = ख["अंत"];
            क्रम_रेखा(बफ, "अंत " + अ["कोड"] + " " + लंबाई(अ["संचालक"])
                + क्रम_संचालक_सूची(अ["संचालक"]) + क्रम_अंश(अ["अंश"]));
        }
        क्रम_रेखा(बफ, "खंड-अंत");
        इक = इक + १;
    }
    क्रम_रेखा(बफ, "कार्य-अंत");
    परत् ०;
}


// ============================================================
// विक्रमबद्धीकरण (deserialize)
// ============================================================
कार्य विक्रम_टोकन(पाठ रेखा) {
    परत् विभाजित(रेखा, " ");
}
कार्य विक्रम_पूर्ण(पाठ ट) {
    संख्या मानः = ०;
    संख्या इक = ०;
    मान ऋण = असत्य;
    यदि (लंबाई(ट) > ०) { यदि (ट[०] == "-") { ऋण = सत्य; इक = १; } }
    यावत् (इक < लंबाई(ट)) {
        संख्या क = अक्षर_मान(ट[इक]);
        यदि (क >= ४८ && क <= ५७) { मानः = मानः * १० + (क - ४८); }
        इक = इक + १;
    }
    यदि (ऋण) { परत् ० - मानः; }
    परत् मानः;
}

कार्य मध्यम_विक्रमबद्ध(पाठ इनपुट) {
    सूची रेखाएँ = विभाजित(इनपुट, अक्षर_निर्माण(१०));
    शब्दकोश अवस्था = {};
    अवस्था["रेखाएँ"] = रेखाएँ;
    अवस्था["सूचक"] = ०;

    शब्दकोश एकक = मध्यम_नव_एकक();

    // पाठ_स्थिरांक
    सूची टक = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // "एकक"
    टक = विक्रम_टोकन(विक्रम_अगली(अवस्था));
    संख्या पन = विक्रम_पूर्ण(टक[१]);
    संख्या इक = ०;
    यावत् (इक < पन) {
        एकक["पाठ_स्थिरांक"] = जोड़ें(एकक["पाठ_स्थिरांक"], क्रम_अनएस्केप(विक्रम_अगली(अवस्था)));
        इक = इक + १;
    }
    टक = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // दशमलव_स्थिरांक n
    संख्या दन = विक्रम_पूर्ण(टक[१]);
    इक = ०;
    यावत् (इक < दन) {
        एकक["दशमलव_स्थिरांक"] = जोड़ें(एकक["दशमलव_स्थिरांक"], विक्रम_अगली(अवस्था));
        इक = इक + १;
    }
    टक = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // वैश्विक n
    संख्या वन = विक्रम_पूर्ण(टक[१]);
    इक = ०;
    यावत् (इक < वन) {
        सूची जत = विक्रम_टोकन(विक्रम_अगली(अवस्था));
        शब्दकोश जी = {};
        जी["नाम"] = जत[०];
        जी["प्रकार"] = जत[१];
        एकक["वैश्विक_सूची"] = जोड़ें(एकक["वैश्विक_सूची"], जी);
        इक = इक + १;
    }
    टक = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // विदेशी_पुस्तकालय n
    संख्या विपन = विक्रम_पूर्ण(टक[१]);
    इक = ०;
    यावत् (इक < विपन) {
        एकक["विदेशी_पुस्तकालय"] = जोड़ें(एकक["विदेशी_पुस्तकालय"], विक्रम_अगली(अवस्था));
        इक = इक + १;
    }
    टक = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // ध्वज m s
    एकक["मुख्य_है"] = असत्य;
    यदि (विक्रम_पूर्ण(टक[१]) == १) { एकक["मुख्य_है"] = सत्य; }
    एकक["शीर्ष_है"] = असत्य;
    यदि (विक्रम_पूर्ण(टक[२]) == १) { एकक["शीर्ष_है"] = सत्य; }

    यावत् (सत्य) {
        पाठ रेखा = विक्रम_झांक(अवस्था);
        यदि (रेखा == "एकक-अंत" || रेखा == "@अंत@") { विक्रम_अगली(अवस्था); परत् एकक; }
        एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], विक्रम_कार्य(अवस्था));
    }
    परत् एकक;
}

// पंक्ति का trailing \r (CRLF → LF) हटाओ — Windows stdout redirect के लिए
कार्य विक्रम_काटो(पाठ रेखा) {
    संख्या दीर्घ = लंबाई(रेखा);
    यदि (दीर्घ > ०) {
        यदि (अक्षर_मान(रेखा[दीर्घ - १]) == १३) { परत् उपखंड(रेखा, ०, दीर्घ - १); }
    }
    परत् रेखा;
}
कार्य विक्रम_अगली(शब्दकोश अवस्था) {
    संख्या सू = अवस्था["सूचक"];
    यदि (सू >= लंबाई(अवस्था["रेखाएँ"])) { परत् "@अंत@"; }
    अवस्था["सूचक"] = सू + १;
    परत् विक्रम_काटो(अवस्था["रेखाएँ"][सू]);
}
कार्य विक्रम_झांक(शब्दकोश अवस्था) {
    संख्या सू = अवस्था["सूचक"];
    यदि (सू >= लंबाई(अवस्था["रेखाएँ"])) { परत् "@अंत@"; }
    परत् विक्रम_काटो(अवस्था["रेखाएँ"][सू]);
}

कार्य विक्रम_कार्य(शब्दकोश अवस्था) {
    सूची कत = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // कार्य नाम ret nextid nextlbl paracount
    शब्दकोश फलन = मध्यम_नव_कार्य(कत[१], कत[२]);
    फलन["अगला_आईडी"] = विक्रम_पूर्ण(कत[३]);
    फलन["अगला_लेबल"] = विक्रम_पूर्ण(कत[४]);
    संख्या पगण = विक्रम_पूर्ण(कत[५]);
    संख्या इक = ०;
    यावत् (इक < पगण) {
        सूची पत = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // पैरा नाम प्रकार आईडी
        शब्दकोश प = {};
        प["नाम"] = पत[१];
        प["प्रकार"] = पत[२];
        प["आईडी"] = विक्रम_पूर्ण(पत[३]);
        फलन["पैरामीटर"] = जोड़ें(फलन["पैरामीटर"], प);
        इक = इक + १;
    }
    यावत् (सत्य) {
        पाठ रेखा = विक्रम_झांक(अवस्था);
        यदि (रेखा == "कार्य-अंत") { विक्रम_अगली(अवस्था); परत् फलन; }
        फलन["खंड_सूची"] = जोड़ें(फलन["खंड_सूची"], विक्रम_खंड(अवस्था));
    }
    परत् फलन;
}

कार्य विक्रम_खंड(शब्दकोश अवस्था) {
    सूची खत = विक्रम_टोकन(विक्रम_अगली(अवस्था));   // खंड लेबल फाईगण निगण अंतध्व
    शब्दकोश ख = {};
    ख["लेबल"] = खत[१];
    ख["फाई"] = [];
    ख["निर्देश"] = [];
    ख["अंत"] = शून्यम्;
    यावत् (सत्य) {
        पाठ रेखा = विक्रम_झांक(अवस्था);
        यदि (रेखा == "खंड-अंत") { विक्रम_अगली(अवस्था); परत् ख; }
        सूची ट = विक्रम_टोकन(विक्रम_अगली(अवस्था));
        यदि (ट[०] == "फाई") {
            शब्दकोश अंश = {};
            सूची स्रोत = [];
            संख्या सगण = विक्रम_पूर्ण(ट[३]);
            संख्या क = ०;
            यावत् (क < सगण) {
                स्रोत = जोड़ें(स्रोत, [ट[४ + क * २], विक्रम_पूर्ण(ट[५ + क * २])]);
                क = क + १;
            }
            अंश["स्रोत"] = स्रोत;
            शब्दकोश फ = मध्यम_निर्देश_बनाओ("फाई", विक्रम_पूर्ण(ट[१]), ट[२], [], अंश);
            ख["फाई"] = जोड़ें(ख["फाई"], फ);
        } अन्यथा यदि (ट[०] == "नि") {
            ख["निर्देश"] = जोड़ें(ख["निर्देश"], विक्रम_निर्देश(ट, १));
        } अन्यथा यदि (ट[०] == "अंत") {
            ख["अंत"] = विक्रम_टर्म(ट);
        }
    }
    परत् ख;
}

// ट: [नि, कोड, आईडी, प्रकार, opcount, ops..., अंशcount, k, v, ...]
कार्य विक्रम_निर्देश(सूची ट, संख्या आधार) {
    पाठ कोड = ट[आधार];
    संख्या आईडी = विक्रम_पूर्ण(ट[आधार + १]);
    पाठ प्रकार = ट[आधार + २];
    संख्या संगण = विक्रम_पूर्ण(ट[आधार + ३]);
    सूची संच = [];
    संख्या क = ०;
    यावत् (क < संगण) { संच = जोड़ें(संच, विक्रम_पूर्ण(ट[आधार + ४ + क])); क = क + १; }
    संख्या अपद = आधार + ४ + संगण;
    शब्दकोश अंश = विक्रम_अंश(ट, अपद, कोड);
    परत् मध्यम_निर्देश_बनाओ(कोड, आईडी, प्रकार, संच, अंश);
}

// ट: [अंत, कोड, opcount, ops..., अंशcount, k, v, ...]
कार्य विक्रम_टर्म(सूची ट) {
    पाठ कोड = ट[१];
    संख्या संगण = विक्रम_पूर्ण(ट[२]);
    सूची संच = [];
    संख्या क = ०;
    यावत् (क < संगण) { संच = जोड़ें(संच, विक्रम_पूर्ण(ट[३ + क])); क = क + १; }
    शब्दकोश अंश = विक्रम_अंश(ट, ३ + संगण, कोड);
    परत् मध्यम_निर्देश_बनाओ(कोड, ० - १, "शून्य", संच, अंश);
}

कार्य विक्रम_अंश(सूची ट, संख्या पद, पाठ कोड) {
    शब्दकोश अंश = {};
    यदि (पद >= लंबाई(ट)) { परत् अंश; }
    संख्या गण = विक्रम_पूर्ण(ट[पद]);
    संख्या क = ०;
    यावत् (क < गण) {
        पाठ कुं = ट[पद + १ + क * २];
        पाठ मव = ट[पद + २ + क * २];
        यदि (कुं == "सूचकांक" || कुं == "क्षेत्र_गण") { अंश[कुं] = विक्रम_पूर्ण(मव); }
        अन्यथा { अंश[कुं] = मव; }
        क = क + १;
    }
    // 'मान' को उसके मान_प्रकार अनुसार सुधारो (कुंजी-क्रम पर निर्भर नहीं)
    यदि (अंश["मान"] != शून्यम्) {
        मान मप = अंश["मान_प्रकार"];
        यदि (मप == "पूर्ण" || मप == "पाठ" || मप == "बूल") {
            अंश["मान"] = विक्रम_पूर्ण(अंश["मान"]);
        }
    }
    परत् अंश;
}
