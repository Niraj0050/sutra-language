// अष्टक_उत्सर्जक.सूत्र — मध्यम IR → सूत्र आभासी यंत्र (SVM) अष्टक-संकेत
// ============================================================
// इनपुट: मध्यम.सूत्र का IR एकक (प्रोग्राम_पार्स → निम्नक_एकक)
// आउटपुट: SVM प्रोग्राम संरचना (फलन_मानचित्र + आज्ञा_सूची)
// ============================================================

आयात "अष्टक_संकेत.सूत्र";
आयात "मध्यम.सूत्र";

कार्य अष्टक_उत्सर्जक_फलन(शब्दकोश एकक, शब्दकोश फलन) {
    सूची आज्ञा_सूची = [];
    शब्दकोश खंड_पता = {};
    
    // पैरामीटर प्रारंभ: कॉलर द्वारा धारक [१००..१००+N-१] में भेजे गए तर्कों को
    // स्थानीय स्लॉट आईडी में प्रतिलिपि करें (बिना किसी टकराव के)
    संख्या पैरा_संख्या = लंबाई(फलन["पैरामीटर"]);
    संख्या प = ०;
    यावत् (प < पैरा_संख्या) {
        शब्दकोश पैरा = फलन["पैरामीटर"][प];
        संख्या स्लॉट_आईडी = पैरा["आईडी"];
        यदि (स्लॉट_आईडी >= ०) {
            आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_चाल, स्लॉट_आईडी, १०० + प, -१, शून्यम्));
        }
        प = प + १;
    }
    
    // चरण १: सभी खंडों की आज्ञाएं उत्पन्न करें
    सूची खंड_सूची = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खंड_सूची)) {
        शब्दकोश खंड = खंड_सूची[ख];
        पाठ खंड_नाम = खंड["लेबल"];
        
        // इस खंड का आरंभिक पता रिकॉर्ड करें
        खंड_पता[खंड_नाम] = लंबाई(आज्ञा_सूची);
        
        // खंड के निर्देश
        सूची निर्देश_सूची = खंड["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निर्देश_सूची)) {
            शब्दकोश निर्देश = निर्देश_सूची[नि];
            पाठ कोड = निर्देश["कोड"];
            संख्या आईडी = निर्देश["आईडी"];
            सूची संचालक = निर्देश["संचालक"];
            शब्दकोश अंश = निर्देश["अंश"];
            
            // १. स्थिर
            यदि (कोड == "स्थिर") {
                मान मान_प्रकार = अंश["मान_प्रकार"];
                मान स्थिरांक_मान = अंश["मान"];
                यदि (मान_प्रकार == "पाठ") {
                    संख्या पाठ_सूचक = स्थिरांक_मान;
                    स्थिरांक_मान = एकक["पाठ_स्थिरांक"][पाठ_सूचक];
                }
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, आईडी, -१, -१, स्थिरांक_मान));
            }
            // २. स्लॉट
            अन्यथा यदि (कोड == "स्लॉट") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_स्थिर, आईडी, -१, -१, शून्यम्));
            }
            // ३. पढ़_स्लॉट
            अन्यथा यदि (कोड == "पढ़_स्लॉट") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_चाल, आईडी, संचालक[०], -१, शून्यम्));
            }
            // ४. लिख_स्लॉट
            अन्यथा यदि (कोड == "लिख_स्लॉट") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_चाल, संचालक[०], संचालक[१], -१, शून्यम्));
            }
            // ५. योग
            अन्यथा यदि (कोड == "योग") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_योग, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // ६. अंतर
            अन्यथा यदि (कोड == "अंतर") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_अंतर, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // ७. गुणा
            अन्यथा यदि (कोड == "गुणा") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_गुणा, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // ८. भाग
            अन्यथा यदि (कोड == "भाग") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_भाग, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // ९. शेष
            अन्यथा यदि (कोड == "शेष") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_शेष, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १०. ऋणात्मक
            अन्यथा यदि (कोड == "ऋणात्मक") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_ऋणात्मक, आईडी, संचालक[०], -१, शून्यम्));
            }
            // ११. सम
            अन्यथा यदि (कोड == "सम") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_सम, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १२. असम
            अन्यथा यदि (कोड == "असम") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_असम, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १३. लघु
            अन्यथा यदि (कोड == "लघु") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लघु, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १४. गुरु
            अन्यथा यदि (कोड == "गुरु") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_गुरु, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १५. लघुसम
            अन्यथा यदि (कोड == "लघुसम") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लघुसम, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १६. गुरुसम
            अन्यथा यदि (कोड == "गुरुसम") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_गुरुसम, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १७. और
            अन्यथा यदि (कोड == "और") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_और, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १८. या
            अन्यथा यदि (कोड == "या") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_या, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // १९. नकार
            अन्यथा यदि (कोड == "नकार") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_नकार, आईडी, संचालक[०], -१, शून्यम्));
            }
            // २०. पढ़_वैश्विक
            अन्यथा यदि (कोड == "पढ़_वैश्विक") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_पढ़_वैश्विक, आईडी, -१, -१, अंश["नाम"]));
            }
            // २१. लिख_वैश्विक
            अन्यथा यदि (कोड == "लिख_वैश्विक") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लिख_वैश्विक, -१, संचालक[०], -१, अंश["नाम"]));
            }
            // २२. नव_सूची
            अन्यथा यदि (कोड == "नव_सूची") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_नव_सूची, आईडी, -१, -१, शून्यम्));
            }
            // २३. नव_शब्दकोश
            अन्यथा यदि (कोड == "नव_शब्दकोश") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_नव_शब्दकोश, आईडी, -१, -१, शून्यम्));
            }
            // २४. पढ़_अनुक्रम
            अन्यथा यदि (कोड == "पढ़_अनुक्रम") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_पढ़_अनुक्रम, आईडी, संचालक[०], संचालक[१], शून्यम्));
            }
            // २५. लिख_अनुक्रम
            अन्यथा यदि (कोड == "लिख_अनुक्रम") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लिख_अनुक्रम, संचालक[२], संचालक[०], संचालक[१], शून्यम्));
            }
            // २६. लंबाई
            अन्यथा यदि (कोड == "लंबाई") {
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लंबाई, आईडी, संचालक[०], -१, शून्यम्));
            }
            // २७. बुलाओ (Call)
            अन्यथा यदि (कोड == "बुलाओ") {
                पाठ लक्ष्य = अंश["लक्ष्य"];
                
                // लिखतु / कंसोल मुद्रण
                यदि (लक्ष्य == "लिखतु" || लक्ष्य == "गतिशील_छापो" || लक्ष्य == "पाठ_छापो" || लक्ष्य == "पूर्णांक_छापो" || लक्ष्य == "बूल_छापो" || लक्ष्य == "शून्य_छापो" || लक्ष्य == "sutra_print_dynamic" || लक्ष्य == "sutra_print_str" || लक्ष्य == "sutra_print_int") {
                    यदि (लंबाई(संचालक) > ०) {
                        आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_छापो, -१, संचालक[०], -१, शून्यम्));
                    }
                } अन्यथा यदि (लक्ष्य == "लंबाई" || लक्ष्य == "sutra_arr_length" || लक्ष्य == "sutra_str_length") {
                    यदि (लंबाई(संचालक) > ०) {
                        आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_लंबाई, आईडी, संचालक[०], -१, शून्यम्));
                    }
                } अन्यथा {
                    // सामान्य फलन आह्वान:
                    // तर्कों को धारक [५०, ५१, ...] में कॉपी करें
                    संख्या तर्क_संख्या = लंबाई(संचालक);
                    संख्या तर्क_आधार = ५०;
                    संख्या ति = ०;
                    यावत् (ति < तर्क_संख्या) {
                        आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_चाल, तर्क_आधार + ति, संचालक[ति], -१, शून्यम्));
                        ति = ति + १;
                    }
                    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_बुलाओ, आईडी, तर्क_संख्या, तर्क_आधार, लक्ष्य));
                }
            }
            
            नि = नि + १;
        }
        
        // खंड का अंत (टर्मिनेटर)
        शब्दकोश अंत = खंड["अंत"];
        यदि (अंत != शून्यम्) {
            पाठ अंत_कोड = अंत["कोड"];
            यदि (अंत_कोड == "वापस") {
                संख्या परत्_मान = -१;
                यदि (लंबाई(अंत["संचालक"]) > ०) {
                    परत्_मान = अंत["संचालक"][०];
                }
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, परत्_मान, -१, शून्यम्));
            } अन्यथा यदि (अंत_कोड == "जाओ") {
                पाठ लक्ष्य_ले = अंत["अंश"]["लक्ष्य"];
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_जाओ, -१, -१, -१, लक्ष्य_ले));
            } अन्यथा यदि (अंत_कोड == "यदि_जाओ") {
                संख्या शर्त_आईडी = अंत["संचालक"][०];
                पाठ सत्य_ले = अंत["अंश"]["सत्य"];
                पाठ असत्य_ले = अंत["अंश"]["असत्य"];
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_यदि_जाओ, -१, शर्त_आईडी, -१, सत्य_ले));
                आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_जाओ, -१, -१, -१, असत्य_ले));
            }
        }
        
        ख = ख + १;
    }
    
    // सुरक्षा: फलन के अंत में वापस आज्ञा
    आज्ञा_सूची = जोड़ें(आज्ञा_सूची, अष्टक_नव_आज्ञा(आज्ञा_वापस, -१, -१, -१, शून्यम्));
    
    // चरण २: छलांग पतों (Jump targets) का समाधान (Pass 2)
    संख्या आ = ०;
    यावत् (आ < लंबाई(आज्ञा_सूची)) {
        शब्दकोश आज्ञा = आज्ञा_सूची[आ];
        संख्या कूट = आज्ञा["कूट"];
        
        यदि (कूट == आज्ञा_जाओ) {
            पाठ लक्ष्य_ले = आज्ञा["स्थिरांक"];
            यदि (लक्ष्य_ले != शून्यम् && खंड_पता[लक्ष्य_ले] != शून्यम्) {
                आज्ञा["प्र१"] = खंड_पता[लक्ष्य_ले];
            }
        } अन्यथा यदि (कूट == आज्ञा_यदि_जाओ || कूट == आज्ञा_यदि_न_जाओ) {
            पाठ लक्ष्य_ले = आज्ञा["स्थिरांक"];
            यदि (लक्ष्य_ले != शून्यम् && खंड_पता[लक्ष्य_ले] != शून्यम्) {
                आज्ञा["प्र२"] = खंड_पता[लक्ष्य_ले];
            }
        }
        आ = आ + १;
    }
    
    शब्दकोश फलन_फल = {};
    फलन_फल["नाम"] = फलन["नाम"];
    फलन_फल["आज्ञा_सूची"] = आज्ञा_सूची;
    फलन_फल["पैरामीटर_गणना"] = पैरा_संख्या;
    परत् फलन_फल;
}

// संपूर्ण एकक को SVM प्रोग्राम में परिवर्तित करें
कार्य अष्टक_उत्सर्जक_एकक(शब्दकोश एकक) {
    शब्दकोश फलन_मानचित्र = {};
    
    सूची कार्य_सूची = एकक["कार्य_सूची"];
    संख्या क = ०;
    यावत् (क < लंबाई(कार्य_सूची)) {
        शब्दकोश फलन = कार्य_सूची[क];
        शब्दकोश फलन_फल = अष्टक_उत्सर्जक_फलन(एकक, फलन);
        फलन_मानचित्र[फलन["नाम"]] = फलन_फल;
        क = क + १;
    }
    
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["जादुई_संकेत"] = "सूत्र";
    प्रोग्राम["संस्करण"] = "१.०";
    प्रोग्राम["लक्ष्य_यंत्र"] = "सार्वत्रिक";
    प्रोग्राम["फलन_मानचित्र"] = फलन_मानचित्र;
    
    यदि (फलन_मानचित्र["__शीर्ष"] != शून्यम्) {
        प्रोग्राम["प्रारंभ_फलन"] = "__शीर्ष";
    } अन्यथा {
        प्रोग्राम["प्रारंभ_फलन"] = "मुख्य";
    }
    
    परत् प्रोग्राम;
}
