// गहन_अंतर्वेशन_परीक्षण.सूत्र — bounded self-recursive inlining का test
// असली parser → lower → अनुकूलक_एकक → पुच्छ_अनुकूलन_एकक → अंतर्वेशन_एकक →
// गहन_अंतर्वेशन_एकक → IR डंप जाँचो (पुच्छ_अनुकूलन_परीक्षण जैसा ही तरीका)

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "पुच्छ_अनुकूलन.सूत्र";
आयात "अंतर्वेशन.सूत्र";
आयात "गहन_अंतर्वेशन.सूत्र";

मान विफल = ०;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + १; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= ०; }

// उप कितनी बार आता है (अतिव्यापी नहीं) — पुस्तकालय/पाठ.सूत्र की गिनो_पाठ जैसी
कार्य गिनो(पाठ स, पाठ उप) {
    संख्या ग = ०;
    पाठ शेष = स;
    यावत् (सत्य) {
        संख्या प = खोजें(शेष, उप);
        यदि (प == -१) { विरामः; }
        ग = ग + १;
        शेष = उपखंड(शेष, प + लंबाई(उप), लंबाई(शेष));
    }
    परत् ग;
}

कार्य दोहराओ(पाठ खंड, संख्या गिनती) {
    पाठ स = "";
    संख्या इ = ०;
    यावत् (इ < गिनती) { स = स + खंड; इ = इ + १; }
    परत् स;
}

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}

// parse → lower → सामान्य अनुकूलक → TCO → v1 inlining → गहन_अंतर्वेशन → छापो
कार्य पूर्ण_अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    पुच्छ_अनुकूलन_एकक(एकक);
    अंतर्वेशन_एकक(एकक);
    गहन_अंतर्वेशन_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

कार्य मुख्य() {
    // १. मूल — फिब-शैली (non-tail, २ self-recursive call-site) — दोनों splice हों
    पाठ द1 = पूर्ण_अनुकूलित(
        "कार्य फिब(संख्या अ) { यदि (अ <= 1) { परत् अ; } परत् फिब(अ - 1) + फिब(अ - 2); }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 गहन_क्लोन ब्लॉक बना", है(द1, "गहन_क्लोन"));
    जाँच("1 गहन_जारी ब्लॉक बना (merge-point)", है(द1, "गहन_जारी"));
    जाँच("1 दोनों मूल स्थल splice हुए (@फिब कॉल-गिनती 2→4, doubling)", गिनो(द1, "@फिब") == ४);

    // २. नकारात्मक — आकार-सीमा (>१५ निर्देश) से बड़ा self-recursive फलन अछूता रहे
    पाठ भारी_देह = दोहराओ("ब = ब + 1; ", २०);
    पाठ द2 = पूर्ण_अनुकूलित(
        "कार्य भारी(संख्या अ) { यदि (अ <= 0) { परत् 0; } संख्या ब = अ; " + भारी_देह +
        " परत् भारी(अ - 1) + ब; }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 oversized self-recursive फलन अछूता (कोई गहन_क्लोन नहीं)", न है(द2, "गहन_क्लोन"));
    जाँच("2 मूल @भारी कॉल जस-का-तस", है(द2, "@भारी"));

    // ३. नकारात्मक — २ से अधिक self-recursive call-site वाला फलन अछूता रहे
    पाठ द3 = पूर्ण_अनुकूलित(
        "कार्य तीनकॉल(संख्या अ) { यदि (अ <= 0) { परत् 0; } " +
        "परत् तीनकॉल(अ - 1) + तीनकॉल(अ - 2) + तीनकॉल(अ - 3); }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 >2 call-site वाला फलन अछूता (कोई गहन_क्लोन नहीं)", न है(द3, "गहन_क्लोन"));
    जाँच("3 सभी 3 मूल @तीनकॉल कॉल जस-का-तस", गिनो(द3, "@तीनकॉल") == ३);

    // ४. नकारात्मक — non-recursive फलन बिल्कुल अछूता
    पाठ द4 = पूर्ण_अनुकूलित("कार्य सादा(संख्या अ) { परत् अ + 1; }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 non-recursive फलन अछूता (कोई गहन_क्लोन नहीं)", न है(द4, "गहन_क्लोन"));
    जाँच("4 non-recursive फलन अछूता (कोई गहन_जारी नहीं)", न है(द4, "गहन_जारी"));

    // ५. गहराई-१ सीमा — क्लोन किए कोड के अपने self-recursive कॉल आगे splice न हों
    // (द1 पर ही: अगर गहराई असीमित होती तो @फिब गिनती ४ से कहीं ज़्यादा
    // (८, १६, ...) होती — ठीक ४ होना साबित करता है कि विस्तार सिर्फ़ एक
    // स्तर गहरा हुआ, क्लोन के अंदर के कॉल असली बुलाओ निर्देश ही रहे)
    जाँच("5 गहराई ठीक 1 स्तर (@फिब == 4, न कि आगे विस्तारित)", गिनो(द1, "@फिब") == ४);

    लिखतु("");
    यदि (विफल == ०) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
