कार्य अष्टक_पाठ_से_पूर्णांक(पाठ प) {
    यदि (प == "-१" || प == "-1") { परत् -१; }
    बूल ऋण = असत्य;
    संख्या प्रारंभ = ०;
    यदि (लंबाई(प) > ० && प[०] == "-") {
        ऋण = सत्य;
        प्रारंभ = १;
    } अन्यथा यदि (लंबाई(प) > ० && प[०] == "क") {
        प्रारंभ = १;
    }
    संख्या परिणाम = ०;
    संख्या इ = प्रारंभ;
    यावत् (इ < लंबाई(प)) {
        पाठ च = प[इ];
        संख्या कोड = अक्षर_मान(च);
        यदि (कोड >= २४०६ && कोड <= २४१५) {
            परिणाम = परिणाम * १० + (कोड - २४०६);
        } अन्यथा यदि (कोड >= ४८ && कोड <= ५७) {
            परिणाम = परिणाम * १० + (कोड - ४८);
        }
        इ = इ + १;
    }
    यदि (ऋण) {
        परत् ० - परिणाम;
    }
    परत् परिणाम;
}

कार्य अष्टक_पाठ_से_दशमलव(पाठ प) {
    सूची खंड = विभाजित(प, ".");
    यदि (लंबाई(खंड) == १) {
        परत् १.० * अष्टक_पाठ_से_पूर्णांक(खंड[०]);
    }
    संख्या पूर्णांक_भाग = अष्टक_पाठ_से_पूर्णांक(खंड[०]);
    पाठ अंश_पाठ = खंड[१];
    संख्या अंश_भाग = अष्टक_पाठ_से_पूर्णांक(अंश_पाठ);
    दशमलव भाजक = १.०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(अंश_पाठ)) {
        भाजक = भाजक * १०.०;
        इ = इ + १;
    }
    यदि (पूर्णांक_भाग < ०) {
        परत् पूर्णांक_भाग - (१.० * अंश_भाग / भाजक);
    }
    परत् पूर्णांक_भाग + (१.० * अंश_भाग / भाजक);
}

कार्य अष्टक_मान_कंटेनर_रूप(मान स्थिरांक) {
    यदि (स्थिरांक == शून्यम्) {
        परत् "शून्यम्";
    }
    पाठ प्रकारः = प्रकार(स्थिरांक);
    यदि (प्रकारः == "पूर्णांक" || प्रकारः == "संख्या") {
        परत् "संख्या:" + अष्टक_संख्या_देवनागरी(स्थिरांक);
    } अन्यथा यदि (प्रकारः == "दशमलव") {
        परत् "दशमलव:" + स्थिरांक;
    } अन्यथा यदि (प्रकारः == "तर्क" || प्रकारः == "बूल") {
        यदि (स्थिरांक) {
            परत् "बूल:सत्य";
        } अन्यथा {
            परत् "बूल:असत्य";
        }
    } अन्यथा {
        परत् "पाठ:" + स्थिरांक;
    }
}

कार्य अष्टक_आज्ञा_कंटेनर_रूप(शब्दकोश आज्ञा) {
    पाठ कूट_पाठ = "आज्ञा: " + अष्टक_संख्या_देवनागरी(आज्ञा["कूट"]);
    पाठ धारक_पाठ = "-१";
    यदि (आज्ञा["लक्ष्य"] >= ०) {
        धारक_पाठ = "क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    }
    पाठ प्र१_पाठ = "-१";
    यदि (आज्ञा["प्र१"] >= ०) {
        प्र१_पाठ = "" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]);
    }
    पाठ प्र२_पाठ = "-१";
    यदि (आज्ञा["प्र२"] >= ०) {
        प्र२_पाठ = "" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र२"]);
    }
    पाठ मान_पाठ = अष्टक_मान_कंटेनर_रूप(आज्ञा["स्थिरांक"]);
    परत् "  " + कूट_पाठ + " | " + धारक_पाठ + " | " + प्र१_पाठ + " | " + प्र२_पाठ + " | " + मान_पाठ;
}

कार्य अष्टक_कंटेनर_संश्लेषण(शब्दकोश प्रोग्राम) {
    पाठ फल = "# 🕉️ सूत्र अष्टक-संकेत संप्रभु बाइनरी पात्र (.सूत्रक)\n";
    फल = फल + "जादुई: " + प्रोग्राम["जादुई_संकेत"] + "\n";
    फल = फल + "संस्करण: " + प्रोग्राम["संस्करण"] + "\n";
    फल = फल + "लक्ष्य: " + प्रोग्राम["लक्ष्य_यंत्र"] + "\n";
    फल = फल + "प्रारंभ: " + प्रोग्राम["प्रारंभ_फलन"] + "\n\n";

    शब्दकोश फनक्शा = प्रोग्राम["फलन_मानचित्र"];
    सूची फकुंजियाँ = कुंजियाँ(फनक्शा);
    संख्या फइ = ०;
    यावत् (फइ < लंबाई(फकुंजियाँ)) {
        पाठ फनाम = फकुंजियाँ[फइ];
        शब्दकोश फलन = फनक्शा[फनाम];
        फल = फल + ".फलन: " + फनाम + " | " + अष्टक_संख्या_देवनागरी(फलन["पैरामीटर_गणना"]) + "\n";
        सूची फआज्ञा = फलन["आज्ञा_सूची"];
        संख्या आइ = ०;
        यावत् (आइ < लंबाई(फआज्ञा)) {
            फल = फल + अष्टक_आज्ञा_कंटेनर_रूप(फआज्ञा[आइ]) + "\n";
            आइ = आइ + १;
        }
        फल = फल + "\n";
        फइ = फइ + १;
    }
    परत् फल;
}

कार्य अष्टक_कंटेनर_पार्स(पाठ सामग्री) {
    शब्दकोश प्रोग्राम = {};
    प्रोग्राम["जादुई_संकेत"] = "सूत्र";
    प्रोग्राम["संस्करण"] = "१.०";
    प्रोग्राम["लक्ष्य_यंत्र"] = "सार्वत्रिक";
    प्रोग्राम["प्रारंभ_फलन"] = "मुख्य";
    शब्दकोश फलन_मानचित्र = {};

    सूची पंक्तियाँ = विभाजित(सामग्री, "\n");
    शब्दकोश वर्तमान_फलन = शून्यम्;
    सूची वर्तमान_आज्ञा_सूची = [];

    संख्या पइ = ०;
    यावत् (पइ < लंबाई(पंक्तियाँ)) {
        पाठ पंक्ति = छाँटें(पंक्तियाँ[पइ]);
        यदि (लंबाई(पंक्ति) == ० || पंक्ति[०] == "#") {
            पइ = पइ + १;
            जारीरह;
        }

        यदि (आरंभिक(पंक्ति, "जादुई: ")) {
            प्रोग्राम["जादुई_संकेत"] = छाँटें(उपखंड(पंक्ति, लंबाई("जादुई: "), लंबाई(पंक्ति)));
        } अन्यथा यदि (आरंभिक(पंक्ति, "संस्करण: ")) {
            प्रोग्राम["संस्करण"] = छाँटें(उपखंड(पंक्ति, लंबाई("संस्करण: "), लंबाई(पंक्ति)));
        } अन्यथा यदि (आरंभिक(पंक्ति, "लक्ष्य: ")) {
            प्रोग्राम["लक्ष्य_यंत्र"] = छाँटें(उपखंड(पंक्ति, लंबाई("लक्ष्य: "), लंबाई(पंक्ति)));
        } अन्यथा यदि (आरंभिक(पंक्ति, "प्रारंभ: ")) {
            प्रोग्राम["प्रारंभ_फलन"] = छाँटें(उपखंड(पंक्ति, लंबाई("प्रारंभ: "), लंबाई(पंक्ति)));
        } अन्यथा यदि (आरंभिक(पंक्ति, ".फलन:")) {
            यदि (वर्तमान_फलन != शून्यम्) {
                वर्तमान_फलन["आज्ञा_सूची"] = वर्तमान_आज्ञा_सूची;
                फलन_मानचित्र[वर्तमान_फलन["नाम"]] = वर्तमान_फलन;
            }
            सूची खंड = विभाजित(पंक्ति, " | ");
            पाठ फनाम_खंड = खंड[०];
            पाठ फनाम = छाँटें(उपखंड(फनाम_खंड, लंबाई(".फलन:"), लंबाई(फनाम_खंड)));
            संख्या पैरा_संख्या = ०;
            यदि (लंबाई(खंड) > १) {
                पैरा_संख्या = अष्टक_पाठ_से_पूर्णांक(छाँटें(खंड[१]));
            }
            वर्तमान_फलन = {};
            वर्तमान_फलन["नाम"] = फनाम;
            वर्तमान_फलन["पैरामीटर_गणना"] = पैरा_संख्या;
            वर्तमान_आज्ञा_सूची = [];
        } अन्यथा यदि (आरंभिक(पंक्ति, "आज्ञा:")) {
            सूची खंड = विभाजित(पंक्ति, " | ");
            यदि (लंबाई(खंड) >= ५) {
                पाठ कूट_खंड = खंड[०];
                संख्या कूट = अष्टक_पाठ_से_पूर्णांक(छाँटें(उपखंड(कूट_खंड, लंबाई("आज्ञा:"), लंबाई(कूट_खंड))));
                संख्या धारक = अष्टक_पाठ_से_पूर्णांक(छाँटें(खंड[१]));
                संख्या प्र१ = अष्टक_पाठ_से_पूर्णांक(छाँटें(खंड[२]));
                संख्या प्र२ = अष्टक_पाठ_से_पूर्णांक(छाँटें(खंड[३]));
                पाठ मान_खंड = छाँटें(खंड[४]);

                शब्दकोश आज्ञा = अष्टक_नव_आज्ञा(कूट, धारक, प्र१, प्र२, शून्यम्);
                यदि (मान_खंड == "शून्यम्") {
                    // शून्यम्
                } अन्यथा यदि (आरंभिक(मान_खंड, "संख्या:")) {
                    आज्ञा["स्थिरांक"] = अष्टक_पाठ_से_पूर्णांक(उपखंड(मान_खंड, लंबाई("संख्या:"), लंबाई(मान_खंड)));
                } अन्यथा यदि (आरंभिक(मान_खंड, "दशमलव:")) {
                    आज्ञा["स्थिरांक"] = अष्टक_पाठ_से_दशमलव(उपखंड(मान_खंड, लंबाई("दशमलव:"), लंबाई(मान_खंड)));
                } अन्यथा यदि (मान_खंड == "बूल:सत्य") {
                    आज्ञा["स्थिरांक"] = सत्य;
                } अन्यथा यदि (मान_खंड == "बूल:असत्य") {
                    आज्ञा["स्थिरांक"] = असत्य;
                } अन्यथा यदि (आरंभिक(मान_खंड, "पाठ:")) {
                    आज्ञा["स्थिरांक"] = उपखंड(मान_खंड, लंबाई("पाठ:"), लंबाई(मान_खंड));
                } अन्यथा {
                    आज्ञा["स्थिरांक"] = मान_खंड;
                }

                वर्तमान_आज्ञा_सूची = जोड़ें(वर्तमान_आज्ञा_सूची, आज्ञा);
            }
        }
        पइ = पइ + १;
    }

    यदि (वर्तमान_फलन != शून्यम्) {
        वर्तमान_फलन["आज्ञा_सूची"] = वर्तमान_आज्ञा_सूची;
        फलन_मानचित्र[वर्तमान_फलन["नाम"]] = वर्तमान_फलन;
    }

    प्रोग्राम["फलन_मानचित्र"] = फलन_मानचित्र;
    परत् प्रोग्राम;
}

कार्य अष्टक_सञ्चिका_सहेजें(शब्दकोश प्रोग्राम, पाठ मार्गः) {
    पाठ सामग्री = अष्टक_कंटेनर_संश्लेषण(प्रोग्राम);
    सञ्चिका_लिखतु(मार्गः, सामग्री);
}

कार्य अष्टक_सञ्चिका_लोड(पाठ मार्गः) {
    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        फेको "त्रुटिः बाइटकोड सञ्चिका न लब्धा: " + मार्गः;
    }
    पाठ सामग्री = सञ्चिका_पठतु(मार्गः);
    परत् अष्टक_कंटेनर_पार्स(सामग्री);
}

