// ------------------------------------------------------------
// आज्ञा-कूट (Opcodes)
// ------------------------------------------------------------
मान आज्ञा_विराम        = ०;   // निष्पादन अंत (Halt)
मान आज्ञा_स्थिर        = १;   // स्थिरांक मान धारक में (Load Const)
मान आज्ञा_चाल         = २;   // धारक प्रतिलिपि (Move/Copy)
मान आज्ञा_योग         = ३;   // अंकगणित + (Add)
मान आज्ञा_अंतर        = ४;   // अंकगणित - (Subtract)
मान आज्ञा_गुणा        = ५;   // अंकगणित * (Multiply)
मान आज्ञा_भाग         = ६;   // अंकगणित / (Divide)
मान आज्ञा_शेष         = ७;   // अंकगणित % (Modulo)
मान आज्ञा_सम          = ८;   // तुलना == (Equal)
मान आज्ञा_असम         = ९;   // तुलना != (Not Equal)
मान आज्ञा_लघु         = १०;  // तुलना < (Less Than)
मान आज्ञा_गुरु         = ११;  // तुलना > (Greater Than)
मान आज्ञा_लघुसम       = १२;  // तुलना <= (Less Equal)
मान आज्ञा_गुरुसम       = १३;  // तुलना >= (Greater Equal)
मान आज्ञा_और          = १४;  // तार्किक एवं बिटवार & (AND)
मान आज्ञा_या          = १५;  // तार्किक एवं बिटवार | (OR)
मान आज्ञा_नकार        = १६;  // तार्किक नकार ! (NOT)
मान आज्ञा_जाओ         = १७;  // बिना शर्त छलांग (Unconditional Jump)
मान आज्ञा_यदि_जाओ     = १८;  // सत्य (१) होने पर छलांग (Jump If True)
मान आज्ञा_यदि_न_जाओ   = १९;  // असत्य (०) होने पर छलांग (Jump If False)
मान आज्ञा_बुलाओ       = २०;  // फलन आह्वान (Call Function)
मान आज्ञा_वापस        = २१;  // फलन से प्रत्यावर्तन (Return)
मान आज्ञा_छापो        = २२;  // कंसोल मुद्रण (Print/लिखतु)
मान आज्ञा_नव_सूची     = २३;  // नवीन सूची (New List)
मान आज्ञा_नव_शब्दकोश  = २४;  // नवीन शब्दकोश (New Dict)
मान आज्ञा_पढ़_अनुक्रम  = २५;  // सूची/कोष/पाठ सूचकांक पठन (Index Read)
मान आज्ञा_लिख_अनुक्रम = २६;  // सूची/कोष सूचकांक लेखन (Index Write)
मान आज्ञा_लंबाई       = २७;  // लंबाई (Length)
मान आज्ञा_ऋणात्मक     = २८;  // ऋणात्मक एकक - (Unary Negate)
मान आज्ञा_पढ़_वैश्विक  = २९;  // वैश्विक चर पठन (Read Global)
मान आज्ञा_लिख_वैश्विक = ३०;  // वैश्विक चर लेखन (Write Global)

// ------------------------------------------------------------
// आज्ञा-नाम मानचित्र (Opcode Names)
// ------------------------------------------------------------
कार्य अष्टक_आज्ञा_नाम(संख्या कूट) {
    यदि (कूट == ०) { परत् "विराम"; }
    यदि (कूट == १) { परत् "स्थिर"; }
    यदि (कूट == २) { परत् "चाल"; }
    यदि (कूट == ३) { परत् "योग"; }
    यदि (कूट == ४) { परत् "अंतर"; }
    यदि (कूट == ५) { परत् "गुणा"; }
    यदि (कूट == ६) { परत् "भाग"; }
    यदि (कूट == ७) { परत् "शेष"; }
    यदि (कूट == ८) { परत् "सम"; }
    यदि (कूट == ९) { परत् "असम"; }
    यदि (कूट == १०) { परत् "लघु"; }
    यदि (कूट == ११) { परत् "गुरु"; }
    यदि (कूट == १२) { परत् "लघुसम"; }
    यदि (कूट == १३) { परत् "गुरुसम"; }
    यदि (कूट == १४) { परत् "और"; }
    यदि (कूट == १५) { परत् "या"; }
    यदि (कूट == १६) { परत् "नकार"; }
    यदि (कूट == १७) { परत् "जाओ"; }
    यदि (कूट == १८) { परत् "यदि_जाओ"; }
    यदि (कूट == १९) { परत् "यदि_न_जाओ"; }
    यदि (कूट == २०) { परत् "बुलाओ"; }
    यदि (कूट == २१) { परत् "वापस"; }
    यदि (कूट == २२) { परत् "छापो"; }
    यदि (कूट == २३) { परत् "नव_सूची"; }
    यदि (कूट == २४) { परत् "नव_शब्दकोश"; }
    यदि (कूट == २५) { परत् "पढ़_अनुक्रम"; }
    यदि (कूट == २६) { परत् "लिख_अनुक्रम"; }
    यदि (कूट == २७) { परत् "लंबाई"; }
    यदि (कूट == २८) { परत् "ऋणात्मक"; }
    यदि (कूट == २९) { परत् "पढ़_वैश्विक"; }
    यदि (कूट == ३०) { परत् "लिख_वैश्विक"; }
    परत् "अज्ञात";
}

// ------------------------------------------------------------
// द्वि-अंक संस्कृत कनवर्टर (Sanskrit Binary Bits: ० and १)
// ------------------------------------------------------------

// संख्या को ८ द्वि-अंकों वाले संस्कृत अष्टक ("०००००००१") में बदले
कार्य संख्या_से_द्विअंक_अष्टक(संख्या मानः) {
    मान परिणाम = "";
    संख्या इ = ७;
    यावत् (इ >= ०) {
        संख्या बिट = बिट_और(दक्षिण_सरक(मानः, इ), १);
        यदि (बिट == १) {
            परिणाम = परिणाम + "१";
        } अन्यथा {
            परिणाम = परिणाम + "०";
        }
        इ = इ - १;
    }
    परत् परिणाम;
}

// संस्कृत द्वि-अंक पाठ ("०००००००१") से पूर्णांक संख्या प्राप्त करें
कार्य द्विअंक_अष्टक_से_संख्या(पाठ द्विअंक_पाठ) {
    संख्या परिणामः = ०;
    संख्या ल = लंबाई(द्विअंक_पाठ);
    संख्या इ = ०;
    यावत् (इ < ल) {
        पाठ वर्ण = उपखंड(द्विअंक_पाठ, इ, इ + १);
        संख्या बिट = ०;
        यदि (वर्ण == "१" || वर्ण == "1") {
            बिट = १;
        }
        परिणामः = बिट_या(बाम_सरक(परिणामः, १), बिट);
        इ = इ + १;
    }
    परत् परिणामः;
}

// ------------------------------------------------------------
// आज्ञा-संरचना निर्माता (Instruction Builder)
// ------------------------------------------------------------
कार्य अष्टक_नव_आज्ञा(संख्या कूट, संख्या लक्ष्य, संख्या प्र१, संख्या प्र२, मान स्थिरांक_मान) {
    शब्दकोश आज्ञा = {};
    आज्ञा["कूट"] = कूट;
    आज्ञा["लक्ष्य"] = लक्ष्य;
    आज्ञा["प्र१"] = प्र१;
    आज्ञा["प्र२"] = प्र२;
    आज्ञा["स्थिरांक"] = स्थिरांक_मान;
    परत् आज्ञा;
}

