कार्य अष्टक_प्रोग्राम_पाठ_रूप(शब्दकोश प्रोग्राम) {
    पाठ फल = "# 🕉️ सूत्र अष्टक-संकेत संचिका (.सूत्रक)\n";
    फल = फल + "# संस्करण: १.०\n";
    फल = फल + "# लक्ष्य-यंत्र: सार्वत्रिक_आभासी_यंत्र (SVM)\n\n";
    शब्दकोश फनक्शा = प्रोग्राम["फलन_मानचित्र"];
    सूची फकुंजियाँ = कुंजियाँ(फनक्शा);
    संख्या फइ = ०;
    यावत् (फइ < लंबाई(फकुंजियाँ)) {
        पाठ फनाम = फकुंजियाँ[फइ];
        फल = फल + ".फलन " + फनाम + "\n";
        सूची फआज्ञा = फनक्शा[फनाम]["आज्ञा_सूची"];
        संख्या आइ = ०;
        यावत् (आइ < लंबाई(फआज्ञा)) {
            फल = फल + "  " + अष्टक_आज्ञा_विच्छेद(आइ, फआज्ञा[आइ]) + "\n";
            आइ = आइ + १;
        }
        फल = फल + "\n";
        फइ = फइ + १;
    }
    परत् फल;
}

