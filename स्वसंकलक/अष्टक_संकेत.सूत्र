// ------------------------------------------------------------
// देवनागरी अंक रूपांतरण उपयोगिता (Devanagari Numerals for Bytecode)
// ------------------------------------------------------------
कार्य अष्टक_संख्या_देवनागरी(संख्या संख्या_मान) {
    यदि (संख्या_मान == ०) { परत् "०"; }
    पाठ फल = "";
    संख्या मान_न = संख्या_मान;
    यदि (मान_न < ०) { मान_न = ० - मान_न; }
    यावत् (मान_न > ०) {
        संख्या शेष = मान_न % १०;
        यदि (शेष == ०) { फल = "०" + फल; }
        अन्यथा यदि (शेष == १) { फल = "१" + फल; }
        अन्यथा यदि (शेष == २) { फल = "२" + फल; }
        अन्यथा यदि (शेष == ३) { फल = "३" + फल; }
        अन्यथा यदि (शेष == ४) { फल = "४" + फल; }
        अन्यथा यदि (शेष == ५) { फल = "५" + फल; }
        अन्यथा यदि (शेष == ६) { फल = "६" + फल; }
        अन्यथा यदि (शेष == ७) { फल = "७" + फल; }
        अन्यथा यदि (शेष == ८) { फल = "८" + फल; }
        अन्यथा यदि (शेष == ९) { फल = "९" + फल; }
        मान_न = मान_न / १०;
    }
    यदि (संख्या_मान < ०) { फल = "-" + फल; }
    परत् फल;
}



कार्य अष्टक_मान_देवनागरी(मान मूल्य) {
    पाठ प्रकार_नाम = प्रकार(मूल्य);
    यदि (प्रकार_नाम == "संख्या") {
        परत् अष्टक_संख्या_देवनागरी(मूल्य);
    }
    पाठ स = "" + मूल्य;
    पाठ फल = "";
    संख्या इ = ०;
    यावत् (इ < लंबाई(स)) {
        पाठ च = उपखंड(स, इ, इ + १);
        यदि (च == "0") { फल = फल + "०"; }
        अन्यथा यदि (च == "1") { फल = फल + "१"; }
        अन्यथा यदि (च == "2") { फल = फल + "२"; }
        अन्यथा यदि (च == "3") { फल = फल + "३"; }
        अन्यथा यदि (च == "4") { फल = फल + "४"; }
        अन्यथा यदि (च == "5") { फल = फल + "५"; }
        अन्यथा यदि (च == "6") { फल = फल + "६"; }
        अन्यथा यदि (च == "7") { फल = फल + "७"; }
        अन्यथा यदि (च == "8") { फल = फल + "८"; }
        अन्यथा यदि (च == "9") { फल = फल + "९"; }
        अन्यथा { फल = फल + च; }
        इ = इ + १;
    }
    परत् फल;
}



कार्य अष्टक_आज्ञा_विच्छेद(संख्या पता, शब्दकोश आज्ञा) {
    संख्या कूट = आज्ञा["कूट"];
    पाठ द्विअंक = संख्या_से_द्विअंक_अष्टक(कूट);
    पाठ नाम = अष्टक_आज्ञा_नाम(कूट);
    
    पाठ पता_पाठ = अष्टक_संख्या_देवनागरी(पता);
    यावत् (लंबाई(पता_पाठ) < ४) {
        पता_पाठ = "०" + पता_पाठ;
    }
    
    मान परिणाम = "[पता " + पता_पाठ + "] अष्टक: " + द्विअंक + " (" + नाम + ")";
    
    यदि (कूट == आज्ञा_स्थिर) {
        परिणाम = परिणाम + " धारक: क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]) + " मान: " + अष्टक_मान_देवनागरी(आज्ञा["स्थिरांक"]);
    } अन्यथा यदि (कूट == आज्ञा_चाल) {
        परिणाम = परिणाम + " धारक: क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + " → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_योग || कूट == आज्ञा_अंतर || कूट == आज्ञा_गुणा || कूट == आज्ञा_भाग || कूट == आज्ञा_शेष || कूट == आज्ञा_सम || कूट == आज्ञा_असम || कूट == आज्ञा_लघु || कूट == आज्ञा_गुरु || कूट == आज्ञा_लघुसम || कूट == आज्ञा_गुरुसम || कूट == आज्ञा_और || कूट == आज्ञा_या) {
        परिणाम = परिणाम + " धारक: क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + ", क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र२"]) + " → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_छापो) {
        परिणाम = परिणाम + " धारक: क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]);
    } अन्यथा यदि (कूट == आज्ञा_जाओ) {
        पाठ लक्ष_पता = अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]);
        यावत् (लंबाई(लक्ष_पता) < ४) { लक्ष_पता = "०" + लक्ष_पता; }
        परिणाम = परिणाम + " लक्ष्य-पता: " + लक्ष_पता;
    } अन्यथा यदि (कूट == आज्ञा_यदि_जाओ || कूट == आज्ञा_यदि_न_जाओ) {
        पाठ लक्ष_पता = अष्टक_संख्या_देवनागरी(आज्ञा["प्र२"]);
        यावत् (लंबाई(लक्ष_पता) < ४) { लक्ष_पता = "०" + लक्ष_पता; }
        परिणाम = परिणाम + " शर्त: क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + " लक्ष्य-पता: " + लक्ष_पता;
    } अन्यथा यदि (कूट == आज्ञा_बुलाओ) {
        परिणाम = परिणाम + " फलन: " + आज्ञा["स्थिरांक"] + " तर्क-संख्या: " + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + " → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_वापस) {
        यदि (आज्ञा["प्र१"] >= ०) {
            परिणाम = परिणाम + " मान: क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]);
        }
    } अन्यथा यदि (कूट == आज्ञा_नव_सूची || कूट == आज्ञा_नव_शब्दकोश) {
        परिणाम = परिणाम + " → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_पढ़_अनुक्रम) {
        परिणाम = परिणाम + " क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + "[क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र२"]) + "] → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_लिख_अनुक्रम) {
        परिणाम = परिणाम + " क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + "[क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र२"]) + "] = क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_लंबाई) {
        परिणाम = परिणाम + " लंबाई(क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + ") → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    } अन्यथा यदि (कूट == आज्ञा_ऋणात्मक) {
        परिणाम = परिणाम + " -क" + अष्टक_संख्या_देवनागरी(आज्ञा["प्र१"]) + " → क" + अष्टक_संख्या_देवनागरी(आज्ञा["लक्ष्य"]);
    }
    
    परत् परिणाम;
}

