// मूल_संकलन_ir.सूत्र — मूल संकलन ड्राइवर (IR backend)
// यह मूल_संकलन.सूत्र जैसा ही है, पर चरण 3 में पुराने मूल_सर्जक की जगह
// नया IR pipeline: AST → निम्नक → अनुकूलक → रजि_नियतक → उत्सर्जक → .s
// (मूल_सर्जक import नहीं — इससे पुराना O(n²) codegen हट जाता है।)

आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "रजि_नियतक.सूत्र";
आयात "मूल_उत्सर्जक.सूत्र";

// मूल_सर्जक से (जो अब import नहीं होता) — ASCII-कोड सूची से पाठ
कार्य अक्षर_सूची_से_पाठ(सूची कोड्स) {
    मान परिणाम = "";
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(कोड्स)) {
        परिणाम = परिणाम + अक्षर_निर्माण(कोड्स[सूचक]);
        सूचक = सूचक + 1;
    }
    परत् परिणाम;
}

कार्य मुख्य() {
    मान मार्गः = "";
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) >= 2) {
        मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - 1];
    } अन्यथा {
        लिखतु("त्रुटिः — सञ्चिका मार्गः न निर्दिष्टः।");
        परत्;
    }

    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        लिखतु("त्रुटिः — सञ्चिका न प्राप्ता: " + मार्गः);
        परत्;
    }

    मान स्रोत_पाठ = सञ्चिका_पठतु(मार्गः);
    लिखतु("=== मूल संकलन (IR) ===");
    लिखतु("सञ्चिका: " + मार्गः);

    // NOTE: प्रयत्न/पकड़ो अभी IR path में नहीं — bootstrap के लिए सीधे pipeline।
        // चरण 1: पद विच्छेदन
        लिखतु("1. पद_विच्छेदन...");
        सूची पद_सूची = पद_विच्छेदन(स्रोत_पाठ);
        लिखतु("   पदों की संख्या: " + लंबाई(पद_सूची));

        // चरण 2: विश्लेषण
        लिखतु("2. विश्लेषण...");
        शब्दकोश अवस्था = {};
        अवस्था["पद_सूची"] = पद_सूची;
        अवस्था["अनुक्रमणिका"] = 0;
        अवस्था["कुल_पद"] = लंबाई(पद_सूची);
        शब्दकोश आयातित_सञ्चिकाः = {};
        शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित_सञ्चिकाः, मार्गः);
        लिखतु("   विश्लेषण संपन्नम्।");

        // चरण 2.5: सार्थक विश्लेषण
        लिखतु("2.5 सार्थक_विश्लेषण...");
        मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
        लिखतु("    सार्थक_विश्लेषण संपन्नम्।");

        // चरण 3: IR pipeline — निम्नक → अनुकूलक → उत्सर्जक
        लिखतु("3. IR उत्पन्न (निम्नक → अनुकूलक → रजि_नियतक → उत्सर्जक)...");
        शब्दकोश एकक = निम्नक_एकक(प्रोग्राम_नोड);
        अनुकूलक_एकक(एकक);
        मान संयोजन_कोड = उत्सर्जक_एकक(एकक);

        // चरण 4: .s सञ्चिका लिखो — "sutra_native_temp.s"
        मान स_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,115]);
        सञ्चिका_लिखतु(स_मार्ग, संयोजन_कोड);
        लिखतु("4. सञ्चिका: " + स_मार्ग);

        // चरण 5: as.exe — .s → .o
        लिखतु("5. संयोजन...");
        मान ओ_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,111]);
        मान संयोजक_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,97,115,46,101,120,101,32,45,111,32]) + ओ_मार्ग + " " + स_मार्ग;
        कमांड_चलाओ(संयोजक_कमांड);

        यदि (न सञ्चिका_अस्ति(ओ_मार्ग)) {
            प्रक्षेपः "त्रुटिः — संयोजन विफल।";
        }
        लिखतु("   संयोजन संपन्नम्।");

        // चरण 5.5: OS-तल (तल.s) → sutra_floor.o
        मान तल_स्रोत = "स्वसंकलक/निर्माण/तल.s";
        यदि (न सञ्चिका_अस्ति(तल_स्रोत)) { तल_स्रोत = "निर्माण/तल.s"; }
        यदि (सञ्चिका_अस्ति(तल_स्रोत)) {
            मान तल_पाठ = सञ्चिका_पठतु(तल_स्रोत);
            मान तल_अस्थायी = अक्षर_सूची_से_पाठ([115,102,108,111,111,114,95,116,101,109,112,46,115]);
            सञ्चिका_लिखतु(तल_अस्थायी, तल_पाठ);
            मान तल_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,97,115,46,101,120,101,32,45,111,32,115,117,116,114,97,95,102,108,111,111,114,46,111,32]) + तल_अस्थायी;
            कमांड_चलाओ(तल_कमांड);
        }

        // चरण 5.6: सूत्र-रनटाइम मॉड्यूल (मूल_रनटाइम.s) → sutra_srt.o
        मान रट_स्रोत = "स्वसंकलक/निर्माण/मूल_रनटाइम.s";
        यदि (न सञ्चिका_अस्ति(रट_स्रोत)) { रट_स्रोत = "निर्माण/मूल_रनटाइम.s"; }
        यदि (सञ्चिका_अस्ति(रट_स्रोत)) {
            मान रट_पाठ = सञ्चिका_पठतु(रट_स्रोत);
            मान रट_अस्थायी = अक्षर_सूची_से_पाठ([115,114,116,95,116,101,109,112,46,115]);
            सञ्चिका_लिखतु(रट_अस्थायी, रट_पाठ);
            मान रट_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,97,115,46,101,120,101,32,45,111,32,115,117,116,114,97,95,115,114,116,46,111,32]) + रट_अस्थायी;
            कमांड_चलाओ(रट_कमांड);
        }

        // चरण 5.7: आवंटक मॉड्यूल (मूल_आवंटक.s) → sutra_alloc.o
        मान आव_स्रोत = "स्वसंकलक/निर्माण/मूल_आवंटक.s";
        यदि (न सञ्चिका_अस्ति(आव_स्रोत)) { आव_स्रोत = "निर्माण/मूल_आवंटक.s"; }
        यदि (सञ्चिका_अस्ति(आव_स्रोत)) {
            मान आव_पाठ = सञ्चिका_पठतु(आव_स्रोत);
            मान आव_अस्थायी = अक्षर_सूची_से_पाठ([97,108,108,111,99,95,116,101,109,112,46,115]);
            सञ्चिका_लिखतु(आव_अस्थायी, आव_पाठ);
            मान आव_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,97,115,46,101,120,101,32,45,111,32,115,117,116,114,97,95,97,108,108,111,99,46,111,32]) + आव_अस्थायी;
            कमांड_चलाओ(आव_कमांड);
        }

        // चरण 6: लिंक
        लिखतु("6. लिंक...");
        मान ई_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,101,120,101]);
        मान तल_कड़ी = "";
        यदि (सञ्चिका_अस्ति("sutra_floor.o")) { तल_कड़ी = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,102,108,111,111,114,46,111,32]); }
        मान रट_कड़ी = "";
        यदि (सञ्चिका_अस्ति("sutra_srt.o")) { रट_कड़ी = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,115,114,116,46,111,32]); }
        मान आव_कड़ी = "";
        यदि (सञ्चिका_अस्ति("sutra_alloc.o")) { आव_कड़ी = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,97,108,108,111,99,46,111,32]); }
        मान लिंकर_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,103,99,99,46,101,120,101,32,45,109,54,52,32]) + ओ_मार्ग + अक्षर_सूची_से_पाठ([32,115,117,116,114,97,95,114,117,110,116,105,109,101,95,112,114,101,98,117,105,108,116,46,111,32]) + आव_कड़ी + रट_कड़ी + तल_कड़ी + अक्षर_सूची_से_पाठ([45,108,109,32,45,108,115,104,101,108,108,51,50,32,45,111,32]) + ई_मार्ग;
        कमांड_चलाओ(लिंकर_कमांड);

        यदि (न सञ्चिका_अस्ति(ई_मार्ग)) {
            प्रक्षेपः "त्रुटिः — लिंक विफल।";
        }
        लिखतु("   लिंक संपन्नम्।");

        // चरण 7: अंतिम नाम पर प्रतिलिपि
        मान अंतिम_नाम = मार्गः + अक्षर_सूची_से_पाठ([95,110,97,116,105,118,101,46,101,120,101]);
        मान प्रतिलिपि_कमांड = अक्षर_सूची_से_पाठ([99,109,100,32,47,99,32,99,111,112,121,32,47,121,32]) + ई_मार्ग + " " + अक्षर_निर्माण(34) + अंतिम_नाम + अक्षर_निर्माण(34);
        कमांड_चलाओ(प्रतिलिपि_कमांड);
        लिखतु("7. अंतिम: " + अंतिम_नाम);

        लिखतु("=== मूल संकलन सफल! ===");
}
