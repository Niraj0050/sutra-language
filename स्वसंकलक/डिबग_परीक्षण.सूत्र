कार्य मुख्य() {
    लिखतु("प्रारंभ");
    मान तर्काः_सूची = तर्काः();
    लिखतु("तर्काः प्राप्तः: " + लंबाई(तर्काः_सूची));
    यदि (लंबाई(तर्काः_सूची) >= 2) {
        मान मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - 1];
        लिखतु("मार्गः: " + मार्गः);
        यदि (सञ्चिका_अस्ति(मार्गः)) {
            लिखतु("सञ्चिका मिली!");
            मान विषय = सञ्चिका_पठतु(मार्गः);
            लिखतु("लंबाई: " + लंबाई(विषय));
        } अन्यथा {
            लिखतु("सञ्चिका नहीं मिली");
        }
    } अन्यथा {
        लिखतु("कोई तर्क नहीं");
    }
    लिखतु("समाप्त");
}
