// रजि_नियतक.सूत्र — रैखिक-स्कैन रजिस्टर नियतन (linear-scan regalloc)  [Phase 1d]
// ============================================================
// मध्यम IR (SSA, अनुकूलक के बाद) लेकर हर मान को एक physical रजिस्टर
// या ढेर-स्लॉट देता है। परिणाम फलन में संग्रहीत:
//   फलन["रजि_नियतन"] : मान-id -> { "प्रकार":"रजि", "नाम":"r12" }
//                                  या { "प्रकार":"ढेर", "ऑफसेट": N }
//   फलन["ढेर_आकार"]      : bytes (16-संरेखित) — spill slots के लिए
//   फलन["प्रयुक्त_सुरक्षित"]: [रजि-नाम...] — prologue में push करने हैं
//
// रजिस्टर pool: केवल callee-saved (rbx rsi rdi r12 r13 r14 r15)।
// इससे calls मानों को clobber नहीं करतीं (volatile = emitter का scratch)।
//
// अभी संकलक में wire नहीं — रजि_नियतक_परीक्षण.सूत्र से जाँचा।
// ============================================================

आयात "मध्यम.सूत्र";
आयात "अनुकूलक.सूत्र";   // अनु_उत्तराधिकारी / अनु_विपक्रम / अनु_खंड_खोजें


कार्य रजि_पूल() {
    परत् ["rbx", "rsi", "rdi", "r12", "r13", "r14", "r15"];
}


// ============================================================
// 1. निर्देश-क्रमांकन (RPO खंड-क्रम में हर बिंदु को स्थान)
// ============================================================
// लौटाता है: { "स्थान": {निर्देश-id -> pos}, "खंड_आरंभ": {label -> pos},
//              "खंड_अंत": {label -> pos}, "अंतिम": pos, "क्रम": [label...] }
कार्य रजि_क्रमांकन(शब्दकोश फलन) {
    सूची क्रम = अनु_विपक्रम(फलन);
    शब्दकोश स्थान = {};
    शब्दकोश खंड_आरंभ = {};
    शब्दकोश खंड_अंत = {};
    संख्या पद = 0;
    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        पाठ लेबल = क्रम[कक];
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
        खंड_आरंभ[लेबल] = पद;
        // फाई सब एक ही बिंदु (खंड-आरंभ) पर
        संख्या इक = 0;
        यावत् (इक < लंबाई(खंड["फाई"])) {
            स्थान[खंड["फाई"][इक]["आईडी"]] = पद;
            इक = इक + 1;
        }
        संख्या फइ = 0;
        यावत् (फइ < लंबाई(खंड["फाई"])) {
            खंड["फाई"][फइ]["_pos"] = पद;
            फइ = फइ + 1;
        }
        पद = पद + 1;
        इक = 0;
        यावत् (इक < लंबाई(खंड["निर्देश"])) {
            खंड["निर्देश"][इक]["_pos"] = पद;   // हर निर्देश (side-effect भी)
            यदि (खंड["निर्देश"][इक]["आईडी"] >= 1) {
                स्थान[खंड["निर्देश"][इक]["आईडी"]] = पद;
            }
            पद = पद + 1;
            इक = इक + 1;
        }
        यदि (खंड["अंत"] != शून्यम्) { खंड["अंत"]["_pos"] = पद; }
        खंड_अंत[लेबल] = पद;   // terminator का स्थान
        पद = पद + 1;
        कक = कक + 1;
    }
    शब्दकोश परिणाम = {};
    परिणाम["स्थान"] = स्थान;
    परिणाम["खंड_आरंभ"] = खंड_आरंभ;
    परिणाम["खंड_अंत"] = खंड_अंत;
    परिणाम["अंतिम"] = पद;
    परिणाम["क्रम"] = क्रम;
    परत् परिणाम;
}


// ============================================================
// 2. सजीवता (liveness) — पिछड़ा fixpoint
// ============================================================
// निर्देश के operand मान इकट्ठा करो
कार्य रजि_उपयोग_मान(शब्दकोश निर्देश) {
    सूची फल = [];
    सूची संच = निर्देश["संचालक"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(संच)) {
        यदि (संच[इक] >= 1) { फल = जोड़ें(फल, संच[इक]); }
        इक = इक + 1;
    }
    परत् फल;
}

कार्य रजि_सजीवता(शब्दकोश फलन, सूची क्रम) {
    // उपयोग[B] = B में upward-exposed मान; परिभाषा[B] = B में परिभाषित
    शब्दकोश उपयोग = {};
    शब्दकोश परिभाषा = {};
    // फाई-योगदान: pred P के live-out में जोड़ने हेतु — { "P" -> [मान...] }
    शब्दकोश फाई_योगदान = {};

    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        पाठ लेबल = क्रम[कक];
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
        शब्दकोश प_सेट = {};   // इस खंड में परिभाषित (id -> सत्य)
        शब्दकोश उ_सूची = {};   // upward-exposed (id -> सत्य)

        // फाई results परिभाषित; फाई operands pred के योगदान
        संख्या इक = 0;
        यावत् (इक < लंबाई(खंड["फाई"])) {
            शब्दकोश फ = खंड["फाई"][इक];
            प_सेट[फ["आईडी"]] = सत्य;
            सूची स्रोत = फ["अंश"]["स्रोत"];
            संख्या जक = 0;
            यावत् (जक < लंबाई(स्रोत)) {
                पाठ पप = स्रोत[जक][0];
                संख्या मव = स्रोत[जक][1];
                यदि (मव >= 1) {
                    मान सूची_य = फाई_योगदान[पप];
                    यदि (सूची_य == शून्यम्) { सूची_य = []; }
                    फाई_योगदान[पप] = जोड़ें(सूची_य, मव);
                }
                जक = जक + 1;
            }
            इक = इक + 1;
        }

        // निर्देश: operand जो अभी तक परिभाषित नहीं → upward-exposed
        इक = 0;
        यावत् (इक < लंबाई(खंड["निर्देश"])) {
            शब्दकोश निर्देश = खंड["निर्देश"][इक];
            सूची उम = रजि_उपयोग_मान(निर्देश);
            संख्या जक = 0;
            यावत् (जक < लंबाई(उम)) {
                यदि (प_सेट[उम[जक]] != सत्य) { उ_सूची[उम[जक]] = सत्य; }
                जक = जक + 1;
            }
            यदि (निर्देश["आईडी"] >= 1) { प_सेट[निर्देश["आईडी"]] = सत्य; }
            इक = इक + 1;
        }
        // terminator के operand
        यदि (खंड["अंत"] != शून्यम्) {
            सूची उम = रजि_उपयोग_मान(खंड["अंत"]);
            संख्या जक = 0;
            यावत् (जक < लंबाई(उम)) {
                यदि (प_सेट[उम[जक]] != सत्य) { उ_सूची[उम[जक]] = सत्य; }
                जक = जक + 1;
            }
        }

        उपयोग[लेबल] = रजि_सेट_सूची(उ_सूची);
        परिभाषा[लेबल] = रजि_सेट_सूची(प_सेट);
        कक = कक + 1;
    }

    // fixpoint: सजीव_अंदर[B] = उपयोग[B] ∪ (सजीव_बाहर[B] − परिभाषा[B])
    //           सजीव_बाहर[B] = ∪ सजीव_अंदर[succ]  ∪  फाई_योगदान[B]
    शब्दकोश सजीव_अंदर = {};
    शब्दकोश सजीव_बाहर = {};
    कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        सजीव_अंदर[क्रम[कक]] = {};
        सजीव_बाहर[क्रम[कक]] = {};
        कक = कक + 1;
    }

    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        संख्या इक = लंबाई(क्रम) - 1;
        यावत् (इक >= 0) {
            पाठ लेबल = क्रम[इक];
            शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
            // out = ∪ succ.in  ∪  फाई_योगदान[लेबल]
            शब्दकोश नया_बाहर = {};
            सूची उत्त = अनु_उत्तराधिकारी(खंड);
            संख्या जक = 0;
            यावत् (जक < लंबाई(उत्त)) {
                रजि_सेट_मिलाओ(नया_बाहर, सजीव_अंदर[उत्त[जक]]);
                जक = जक + 1;
            }
            मान यो = फाई_योगदान[लेबल];
            यदि (यो != शून्यम्) {
                जक = 0;
                यावत् (जक < लंबाई(यो)) { नया_बाहर[यो[जक]] = सत्य; जक = जक + 1; }
            }
            // in = उपयोग ∪ (out − परिभाषा)
            शब्दकोश नया_अंदर = {};
            सूची उ = उपयोग[लेबल];
            जक = 0;
            यावत् (जक < लंबाई(उ)) { नया_अंदर[उ[जक]] = सत्य; जक = जक + 1; }
            सूची ओके = रजि_सेट_सूची(नया_बाहर);
            शब्दकोश प_सेट = रजि_सूची_सेट(परिभाषा[लेबल]);
            जक = 0;
            यावत् (जक < लंबाई(ओके)) {
                यदि (प_सेट[ओके[जक]] != सत्य) { नया_अंदर[ओके[जक]] = सत्य; }
                जक = जक + 1;
            }
            यदि (रजि_सेट_भिन्न(नया_अंदर, सजीव_अंदर[लेबल]) || रजि_सेट_भिन्न(नया_बाहर, सजीव_बाहर[लेबल])) {
                बदला = सत्य;
            }
            सजीव_अंदर[लेबल] = नया_अंदर;
            सजीव_बाहर[लेबल] = नया_बाहर;
            इक = इक - 1;
        }
    }

    शब्दकोश परिणाम = {};
    परिणाम["in"] = सजीव_अंदर;
    परिणाम["out"] = सजीव_बाहर;
    परिणाम["उपयोग"] = उपयोग;
    परत् परिणाम;
}

कार्य रजि_सेट_सूची(शब्दकोश सेट) {
    सूची फल = [];
    सूची कुं = कुंजियाँ(सेट);
    संख्या इक = 0;
    यावत् (इक < लंबाई(कुं)) {
        यदि (सेट[कुं[इक]] == सत्य) { फल = जोड़ें(फल, कुं[इक]); }
        इक = इक + 1;
    }
    परत् फल;
}
कार्य रजि_सूची_सेट(सूची सू) {
    शब्दकोश स = {};
    संख्या इक = 0;
    यावत् (इक < लंबाई(सू)) { स[सू[इक]] = सत्य; इक = इक + 1; }
    परत् स;
}
कार्य रजि_सेट_मिलाओ(शब्दकोश लक्ष्य, शब्दकोश स्रोत) {
    सूची कुं = कुंजियाँ(स्रोत);
    संख्या इक = 0;
    यावत् (इक < लंबाई(कुं)) {
        यदि (स्रोत[कुं[इक]] == सत्य) { लक्ष्य[कुं[इक]] = सत्य; }
        इक = इक + 1;
    }
    परत् 0;
}
कार्य रजि_सेट_भिन्न(शब्दकोश अ, शब्दकोश ब) {
    यदि (लंबाई(रजि_सेट_सूची(अ)) != लंबाई(रजि_सेट_सूची(ब))) { परत् सत्य; }
    सूची कुं = रजि_सेट_सूची(अ);
    संख्या इक = 0;
    यावत् (इक < लंबाई(कुं)) {
        यदि (ब[कुं[इक]] != सत्य) { परत् सत्य; }
        इक = इक + 1;
    }
    परत् असत्य;
}


// ============================================================
// 3. सजीव अंतराल
// ============================================================
// हर मान: [आरंभ, अंत]  (स्थान-संख्या)
कार्य रजि_अंतराल(शब्दकोश फलन, शब्दकोश क्र, शब्दकोश सज) {
    शब्दकोश स्थान = क्र["स्थान"];
    शब्दकोश खंड_आरंभ = क्र["खंड_आरंभ"];
    शब्दकोश खंड_अंत = क्र["खंड_अंत"];
    सूची क्रम = क्र["क्रम"];
    शब्दकोश सजीव_बाहर = सज["out"];

    शब्दकोश आरंभ = {};
    शब्दकोश अंत = {};

    // पैरामीटर — स्थान 0 पर परिभाषित
    सूची पैरा = फलन["पैरामीटर"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(पैरा)) {
        आरंभ[पैरा[इक]["आईडी"]] = 0;
        अंत[पैरा[इक]["आईडी"]] = 0;
        इक = इक + 1;
    }

    // परिभाषाएँ
    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        पाठ लेबल = क्रम[कक];
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
        इक = 0;
        यावत् (इक < लंबाई(खंड["फाई"])) {
            संख्या आ = खंड["फाई"][इक]["आईडी"];
            आरंभ[आ] = खंड_आरंभ[लेबल];
            यदि (अंत[आ] == शून्यम्) { अंत[आ] = खंड_आरंभ[लेबल]; }
            इक = इक + 1;
        }
        इक = 0;
        यावत् (इक < लंबाई(खंड["निर्देश"])) {
            संख्या आ = खंड["निर्देश"][इक]["आईडी"];
            यदि (आ >= 1) {
                आरंभ[आ] = स्थान[आ];
                यदि (अंत[आ] == शून्यम्) { अंत[आ] = स्थान[आ]; }
            }
            इक = इक + 1;
        }
        कक = कक + 1;
    }

    // उपयोग → अंत बढ़ाओ
    कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        पाठ लेबल = क्रम[कक];
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
        // सजीव_बाहर के मान → खंड-अंत तक जीवित
        सूची लो = रजि_सेट_सूची(सजीव_बाहर[लेबल]);
        इक = 0;
        यावत् (इक < लंबाई(लो)) {
            रजि_अंत_बढ़ाओ(अंत, लो[इक], खंड_अंत[लेबल]);
            इक = इक + 1;
        }
        // निर्देश-operand उपयोग
        इक = 0;
        यावत् (इक < लंबाई(खंड["निर्देश"])) {
            शब्दकोश निर्देश = खंड["निर्देश"][इक];
            सूची उम = रजि_उपयोग_मान(निर्देश);
            संख्या जक = 0;
            यावत् (जक < लंबाई(उम)) {
                रजि_अंत_बढ़ाओ(अंत, उम[जक], निर्देश["_pos"]);
                जक = जक + 1;
            }
            इक = इक + 1;
        }
        // terminator-operand उपयोग
        यदि (खंड["अंत"] != शून्यम्) {
            सूची उम = रजि_उपयोग_मान(खंड["अंत"]);
            संख्या जक = 0;
            यावत् (जक < लंबाई(उम)) {
                रजि_अंत_बढ़ाओ(अंत, उम[जक], खंड_अंत[लेबल]);
                जक = जक + 1;
            }
        }
        // फाई operand → उस pred के खंड-अंत तक जीवित
        इक = 0;
        यावत् (इक < लंबाई(खंड["फाई"])) {
            सूची स्रोत = खंड["फाई"][इक]["अंश"]["स्रोत"];
            संख्या जक = 0;
            यावत् (जक < लंबाई(स्रोत)) {
                पाठ पप = स्रोत[जक][0];
                संख्या मव = स्रोत[जक][1];
                यदि (मव >= 1 && खंड_अंत[पप] != शून्यम्) {
                    रजि_अंत_बढ़ाओ(अंत, मव, खंड_अंत[पप]);
                }
                जक = जक + 1;
            }
            इक = इक + 1;
        }
        कक = कक + 1;
    }

    शब्दकोश परिणाम = {};
    परिणाम["आरंभ"] = आरंभ;
    परिणाम["अंत"] = अंत;
    परत् परिणाम;
}

कार्य रजि_अंत_बढ़ाओ(शब्दकोश अंत, संख्या मव, संख्या स्थान) {
    मान वर्त = अंत[मव];
    यदि (वर्त == शून्यम् || स्थान > वर्त) { अंत[मव] = स्थान; }
    परत् 0;
}


// ============================================================
// 4. रैखिक स्कैन
// ============================================================
कार्य रजि_रैखिक_स्कैन(शब्दकोश फलन, शब्दकोश अंतराल) {
    शब्दकोश आरंभ = अंतराल["आरंभ"];
    शब्दकोश अंत = अंतराल["अंत"];

    // मान-सूची, आरंभ से sorted
    सूची मान_सूची = कुंजियाँ(आरंभ);
    मान_सूची = रजि_क्रमबद्ध(मान_सूची, आरंभ);

    सूची पूल = रजि_पूल();
    शब्दकोश मुक्त = {};   // रजि-नाम -> सत्य (उपलब्ध)
    संख्या इक = 0;
    यावत् (इक < लंबाई(पूल)) { मुक्त[पूल[इक]] = सत्य; इक = इक + 1; }

    शब्दकोश नियतन = {};       // मान-id -> {प्रकार, ...}
    शब्दकोश प्रयुक्त = {};      // रजि-नाम -> सत्य (कभी इस्तेमाल हुआ)
    सूची सक्रिय = [];          // [[मान-id, रजि-नाम], ...] — अंत से sorted
    संख्या ढेर_अगला = 0;       // अगला spill स्लॉट offset (16 के गुणक)

    इक = 0;
    यावत् (इक < लंबाई(मान_सूची)) {
        संख्या मव = मान_सूची[इक];
        संख्या इस_आरंभ = आरंभ[मव];

        // समाप्त अंतराल हटाओ
        सूची नया_सक्रिय = [];
        संख्या जक = 0;
        यावत् (जक < लंबाई(सक्रिय)) {
            सूची यु = सक्रिय[जक];
            यदि (अंत[यु[0]] < इस_आरंभ) {
                मुक्त[यु[1]] = सत्य;   // रजिस्टर वापस
            } अन्यथा {
                नया_सक्रिय = जोड़ें(नया_सक्रिय, यु);
            }
            जक = जक + 1;
        }
        सक्रिय = नया_सक्रिय;

        // मुक्त रजिस्टर?
        पाठ चुना = रजि_कोई_मुक्त(पूल, मुक्त);
        यदि (चुना != "") {
            मुक्त[चुना] = असत्य;
            प्रयुक्त[चुना] = सत्य;
            शब्दकोश निधि = {};
            निधि["प्रकार"] = "रजि";
            निधि["नाम"] = चुना;
            नियतन[मव] = निधि;
            सक्रिय = रजि_सक्रिय_डालो(सक्रिय, [मव, चुना], अंत);
        } अन्यथा {
            // spill: सक्रिय में सबसे-दूर-अंत वाला बनाम यह
            संख्या अंतिम_सूचक = लंबाई(सक्रिय) - 1;
            सूची दूर = सक्रिय[अंतिम_सूचक];
            यदि (अंत[दूर[0]] > अंत[मव]) {
                // दूर वाले को spill करो, उसका रजि इसे दो
                शब्दकोश निधि = {};
                निधि["प्रकार"] = "रजि";
                निधि["नाम"] = दूर[1];
                नियतन[मव] = निधि;
                शब्दकोश स्न = {};
                स्न["प्रकार"] = "ढेर";
                स्न["ऑफसेट"] = ढेर_अगला;
                ढेर_अगला = ढेर_अगला + 16;
                नियतन[दूर[0]] = स्न;
                सक्रिय = रजि_सक्रिय_हटाओ(सक्रिय, दूर[0]);
                सक्रिय = रजि_सक्रिय_डालो(सक्रिय, [मव, दूर[1]], अंत);
            } अन्यथा {
                शब्दकोश स्न = {};
                स्न["प्रकार"] = "ढेर";
                स्न["ऑफसेट"] = ढेर_अगला;
                ढेर_अगला = ढेर_अगला + 16;
                नियतन[मव] = स्न;
            }
        }
        इक = इक + 1;
    }

    // callee-saved जो इस्तेमाल हुए
    सूची सुरक्षित = [];
    इक = 0;
    यावत् (इक < लंबाई(पूल)) {
        यदि (प्रयुक्त[पूल[इक]] == सत्य) { सुरक्षित = जोड़ें(सुरक्षित, पूल[इक]); }
        इक = इक + 1;
    }

    फलन["रजि_नियतन"] = नियतन;
    फलन["ढेर_आकार"] = ढेर_अगला;
    फलन["प्रयुक्त_सुरक्षित"] = सुरक्षित;
    परत् 0;
}

कार्य रजि_कोई_मुक्त(सूची पूल, शब्दकोश मुक्त) {
    संख्या इक = 0;
    यावत् (इक < लंबाई(पूल)) {
        यदि (मुक्त[पूल[इक]] == सत्य) { परत् पूल[इक]; }
        इक = इक + 1;
    }
    परत् "";
}

कार्य रजि_सक्रिय_डालो(सूची सक्रिय, सूची नया, शब्दकोश अंत) {
    // अंत बढ़ते क्रम में insert
    सूची फल = [];
    मान डाला = असत्य;
    संख्या इक = 0;
    यावत् (इक < लंबाई(सक्रिय)) {
        यदि (न डाला && अंत[नया[0]] < अंत[सक्रिय[इक][0]]) {
            फल = जोड़ें(फल, नया);
            डाला = सत्य;
        }
        फल = जोड़ें(फल, सक्रिय[इक]);
        इक = इक + 1;
    }
    यदि (न डाला) { फल = जोड़ें(फल, नया); }
    परत् फल;
}

कार्य रजि_सक्रिय_हटाओ(सूची सक्रिय, संख्या मव) {
    सूची फल = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(सक्रिय)) {
        यदि (सक्रिय[इक][0] != मव) { फल = जोड़ें(फल, सक्रिय[इक]); }
        इक = इक + 1;
    }
    परत् फल;
}

कार्य रजि_क्रमबद्ध(सूची कुंजियाँ_सू, शब्दकोश कुंजी) {
    // सरल insertion sort — कुंजी[k] बढ़ते क्रम में
    सूची फल = [];
    संख्या इक = 0;
    यावत् (इक < लंबाई(कुंजियाँ_सू)) {
        संख्या क = कुंजियाँ_सू[इक];
        सूची नया = [];
        मान डाला = असत्य;
        संख्या जक = 0;
        यावत् (जक < लंबाई(फल)) {
            यदि (न डाला && कुंजी[क] < कुंजी[फल[जक]]) {
                नया = जोड़ें(नया, क);
                डाला = सत्य;
            }
            नया = जोड़ें(नया, फल[जक]);
            जक = जक + 1;
        }
        यदि (न डाला) { नया = जोड़ें(नया, क); }
        फल = नया;
        इक = इक + 1;
    }
    परत् फल;
}


// ============================================================
// चालक
// ============================================================
कार्य रजि_नियतक_कार्य(शब्दकोश फलन) {
    शब्दकोश क्र = रजि_क्रमांकन(फलन);
    शब्दकोश सज = रजि_सजीवता(फलन, क्र["क्रम"]);
    शब्दकोश अंतराल = रजि_अंतराल(फलन, क्र, सज);
    रजि_रैखिक_स्कैन(फलन, अंतराल);
    रजि_जीसी_जड़ें(फलन, क्र, अंतराल);
    परत् 0;
}

// ============================================================
// 5. GC जड़ें (Phase 1f) — कौन-से मान call के आर-पार जीवित रहते हैं?
// ============================================================
// GC-टैप्ड (पाठ/सूची/शब्दकोश/वस्तु/मान) मान जिसका जीवन-अंतराल किसी
// सुरक्षा-बिंदु (allocate/collect करने वाला call) को घेरता है — उसे एक
// समर्पित frame-स्लॉट चाहिए जिसे संग्राहक scan करे। emitter उस स्लॉट को
// prologue में gc_roots[] में डालता है, def के तुरंत बाद मान वहाँ store
// करता है, epilogue में हटा देता है।
// GC-तल (allocator + collector) के कार्य — इनके स्थानीय चर कच्ची स्मृति
// (block-आधार, टैग, आकार, अंतर-सूचक) रखते हैं, प्रबंधित वस्तुएँ नहीं। इन्हें
// कभी GC-जड़ न बनाओ — वरना सूत्र_संग्रह अपने ही temps को scan करके जड़_गण
// फुला देता है और कच्चे मानों को वस्तु मानकर crash करता है।
कार्य रजि_जीसी_तल_कार्य(पाठ नाम) {
    यदि (नाम == "श्रेणी_का" || नाम == "मुक्त_तालिका_तैयार" || नाम == "सूत्र_स्वजीसी_आरंभ") { परत् सत्य; }
    यदि (नाम == "सूत्र_जीसी_दबाओ" || नाम == "सूत्र_जीसी_छोड़ो" || नाम == "संरेखित16") { परत् सत्य; }
    यदि (नाम == "नया_अखंड" || नाम == "शून्य_भरो" || नाम == "सूत्र_आवंटन") { परत् सत्य; }
    यदि (नाम == "सूत्र_मुक्त" || नाम == "सूत्र_पुनः_आवंटन" || नाम == "अखंड_में_है") { परत् सत्य; }
    यदि (नाम == "सूत्र_ब्लॉक_प्रकार" || नाम == "सूत्र_क्या_पाठ" || नाम == "सूत्र_क्या_सूची") { परत् सत्य; }
    यदि (नाम == "सूत्र_क्या_वस्तु" || नाम == "सूत्र_क्या_शब्दकोश") { परत् सत्य; }
    यदि (नाम == "चिह्नित_कच्चा" || नाम == "चिह्नित" || नाम == "सूत्र_संग्रह") { परत् सत्य; }
    यदि (नाम == "सूत्र_गण_चक्र" || नाम == "सूत्र_गण_सक्रिय") { परत् सत्य; }
    यदि (नाम == "सूत्र_गण_संग्रहित" || नाम == "सूत्र_गण_पुनःप्राप्त") { परत् सत्य; }
    परत् असत्य;
}

कार्य रजि_जीसी_जड़ें(शब्दकोश फलन, शब्दकोश क्र, शब्दकोश अंतराल) {
    यदि (रजि_जीसी_तल_कार्य(फलन["नाम"])) {
        फलन["जीसी_जड़ें"] = [];
        फलन["जीसी_जड़_नक्शा"] = {};
        फलन["जीसी_मृत्यु_पद"] = {};
        परत् 0;
    }
    // मान-id -> प्रकार-टैग  +  सुरक्षा-बिंदु स्थान-संख्याएँ
    शब्दकोश टैप = {};
    शब्दकोश सदा_जड़ = {};   // id -> सत्य : हमेशा रूट (नव_* परिणाम)
    शब्दकोश स्थायी_जड़ = {}; // id -> सत्य : कभी रूट मत करो (पाठ-साहित्य = स्थायी .LC_strtab जड़)
    सूची बिंदु = [];
    सूची पैरा = फलन["पैरामीटर"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(पैरा)) { टैप[पैरा[इक]["आईडी"]] = पैरा[इक]["प्रकार"]; इक = इक + 1; }

    सूची क्रम = क्र["क्रम"];
    शब्दकोश टर्म_पद = {};   // terminator स्थान-संख्याएँ (यहाँ clear मत करो)
    संख्या कक = 0;
    यावत् (कक < लंबाई(क्रम)) {
        शब्दकोश खंड = अनु_खंड_खोजें(फलन, क्रम[कक]);
        टर्म_पद[क्र["खंड_अंत"][क्रम[कक]]] = सत्य;
        संख्या फइ = 0;
        यावत् (फइ < लंबाई(खंड["फाई"])) {
            टैप[खंड["फाई"][फइ]["आईडी"]] = खंड["फाई"][फइ]["प्रकार"];
            फइ = फइ + 1;
        }
        संख्या नि = 0;
        यावत् (नि < लंबाई(खंड["निर्देश"])) {
            शब्दकोश निर्देश = खंड["निर्देश"][नि];
            यदि (निर्देश["आईडी"] >= 1) {
                टैप[निर्देश["आईडी"]] = निर्देश["प्रकार"];
                // नव_* (compound alloc): fill-steps खुद allocate कर सकते
                // (dict grow, constructor) — half-built aggregate रूट करना
                // ज़रूरी, चाहे बाद में safepoint घेरे या न घेरे।
                पाठ कक2 = निर्देश["कोड"];
                यदि (कक2 == "नव_शब्दकोश" || कक2 == "नव_वस्तु" || कक2 == "नव_सूची" || कक2 == "नव_पाठ") {
                    सदा_जड़[निर्देश["आईडी"]] = सत्य;
                }
                // पाठ-साहित्य: .LC_strtab में स्थायी GC-जड़ (उत्_पाठ_तालिका_आरंभ /
                // एउ_पाठ_तालिका_आरंभ) → उसकी स्थानीय प्रति को फिर से रूट करना
                // व्यर्थ; लूप में यह store/clear जोड़ी clang की LICM रोकती।
                // केवल तभी जब यह एकक स्थायी तालिका उपयोग करेगा (_पाठ_तालिका)।
                यदि (कक2 == "स्थिर" && निर्देश["अंश"]["मान_प्रकार"] == "पाठ"
                     && फलन["_स्थिर_पाठ_स्थायी"] == सत्य) {
                    स्थायी_जड़[निर्देश["आईडी"]] = सत्य;
                }
            }
            यदि (मध्यम_सुरक्षा_बिंदु_है(निर्देश)) { बिंदु = जोड़ें(बिंदु, निर्देश["_pos"]); }
            नि = नि + 1;
        }
        कक = कक + 1;
    }

    शब्दकोश आरंभ = अंतराल["आरंभ"];
    शब्दकोश अंत = अंतराल["अंत"];
    सूची जड़_सूची = [];
    शब्दकोश जड़_नक्शा = {};
    शब्दकोश मृत्यु_पद = {};   // पद -> [जड़-स्लॉट-ऑफसेट...] जो यहाँ मरते हैं
    संख्या ढेर = फलन["ढेर_आकार"];
    संख्या मूल_ढेर = ढेर;
    // ⚠️ ऑफसेट 0 आरक्षित — शब्दकोश-get 0 बनाम अनुपस्थित में फर्क नहीं करता,
    // तो जड़_नक्शा[id]==0 को उत्_जड़_संचय "कोई स्लॉट नहीं" समझ लेगा।
    यदि (ढेर < 8) { ढेर = 8; }

    सूची कुं = कुंजियाँ(आरंभ);
    कुं = रजि_क्रमबद्ध(कुं, रजि_पहचान_नक्शा(कुं));
    इक = 0;
    यावत् (इक < लंबाई(कुं)) {
        संख्या व = कुं[इक];
        यदि (मध्यम_जीसी_टैप्ड(टैप[व]) && स्थायी_जड़[व] != सत्य) {
            संख्या स = आरंभ[व];
            संख्या ए = अंत[व];
            मान घेरता = असत्य;
            यदि (सदा_जड़[व] == सत्य) { घेरता = सत्य; }
            संख्या ज = 0;
            यावत् (ज < लंबाई(बिंदु)) {
                यदि (बिंदु[ज] > स) {
                    यदि (बिंदु[ज] <= ए) { घेरता = सत्य; }
                }
                ज = ज + 1;
            }
            यदि (घेरता) {
                जड़_नक्शा[व] = ढेर;
                जड़_सूची = जोड़ें(जड़_सूची, व);
                // मृत्यु पर स्लॉट clear — यदि अंत एक सामान्य निर्देश-स्थान है
                // (terminator/phi-edge नहीं) — ताकि मृत मान वस्तु को जीवित न रखे
                यदि (ए > स) {
                    यदि (टर्म_पद[ए] != सत्य) {
                        मान सू = मृत्यु_पद[ए];
                        यदि (सू == शून्यम्) { सू = []; }
                        मृत्यु_पद[ए] = जोड़ें(सू, ढेर);
                    }
                }
                ढेर = ढेर + 8;
            }
        }
        इक = इक + 1;
    }

    // कोई जड़ नहीं → ढेर_आकार अछूता (perf-tests spill-गिनती पर निर्भर)
    यदि (लंबाई(जड़_सूची) == 0) { ढेर = मूल_ढेर; }
    फलन["ढेर_आकार"] = ढेर;
    फलन["जीसी_जड़ें"] = जड़_सूची;
    फलन["जीसी_जड़_नक्शा"] = जड़_नक्शा;
    फलन["जीसी_मृत्यु_पद"] = मृत्यु_पद;
    परत् 0;
}

कार्य रजि_नियतक_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या इक = 0;
    यावत् (इक < लंबाई(कस)) {
        रजि_नियतक_कार्य(कस[इक]);
        इक = इक + 1;
    }
    परत् एकक;
}


// ============================================================
// मुद्रक — debugging
// ============================================================
कार्य रजि_छापो(शब्दकोश फलन) {
    पाठ स = "रजि-नियतन: " + फलन["नाम"] + अक्षर_निर्माण(10);
    शब्दकोश नि = फलन["रजि_नियतन"];
    सूची कुं = कुंजियाँ(नि);
    कुं = रजि_क्रमबद्ध(कुं, रजि_पहचान_नक्शा(कुं));
    संख्या इक = 0;
    यावत् (इक < लंबाई(कुं)) {
        शब्दकोश अ = नि[कुं[इक]];
        यदि (अ["प्रकार"] == "रजि") {
            स = स + "  v" + कुं[इक] + " -> %" + अ["नाम"] + अक्षर_निर्माण(10);
        } अन्यथा {
            स = स + "  v" + कुं[इक] + " -> [ढेर+" + अ["ऑफसेट"] + "]" + अक्षर_निर्माण(10);
        }
        इक = इक + 1;
    }
    स = स + "  ढेर_आकार=" + फलन["ढेर_आकार"] + "  सुरक्षित=" + लंबाई(फलन["प्रयुक्त_सुरक्षित"]) + अक्षर_निर्माण(10);
    परत् स;
}
कार्य रजि_पहचान_नक्शा(सूची कुं) {
    शब्दकोश निधि = {};
    संख्या इक = 0;
    यावत् (इक < लंबाई(कुं)) { निधि[कुं[इक]] = कुं[इक]; इक = इक + 1; }
    परत् निधि;
}
