// लूप_अनुकूलन.सूत्र — LICM (loop-invariant code motion), Milestone 4 भाग B
// ============================================================
// §4g में एक बार LICM आज़माई गई थी और पूरी तरह revert हुई — कारण: "लूप
// में कोई भी कॉल = मत छुओ" जितनी मोटी rule के तहत लगभग हर असली लूप
// (parser का हर लूप कोई-न-कोई helper बुलाता है) अयोग्य हो जाता था, शून्य
// hoist हुआ, बस pass का अपना कोड compiler की .s में जुड़ गया — शुद्ध regression।
//
// अब बिंदु_विश्लेषण (Milestone 1-4 भाग A) से "यह specific कॉल *इस* वस्तु
// को छू सकता है क्या" पूछा जा सकता है — तो rule सटीक हो सकती है।
//
// दायरा (जान-बूझकर संकुचित — सुरक्षित, सत्यापन-योग्य पहला कदम):
// सिर्फ़ "लंबाई" IR opcode को लूप से बाहर निकालना (सूत्र_निम्नक हर
// `लंबाई(x)` को इसी एक opcode में lower करता है, चाहे x सूची/शब्दकोश/
// पाठ हो — देखें मूल_निम्नक.सूत्र निम्नक_सूची_अभिव्यक्ति के पास "लंबाई"
// case, और मूल_उत्सर्जक जो हमेशा `call दैशिक_लंबाई` उत्सर्जित करता)।
// यही वह पैटर्न है जो §4g में मापा गया था: `यावत् (इक < लंबाई(सूची))`
// जैसी शर्तें compiler में खुद 130+ बार आती हैं — हर बार दोबारा लंबाई
// गिनना, जब तक कि लूप के अंदर सूची में कुछ जुड़े/निकले नहीं।
//
// सुरक्षा-शर्त: "लंबाई(आधार)" तभी hoist होता जब
//   (क) आधार लूप के बाहर परिभाषित हो (SSA dominance से preheader में
//       hoist के बाद भी valid रहेगा), और
//   (ख) लूप के अंदर कोई भी निर्देश/कॉल आधार के points-to-सेट से टकराने
//       वाली किसी वस्तु को न लिख सके (कग_पुस्तकालय_प्रभाव + module-भीतरी
//       प्रत्यक्ष_लेखन + अपरिचित-कॉल-रूढ़िवादिता — बिंदु_विश्लेषण.सूत्र से,
//       पर सिर्फ़ *इस लूप के* ब्लॉकों पर, पूरे फलन पर नहीं — फलन में कहीं
//       और होने वाला असंबंधित लेखन इस लूप की hoist-योग्यता को प्रभावित
//       नहीं करना चाहिए)।
//
// क्रियाविधि: प्राकृतिक-लूप पहचान (dominators, Cooper-Harvey-Kennedy) →
// हर लूप के लिए preheader डालो (सिर्फ़ तभी जब कोई उम्मीदवार मिले, और
// सिर्फ़ तभी जब header का बाहरी (गैर-लूप) पूर्ववर्ती ठीक 1 हो — सूत्र की
// अपनी यावत्/for lowering हमेशा यही आकार बनाती; कुछ और मिले तो सुरक्षित
// रूप से छोड़ दो, न कि गलत phi-rewrite का जोखिम लो)।
//
// कहीं wire नहीं — केवल लूप_अनुकूलन_परीक्षण.सूत्र से जाँचा, फिर empirically
// असली compiler पर मापा जाएगा, तभी मूल_संकलन.सूत्र में जोड़ेंगे।
// ============================================================

आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";


// ============================================================
// DFS — postorder संख्या + RPO (dominators के लिए दोनों चाहिए)
// ============================================================

कार्य लूइनी_डीएफएस(शब्दकोश फलन) {
    सूची खस = फलन["खंड_सूची"];
    शब्दकोश नतीजा = {};
    यदि (लंबाई(खस) == ०) { नतीजा["क्रमसू"] = []; नतीजा["उपन"] = {}; परत् नतीजा; }
    शब्दकोश देखे = {};
    शब्दकोश धारक = {};
    धारक["क्रम"] = [];
    लूइनी_डीएफएस_गहन(फलन, खस[०]["लेबल"], देखे, धारक);
    सूची उक्रम = धारक["क्रम"];
    शब्दकोश उपन = {};
    संख्या इक = ०;
    यावत् (इक < लंबाई(उक्रम)) { उपन[उक्रम[इक]] = इक; इक = इक + १; }
    सूची क्रमसू = [];
    इक = लंबाई(उक्रम) - १;
    यावत् (इक >= ०) { क्रमसू = जोड़ें(क्रमसू, उक्रम[इक]); इक = इक - १; }
    नतीजा["क्रमसू"] = क्रमसू;
    नतीजा["उपन"] = उपन;
    परत् नतीजा;
}

कार्य लूइनी_डीएफएस_गहन(शब्दकोश फलन, पाठ लेबल, शब्दकोश देखे, शब्दकोश धारक) {
    यदि (देखे[लेबल] == सत्य) { परत् ०; }
    देखे[लेबल] = सत्य;
    शब्दकोश खंड = अनु_खंड_खोजें(फलन, लेबल);
    यदि (खंड != शून्यम्) {
        सूची उत्त = अनु_उत्तराधिकारी(खंड);
        संख्या स = ०;
        यावत् (स < लंबाई(उत्त)) {
            लूइनी_डीएफएस_गहन(फलन, उत्त[स], देखे, धारक);
            स = स + १;
        }
    }
    धारक["क्रम"] = जोड़ें(धारक["क्रम"], लेबल);
    परत् ०;
}


// ============================================================
// Dominators — Cooper/Harvey/Kennedy (idom, postorder-number आधारित)
// ============================================================

कार्य लूइनी_प्रभु(शब्दकोश फलन) {
    मान डीएफ = लूइनी_डीएफएस(फलन);
    सूची क्रमसू = डीएफ["क्रमसू"];
    शब्दकोश उपन = डीएफ["उपन"];
    शब्दकोश प्रभुनक्शा = {};
    यदि (लंबाई(क्रमसू) == ०) { परत् प्रभुनक्शा; }
    पाठ प्रवेश = क्रमसू[०];
    शब्दकोश पूर्व = अनु_पूर्ववर्ती(फलन);
    प्रभुनक्शा[प्रवेश] = प्रवेश;

    मान बदला = सत्य;
    संख्या रक्षक = ०;
    यावत् (बदला && रक्षक < १००००) {
        बदला = असत्य;
        संख्या इक = १;
        यावत् (इक < लंबाई(क्रमसू)) {
            पाठ ब = क्रमसू[इक];
            सूची प्रीज = पूर्व[ब];
            पाठ नयाप्रभु = शून्यम्;
            संख्या ज = ०;
            यावत् (ज < लंबाई(प्रीज)) {
                पाठ प = प्रीज[ज];
                यदि (प्रभुनक्शा[प] != शून्यम्) {
                    यदि (नयाप्रभु == शून्यम्) { नयाप्रभु = प; }
                    अन्यथा { नयाप्रभु = लूइनी_मिलाओ(प्रभुनक्शा, उपन, नयाप्रभु, प); }
                }
                ज = ज + १;
            }
            यदि (नयाप्रभु != शून्यम् && प्रभुनक्शा[ब] != नयाप्रभु) {
                प्रभुनक्शा[ब] = नयाप्रभु;
                बदला = सत्य;
            }
            इक = इक + १;
        }
        रक्षक = रक्षक + १;
    }
    परत् प्रभुनक्शा;
}

कार्य लूइनी_मिलाओ(शब्दकोश प्रभुनक्शा, शब्दकोश उपन, पाठ अ, पाठ ब) {
    पाठ फ1 = अ;
    पाठ फ2 = ब;
    संख्या रक्षक = ०;
    यावत् (फ1 != फ2 && रक्षक < १००००) {
        यावत् (उपन[फ1] < उपन[फ2]) { फ1 = प्रभुनक्शा[फ1]; }
        यावत् (उपन[फ2] < उपन[फ1]) { फ2 = प्रभुनक्शा[फ2]; }
        रक्षक = रक्षक + १;
    }
    परत् फ1;
}

// क्या ए, बी को dominate करता (बी की dominator-श्रृंखला में ए मिलता है)?
कार्य लूइनी_क्या_डोमिनेट(शब्दकोश प्रभुनक्शा, पाठ ए, पाठ बी) {
    पाठ वर्त = बी;
    संख्या रक्षक = ०;
    यावत् (रक्षक < १००००) {
        यदि (वर्त == ए) { परत् सत्य; }
        यदि (प्रभुनक्शा[वर्त] == वर्त) { परत् असत्य; }   // प्रवेश तक पहुँच गए
        वर्त = प्रभुनक्शा[वर्त];
        रक्षक = रक्षक + १;
    }
    परत् असत्य;
}


// ============================================================
// प्राकृतिक-लूप पहचान — back-edge (n->h जहाँ h, n को dominate करता)
// से header के इर्द-गिर्द ब्लॉक-समुच्चय (backward reachability)
// ============================================================

कार्य लूइनी_लूप_खोजें(शब्दकोश फलन) {
    शब्दकोश प्रभुनक्शा = लूइनी_प्रभु(फलन);
    शब्दकोश पूर्व = अनु_पूर्ववर्ती(फलन);
    सूची खस = फलन["खंड_सूची"];

    शब्दकोश हैडर_स्रोत = {};
    सूची हैडर_क्रम = [];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        पाठ नब = खस[ख]["लेबल"];
        सूची उत्त = अनु_उत्तराधिकारी(खस[ख]);
        संख्या ज = ०;
        यावत् (ज < लंबाई(उत्त)) {
            पाठ हब = उत्त[ज];
            यदि (लूइनी_क्या_डोमिनेट(प्रभुनक्शा, हब, नब)) {
                मान सू = हैडर_स्रोत[हब];
                यदि (सू == शून्यम्) { सू = []; हैडर_क्रम = जोड़ें(हैडर_क्रम, हब); }
                हैडर_स्रोत[हब] = जोड़ें(सू, नब);
            }
            ज = ज + १;
        }
        ख = ख + १;
    }

    सूची लूप_सूची = [];
    संख्या हक = ०;
    यावत् (हक < लंबाई(हैडर_क्रम)) {
        पाठ हब = हैडर_क्रम[हक];
        सूची स्रोत = हैडर_स्रोत[हब];
        शब्दकोश खंड_सेट = {};
        खंड_सेट[हब] = सत्य;
        सूची कार्यसूची = [];
        संख्या स = ०;
        यावत् (स < लंबाई(स्रोत)) {
            यदि (खंड_सेट[स्रोत[स]] != सत्य) {
                खंड_सेट[स्रोत[स]] = सत्य;
                कार्यसूची = जोड़ें(कार्यसूची, स्रोत[स]);
            }
            स = स + १;
        }
        यावत् (लंबाई(कार्यसूची) > ०) {
            संख्या अंतिम = लंबाई(कार्यसूची) - १;
            पाठ नब = कार्यसूची[अंतिम];
            सूची अगली = [];
            संख्या पी = ०;
            यावत् (पी < अंतिम) { अगली = जोड़ें(अगली, कार्यसूची[पी]); पी = पी + १; }
            कार्यसूची = अगली;
            सूची प्रीज = पूर्व[नब];
            संख्या ज = ०;
            यावत् (ज < लंबाई(प्रीज)) {
                पाठ प = प्रीज[ज];
                यदि (खंड_सेट[प] != सत्य) {
                    खंड_सेट[प] = सत्य;
                    कार्यसूची = जोड़ें(कार्यसूची, प);
                }
                ज = ज + १;
            }
        }
        शब्दकोश लूप = {};
        लूप["हैडर"] = हब;
        लूप["खंड"] = खंड_सेट;
        लूप_सूची = जोड़ें(लूप_सूची, लूप);
        हक = हक + १;
    }
    परत् लूप_सूची;
}


// ============================================================
// लूप-स्थानीय written-sites — कग_लेखन_दर्ज जैसा तर्क, पर सिर्फ़ इस
// लूप के अपने ब्लॉकों पर (पूरे फलन पर नहीं — कम रूढ़िवादी, ज़्यादा सटीक)
// ============================================================

कार्य लूइनी_लूप_लेखन(शब्दकोश फलन, शब्दकोश विश्लेषण, शब्दकोश खंड_सेट, शब्दकोश विश्लेषण_नक्शा) {
    शब्दकोश बिंदु = विश्लेषण["बिंदु"];
    शब्दकोश लेखन = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        यदि (खंड_सेट[खंड["लेबल"]] == सत्य) {
            सूची निस = खंड["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश निर्देश = निस[नि];
                पाठ कोड = निर्देश["कोड"];
                यदि (कोड == "लिख_अनुक्रम" || कोड == "लिख_क्षेत्र") {
                    संख्या आधार = निर्देश["संचालक"][०];
                    बिं_संघ(लेखन, बिंदु[आधार]);
                } अन्यथा यदि (कोड == "बुलाओ") {
                    पाठ लक्ष्य_नाम = निर्देश["अंश"]["लक्ष्य"];
                    सूची तर्क = निर्देश["संचालक"];
                    मान प्रभाव = कग_पुस्तकालय_प्रभाव(लक्ष्य_नाम);
                    यदि (प्रभाव != शून्यम्) {
                        कग_लेखन_दर्ज(लेखन, बिंदु, प्रभाव["लेखन"], तर्क);
                    } अन्यथा यदि (विश्लेषण_नक्शा[लक्ष्य_नाम] != शून्यम्) {
                        बिं_संघ(लेखन, विश्लेषण_नक्शा[लक्ष्य_नाम]["प्रत्यक्ष_लेखन"]);
                    } अन्यथा {
                        बिं_संघ(लेखन, बिं_एकल(बिं_शीर्ष()));
                    }
                }
                नि = नि + १;
            }
        }
        ख = ख + १;
    }
    परत् लेखन;
}


// ============================================================
// def-block नक्शा — कौन-सा ब्लॉक किस value-id को परिभाषित करता
// (पैरामीटर नक्शे में कभी नहीं — हमेशा "लूप के बाहर" गिने जाते)
// ============================================================

कार्य लूइनी_परिभाषा_खंड(शब्दकोश फलन) {
    शब्दकोश नक्शा = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        पाठ लेबल = खंड["लेबल"];
        सूची फस = खंड["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) { नक्शा[फस[फ]["आईडी"]] = लेबल; फ = फ + १; }
        सूची निस = खंड["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] >= १) { नक्शा[निस[नि]["आईडी"]] = लेबल; }
            नि = नि + १;
        }
        ख = ख + १;
    }
    परत् नक्शा;
}

कार्य लूइनी_बाहर_परिभाषित(शब्दकोश परिभाषा_खंड, शब्दकोश खंड_सेट, संख्या मव) {
    यदि (मव < १) { परत् सत्य; }
    मान ब = परिभाषा_खंड[मव];
    यदि (ब == शून्यम्) { परत् सत्य; }   // पैरामीटर आदि
    परत् खंड_सेट[ब] != सत्य;
}


// ============================================================
// लूप_लेखन बनाम आधार का points-to — टकराव जाँच। बिंदु_विश्लेषण की
// सामान्य बिं_स्थल_अतिच्छादन यहाँ सीधे इस्तेमाल नहीं की जा सकती: वह
// "या तो पक्ष ⊤ है तो टकराव मान लो" कहती — सही जब दोनों पक्ष किसी
// वस्तु की *पहचान* बता रहे हों (alias-प्रश्न), पर यहाँ लूप_लेखन का
// मतलब अलग है — वह ठोस रूप से गिना हुआ "इस लूप ने क्या-क्या लिखा" है।
// अगर लूप_लेखन बिल्कुल खाली है (कुछ भी नहीं लिखा गया — यह एक निश्चित
// तथ्य है, अनुमान नहीं), तो आधार चाहे ⊤ (पूरी तरह अज्ञात) ही क्यों न
// हो, hoist सुरक्षित है — खाली सेट किसी से नहीं टकराता। पर लूप_लेखन
// खाली न हो तो आधार का ⊤ होना अब भी रूढ़िवादी रूप से टकराव मानना
// ज़रूरी (आधार सैद्धांतिक रूप से कुछ भी हो सकता, इसलिए लिखी गई किसी
// भी वस्तु से मेल खा सकता)।
कार्य लूइनी_लेखन_टकराव(शब्दकोश लूप_लेखन, शब्दकोश आधार_बिं) {
    यदि (लूप_लेखन == शून्यम्) { परत् सत्य; }
    यदि (लंबाई(कुंजियाँ(लूप_लेखन)) == ०) { परत् असत्य; }   // कुछ भी नहीं लिखा गया — हमेशा सुरक्षित
    परत् बिं_स्थल_अतिच्छादन(लूप_लेखन, आधार_बिं);
}


// ============================================================
// एक ब्लॉक के निर्देश-सूची से एक id हटाओ (hoist के दौरान मूल जगह से निकालना)
// ============================================================

कार्य लूइनी_निर्देश_हटाओ(सूची निस, संख्या आईडी) {
    सूची नयी = [];
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(निस)) {
        यदि (निस[सूचक]["आईडी"] != आईडी) { नयी = जोड़ें(नयी, निस[सूचक]); }
        सूचक = सूचक + १;
    }
    परत् नयी;
}


// ============================================================
// एक लूप पर — "लंबाई" उम्मीदवार ढूँढो + सुरक्षित हों तो preheader में hoist करो
// ============================================================

कार्य लूइनी_हॉइस्ट_लंबाई(शब्दकोश फलन, शब्दकोश विश्लेषण, शब्दकोश विश्लेषण_नक्शा, शब्दकोश लूप) {
    शब्दकोश खंड_सेट = लूप["खंड"];
    पाठ हैडर = लूप["हैडर"];

    शब्दकोश पूर्व = अनु_पूर्ववर्ती(फलन);
    सूची हैडर_पूर्व = पूर्व[हैडर];
    सूची बाहरी = [];
    संख्या प = ०;
    यावत् (प < लंबाई(हैडर_पूर्व)) {
        यदि (खंड_सेट[हैडर_पूर्व[प]] != सत्य) { बाहरी = जोड़ें(बाहरी, हैडर_पूर्व[प]); }
        प = प + १;
    }
    यदि (लंबाई(बाहरी) != १) { परत् असत्य; }   // असामान्य आकार — मत छुओ
    पाठ बाहरी_लेबल = बाहरी[०];

    शब्दकोश परिभाषा_खंड = लूइनी_परिभाषा_खंड(फलन);
    शब्दकोश लूप_लेखन = लूइनी_लूप_लेखन(फलन, विश्लेषण, खंड_सेट, विश्लेषण_नक्शा);
    शब्दकोश बिंदु = विश्लेषण["बिंदु"];

    सूची उम्मीदवार = [];   // [[खंड, निर्देश], ...]
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        यदि (खंड_सेट[खंड["लेबल"]] == सत्य) {
            सूची निस = खंड["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश निर्देश = निस[नि];
                यदि (निर्देश["कोड"] == "लंबाई") {
                    संख्या आधार = निर्देश["संचालक"][०];
                    यदि (लूइनी_बाहर_परिभाषित(परिभाषा_खंड, खंड_सेट, आधार)) {
                        यदि (न लूइनी_लेखन_टकराव(लूप_लेखन, बिंदु[आधार])) {
                            उम्मीदवार = जोड़ें(उम्मीदवार, [खंड, निर्देश]);
                        }
                    }
                }
                नि = नि + १;
            }
        }
        ख = ख + १;
    }

    यदि (लंबाई(उम्मीदवार) == ०) { परत् असत्य; }

    शब्दकोश पह_खंड = मध्यम_नव_खंड(फलन, "licm_ph");
    मध्यम_जाओ(पह_खंड, हैडर);

    शब्दकोश बाहरी_खंड = अनु_खंड_खोजें(फलन, बाहरी_लेबल);
    मान बअंत = बाहरी_खंड["अंत"];
    यदि (बअंत["कोड"] == "जाओ") {
        यदि (बअंत["अंश"]["लक्ष्य"] == हैडर) { बअंत["अंश"]["लक्ष्य"] = पह_खंड["लेबल"]; }
    } अन्यथा यदि (बअंत["कोड"] == "यदि_जाओ") {
        यदि (बअंत["अंश"]["सत्य"] == हैडर) { बअंत["अंश"]["सत्य"] = पह_खंड["लेबल"]; }
        यदि (बअंत["अंश"]["असत्य"] == हैडर) { बअंत["अंश"]["असत्य"] = पह_खंड["लेबल"]; }
    }

    शब्दकोश हैडर_खंड = अनु_खंड_खोजें(फलन, हैडर);
    सूची हैडर_फाई = हैडर_खंड["फाई"];
    संख्या फि = ०;
    यावत् (फि < लंबाई(हैडर_फाई)) {
        सूची स्रोत = हैडर_फाई[फि]["अंश"]["स्रोत"];
        संख्या सि = ०;
        यावत् (सि < लंबाई(स्रोत)) {
            यदि (स्रोत[सि][०] == बाहरी_लेबल) { स्रोत[सि][०] = पह_खंड["लेबल"]; }
            सि = सि + १;
        }
        फि = फि + १;
    }

    संख्या उइ = ०;
    यावत् (उइ < लंबाई(उम्मीदवार)) {
        शब्दकोश खंड = उम्मीदवार[उइ][०];
        शब्दकोश निर्देश = उम्मीदवार[उइ][१];
        खंड["निर्देश"] = लूइनी_निर्देश_हटाओ(खंड["निर्देश"], निर्देश["आईडी"]);
        पह_खंड["निर्देश"] = जोड़ें(पह_खंड["निर्देश"], निर्देश);
        उइ = उइ + १;
    }

    परत् सत्य;
}

// ============================================================
// सीमा-उन्नयन (bounds-check hoisting) — Stage 1
// ============================================================
// लक्ष्य: `यावत् (इ < ऊपरी) { ... सूची[इ] ... }` जैसे counted लूप में
// per-element bounds-check हटाना ताकि --release (LLVM) backend inner loop
// vectorize कर सके (मापा: c4 matmul ~4.3×, clang parity)।
//
// तरीका (option-b — कोई नया preheader block नहीं, कोई phi rewrite नहीं;
// वही cheez Commit 2 में self-hosting तोड़ रही थी):
//   • header का एकमात्र बाहरी पूर्ववर्ती P हो, terminator अशर्त `जाओ header`
//     → P पहले से preheader; उसी में जोड़ो।
//   • P में `सीमा_दावा_ऊपर(आधार, ऊपरी)` कॉल — रनटाइम गार्ड जो
//     `ऊपरी > लंबाई(आधार)` पर लूप-पूर्व वही सीमा-त्रुटि फेंकता।
//   • लूप-भीतर हर योग्य access `अंश["अनियंत्रित"]="1"` → LLVM emitter
//     branch-रहित load/store बनाता।
//
// Stage 1 प्रतिबंध (जान-बूझकर तंग — पहले self-host सुरक्षा):
//   IV आरंभ स्थिरांक 0, पद स्थिरांक 1, निकास `<`; सूचकांक ठीक IV;
//   आधार लूप-बाहर; लूप में कोई length-बदलू या अज्ञात कॉल नहीं।

// लंबाई-स्थिरता: लूप में कोई कॉल जो सूची लंबाई बदल सके या अज्ञात हो →
// असुरक्षित (तत्व-लेखन लिख_अनुक्रम length-neutral, ठीक है)।
कार्य लूइनी_सुरक्षित_कॉल(पाठ लक्ष्य) {
    परत् लक्ष्य == "sutra_float_add" || लक्ष्य == "sutra_float_sub" ||
         लक्ष्य == "sutra_float_mul" || लक्ष्य == "sutra_float_div" ||
         लक्ष्य == "sutra_float_eq" || लक्ष्य == "sutra_float_ne" ||
         लक्ष्य == "sutra_float_lt" || लक्ष्य == "sutra_float_gt" ||
         लक्ष्य == "sutra_float_le" || लक्ष्य == "sutra_float_ge" ||
         लक्ष्य == "sutra_math_sqrt_f" || लक्ष्य == "sutra_math_abs_f" ||
         लक्ष्य == "sutra_math_min_f" || लक्ष्य == "sutra_math_max_f" ||
         लक्ष्य == "sutra_math_round_f" ||
         लक्ष्य == "सूची_लंबाई_तेज़" || लक्ष्य == "दैशिक_लंबाई" ||
         लक्ष्य == "पाठ_लंबाई_तेज़" ||
         लक्ष्य == "सूची_तत्व_तेज़" || लक्ष्य == "सूची_सूचकांक" ||
         लक्ष्य == "सूची_तत्व_अनि" || लक्ष्य == "सीमा_दावा_ऊपर" ||
         लक्ष्य == "सूची_तत्व_सेट_तेज़" || लक्ष्य == "सूची_सूचकांक_सेट" ||
         लक्ष्य == "सूची_तत्व_सेट_अनि";
}
कार्य लूइनी_लंबाई_सुरक्षित(शब्दकोश फलन, शब्दकोश खंड_सेट) {
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        यदि (खंड_सेट[खस[ख]["लेबल"]] == सत्य) {
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                पाठ को = निस[नि]["कोड"];
                यदि (को == "बुलाओ") {
                    यदि (न लूइनी_सुरक्षित_कॉल(निस[नि]["अंश"]["लक्ष्य"])) { परत् असत्य; }
                }
                यदि (को == "अंतर्" || को == "विधि_बुलाओ" || को == "नव_वस्तु") { परत् असत्य; }
                नि = नि + १;
            }
            // फलन-स्तर जल्दी-निकास (वापस/फेंको) लूप में → गार्ड return-मान
            // या दूसरी exception को सीमा-त्रुटि में बदल सकता → छोड़ो।
            // (विरामः/जारीरह = जाओ, लूप-आंतरिक — स्वीकृत semantics, ठीक)
            मान अंत = खस[ख]["अंत"];
            यदि (अंत != शून्यम्) {
                यदि (अंत["कोड"] == "वापस" || अंत["कोड"] == "फेंको") { परत् असत्य; }
            }
        }
        ख = ख + १;
    }
    परत् सत्य;
}

कार्य लूइनी_मान_निर्देश(शब्दकोश फलन) {
    शब्दकोश नक्शा = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        सूची फस = खंड["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) { नक्शा[फस[फ]["आईडी"]] = फस[फ]; फ = फ + १; }
        सूची निस = खंड["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] >= १) { नक्शा[निस[नि]["आईडी"]] = निस[नि]; }
            नि = नि + १;
        }
        ख = ख + १;
    }
    परत् नक्शा;
}

कार्य लूइनी_स्थिर_मान(शब्दकोश निर्देश) {
    यदि (निर्देश == शून्यम्) { परत् शून्यम्; }
    यदि (निर्देश["कोड"] != "स्थिर") { परत् शून्यम्; }
    यदि (निर्देश["अंश"]["मान_प्रकार"] != "पूर्ण") { परत् शून्यम्; }
    परत् निर्देश["अंश"]["मान"];
}

// वनेक्स्ट, `योग(iv, स्थिर 1)` या `योग(स्थिर 1, iv)` से आता है?
कार्य लूइनी_पद_एक(शब्दकोश मान_निर्देश, संख्या वनेक्स्ट, संख्या आइवी) {
    मान द = मान_निर्देश[वनेक्स्ट];
    यदि (द == शून्यम् || द["कोड"] != "योग") { परत् असत्य; }
    सूची स = द["संचालक"];
    यदि (लंबाई(स) != २) { परत् असत्य; }
    संख्या अन्य = ० - १;
    यदि (स[०] == आइवी) { अन्य = स[१]; }
    अन्यथा यदि (स[१] == आइवी) { अन्य = स[०]; }
    अन्यथा { परत् असत्य; }
    परत् लूइनी_स्थिर_मान(मान_निर्देश[अन्य]) == १;
}

कार्य लूइनी_सीमा_उन्नयन(शब्दकोश एकक, शब्दकोश फलन, शब्दकोश विश्लेषण, शब्दकोश विश्लेषण_नक्शा, शब्दकोश लूप) {
    शब्दकोश खंड_सेट = लूप["खंड"];
    पाठ हैडर = लूप["हैडर"];

    // (क) header का ठीक 1 बाहरी पूर्ववर्ती, अशर्त `जाओ header`
    शब्दकोश पूर्व = अनु_पूर्ववर्ती(फलन);
    सूची हैडर_पूर्व = पूर्व[हैडर];
    सूची बाहरी = [];
    संख्या प = ०;
    यावत् (प < लंबाई(हैडर_पूर्व)) {
        यदि (खंड_सेट[हैडर_पूर्व[प]] != सत्य) { बाहरी = जोड़ें(बाहरी, हैडर_पूर्व[प]); }
        प = प + १;
    }
    यदि (लंबाई(बाहरी) != १) { परत् असत्य; }
    शब्दकोश पूर्व_खंड = अनु_खंड_खोजें(फलन, बाहरी[०]);
    यदि (पूर्व_खंड == शून्यम्) { परत् असत्य; }
    मान पअंत = पूर्व_खंड["अंत"];
    यदि (पअंत == शून्यम् || पअंत["कोड"] != "जाओ" || पअंत["अंश"]["लक्ष्य"] != हैडर) { परत् असत्य; }

    शब्दकोश हैडर_खंड = अनु_खंड_खोजें(फलन, हैडर);
    यदि (हैडर_खंड == शून्यम्) { परत् असत्य; }
    शब्दकोश मान_निर्देश = लूइनी_मान_निर्देश(फलन);
    शब्दकोश परिभाषा_खंड = लूइनी_परिभाषा_खंड(फलन);

    // (ख) IV: header phi — स्रोत [बाहरी: स्थिर0], [latch: iv+1]
    संख्या आइवी = ० - १;
    सूची हफ = हैडर_खंड["फाई"];
    संख्या फ = ०;
    यावत् (फ < लंबाई(हफ)) {
        सूची स्रोत = हफ[फ]["अंश"]["स्रोत"];
        यदि (लंबाई(स्रोत) == २) {
            संख्या व0 = ० - १; संख्या वल = ० - १;
            संख्या क = ०;
            यावत् (क < २) {
                यदि (स्रोत[क][०] == बाहरी[०]) { व0 = स्रोत[क][१]; }
                अन्यथा यदि (खंड_सेट[स्रोत[क][०]] == सत्य) { वल = स्रोत[क][१]; }
                क = क + १;
            }
            यदि (व0 >= १ && वल >= १) {
                यदि (लूइनी_स्थिर_मान(मान_निर्देश[व0]) == ०) {
                    यदि (लूइनी_पद_एक(मान_निर्देश, वल, हफ[फ]["आईडी"])) {
                        आइवी = हफ[फ]["आईडी"];
                    }
                }
            }
        }
        फ = फ + १;
    }
    यदि (आइवी < १) { परत् असत्य; }

    // (ग) निकास-परीक्षण: header terminator `यदि_जाओ c ? body : exit`,
    //     c = लघु(iv, ऊपरी), ऊपरी लूप-अपरिवर्ती
    मान हअंत = हैडर_खंड["अंत"];
    यदि (हअंत == शून्यम् || हअंत["कोड"] != "यदि_जाओ") { परत् असत्य; }
    यदि (खंड_सेट[हअंत["अंश"]["सत्य"]] != सत्य) { परत् असत्य; }
    यदि (खंड_सेट[हअंत["अंश"]["असत्य"]] == सत्य) { परत् असत्य; }
    संख्या शर्त_आईडी = हअंत["संचालक"][०];
    मान शर्त_नि = मान_निर्देश[शर्त_आईडी];
    यदि (शर्त_नि == शून्यम् || शर्त_नि["कोड"] != "लघु") { परत् असत्य; }
    यदि (शर्त_नि["संचालक"][०] != आइवी) { परत् असत्य; }
    संख्या ऊपरी_आईडी = शर्त_नि["संचालक"][१];
    संख्या ऊपरी_स्थिर = लूइनी_स्थिर_मान(मान_निर्देश[ऊपरी_आईडी]);
    यदि (ऊपरी_स्थिर == शून्यम्) {
        यदि (न लूइनी_बाहर_परिभाषित(परिभाषा_खंड, खंड_सेट, ऊपरी_आईडी)) { परत् असत्य; }
    }

    // लंबाई-स्थिरता: लूप में कोई length-बदलू / अज्ञात कॉल नहीं
    यदि (न लूइनी_लंबाई_सुरक्षित(फलन, खंड_सेट)) { परत् असत्य; }

    // साफ़ लूप: लूप-ब्लॉक में या उसके तुरंत-बाहरी successor में `वापस`/`फेंको`
    // (फलन-स्तर जल्दी-निकास) नहीं — वह गार्ड return-मान/exception बदल सकता।
    // `विरामः` (जाओ wh_अंत) ठीक है — user ने "गार्ड लूप-पूर्व फेंके" semantics
    // स्वीकृत की; सिर्फ़ फलन-स्तर निकास सीमित करो।
    पाठ काउंट_निकास = हअंत["अंश"]["असत्य"];
    सूची सफ_खस = फलन["खंड_सूची"];
    संख्या स्ख = ०;
    यावत् (स्ख < लंबाई(सफ_खस)) {
        शब्दकोश ख्ब = सफ_खस[स्ख];
        यदि (खंड_सेट[ख्ब["लेबल"]] == सत्य) {
            मान ख्ब_अंत = ख्ब["अंत"];
            यदि (ख्ब_अंत != शून्यम्) {
                यदि (ख्ब_अंत["कोड"] == "वापस" || ख्ब_अंत["कोड"] == "फेंको") { परत् असत्य; }
            }
            सूची उत्त = अनु_उत्तराधिकारी(ख्ब);
            संख्या उ = ०;
            यावत् (उ < लंबाई(उत्त)) {
                पाठ लक्ष्य_ल = उत्त[उ];
                // header का counted-निकास लक्ष्य छोड़ो — वह सामान्य लूप-बाद
                // प्रवाह है (function epilogue वापस पर खत्म हो सकता)
                मान काउंट = ख्ब["लेबल"] == हैडर && लक्ष्य_ल == काउंट_निकास;
                यदि (खंड_सेट[लक्ष्य_ल] != सत्य && न काउंट) {
                    शब्दकोश स_खंड = अनु_खंड_खोजें(फलन, लक्ष्य_ल);
                    यदि (स_खंड != शून्यम् && स_खंड["अंत"] != शून्यम्) {
                        पाठ स_को = स_खंड["अंत"]["कोड"];
                        यदि (स_को == "वापस" || स_को == "फेंको") { परत् असत्य; }
                    }
                }
                उ = उ + १;
            }
        }
        स्ख = स्ख + १;
    }

    // (घ) पहले: सूची-प्रकार-सिद्ध आधार जमा करो (typed पढ़_अनुक्रम से) —
    //     लिख_अनुक्रम नोड में आधार_प्रकार नहीं होता, इसलिए पढ़ से key करो
    शब्दकोश सूची_आधार = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख0 = ०;
    यावत् (ख0 < लंबाई(खस)) {
        यदि (खंड_सेट[खस[ख0]["लेबल"]] == सत्य) {
            सूची निस0 = खस[ख0]["निर्देश"];
            संख्या नि0 = ०;
            यावत् (नि0 < लंबाई(निस0)) {
                शब्दकोश आ0 = निस0[नि0];
                यदि (आ0["कोड"] == "पढ़_अनुक्रम" && आ0["अंश"]["आधार_प्रकार"] == "सूची") {
                    सूची_आधार[आ0["संचालक"][०]] = सत्य;
                }
                नि0 = नि0 + १;
            }
        }
        ख0 = ख0 + १;
    }

    // योग्य accesses: पढ़/लिख_अनुक्रम, आधार सूची-सिद्ध + लूप-बाहर, सूचकांक == IV
    सूची योग्य = [];
    सूची आधार_सूची = [];     // विशिष्ट आधार-आईडी (हर एक पर एक गार्ड)
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        यदि (खंड_सेट[खंड["लेबल"]] == सत्य) {
            सूची निस = खंड["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश आ = निस[नि];
                यदि (आ["कोड"] == "पढ़_अनुक्रम" || आ["कोड"] == "लिख_अनुक्रम") {
                    संख्या आधार = आ["संचालक"][०];
                    संख्या सूचक = आ["संचालक"][१];
                    यदि (सूचक == आइवी && सूची_आधार[आधार] == सत्य &&
                         लूइनी_बाहर_परिभाषित(परिभाषा_खंड, खंड_सेट, आधार)) {
                        योग्य = जोड़ें(योग्य, आ);
                        मान मिला = असत्य;
                        संख्या द = ०;
                        यावत् (द < लंबाई(आधार_सूची)) {
                            यदि (आधार_सूची[द] == आधार) { मिला = सत्य; }
                            द = द + १;
                        }
                        यदि (न मिला) { आधार_सूची = जोड़ें(आधार_सूची, आधार); }
                    }
                }
                नि = नि + १;
            }
        }
        ख = ख + १;
    }
    यदि (लंबाई(योग्य) == ०) { परत् असत्य; }

    // (च) mutation: हर विशिष्ट आधार के लिए P में गार्ड कॉल + accesses retag
    संख्या ऊपरी_प = ऊपरी_आईडी;
    यदि (ऊपरी_स्थिर != शून्यम्) {
        ऊपरी_प = मध्यम_स्थिर_पूर्ण(फलन, पूर्व_खंड, ऊपरी_स्थिर);
    }
    संख्या ब = ०;
    यावत् (ब < लंबाई(आधार_सूची)) {
        शब्दकोश गुण = {};
        गुण["लक्ष्य"] = "सीमा_दावा_ऊपर";
        मध्यम_जोड़_प्रभाव(पूर्व_खंड, "बुलाओ", [आधार_सूची[ब], ऊपरी_प], गुण);
        ब = ब + १;
    }
    संख्या य = ०;
    यावत् (य < लंबाई(योग्य)) {
        योग्य[य]["अंश"]["अनियंत्रित"] = "1";
        योग्य[य]["अंश"]["आधार_प्रकार"] = "सूची";   // लिख_अनुक्रम में सामान्यतः नहीं होता
        य = य + १;
    }
    परत् सत्य;
}

कार्य लूइनी_फलन(शब्दकोश एकक, शब्दकोश फलन, शब्दकोश विश्लेषण, शब्दकोश विश्लेषण_नक्शा) {
    // नोट: लूइनी_हॉइस्ट_लंबाई (लंबाई-LICM, मध्यम_नव_खंड preheader + phi-rewrite)
    // जान-बूझकर बंद — कभी असली compiler पर validate नहीं हुआ। सीमा-उन्नयन
    // (option-b, कोई नया preheader block नहीं) ही wired है।
    सूची लूप_सूची = लूइनी_लूप_खोजें(फलन);
    मान बदला = असत्य;
    संख्या लू = ०;
    यावत् (लू < लंबाई(लूप_सूची)) {
        यदि (लूइनी_सीमा_उन्नयन(एकक, फलन, विश्लेषण, विश्लेषण_नक्शा, लूप_सूची[लू])) { बदला = सत्य; }
        लू = लू + १;
    }
    परत् बदला;
}


// ============================================================
// चालक — कॉलर पहले सामान्य अनुकूलक_एकक(एकक) चला चुका माना जाता (SSA साफ,
// mem2reg हो चुका) — फिर यहाँ module-वाइड points-to + हर फलन पर LICM।
// ============================================================

कार्य लूप_अनुकूलक_एकक(शब्दकोश एकक) {
    शब्दकोश विश्लेषण_नक्शा = कग_मॉड्यूल_विश्लेषण(एकक);
    सूची कस = एकक["कार्य_सूची"];
    संख्या इक = ०;
    यावत् (इक < लंबाई(कस)) {
        शब्दकोश फलन = कस[इक];
        शब्दकोश विश्लेषण = विश्लेषण_नक्शा[फलन["नाम"]];
        यदि (विश्लेषण != शून्यम्) {
            यदि (लूइनी_फलन(एकक, फलन, विश्लेषण, विश्लेषण_नक्शा)) {
                अनुकूलक_कार्य(फलन);   // preheader/phi-rewrite के बाद सामान्य सफाई फिर चलाओ
            }
        }
        इक = इक + १;
    }
    परत् एकक;
}
