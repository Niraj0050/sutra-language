// पुच्छ_अनुकूलन.सूत्र — self-tail-call optimization (TCO)
// ============================================================
// लक्ष्य: जब किसी फलन का पुनरावर्ती कॉल पुच्छ-स्थिति में हो (`परत्
// फलन(...);` — कॉल के बाद कुछ और नहीं होता), उसे call+return की जगह
// argument-rebind + loop-header पर जाओ में बदलना — call-overhead खत्म,
// stack-गहराई O(1) (गहरी accumulator-शैली पुनरावृत्ति अभी stack-overflow
// तक कर सकती, TCO वही ठीक करता, सिर्फ़ गति नहीं)।
//
// fib(35) जैसे non-tail self-recursion (`परत् अ*फिब(अ-1);`) को यह छूता
// नहीं — वहाँ कॉल के नतीजे पर आगे गणना होती, पुच्छ-स्थिति नहीं।
//
// दायरा (v1):
//   - सिर्फ़ self-recursion (लक्ष्य == फलन का अपना नाम) — mutual recursion
//     से बाहर, इनलाइनिंग v1 जैसा ही अनुशासन।
//   - कॉल खंड की आख़िरी निर्देश हो (सच्ची पुच्छ-स्थिति) + उसका नतीजा
//     सीधे उसी खंड के "वापस" का इकलौता संचालक हो + उस नतीजे का पूरे
//     फलन में उपयोग-गिनती ठीक 1 (कहीं और साझा न हो)।
//   - फलन का entry-खंड (खंड_सूची[0]) कभी candidate नहीं — "कोई base-case
//     ही नहीं" वाला विकृत मामला अलग रखता (जो वैसे भी कभी terminate न हो)।
// Multi-block/multi-site तो ठीक चलता — हर योग्य कॉल-स्थल अपना back-edge
// + phi-स्रोत जोड़ता, सब एक ही tco_सिर पर मिलते।
//
// अभी कहीं wire नहीं — केवल पुच्छ_अनुकूलन_परीक्षण.सूत्र से जाँचा।
// ============================================================

आयात "अनुकूलक.सूत्र";
आयात "लूप_अनुकूलन.सूत्र";

// क्या यह खंड सच्चा self-tail-call उम्मीदवार है? — {खंड, बुलाओ_निर्देश} या शून्यम्
कार्य पुअ_उम्मीदवार_जाँच(शब्दकोश फलन, शब्दकोश खंड, शब्दकोश मूल_प्रवेश, शब्दकोश उपयोग) {
    यदि (खंड == मूल_प्रवेश) { परत् शून्यम्; }
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम् || अंत["कोड"] != "वापस") { परत् शून्यम्; }
    सूची वा_संच = अंत["संचालक"];
    यदि (लंबाई(वा_संच) != 1) { परत् शून्यम्; }
    संख्या आर = वा_संच[0];

    सूची निस = खंड["निर्देश"];
    यदि (लंबाई(निस) == 0) { परत् शून्यम्; }
    शब्दकोश अंतिम = निस[लंबाई(निस) - 1];
    यदि (अंतिम["आईडी"] != आर || अंतिम["कोड"] != "बुलाओ") { परत् शून्यम्; }
    यदि (अंतिम["अंश"]["लक्ष्य"] != फलन["नाम"]) { परत् शून्यम्; }

    मान गिनती = उपयोग[आर];
    यदि (गिनती == शून्यम्) { गिनती = 0; }
    यदि (गिनती != 1) { परत् शून्यम्; }   // सिर्फ़ इसी वापस से उपयोग हो

    परत् अंतिम;
}

कार्य पुच्छ_अनुकूलन_फलन(शब्दकोश फलन) {
    शब्दकोश उपयोग = अनु_उपयोग_गणना(फलन);
    शब्दकोश मूल_प्रवेश = फलन["खंड_सूची"][0];

    // पास 1 — उम्मीदवार ढूँढो (कोई mutation नहीं अभी)
    सूची उम्मीदवार = [];   // [[खंड, बुलाओ_निर्देश], ...]
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश बुलाओ_नि = पुअ_उम्मीदवार_जाँच(फलन, खस[ख], मूल_प्रवेश, उपयोग);
        यदि (बुलाओ_नि != शून्यम्) { उम्मीदवार = जोड़ें(उम्मीदवार, [खस[ख], बुलाओ_नि]); }
        ख = ख + 1;
    }

    यदि (लंबाई(उम्मीदवार) == 0) { परत् असत्य; }

    // पास 2 — मूल_प्रवेश की देह tco_सिर पर ले जाओ
    शब्दकोश पुच्छ_सिर = मध्यम_नव_खंड(फलन, "tco_सिर");
    पुच्छ_सिर["फाई"] = मूल_प्रवेश["फाई"];
    पुच्छ_सिर["निर्देश"] = मूल_प्रवेश["निर्देश"];
    पुच्छ_सिर["अंत"] = मूल_प्रवेश["अंत"];
    मूल_प्रवेश["फाई"] = [];
    मूल_प्रवेश["निर्देश"] = [];
    मध्यम_जाओ(मूल_प्रवेश, पुच्छ_सिर["लेबल"]);

    // पास 3 — हर पैरामीटर: rename पहले, फिर phi (ताकि phi का अपना
    // entry-स्रोत rename में ग़लती से न बदल जाए)
    सूची पैरा = फलन["पैरामीटर"];
    सूची फाई_सूची = [];   // पैरामीटर-सूचकांक के समानांतर
    संख्या प = 0;
    यावत् (प < लंबाई(पैरा)) {
        संख्या मूल_आईडी = पैरा[प]["आईडी"];
        संख्या नई_आईडी = मध्यम_ताजा_आईडी(फलन);
        अनु_हर_उपयोग_बदलो(फलन, मूल_आईडी, नई_आईडी);

        शब्दकोश अंश = {};
        अंश["स्रोत"] = [[मूल_प्रवेश["लेबल"], मूल_आईडी]];
        शब्दकोश फाई_नोड = मध्यम_निर्देश_बनाओ("फाई", नई_आईडी, पैरा[प]["प्रकार"], [], अंश);
        पुच्छ_सिर["फाई"] = जोड़ें(पुच्छ_सिर["फाई"], फाई_नोड);
        फाई_सूची = जोड़ें(फाई_सूची, फाई_नोड);
        प = प + 1;
    }

    // पास 4 — हर उम्मीदवार खंड को back-edge में बदलो + phi-स्रोत जोड़ो
    संख्या उइ = 0;
    यावत् (उइ < लंबाई(उम्मीदवार)) {
        शब्दकोश खंड = उम्मीदवार[उइ][0];
        शब्दकोश बुलाओ_नि = उम्मीदवार[उइ][1];
        सूची तर्क = बुलाओ_नि["संचालक"];

        खंड["निर्देश"] = लूइनी_निर्देश_हटाओ(खंड["निर्देश"], बुलाओ_नि["आईडी"]);
        मध्यम_जाओ(खंड, पुच्छ_सिर["लेबल"]);

        संख्या प2 = 0;
        यावत् (प2 < लंबाई(फाई_सूची)) {
            सूची स्रोत = फाई_सूची[प2]["अंश"]["स्रोत"];
            फाई_सूची[प2]["अंश"]["स्रोत"] = जोड़ें(स्रोत, [खंड["लेबल"], तर्क[प2]]);
            प2 = प2 + 1;
        }
        उइ = उइ + 1;
    }

    परत् सत्य;
}

कार्य पुच्छ_अनुकूलन_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या इ = 0;
    यावत् (इ < लंबाई(कस)) {
        शब्दकोश फलन = कस[इ];
        यदि (पुच्छ_अनुकूलन_फलन(फलन)) {
            अनुकूलक_कार्य(फलन);
        }
        इ = इ + 1;
    }
    परत् एकक;
}
