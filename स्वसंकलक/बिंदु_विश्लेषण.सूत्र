// बिंदु_विश्लेषण.सूत्र — points-to विश्लेषण [Milestone 1: intraprocedural]
// ============================================================
// लक्ष्य: हर SSA मान के लिए "यह किन abstract heap-स्थलों की ओर इशारा
// कर सकता है" पता करना — ताकि अनुकूलक (LICM/CSE/GVN) यह जान सके कि दो
// अलग आधार-मान (जैसे किसी लूप के अंदर एक कॉल का argument बनाम लूप की
// शर्त में पढ़ी जा रही सूची) एक ही वस्तु को alias कर सकते हैं या नहीं —
// बिना alias-जानकारी के, हर कॉल को "कुछ भी बदल सकता है" मानना पड़ता,
// जो §4-सत्र में LICM/CSE को व्यावहारिक रूप से बेकार कर देता था।
//
// दायरा (Milestone 1 — यहीं तक): सिर्फ एक फलन के भीतर (intraprocedural)।
//   - कॉल के नतीजे तथा पैरामीटर अभी ⊤ ("पता नहीं, कुछ भी हो सकता") —
//     Milestone 2 इसे call-graph से refine करेगा (शुद्ध फलनों को पहचानकर)।
//   - field/index-insensitive: हर वस्तु का एक ही साझा "भंडार" — किस
//     विशेष क्षेत्र/सूचकांक में क्या रखा गया, अलग-अलग नहीं रखता (safe
//     over-approximation, बस कम सटीक)।
//   - flow-insensitive: निर्देशों का क्रम नहीं देखता, सिर्फ पूरे फलन में
//     "क्या हो सकता है" जमा करता (फिर से, safe over-approximation)।
//
// अभी कहीं wire नहीं — केवल बिंदु_विश्लेषण_परीक्षण.सूत्र से जाँचा।
// ============================================================

आयात "मध्यम.सूत्र";

// ⊤ (शीर्ष) — "पता नहीं, कुछ भी हो सकता" का सांकेतिक स्थल-आईडी।
// वास्तविक allocation-site आईडी हमेशा >= 1 (SSA में v0 आरक्षित), तो 0 सुरक्षित।
कार्य बिं_शीर्ष() { परत् ०; }

// dict-as-set: ब के सारे कुंजी अ में जोड़ो, कुछ नया जुड़ा तो सत्य लौटाओ
कार्य बिं_संघ(शब्दकोश अ, शब्दकोश ब) {
    यदि (ब == शून्यम्) { परत् असत्य; }
    मान बदला = असत्य;
    सूची कुं = कुंजियाँ(ब);
    संख्या इक = ०;
    यावत् (इक < लंबाई(कुं)) {
        यदि (अ[कुं[इक]] != सत्य) { अ[कुं[इक]] = सत्य; बदला = सत्य; }
        इक = इक + १;
    }
    परत् बदला;
}

कार्य बिं_एकल(संख्या स्थल) {
    शब्दकोश स = {};
    स[स्थल] = सत्य;
    परत् स;
}

// value-id -> प्रकार-टैग नक्शा (पैरामीटर + हर निर्देश + फाई)
कार्य बिं_प्रकार_नक्शा(शब्दकोश फलन) {
    शब्दकोश नक्शा = {};
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = ०;
    यावत् (प < लंबाई(पैरा)) { नक्शा[पैरा[प]["आईडी"]] = पैरा[प]["प्रकार"]; प = प + १; }
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        शब्दकोश खंड = खस[ख];
        सूची फस = खंड["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) { नक्शा[फस[फ]["आईडी"]] = फस[फ]["प्रकार"]; फ = फ + १; }
        सूची निस = खंड["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] >= १) { नक्शा[निस[नि]["आईडी"]] = निस[नि]["प्रकार"]; }
            नि = नि + १;
        }
        ख = ख + १;
    }
    परत् नक्शा;
}

// क्या यह मान एक heap-सूचक हो सकता है (GC-टैप्ड प्रकार)? नहीं तो
// points-to की कोई ज़रूरत नहीं (पूर्ण/दशमलव/बूल/शून्य)।
कार्य बिं_सूचक_है(शब्दकोश प्रकार_नक्शा, संख्या मव) {
    यदि (मव < १) { परत् असत्य; }
    मान टैग = प्रकार_नक्शा[मव];
    परत् मध्यम_जीसी_टैप्ड(टैग);
}

// ============================================================
// Milestone 3 — मूल_रनटाइम.सूत्र (अलग compilation unit, इसलिए इस
// विश्लेषण को इनका IR कभी नहीं दिखता) की हाथ-से-classify की गई तालिका।
// हर entry को असली स्रोत पढ़कर सोच-समझकर बनाया — ग़लत entry यहाँ silent
// miscompilation का सीधा रास्ता है, तो अनुमान नहीं, सिर्फ़ पढ़ा हुआ।
//
// "वापसी_प्रकार":
//   "शुद्ध"            — नतीजा हमेशा ताज़ा/असंबद्ध (किसी तर्क से alias नहीं)
//   "उपनाम"            — नतीजा ठीक "वापसी_तर्क" के बराबर alias करता
//                         (जैसे सूची_जोड़ — पुनः-आवंटन पर पता बदल सकता,
//                         पर तार्किक रूप से वही सूची, इसलिए alias मानना सुरक्षित)
//   "भंडार"            — नतीजा वो है जो "वापसी_तर्क" के अंदर पहले से रखा था
//                         (सूची/शब्दकोश/पाठ-सूचकांक पठन — पढ़_अनुक्रम जैसा)
//   "कंटेनर_प्रतिलिपि" — नतीजा एक नई वस्तु है, पर उसके तत्व "वापसी_तर्क"
//                         में जो रखा था उससे बने (जैसे शब्दकोश_कुंजियाँ_रन)
// "लेखन": [[लक्ष्य_तर्क_सूचकांक, स्रोत_तर्क_सूचकांक], ...] — कॉल के दौरान
//   लक्ष्य_तर्क के भंडार में स्रोत_तर्क का बिंदु जोड़ा जाता (लिख_अनुक्रम जैसा)।
// अज्ञात नाम -> शून्यम् (caller रूढ़िवादी ⊤ पर वापस गिरता — सुरक्षित default)।
// ============================================================
कार्य कग_पुस्तकालय_प्रभाव(पाठ नाम) {
    शब्दकोश प्र = {};

    // शुद्ध — कोई argument-लेखन नहीं, नतीजा हमेशा ताज़ा। सारे पाठ_* (पाठ
    // अपरिवर्तनीय — कभी argument में लिखते नहीं, हमेशा नया बनाकर byte-copy
    // करते — पाठ_जोड़/पाठ_रचना/पाठ_उपखंड/पाठ_योग_गतिक/पाठ_संयोग/अक्षर_बना
    // सबका स्रोत यही जाँचा गया)। सूची_रचना/शब्दकोश_रचना = ताज़ा-आवंटन ही।
    // बाकी सब यहाँ pure-पठन/int/bool नतीजे (pointer-प्रश्न उठता ही नहीं —
    // बिं_सूचक_है output-प्रकार से पहले ही गेट कर देता, तो "शुद्ध" यहाँ भी
    // सुरक्षित catch-all है)।
    यदि (नाम == "पाठ_जोड़" || नाम == "पाठ_रचना" || नाम == "पाठ_उपखंड"
        || नाम == "पाठ_योग_गतिक" || नाम == "पाठ_संयोग" || नाम == "अक्षर_बना"
        || नाम == "सूची_रचना" || नाम == "शब्दकोश_रचना" || नाम == "तर्क_सूची_रन"
        || नाम == "सञ्चिका_पढ़ो_रन" || नाम == "पाठ_तुल्य" || नाम == "पाठ_खोज_गतिक"
        || नाम == "दैशिक_लंबाई" || नाम == "अक्षर_कोडबिंदु" || नाम == "शब्दकोश_कुंजी_है"
        || नाम == "सामान्य_अधिक" || नाम == "सामान्य_अधिक_सम"
        || नाम == "सामान्य_न्यून" || नाम == "सामान्य_न्यून_सम"
        || नाम == "सञ्चिका_लिखो_रन" || नाम == "सञ्चिका_है_रन"
        || नाम == "समादेश_चलाओ_रन" || नाम == "सूत्र_स्वजीसी_आरंभ"
        || नाम == "गतिशील_छापो" || नाम == "सूची_सूचकांक_सेट") {
        प्र["वापसी_प्रकार"] = "शुद्ध";
        प्र["लेखन"] = [];
        यदि (नाम == "सूची_सूचकांक_सेट") { प्र["लेखन"] = [[०, २]]; }  // तर्क0.भंडार ∪= तर्क2
        परत् प्र;
    }

    // पाठ_सूचकांक — 1-अक्षर नई पाठ-वस्तु लौटाता (पाठ_प्रति से byte-copy),
    // स्रोत पाठ में कभी लिखता नहीं — पर "पाठ_सूचकांक" सूची_सूचकांक का हिस्सा
    // भी है (पाठ आधार पर), जहाँ नतीजा वैसे भी GC-टैप्ड "मान" के रूप में
    // पहले से ⊤-सुरक्षित रहता; यहाँ सीधे शुद्ध — नया, असंबद्ध।
    यदि (नाम == "पाठ_सूचकांक") {
        प्र["वापसी_प्रकार"] = "शुद्ध"; प्र["लेखन"] = []; परत् प्र;
    }

    // सूची_सूचकांक — जो कुछ आधार (तर्क0) में पहले से store था वही पढ़ता,
    // कोई लेखन नहीं (सूची_सूचकांक.सूत्र: सीमा-जाँच + अंतर्_पढ़8 सीधा, या
    // पाठ_सूचकांक/शब्दकोश_पाओ को delegate — दोनों भी अपने आधार में लिखते नहीं)।
    यदि (नाम == "सूची_सूचकांक") {
        प्र["वापसी_प्रकार"] = "भंडार"; प्र["वापसी_तर्क"] = ०; प्र["लेखन"] = [];
        परत् प्र;
    }

    // शब्दकोश_कुंजियाँ_रन — नई सूची बनाता (सूची_रचना), पर हर तत्व मूल कोष
    // (तर्क0) की entries से copy होता — तो नतीजे का भंडार कोष के भंडार से।
    यदि (नाम == "शब्दकोश_कुंजियाँ_रन") {
        प्र["वापसी_प्रकार"] = "कंटेनर_प्रतिलिपि"; प्र["वापसी_तर्क"] = ०; प्र["लेखन"] = [];
        परत् प्र;
    }

    // सूची_जोड़ — तर्क1 (मूल्य) को तर्क0 (सर) में store करता; क्षमता कम
    // पड़े तो सूत्र_पुनः_आवंटन से नया पता भी आ सकता — फिर भी तार्किक रूप
    // से वही सूची, तो नतीजा = तर्क0 का उपनाम मानना सुरक्षित है।
    यदि (नाम == "सूची_जोड़") {
        प्र["वापसी_प्रकार"] = "उपनाम"; प्र["वापसी_तर्क"] = ०;
        प्र["लेखन"] = [[०, १]];
        परत् प्र;
    }

    // सूची_निकाल — कोई नया मान store नहीं करता (आख़िरी तत्व शून्य कर हटाता),
    // बस gणना घटाता + कभी-कभी सिकोड़ता (फिर भी वही तार्किक सूची)।
    यदि (नाम == "सूची_निकाल") {
        प्र["वापसी_प्रकार"] = "उपनाम"; प्र["वापसी_तर्क"] = ०; प्र["लेखन"] = [];
        परत् प्र;
    }

    परत् शून्यम्;   // अज्ञात — caller ⊤ पर वापस गिरेगा
}

// कग_पुस्तकालय_प्रभाव का "लेखन" भाग इस कॉल-निर्देश पर लागू करो
कार्य कग_लेखन_लागू(शब्दकोश बिंदु, शब्दकोश भंडार, सूची लेखन, सूची तर्क) {
    मान बदला = असत्य;
    संख्या ल = ०;
    यावत् (ल < लंबाई(लेखन)) {
        संख्या लक्ष्य_सू = लेखन[ल][०];
        संख्या स्रोत_सू = लेखन[ल][१];
        यदि (लक्ष्य_सू < लंबाई(तर्क) && स्रोत_सू < लंबाई(तर्क)) {
            संख्या लक्ष्य_आईडी = तर्क[लक्ष्य_सू];
            संख्या स्रोत_आईडी = तर्क[स्रोत_सू];
            यदि (लक्ष्य_आईडी >= १) {
                मान लक्ष्य_बिं = बिंदु[लक्ष्य_आईडी];
                यदि (लक्ष्य_बिं != शून्यम्) {
                    सूची स्थल_कुं = कुंजियाँ(लक्ष्य_बिं);
                    संख्या स = ०;
                    यावत् (स < लंबाई(स्थल_कुं)) {
                        मान भं = भंडार[स्थल_कुं[स]];
                        यदि (भं == शून्यम्) { भं = {}; भंडार[स्थल_कुं[स]] = भं; }
                        यदि (स्रोत_आईडी >= १) {
                            यदि (बिं_संघ(भं, बिंदु[स्रोत_आईडी])) { बदला = सत्य; }
                        }
                        स = स + १;
                    }
                }
            }
        }
        ल = ल + १;
    }
    परत् बदला;
}

// कग_पुस्तकालय_प्रभाव के "लेखन" भाग से — इस कॉल में कौन-कौन से स्थल लिखे
// गए, प्रत्यक्ष_लेखन (फलन का written-sites संचयक) में दर्ज करो (Milestone 4)
कार्य कग_लेखन_दर्ज(शब्दकोश प्रत्यक्ष_लेखन, शब्दकोश बिंदु, सूची लेखन, सूची तर्क) {
    संख्या ल = ०;
    यावत् (ल < लंबाई(लेखन)) {
        संख्या लक्ष्य_सू = लेखन[ल][०];
        यदि (लक्ष्य_सू < लंबाई(तर्क)) {
            संख्या लक्ष्य_आईडी = तर्क[लक्ष्य_सू];
            यदि (लक्ष्य_आईडी >= १) { बिं_संघ(प्रत्यक्ष_लेखन, बिंदु[लक्ष्य_आईडी]); }
        }
        ल = ल + १;
    }
    परत् ०;
}

// कग_पुस्तकालय_प्रभाव के "वापसी_प्रकार" के अनुसार नतीजे का बिंदु-सेट बनाओ
कार्य कग_वापसी_बिंदु_गणना(शब्दकोश बिंदु, शब्दकोश भंडार, शब्दकोश प्रभाव, सूची तर्क, संख्या दस) {
    पाठ वट = प्रभाव["वापसी_प्रकार"];
    यदि (वट == "शुद्ध") { परत् बिं_एकल(दस); }

    संख्या अनु = प्रभाव["वापसी_तर्क"];
    संख्या आ = ० - १;
    यदि (अनु < लंबाई(तर्क)) { आ = तर्क[अनु]; }
    मान आ_बिं = शून्यम्;
    यदि (आ >= १) { आ_बिं = बिंदु[आ]; }

    यदि (वट == "उपनाम") {
        यदि (आ_बिं != शून्यम्) { परत् आ_बिं; }
        परत् बिं_एकल(बिं_शीर्ष());
    }
    यदि (वट == "भंडार") {
        शब्दकोश नतीजा = {};
        यदि (आ_बिं != शून्यम्) {
            सूची स्थल_कुं = कुंजियाँ(आ_बिं);
            संख्या स = ०;
            यावत् (स < लंबाई(स्थल_कुं)) { बिं_संघ(नतीजा, भंडार[स्थल_कुं[स]]); स = स + १; }
        }
        परत् नतीजा;
    }
    यदि (वट == "कंटेनर_प्रतिलिपि") {
        शब्दकोश नतीजा = बिं_एकल(दस);
        यदि (आ_बिं != शून्यम्) {
            सूची स्थल_कुं = कुंजियाँ(आ_बिं);
            संख्या स = ०;
            यावत् (स < लंबाई(स्थल_कुं)) { बिं_संघ(नतीजा, भंडार[स्थल_कुं[स]]); स = स + १; }
        }
        परत् नतीजा;
    }
    परत् बिं_एकल(बिं_शीर्ष());   // अपरिचित टैग — रूढ़िवादी
}

// Milestone 1 प्रवेश-बिंदु — पैरामीटर/कॉल-नतीजे हमेशा ⊤ (कोई cross-फलन
// जानकारी नहीं)। पीछे-संगत — मौजूदा टेस्ट + व्यवहार बिल्कुल अपरिवर्तित।
कार्य बिं_फलन_विश्लेषण(शब्दकोश फलन) {
    परत् बिं_फलन_विश्लेषण_सन्दर्भ(फलन, शून्यम्);
}

// मुख्य विश्लेषण — {"बिंदु":.., "भंडार":.., "प्रकार_नक्शा":..} लौटाता।
// संदर्भ (Milestone 2, वैकल्पिक — शून्यम् = Milestone-1 व्यवहार):
//   संदर्भ["पैरा_बिंदु"]["<फलन-नाम>#<index>"]  -> {स्थल: सत्य}
//     (कॉल-स्थलों के argument-बिंदुओं का संघ — कग_मॉड्यूल_विश्लेषण भरता)
//   संदर्भ["वापसी_बिंदु"]["<फलन-नाम>"]         -> {स्थल: सत्य}
//     (उस फलन के सारे `वापस मान` का संघ)
// दोनों में सीड न मिले (शून्यम्) तो हमेशा ⊤ पर वापस गिरता — सुरक्षित default।
कार्य बिं_फलन_विश्लेषण_सन्दर्भ(शब्दकोश फलन, शब्दकोश संदर्भ) {
    शब्दकोश प्रकार_नक्शा = बिं_प्रकार_नक्शा(फलन);
    शब्दकोश बिंदु = {};   // value-id -> {स्थल-आईडी: सत्य, ...}
    शब्दकोश भंडार = {};   // स्थल-आईडी -> {स्थल-आईडी: सत्य, ...}
    // इस फलन के दौरान कौन-कौन से स्थल लिखे जा सकते हैं — प्रत्यक्ष (अपना
    // लिख_अनुक्रम/लिख_क्षेत्र + library-कॉल का लेखन) + transitively callees
    // का (Milestone 4 — LICM को "लूप में कॉल = मत छुओ" की जगह "लूप में
    // कॉल जो *यह* वस्तु लिख सकता = मत छुओ" पूछने देने को)।
    शब्दकोश प्रत्यक्ष_लेखन = {};

    शब्दकोश पैरा_बिंदु = शून्यम्;
    शब्दकोश लिखे_स्थल_संदर्भ = शून्यम्;
    यदि (संदर्भ != शून्यम्) {
        पैरा_बिंदु = संदर्भ["पैरा_बिंदु"];
        लिखे_स्थल_संदर्भ = संदर्भ["लिखे_स्थल"];
    }

    // प्रारंभ: पैरामीटर — पता हो तो कॉलरों के argument-बिंदु से, वरना ⊤
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = ०;
    यावत् (प < लंबाई(पैरा)) {
        यदि (बिं_सूचक_है(प्रकार_नक्शा, पैरा[प]["आईडी"])) {
            मान सीड = शून्यम्;
            यदि (पैरा_बिंदु != शून्यम्) { सीड = पैरा_बिंदु[फलन["नाम"] + "#" + प]; }
            यदि (सीड == शून्यम् || लंबाई(कुंजियाँ(सीड)) == ०) { सीड = बिं_एकल(बिं_शीर्ष()); }
            बिंदु[पैरा[प]["आईडी"]] = सीड;
        }
        प = प + १;
    }

    // फिक्सपॉइंट — allocation seeds + प्रचार, स्थिर होने तक दोहराओ
    मान बदला = सत्य;
    संख्या दौर = ०;
    यावत् (बदला && दौर < ५०) {
        बदला = असत्य;
        प्रत्यक्ष_लेखन = {};   // हर दौर ताज़ा — अंतिम स्थिर दौर का ही मायने रखता
        सूची खस = फलन["खंड_सूची"];
        संख्या ख = ०;
        यावत् (ख < लंबाई(खस)) {
            शब्दकोश खंड = खस[ख];

            सूची फस = खंड["फाई"];
            संख्या फ = ०;
            यावत् (फ < लंबाई(फस)) {
                शब्दकोश फ_नोड = फस[फ];
                यदि (बिं_सूचक_है(प्रकार_नक्शा, फ_नोड["आईडी"])) {
                    मान वर्त = बिंदु[फ_नोड["आईडी"]];
                    यदि (वर्त == शून्यम्) { वर्त = {}; बिंदु[फ_नोड["आईडी"]] = वर्त; }
                    सूची स्रोत = फ_नोड["अंश"]["स्रोत"];
                    संख्या ज = ०;
                    यावत् (ज < लंबाई(स्रोत)) {
                        संख्या स्रोत_आईडी = स्रोत[ज][१];
                        यदि (स्रोत_आईडी >= १) {
                            यदि (बिं_संघ(वर्त, बिंदु[स्रोत_आईडी])) { बदला = सत्य; }
                        }
                        ज = ज + १;
                    }
                }
                फ = फ + १;
            }

            सूची निस = खंड["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश निर्देश = निस[नि];
                पाठ कोड = निर्देश["कोड"];
                संख्या दस = निर्देश["आईडी"];

                यदि (कोड == "नव_सूची" || कोड == "नव_शब्दकोश" || कोड == "नव_वस्तु" || कोड == "नव_पाठ") {
                    यदि (बिंदु[दस] == शून्यम्) { बिंदु[दस] = बिं_एकल(दस); बदला = सत्य; }
                    मान भं = भंडार[दस];
                    यदि (भं == शून्यम्) { भं = {}; भंडार[दस] = भं; }
                    सूची संच = निर्देश["संचालक"];
                    संख्या स = ०;
                    यावत् (स < लंबाई(संच)) {
                        यदि (संच[स] >= १) {
                            यदि (बिं_संघ(भं, बिंदु[संच[स]])) { बदला = सत्य; }
                        }
                        स = स + १;
                    }
                } अन्यथा यदि (कोड == "स्थिर" && निर्देश["अंश"]["मान_प्रकार"] == "पाठ") {
                    यदि (बिंदु[दस] == शून्यम्) { बिंदु[दस] = बिं_एकल(दस); बदला = सत्य; }
                } अन्यथा यदि (कोड == "लिख_अनुक्रम" || कोड == "लिख_क्षेत्र") {
                    सूची संच = निर्देश["संचालक"];
                    संख्या आधार = संच[०];
                    संख्या मान_आईडी = संच[लंबाई(संच) - १];
                    मान आधार_बिं = बिंदु[आधार];
                    बिं_संघ(प्रत्यक्ष_लेखन, आधार_बिं);   // यह लिखे जाने वाले स्थल दर्ज करो
                    यदि (आधार_बिं != शून्यम्) {
                        सूची स्थल_कुं = कुंजियाँ(आधार_बिं);
                        संख्या स = ०;
                        यावत् (स < लंबाई(स्थल_कुं)) {
                            संख्या स्थल = स्थल_कुं[स];
                            मान भं = भंडार[स्थल];
                            यदि (भं == शून्यम्) { भं = {}; भंडार[स्थल] = भं; }
                            यदि (मान_आईडी >= १) {
                                यदि (बिं_संघ(भं, बिंदु[मान_आईडी])) { बदला = सत्य; }
                            }
                            स = स + १;
                        }
                    }
                } अन्यथा यदि (कोड == "पढ़_अनुक्रम" || कोड == "पढ़_क्षेत्र") {
                    यदि (बिं_सूचक_है(प्रकार_नक्शा, दस)) {
                        संख्या आधार = निर्देश["संचालक"][०];
                        मान आधार_बिं = बिंदु[आधार];
                        मान वर्त = बिंदु[दस];
                        यदि (वर्त == शून्यम्) { वर्त = {}; बिंदु[दस] = वर्त; }
                        यदि (आधार_बिं != शून्यम्) {
                            सूची स्थल_कुं = कुंजियाँ(आधार_बिं);
                            संख्या स = ०;
                            यावत् (स < लंबाई(स्थल_कुं)) {
                                यदि (बिं_संघ(वर्त, भंडार[स्थल_कुं[स]])) { बदला = सत्य; }
                                स = स + १;
                            }
                        }
                    }
                } अन्यथा यदि (कोड == "बुलाओ") {
                    // Milestone 3: लक्ष्य module-बाहरी (library) फलन हो तो
                    // हाथ-वर्गीकृत तालिका से — पहले लेखन-प्रभाव (दस pointer
                    // हो या न हो, सूची_सूचकांक_सेट जैसों का नतीजा पूर्ण/शून्य
                    // होता पर लेखन तब भी लागू होना चाहिए), फिर नतीजे का बिंदु।
                    पाठ लक्ष्य_नाम = निर्देश["अंश"]["लक्ष्य"];
                    सूची तर्क = निर्देश["संचालक"];
                    मान प्रभाव = कग_पुस्तकालय_प्रभाव(लक्ष्य_नाम);
                    यदि (प्रभाव != शून्यम्) {
                        यदि (कग_लेखन_लागू(बिंदु, भंडार, प्रभाव["लेखन"], तर्क)) { बदला = सत्य; }
                        कग_लेखन_दर्ज(प्रत्यक्ष_लेखन, बिंदु, प्रभाव["लेखन"], तर्क);
                    } अन्यथा यदि (लिखे_स्थल_संदर्भ != शून्यम् && लिखे_स्थल_संदर्भ[लक्ष्य_नाम] != शून्यम्) {
                        // Milestone 4: module-भीतरी callee — उसका (पिछले
                        // दौर का, Jacobi) लिखे-स्थल यहाँ transitively जोड़ो
                        बिं_संघ(प्रत्यक्ष_लेखन, लिखे_स्थल_संदर्भ[लक्ष्य_नाम]);
                    } अन्यथा {
                        // पूरी तरह अपरिचित (library-तालिका में नहीं, module
                        // में भी नहीं मिला) — रूढ़िवादी मान लो: कुछ भी लिख सकता
                        बिं_संघ(प्रत्यक्ष_लेखन, बिं_एकल(बिं_शीर्ष()));
                    }

                    यदि (बिं_सूचक_है(प्रकार_नक्शा, दस)) {
                        मान ज्ञात = शून्यम्;
                        यदि (प्रभाव != शून्यम्) {
                            ज्ञात = कग_वापसी_बिंदु_गणना(बिंदु, भंडार, प्रभाव, तर्क, दस);
                        } अन्यथा यदि (संदर्भ != शून्यम्) {
                            शब्दकोश वापसी_बिंदु = संदर्भ["वापसी_बिंदु"];
                            यदि (वापसी_बिंदु != शून्यम्) { ज्ञात = वापसी_बिंदु[निर्देश["अंश"]["लक्ष्य"]]; }
                        }
                        यदि (ज्ञात != शून्यम्) {
                            मान वर्त = बिंदु[दस];
                            यदि (वर्त == शून्यम्) { वर्त = {}; बिंदु[दस] = वर्त; }
                            यदि (बिं_संघ(वर्त, ज्ञात)) { बदला = सत्य; }
                        } अन्यथा यदि (बिंदु[दस] == शून्यम्) {
                            बिंदु[दस] = बिं_एकल(बिं_शीर्ष());
                            बदला = सत्य;
                        }
                    }
                } अन्यथा यदि (कोड == "अंतर्" || कोड == "विधि_बुलाओ") {
                    यदि (बिं_सूचक_है(प्रकार_नक्शा, दस) && बिंदु[दस] == शून्यम्) {
                        बिंदु[दस] = बिं_एकल(बिं_शीर्ष());
                        बदला = सत्य;
                    }
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
        दौर = दौर + १;
    }

    शब्दकोश परिणाम = {};
    परिणाम["बिंदु"] = बिंदु;
    परिणाम["भंडार"] = भंडार;
    परिणाम["प्रकार_नक्शा"] = प्रकार_नक्शा;
    परिणाम["प्रत्यक्ष_लेखन"] = प्रत्यक्ष_लेखन;
    परत् परिणाम;
}

// ============================================================
// Milestone 2 — interprocedural, एक ही एकक के भीतर
//
// विधि-कॉल असल में सादा "बुलाओ" opcode है (निम्नक ने "वर्ग_<X>_<विधि>"
// नाम में statically resolve कर दिया — देखें मूल_निम्नक.सूत्र की
// निम्नक_अभिव्यक्ति "अभिव्यक्ति_विधि_कॉल" case); "विधि_बुलाओ" opcode
// मध्यम.सूत्र में दस्तावेज़ है पर lowering कभी इसे उत्सर्जित नहीं करता
// (मूल_उत्सर्जक की टिप्पणी: "स्थगित")। तो सिर्फ "बुलाओ" संभालना काफ़ी —
// कोई indirect/virtual dispatch है ही नहीं (कोई first-class fn नहीं)।
//
// तरीका: context-insensitive (सारे call-site एक साथ merge), पूरे
// मॉड्यूल पर एक बाहरी fixpoint — हर दौर में हर फलन का intraprocedural
// विश्लेषण ताज़ा पैरा/वापसी-बिंदु सीड से दोहराया जाता, जब तक कुछ न बदले।
// पुनरावर्तन (recursion/चक्र) अपने-आप संभल जाता — कोई SCC-क्रम ज़रूरी नहीं,
// बस मोनोटोन संघ (सेट सिर्फ़ बढ़ते, कभी घटते नहीं) की वजह से fixpoint है।
// module के बाहर के कॉल (library — Milestone 3) अब भी ⊤।
// ============================================================

कार्य कग_फलन_नक्शा(शब्दकोश एकक) {
    शब्दकोश नक्शा = {};
    सूची कस = एकक["कार्य_सूची"];
    संख्या इक = ०;
    यावत् (इक < लंबाई(कस)) { नक्शा[कस[इक]["नाम"]] = कस[इक]; इक = इक + १; }
    परत् नक्शा;
}

// लक्ष्य-नाम -> [[कॉलर-फलन, बुलाओ-निर्देश], ...] सारे "बुलाओ" कॉल-स्थल
कार्य कग_कॉल_स्थल_खोजें(शब्दकोश एकक) {
    शब्दकोश स्थल = {};
    सूची कस = एकक["कार्य_सूची"];
    संख्या इक = ०;
    यावत् (इक < लंबाई(कस)) {
        शब्दकोश फलन = कस[इक];
        सूची खस = फलन["खंड_सूची"];
        संख्या ख = ०;
        यावत् (ख < लंबाई(खस)) {
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश निर्देश = निस[नि];
                यदि (निर्देश["कोड"] == "बुलाओ") {
                    पाठ लक्ष्य = निर्देश["अंश"]["लक्ष्य"];
                    मान सू = स्थल[लक्ष्य];
                    यदि (सू == शून्यम्) { सू = []; }
                    स्थल[लक्ष्य] = जोड़ें(सू, [फलन, निर्देश]);
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
        इक = इक + १;
    }
    परत् स्थल;
}

// फलन के सारे `वापस मान` का points-to संघ
कार्य कग_वापसी_बिंदु_निकालो(शब्दकोश फलन, शब्दकोश परिणाम) {
    शब्दकोश बिंदु = परिणाम["बिंदु"];
    शब्दकोश परिणामी = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        मान अंत = खस[ख]["अंत"];
        यदि (अंत != शून्यम् && अंत["कोड"] == "वापस" && लंबाई(अंत["संचालक"]) > ०) {
            संख्या मान_आईडी = अंत["संचालक"][०];
            यदि (मान_आईडी >= १) { बिं_संघ(परिणामी, बिंदु[मान_आईडी]); }
        }
        ख = ख + १;
    }
    परत् परिणामी;
}

// दो dict-as-set बराबर हैं? (सम कुंजी-गिनती + हर कुंजी दोनों में)
कार्य बिं_सेट_बराबर(शब्दकोश अ, शब्दकोश ब) {
    यदि (अ == शून्यम् && ब == शून्यम्) { परत् सत्य; }
    यदि (अ == शून्यम् || ब == शून्यम्) { परत् असत्य; }
    सूची कुं = कुंजियाँ(अ);
    यदि (लंबाई(कुं) != लंबाई(कुंजियाँ(ब))) { परत् असत्य; }
    संख्या इक = ०;
    यावत् (इक < लंबाई(कुं)) {
        यदि (ब[कुं[इक]] != सत्य) { परत् असत्य; }
        इक = इक + १;
    }
    परत् सत्य;
}

// दो "कुंजी -> dict-as-set" नक्शे बराबर हैं?
कार्य कग_नक्शा_बराबर(शब्दकोश अ, शब्दकोश ब) {
    सूची कुं = कुंजियाँ(अ);
    यदि (लंबाई(कुं) != लंबाई(कुंजियाँ(ब))) { परत् असत्य; }
    संख्या इक = ०;
    यावत् (इक < लंबाई(कुं)) {
        यदि (न बिं_सेट_बराबर(अ[कुं[इक]], ब[कुं[इक]])) { परत् असत्य; }
        इक = इक + १;
    }
    परत् सत्य;
}

// पूरे एकक पर interprocedural fixpoint — फलन-नाम -> बिं_फलन_विश्लेषण
// परिणाम (अंतिम दौर का) लौटाता।
//
// ध्यान: वापसी_बिंदु/पैरा_बिंदु हर दौर में ताज़ा से फिर बनते (पुराने
// दौर के मान में संघ (union) नहीं जोड़े जाते)। कारण: दौर 1 में किसी
// फलन के कॉल-स्थल अभी न मिले हों तो उसका पैरामीटर ⊤ मान लिया जाता —
// पर दौर 2 में सही कॉल-स्थल मिलने पर असली (छोटा, ज़्यादा सटीक) सेट
// पता चलता। यदि नए (छोटे, सटीक) मान को पुराने (⊤) में संघ करते तो ⊤
// हमेशा के लिए चिपक जाता — कभी परिशुद्ध ही न होता। हर दौर में ताज़ा
// गणना खुद ही स्थिर होते ही रुक जाती (दो लगातार दौर बराबर = fixpoint),
// इसलिए दौरों के बीच संचय (accumulate) करने की ज़रूरत ही नहीं।
कार्य कग_मॉड्यूल_विश्लेषण(शब्दकोश एकक) {
    शब्दकोश फलन_नक्शा = कग_फलन_नक्शा(एकक);
    शब्दकोश कॉल_स्थल = कग_कॉल_स्थल_खोजें(एकक);
    सूची कस = एकक["कार्य_सूची"];
    सूची फलन_नाम_सूची = कुंजियाँ(फलन_नक्शा);

    शब्दकोश विश्लेषण_नक्शा = {};   // फलन-नाम -> नवीनतम बिं_फलन_विश्लेषण परिणाम
    शब्दकोश वापसी_बिंदु = {};      // फलन-नाम -> {स्थल: सत्य}  (पिछले दौर का)
    शब्दकोश पैरा_बिंदु = {};       // "फलन-नाम#index" -> {स्थल: सत्य}  (पिछले दौर का)
    शब्दकोश लिखे_स्थल = {};        // फलन-नाम -> {स्थल: सत्य}  (Milestone 4, पिछले दौर का)

    मान बदला = सत्य;
    संख्या बाहरी_दौर = ०;
    यावत् (बदला && बाहरी_दौर < २०) {
        शब्दकोश संदर्भ = {};
        संदर्भ["पैरा_बिंदु"] = पैरा_बिंदु;
        संदर्भ["वापसी_बिंदु"] = वापसी_बिंदु;
        संदर्भ["लिखे_स्थल"] = लिखे_स्थल;

        शब्दकोश नई_वापसी_बिंदु = {};
        शब्दकोश नई_लिखे_स्थल = {};
        संख्या इक = ०;
        यावत् (इक < लंबाई(कस)) {
            शब्दकोश फलन = कस[इक];
            शब्दकोश परिणाम = बिं_फलन_विश्लेषण_सन्दर्भ(फलन, संदर्भ);
            विश्लेषण_नक्शा[फलन["नाम"]] = परिणाम;
            नई_वापसी_बिंदु[फलन["नाम"]] = कग_वापसी_बिंदु_निकालो(फलन, परिणाम);
            नई_लिखे_स्थल[फलन["नाम"]] = परिणाम["प्रत्यक्ष_लेखन"];
            इक = इक + १;
        }

        // हर फलन के पैरामीटर — इसी दौर के ताज़ा विश्लेषण से, उसके
        // कॉल-स्थलों पर argument-बिंदुओं का संघ (अलग-अलग कॉलर मिलाना
        // ठीक है — यह दौरों के बीच नहीं, एक ही दौर के भीतर है)
        शब्दकोश नई_पैरा_बिंदु = {};
        इक = ०;
        यावत् (इक < लंबाई(फलन_नाम_सूची)) {
            पाठ नाम = फलन_नाम_सूची[इक];
            सूची स्थल = कॉल_स्थल[नाम];
            यदि (स्थल != शून्यम्) {
                शब्दकोश लक्ष्य_फलन = फलन_नक्शा[नाम];
                सूची पैरा = लक्ष्य_फलन["पैरामीटर"];
                संख्या ज = ०;
                यावत् (ज < लंबाई(स्थल)) {
                    शब्दकोश कॉलर = स्थल[ज][०];
                    शब्दकोश निर्देश = स्थल[ज][१];
                    शब्दकोश कॉलर_विश्लेषण = विश्लेषण_नक्शा[कॉलर["नाम"]];
                    यदि (कॉलर_विश्लेषण != शून्यम्) {
                        सूची तर्क = निर्देश["संचालक"];
                        संख्या प = ०;
                        यावत् (प < लंबाई(पैरा) && प < लंबाई(तर्क)) {
                            संख्या तर्क_आईडी = तर्क[प];
                            यदि (तर्क_आईडी >= १) {
                                पाठ कुं = नाम + "#" + प;
                                मान वर्त = नई_पैरा_बिंदु[कुं];
                                यदि (वर्त == शून्यम्) { वर्त = {}; नई_पैरा_बिंदु[कुं] = वर्त; }
                                बिं_संघ(वर्त, कॉलर_विश्लेषण["बिंदु"][तर्क_आईडी]);
                            }
                            प = प + १;
                        }
                    }
                    ज = ज + १;
                }
            }
            इक = इक + १;
        }

        बदला = असत्य;
        यदि (न कग_नक्शा_बराबर(वापसी_बिंदु, नई_वापसी_बिंदु)) { बदला = सत्य; }
        यदि (न कग_नक्शा_बराबर(पैरा_बिंदु, नई_पैरा_बिंदु)) { बदला = सत्य; }
        यदि (न कग_नक्शा_बराबर(लिखे_स्थल, नई_लिखे_स्थल)) { बदला = सत्य; }
        वापसी_बिंदु = नई_वापसी_बिंदु;
        पैरा_बिंदु = नई_पैरा_बिंदु;
        लिखे_स्थल = नई_लिखे_स्थल;

        बाहरी_दौर = बाहरी_दौर + १;
    }

    परत् विश्लेषण_नक्शा;
}

// दो स्थल-सेट (dict-as-set) संभवतः एक साझा स्थल रखते हैं? (रूढ़िवादी —
// जानकारी न हो या ⊤ शामिल हो तो सत्य — caller हमेशा सुरक्षित रहे)
कार्य बिं_स्थल_अतिच्छादन(शब्दकोश अ, शब्दकोश ब) {
    यदि (अ == शून्यम् || ब == शून्यम्) { परत् सत्य; }
    यदि (अ[बिं_शीर्ष()] == सत्य || ब[बिं_शीर्ष()] == सत्य) { परत् सत्य; }
    सूची कुं = कुंजियाँ(अ);
    संख्या इक = ०;
    यावत् (इक < लंबाई(कुं)) {
        यदि (ब[कुं[इक]] == सत्य) { परत् सत्य; }
        इक = इक + १;
    }
    परत् असत्य;
}

// दो value-id संभवतः एक ही वस्तु को alias करते हैं?
कार्य बिं_उपनाम_हो_सकता(शब्दकोश विश्लेषण, संख्या अ, संख्या ब) {
    शब्दकोश बिंदु = विश्लेषण["बिंदु"];
    परत् बिं_स्थल_अतिच्छादन(बिंदु[अ], बिंदु[ब]);
}

// Milestone 4 — किसी फलन-विश्लेषण के "प्रत्यक्ष_लेखन" (उस फलन को बुलाने
// पर transitively जो-जो स्थल लिखे जा सकते) में से कोई value-id "आईडी"
// के बिंदु-सेट से टकराता है? (LICM को "यह कॉल *इस* वस्तु को छू सकता है
// क्या" पूछने देने को — "लूप में कोई भी कॉल = मत छुओ" से कहीं ज़्यादा सटीक)
कार्य कग_लेखन_छू_सकता(शब्दकोश विश्लेषण, संख्या आईडी) {
    परत् बिं_स्थल_अतिच्छादन(विश्लेषण["बिंदु"][आईडी], विश्लेषण["प्रत्यक्ष_लेखन"]);
}
