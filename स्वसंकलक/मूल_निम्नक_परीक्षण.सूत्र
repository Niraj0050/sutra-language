// मूल_निम्नक_परीक्षण.सूत्र — AST→IR lowering (Phase 1b) का test
// असली parser से source string को AST बनाओ, फिर lower करो, IR डंप जाँचो।
// चलाओ:  sutrac.exe स्वसंकलक\मूल_निम्नक_परीक्षण.सूत्र  &&  <exe>

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";

मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश आयातित = {};
    परत् प्रोग्राम_पार्स(अवस्था, आयातित, "परीक्षण");
}

कार्य निम्न_करो(पाठ स्रोत) {
    शब्दकोश प्रो = पार्स_करो(स्रोत);
    शब्दकोश एकक = निम्नक_एकक(प्रो);
    परत् मध्यम_छापो_एकक(एकक);
}

कार्य है(पाठ हेस्टैक, पाठ सुई) {
    परत् खोजें(हेस्टैक, सुई) >= 0;
}

कार्य मुख्य() {

    // ---- 1. सरल कार्य: params, slot, load, add, return ----
    पाठ द1 = निम्न_करो("कार्य जोड़(संख्या अ, संख्या ब) { परत् अ + ब; }");
    लिखतु("--- test 1 ---");
    लिखतु(द1);
    जाँच("1 फलन शीर्षक", है(द1, "फलन जोड़(v1: पूर्ण, v2: पूर्ण) -> मान"));
    जाँच("1 पैरा-स्लॉट लिखना", है(द1, "लिख_स्लॉट"));
    जाँच("1 पढ़_स्लॉट", है(द1, "पढ़_स्लॉट"));
    जाँच("1 योग निर्देश", है(द1, "योग "));
    जाँच("1 वापस", है(द1, "वापस v"));

    // ---- 2. यदि/अन्यथा ----
    पाठ द2 = निम्न_करो("कार्य म(संख्या स) { यदि (स > 0) { परत् 1; } अन्यथा { परत् 0; } }");
    लिखतु("--- test 2 ---");
    लिखतु(द2);
    जाँच("2 गुरु तुलना", है(द2, "गुरु "));
    जाँच("2 यदि_जाओ", है(द2, "यदि_जाओ"));
    जाँच("2 सत्य-शाखा लेबल", है(द2, "if_सत्य_"));
    जाँच("2 असत्य-शाखा लेबल", है(द2, "if_असत्य_"));
    जाँच("2 अंत लेबल", है(द2, "if_अंत_"));

    // ---- 3. यावत् + विराम ----
    पाठ द3 = निम्न_करो("कार्य ल() { संख्या इ = 0; यावत् (इ < 10) { इ = इ + 1; यदि (इ == 5) { विरामः; } } }");
    लिखतु("--- test 3 ---");
    लिखतु(द3);
    जाँच("3 शर्त खंड", है(द3, "wh_शर्त_"));
    जाँच("3 देह खंड", है(द3, "wh_देह_"));
    जाँच("3 अंत खंड", है(द3, "wh_अंत_"));
    जाँच("3 विराम → जाओ अंत", है(द3, "जाओ wh_अंत_"));
    जाँच("3 लूप-बैक → जाओ शर्त", है(द3, "जाओ wh_शर्त_"));

    // ---- 4. && short-circuit → शाखाएँ + फाई ----
    पाठ द4 = निम्न_करो("कार्य स(बूल क, बूल ख) { यदि (क && ख) { परत् 1; } परत् 0; }");
    लिखतु("--- test 4 ---");
    लिखतु(द4);
    जाँच("4 sc दायाँ खंड", है(द4, "sc_दायाँ_"));
    जाँच("4 sc अंत खंड", है(द4, "sc_अंत_"));
    जाँच("4 फाई नोड", है(द4, "= फाई ["));

    // ---- 5. कॉल + लिखतु ----
    पाठ द5 = निम्न_करो("कार्य दुगुना(संख्या स) { परत् स * 2; } कार्य मुख्य() { लिखतु(दुगुना(21)); }");
    लिखतु("--- test 5 ---");
    लिखतु(द5);
    जाँच("5 बुलाओ @दुगुना", है(द5, "बुलाओ v1 @दुगुना"));
    जाँच("5 लिखतु → print_dynamic", है(द5, "@sutra_print_dynamic"));
    जाँच("5 गुणा स्थिर", है(द5, "स्थिर पूर्ण:2"));

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
