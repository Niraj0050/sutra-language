// उत्सर्जक_चालक.सूत्र — CLI: एक .सूत्र फ़ाइल → IR path → .s (stdout)
// प्रयोग:  <exe> path/to/program.सूत्र  > out.s
// verify_emit.ps1 इसे उपयोग करता है (as + ld + run तक)।

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "रजि_नियतक.सूत्र";
आयात "मूल_उत्सर्जक.सूत्र";

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) < 2) {
        लिखतु("# प्रयोग: उत्सर्जक_चालक <program.सूत्र>");
        परत्;
    }
    पाठ मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - 1];
    पाठ स्रोत = सञ्चिका_पठतु(मार्गः);

    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश प्रोग्राम = प्रोग्राम_पार्स(अवस्था, {}, मार्गः);

    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम);
    अनुकूलक_एकक(एकक);
    लिखतु(उत्सर्जक_एकक(एकक));
}
