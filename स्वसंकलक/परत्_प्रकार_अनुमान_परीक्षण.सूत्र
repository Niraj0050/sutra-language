// परत्_प्रकार_अनुमान_परीक्षण.सूत्र — वापसी-प्रकार अनुमान का test
// असली parser → lower → अनुकूलक_एकक → परत्_प्रकार_अनुमान_एकक → IR डंप जाँचो

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "परत्_प्रकार_अनुमान.सूत्र";

मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= 0; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}

// parse → lower → सामान्य अनुकूलक (mem2reg+const-fold+DCE) → परत्_प्रकार_अनुमान → छापो
कार्य पूर्ण_अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    परत्_प्रकार_अनुमान_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

कार्य मुख्य() {
    // 1. फिब-शैली — non-tail self-recursion, base-case अकेला ठोस संकेत
    पाठ द1 = पूर्ण_अनुकूलित(
        "कार्य फिब(संख्या अ) { यदि (अ <= 1) { परत् अ; } परत् फिब(अ - 1) + फिब(अ - 2); } " +
        "कार्य मुख्य1() { परत् फिब(5); }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 @फिब कॉल पूर्ण-टाइप्ड हो गया", है(द1, "@फिब  : पूर्ण"));
    जाँच("1 @फिब कहीं मान-टाइप्ड नहीं बचा", न है(द1, "@फिब  : मान"));

    // 2. accumulator-शैली — पुनरावर्ती वापस सीधे कॉल-नतीजा है
    पाठ द2 = पूर्ण_अनुकूलित(
        "कार्य योगसह(संख्या अ, संख्या स) { यदि (अ <= 0) { परत् स; } परत् योगसह(अ - 1, स + अ); } " +
        "कार्य मुख्य2() { परत् योगसह(5, 0); }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 @योगसह कॉल पूर्ण-टाइप्ड हो गया", है(द2, "@योगसह  : पूर्ण"));
    जाँच("2 @योगसह कहीं मान-टाइप्ड नहीं बचा", न है(द2, "@योगसह  : मान"));

    // 3. multi-hop forwarding chain — अग्रेषक पहले घोषित (पत्ता से पहले),
    // ताकि दौर-1 में पत्ता अनसुलझा हो और असली fixpoint (≥2 दौर) ज़रूरी बने
    पाठ द3 = पूर्ण_अनुकूलित(
        "कार्य अग्रेषक(संख्या अ) { परत् पत्ता(अ); } " +
        "कार्य पत्ता(संख्या अ) { परत् अ * 2; } " +
        "कार्य मुख्य3() { परत् अग्रेषक(5); }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 @पत्ता (leaf) पूर्ण-टाइप्ड", है(द3, "@पत्ता  : पूर्ण"));
    जाँच("3 @अग्रेषक (forwarding) भी पूर्ण-टाइप्ड (fixpoint ज़रूरी था)", है(द3, "@अग्रेषक  : पूर्ण"));

    // 4. नकारात्मक — genuinely मिश्रित-प्रकार फलन → मान पर ही रहे
    पाठ उ = अक्षर_निर्माण(34);   // " — embedded स्रोत में सुरक्षित रूप से डालने को
    पाठ द4 = पूर्ण_अनुकूलित(
        "कार्य मिश्रित(संख्या अ) { यदि (अ <= 0) { परत् 42; } परत् " + उ + "पाठ_मान" + उ + "; } " +
        "कार्य मुख्य4() { परत् मिश्रित(5); }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 मिश्रित-प्रकार फलन मान पर ही रहा", है(द4, "@मिश्रित  : मान"));

    // 5. नकारात्मक — सारे वापस खाली (void) → शून्य अनुमानित, crash नहीं
    पाठ द5 = पूर्ण_अनुकूलित(
        "कार्य रिक्तकार्य(संख्या अ) { यदि (अ <= 0) { परत्; } परत्; } " +
        "कार्य मुख्य5() { रिक्तकार्य(5); परत् 0; }");
    लिखतु("--- 5 ---"); लिखतु(द5);
    जाँच("5 void फलन crash नहीं हुआ (dump बना)", लंबाई(द5) > 0);

    // 6. कहीं से भी न बुलाया गया फलन — बिना crash सुरक्षित रहे
    पाठ द6 = पूर्ण_अनुकूलित(
        "कार्य अकेला(संख्या अ) { परत् अ + 1; } " +
        "कार्य मुख्य6() { परत् 0; }");
    लिखतु("--- 6 ---"); लिखतु(द6);
    जाँच("6 अकेला (uncalled) फलन crash नहीं हुआ", है(द6, "फलन अकेला"));

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
