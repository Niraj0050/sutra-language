// सार्थक_विश्लेषक_परीक्षण.सूत्र — Unit tests for standalone semantic analyzer

आयात "लेखक.सूत्र";
आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";

कार्य परीक्षण_चलाओ(पाठ नाम, पाठ कोड, बूल त्रुटि_अपेक्षित) {
    बूल त्रुटि_मिली = असत्य;
    पाठ त्रुटि_सन्देश = "";
    
    प्रयत्न {
        सूची पद_सूची = पद_विच्छेदन(कोड);
        शब्दकोश अवस्था = {};
        अवस्था["पद_सूची"] = पद_सूची;
        अवस्था["अनुक्रमणिका"] = 0;
        अवस्था["कुल_पद"] = लंबाई(पद_सूची);
        
        शब्दकोश आयातित_सञ्चिकाः = {};
        शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित_सञ्चिकाः, "परीक्षण.सूत्र");
        
        मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
    } पकड़ो (त्रुटि) {
        त्रुटि_मिली = सत्य;
        त्रुटि_सन्देश = त्रुटि;
    }
    
    यदि (त्रुटि_अपेक्षित) {
        यदि (त्रुटि_मिली) {
            लिखतु("  [सफल] " + नाम + " (पकड़ी गई त्रुटि: " + त्रुटि_सन्देश + ")");
        } अन्यथा {
            लिखतु("  [असफल] " + नाम + " — त्रुटि की अपेक्षा थी लेकिन सफल रहा।");
            प्रक्षेपः "परीक्षण असफलता";
        }
    } अन्यथा {
        यदि (त्रुटि_मिली) {
            लिखतु("  [असफल] " + नाम + " — त्रुटि अनपेक्षित थी लेकिन प्राप्त हुई: " + त्रुटि_सन्देश);
            प्रक्षेपः "परीक्षण असफलता";
        } अन्यथा {
            लिखतु("  [सफल] " + नाम);
        }
    }
}

कार्य मुख्य() {
    लिखतु("========================================================");
    लिखतु("       Sutra Standalone Semantic Analyzer Tests");
    लिखतु("========================================================");
    
    // valid variable
    परीक्षण_चलाओ("Valid Variable Declaration", "मान क = 10;", असत्य);
    
    // undefined variable
    परीक्षण_चलाओ("Undefined Variable Assignment", "क = 10;", सत्य);
    
    // duplicate variable
    परीक्षण_चलाओ("Duplicate Variable Declaration", "मान क = 10; मान क = 20;", सत्य);
    
    // valid function
    परीक्षण_चलाओ("Valid Function Call", "कार्य जोड़(क, ख) { परत् क + ख; } मान परिणाम = जोड़(10, 20);", असत्य);
    
    // invalid function call (undefined callee)
    परीक्षण_चलाओ("Undefined Function Call", "अपरिभाषित_कार्य();", सत्य);
    
    // parameter mismatch
    परीक्षण_चलाओ("Function Parameter Mismatch", "कार्य जोड़(क, ख) { परत् क + ख; } जोड़(10);", सत्य);
    
    // invalid break
    परीक्षण_चलाओ("Invalid Break outside loop", "विरामः;", सत्य);
    
    // valid break inside loop
    परीक्षण_चलाओ("Valid Break inside loop", "यावत् (सत्य) { विरामः; }", असत्य);
    
    // invalid class constructor
    परीक्षण_चलाओ("Undefined Class New Expression", "मान ओ = नवीन अपरिभाषित_वर्ग();", सत्य);
    
    // Type checking tests
    परीक्षण_चलाओ("Variable Decl Type Mismatch", "संख्या क = \"पाठ\";", सत्य);
    परीक्षण_चलाओ("Variable Assign Type Mismatch", "संख्या क = 10; क = \"पाठ\";", सत्य);
    परीक्षण_चलाओ("Logical Op Type Mismatch", "मान क = 10 && सत्य;", सत्य);
    परीक्षण_चलाओ("Arithmetic Op Type Mismatch", "मान क = 10 + सत्य;", सत्य);
    परीक्षण_चलाओ("Modulo Decimal Type Mismatch", "मान क = 10.5 % 3;", सत्य);
    परीक्षण_चलाओ("Param Type Mismatch", "कार्य जोड़(संख्या क, संख्या ख) { परत् क + ख; } जोड़(10, \"पाठ\");", सत्य);
    परीक्षण_चलाओ("Param Type Valid Conversion", "कार्य जोड़(दशमलव क, दशमलव ख) { परत् क + ख; } जोड़(10, 20.5);", असत्य);

    लिखतु("सभी सार्थक विश्लेषण परीक्षण सम्पन्न! (All semantic tests passed!)");
}
