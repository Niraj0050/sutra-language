// एलएलवीएम_चालक.सूत्र — CLI: IR-पाठ → LLVM IR-पाठ (.ll, stdout)
// ============================================================
// पश्च_चालक.सूत्र जैसा ही ढाँचा — बस उत्सर्जक_एकक की जगह
// एलएलवीएम_उत्सर्जक_एकक। अनुकूलक/रजि_नियतक/regalloc अनदेखा — LLVM अपना
// करता (रजि_नियतक_कार्य सिर्फ़ GC-root-चयन के लिए एलएलवीएम_उत्सर्जक के भीतर
// चलता, black box)।
//
// प्रयोग:  अग्र_चालक prog.सूत्र > out.ir
//          एलएलवीएम_चालक out.ir  > out.ll
// ============================================================

आयात "मध्यम.सूत्र";
आयात "एलएलवीएम_उत्सर्जक.सूत्र";
आयात "मध्यम_क्रम.सूत्र";

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) < २) {
        लिखतु("# प्रयोग: एलएलवीएम_चालक <out.ir>  > out.ll");
        परत्;
    }
    पाठ मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - १];
    पाठ इनपुट = सञ्चिका_पठतु(मार्गः);
    शब्दकोश एकक = मध्यम_विक्रमबद्ध(इनपुट);
    लिखतु(एलएलवीएम_उत्सर्जक_एकक(एकक));
}
