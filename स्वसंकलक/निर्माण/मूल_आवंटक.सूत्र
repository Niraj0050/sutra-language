// मूल_आवंटक.सूत्र — arena allocator + mark-and-sweep GC, सूत्र में
// ============================================================
// प्रतिबंधित उपसमुच्चय: कोई पाठ / सूची / शब्दकोश / पाठ-साहित्य नहीं
// — केवल पूर्णांक, अंकगणित और अंतर्_* अंतर्निर्देश। (यही मॉड्यूल तो
// पाठ/सूची/शब्दकोश को *लागू* करता है।)
//
// ब्लॉक विन्यास:
//   आधार → [टैग:८][आकार:८][ payload ... ]
//                         ↑ लौटाया गया pointer  (प = आधार + १६)
//   टैग  = प्रकार + (चिह्नित ? २५६ : ०)
//   प्रकार: ० = मुक्त, १ = पाठ, २ = सूची, ३ = वस्तु, ४ = शब्दकोश
//   आकार = payload बाइट्स (१६-संरेखित)
//
// अखंड (arena chunk) विन्यास:
//   [अगला_अखंड:८][उपयोग:८][क्षमता:८][ blocks ... ]
// ============================================================

संख्या अखंड_प्रथम = ०;
संख्या अखंड_वर्तमान = ०;

// मुक्त-सूची अब वर्ग-वार (segregated free lists) — O(१) alloc/free।
// मुक्त_तालिका = २५७ slots का raw block; slot i = वर्ग i की सूची का शीर्ष।
// वर्ग १..२५६ = ठीक-आकार (१६..४०९६, १६-बाइट granularity); वर्ग ० = बड़े
// ब्लॉक (first-fit, कम ही होते हैं)।
संख्या मुक्त_तालिका = ०;

कार्य श्रेणी_का(संख्या भ) {
    यदि (भ > ४०९६) { परत् ०; }
    परत् भ / १६;
}

कार्य मुक्त_तालिका_तैयार() {
    यदि (मुक्त_तालिका == ०) {
        मुक्त_तालिका = अंतर्_क्षेत्र_आवंटन(२०५६);   // २५७ * ८, VirtualAlloc = शून्य
    }
    परत् ०;
}

संख्या गण_चक्र = ०;
संख्या गण_सक्रिय = ०;
संख्या गण_संग्रहित = ०;
संख्या गण_पुनःप्राप्त = ०;

// ===== स्वतः-GC (byte-threshold trigger, opt-in) =====
// पिछले GC के बाद bump-path से arena कितना बढ़ा। सीमा पार → auto-GC।
// ⚠️ केवल IR-backend से संकलित programs चालू करते हैं (Phase-1f precise
// roots)। पुराने मूल_सर्जक codegen में roots नहीं — वहाँ बंद रहे।
// ⚠️ इन globals के top-level initializer library-mode (कोई main नहीं) में
// नहीं चलते — पुराना codegen सबको .quad ० करता। इसलिए असली मान
// सूत्र_स्वजीसी_आरंभ() (main से बुलाया जाता) में सेट होते हैं।
संख्या आवंटित_बाइट्स = ०;
संख्या जीसी_सीमा = ०;          // सूत्र_स्वजीसी_आरंभ में १२८ MB
संख्या जीसी_चालू = ०;          // reentrancy guard
संख्या ऑटो_सक्षम = ०;          // main में सूत्र_स्वजीसी_आरंभ() से १
// GC-दबाव: runtime C फलन जो एक object आवंटित कर के दूसरा आवंटित करते हैं
// (sutra_dict_create = dict + entries; sutra_split = arr + N strings) —
// पहला अभी किसी Sutra root में नहीं, तो auto-GC उसे sweep कर देगा।
// ये फलन अपने बहु-आवंटन को सूत्र_जीसी_दबाओ()/छोड़ो() में लपेटते हैं।
संख्या जीसी_दबाव = ०;

कार्य सूत्र_स्वजीसी_आरंभ() {
    आवंटित_बाइट्स = ०;
    जीसी_चालू = ०;
    जीसी_दबाव = ०;
    जीसी_सीमा = १२८ * १०४८५७६;
    ऑटो_सक्षम = १;
    परत् ०;
}
कार्य सूत्र_जीसी_दबाओ() { जीसी_दबाव = जीसी_दबाव + १; परत् ०; }
कार्य सूत्र_जीसी_छोड़ो() { जीसी_दबाव = जीसी_दबाव - १; परत् ०; }

कार्य संरेखित16(संख्या मात्रा) {
    परत् ((मात्रा + १५) / १६) * १६;
}

कार्य नया_अखंड(संख्या आवश्यक) {
    संख्या क्षमता = १६७७७२१६;   // १६ MB न्यूनतम अखंड
    यदि (आवश्यक + ६४ > क्षमता) {
        क्षमता = संरेखित16(आवश्यक + ६४);
    }
    संख्या अ = अंतर्_क्षेत्र_आवंटन(क्षमता + ३२);
    अंतर्_लिख8(अ, ०, ०);          // अगला = ०
    अंतर्_लिख8(अ, ८, ०);          // उपयोग = ०
    अंतर्_लिख8(अ, १६, क्षमता);    // क्षमता
    यदि (अखंड_प्रथम == ०) {
        अखंड_प्रथम = अ;
    } अन्यथा {
        अंतर्_लिख8(अखंड_वर्तमान, ०, अ);
    }
    अखंड_वर्तमान = अ;
    परत् अ;
}

// प (= आधार+१६) से आगे कुल बाइट्स शून्य करो
कार्य शून्य_भरो(संख्या प, संख्या कुल) {
    संख्या इ = ०;
    यावत् (इ + ८ <= कुल) {
        अंतर्_लिख8(प, इ, ०);
        इ = इ + ८;
    }
    यावत् (इ < कुल) {
        अंतर्_लिख1(प, इ, ०);
        इ = इ + १;
    }
}

// आकार बाइट्स का payload, प्रकार टैग। लौटाता है आधार+१६।
कार्य सूत्र_आवंटन(संख्या आकार, संख्या प्रकार) {
    संख्या भ = संरेखित16(आकार);
    // न्यूनतम payload १६: शून्य-आकार ब्लॉक का payload पड़ोसी ब्लॉक के header पर पड़ता है, और
    // सूत्र_मुक्त का free-list "next" लेखन (payload+०) उस पड़ोसी का टैग मिटा देता (सूची का
    // तत्व-बफर अब गिन*८ है, इसलिए खाली सूची शून्य-आकार माँगती)।
    यदि (भ < १६) { भ = १६; }
    संख्या कुल = १६ + भ;
    मुक्त_तालिका_तैयार();

    // स्वतः-GC: सीमा पार → अभी संग्रह। roots (Phase 1f) call के आर-पार
    // जीवित सूचकों को ढकते हैं तो caller के in-flight मान सुरक्षित।
    यदि (ऑटो_सक्षम == १) {
        यदि (जीसी_चालू == ०) {
            यदि (जीसी_दबाव == ०) {
                यदि (आवंटित_बाइट्स >= जीसी_सीमा) {
                    जीसी_चालू = १;
                    सूत्र_संग्रह();
                    आवंटित_बाइट्स = ०;
                    जीसी_चालू = ०;
                }
            }
        }
    }

    संख्या श्रेणी = श्रेणी_का(भ);

    // १. मुक्त-सूची (वर्ग-वार)
    यदि (श्रेणी != ०) {
        // ठीक-आकार वर्ग → O(१) pop
        संख्या शीर्ष = अंतर्_पढ़8(मुक्त_तालिका, श्रेणी * ८);
        यदि (शीर्ष != ०) {
            अंतर्_लिख8(मुक्त_तालिका, श्रेणी * ८, अंतर्_पढ़8(शीर्ष, १६));
            अंतर्_लिख8(शीर्ष, ०, प्रकार);
            शून्य_भरो(शीर्ष + १६, अंतर्_पढ़8(शीर्ष, ८));
            परत् शीर्ष + १६;
        }
    } अन्यथा {
        // बड़ा ब्लॉक → वर्ग-० सूची में प्रथम-उपयुक्त (छोटी सूची)
        संख्या पूर्व = ०;
        संख्या वर्त = अंतर्_पढ़8(मुक्त_तालिका, ०);
        यावत् (वर्त != ०) {
            संख्या ब_आकार = अंतर्_पढ़8(वर्त, ८);
            संख्या अगला_मुक्त = अंतर्_पढ़8(वर्त, १६);
            यदि (ब_आकार >= भ) {
                यदि (पूर्व == ०) {
                    अंतर्_लिख8(मुक्त_तालिका, ०, अगला_मुक्त);
                } अन्यथा {
                    अंतर्_लिख8(पूर्व, १६, अगला_मुक्त);
                }
                अंतर्_लिख8(वर्त, ०, प्रकार);
                शून्य_भरो(वर्त + १६, ब_आकार);
                परत् वर्त + १६;
            }
            पूर्व = वर्त;
            वर्त = अगला_मुक्त;
        }
    }

    // २. bump
    यदि (अखंड_वर्तमान == ०) {
        नया_अखंड(कुल);
    }
    संख्या वर्त_अखंड = अखंड_वर्तमान;
    संख्या उपयोग = अंतर्_पढ़8(वर्त_अखंड, ८);
    संख्या क्षमता = अंतर्_पढ़8(वर्त_अखंड, १६);
    यदि (उपयोग + कुल > क्षमता) {
        नया_अखंड(कुल);
        वर्त_अखंड = अखंड_वर्तमान;
        उपयोग = ०;
    }
    संख्या आधार = वर्त_अखंड + ३२ + उपयोग;
    अंतर्_लिख8(वर्त_अखंड, ८, उपयोग + कुल);
    अंतर्_लिख8(आधार, ०, प्रकार);
    अंतर्_लिख8(आधार, ८, भ);
    आवंटित_बाइट्स = आवंटित_बाइट्स + कुल;   // bump → arena बढ़ा
    // ताज़ा bump पहले से शून्य (VirtualAlloc) — भरने की ज़रूरत नहीं
    परत् आधार + १६;
}

कार्य सूत्र_मुक्त(संख्या प) {
    यदि (प == ०) { परत् ०; }
    मुक्त_तालिका_तैयार();
    संख्या आधार = प - १६;
    संख्या श्रेणी = श्रेणी_का(अंतर्_पढ़8(आधार, ८));   // आकार offset ८ पर बरकरार
    अंतर्_लिख8(आधार, ०, ०);                        // प्रकार = मुक्त
    अंतर्_लिख8(आधार, १६, अंतर्_पढ़8(मुक्त_तालिका, श्रेणी * ८));   // next @ payload+०
    अंतर्_लिख8(मुक्त_तालिका, श्रेणी * ८, आधार);
    परत् ०;
}

कार्य सूत्र_पुनः_आवंटन(संख्या प, संख्या नया_आकार) {
    यदि (प == ०) { परत् सूत्र_आवंटन(नया_आकार, २); }
    संख्या आधार = प - १६;
    संख्या टैग = अंतर्_पढ़8(आधार, ०);
    संख्या प्रकार = टैग % २५६;
    संख्या पुराना_भ = अंतर्_पढ़8(आधार, ८);
    संख्या नया_प = सूत्र_आवंटन(नया_आकार, प्रकार);
    संख्या प्रति = पुराना_भ;
    यदि (नया_आकार < प्रति) { प्रति = नया_आकार; }
    संख्या इ = ०;
    यावत् (इ + ८ <= प्रति) {
        अंतर्_लिख8(नया_प, इ, अंतर्_पढ़8(प, इ));
        इ = इ + ८;
    }
    यावत् (इ < प्रति) {
        अंतर्_लिख1(नया_प, इ, अंतर्_पढ़1(प, इ));
        इ = इ + १;
    }
    सूत्र_मुक्त(प);
    परत् नया_प;
}

// ===== प्रकार जाँच =====

कार्य अखंड_में_है(संख्या आधार) {
    संख्या च = अखंड_प्रथम;
    यावत् (च != ०) {
        संख्या आरंभ = च + ३२;
        संख्या अंत = आरंभ + अंतर्_पढ़8(च, ८);
        यदि (आधार >= आरंभ && आधार < अंत) { परत् १; }
        च = अंतर्_पढ़8(च, ०);
    }
    परत् ०;
}

कार्य सूत्र_ब्लॉक_प्रकार(संख्या प) {
    यदि (प < ६५५३६) { परत् ०; }
    यदि (प % १६ != ०) { परत् ०; }        // ब्लॉक pointer सदैव १६-संरेखित
    संख्या आधार = प - १६;
    यदि (न अखंड_में_है(आधार)) { परत् ०; }
    संख्या टैग = अंतर्_पढ़8(आधार, ०);
    संख्या प्रकार = टैग % २५६;
    यदि (प्रकार < १ || प्रकार > ४) { परत् ०; }
    परत् प्रकार;
}

कार्य सूत्र_क्या_पाठ(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == १) { परत् १; }
    परत् ०;
}
कार्य सूत्र_क्या_सूची(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == २) { परत् १; }
    परत् ०;
}
कार्य सूत्र_क्या_वस्तु(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == ३) { परत् १; }
    परत् ०;
}
कार्य सूत्र_क्या_शब्दकोश(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == ४) { परत् १; }
    परत् ०;
}

// ===== mark & sweep =====

// केवल mark-bit सेट करो — payload को typed-object की तरह पढ़े बिना।
// (शब्दकोश का entries-buffer SR_ARR-टैप्ड है पर raw [key,val]* है, उसे
//  प्रकार-२ array की तरह पढ़ना out-of-bounds है।)
कार्य चिह्नित_कच्चा(संख्या प) {
    यदि (प < ६५५३६) { परत् ०; }
    संख्या आधार = प - १६;
    यदि (न अखंड_में_है(आधार)) { परत् ०; }
    संख्या टैग = अंतर्_पढ़8(आधार, ०);
    संख्या प्रकार = टैग % २५६;
    यदि (प्रकार < १ || प्रकार > ४) { परत् ०; }
    यदि (टैग < २५६) { अंतर्_लिख8(आधार, ०, प्रकार + २५६); }
    परत् ०;
}

कार्य चिह्नित(संख्या प) {
    यदि (प < ६५५३६) { परत् ०; }
    संख्या आधार = प - १६;
    यदि (न अखंड_में_है(आधार)) { परत् ०; }
    संख्या टैग = अंतर्_पढ़8(आधार, ०);
    संख्या प्रकार = टैग % २५६;
    यदि (प्रकार < १ || प्रकार > ४) { परत् ०; }
    यदि (टैग >= २५६) { परत् ०; }        // पहले से चिह्नित
    अंतर्_लिख8(आधार, ०, प्रकार + २५६);

    यदि (प्रकार == २) {                          // सूची — स्थिर हैंडल + अलग तत्व-बफर
        संख्या गण = अंतर्_पढ़8(प, ८);
        संख्या तत्व = अंतर्_पढ़8(प, १६);
        यदि (तत्व != ०) {
            चिह्नित_कच्चा(तत्व);   // raw buffer — recurse मत करो
            संख्या इ = ०;
            यावत् (इ < गण) {
                चिह्नित(अंतर्_पढ़8(तत्व, इ * ८));
                इ = इ + १;
            }
        }
    } अन्यथा यदि (प्रकार == ३) {                // वस्तु — inline layout, अपरिवर्तित (fixed क्षेत्र_गण, कभी नहीं बढ़ता)
        संख्या गण = अंतर्_पढ़8(प, ८);
        संख्या इ = ०;
        यावत् (इ < गण) {
            चिह्नित(अंतर्_पढ़8(प, १६ + इ * ८));
            इ = इ + १;
        }
    } अन्यथा यदि (प्रकार == ४) {                // शब्दकोश
        संख्या गण = अंतर्_पढ़8(प, ०);
        संख्या प्रविष्टियाँ = अंतर्_पढ़8(प, १६);
        यदि (प्रविष्टियाँ != ०) {
            चिह्नित_कच्चा(प्रविष्टियाँ);   // raw buffer — recurse मत करो
            संख्या इ = ०;
            यावत् (इ < गण) {
                चिह्नित(अंतर्_पढ़8(प्रविष्टियाँ, इ * १६));
                चिह्नित(अंतर्_पढ़8(प्रविष्टियाँ, इ * १६ + ८));
                इ = इ + १;
            }
        }
        संख्या सूचकांक = अंतर्_पढ़8(प, २४);   // हैश तालिका — शुद्ध पूर्णांक
        यदि (सूचकांक != ०) { चिह्नित_कच्चा(सूचकांक); }
    }
    परत् ०;
}

कार्य सूत्र_संग्रह() {
    गण_चक्र = गण_चक्र + १;
    मुक्त_तालिका_तैयार();
    संख्या पुनः_पूर्व = गण_पुनःप्राप्त;

    // १. चिह्न हटाओ
    संख्या च = अखंड_प्रथम;
    यावत् (च != ०) {
        संख्या उपयोग = अंतर्_पढ़8(च, ८);
        संख्या ऑफ = ०;
        यावत् (ऑफ < उपयोग) {
            संख्या आधार = च + ३२ + ऑफ;
            संख्या टैग = अंतर्_पढ़8(आधार, ०);
            संख्या आकार = अंतर्_पढ़8(आधार, ८);
            अंतर्_लिख8(आधार, ०, टैग % २५६);
            ऑफ = ऑफ + १६ + आकार;
        }
        च = अंतर्_पढ़8(च, ०);
    }

    // २. जड़ों से चिह्नित करो
    संख्या जड़_गण = अंतर्_जड़_संख्या();
    संख्या इ = ०;
    यावत् (इ < जड़_गण) {
        चिह्नित(अंतर्_जड़_मान(इ));
        इ = इ + १;
    }
    चिह्नित(अंतर्_सक्रिय_अपवाद());

    // ३. sweep
    गण_सक्रिय = ०;
    च = अखंड_प्रथम;
    यावत् (च != ०) {
        संख्या उपयोग = अंतर्_पढ़8(च, ८);
        संख्या ऑफ = ०;
        यावत् (ऑफ < उपयोग) {
            संख्या आधार = च + ३२ + ऑफ;
            संख्या टैग = अंतर्_पढ़8(आधार, ०);
            संख्या आकार = अंतर्_पढ़8(आधार, ८);
            संख्या प्रकार = टैग % २५६;
            यदि (प्रकार != ०) {
                यदि (टैग >= २५६) {
                    अंतर्_लिख8(आधार, ०, प्रकार);
                    गण_सक्रिय = गण_सक्रिय + १;
                } अन्यथा {
                    संख्या मुक्त_श्रेणी = श्रेणी_का(आकार);
                    अंतर्_लिख8(आधार, ०, ०);
                    अंतर्_लिख8(आधार, १६, अंतर्_पढ़8(मुक्त_तालिका, मुक्त_श्रेणी * ८));
                    अंतर्_लिख8(मुक्त_तालिका, मुक्त_श्रेणी * ८, आधार);
                    गण_संग्रहित = गण_संग्रहित + १;
                    गण_पुनःप्राप्त = गण_पुनःप्राप्त + आकार;
                }
            }
            ऑफ = ऑफ + १६ + आकार;
        }
        च = अंतर्_पढ़8(च, ०);
    }

    // अनुकूली सीमा: इस चक्र में सीमा के १/४ से कम reclaim → live-set बड़ा,
    // सीमा दुगनी करके GC-thrash रोको।
    संख्या इस_चक्र = गण_पुनःप्राप्त - पुनः_पूर्व;
    // ⚠ ऊपरी हद (१६ GB): बिना हद के हर बेकार चक्र पर सीमा दुगुनी होते-होते ~३६ चक्रों बाद int64
    // overflow कर ऋणात्मक/शून्य हो जाती, और तब *हर* आवंटन पर GC चलता (लूप में संग्रह_करो() बार-बार
    // बुलाने पर सीधे दिखता; runtime के unrooted अस्थायी तब सचमुच sweep हो जाते)।
    यदि (इस_चक्र < जीसी_सीमा / ४ && जीसी_सीमा < १७१७९८६९१८४) {
        जीसी_सीमा = जीसी_सीमा * २;
    }
    परत् ०;
}

कार्य सूत्र_गण_चक्र() { परत् गण_चक्र; }
कार्य सूत्र_गण_सक्रिय() { परत् गण_सक्रिय; }
कार्य सूत्र_गण_संग्रहित() { परत् गण_संग्रहित; }
कार्य सूत्र_गण_पुनःप्राप्त() { परत् गण_पुनःप्राप्त; }
