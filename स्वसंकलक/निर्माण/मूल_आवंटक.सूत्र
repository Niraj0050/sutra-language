// मूल_आवंटक.सूत्र — arena allocator + mark-and-sweep GC, सूत्र में
// ============================================================
// प्रतिबंधित उपसमुच्चय: कोई पाठ / सूची / शब्दकोश / पाठ-साहित्य नहीं
// — केवल पूर्णांक, अंकगणित और अंतर्_* अंतर्निर्देश। (यही मॉड्यूल तो
// पाठ/सूची/शब्दकोश को *लागू* करता है।)
//
// ब्लॉक विन्यास:
//   आधार → [टैग:8][आकार:8][ payload ... ]
//                         ↑ लौटाया गया pointer  (प = आधार + 16)
//   टैग  = प्रकार + (चिह्नित ? 256 : 0)
//   प्रकार: 0 = मुक्त, 1 = पाठ, 2 = सूची, 3 = वस्तु, 4 = शब्दकोश
//   आकार = payload बाइट्स (16-संरेखित)
//
// अखंड (arena chunk) विन्यास:
//   [अगला_अखंड:8][उपयोग:8][क्षमता:8][ blocks ... ]
// ============================================================

संख्या अखंड_प्रथम = 0;
संख्या अखंड_वर्तमान = 0;

// मुक्त-सूची अब वर्ग-वार (segregated free lists) — O(1) alloc/free।
// मुक्त_तालिका = 257 slots का raw block; slot i = वर्ग i की सूची का शीर्ष।
// वर्ग 1..256 = ठीक-आकार (16..4096, 16-बाइट granularity); वर्ग 0 = बड़े
// ब्लॉक (first-fit, कम ही होते हैं)।
संख्या मुक्त_तालिका = 0;

कार्य श्रेणी_का(संख्या भ) {
    यदि (भ > 4096) { परत् 0; }
    परत् भ / 16;
}

कार्य मुक्त_तालिका_तैयार() {
    यदि (मुक्त_तालिका == 0) {
        मुक्त_तालिका = अंतर्_क्षेत्र_आवंटन(2056);   // 257 * 8, VirtualAlloc = शून्य
    }
    परत् 0;
}

संख्या गण_चक्र = 0;
संख्या गण_सक्रिय = 0;
संख्या गण_संग्रहित = 0;
संख्या गण_पुनःप्राप्त = 0;

// ===== स्वतः-GC (byte-threshold trigger, opt-in) =====
// पिछले GC के बाद bump-path से arena कितना बढ़ा। सीमा पार → auto-GC।
// ⚠️ केवल IR-backend से संकलित programs चालू करते हैं (Phase-1f precise
// roots)। पुराने मूल_सर्जक codegen में roots नहीं — वहाँ बंद रहे।
// ⚠️ इन globals के top-level initializer library-mode (कोई main नहीं) में
// नहीं चलते — पुराना codegen सबको .quad 0 करता। इसलिए असली मान
// सूत्र_स्वजीसी_आरंभ() (main से बुलाया जाता) में सेट होते हैं।
संख्या आवंटित_बाइट्स = 0;
संख्या जीसी_सीमा = 0;          // सूत्र_स्वजीसी_आरंभ में 128 MB
संख्या जीसी_चालू = 0;          // reentrancy guard
संख्या ऑटो_सक्षम = 0;          // main में सूत्र_स्वजीसी_आरंभ() से 1
// GC-दबाव: runtime C फलन जो एक object आवंटित कर के दूसरा आवंटित करते हैं
// (sutra_dict_create = dict + entries; sutra_split = arr + N strings) —
// पहला अभी किसी Sutra root में नहीं, तो auto-GC उसे sweep कर देगा।
// ये फलन अपने बहु-आवंटन को सूत्र_जीसी_दबाओ()/छोड़ो() में लपेटते हैं।
संख्या जीसी_दबाव = 0;

कार्य सूत्र_स्वजीसी_आरंभ() {
    आवंटित_बाइट्स = 0;
    जीसी_चालू = 0;
    जीसी_दबाव = 0;
    जीसी_सीमा = 128 * 1048576;
    ऑटो_सक्षम = 1;
    परत् 0;
}
कार्य सूत्र_जीसी_दबाओ() { जीसी_दबाव = जीसी_दबाव + 1; परत् 0; }
कार्य सूत्र_जीसी_छोड़ो() { जीसी_दबाव = जीसी_दबाव - 1; परत् 0; }

कार्य संरेखित16(संख्या मात्रा) {
    परत् ((मात्रा + 15) / 16) * 16;
}

कार्य नया_अखंड(संख्या आवश्यक) {
    संख्या क्षमता = 16777216;   // 16 MB न्यूनतम अखंड
    यदि (आवश्यक + 64 > क्षमता) {
        क्षमता = संरेखित16(आवश्यक + 64);
    }
    संख्या अ = अंतर्_क्षेत्र_आवंटन(क्षमता + 32);
    अंतर्_लिख8(अ, 0, 0);          // अगला = 0
    अंतर्_लिख8(अ, 8, 0);          // उपयोग = 0
    अंतर्_लिख8(अ, 16, क्षमता);    // क्षमता
    यदि (अखंड_प्रथम == 0) {
        अखंड_प्रथम = अ;
    } अन्यथा {
        अंतर्_लिख8(अखंड_वर्तमान, 0, अ);
    }
    अखंड_वर्तमान = अ;
    परत् अ;
}

// प (= आधार+16) से आगे कुल बाइट्स शून्य करो
कार्य शून्य_भरो(संख्या प, संख्या कुल) {
    संख्या इ = 0;
    यावत् (इ + 8 <= कुल) {
        अंतर्_लिख8(प, इ, 0);
        इ = इ + 8;
    }
    यावत् (इ < कुल) {
        अंतर्_लिख1(प, इ, 0);
        इ = इ + 1;
    }
}

// आकार बाइट्स का payload, प्रकार टैग। लौटाता है आधार+16।
कार्य सूत्र_आवंटन(संख्या आकार, संख्या प्रकार) {
    संख्या भ = संरेखित16(आकार);
    संख्या कुल = 16 + भ;
    मुक्त_तालिका_तैयार();

    // स्वतः-GC: सीमा पार → अभी संग्रह। roots (Phase 1f) call के आर-पार
    // जीवित सूचकों को ढकते हैं तो caller के in-flight मान सुरक्षित।
    यदि (ऑटो_सक्षम == 1) {
        यदि (जीसी_चालू == 0) {
            यदि (जीसी_दबाव == 0) {
                यदि (आवंटित_बाइट्स >= जीसी_सीमा) {
                    जीसी_चालू = 1;
                    सूत्र_संग्रह();
                    आवंटित_बाइट्स = 0;
                    जीसी_चालू = 0;
                }
            }
        }
    }

    संख्या श्रेणी = श्रेणी_का(भ);

    // 1. मुक्त-सूची (वर्ग-वार)
    यदि (श्रेणी != 0) {
        // ठीक-आकार वर्ग → O(1) pop
        संख्या शीर्ष = अंतर्_पढ़8(मुक्त_तालिका, श्रेणी * 8);
        यदि (शीर्ष != 0) {
            अंतर्_लिख8(मुक्त_तालिका, श्रेणी * 8, अंतर्_पढ़8(शीर्ष, 16));
            अंतर्_लिख8(शीर्ष, 0, प्रकार);
            शून्य_भरो(शीर्ष + 16, अंतर्_पढ़8(शीर्ष, 8));
            परत् शीर्ष + 16;
        }
    } अन्यथा {
        // बड़ा ब्लॉक → वर्ग-0 सूची में प्रथम-उपयुक्त (छोटी सूची)
        संख्या पूर्व = 0;
        संख्या वर्त = अंतर्_पढ़8(मुक्त_तालिका, 0);
        यावत् (वर्त != 0) {
            संख्या ब_आकार = अंतर्_पढ़8(वर्त, 8);
            संख्या अगला_मुक्त = अंतर्_पढ़8(वर्त, 16);
            यदि (ब_आकार >= भ) {
                यदि (पूर्व == 0) {
                    अंतर्_लिख8(मुक्त_तालिका, 0, अगला_मुक्त);
                } अन्यथा {
                    अंतर्_लिख8(पूर्व, 16, अगला_मुक्त);
                }
                अंतर्_लिख8(वर्त, 0, प्रकार);
                शून्य_भरो(वर्त + 16, ब_आकार);
                परत् वर्त + 16;
            }
            पूर्व = वर्त;
            वर्त = अगला_मुक्त;
        }
    }

    // 2. bump
    यदि (अखंड_वर्तमान == 0) {
        नया_अखंड(कुल);
    }
    संख्या वर्त_अखंड = अखंड_वर्तमान;
    संख्या उपयोग = अंतर्_पढ़8(वर्त_अखंड, 8);
    संख्या क्षमता = अंतर्_पढ़8(वर्त_अखंड, 16);
    यदि (उपयोग + कुल > क्षमता) {
        नया_अखंड(कुल);
        वर्त_अखंड = अखंड_वर्तमान;
        उपयोग = 0;
    }
    संख्या आधार = वर्त_अखंड + 32 + उपयोग;
    अंतर्_लिख8(वर्त_अखंड, 8, उपयोग + कुल);
    अंतर्_लिख8(आधार, 0, प्रकार);
    अंतर्_लिख8(आधार, 8, भ);
    आवंटित_बाइट्स = आवंटित_बाइट्स + कुल;   // bump → arena बढ़ा
    // ताज़ा bump पहले से शून्य (VirtualAlloc) — भरने की ज़रूरत नहीं
    परत् आधार + 16;
}

कार्य सूत्र_मुक्त(संख्या प) {
    यदि (प == 0) { परत् 0; }
    मुक्त_तालिका_तैयार();
    संख्या आधार = प - 16;
    संख्या श्रेणी = श्रेणी_का(अंतर्_पढ़8(आधार, 8));   // आकार offset 8 पर बरकरार
    अंतर्_लिख8(आधार, 0, 0);                        // प्रकार = मुक्त
    अंतर्_लिख8(आधार, 16, अंतर्_पढ़8(मुक्त_तालिका, श्रेणी * 8));   // next @ payload+0
    अंतर्_लिख8(मुक्त_तालिका, श्रेणी * 8, आधार);
    परत् 0;
}

कार्य सूत्र_पुनः_आवंटन(संख्या प, संख्या नया_आकार) {
    यदि (प == 0) { परत् सूत्र_आवंटन(नया_आकार, 2); }
    संख्या आधार = प - 16;
    संख्या टैग = अंतर्_पढ़8(आधार, 0);
    संख्या प्रकार = टैग % 256;
    संख्या पुराना_भ = अंतर्_पढ़8(आधार, 8);
    संख्या नया_प = सूत्र_आवंटन(नया_आकार, प्रकार);
    संख्या प्रति = पुराना_भ;
    यदि (नया_आकार < प्रति) { प्रति = नया_आकार; }
    संख्या इ = 0;
    यावत् (इ + 8 <= प्रति) {
        अंतर्_लिख8(नया_प, इ, अंतर्_पढ़8(प, इ));
        इ = इ + 8;
    }
    यावत् (इ < प्रति) {
        अंतर्_लिख1(नया_प, इ, अंतर्_पढ़1(प, इ));
        इ = इ + 1;
    }
    सूत्र_मुक्त(प);
    परत् नया_प;
}

// ===== प्रकार जाँच =====

कार्य अखंड_में_है(संख्या आधार) {
    संख्या च = अखंड_प्रथम;
    यावत् (च != 0) {
        संख्या आरंभ = च + 32;
        संख्या अंत = आरंभ + अंतर्_पढ़8(च, 8);
        यदि (आधार >= आरंभ && आधार < अंत) { परत् 1; }
        च = अंतर्_पढ़8(च, 0);
    }
    परत् 0;
}

कार्य सूत्र_ब्लॉक_प्रकार(संख्या प) {
    यदि (प < 65536) { परत् 0; }
    यदि (प % 16 != 0) { परत् 0; }        // ब्लॉक pointer सदैव 16-संरेखित
    संख्या आधार = प - 16;
    यदि (न अखंड_में_है(आधार)) { परत् 0; }
    संख्या टैग = अंतर्_पढ़8(आधार, 0);
    संख्या प्रकार = टैग % 256;
    यदि (प्रकार < 1 || प्रकार > 4) { परत् 0; }
    परत् प्रकार;
}

कार्य सूत्र_क्या_पाठ(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == 1) { परत् 1; }
    परत् 0;
}
कार्य सूत्र_क्या_सूची(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == 2) { परत् 1; }
    परत् 0;
}
कार्य सूत्र_क्या_वस्तु(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == 3) { परत् 1; }
    परत् 0;
}
कार्य सूत्र_क्या_शब्दकोश(संख्या प) {
    यदि (सूत्र_ब्लॉक_प्रकार(प) == 4) { परत् 1; }
    परत् 0;
}

// ===== mark & sweep =====

// केवल mark-bit सेट करो — payload को typed-object की तरह पढ़े बिना।
// (शब्दकोश का entries-buffer SR_ARR-टैप्ड है पर raw [key,val]* है, उसे
//  प्रकार-2 array की तरह पढ़ना out-of-bounds है।)
कार्य चिह्नित_कच्चा(संख्या प) {
    यदि (प < 65536) { परत् 0; }
    संख्या आधार = प - 16;
    यदि (न अखंड_में_है(आधार)) { परत् 0; }
    संख्या टैग = अंतर्_पढ़8(आधार, 0);
    संख्या प्रकार = टैग % 256;
    यदि (प्रकार < 1 || प्रकार > 4) { परत् 0; }
    यदि (टैग < 256) { अंतर्_लिख8(आधार, 0, प्रकार + 256); }
    परत् 0;
}

कार्य चिह्नित(संख्या प) {
    यदि (प < 65536) { परत् 0; }
    संख्या आधार = प - 16;
    यदि (न अखंड_में_है(आधार)) { परत् 0; }
    संख्या टैग = अंतर्_पढ़8(आधार, 0);
    संख्या प्रकार = टैग % 256;
    यदि (प्रकार < 1 || प्रकार > 4) { परत् 0; }
    यदि (टैग >= 256) { परत् 0; }        // पहले से चिह्नित
    अंतर्_लिख8(आधार, 0, प्रकार + 256);

    यदि (प्रकार == 2 || प्रकार == 3) {          // सूची / वस्तु
        संख्या गण = अंतर्_पढ़8(प, 8);
        संख्या इ = 0;
        यावत् (इ < गण) {
            चिह्नित(अंतर्_पढ़8(प, 16 + इ * 8));
            इ = इ + 1;
        }
    } अन्यथा यदि (प्रकार == 4) {                // शब्दकोश
        संख्या गण = अंतर्_पढ़8(प, 0);
        संख्या प्रविष्टियाँ = अंतर्_पढ़8(प, 16);
        यदि (प्रविष्टियाँ != 0) {
            चिह्नित_कच्चा(प्रविष्टियाँ);   // raw buffer — recurse मत करो
            संख्या इ = 0;
            यावत् (इ < गण) {
                चिह्नित(अंतर्_पढ़8(प्रविष्टियाँ, इ * 16));
                चिह्नित(अंतर्_पढ़8(प्रविष्टियाँ, इ * 16 + 8));
                इ = इ + 1;
            }
        }
    }
    परत् 0;
}

कार्य सूत्र_संग्रह() {
    गण_चक्र = गण_चक्र + 1;
    मुक्त_तालिका_तैयार();
    संख्या पुनः_पूर्व = गण_पुनःप्राप्त;

    // 1. चिह्न हटाओ
    संख्या च = अखंड_प्रथम;
    यावत् (च != 0) {
        संख्या उपयोग = अंतर्_पढ़8(च, 8);
        संख्या ऑफ = 0;
        यावत् (ऑफ < उपयोग) {
            संख्या आधार = च + 32 + ऑफ;
            संख्या टैग = अंतर्_पढ़8(आधार, 0);
            संख्या आकार = अंतर्_पढ़8(आधार, 8);
            अंतर्_लिख8(आधार, 0, टैग % 256);
            ऑफ = ऑफ + 16 + आकार;
        }
        च = अंतर्_पढ़8(च, 0);
    }

    // 2. जड़ों से चिह्नित करो
    संख्या जड़_गण = अंतर्_जड़_संख्या();
    संख्या इ = 0;
    यावत् (इ < जड़_गण) {
        चिह्नित(अंतर्_जड़_मान(इ));
        इ = इ + 1;
    }
    चिह्नित(अंतर्_सक्रिय_अपवाद());

    // 3. sweep
    गण_सक्रिय = 0;
    च = अखंड_प्रथम;
    यावत् (च != 0) {
        संख्या उपयोग = अंतर्_पढ़8(च, 8);
        संख्या ऑफ = 0;
        यावत् (ऑफ < उपयोग) {
            संख्या आधार = च + 32 + ऑफ;
            संख्या टैग = अंतर्_पढ़8(आधार, 0);
            संख्या आकार = अंतर्_पढ़8(आधार, 8);
            संख्या प्रकार = टैग % 256;
            यदि (प्रकार != 0) {
                यदि (टैग >= 256) {
                    अंतर्_लिख8(आधार, 0, प्रकार);
                    गण_सक्रिय = गण_सक्रिय + 1;
                } अन्यथा {
                    संख्या मुक्त_श्रेणी = श्रेणी_का(आकार);
                    अंतर्_लिख8(आधार, 0, 0);
                    अंतर्_लिख8(आधार, 16, अंतर्_पढ़8(मुक्त_तालिका, मुक्त_श्रेणी * 8));
                    अंतर्_लिख8(मुक्त_तालिका, मुक्त_श्रेणी * 8, आधार);
                    गण_संग्रहित = गण_संग्रहित + 1;
                    गण_पुनःप्राप्त = गण_पुनःप्राप्त + आकार;
                }
            }
            ऑफ = ऑफ + 16 + आकार;
        }
        च = अंतर्_पढ़8(च, 0);
    }

    // अनुकूली सीमा: इस चक्र में सीमा के 1/4 से कम reclaim → live-set बड़ा,
    // सीमा दुगनी करके GC-thrash रोको।
    संख्या इस_चक्र = गण_पुनःप्राप्त - पुनः_पूर्व;
    यदि (इस_चक्र < जीसी_सीमा / 4) {
        जीसी_सीमा = जीसी_सीमा * 2;
    }
    परत् 0;
}

कार्य सूत्र_गण_चक्र() { परत् गण_चक्र; }
कार्य सूत्र_गण_सक्रिय() { परत् गण_सक्रिय; }
कार्य सूत्र_गण_संग्रहित() { परत् गण_संग्रहित; }
कार्य सूत्र_गण_पुनःप्राप्त() { परत् गण_पुनःप्राप्त; }
