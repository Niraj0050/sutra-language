कार्य सञ्चिका_कोष_तैयार() {
    यदि (सञ्चिका_पथ_बफ == 0) {
        सञ्चिका_पथ_बफ = अंतर्_क्षेत्र_आवंटन(8192);
        सञ्चिका_समादेश_बफ = अंतर्_क्षेत्र_आवंटन(262144);
        सञ्चिका_तर्क_बफ = अंतर्_क्षेत्र_आवंटन(65536);
