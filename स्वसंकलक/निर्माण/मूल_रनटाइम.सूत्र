// सूची header (स्थिर हैंडल, प्रकार २) = [क्षमता@०][गणना@८][तत्व-पॉइंटर@१६]।
// तत्व असली storage एक अलग आवंटन (प्रकार २, raw — केवल चिह्नित_कच्चा से ट्रेस) है।
// यही शब्दकोश (कोष हैंडल + प्रवि/अनुक्र बफर) वाला पैटर्न — growth तत्व-बफर को
// पुनः-आवंटित/स्थानांतरित करता है, पर हैंडल (सर) का पता कभी नहीं बदलता, तो
// किसी भी alias को नया पता जानने की ज़रूरत नहीं (मूल में यह टूटा था: growth
// सीधे हैंडल को reallocate करता, लौटाया पता बदल जाता, और सिर्फ़ जिसने return
// value कैप्चर किया वही अद्यतन रहता — दूसरे aliases पुराने, dangling पते पर रह जाते)।
कार्य सूची_रचना(संख्या गिन) {
    सूत्र_जीसी_दबाओ();
    संख्या तत्व = सूत्र_आवंटन(गिन * ८, २);   // आवंटक शून्य कर देता
    संख्या ब = सूत्र_आवंटन(२४, २);
    अंतर्_लिख8(ब, ०, गिन);     // क्षमता
    अंतर्_लिख8(ब, ८, गिन);     // गणना
    अंतर्_लिख8(ब, १६, तत्व);   // तत्व-पॉइंटर
    सूत्र_जीसी_छोड़ो();
    परत् ब;
}

कार्य सूची_जोड़(संख्या सर, संख्या मूल्य) {
    यदि (सर == ०) {
        प्रक्षेपः "त्रुटिः — शून्य सर पर जोड़ना असंभव";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, ०);
    संख्या गणना = अंतर्_पढ़8(सर, ८);
    संख्या तत्व = अंतर्_पढ़8(सर, १६);
    यदि (गणना < क्षमता) {
        अंतर्_लिख8(तत्व, गणना * ८, मूल्य);
        अंतर्_लिख8(सर, ८, गणना + १);
        परत् सर;
    }
    सूत्र_जीसी_दबाओ();
    संख्या नई_क्षमता = ४;
    यदि (क्षमता != ०) { नई_क्षमता = क्षमता * २; }
    संख्या नया_तत्व = सूत्र_पुनः_आवंटन(तत्व, नई_क्षमता * ८);
    अंतर्_लिख8(सर, ०, नई_क्षमता);
    अंतर्_लिख8(सर, ८, गणना + १);
    अंतर्_लिख8(सर, १६, नया_तत्व);
    अंतर्_लिख8(नया_तत्व, गणना * ८, मूल्य);
    सूत्र_जीसी_छोड़ो();
    परत् सर;   // हैंडल अपरिवर्तित — हर alias तुरंत नया तत्व देखता है
}

कार्य सूची_निकाल(संख्या सर) {
    यदि (सर == ०) {
        प्रक्षेपः "त्रुटिः — शून्य सर से तत्व नहीं निकाला जा सकता।";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, ०);
    संख्या गणना = अंतर्_पढ़8(सर, ८);
    संख्या तत्व = अंतर्_पढ़8(सर, १६);
    यदि (गणना <= ०) {
        प्रक्षेपः "त्रुटिः — शून्य सर से तत्व नहीं निकाला जा सकता।";
    }
    अंतर्_लिख8(तत्व, (गणना - १) * ८, ०);
    गणना = गणना - १;
    अंतर्_लिख8(सर, ८, गणना);
    यदि (गणना <= क्षमता / ४) {
        यदि (क्षमता > ४) {
            सूत्र_जीसी_दबाओ();
            संख्या नई_क्षमता = क्षमता / २;
            यदि (नई_क्षमता < ४) { नई_क्षमता = ४; }
            संख्या नया_तत्व = सूत्र_पुनः_आवंटन(तत्व, नई_क्षमता * ८);
            अंतर्_लिख8(सर, ०, नई_क्षमता);
            अंतर्_लिख8(सर, १६, नया_तत्व);
            सूत्र_जीसी_छोड़ो();
        }
    }
    परत् सर;
}

कार्य सूची_डाल(संख्या सर, संख्या सूचकांक, संख्या मूल्य) {
    यदि (सर == ०) {
        प्रक्षेपः "त्रुटिः — शून्य सर पर डालना असंभव";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, ०);
    संख्या गणना = अंतर्_पढ़8(सर, ८);
    यदि (सूचकांक < ० || सूचकांक > गणना) {
        प्रक्षेपः "त्रुटिः — डालें: सूचकांक सीमा से बाहर";
    }
    संख्या तत्व = अंतर्_पढ़8(सर, १६);
    यदि (गणना >= क्षमता) {
        सूत्र_जीसी_दबाओ();
        संख्या नई_क्षमता = ४;
        यदि (क्षमता != ०) { नई_क्षमता = क्षमता * २; }
        तत्व = सूत्र_पुनः_आवंटन(तत्व, नई_क्षमता * ८);
        अंतर्_लिख8(सर, ०, नई_क्षमता);
        अंतर्_लिख8(सर, १६, तत्व);
        सूत्र_जीसी_छोड़ो();
    }
    संख्या इ = गणना;
    यावत् (इ > सूचकांक) {
        अंतर्_लिख8(तत्व, इ * ८, अंतर्_पढ़8(तत्व, (इ - १) * ८));
        इ = इ - १;
    }
    अंतर्_लिख8(तत्व, सूचकांक * ८, मूल्य);
    अंतर्_लिख8(सर, ८, गणना + १);
    परत् सर;
}

कार्य सूची_हटा(संख्या सर, संख्या सूचकांक) {
    यदि (सर == ०) {
        प्रक्षेपः "त्रुटिः — शून्य सर से तत्व हटाना असंभव";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, ०);
    संख्या गणना = अंतर्_पढ़8(सर, ८);
    यदि (सूचकांक < ० || सूचकांक >= गणना) {
        प्रक्षेपः "त्रुटिः — हटाएं: सूचकांक सीमा से बाहर";
    }
    संख्या तत्व = अंतर्_पढ़8(सर, १६);
    संख्या इ = सूचकांक;
    यावत् (इ < गणना - १) {
        अंतर्_लिख8(तत्व, इ * ८, अंतर्_पढ़8(तत्व, (इ + १) * ८));
        इ = इ + १;
    }
    अंतर्_लिख8(तत्व, (गणना - १) * ८, ०);
    गणना = गणना - १;
    अंतर्_लिख8(सर, ८, गणना);
    यदि (गणना <= क्षमता / ४) {
        यदि (क्षमता > ४) {
            सूत्र_जीसी_दबाओ();
            संख्या नई_क्षमता = क्षमता / २;
            यदि (नई_क्षमता < ४) { नई_क्षमता = ४; }
            संख्या नया_तत्व = सूत्र_पुनः_आवंटन(तत्व, नई_क्षमता * ८);
            अंतर्_लिख8(सर, ०, नई_क्षमता);
            अंतर्_लिख8(सर, १६, नया_तत्व);
            सूत्र_जीसी_छोड़ो();
        }
    }
    परत् सर;
}

कार्य सूची_जोड़ो_दो(संख्या अ, संख्या ब) {
    संख्या ग_अ = ०;
    यदि (अ != ०) { ग_अ = अंतर्_पढ़8(अ, ८); }
    संख्या ग_ब = ०;
    यदि (ब != ०) { ग_ब = अंतर्_पढ़8(ब, ८); }
    सूत्र_जीसी_दबाओ();
    संख्या नया = सूची_रचना(ग_अ + ग_ब);
    संख्या न_तत्व = अंतर्_पढ़8(नया, १६);
    संख्या अ_तत्व = ०;
    यदि (अ != ०) { अ_तत्व = अंतर्_पढ़8(अ, १६); }
    संख्या ब_तत्व = ०;
    यदि (ब != ०) { ब_तत्व = अंतर्_पढ़8(ब, १६); }
    संख्या इ = ०;
    यावत् (इ < ग_अ) {
        अंतर्_लिख8(न_तत्व, इ * ८, अंतर्_पढ़8(अ_तत्व, इ * ८));
        इ = इ + १;
    }
    इ = ०;
    यावत् (इ < ग_ब) {
        अंतर्_लिख8(न_तत्व, (ग_अ + इ) * ८, अंतर्_पढ़8(ब_तत्व, इ * ८));
        इ = इ + १;
    }
    सूत्र_जीसी_छोड़ो();
    परत् नया;
}

कार्य सूची_खोज(संख्या सर, संख्या मूल्य) {
    यदि (सर == ०) { परत् -१; }
    संख्या गणना = अंतर्_पढ़8(सर, ८);
    संख्या तत्व = अंतर्_पढ़8(सर, १६);
    संख्या इ = ०;
    यावत् (इ < गणना) {
        यदि (अंतर्_पढ़8(तत्व, इ * ८) == मूल्य) { परत् इ; }
        इ = इ + १;
    }
    परत् -१;
}


