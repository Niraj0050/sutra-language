// पूर्व: sutra_char_chr — कोडबिंदु → 1-4 बाइट UTF-8 पाठ
कार्य अक्षर_बना(संख्या कब) {
    यदि (कब < 128) {
        संख्या प = पाठ_आवंटित(1);
        अंतर्_लिख1(प, 16, कब);
        परत् प;
    }
    यदि (कब < 2048) {
        संख्या प = पाठ_आवंटित(2);
        अंतर्_लिख1(प, 16, 192 + (कब / 64));
        अंतर्_लिख1(प, 17, 128 + (कब % 64));
        परत् प;
    }
    यदि (कब < 65536) {
        संख्या प = पाठ_आवंटित(3);
        अंतर्_लिख1(प, 16, 224 + (कब / 4096));
        अंतर्_लिख1(प, 17, 128 + ((कब / 64) % 64));
        अंतर्_लिख1(प, 18, 128 + (कब % 64));
        परत् प;
    }
    यदि (कब <= 1114111) {
        संख्या प = पाठ_आवंटित(4);
        अंतर्_लिख1(प, 16, 240 + (कब / 262144));
        अंतर्_लिख1(प, 17, 128 + ((कब / 4096) % 64));
        अंतर्_लिख1(प, 18, 128 + ((कब / 64) % 64));
        अंतर्_लिख1(प, 19, 128 + (कब % 64));
        परत् प;
    }
    संख्या प = पाठ_आवंटित(3);
    अंतर्_लिख1(प, 16, 239);
    अंतर्_लिख1(प, 17, 191);
    अंतर्_लिख1(प, 18, 189);
    परत् प;
}

// पूर्व: sutra_substr — कोडबिंदु-सूचकांक [आरंभ, अंत)
कार्य पाठ_उपखंड(संख्या पा, संख्या आरंभ, संख्या अंत) {
    यदि (पा == 0) { परत् पाठ_आवंटित(0); }
    यदि (आरंभ < 0 || अंत < 0) {
        प्रक्षेपः "त्रुटिः — अमान्य सूचकांक मान (Index cannot be negative)";
    }
    संख्या बल = अंतर्_पढ़8(पा, 8);
    संख्या कुल_कब = पाठ_कोडबिंदु_गणना(पा);
    यदि (आरंभ > कुल_कब || अंत > कुल_कब) {
        प्रक्षेपः "त्रुटिः — पाठस्य सीमा अतिक्रान्ता (String index out of bounds)";
    }
    यदि (आरंभ > अंत) {
        प्रक्षेपः "त्रुटिः — आरंभः अन्त्यतः अधिकः अस्ति (start > end)";
    }
    यदि (आरंभ == अंत) { परत् पाठ_आवंटित(0); }
    संख्या बा_आरंभ = 0;
    संख्या बा_अंत = बल;
    संख्या कब = 0;
    संख्या इ = 0;
    यावत् (इ < बल) {
        संख्या पूर्व = इ;
        संख्या च = अंतर्_पढ़1(पा, 16 + इ);
        इ = इ + अक्षर_बाइट_चौड़ाई(च);
        यदि (कब == आरंभ) { बा_आरंभ = पूर्व; }
        यदि (कब == अंत) { बा_अंत = पूर्व; विरामः; }
        कब = कब + 1;
    }
    यदि (अंत == कुल_कब) { बा_अंत = बल; }
    परत् पाठ_प्रति(पा, बा_आरंभ, बा_अंत - बा_आरंभ);
}


