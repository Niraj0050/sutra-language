// प्राकृतिक-लघुगणक — Taylor (atanh श्रेणी); चर > ० माना
कार्य लघुगणक_रन(दशमलव चर) {
    यदि (चर <= ०.०) { परत् ०.०; }
    संख्या द52 = दो_बावन();
    संख्या चबि = दशमलव_बिट(चर);
    संख्या कै = (चबि / द52) % २०४८ - १०२३;
    संख्या मंबि = (चबि % द52) + १०२३ * द52;
    दशमलव मं = बिट_दशमलव(मंबि);
    यदि (मं > १.४१४२१३५६२३७३०९५१) {
        मं = मं * ०.५;
        कै = कै + १;
    }
    दशमलव सम = (मं - १.०) / (मं + १.०);
    दशमलव समवर्ग = सम * सम;
    दशमलव पद = सम;
    दशमलव योग = ०.०;
    संख्या इक = १;
    यावत् (इक < ४०) {
        योग = योग + पद / इक;
        पद = पद * समवर्ग;
        इक = इक + २;
    }
    परत् २.० * योग + कै * ०.६९३१४७१८०५५९९४५३;
}

// e^चर — range-reduction + Taylor
कार्य घातांकी_रन(दशमलव चर) {
    संख्या द52 = दो_बावन();
    दशमलव कैफ = चर * १.४४२६९५०४०८८८९६३४;
    संख्या कै = गोल(कैफ);
    यदि (कै > १०००) { कै = १०००; }
    यदि (कै < -१०००) { कै = ० - १०००; }
    दशमलव शेष = चर - कै * ०.६९३१४७१८०५५९९४५३;
    दशमलव पद = १.०;
    दशमलव योग = १.०;
    संख्या इक = १;
    यावत् (इक < २०) {
        पद = पद * शेष / इक;
        योग = योग + पद;
        इक = इक + १;
    }
    संख्या दोबि = (कै + १०२३) * द52;
    दशमलव दोघात = बिट_दशमलव(दोबि);
    परत् योग * दोघात;
}

// पूर्व: sutra_math_pow_f — निम्नक `घात` → यहाँ। पूर्णांक-घात = repeated-multiply;
// भिन्नात्मक = exp(ई·ln ब)। दशमलव param/return = f64-bits सीधे।
कार्य रन_घात(दशमलव ब, दशमलव ई) {
    संख्या ईपू = गोल(ई);
    यदि (ईपू == ई) {
        यदि (ई >= -१०२४.०) {
            यदि (ई <= १०२४.०) {
                संख्या नि = ईपू;
                संख्या ऋण = ०;
                यदि (नि < ०) { ऋण = १; नि = ० - नि; }
                दशमलव सञ्चय = १.०;
                दशमलव आधार = ब;
                यावत् (नि > ०) {
                    यदि (नि % २ == १) { सञ्चय = सञ्चय * आधार; }
                    आधार = आधार * आधार;
                    नि = नि / २;
                }
                यदि (ऋण == १) { परत् १.० / सञ्चय; }
                परत् सञ्चय;
            }
        }
    }
    यदि (ब > ०.०) { परत् घातांकी_रन(ई * लघुगणक_रन(ब)); }
    परत् ०.०;
}
