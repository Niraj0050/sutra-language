// ============================================================
// दशमलव प्रारूपण — पूर्व: sutra_runtime.c का sr_fmt_float / float_to_str /
// print_float। "%f"-जैसा: ६ अंश-अंक, गोल, trailing शून्य छँटे। कोई libc —
// SSE अंकगणित (सूत्र_float_* तल.s में) + पूर्णांक-लूप। व्याख्याता std::to_string
// से मेल (जो %f करता, फिर trailing ० + '.' छाँटता)।
// टिप्पणी: e-नोटेशन नहीं लिख सकते → inf जाँच (धन-धन != ०), २^६३-सीमा गोल()
// के INT64_MIN sentinel से।
// ============================================================

// द को बफ में लिखो (raw pointer, header-रहित), लिखे बाइट लौटाओ। बफ ≥ ४८ बाइट।
कार्य दशमलव_प्रारूप(दशमलव द, संख्या बफ) {
    संख्या प = ०;
    यदि (द != द) {                       // NaN
        अंतर्_लिख1(बफ, ०, ११०); अंतर्_लिख1(बफ, १, ९७); अंतर्_लिख1(बफ, २, ११०);
        परत् ३;
    }
    दशमलव धन = द;
    यदि (द < ०.०) {
        अंतर्_लिख1(बफ, प, ४५);           // '-'
        प = प + १;
        धन = ०.० - द;
    }
    दशमलव पार = धन - धन;                 // ±inf → NaN → != ०; परिमित → ०
    यदि (पार != ०.०) {
        अंतर्_लिख1(बफ, प, १०५); प = प + १;   // 'i'
        अंतर्_लिख1(बफ, प, ११०); प = प + १;   // 'n'
        अंतर्_लिख1(बफ, प, १०२); प = प + १;   // 'f'
        परत् प;
    }
    संख्या कुल = गोल(धन * १००००००.०);    // = trunc(धन*1e6 + ०.५), धन ≥ ०
    यदि (कुल < ०) {                       // ≥ २^६३ (या overflow) → पूर्ण भाग मात्र
        संख्या इब = गोल(धन);
        संख्या ग = अंक_गणना(इब);
        संख्या क = इब;
        संख्या ल = प + ग;
        यदि (इब == ०) { अंतर्_लिख1(बफ, प, ४८); परत् प + १; }
        यावत् (क > ०) {
            ल = ल - १;
            अंतर्_लिख1(बफ, ल, ४८ + (क % १०));
            क = क / १०;
        }
        परत् प + ग;
    }
    संख्या इभाग = कुल / १००००००;
    संख्या फभाग = कुल % १००००००;
    // पूर्ण भाग
    यदि (इभाग == ०) {
        अंतर्_लिख1(बफ, प, ४८);
        प = प + १;
    } अन्यथा {
        संख्या ग = अंक_गणना(इभाग);
        संख्या क = इभाग;
        संख्या ल = प + ग;
        यावत् (क > ०) {
            ल = ल - १;
            अंतर्_लिख1(बफ, ल, ४८ + (क % १०));
            क = क / १०;
        }
        प = प + ग;
    }
    // अंश — ६ अंक, अंतिम गैर-शून्य तक
    संख्या श = फभाग;
    संख्या द0 = श / १०००००;  श = श % १०००००;
    संख्या द1 = श / १००००;   श = श % १००००;
    संख्या द2 = श / १०००;    श = श % १०००;
    संख्या द3 = श / १००;     श = श % १००;
