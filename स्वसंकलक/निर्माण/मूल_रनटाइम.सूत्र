    यदि (तर्क_डब्ल्यू == 0) {
        तर्क_गण = 0;
    } अन्यथा {
        तर्क_गण = अंतर्_पढ़8(गणक_बफ, 0) % 4294967296;
    }
    अंतर्_क्षेत्र_मुक्त(गणक_बफ);
    तर्क_तैयार = 1;
    परत् 0;
}

// पूर्व: sutra_args_get — हर कॉल पर ताज़ा सूची (C भी ऐसा ही करता था)
कार्य तर्क_सूची_रन() {
    तर्क_आरंभ_रन();
    सूत्र_जीसी_दबाओ();
    संख्या फल = सूची_रचना(तर्क_गण);
    संख्या इ = 0;
    यावत् (इ < तर्क_गण) {
        संख्या डब्ल्यू = अंतर्_पढ़8(तर्क_डब्ल्यू, इ * 8);
        संख्या बाइट्स = सूत्र_तल_चौड़ा_यूटीएफ(डब्ल्यू, सञ्चिका_तर्क_बफ, 65536);
        संख्या लं = बाइट्स - 1;             // null-टर्मिनेटर हटाओ
        यदि (लं < 0) { लं = 0; }
        अंतर्_लिख8(फल, 16 + इ * 8, पाठ_कच्चे_से(सञ्चिका_तर्क_बफ, लं));
        इ = इ + 1;
    }
    सूत्र_जीसी_छोड़ो();
    परत् फल;
}


