}

// कच्चे बाइट्स (raw pointer, header-रहित) से नया पाठ-वस्तु
कार्य पाठ_कच्चे_से(संख्या कच्चा, संख्या बल) {
    संख्या स = पाठ_आवंटित(बल);
    खंड_प्रतिलिपि(स, 16, कच्चा - 16, 16, बल);
    परत् स;
}

// पूर्व: sutra_file_exists — 1 यदि साधारण सञ्चिका मौजूद, वरना 0
कार्य सञ्चिका_है_रन(संख्या पथ) {
    यदि (पथ == 0) { परत् 0; }
    सञ्चिका_कोष_तैयार();
    यदि (सूत्र_तल_यूटीएफ_चौड़ा(पथ + 16, सञ्चिका_पथ_बफ, 4096) == 0) { परत् 0; }
    संख्या ग = सूत्र_तल_सञ्चिका_गुण(सञ्चिका_पथ_बफ);
    यदि (ग == 4294967295) { परत् 0; }        // INVALID_FILE_ATTRIBUTES
    यदि ((ग / 16) % 2 == 1) { परत् 0; }        // FILE_ATTRIBUTE_DIRECTORY = 0x10
    परत् 1;
}

// पूर्व: sutra_file_read — विफल पर खाली पाठ (binary, कोई CRLF-रूपांतरण नहीं)
कार्य सञ्चिका_पढ़ो_रन(संख्या पथ) {
    यदि (पथ == 0) { परत् पाठ_आवंटित(0); }
    सञ्चिका_कोष_तैयार();
    यदि (सूत्र_तल_यूटीएफ_चौड़ा(पथ + 16, सञ्चिका_पथ_बफ, 4096) == 0) { परत् पाठ_आवंटित(0); }
    संख्या ह = सूत्र_तल_सञ्चिका_खोलो_प(सञ्चिका_पथ_बफ);
    यदि (ह == -1) { परत् पाठ_आवंटित(0); }
    संख्या कुल = सूत्र_तल_सञ्चिका_आकार(ह);
    यदि (कुल < 0 || कुल > 2147483647) {
        सूत्र_तल_हैंडल_बंद(ह);
        परत् पाठ_आवंटित(0);
    }
    संख्या ब = पाठ_आवंटित(कुल);
    संख्या मिला = 0;
    यावत् (मिला < कुल) {
        संख्या खंड = सूत्र_तल_पढ़ो(ह, ब + 16 + मिला, कुल - मिला);
        यदि (खंड == 0) { विरामः; }
        मिला = मिला + खंड;
    }
    अंतर्_लिख8(ब, 8, मिला);            // वास्तविक लंबाई
    अंतर्_लिख1(ब, 16 + मिला, 0);
    सूत्र_तल_हैंडल_बंद(ह);
    परत् ब;
}

// पूर्व: sutra_file_write — 1 सफल, 0 विफल
कार्य सञ्चिका_लिखो_रन(संख्या पथ, संख्या सामग्री) {
    यदि (पथ == 0 || सामग्री == 0) { परत् 0; }
    सञ्चिका_कोष_तैयार();
    यदि (सूत्र_तल_यूटीएफ_चौड़ा(पथ + 16, सञ्चिका_पथ_बफ, 4096) == 0) { परत् 0; }
    संख्या ह = सूत्र_तल_सञ्चिका_खोलो_ल(सञ्चिका_पथ_बफ);
    यदि (ह == -1) { परत् 0; }
    संख्या लं = अंतर्_पढ़8(सामग्री, 8);
    संख्या रखा = 0;
    संख्या ठीक = 1;
    यावत् (रखा < लं) {
        संख्या खंड = सूत्र_तल_लिखो(ह, सामग्री + 16 + रखा, लं - रखा);
        यदि (खंड == 0) { ठीक = 0; विरामः; }
        रखा = रखा + खंड;
    }
    सूत्र_तल_हैंडल_बंद(ह);
    यदि (ठीक == 1) {
        यदि (रखा == लं) { परत् 1; }
    }
    परत् 0;
}

// "cmd.exe /c " उपसर्ग — पाठ-साहित्य को अजनक-वापसी में लपेटो
कार्य समादेश_उपसर्ग() { परत् "cmd.exe /c "; }

// पूर्व: sutra_command_run — प्रक्रिया exit-कोड (-1 विफल)
कार्य समादेश_चलाओ_रन(संख्या समादेश) {
    यदि (समादेश == 0) { परत् -1; }
    सञ्चिका_कोष_तैयार();
    सूत्र_जीसी_दबाओ();
    संख्या पूर्ण = पाठ_जोड़(समादेश_उपसर्ग(), समादेश);
    सूत्र_जीसी_छोड़ो();
    यदि (सूत्र_तल_यूटीएफ_चौड़ा(पूर्ण + 16, सञ्चिका_समादेश_बफ, 131072) == 0) { परत् -1; }
    परत् सूत्र_तल_समादेश(सञ्चिका_समादेश_बफ);
}

// पूर्व: sutra_init_args — आलसी (main में कोई call नहीं); CommandLineToArgvW
कार्य तर्क_आरंभ_रन() {
    यदि (तर्क_तैयार == 1) { परत् 0; }
    सञ्चिका_कोष_तैयार();
    संख्या रेखा = सूत्र_तल_समादेश_रेखा();
    संख्या गणक_बफ = अंतर्_क्षेत्र_आवंटन(8);
    अंतर्_लिख8(गणक_बफ, 0, 0);
