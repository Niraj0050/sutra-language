    संख्या चक्र = सूत्र_गण_चक्र();
    यदि (स == पसू_कैश_स) {
        यदि (चक्र == पसू_कैश_चक्र) {
            यदि (अनु >= पसू_कैश_क) {
                इ = पसू_कैश_ब;
                गण = पसू_कैश_क;
            }
        }
    }
    यावत् (इ < बल) {
        संख्या आरंभ = इ;
        संख्या च = अंतर्_पढ़1(स, 16 + इ);
        इ = इ + अक्षर_बाइट_चौड़ाई(च);
