// ============================================================
// शब्दकोश — open-addressing हैश सूचकांक + packed प्रविष्टियाँ
// पूर्व: sutra_dict_* (C, हर lookup O(n) linear-scan)। अब सूत्र, O(१) औसत।
//
// block विन्यास (४० बाइट, प्रकार ४):
//   ऑफ ०  : गण           — जीवित प्रविष्टि गिनती (GC इसे पढ़ता; पुराना ऑफसेट)
//   ऑफ ८  : क्षमता        — प्रविष्टि-बफर क्षमता (जोड़ों में; पुराना ऑफसेट)
//   ऑफ १६ : प्रविष्टियाँ*  — packed [कुंजी:८][मूल्य:८] × गण, insertion-order
//                          (GC पहले जैसा ट्रेस करता; पुराना ऑफसेट)
//   ऑफ २४ : सूचकांक*      — हैश तालिका: पूर्णांक slot सरणी;
//                          slot मान = (प्रविष्टि-अनुक्रमांक + १), ० = रिक्त
//   ऑफ ३२ : हैश_क्षमता     — २ की घात
// GC (चिह्नित, प्रकार==४): गण + प्रविष्टियाँ पहले जैसा; सूचकांक* को
//   चिह्नित_कच्चा (शुद्ध पूर्णांक — mark-bit मात्र)।
//
// कुंजियाँ पाठ या छोटा-पूर्णांक (पहचान से तुलना — पाठ_तुल्य दोनों संभालता)।
// लोड-फैक्टर ≤ ०.७५ → probe हमेशा किसी रिक्त slot पर रुकता।
// ============================================================

कार्य कोष_हैश(संख्या कुं) {
    यदि (कुं < ६५५३६) { परत् कुं; }              // छोटा पूर्णांक कुंजी → स्वयं
    यदि (न अंतर्_क्या_पाठ(कुं)) { परत् कुं / १६; }  // गैर-पाठ पॉइंटर → पहचान
    संख्या लं = अंतर्_पढ़8(कुं, ८);
    संख्या ह = ०;
    संख्या इ = ०;
    यावत् (इ < लं) {
        ह = ह * ३१ + अंतर्_पढ़1(कुं, १६ + इ);
        ह = ह % १००००००००७;
        इ = इ + १;
    }
    परत् ह;
}

// एक probe चरण — inline करने योग्य छोटा। लौटाता: स्लॉट यदि मिला/रिक्त,
// अन्यथा -१ (आगे probe)।  (हक्षम सदा २ की घात → बिट_और = modulo)
कार्य कोष_प्रोब1(संख्या अनुक्र, संख्या प्रवि, संख्या कुं, संख्या स) {
    संख्या ई = अंतर्_पढ़8(अनुक्र, स * ८);
    यदि (ई == ०) { परत् स; }
    यदि (पाठ_तुल्य(अंतर्_पढ़8(प्रवि, (ई - १) * १६), कुं)) { परत् स; }
    परत् ० - १;
}

// कुंजी के लिए slot — मिलान-slot या पहला रिक्त slot (जो पहले मिले)।
// पहले ८ probe सीधी-रेखा में unroll (clang const-trip loop पूर्ण unroll
// करता → कोई अंदरूनी loop नहीं → LICM एक loop-invariant कोष_स्लॉट कॉल
// को accumulator-loop से बाहर hoist कर पाता)। load-factor ≤ ०.७५ → छोटा
// table (हक्षम ≤ ८) इसी में हल; बड़ा table + ८ लगातार टकराव (दुर्लभ) →
// नीचे हक्षम-बँधा fallback।
कार्य कोष_स्लॉट(संख्या कोष, संख्या कुं) {
    संख्या हक्षम = अंतर्_पढ़8(कोष, ३२);
    संख्या अनुक्र = अंतर्_पढ़8(कोष, २४);
    संख्या प्रवि = अंतर्_पढ़8(कोष, १६);
    संख्या मास्क = हक्षम - १;
    संख्या स = बिट_और(कोष_हैश(कुं), मास्क);
    संख्या क = ०;
    यावत् (क < ८) {
        संख्या र = कोष_प्रोब1(अनुक्र, प्रवि, कुं, स);
        यदि (र != ० - १) { परत् र; }
        स = बिट_और(स + १, मास्क);
        क = क + १;
    }
    संख्या प्रयास = ८;
    यावत् (प्रयास < हक्षम) {
        संख्या र2 = कोष_प्रोब1(अनुक्र, प्रवि, कुं, स);
        यदि (र2 != ० - १) { परत् र2; }
        स = बिट_और(स + १, मास्क);
        प्रयास = प्रयास + १;
    }
    परत् स;
}

// सूचकांक तालिका को packed प्रविष्टियों से नए सिरे से भरो।
// (सूचकांक बफर पहले से शून्य होना चाहिए — ताज़ा आवंटन या मैनुअल clear।)
कार्य कोष_सूचकांक_भरो(संख्या कोष) {
    संख्या हक्षम = अंतर्_पढ़8(कोष, ३२);
    संख्या अनुक्र = अंतर्_पढ़8(कोष, २४);
    संख्या प्रवि = अंतर्_पढ़8(कोष, १६);
    संख्या गण = अंतर्_पढ़8(कोष, ०);
    संख्या इ = ०;
    यावत् (इ < गण) {
        संख्या स = कोष_हैश(अंतर्_पढ़8(प्रवि, इ * १६)) % हक्षम;
        यदि (स < ०) { स = स + हक्षम; }
        यावत् (अंतर्_पढ़8(अनुक्र, स * ८) != ०) {
            स = स + १;
            यदि (स >= हक्षम) { स = ०; }
        }
        अंतर्_लिख8(अनुक्र, स * ८, इ + १);
        इ = इ + १;
    }
    परत् ०;
}

कार्य शब्दकोश_रचना() {
    सूत्र_जीसी_दबाओ();
    संख्या कोष = सूत्र_आवंटन(४०, ४);
    संख्या प्रवि = सूत्र_आवंटन(४ * १६, २);
    संख्या अनुक्र = सूत्र_आवंटन(८ * ८, २);
    अंतर्_लिख8(कोष, ०, ०);
    अंतर्_लिख8(कोष, ८, ४);
    अंतर्_लिख8(कोष, १६, प्रवि);
    अंतर्_लिख8(कोष, २४, अनुक्र);
    अंतर्_लिख8(कोष, ३२, ८);
    सूत्र_जीसी_छोड़ो();
    परत् कोष;
}

कार्य शब्दकोश_पाओ(संख्या कोष, संख्या कुं) {
    यदि (कोष == ०) { परत् ०; }
    यदि (अंतर्_पढ़8(कोष, ०) == ०) { परत् ०; }
    संख्या स = कोष_स्लॉट(कोष, कुं);
    संख्या ई = अंतर्_पढ़8(अंतर्_पढ़8(कोष, २४), स * ८);
    यदि (ई == ०) { परत् ०; }
    परत् अंतर्_पढ़8(अंतर्_पढ़8(कोष, १६), (ई - १) * १६ + ८);
}

कार्य शब्दकोश_कुंजी_है(संख्या कोष, संख्या कुं) {
    यदि (कोष == ०) { परत् ०; }
    यदि (अंतर्_पढ़8(कोष, ०) == ०) { परत् ०; }
    संख्या स = कोष_स्लॉट(कोष, कुं);
    यदि (अंतर्_पढ़8(अंतर्_पढ़8(कोष, २४), स * ८) == ०) { परत् ०; }
    परत् १;
}

कार्य शब्दकोश_सेट(संख्या कोष, संख्या कुं, संख्या मू) {
    यदि (कोष == ०) {
        प्रक्षेपः "त्रुटिः — शून्य शब्दकोश पर सेट प्रयास";
    }
    संख्या गण = अंतर्_पढ़8(कोष, ०);
    यदि (गण > ०) {
        संख्या स0 = कोष_स्लॉट(कोष, कुं);
        संख्या ई0 = अंतर्_पढ़8(अंतर्_पढ़8(कोष, २४), स0 * ८);
        यदि (ई0 != ०) {
            अंतर्_लिख8(अंतर्_पढ़8(कोष, १६), (ई0 - १) * १६ + ८, मू);   // मौजूदा कुंजी अद्यतन
            परत् ०;
        }
    }
    // नई कुंजी — packed में append, फिर सूचकांक
    सूत्र_जीसी_दबाओ();
    संख्या क्षम = अंतर्_पढ़8(कोष, ८);
    यदि (गण >= क्षम) {
        संख्या नक्षम = क्षम * २;
        संख्या नप = सूत्र_पुनः_आवंटन(अंतर्_पढ़8(कोष, १६), नक्षम * १६);
        अंतर्_लिख8(कोष, ८, नक्षम);
        अंतर्_लिख8(कोष, १६, नप);
    }
    संख्या प्रवि = अंतर्_पढ़8(कोष, १६);
    अंतर्_लिख8(प्रवि, गण * १६, कुं);
    अंतर्_लिख8(प्रवि, गण * १६ + ८, मू);
    अंतर्_लिख8(कोष, ०, गण + १);
    संख्या हक्षम = अंतर्_पढ़8(कोष, ३२);
    यदि ((गण + १) * ४ >= हक्षम * ३) {
        संख्या नअनुक्र = सूत्र_आवंटन(हक्षम * २ * ८, २);   // ताज़ा → शून्य
        अंतर्_लिख8(कोष, २४, नअनुक्र);
        अंतर्_लिख8(कोष, ३२, हक्षम * २);
        कोष_सूचकांक_भरो(कोष);
    } अन्यथा {
        अंतर्_लिख8(अंतर्_पढ़8(कोष, २४), कोष_स्लॉट(कोष, कुं) * ८, गण + १);
    }
    सूत्र_जीसी_छोड़ो();
    परत् ०;
}

कार्य शब्दकोश_हटाओ(संख्या कोष, संख्या कुं) {
    यदि (कोष == ०) { परत् कोष; }
    संख्या गण = अंतर्_पढ़8(कोष, ०);
    यदि (गण == ०) { परत् कोष; }
    संख्या अनुक्र = अंतर्_पढ़8(कोष, २४);
    संख्या प्रवि = अंतर्_पढ़8(कोष, १६);
    संख्या स = कोष_स्लॉट(कोष, कुं);
    संख्या ई = अंतर्_पढ़8(अनुक्र, स * ८);
    यदि (ई == ०) { परत् कोष; }
    संख्या ज = ई - १;
    यावत् (ज < गण - १) {   // packed को बाईं ओर shift
        अंतर्_लिख8(प्रवि, ज * १६, अंतर्_पढ़8(प्रवि, (ज + १) * १६));
        अंतर्_लिख8(प्रवि, ज * १६ + ८, अंतर्_पढ़8(प्रवि, (ज + १) * १६ + ८));
        ज = ज + १;
    }
    अंतर्_लिख8(कोष, ०, गण - १);
    संख्या हक्षम = अंतर्_पढ़8(कोष, ३२);
    संख्या क2 = ०;
    यावत् (क2 < हक्षम) {   // सूचकांक clear + नए सिरे से (सरल, सही)
        अंतर्_लिख8(अनुक्र, क2 * ८, ०);
        क2 = क2 + १;
    }
    कोष_सूचकांक_भरो(कोष);
    परत् कोष;
}


// ============================================================
// सूची (dynamic array) — [क्षमता:८][गणना:८][तत्व:८×क्षमता], प्रकार २
// पूर्व: sutra_list_* / sutra_arr_create (C)। अब सूत्र।
// grow/shrink: सूत्र_पुनः_आवंटन (arena) — GC दबाकर, वरना बीच में
