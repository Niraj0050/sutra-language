// द को बफ में लिखो (raw pointer, header-रहित), लिखे बाइट लौटाओ। बफ ≥ 48 बाइट।
कार्य दशमलव_प्रारूप(दशमलव द, संख्या बफ) {
    संख्या प = 0;
    यदि (द != द) {                       // NaN
        अंतर्_लिख1(बफ, 0, 110); अंतर्_लिख1(बफ, 1, 97); अंतर्_लिख1(बफ, 2, 110);
        परत् 3;
    }
    दशमलव धन = द;
    यदि (द < 0.0) {
        अंतर्_लिख1(बफ, प, 45);           // '-'
        प = प + 1;
        धन = 0.0 - द;
    }
    दशमलव पार = धन - धन;                 // ±inf → NaN → != 0; परिमित → 0
    यदि (पार != 0.0) {
        अंतर्_लिख1(बफ, प, 105); प = प + 1;   // 'i'
        अंतर्_लिख1(बफ, प, 110); प = प + 1;   // 'n'
        अंतर्_लिख1(बफ, प, 102); प = प + 1;   // 'f'
        परत् प;
    }
    संख्या कुल = गोल(धन * 1000000.0);    // = trunc(धन*1e6 + 0.5), धन ≥ 0
    यदि (कुल < 0) {                       // ≥ 2^63 (या overflow) → पूर्ण भाग मात्र
        संख्या इब = गोल(धन);
        संख्या ग = अंक_गणना(इब);
        संख्या क = इब;
        संख्या ल = प + ग;
        यदि (इब == 0) { अंतर्_लिख1(बफ, प, 48); परत् प + 1; }
        यावत् (क > 0) {
            ल = ल - 1;
            अंतर्_लिख1(बफ, ल, 48 + (क % 10));
            क = क / 10;
        }
        परत् प + ग;
    }
    संख्या इभाग = कुल / 1000000;
    संख्या फभाग = कुल % 1000000;
    // पूर्ण भाग
    यदि (इभाग == 0) {
        अंतर्_लिख1(बफ, प, 48);
        प = प + 1;
    } अन्यथा {
        संख्या ग = अंक_गणना(इभाग);
        संख्या क = इभाग;
        संख्या ल = प + ग;
        यावत् (क > 0) {
            ल = ल - 1;
            अंतर्_लिख1(बफ, ल, 48 + (क % 10));
            क = क / 10;
        }
        प = प + ग;
    }
    // अंश — 6 अंक, अंतिम गैर-शून्य तक
    संख्या श = फभाग;
    संख्या द0 = श / 100000;  श = श % 100000;
    संख्या द1 = श / 10000;   श = श % 10000;
    संख्या द2 = श / 1000;    श = श % 1000;
    संख्या द3 = श / 100;     श = श % 100;
    संख्या द4 = श / 10;
    संख्या द5 = श % 10;
    संख्या अंतिम = -1;
    यदि (द0 != 0) { अंतिम = 0; }
    यदि (द1 != 0) { अंतिम = 1; }
    यदि (द2 != 0) { अंतिम = 2; }
    यदि (द3 != 0) { अंतिम = 3; }
    यदि (द4 != 0) { अंतिम = 4; }
    यदि (द5 != 0) { अंतिम = 5; }
    यदि (अंतिम >= 0) {
        अंतर्_लिख1(बफ, प, 46);           // '.'
        प = प + 1;
        अंतर्_लिख1(बफ, प, 48 + द0);
        अंतर्_लिख1(बफ, प + 1, 48 + द1);
        अंतर्_लिख1(बफ, प + 2, 48 + द2);
        अंतर्_लिख1(बफ, प + 3, 48 + द3);
        अंतर्_लिख1(बफ, प + 4, 48 + द4);
        अंतर्_लिख1(बफ, प + 5, 48 + द5);
        प = प + अंतिम + 1;
    }
    परत् प;
}

