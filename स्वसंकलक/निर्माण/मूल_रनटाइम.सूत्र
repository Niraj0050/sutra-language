        अन्यथा यदि (क >= २२४ && क < २४०) { सूचक = सूचक + ३; }
        अन्यथा यदि (क >= २४० && क < २४८) { सूचक = सूचक + ४; }
        अन्यथा { सूचक = सूचक + १; }
