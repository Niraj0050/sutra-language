कार्य कोष्ठ_सूची() { परत् "[सूची]"; }

// पूर्व: sutra_print_dynamic — रन-टाइम प्रकार पर निर्भर
कार्य गतिशील_छापो(संख्या मूल्य) {
    यदि (मूल्य == ०) { परत् पंक्ति_लिखो(संख्या_से_पाठ(०)); }
    संख्या प्र = सूत्र_ब्लॉक_प्रकार(मूल्य);
    यदि (प्र == १) { परत् पंक्ति_लिखो(मूल्य); }
