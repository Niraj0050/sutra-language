// मूल_रनटाइम.सूत्र — रनटाइम के पत्ते (leaf) कार्य, सूत्र में
// ============================================================
// ये कार्य पहले sutra_runtime.c में C थे। अब सूत्र में — केवल
// निम्न-स्तर अंतर्निर्देश (अंतर्_पढ़8 / अंतर्_पढ़1) और अंकगणित।
// कोई आवंटन नहीं। हर उत्पन्न binary में लिंक होते हैं।
//
// ढेर-वस्तु विन्यास (memory.md):
//   पाठ  : [क्षमता:८][लंबाई:८][utf8 बाइट्स][\0]
//   सूची : [क्षमता:८][लंबाई:८][तत्व:८]...
//   शब्दकोश: [गणना:८][क्षमता:८][प्रविष्टियाँ*:८]
// ============================================================

// ===== अपवाद-अवस्था (पूर्व: sutra_runtime.c के C globals) =====
// library-mode initializer नहीं चलता → ० से शुरू; ढेर lazy-alloc।
संख्या प्रयत्न_गहराई = ०;
संख्या प्रयत्न_ढेर = ०;      // VirtualAlloc: २५६ × २५६-बाइट jmp_buf
संख्या प्रयत्न_जड़_गण = ०;   // VirtualAlloc: २५६ × ८-बाइट gc_roots_count स्नैपशॉट
संख्या सक्रिय_अपवाद = ०;

// ===== सञ्चिका I/O + तर्क कोष (पूर्व: sutra_runtime.c के Win32 भाग) =====
// तल.s पतले wrappers देता; रचना यहाँ। बफ़र lazy VirtualAlloc, कभी मुक्त नहीं।
संख्या सञ्चिका_पथ_बफ = ०;     // ८१९२ बाइट = ४०९६ wide-char (मार्ग UTF-16)
संख्या सञ्चिका_समादेश_बफ = ०; // २६२१४४ बाइट = १३१०७२ wide-char (समादेश-रेखा)
संख्या सञ्चिका_तर्क_बफ = ०;    // ६५५३६ बाइट UTF-8 (एक तर्क का रूपांतरण)
संख्या तर्क_तैयार = ०;         // ० = अभी नहीं पढ़ा
संख्या तर्क_गण = ०;
संख्या तर्क_डब्ल्यू = ०;       // CommandLineToArgvW परिणाम (LocalAlloc — रखते हैं)
संख्या दशमलव_बफ = ०;          // ६४ बाइट — दशमलव_प्रारूप का अंक-scratch

// ===== पाठ_सूचकांक का अनुक्रमिक-पहुँच cache (पूर्व: sutra_runtime.c के sg_cache_*) =====
// लेक्सर स्रोत[०],[१],[२]... क्रम में पढ़ता → हर बार शुरू से UTF-8 डिकोड न करके
// पिछली स्थिति से आगे। GC-चक्र-स्टैम्प से अमान्य (auto-GC भी चक्र बढ़ाता)।
संख्या पसू_कैश_स = ०;
संख्या पसू_कैश_क = ०;       // cached अक्षर-सूचकांक
संख्या पसू_कैश_ब = ०;       // उस सूचकांक का बाइट-ऑफसेट
संख्या पसू_कैश_चक्र = -१;   // सूत्र_गण_चक्र() स्नैपशॉट

// एक UTF-8 अक्षर का कोडबिंदु (पाठ के पहले अक्षर का)।  पूर्व: sutra_char_ord
कार्य अक्षर_कोडबिंदु(संख्या स) {
    यदि (स == शून्यम्) { परत् -१; }
    संख्या लं = अंतर्_पढ़8(स, ८);
    यदि (लं <= ०) { परत् -१; }
    संख्या क1 = अंतर्_पढ़1(स, १६);
    यदि (क1 < १२८) {
        परत् क1;
    }
    यदि (क1 >= १९२ && क1 < २२४ && लं >= २) {
        संख्या क2 = अंतर्_पढ़1(स, १७);
        परत् ((क1 - १९२) * ६४) + (क2 % ६४);
    }
    यदि (क1 >= २२४ && क1 < २४० && लं >= ३) {
        संख्या क2 = अंतर्_पढ़1(स, १७);
        संख्या क3 = अंतर्_पढ़1(स, १८);
        परत् ((क1 - २२४) * ४०९६) + ((क2 % ६४) * ६४) + (क3 % ६४);
    }
    यदि (क1 >= २४० && क1 < २४८ && लं >= ४) {
        संख्या क2 = अंतर्_पढ़1(स, १७);
        संख्या क3 = अंतर्_पढ़1(स, १८);
        संख्या क4 = अंतर्_पढ़1(स, १९);
        परत् ((क1 - २४०) * २६२१४४) + ((क2 % ६४) * ४०९६) + ((क3 % ६४) * ६४) + (क4 % ६४);
    }
    परत् ६५५३३;
}

// पाठ में UTF-8 कोडबिंदुओं की संख्या।  पूर्व: sutra_str_length
कार्य पाठ_कोडबिंदु_गणना(संख्या स) {
    यदि (स == शून्यम्) { परत् ०; }
    संख्या लं = अंतर्_पढ़8(स, ८);
    संख्या सूचक = ०;
    संख्या गणना = ०;
    यावत् (सूचक < लं) {
        संख्या क = अंतर्_पढ़1(स, १६ + सूचक);
        यदि (क < १२८) {
            सूचक = सूचक + १;
        } अन्यथा यदि (क >= १९२ && क < २२४) {
            सूचक = सूचक + २;
        } अन्यथा यदि (क >= २२४ && क < २४०) {
            सूचक = सूचक + ३;
        } अन्यथा यदि (क >= २४० && क < २४८) {
            सूचक = सूचक + ४;
        } अन्यथा {
            सूचक = सूचक + १;
        }
        गणना = गणना + १;
    }
    परत् गणना;
}

// दो पाठ बाइट-दर-बाइट समान?  पूर्व: sutra_str_equal (१/०)
// छोटे पूर्णांक (< ६५५३६) को अमान्य पता मानकर ० लौटाता है — crash-सुरक्षित।
कार्य पाठ_तुल्य(संख्या अ, संख्या ब) {
    यदि (अ == ब) { परत् १; }
    यदि (अ == शून्यम् || ब == शून्यम्) { परत् ०; }
    यदि (अ < ६५५३६ || ब < ६५५३६) { परत् ०; }
    यदि (न अंतर्_क्या_पाठ(अ) || न अंतर्_क्या_पाठ(ब)) { परत् ०; }
    संख्या ल_अ = अंतर्_पढ़8(अ, ८);
    संख्या ल_ब = अंतर्_पढ़8(ब, ८);
    यदि (ल_अ != ल_ब) { परत् ०; }
    संख्या सूचक = ०;
    यावत् (सूचक < ल_अ) {
        यदि (अंतर्_पढ़1(अ, १६ + सूचक) != अंतर्_पढ़1(ब, १६ + सूचक)) {
            परत् ०;
        }
        सूचक = सूचक + १;
    }
    परत् १;
}

// सूची/शब्दकोश की कच्ची लंबाई (गणना)।  पूर्व: sutra_arr_length
कार्य सञ्चय_गणना(संख्या व) {
    यदि (व == शून्यम्) { परत् ०; }
    यदि (अंतर्_क्या_शब्दकोश(व)) {
        परत् अंतर्_पढ़8(व, ०);   // शब्दकोश: [गणना] ऑफसेट ० पर
    }
    परत् अंतर्_पढ़8(व, ८);       // सूची: [लंबाई] ऑफसेट ८ पर
}

// बहुरूपी लंबाई — पाठ → कोडबिंदु, अन्यथा → गणना।  पूर्व: sutra_dynamic_length
कार्य दैशिक_लंबाई(संख्या व) {
    यदि (व == शून्यम्) { परत् ०; }
    यदि (अंतर्_क्या_पाठ(व)) {
        परत् पाठ_कोडबिंदु_गणना(व);
    }
    परत् सञ्चय_गणना(व);
}

// ===== पाठ कोडबिंदु-वार तुलना (< > <= >=) — पूर्व: sutra_utf8_cmp_codepoints =====

// लीड-बाइट से UTF-8 अक्षर की बाइट-चौड़ाई
कार्य अक्षर_बाइट_चौड़ाई(संख्या लीड) {
    यदि (लीड < १२८) { परत् १; }
    यदि (लीड >= १९२ && लीड < २२४) { परत् २; }
    यदि (लीड >= २२४ && लीड < २४०) { परत् ३; }
    यदि (लीड >= २४० && लीड < २४८) { परत् ४; }
    परत् १;
}

// पाठ के byte-ऑफसेट ऑफ पर कोडबिंदु का मान (चौ = बाइट-चौड़ाई)
कार्य कोडबिंदु_मान(संख्या स, संख्या ऑफ, संख्या चौ) {
    संख्या क1 = अंतर्_पढ़1(स, १६ + ऑफ);
    यदि (चौ == १) { परत् क1; }
    यदि (चौ == २) {
        परत् ((क1 - १९२) * ६४) + (अंतर्_पढ़1(स, १७ + ऑफ) % ६४);
    }
    यदि (चौ == ३) {
        परत् ((क1 - २२४) * ४०९६) + ((अंतर्_पढ़1(स, १७ + ऑफ) % ६४) * ६४) + (अंतर्_पढ़1(स, १८ + ऑफ) % ६४);
    }
    परत् ((क1 - २४०) * २६२१४४) + ((अंतर्_पढ़1(स, १७ + ऑफ) % ६४) * ४०९६) + ((अंतर्_पढ़1(स, १८ + ऑफ) % ६४) * ६४) + (अंतर्_पढ़1(स, १९ + ऑफ) % ६४);
}

// -१ यदि अ < ब, ० यदि तुल्य, १ यदि अ > ब  (कोडबिंदु-वार)
कार्य पाठ_कोडबिंदु_तुलना(संख्या अ, संख्या ब) {
    यदि (अ == ब) { परत् ०; }
    यदि (अ == शून्यम्) { परत् -१; }
    यदि (ब == शून्यम्) { परत् १; }
    संख्या ल_अ = अंतर्_पढ़8(अ, ८);
    संख्या ल_ब = अंतर्_पढ़8(ब, ८);
    संख्या इ = ०;
    संख्या ज = ०;
    यावत् (इ < ल_अ && ज < ल_ब) {
        संख्या चौ_अ = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(अ, १६ + इ));
        यदि (इ + चौ_अ > ल_अ) { चौ_अ = १; }
        संख्या चौ_ब = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(ब, १६ + ज));
        यदि (ज + चौ_ब > ल_ब) { चौ_ब = १; }
        संख्या क_अ = कोडबिंदु_मान(अ, इ, चौ_अ);
        संख्या क_ब = कोडबिंदु_मान(ब, ज, चौ_ब);
        यदि (क_अ != क_ब) {
            यदि (क_अ < क_ब) { परत् -१; }
            परत् १;
        }
        इ = इ + चौ_अ;
        ज = ज + चौ_ब;
    }
    यदि (इ >= ल_अ && ज >= ल_ब) { परत् ०; }
    यदि (इ >= ल_अ) { परत् -१; }
    परत् १;
}

// dynamic < > <= >=  — दोनों पाठ हों तो कोडबिंदु-वार, वरना पूर्णांक तुलना।
// IR backend `मान`-typed operands (सूची तत्व वग़ैरह) को यहाँ भेजता है —
// वरना raw cmpq दो पाठ-सूचकों की पता-तुलना कर बैठता।
कार्य सामान्य_न्यून(संख्या अ, संख्या ब) {
    यदि (अंतर्_क्या_पाठ(अ)) {
        यदि (अंतर्_क्या_पाठ(ब)) { परत् पाठ_न्यून(अ, ब); }
    }
    यदि (अ < ब) { परत् १; }
    परत् ०;
}
कार्य सामान्य_अधिक(संख्या अ, संख्या ब) {
    यदि (अंतर्_क्या_पाठ(अ)) {
        यदि (अंतर्_क्या_पाठ(ब)) { परत् पाठ_अधिक(अ, ब); }
    }
    यदि (अ > ब) { परत् १; }
    परत् ०;
}
कार्य सामान्य_न्यून_सम(संख्या अ, संख्या ब) {
    यदि (सामान्य_अधिक(अ, ब)) { परत् ०; }
    परत् १;
}
कार्य सामान्य_अधिक_सम(संख्या अ, संख्या ब) {
    यदि (सामान्य_न्यून(अ, ब)) { परत् ०; }
    परत् १;
}

कार्य पाठ_न्यून(संख्या अ, संख्या ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) < ०) { परत् १; }
    परत् ०;
}
कार्य पाठ_अधिक(संख्या अ, संख्या ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) > ०) { परत् १; }
    परत् ०;
}
कार्य पाठ_न्यून_सम(संख्या अ, संख्या ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) <= ०) { परत् १; }
    परत् ०;
}
कार्य पाठ_अधिक_सम(संख्या अ, संख्या ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) >= ०) { परत् १; }
    परत् ०;
}

// ===== आवंटन करने वाली पाठ-क्रियाएँ =====
// (heap अब सूत्र के arena में — मूल_आवंटक.सूत्र का सूत्र_आवंटन)

// बल बाइट्स का पाठ-block; header [क्षमता][लंबाई]; अंत में \0।  लौटाता है pointer।
कार्य पाठ_आवंटित(संख्या बल) {
    संख्या धा = बल;
    यदि (धा == ०) { धा = ४; }
    संख्या प = सूत्र_आवंटन(१६ + धा + १, १);
    अंतर्_लिख8(प, ०, धा);
    अंतर्_लिख8(प, ८, बल);
    अंतर्_लिख1(प, १६ + बल, ०);
    परत् प;
}

// गंतव्य_प[ग_ऑफ ..] ← स्रोत_प[स_ऑफ ..], बल बाइट्स। ८-बाइट शब्द जितना संभव,
// फिर शेष बाइट-दर-बाइट। ऑफसेट header-सहित (raw block offset)।
कार्य खंड_प्रतिलिपि(संख्या गंतव्य_प, संख्या ग_ऑफ, संख्या स्रोत_प, संख्या स_ऑफ, संख्या बल) {
    संख्या इ = ०;
    यावत् (इ + ८ <= बल) {
        अंतर्_लिख8(गंतव्य_प, ग_ऑफ + इ, अंतर्_पढ़8(स्रोत_प, स_ऑफ + इ));
        इ = इ + ८;
    }
    यावत् (इ < बल) {
        अंतर्_लिख1(गंतव्य_प, ग_ऑफ + इ, अंतर्_पढ़1(स्रोत_प, स_ऑफ + इ));
        इ = इ + १;
    }
    परत् ०;
}

// स्रोत_प के बाइट-ऑफसेट बा से बल बाइट्स को नए पाठ में copy करो
कार्य पाठ_प्रति(संख्या स्रोत_प, संख्या बा, संख्या बल) {
    संख्या प = पाठ_आवंटित(बल);
    खंड_प्रतिलिपि(प, १६, स्रोत_प, १६ + बा, बल);
    परत् प;
}

// बाइट-श्रेणी [बाइट_आरंभ, बाइट_आरंभ+बाइट_लंबाई) की एक-आवंटन प्रति —
// पाठ_उपखंड के उलट कोई कोडबिंदु-गणना/कोडबिंदु→बाइट walk नहीं (O(span))।
// lexer इसे token-text slice के लिए बुलाता (byte-cursor से सीमाएँ)।
कार्य पाठ_उपखंड_बाइट(संख्या पा, संख्या बाइट_आरंभ, संख्या बाइट_लंबाई) {
    यदि (पा == ०) { परत् पाठ_आवंटित(०); }
    यदि (बाइट_आरंभ < ० || बाइट_लंबाई < ०) {
        प्रक्षेपः "त्रुटिः — पाठ_उपखंड_बाइट: ऋण सूचकांक";
    }
    यदि (बाइट_आरंभ + बाइट_लंबाई > अंतर्_पढ़8(पा, ८)) {
        प्रक्षेपः "त्रुटिः — पाठ_उपखंड_बाइट: बाइट-सीमा अतिक्रान्ता";
    }
    यदि (बाइट_लंबाई == ०) { परत् पाठ_आवंटित(०); }
    परत् पाठ_प्रति(पा, बाइट_आरंभ, बाइट_लंबाई);
}

// पूर्व: sutra_str_concat
कार्य पाठ_जोड़(संख्या अ, संख्या ब) {
    यदि (अ == ० && ब == ०) { परत् पाठ_आवंटित(०); }
    यदि (अ == ०) { परत् पाठ_प्रति(ब, ०, अंतर्_पढ़8(ब, ८)); }
    यदि (ब == ०) { परत् पाठ_प्रति(अ, ०, अंतर्_पढ़8(अ, ८)); }
    संख्या ल_अ = अंतर्_पढ़8(अ, ८);
    संख्या ल_ब = अंतर्_पढ़8(ब, ८);
    // ⚠ runtime फलन precise-roots के बिना संकलित होते: अ/ब यहाँ rooted नहीं। कॉलर का अस्थायी (जैसे
    // पाठ_योग_गतिक में संख्या_से_पाठ का परिणाम) इस आवंटन के बीच auto-GC से sweep हो सकता था, और
    // परिणाम-ब्लॉक उसी मुक्त ब्लॉक का पुनः-उपयोग बनकर "abc5" को "abca" कर देता — इसलिए आवंटन GC-दबाव में।
    सूत्र_जीसी_दबाओ();
    संख्या प = पाठ_आवंटित(ल_अ + ल_ब);
    सूत्र_जीसी_छोड़ो();
    खंड_प्रतिलिपि(प, १६, अ, १६, ल_अ);
    खंड_प्रतिलिपि(प, १६ + ल_अ, ब, १६, ल_ब);
    परत् प;
}

// ── पाठ_निर्माता ── amortized-O(१) string builder। एक सामान्य पाठ-ब्लॉक
// ही है (प्रकार १, विन्यास [cap@०][len@८][bytes@१६][NUL]), बस cap > len
// (अतिरिक्त जगह)। हर पाठ-op len पढ़ता (cap नहीं) → spare-cap वाला builder
// हर जगह वैध पाठ है। निर्माता_जोड़: जगह हो तो in-place append (वही pointer,
// O(append-len)); वरना क्षमता दुगनी करके सूत्र_पुनः_आवंटन। n append =
// O(n) कुल, न कि पाठ_जोड़ का O(n²)।
// ⚠ mutate-in-place: builder को दूसरे चर में alias मत करो; append करते
//    समय पुराने pointer पर भरोसा मत करो — हमेशा `ब = निर्माता_जोड़(ब,…)`.
कार्य निर्माता_नया() {
    संख्या ब = पाठ_आवंटित(१६);   // cap=१६, len=१६
    अंतर्_लिख8(ब, ८, ०);          // len ← ०
    अंतर्_लिख1(ब, १६, ०);         // NUL
    परत् ब;
}

कार्य निर्माता_जोड़(संख्या ब, संख्या त) {
    यदि (त == ०) { परत् ब; }
    यदि (न अंतर्_क्या_पाठ(त)) { परत् ब; }
    संख्या तल = अंतर्_पढ़8(त, ८);
    यदि (तल == ०) { परत् ब; }
    संख्या बल = अंतर्_पढ़8(ब, ८);
    संख्या नई = बल + तल;
    संख्या कैप = अंतर्_पढ़8(ब, ०);
    यदि (नई > कैप) {
        संख्या नकैप = कैप * २;
        यदि (नकैप < नई) { नकैप = नई; }
        सूत्र_जीसी_दबाओ();
        ब = सूत्र_पुनः_आवंटन(ब, १६ + नकैप + १);
        अंतर्_लिख8(ब, ०, नकैप);
        सूत्र_जीसी_छोड़ो();
    }
    खंड_प्रतिलिपि(ब, १६ + बल, त, १६, तल);
    अंतर्_लिख8(ब, ८, नई);
    अंतर्_लिख1(ब, १६ + नई, ०);
    परत् ब;
}

कार्य निर्माता_अक्षर(संख्या ब, संख्या कोड) {
    परत् निर्माता_जोड़(ब, अक्षर_बना(कोड));
}

कार्य निर्माता_लंबाई(संख्या ब) {
    यदि (ब == ०) { परत् ०; }
    परत् पाठ_कोडबिंदु_गणना(ब);
}

// builder → अंतिम पाठ। zero-copy: builder खुद ही पाठ बन जाता (spare cap
// harmless)। इसके बाद उस builder पर append मत करो।
कार्य निर्माता_पाठ(संख्या ब) {
    यदि (ब == ०) { परत् पाठ_आवंटित(०); }
    परत् ब;
}

// पूर्व: sutra_int_to_str  (यदि म असल में पाठ-pointer है तो उसे ही लौटाओ)
कार्य अंक_गणना(संख्या व) {
    यदि (व == ०) { परत् १; }
    संख्या ग = ०;
    संख्या क = व;
    यदि (क < ०) { ग = १; क = ० - क; }
    यावत् (क > ०) {
        ग = ग + १;
        क = क / १०;
    }
    परत् ग;
}

कार्य संख्या_से_पाठ(संख्या व) {
    यदि (अंतर्_क्या_पाठ(व)) { परत् व; }
    संख्या लं = अंक_गणना(व);
    संख्या प = पाठ_आवंटित(लं);
    यदि (व == ०) {
        अंतर्_लिख1(प, १६, ४८);
        परत् प;
    }
    संख्या क = व;
    संख्या ऋण = ०;
    यदि (क < ०) { ऋण = १; क = ० - क; }
    संख्या स्थान = लं - १;
    यावत् (क > ०) {
        अंतर्_लिख1(प, १६ + स्थान, ४८ + (क % १०));
        क = क / १०;
        स्थान = स्थान - १;
    }
    यदि (ऋण == १) {
        अंतर्_लिख1(प, १६, ४५);
    }
    परत् प;
}

// पूर्व: sutra_bool_to_str
कार्य बूल_से_पाठ(संख्या म) {
    यदि (म != ०) {
        संख्या प = पाठ_आवंटित(१२);
        अंतर्_लिख1(प, १६, २२४); अंतर्_लिख1(प, १७, १६४); अंतर्_लिख1(प, १८, १८४);
        अंतर्_लिख1(प, १९, २२४); अंतर्_लिख1(प, २०, १६४); अंतर्_लिख1(प, २१, १६४);
        अंतर्_लिख1(प, २२, २२४); अंतर्_लिख1(प, २३, १६५); अंतर्_लिख1(प, २४, १४१);
        अंतर्_लिख1(प, २५, २२४); अंतर्_लिख1(प, २६, १६४); अंतर्_लिख1(प, २७, १७५);
        परत् प;
    }
    संख्या प = पाठ_आवंटित(१५);
    अंतर्_लिख1(प, १६, २२४); अंतर्_लिख1(प, १७, १६४); अंतर्_लिख1(प, १८, १३३);
    अंतर्_लिख1(प, १९, २२४); अंतर्_लिख1(प, २०, १६४); अंतर्_लिख1(प, २१, १८४);
    अंतर्_लिख1(प, २२, २२४); अंतर्_लिख1(प, २३, १६४); अंतर्_लिख1(प, २४, १६४);
    अंतर्_लिख1(प, २५, २२४); अंतर्_लिख1(प, २६, १६५); अंतर्_लिख1(प, २७, १४१);
    अंतर्_लिख1(प, २८, २२४); अंतर्_लिख1(प, २९, १६४); अंतर्_लिख1(प, ३०, १७५);
    परत् प;
}

// पूर्व: sutra_null_to_str  → "शून्यम्"
कार्य शून्य_से_पाठ() {
    संख्या प = पाठ_आवंटित(२१);
    अंतर्_लिख1(प, १६, २२४); अंतर्_लिख1(प, १७, १६४); अंतर्_लिख1(प, १८, १८२);
    अंतर्_लिख1(प, १९, २२४); अंतर्_लिख1(प, २०, १६५); अंतर्_लिख1(प, २१, १३०);
    अंतर्_लिख1(प, २२, २२४); अंतर्_लिख1(प, २३, १६४); अंतर्_लिख1(प, २४, १६८);
    अंतर्_लिख1(प, २५, २२४); अंतर्_लिख1(प, २६, १६५); अंतर्_लिख1(प, २७, १४१);
    अंतर्_लिख1(प, २८, २२४); अंतर्_लिख1(प, २९, १६४); अंतर्_लिख1(प, ३०, १७५);
    अंतर्_लिख1(प, ३१, २२४); अंतर्_लिख1(प, ३२, १६४); अंतर्_लिख1(प, ३३, १७४);
    अंतर्_लिख1(प, ३४, २२४); अंतर्_लिख1(प, ३५, १६५); अंतर्_लिख1(प, ३६, १४१);
    परत् प;
}

// पूर्व: sutra_char_chr — कोडबिंदु → १-४ बाइट UTF-8 पाठ
कार्य अक्षर_बना(संख्या कब) {
    यदि (कब < १२८) {
        संख्या प = पाठ_आवंटित(१);
        अंतर्_लिख1(प, १६, कब);
        परत् प;
    }
    यदि (कब < २०४८) {
        संख्या प = पाठ_आवंटित(२);
        अंतर्_लिख1(प, १६, १९२ + (कब / ६४));
        अंतर्_लिख1(प, १७, १२८ + (कब % ६४));
        परत् प;
    }
    यदि (कब < ६५५३६) {
        संख्या प = पाठ_आवंटित(३);
        अंतर्_लिख1(प, १६, २२४ + (कब / ४०९६));
        अंतर्_लिख1(प, १७, १२८ + ((कब / ६४) % ६४));
        अंतर्_लिख1(प, १८, १२८ + (कब % ६४));
        परत् प;
    }
    यदि (कब <= १११४१११) {
        संख्या प = पाठ_आवंटित(४);
        अंतर्_लिख1(प, १६, २४० + (कब / २६२१४४));
        अंतर्_लिख1(प, १७, १२८ + ((कब / ४०९६) % ६४));
        अंतर्_लिख1(प, १८, १२८ + ((कब / ६४) % ६४));
        अंतर्_लिख1(प, १९, १२८ + (कब % ६४));
        परत् प;
    }
    संख्या प = पाठ_आवंटित(३);
    अंतर्_लिख1(प, १६, २३९);
    अंतर्_लिख1(प, १७, १९१);
    अंतर्_लिख1(प, १८, १८९);
    परत् प;
}

// पूर्व: sutra_substr — कोडबिंदु-सूचकांक [आरंभ, अंत)
कार्य पाठ_उपखंड(संख्या पा, संख्या आरंभ, संख्या अंत) {
    यदि (पा == ०) { परत् पाठ_आवंटित(०); }
    यदि (आरंभ < ० || अंत < ०) {
        प्रक्षेपः "त्रुटिः — अमान्य सूचकांक मान (Index cannot be negative)";
    }
    संख्या बल = अंतर्_पढ़8(पा, ८);
    संख्या कुल_कब = पाठ_कोडबिंदु_गणना(पा);
    यदि (आरंभ > कुल_कब || अंत > कुल_कब) {
        प्रक्षेपः "त्रुटिः — पाठस्य सीमा अतिक्रान्ता (String index out of bounds)";
    }
    यदि (आरंभ > अंत) {
        प्रक्षेपः "त्रुटिः — आरंभः अन्त्यतः अधिकः अस्ति (start > end)";
    }
    यदि (आरंभ == अंत) { परत् पाठ_आवंटित(०); }
    संख्या बा_आरंभ = ०;
    संख्या बा_अंत = बल;
    संख्या कब = ०;
    संख्या इ = ०;
    यावत् (इ < बल) {
        संख्या पूर्व = इ;
        संख्या च = अंतर्_पढ़1(पा, १६ + इ);
        इ = इ + अक्षर_बाइट_चौड़ाई(च);
        यदि (कब == आरंभ) { बा_आरंभ = पूर्व; }
        यदि (कब == अंत) { बा_अंत = पूर्व; विरामः; }
        कब = कब + १;
    }
    यदि (अंत == कुल_कब) { बा_अंत = बल; }
    परत् पाठ_प्रति(पा, बा_आरंभ, बा_अंत - बा_आरंभ);
}


