    यदि (द0 != ०) { अंतिम = ०; }
    यदि (द1 != ०) { अंतिम = १; }
    यदि (द2 != ०) { अंतिम = २; }
    यदि (द3 != ०) { अंतिम = ३; }
    यदि (द4 != ०) { अंतिम = ४; }
    यदि (द5 != ०) { अंतिम = ५; }
    यदि (अंतिम >= ०) {
