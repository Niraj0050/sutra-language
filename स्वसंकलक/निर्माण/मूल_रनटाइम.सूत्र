// ===== घात (pow) — पूर्व: sr_ln / sr_exp / sutra_math_pow_f (C) =====
// bit-cast: "मान"-param passthrough (मशीन-स्तर केवल mov; type-tag बदलता)।
// बड़े स्थिरांक (2^52) रनटाइम-गुणन से — int-साहित्य ≥ 2³¹ सीमा से बचने को।
कार्य दशमलव_बिट(व) { परत् व; }
कार्य बिट_दशमलव(व) { परत् व; }

संख्या घा_बावन = 0;
कार्य दो_बावन() {
    यदि (घा_बावन == 0) {
        संख्या फ = 1;
        संख्या इ = 0;
        यावत् (इ < 52) { फ = फ * 2; इ = इ + 1; }
        घा_बावन = फ;
    }
    परत् घा_बावन;
}

// प्राकृतिक-लघुगणक — Taylor (atanh श्रेणी); चर > 0 माना
कार्य लघुगणक_रन(दशमलव चर) {
    यदि (चर <= 0.0) { परत् 0.0; }
    संख्या द52 = दो_बावन();
    संख्या चबि = दशमलव_बिट(चर);
    संख्या कै = (चबि / द52) % 2048 - 1023;
    संख्या मंबि = (चबि % द52) + 1023 * द52;
    दशमलव मं = बिट_दशमलव(मंबि);
    यदि (मं > 1.4142135623730951) {
        मं = मं * 0.5;
        कै = कै + 1;
    }
    दशमलव सम = (मं - 1.0) / (मं + 1.0);
    दशमलव समवर्ग = सम * सम;
    दशमलव पद = सम;
    दशमलव योग = 0.0;
    संख्या इक = 1;
    यावत् (इक < 40) {
        योग = योग + पद / इक;
        पद = पद * समवर्ग;
        इक = इक + 2;
    }
    परत् 2.0 * योग + कै * 0.6931471805599453;
}

// e^चर — range-reduction + Taylor
कार्य घातांकी_रन(दशमलव चर) {
    संख्या द52 = दो_बावन();
    दशमलव कैफ = चर * 1.4426950408889634;
    संख्या कै = गोल(कैफ);
    यदि (कै > 1000) { कै = 1000; }
    यदि (कै < -1000) { कै = 0 - 1000; }
    दशमलव शेष = चर - कै * 0.6931471805599453;
    दशमलव पद = 1.0;
    दशमलव योग = 1.0;
    संख्या इक = 1;
    यावत् (इक < 20) {
        पद = पद * शेष / इक;
        योग = योग + पद;
        इक = इक + 1;
    }
    संख्या दोबि = (कै + 1023) * द52;
    दशमलव दोघात = बिट_दशमलव(दोबि);
    परत् योग * दोघात;
}

// पूर्व: sutra_math_pow_f — निम्नक `घात` → यहाँ। पूर्णांक-घात = repeated-multiply;
// भिन्नात्मक = exp(ई·ln ब)। दशमलव param/return = f64-bits सीधे।
कार्य रन_घात(दशमलव ब, दशमलव ई) {
    संख्या ईपू = गोल(ई);
    यदि (ईपू == ई) {
        यदि (ई >= -1024.0) {
            यदि (ई <= 1024.0) {
                संख्या नि = ईपू;
                संख्या ऋण = 0;
                यदि (नि < 0) { ऋण = 1; नि = 0 - नि; }
                दशमलव सञ्चय = 1.0;
                दशमलव आधार = ब;
                यावत् (नि > 0) {
                    यदि (नि % 2 == 1) { सञ्चय = सञ्चय * आधार; }
                    आधार = आधार * आधार;
                    नि = नि / 2;
                }
                यदि (ऋण == 1) { परत् 1.0 / सञ्चय; }
                परत् सञ्चय;
            }
        }
    }
    यदि (ब > 0.0) { परत् घातांकी_रन(ई * लघुगणक_रन(ब)); }
    परत् 0.0;
}
