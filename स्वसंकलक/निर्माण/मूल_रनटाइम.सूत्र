// ============================================================
// शब्दकोश — open-addressing हैश सूचकांक + packed प्रविष्टियाँ
// पूर्व: sutra_dict_* (C, हर lookup O(n) linear-scan)। अब सूत्र, O(1) औसत।
//
// block विन्यास (40 बाइट, प्रकार 4):
//   ऑफ 0  : गण           — जीवित प्रविष्टि गिनती (GC इसे पढ़ता; पुराना ऑफसेट)
//   ऑफ 8  : क्षमता        — प्रविष्टि-बफर क्षमता (जोड़ों में; पुराना ऑफसेट)
//   ऑफ 16 : प्रविष्टियाँ*  — packed [कुंजी:8][मूल्य:8] × गण, insertion-order
//                          (GC पहले जैसा ट्रेस करता; पुराना ऑफसेट)
//   ऑफ 24 : सूचकांक*      — हैश तालिका: पूर्णांक slot सरणी;
//                          slot मान = (प्रविष्टि-अनुक्रमांक + 1), 0 = रिक्त
//   ऑफ 32 : हैश_क्षमता     — 2 की घात
// GC (चिह्नित, प्रकार==4): गण + प्रविष्टियाँ पहले जैसा; सूचकांक* को
//   चिह्नित_कच्चा (शुद्ध पूर्णांक — mark-bit मात्र)।
//
// कुंजियाँ पाठ या छोटा-पूर्णांक (पहचान से तुलना — पाठ_तुल्य दोनों संभालता)।
// लोड-फैक्टर ≤ 0.75 → probe हमेशा किसी रिक्त slot पर रुकता।
// ============================================================

कार्य कोष_हैश(संख्या कुं) {
    यदि (कुं < 65536) { परत् कुं; }              // छोटा पूर्णांक कुंजी → स्वयं
    यदि (न अंतर्_क्या_पाठ(कुं)) { परत् कुं / 16; }  // गैर-पाठ पॉइंटर → पहचान
    संख्या लं = अंतर्_पढ़8(कुं, 8);
    संख्या ह = 0;
    संख्या इ = 0;
    यावत् (इ < लं) {
        ह = ह * 31 + अंतर्_पढ़1(कुं, 16 + इ);
        ह = ह % 1000000007;
        इ = इ + 1;
    }
    परत् ह;
}

// कुंजी के लिए slot — मिलान-slot या पहला रिक्त slot (जो पहले मिले)।
// probe हक्षम बार से बँधा (load-factor ≤ 0.75 → रिक्त slot इससे बहुत पहले
// मिलता; bound = defensive + clang को willreturn सिद्ध करने देता → LICM
// एक loop-invariant कोष_स्लॉट कॉल hoist कर पाता)।
कार्य कोष_स्लॉट(संख्या कोष, संख्या कुं) {
    संख्या हक्षम = अंतर्_पढ़8(कोष, 32);
    संख्या अनुक्र = अंतर्_पढ़8(कोष, 24);
    संख्या प्रवि = अंतर्_पढ़8(कोष, 16);
    संख्या स = कोष_हैश(कुं) % हक्षम;
    यदि (स < 0) { स = स + हक्षम; }
    संख्या प्रयास = 0;
    यावत् (प्रयास < हक्षम) {
        संख्या ई = अंतर्_पढ़8(अनुक्र, स * 8);
        यदि (ई == 0) { परत् स; }
        यदि (पाठ_तुल्य(अंतर्_पढ़8(प्रवि, (ई - 1) * 16), कुं)) { परत् स; }
        स = स + 1;
        यदि (स >= हक्षम) { स = 0; }
        प्रयास = प्रयास + 1;
    }
    परत् स;
}

// सूचकांक तालिका को packed प्रविष्टियों से नए सिरे से भरो।
// (सूचकांक बफर पहले से शून्य होना चाहिए — ताज़ा आवंटन या मैनुअल clear।)
कार्य कोष_सूचकांक_भरो(संख्या कोष) {
    संख्या हक्षम = अंतर्_पढ़8(कोष, 32);
    संख्या अनुक्र = अंतर्_पढ़8(कोष, 24);
    संख्या प्रवि = अंतर्_पढ़8(कोष, 16);
    संख्या गण = अंतर्_पढ़8(कोष, 0);
    संख्या इ = 0;
    यावत् (इ < गण) {
        संख्या स = कोष_हैश(अंतर्_पढ़8(प्रवि, इ * 16)) % हक्षम;
        यदि (स < 0) { स = स + हक्षम; }
        यावत् (अंतर्_पढ़8(अनुक्र, स * 8) != 0) {
            स = स + 1;
            यदि (स >= हक्षम) { स = 0; }
        }
        अंतर्_लिख8(अनुक्र, स * 8, इ + 1);
        इ = इ + 1;
    }
    परत् 0;
}

कार्य शब्दकोश_रचना() {
    सूत्र_जीसी_दबाओ();
    संख्या कोष = सूत्र_आवंटन(40, 4);
    संख्या प्रवि = सूत्र_आवंटन(4 * 16, 2);
    संख्या अनुक्र = सूत्र_आवंटन(8 * 8, 2);
    अंतर्_लिख8(कोष, 0, 0);
    अंतर्_लिख8(कोष, 8, 4);
    अंतर्_लिख8(कोष, 16, प्रवि);
    अंतर्_लिख8(कोष, 24, अनुक्र);
    अंतर्_लिख8(कोष, 32, 8);
    सूत्र_जीसी_छोड़ो();
    परत् कोष;
}

कार्य शब्दकोश_पाओ(संख्या कोष, संख्या कुं) {
    यदि (कोष == 0) { परत् 0; }
    यदि (अंतर्_पढ़8(कोष, 0) == 0) { परत् 0; }
    संख्या स = कोष_स्लॉट(कोष, कुं);
    संख्या ई = अंतर्_पढ़8(अंतर्_पढ़8(कोष, 24), स * 8);
    यदि (ई == 0) { परत् 0; }
    परत् अंतर्_पढ़8(अंतर्_पढ़8(कोष, 16), (ई - 1) * 16 + 8);
}

कार्य शब्दकोश_कुंजी_है(संख्या कोष, संख्या कुं) {
    यदि (कोष == 0) { परत् 0; }
    यदि (अंतर्_पढ़8(कोष, 0) == 0) { परत् 0; }
    संख्या स = कोष_स्लॉट(कोष, कुं);
    यदि (अंतर्_पढ़8(अंतर्_पढ़8(कोष, 24), स * 8) == 0) { परत् 0; }
    परत् 1;
}

कार्य शब्दकोश_सेट(संख्या कोष, संख्या कुं, संख्या मू) {
    यदि (कोष == 0) {
        प्रक्षेपः "त्रुटिः — शून्य शब्दकोश पर सेट प्रयास";
    }
    संख्या गण = अंतर्_पढ़8(कोष, 0);
    यदि (गण > 0) {
        संख्या स0 = कोष_स्लॉट(कोष, कुं);
        संख्या ई0 = अंतर्_पढ़8(अंतर्_पढ़8(कोष, 24), स0 * 8);
        यदि (ई0 != 0) {
            अंतर्_लिख8(अंतर्_पढ़8(कोष, 16), (ई0 - 1) * 16 + 8, मू);   // मौजूदा कुंजी अद्यतन
            परत् 0;
        }
    }
    // नई कुंजी — packed में append, फिर सूचकांक
    सूत्र_जीसी_दबाओ();
    संख्या क्षम = अंतर्_पढ़8(कोष, 8);
    यदि (गण >= क्षम) {
        संख्या नक्षम = क्षम * 2;
        संख्या नप = सूत्र_पुनः_आवंटन(अंतर्_पढ़8(कोष, 16), नक्षम * 16);
        अंतर्_लिख8(कोष, 8, नक्षम);
        अंतर्_लिख8(कोष, 16, नप);
    }
    संख्या प्रवि = अंतर्_पढ़8(कोष, 16);
    अंतर्_लिख8(प्रवि, गण * 16, कुं);
    अंतर्_लिख8(प्रवि, गण * 16 + 8, मू);
    अंतर्_लिख8(कोष, 0, गण + 1);
    संख्या हक्षम = अंतर्_पढ़8(कोष, 32);
    यदि ((गण + 1) * 4 >= हक्षम * 3) {
        संख्या नअनुक्र = सूत्र_आवंटन(हक्षम * 2 * 8, 2);   // ताज़ा → शून्य
        अंतर्_लिख8(कोष, 24, नअनुक्र);
        अंतर्_लिख8(कोष, 32, हक्षम * 2);
        कोष_सूचकांक_भरो(कोष);
    } अन्यथा {
        अंतर्_लिख8(अंतर्_पढ़8(कोष, 24), कोष_स्लॉट(कोष, कुं) * 8, गण + 1);
    }
    सूत्र_जीसी_छोड़ो();
    परत् 0;
}

कार्य शब्दकोश_हटाओ(संख्या कोष, संख्या कुं) {
    यदि (कोष == 0) { परत् कोष; }
    संख्या गण = अंतर्_पढ़8(कोष, 0);
    यदि (गण == 0) { परत् कोष; }
    संख्या अनुक्र = अंतर्_पढ़8(कोष, 24);
    संख्या प्रवि = अंतर्_पढ़8(कोष, 16);
    संख्या स = कोष_स्लॉट(कोष, कुं);
    संख्या ई = अंतर्_पढ़8(अनुक्र, स * 8);
    यदि (ई == 0) { परत् कोष; }
    संख्या ज = ई - 1;
    यावत् (ज < गण - 1) {   // packed को बाईं ओर shift
        अंतर्_लिख8(प्रवि, ज * 16, अंतर्_पढ़8(प्रवि, (ज + 1) * 16));
        अंतर्_लिख8(प्रवि, ज * 16 + 8, अंतर्_पढ़8(प्रवि, (ज + 1) * 16 + 8));
        ज = ज + 1;
    }
    अंतर्_लिख8(कोष, 0, गण - 1);
    संख्या हक्षम = अंतर्_पढ़8(कोष, 32);
    संख्या क2 = 0;
    यावत् (क2 < हक्षम) {   // सूचकांक clear + नए सिरे से (सरल, सही)
        अंतर्_लिख8(अनुक्र, क2 * 8, 0);
        क2 = क2 + 1;
    }
    कोष_सूचकांक_भरो(कोष);
    परत् कोष;
}


// ============================================================
// सूची (dynamic array) — [क्षमता:8][गणना:8][तत्व:8×क्षमता], प्रकार 2
// पूर्व: sutra_list_* / sutra_arr_create (C)। अब सूत्र।
// grow/shrink: सूत्र_पुनः_आवंटन (arena) — GC दबाकर, वरना बीच में
// अभी-un-rooted नया block sweep हो सकता।
// ============================================================

कार्य सूची_रचना(संख्या गिन) {
    संख्या ब = सूत्र_आवंटन(16 + गिन * 8, 2);   // आवंटक शून्य कर देता
    अंतर्_लिख8(ब, 0, गिन);   // क्षमता
    अंतर्_लिख8(ब, 8, गिन);   // गणना
    परत् ब;
}

कार्य सूची_जोड़(संख्या सर, संख्या मूल्य) {
    यदि (सर == 0) {
        प्रक्षेपः "त्रुटिः — शून्य सर पर जोड़ना असंभव";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, 0);
    संख्या गणना = अंतर्_पढ़8(सर, 8);
    यदि (गणना < क्षमता) {
        अंतर्_लिख8(सर, 16 + गणना * 8, मूल्य);
        अंतर्_लिख8(सर, 8, गणना + 1);
        परत् सर;
    }
    सूत्र_जीसी_दबाओ();
    संख्या नई_क्षमता = 4;
    यदि (क्षमता != 0) { नई_क्षमता = क्षमता * 2; }
    संख्या नया = सूत्र_पुनः_आवंटन(सर, 16 + नई_क्षमता * 8);
    अंतर्_लिख8(नया, 0, नई_क्षमता);
    अंतर्_लिख8(नया, 8, गणना + 1);
    अंतर्_लिख8(नया, 16 + गणना * 8, मूल्य);
    सूत्र_जीसी_छोड़ो();
    परत् नया;
}

कार्य सूची_निकाल(संख्या सर) {
    यदि (सर == 0) {
        प्रक्षेपः "त्रुटिः — शून्य सर से तत्व नहीं निकाला जा सकता।";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, 0);
    संख्या गणना = अंतर्_पढ़8(सर, 8);
    यदि (गणना <= 0) {
        प्रक्षेपः "त्रुटिः — शून्य सर से तत्व नहीं निकाला जा सकता।";
    }
    अंतर्_लिख8(सर, 16 + (गणना - 1) * 8, 0);
    गणना = गणना - 1;
    अंतर्_लिख8(सर, 8, गणना);
    यदि (गणना <= क्षमता / 4) {
        यदि (क्षमता > 4) {
            सूत्र_जीसी_दबाओ();
            संख्या नई_क्षमता = क्षमता / 2;
            यदि (नई_क्षमता < 4) { नई_क्षमता = 4; }
            संख्या नया = सूत्र_पुनः_आवंटन(सर, 16 + नई_क्षमता * 8);
            अंतर्_लिख8(नया, 0, नई_क्षमता);
            सूत्र_जीसी_छोड़ो();
            परत् नया;
        }
    }
    परत् सर;
}

कार्य सूची_डाल(संख्या सर, संख्या सूचकांक, संख्या मूल्य) {
    यदि (सर == 0) {
        प्रक्षेपः "त्रुटिः — शून्य सर पर डालना असंभव";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, 0);
    संख्या गणना = अंतर्_पढ़8(सर, 8);
    यदि (सूचकांक < 0 || सूचकांक > गणना) {
        प्रक्षेपः "त्रुटिः — डालें: सूचकांक सीमा से बाहर";
    }
    संख्या लक्ष्य = सर;
    यदि (गणना >= क्षमता) {
        सूत्र_जीसी_दबाओ();
        संख्या नई_क्षमता = 4;
        यदि (क्षमता != 0) { नई_क्षमता = क्षमता * 2; }
        लक्ष्य = सूत्र_पुनः_आवंटन(सर, 16 + नई_क्षमता * 8);
        अंतर्_लिख8(लक्ष्य, 0, नई_क्षमता);
        सूत्र_जीसी_छोड़ो();
    }
    संख्या इ = गणना;
    यावत् (इ > सूचकांक) {
        अंतर्_लिख8(लक्ष्य, 16 + इ * 8, अंतर्_पढ़8(लक्ष्य, 16 + (इ - 1) * 8));
        इ = इ - 1;
    }
    अंतर्_लिख8(लक्ष्य, 16 + सूचकांक * 8, मूल्य);
    अंतर्_लिख8(लक्ष्य, 8, गणना + 1);
    परत् लक्ष्य;
}

कार्य सूची_हटा(संख्या सर, संख्या सूचकांक) {
    यदि (सर == 0) {
        प्रक्षेपः "त्रुटिः — शून्य सर से तत्व हटाना असंभव";
    }
    संख्या क्षमता = अंतर्_पढ़8(सर, 0);
    संख्या गणना = अंतर्_पढ़8(सर, 8);
    यदि (सूचकांक < 0 || सूचकांक >= गणना) {
        प्रक्षेपः "त्रुटिः — हटाएं: सूचकांक सीमा से बाहर";
    }
    संख्या इ = सूचकांक;
    यावत् (इ < गणना - 1) {
        अंतर्_लिख8(सर, 16 + इ * 8, अंतर्_पढ़8(सर, 16 + (इ + 1) * 8));
        इ = इ + 1;
    }
    अंतर्_लिख8(सर, 16 + (गणना - 1) * 8, 0);
    गणना = गणना - 1;
    अंतर्_लिख8(सर, 8, गणना);
    यदि (गणना <= क्षमता / 4) {
        यदि (क्षमता > 4) {
            सूत्र_जीसी_दबाओ();
            संख्या नई_क्षमता = क्षमता / 2;
            यदि (नई_क्षमता < 4) { नई_क्षमता = 4; }
            संख्या नया = सूत्र_पुनः_आवंटन(सर, 16 + नई_क्षमता * 8);
            अंतर्_लिख8(नया, 0, नई_क्षमता);
            सूत्र_जीसी_छोड़ो();
            परत् नया;
        }
    }
    परत् सर;
}

कार्य सूची_जोड़ो_दो(संख्या अ, संख्या ब) {
    संख्या ग_अ = 0;
    यदि (अ != 0) { ग_अ = अंतर्_पढ़8(अ, 8); }
    संख्या ग_ब = 0;
    यदि (ब != 0) { ग_ब = अंतर्_पढ़8(ब, 8); }
    सूत्र_जीसी_दबाओ();
    संख्या नया = सूची_रचना(ग_अ + ग_ब);
    संख्या इ = 0;
    यावत् (इ < ग_अ) {
        अंतर्_लिख8(नया, 16 + इ * 8, अंतर्_पढ़8(अ, 16 + इ * 8));
        इ = इ + 1;
    }
    इ = 0;
    यावत् (इ < ग_ब) {
        अंतर्_लिख8(नया, 16 + (ग_अ + इ) * 8, अंतर्_पढ़8(ब, 16 + इ * 8));
        इ = इ + 1;
    }
    सूत्र_जीसी_छोड़ो();
    परत् नया;
}

कार्य सूची_खोज(संख्या सर, संख्या मूल्य) {
    यदि (सर == 0) { परत् -1; }
    संख्या गणना = अंतर्_पढ़8(सर, 8);
    संख्या इ = 0;
    यावत् (इ < गणना) {
        यदि (अंतर्_पढ़8(सर, 16 + इ * 8) == मूल्य) { परत् इ; }
        इ = इ + 1;
    }
    परत् -1;
}


// ============================================================
// पाठ खोज / रूपांतरण — पूर्व: sutra_find/replace/split/join/trim/
//   starts_with/ends_with (C)। अब सूत्र। बाइट-स्तर मिलान (UTF-8 self-
//   synchronising तो सुरक्षित)। sutra_substr हॉट-पाथ, C में ही।
// ============================================================

// हे के बाइट-ऑफसेट ऑफ से स_ल बाइट्स == सूई?
कार्य पाठ_बाइट_मिलान(संख्या हे, संख्या ऑफ, संख्या सूई, संख्या स_ल) {
    संख्या इ = 0;
    यावत् (इ < स_ल) {
        यदि (अंतर्_पढ़1(हे, 16 + ऑफ + इ) != अंतर्_पढ़1(सूई, 16 + इ)) { परत् 0; }
        इ = इ + 1;
    }
    परत् 1;
}

// बाइट-स्थिति से पहले कितने कोडबिंदु
कार्य पाठ_कोडबिंदु_पूर्व(संख्या स, संख्या बाइट_स्थिति) {
    संख्या गणना = 0;
    संख्या इ = 0;
    यावत् (इ < बाइट_स्थिति) {
        इ = इ + अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(स, 16 + इ));
        गणना = गणना + 1;
    }
    परत् गणना;
}

// पहली उपस्थिति का कोडबिंदु-सूचकांक, वरना -1  (पूर्व: sutra_find string-भाग)
कार्य पाठ_कोडबिंदु_खोज(संख्या हे, संख्या सूई) {
    संख्या ह_ल = अंतर्_पढ़8(हे, 8);
    संख्या स_ल = अंतर्_पढ़8(सूई, 8);
    यदि (स_ल == 0) {
        प्रक्षेपः "त्रुटिः — खोजें: रिक्त खोज पाठ मान्य न अस्ति।";
    }
    संख्या प = 0;
    यावत् (प + स_ल <= ह_ल) {
        यदि (पाठ_बाइट_मिलान(हे, प, सूई, स_ल)) {
            परत् पाठ_कोडबिंदु_पूर्व(हे, प);
        }
        प = प + 1;
    }
    परत् -1;
}

// पहली उपस्थिति बदलो  (पूर्व: sutra_replace)
कार्य पाठ_बदल(संख्या हे, संख्या सूई, संख्या नया) {
    यदि (हे == 0 || सूई == 0 || नया == 0) {
        प्रक्षेपः "त्रुटिः — बदलें में शून्य पाठ मान्य नहीं है";
    }
    संख्या ह_ल = अंतर्_पढ़8(हे, 8);
    संख्या स_ल = अंतर्_पढ़8(सूई, 8);
    संख्या न_ल = अंतर्_पढ़8(नया, 8);
    यदि (स_ल == 0) {
        प्रक्षेपः "त्रुटिः — बदलें: रिक्त खोज पाठ मान्य न अस्ति।";
    }
    संख्या प = 0;
    यावत् (प + स_ल <= ह_ल) {
        यदि (पाठ_बाइट_मिलान(हे, प, सूई, स_ल)) {
            संख्या पुच्छ = ह_ल - प - स_ल;
            संख्या फल = पाठ_आवंटित(प + न_ल + पुच्छ);
            खंड_प्रतिलिपि(फल, 16, हे, 16, प);
            खंड_प्रतिलिपि(फल, 16 + प, नया, 16, न_ल);
            खंड_प्रतिलिपि(फल, 16 + प + न_ल, हे, 16 + प + स_ल, पुच्छ);
            परत् फल;
        }
        प = प + 1;
    }
    परत् हे;
}

// विभाजक पर टुकड़ों की सूची  (पूर्व: sutra_split)
कार्य पाठ_विभाजन(संख्या हे, संख्या वि) {
    यदि (हे == 0 || वि == 0) {
        प्रक्षेपः "त्रुटिः — विभाजित के तर्क शून्य नहीं हो सकते";
    }
    संख्या ह_ल = अंतर्_पढ़8(हे, 8);
    संख्या व_ल = अंतर्_पढ़8(वि, 8);
    यदि (व_ल == 0) {
        प्रक्षेपः "त्रुटिः — विभाजित: रिक्त विभाजक मान्य न अस्ति।";
    }
    संख्या गण = 1;
    संख्या प = 0;
    यावत् (प + व_ल <= ह_ल) {
        यदि (पाठ_बाइट_मिलान(हे, प, वि, व_ल)) {
            गण = गण + 1;
            प = प + व_ल;
        } अन्यथा {
            प = प + 1;
        }
    }
    सूत्र_जीसी_दबाओ();
    संख्या सर = सूची_रचना(गण);
    संख्या सूचकांक = 0;
    संख्या आरंभ = 0;
    यावत् (आरंभ <= ह_ल) {
        संख्या अगला = आरंभ;
        संख्या रुका = 0;
        यावत् (अगला + व_ल <= ह_ल) {
            यदि (पाठ_बाइट_मिलान(हे, अगला, वि, व_ल)) { रुका = 1; अगला = अगला; विरामः; }
            अगला = अगला + 1;
        }
        यदि (रुका == 0) { अगला = ह_ल; }
        संख्या भाग = पाठ_प्रति(हे, आरंभ, अगला - आरंभ);
        अंतर्_लिख8(सर, 16 + सूचकांक * 8, भाग);
        सूचकांक = सूचकांक + 1;
        यदि (रुका == 0) { विरामः; }
        आरंभ = अगला + व_ल;
    }
    सूत्र_जीसी_छोड़ो();
    परत् सर;
}

// सूची-तत्वों को विभाजक से जोड़ो  (पूर्व: sutra_join)
कार्य पाठ_संयोग(संख्या सर, संख्या विभा) {
    यदि (सर == 0) { परत् पाठ_आवंटित(0); }
    संख्या गण = अंतर्_पढ़8(सर, 8);
    संख्या वि_ल = 0;
    यदि (विभा != 0) { वि_ल = अंतर्_पढ़8(विभा, 8); }
    संख्या कुल = 0;
    संख्या इ = 0;
    यावत् (इ < गण) {
        संख्या त = अंतर्_पढ़8(सर, 16 + इ * 8);
        यदि (त < 65536) {
            प्रक्षेपः "त्रुटिः — संयोजित में सूची के सभी तत्व पाठ होने चाहिए।";
        }
        कुल = कुल + अंतर्_पढ़8(त, 8);
        यदि (इ + 1 < गण) { कुल = कुल + वि_ल; }
        इ = इ + 1;
    }
    संख्या फल = पाठ_आवंटित(कुल);
    संख्या स्थिति = 0;
    इ = 0;
    यावत् (इ < गण) {
        संख्या त = अंतर्_पढ़8(सर, 16 + इ * 8);
        संख्या त_ल = अंतर्_पढ़8(त, 8);
        खंड_प्रतिलिपि(फल, 16 + स्थिति, त, 16, त_ल);
        स्थिति = स्थिति + त_ल;
        यदि (इ + 1 < गण) {
            यदि (वि_ल > 0) {
                खंड_प्रतिलिपि(फल, 16 + स्थिति, विभा, 16, वि_ल);
                स्थिति = स्थिति + वि_ल;
            }
        }
        इ = इ + 1;
    }
    परत् फल;
}

// Unicode श्वेत-स्थान कोडबिंदु?
कार्य कोडबिंदु_श्वेत_है(संख्या कब) {
    यदि (कब == 32 || कब == 9 || कब == 10 || कब == 13) { परत् 1; }
    यदि (कब == 160 || कब == 5760) { परत् 1; }
    यदि (कब >= 8192 && कब <= 8202) { परत् 1; }
    यदि (कब == 8232 || कब == 8233 || कब == 8239) { परत् 1; }
    यदि (कब == 8287 || कब == 12288) { परत् 1; }
    परत् 0;
}

// दोनों सिरों से श्वेत-स्थान हटाओ  (पूर्व: sutra_trim)
कार्य पाठ_छाँट(संख्या पा) {
    यदि (पा == 0) { परत् पाठ_आवंटित(0); }
    संख्या लं = अंतर्_पढ़8(पा, 8);
    संख्या आरंभ_बाइट = 0;
    संख्या मिला = 0;
    संख्या इ = 0;
    यावत् (इ < लं) {
        संख्या चौ = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(पा, 16 + इ));
        यदि (इ + चौ > लं) { चौ = 1; }
        यदि (न कोडबिंदु_श्वेत_है(कोडबिंदु_मान(पा, इ, चौ))) {
            आरंभ_बाइट = इ;
            मिला = 1;
            विरामः;
        }
        इ = इ + चौ;
    }
    यदि (मिला == 0) { परत् पाठ_आवंटित(0); }
    संख्या अंत_बाइट = आरंभ_बाइट;
    इ = आरंभ_बाइट;
    यावत् (इ < लं) {
        संख्या चौ = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(पा, 16 + इ));
        यदि (इ + चौ > लं) { चौ = 1; }
        यदि (न कोडबिंदु_श्वेत_है(कोडबिंदु_मान(पा, इ, चौ))) {
            अंत_बाइट = इ + चौ;
        }
        इ = इ + चौ;
    }
    परत् पाठ_प्रति(पा, आरंभ_बाइट, अंत_बाइट - आरंभ_बाइट);
}

// उपसर्ग / प्रत्यय जाँच  (पूर्व: sutra_starts_with / sutra_ends_with)
कार्य पाठ_आरंभ_में(संख्या पा, संख्या उप) {
    यदि (पा == 0 || उप == 0) { परत् 1; }
    संख्या प_ल = अंतर्_पढ़8(पा, 8);
    संख्या उ_ल = अंतर्_पढ़8(उप, 8);
    यदि (उ_ल == 0) { परत् 1; }
    यदि (प_ल < उ_ल) { परत् 0; }
    परत् पाठ_बाइट_मिलान(पा, 0, उप, उ_ल);
}
कार्य पाठ_अंत_में(संख्या पा, संख्या उप) {
    यदि (पा == 0 || उप == 0) { परत् 1; }
    संख्या प_ल = अंतर्_पढ़8(पा, 8);
    संख्या उ_ल = अंतर्_पढ़8(उप, 8);
    यदि (उ_ल == 0) { परत् 1; }
    यदि (प_ल < उ_ल) { परत् 0; }
    परत् पाठ_बाइट_मिलान(पा, प_ल - उ_ल, उप, उ_ल);
}


