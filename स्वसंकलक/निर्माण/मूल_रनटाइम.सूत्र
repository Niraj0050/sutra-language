// ===== तेज़-पथ: statically-typed पाठ ops (कोई type-dispatch नहीं) =====
// LLVM backend तब बुलाता जब operand का प्रकार निश्चित रूप से "पाठ" हो।
कार्य पाठ_तुल्य_तेज़(संख्या अ, संख्या ब) {
    यदि (अ == ब) { परत् 1; }
    यदि (अ == 0 || ब == 0) { परत् 0; }
    संख्या ल_अ = अंतर्_पढ़8(अ, 8);
    यदि (ल_अ != अंतर्_पढ़8(ब, 8)) { परत् 0; }
    संख्या सूचक = 0;
    यावत् (सूचक < ल_अ) {
        यदि (अंतर्_पढ़1(अ, 16 + सूचक) != अंतर्_पढ़1(ब, 16 + सूचक)) { परत् 0; }
        सूचक = सूचक + 1;
    }
    परत् 1;
}
// कोडबिंदु-गणना बिना type-dispatch — loop-invariant call के रूप में
// clang इसे loop से hoist कर सके (सिर्फ़ null-guard रखा)
कार्य पाठ_लंबाई_तेज़(संख्या स) {
    यदि (स == 0) { परत् 0; }
    संख्या लं = अंतर्_पढ़8(स, 8);
    संख्या सूचक = 0;
    संख्या गणना = 0;
    यावत् (सूचक < लं) {
        संख्या क = अंतर्_पढ़1(स, 16 + सूचक);
        यदि (क < 128) { सूचक = सूचक + 1; }
        अन्यथा यदि (क >= 192 && क < 224) { सूचक = सूचक + 2; }
        अन्यथा यदि (क >= 224 && क < 240) { सूचक = सूचक + 3; }
        अन्यथा यदि (क >= 240 && क < 248) { सूचक = सूचक + 4; }
        अन्यथा { सूचक = सूचक + 1; }
        गणना = गणना + 1;
    }
    परत् गणना;
}

