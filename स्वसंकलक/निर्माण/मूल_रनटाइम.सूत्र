// हे के बाइट-ऑफसेट ऑफ से स_ल बाइट्स == सूई?
कार्य पाठ_बाइट_मिलान(संख्या हे, संख्या ऑफ, संख्या सूई, संख्या स_ल) {
    संख्या इ = ०;
    यावत् (इ < स_ल) {
        यदि (अंतर्_पढ़1(हे, १६ + ऑफ + इ) != अंतर्_पढ़1(सूई, १६ + इ)) { परत् ०; }
        इ = इ + १;
    }
    परत् १;
}

// बाइट-स्थिति से पहले कितने कोडबिंदु
कार्य पाठ_कोडबिंदु_पूर्व(संख्या स, संख्या बाइट_स्थिति) {
    संख्या गणना = ०;
    संख्या इ = ०;
    यावत् (इ < बाइट_स्थिति) {
        इ = इ + अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(स, १६ + इ));
        गणना = गणना + १;
    }
    परत् गणना;
}

// पहली उपस्थिति का कोडबिंदु-सूचकांक, वरना -१  (पूर्व: sutra_find string-भाग)
कार्य पाठ_कोडबिंदु_खोज(संख्या हे, संख्या सूई) {
    संख्या ह_ल = अंतर्_पढ़8(हे, ८);
    संख्या स_ल = अंतर्_पढ़8(सूई, ८);
    यदि (स_ल == ०) {
        प्रक्षेपः "त्रुटिः — खोजें: रिक्त खोज पाठ मान्य न अस्ति।";
    }
    संख्या प = ०;
    यावत् (प + स_ल <= ह_ल) {
        यदि (पाठ_बाइट_मिलान(हे, प, सूई, स_ल)) {
            परत् पाठ_कोडबिंदु_पूर्व(हे, प);
        }
        प = प + १;
    }
    परत् -१;
}

// पहली उपस्थिति बदलो  (पूर्व: sutra_replace)
कार्य पाठ_बदल(संख्या हे, संख्या सूई, संख्या नया) {
    यदि (हे == ० || सूई == ० || नया == ०) {
        प्रक्षेपः "त्रुटिः — बदलें में शून्य पाठ मान्य नहीं है";
    }
    संख्या ह_ल = अंतर्_पढ़8(हे, ८);
    संख्या स_ल = अंतर्_पढ़8(सूई, ८);
    संख्या न_ल = अंतर्_पढ़8(नया, ८);
    यदि (स_ल == ०) {
        प्रक्षेपः "त्रुटिः — बदलें: रिक्त खोज पाठ मान्य न अस्ति।";
    }
    संख्या प = ०;
    यावत् (प + स_ल <= ह_ल) {
        यदि (पाठ_बाइट_मिलान(हे, प, सूई, स_ल)) {
            संख्या पुच्छ = ह_ल - प - स_ल;
            संख्या फल = पाठ_आवंटित(प + न_ल + पुच्छ);
            खंड_प्रतिलिपि(फल, १६, हे, १६, प);
            खंड_प्रतिलिपि(फल, १६ + प, नया, १६, न_ल);
            खंड_प्रतिलिपि(फल, १६ + प + न_ल, हे, १६ + प + स_ल, पुच्छ);
            परत् फल;
        }
        प = प + १;
    }
    परत् हे;
}

// विभाजक पर टुकड़ों की सूची  (पूर्व: sutra_split)
कार्य पाठ_विभाजन(संख्या हे, संख्या वि) {
    यदि (हे == ० || वि == ०) {
        प्रक्षेपः "त्रुटिः — विभाजित के तर्क शून्य नहीं हो सकते";
    }
    संख्या ह_ल = अंतर्_पढ़8(हे, ८);
    संख्या व_ल = अंतर्_पढ़8(वि, ८);
    यदि (व_ल == ०) {
        प्रक्षेपः "त्रुटिः — विभाजित: रिक्त विभाजक मान्य न अस्ति।";
    }
    संख्या गण = १;
    संख्या प = ०;
    यावत् (प + व_ल <= ह_ल) {
        यदि (पाठ_बाइट_मिलान(हे, प, वि, व_ल)) {
            गण = गण + १;
            प = प + व_ल;
        } अन्यथा {
            प = प + १;
        }
    }
    सूत्र_जीसी_दबाओ();
    संख्या सर = सूची_रचना(गण);
    संख्या सर_तत्व = अंतर्_पढ़8(सर, १६);
    संख्या सूचकांक = ०;
    संख्या आरंभ = ०;
    यावत् (आरंभ <= ह_ल) {
        संख्या अगला = आरंभ;
        संख्या रुका = ०;
        यावत् (अगला + व_ल <= ह_ल) {
            यदि (पाठ_बाइट_मिलान(हे, अगला, वि, व_ल)) { रुका = १; अगला = अगला; विरामः; }
            अगला = अगला + १;
        }
        यदि (रुका == ०) { अगला = ह_ल; }
        संख्या भाग = पाठ_प्रति(हे, आरंभ, अगला - आरंभ);
        अंतर्_लिख8(सर_तत्व, सूचकांक * ८, भाग);
        सूचकांक = सूचकांक + १;
        यदि (रुका == ०) { विरामः; }
        आरंभ = अगला + व_ल;
    }
    सूत्र_जीसी_छोड़ो();
    परत् सर;
}

// सूची-तत्वों को विभाजक से जोड़ो  (पूर्व: sutra_join)
कार्य पाठ_संयोग(संख्या सर, संख्या विभा) {
    यदि (सर == ०) { परत् पाठ_आवंटित(०); }
    संख्या गण = अंतर्_पढ़8(सर, ८);
    संख्या तत्व = अंतर्_पढ़8(सर, १६);
    संख्या वि_ल = ०;
    यदि (विभा != ०) { वि_ल = अंतर्_पढ़8(विभा, ८); }
    संख्या कुल = ०;
    संख्या इ = ०;
    यावत् (इ < गण) {
        संख्या त = अंतर्_पढ़8(तत्व, इ * ८);
        यदि (त < ६५५३६) {
            प्रक्षेपः "त्रुटिः — संयोजित में सूची के सभी तत्व पाठ होने चाहिए।";
        }
        कुल = कुल + अंतर्_पढ़8(त, ८);
        यदि (इ + १ < गण) { कुल = कुल + वि_ल; }
        इ = इ + १;
    }
    संख्या फल = पाठ_आवंटित(कुल);
    संख्या स्थिति = ०;
    इ = ०;
    यावत् (इ < गण) {
        संख्या त = अंतर्_पढ़8(तत्व, इ * ८);
        संख्या त_ल = अंतर्_पढ़8(त, ८);
        खंड_प्रतिलिपि(फल, १६ + स्थिति, त, १६, त_ल);
        स्थिति = स्थिति + त_ल;
        यदि (इ + १ < गण) {
            यदि (वि_ल > ०) {
                खंड_प्रतिलिपि(फल, १६ + स्थिति, विभा, १६, वि_ल);
                स्थिति = स्थिति + वि_ल;
            }
        }
        इ = इ + १;
    }
    परत् फल;
}

// Unicode श्वेत-स्थान कोडबिंदु?
कार्य कोडबिंदु_श्वेत_है(संख्या कब) {
    यदि (कब == ३२ || कब == ९ || कब == १० || कब == १३) { परत् १; }
    यदि (कब == १६० || कब == ५७६०) { परत् १; }
    यदि (कब >= ८१९२ && कब <= ८२०२) { परत् १; }
    यदि (कब == ८२३२ || कब == ८२३३ || कब == ८२३९) { परत् १; }
    यदि (कब == ८२८७ || कब == १२२८८) { परत् १; }
    परत् ०;
}

// दोनों सिरों से श्वेत-स्थान हटाओ  (पूर्व: sutra_trim)
कार्य पाठ_छाँट(संख्या पा) {
    यदि (पा == ०) { परत् पाठ_आवंटित(०); }
    संख्या लं = अंतर्_पढ़8(पा, ८);
    संख्या आरंभ_बाइट = ०;
    संख्या मिला = ०;
    संख्या इ = ०;
    यावत् (इ < लं) {
        संख्या चौ = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(पा, १६ + इ));
        यदि (इ + चौ > लं) { चौ = १; }
        यदि (न कोडबिंदु_श्वेत_है(कोडबिंदु_मान(पा, इ, चौ))) {
            आरंभ_बाइट = इ;
            मिला = १;
            विरामः;
        }
        इ = इ + चौ;
    }
    यदि (मिला == ०) { परत् पाठ_आवंटित(०); }
    संख्या अंत_बाइट = आरंभ_बाइट;
    इ = आरंभ_बाइट;
    यावत् (इ < लं) {
        संख्या चौ = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(पा, १६ + इ));
        यदि (इ + चौ > लं) { चौ = १; }
        यदि (न कोडबिंदु_श्वेत_है(कोडबिंदु_मान(पा, इ, चौ))) {
            अंत_बाइट = इ + चौ;
        }
        इ = इ + चौ;
    }
    परत् पाठ_प्रति(पा, आरंभ_बाइट, अंत_बाइट - आरंभ_बाइट);
}

// उपसर्ग / प्रत्यय जाँच  (पूर्व: sutra_starts_with / sutra_ends_with)
कार्य पाठ_आरंभ_में(संख्या पा, संख्या उप) {
    यदि (पा == ० || उप == ०) { परत् १; }
    संख्या प_ल = अंतर्_पढ़8(पा, ८);
    संख्या उ_ल = अंतर्_पढ़8(उप, ८);
    यदि (उ_ल == ०) { परत् १; }
    यदि (प_ल < उ_ल) { परत् ०; }
    परत् पाठ_बाइट_मिलान(पा, ०, उप, उ_ल);
}
कार्य पाठ_अंत_में(संख्या पा, संख्या उप) {
    यदि (पा == ० || उप == ०) { परत् १; }
    संख्या प_ल = अंतर्_पढ़8(पा, ८);
    संख्या उ_ल = अंतर्_पढ़8(उप, ८);
    यदि (उ_ल == ०) { परत् १; }
    यदि (प_ल < उ_ल) { परत् ०; }
    परत् पाठ_बाइट_मिलान(पा, प_ल - उ_ल, उप, उ_ल);
}


