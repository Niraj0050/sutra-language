    यदि (पथ == ०) { परत् पाठ_आवंटित(०); }
    सञ्चिका_कोष_तैयार();
    यदि (सूत्र_तल_यूटीएफ_चौड़ा(पथ + १६, सञ्चिका_पथ_बफ, ४०९६) == ०) { परत् पाठ_आवंटित(०); }
    संख्या ह = सूत्र_तल_सञ्चिका_खोलो_प(सञ्चिका_पथ_बफ);
    यदि (ह == -१) { परत् पाठ_आवंटित(०); }
    संख्या कुल = सूत्र_तल_सञ्चिका_आकार(ह);
    यदि (कुल < ० || कुल > २१४७४८३६४७) {
        सूत्र_तल_हैंडल_बंद(ह);
