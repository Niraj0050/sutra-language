// मूल_रनटाइम.सूत्र — रनटाइम के पत्ते (leaf) कार्य, सूत्र में
// ============================================================
// ये कार्य पहले sutra_runtime.c में C थे। अब सूत्र में — केवल
// निम्न-स्तर अंतर्निर्देश (अंतर्_पढ़8 / अंतर्_पढ़1) और अंकगणित।
// कोई आवंटन नहीं। हर उत्पन्न binary में लिंक होते हैं।
//
// ढेर-वस्तु विन्यास (memory.md):
//   पाठ  : [क्षमता:8][लंबाई:8][utf8 बाइट्स][\0]
//   सूची : [क्षमता:8][लंबाई:8][तत्व:8]...
//   शब्दकोश: [गणना:8][क्षमता:8][प्रविष्टियाँ*:8]
// ============================================================

// एक UTF-8 अक्षर का कोडबिंदु (पाठ के पहले अक्षर का)।  पूर्व: sutra_char_ord
कार्य अक्षर_कोडबिंदु(मान स) {
    यदि (स == शून्यम्) { परत् -1; }
    संख्या लं = अंतर्_पढ़8(स, 8);
    यदि (लं <= 0) { परत् -1; }
    संख्या क1 = अंतर्_पढ़1(स, 16);
    यदि (क1 < 128) {
        परत् क1;
    }
    यदि (क1 >= 192 && क1 < 224 && लं >= 2) {
        संख्या क2 = अंतर्_पढ़1(स, 17);
        परत् ((क1 - 192) * 64) + (क2 % 64);
    }
    यदि (क1 >= 224 && क1 < 240 && लं >= 3) {
        संख्या क2 = अंतर्_पढ़1(स, 17);
        संख्या क3 = अंतर्_पढ़1(स, 18);
        परत् ((क1 - 224) * 4096) + ((क2 % 64) * 64) + (क3 % 64);
    }
    यदि (क1 >= 240 && क1 < 248 && लं >= 4) {
        संख्या क2 = अंतर्_पढ़1(स, 17);
        संख्या क3 = अंतर्_पढ़1(स, 18);
        संख्या क4 = अंतर्_पढ़1(स, 19);
        परत् ((क1 - 240) * 262144) + ((क2 % 64) * 4096) + ((क3 % 64) * 64) + (क4 % 64);
    }
    परत् 65533;
}

// पाठ में UTF-8 कोडबिंदुओं की संख्या।  पूर्व: sutra_str_length
कार्य पाठ_कोडबिंदु_गणना(मान स) {
    यदि (स == शून्यम्) { परत् 0; }
    संख्या लं = अंतर्_पढ़8(स, 8);
    संख्या सूचक = 0;
    संख्या गणना = 0;
    यावत् (सूचक < लं) {
        संख्या क = अंतर्_पढ़1(स, 16 + सूचक);
        यदि (क < 128) {
            सूचक = सूचक + 1;
        } अन्यथा यदि (क >= 192 && क < 224) {
            सूचक = सूचक + 2;
        } अन्यथा यदि (क >= 224 && क < 240) {
            सूचक = सूचक + 3;
        } अन्यथा यदि (क >= 240 && क < 248) {
            सूचक = सूचक + 4;
        } अन्यथा {
            सूचक = सूचक + 1;
        }
        गणना = गणना + 1;
    }
    परत् गणना;
}

// दो पाठ बाइट-दर-बाइट समान?  पूर्व: sutra_str_equal (1/0)
// छोटे पूर्णांक (< 65536) को अमान्य पता मानकर 0 लौटाता है — crash-सुरक्षित।
कार्य पाठ_तुल्य(मान अ, मान ब) {
    यदि (अ == ब) { परत् 1; }
    यदि (अ == शून्यम् || ब == शून्यम्) { परत् 0; }
    यदि (अ < 65536 || ब < 65536) { परत् 0; }
    यदि (न अंतर्_क्या_पाठ(अ) || न अंतर्_क्या_पाठ(ब)) { परत् 0; }
    संख्या ल_अ = अंतर्_पढ़8(अ, 8);
    संख्या ल_ब = अंतर्_पढ़8(ब, 8);
    यदि (ल_अ != ल_ब) { परत् 0; }
    संख्या सूचक = 0;
    यावत् (सूचक < ल_अ) {
        यदि (अंतर्_पढ़1(अ, 16 + सूचक) != अंतर्_पढ़1(ब, 16 + सूचक)) {
            परत् 0;
        }
        सूचक = सूचक + 1;
    }
    परत् 1;
}

// सूची/शब्दकोश की कच्ची लंबाई (गणना)।  पूर्व: sutra_arr_length
कार्य सञ्चय_गणना(मान व) {
    यदि (व == शून्यम्) { परत् 0; }
    यदि (अंतर्_क्या_शब्दकोश(व)) {
        परत् अंतर्_पढ़8(व, 0);   // शब्दकोश: [गणना] ऑफसेट 0 पर
    }
    परत् अंतर्_पढ़8(व, 8);       // सूची: [लंबाई] ऑफसेट 8 पर
}

// बहुरूपी लंबाई — पाठ → कोडबिंदु, अन्यथा → गणना।  पूर्व: sutra_dynamic_length
कार्य दैशिक_लंबाई(मान व) {
    यदि (व == शून्यम्) { परत् 0; }
    यदि (अंतर्_क्या_पाठ(व)) {
        परत् पाठ_कोडबिंदु_गणना(व);
    }
    परत् सञ्चय_गणना(व);
}

// ===== पाठ कोडबिंदु-वार तुलना (< > <= >=) — पूर्व: sutra_utf8_cmp_codepoints =====

// लीड-बाइट से UTF-8 अक्षर की बाइट-चौड़ाई
कार्य अक्षर_बाइट_चौड़ाई(संख्या लीड) {
    यदि (लीड < 128) { परत् 1; }
    यदि (लीड >= 192 && लीड < 224) { परत् 2; }
    यदि (लीड >= 224 && लीड < 240) { परत् 3; }
    यदि (लीड >= 240 && लीड < 248) { परत् 4; }
    परत् 1;
}

// पाठ के byte-ऑफसेट ऑफ पर कोडबिंदु का मान (चौ = बाइट-चौड़ाई)
कार्य कोडबिंदु_मान(मान स, संख्या ऑफ, संख्या चौ) {
    संख्या क1 = अंतर्_पढ़1(स, 16 + ऑफ);
    यदि (चौ == 1) { परत् क1; }
    यदि (चौ == 2) {
        परत् ((क1 - 192) * 64) + (अंतर्_पढ़1(स, 17 + ऑफ) % 64);
    }
    यदि (चौ == 3) {
        परत् ((क1 - 224) * 4096) + ((अंतर्_पढ़1(स, 17 + ऑफ) % 64) * 64) + (अंतर्_पढ़1(स, 18 + ऑफ) % 64);
    }
    परत् ((क1 - 240) * 262144) + ((अंतर्_पढ़1(स, 17 + ऑफ) % 64) * 4096) + ((अंतर्_पढ़1(स, 18 + ऑफ) % 64) * 64) + (अंतर्_पढ़1(स, 19 + ऑफ) % 64);
}

// -1 यदि अ < ब, 0 यदि तुल्य, 1 यदि अ > ब  (कोडबिंदु-वार)
कार्य पाठ_कोडबिंदु_तुलना(मान अ, मान ब) {
    यदि (अ == ब) { परत् 0; }
    यदि (अ == शून्यम्) { परत् -1; }
    यदि (ब == शून्यम्) { परत् 1; }
    संख्या ल_अ = अंतर्_पढ़8(अ, 8);
    संख्या ल_ब = अंतर्_पढ़8(ब, 8);
    संख्या इ = 0;
    संख्या ज = 0;
    यावत् (इ < ल_अ && ज < ल_ब) {
        संख्या चौ_अ = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(अ, 16 + इ));
        यदि (इ + चौ_अ > ल_अ) { चौ_अ = 1; }
        संख्या चौ_ब = अक्षर_बाइट_चौड़ाई(अंतर्_पढ़1(ब, 16 + ज));
        यदि (ज + चौ_ब > ल_ब) { चौ_ब = 1; }
        संख्या क_अ = कोडबिंदु_मान(अ, इ, चौ_अ);
        संख्या क_ब = कोडबिंदु_मान(ब, ज, चौ_ब);
        यदि (क_अ != क_ब) {
            यदि (क_अ < क_ब) { परत् -1; }
            परत् 1;
        }
        इ = इ + चौ_अ;
        ज = ज + चौ_ब;
    }
    यदि (इ >= ल_अ && ज >= ल_ब) { परत् 0; }
    यदि (इ >= ल_अ) { परत् -1; }
    परत् 1;
}

कार्य पाठ_न्यून(मान अ, मान ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) < 0) { परत् 1; }
    परत् 0;
}
कार्य पाठ_अधिक(मान अ, मान ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) > 0) { परत् 1; }
    परत् 0;
}
कार्य पाठ_न्यून_सम(मान अ, मान ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) <= 0) { परत् 1; }
    परत् 0;
}
कार्य पाठ_अधिक_सम(मान अ, मान ब) {
    यदि (पाठ_कोडबिंदु_तुलना(अ, ब) >= 0) { परत् 1; }
    परत् 0;
}
