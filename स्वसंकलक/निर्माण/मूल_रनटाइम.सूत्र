// bit-cast: "मान"-param passthrough (मशीन-स्तर केवल mov; type-tag बदलता)।
// बड़े स्थिरांक (२^५२) रनटाइम-गुणन से — int-साहित्य ≥ २³¹ सीमा से बचने को।
कार्य दशमलव_बिट(व) { परत् व; }
कार्य बिट_दशमलव(व) { परत् व; }

संख्या घा_बावन = ०;
कार्य दो_बावन() {
    यदि (घा_बावन == ०) {
        संख्या फ = १;
        संख्या इ = ०;
        यावत् (इ < ५२) { फ = फ * २; इ = इ + १; }
        घा_बावन = फ;
