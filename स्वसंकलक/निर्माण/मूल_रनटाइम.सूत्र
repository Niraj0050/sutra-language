// एक पाठ-वस्तु के बाइट + '\n' stdout पर लिखो (GC-सुरक्षित)।
कार्य पंक्ति_लिखो(संख्या स) {
    सूत्र_जीसी_दबाओ();
    संख्या नल = पाठ_जोड़(स, अक्षर_बना(१०));
    सूत्र_जीसी_छोड़ो();
    अंतर्_मुद्रण(नल, १६, अंतर्_पढ़8(नल, ८));
    परत् ०;
}

