// पाठ_संचायक.सूत्र — लूप string-accumulator → in-place builder [§perf]
// ============================================================
// पैटर्न:  पाठ स = "";  यावत् (…) { स = स + <पाठ>; … }
// mem2reg के बाद यह बनता:  P = phi[INIT, R];  R = योग(P, X)  [विधि पाठ]।
// हर चक्कर पाठ_जोड़ पूरे संचायक को copy करता → O(n²)।
//
// यह pass ऐसे R को `बुलाओ निर्माता_जोड़(P, X)` में बदल देता — जो जगह हो तो
// in-place append करता (amortized O(1))। सुरक्षित तभी जब संचायक कहीं
// escape/alias न करे: P और R के सारे उपयोग या तो (a) इसी चेन का अगला
// योग/phi हों, या (b) "उपभोक्ता पाठक" (लंबाई/छापो/सूचकांक/तुलना/पाठ-fn —
// जो सामग्री पढ़ते पर reference नहीं रखते)। गैर-सुरक्षित उपयोग (जोड़ें/
// लिख_अनुक्रम/परत्/user-कॉल/योग का RHS) → रूपांतरण छोड़ो।
//
// INIT केवल "" (खाली पाठ-साहित्य) — तब phi का INIT किनारा सीधे
// `निर्माता_नया()` से बदल जाता (साहित्य "" साझा/immutable है, उस पर
// in-place append नहीं कर सकते)।
//
// सुदृढ़ता: monotone guard — शक हो तो छोड़ो; कभी गलत रूपांतरण नहीं।
// ============================================================

आयात "मध्यम.सूत्र";

// id के सारे उपयोग गिनो — निर्देश-operand + phi-स्रोत, सब खंडों में
कार्य पस_उपयोग(शब्दकोश फलन, संख्या आईडी) {
    संख्या ग = 0;
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
            संख्या स = 0;
            यावत् (स < लंबाई(स्रोत)) {
                यदि (स्रोत[स][1] == आईडी) { ग = ग + 1; }
                स = स + 1;
            }
            फ = फ + 1;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            सूची ऑप = निस[नि]["संचालक"];
            संख्या क = 0;
            यावत् (क < लंबाई(ऑप)) {
                यदि (ऑप[क] == आईडी) { ग = ग + 1; }
                क = क + 1;
            }
            नि = नि + 1;
        }
        मान अंत = खस[ख]["अंत"];
        यदि (अंत != शून्यम्) {
            सूची ऑप2 = अंत["संचालक"];
            संख्या क2 = 0;
            यावत् (क2 < लंबाई(ऑप2)) {
                यदि (ऑप2[क2] == आईडी) { ग = ग + 1; }
                क2 = क2 + 1;
            }
        }
        ख = ख + 1;
    }
    परत् ग;
}

// क्या यह निर्देश `आईडी` को केवल पढ़ता (reference नहीं रखता, mutate नहीं
// करता, escape नहीं कराता)? — तब संचायक का यह उपयोग सुरक्षित।
कार्य पस_उपभोक्ता(शब्दकोश निर्देश, संख्या आईडी, संख्या चेन_योग) {
    पाठ को = निर्देश["कोड"];
    सूची ऑप = निर्देश["संचालक"];
    // चेन का अगला योग — सुरक्षित (हम उसे भी बदलेंगे/बदल चुके)
    यदि (निर्देश["आईडी"] == चेन_योग) { परत् सत्य; }
    यदि (को == "लंबाई") { परत् सत्य; }
    यदि (को == "पढ़_अनुक्रम") {
        // string index → ताज़ा 1-अक्षर पाठ; आईडी आधार (ऑप[0]) हो तभी सुरक्षित
        यदि (लंबाई(ऑप) >= 1 && ऑप[0] == आईडी) { परत् सत्य; }
        परत् असत्य;
    }
    यदि (को == "सम" || को == "असम" || को == "लघु" || को == "गुरु" || को == "लघुसम" || को == "गुरुसम") {
        परत् सत्य;   // तुलना → बूल, सामग्री-पठन मात्र
    }
    यदि (को == "बुलाओ") {
        पाठ ल = निर्देश["अंश"]["लक्ष्य"];
        यदि (ल == "गतिशील_छापो" || ल == "दैशिक_लंबाई" || ल == "पाठ_लंबाई_तेज़" ||
             ल == "पाठ_सूचकांक" || ल == "पाठ_खोज_गतिक" || ल == "पाठ_विभाजन" ||
             ल == "पाठ_बड़ा" || ल == "पाठ_छोटा" || ल == "पाठ_छाँट" ||
             ल == "पाठ_आरंभ_में" || ल == "पाठ_अंत_में" || ल == "पाठ_बदल" ||
             ल == "पाठ_तुल्य" || ल == "पाठ_तुल्य_तेज़" || ल == "गतिशील_प्रकार" ||
             ल == "पाठ_कोडबिंदु_गणना" || ल == "पाठ_उपखंड" || ल == "पाठ_उपखंड_बाइट" ||
             ल == "निर्माता_जोड़" || ल == "निर्माता_लंबाई" || ल == "निर्माता_पाठ") {
            परत् सत्य;
        }
        परत् असत्य;   // user-कॉल / अज्ञात → escape
    }
    यदि (को == "योग" || को == "अंतर" || को == "गुणा") {
        // चेन-योग ऊपर संभाला; कोई और योग जिसमें आईडी है → छोड़ो
        परत् असत्य;
    }
    परत् असत्य;   // लिख_अनुक्रम / जोड़ें-operand / अन्य → escape
}

// एक फलन में सुरक्षित संचायक-चेन ढूँढो और बदलो
कार्य पस_फलन(शब्दकोश एकक, शब्दकोश फलन) {
    सूची खस = फलन["खंड_सूची"];
    सूची पाठ_स्थि = एकक["पाठ_स्थिरांक"];

    // हर योग(विधि पाठ) निर्देश जिसका ऑप[0] एक phi है
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश यो = निस[नि];
            यदि (यो["कोड"] != "योग") { नि = नि + 1; जारीरह; }
            यदि (यो["अंश"] == शून्यम् || यो["अंश"]["विधि"] != "पाठ") { नि = नि + 1; जारीरह; }
            यदि (लंबाई(यो["संचालक"]) < 2) { नि = नि + 1; जारीरह; }
            संख्या पिड = यो["संचालक"][0];
            संख्या एक्स = यो["संचालक"][1];
            संख्या रिड = यो["आईडी"];
            यदि (पिड < 1 || रिड < 1) { नि = नि + 1; जारीरह; }

            // पिड एक phi हो, 2 स्रोत, एक स्रोत = रिड (back-edge)
            शब्दकोश पफाई = पस_फाई_खोजो(फलन, पिड);
            यदि (पफाई == शून्यम्) { नि = नि + 1; जारीरह; }
            सूची स्रोत = पफाई["अंश"]["स्रोत"];
            यदि (लंबाई(स्रोत) != 2) { नि = नि + 1; जारीरह; }
            संख्या इनिट = 0 - 1;
            मान बैक_ठीक = असत्य;
            संख्या स = 0;
            यावत् (स < लंबाई(स्रोत)) {
                यदि (स्रोत[स][1] == रिड) { बैक_ठीक = सत्य; }
                अन्यथा { इनिट = स्रोत[स][1]; }
                स = स + 1;
            }
            यदि (न बैक_ठीक || इनिट < 1) { नि = नि + 1; जारीरह; }

            // INIT केवल खाली "" पाठ-साहित्य
            शब्दकोश इनि_नि = पस_निर्देश_खोजो(फलन, इनिट);
            यदि (इनि_नि == शून्यम् || इनि_नि["कोड"] != "स्थिर") { नि = नि + 1; जारीरह; }
            यदि (इनि_नि["अंश"] == शून्यम् || इनि_नि["अंश"]["मान_प्रकार"] != "पाठ") { नि = नि + 1; जारीरह; }
            संख्या साइडक्स = इनि_नि["अंश"]["मान"];
            यदि (साइडक्स < 0 || साइडक्स >= लंबाई(पाठ_स्थि)) { नि = नि + 1; जारीरह; }
            यदि (पाठ_स्थि[साइडक्स] != "") { नि = नि + 1; जारीरह; }
            // वह `स्थिर ""` निर्देश केवल इसी phi-किनारे में उपयोग हो (साझा तो
            // उसे जगह-पर निर्माता_नया बनाना दूसरे उपयोगों को तोड़ेगा)
            यदि (पस_उपयोग(फलन, इनिट) != 1) { नि = नि + 1; जारीरह; }

            // पिड और रिड के सारे उपयोग सुरक्षित हों
            यदि (न पस_चेन_सुरक्षित(फलन, पिड, रिड)) { नि = नि + 1; जारीरह; }

            // ── रूपांतरण (कोई नया निर्देश/id नहीं — serialization-सुरक्षित) ──
            // R: योग → बुलाओ निर्माता_जोड़(P, X)
            यो["कोड"] = "बुलाओ";
            यो["प्रकार"] = "पाठ";
            शब्दकोश नअंश = {};
            नअंश["लक्ष्य"] = "निर्माता_जोड़";
            यो["अंश"] = नअंश;
            यो["संचालक"] = [पिड, एक्स];

            // INIT का `स्थिर ""` → जगह-पर `बुलाओ निर्माता_नया` (वही id, phi
            // किनारा अछूता; साहित्य "" साझा/immutable तो उस पर in-place
            // append नहीं कर सकते — ताज़ा builder चाहिए)
            इनि_नि["कोड"] = "बुलाओ";
            इनि_नि["प्रकार"] = "पाठ";
            इनि_नि["संचालक"] = [];
            शब्दकोश इअंश = {};
            इअंश["लक्ष्य"] = "निर्माता_नया";
            इनि_नि["अंश"] = इअंश;

            नि = नि + 1;
        }
        ख = ख + 1;
    }
    परत् 0;
}

कार्य पस_चेन_सुरक्षित(शब्दकोश फलन, संख्या पिड, संख्या रिड) {
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        // phi-स्रोत: पिड/रिड केवल एक-दूसरे की चेन में
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
            संख्या स = 0;
            यावत् (स < लंबाई(स्रोत)) {
                संख्या सिड = स्रोत[स][1];
                यदि (सिड == पिड || सिड == रिड) {
                    // यह phi वही संचायक-phi हो (आईडी == पिड) — तभी ठीक
                    यदि (फस[फ]["आईडी"] != पिड) { परत् असत्य; }
                }
                स = स + 1;
            }
            फ = फ + 1;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            सूची ऑप = इ["संचालक"];
            संख्या क = 0;
            यावत् (क < लंबाई(ऑप)) {
                यदि (ऑप[क] == पिड || ऑप[क] == रिड) {
                    यदि (न पस_उपभोक्ता(इ, ऑप[क], रिड)) { परत् असत्य; }
                }
                क = क + 1;
            }
            नि = नि + 1;
        }
        मान अंत = खस[ख]["अंत"];
        यदि (अंत != शून्यम्) {
            सूची ऑप2 = अंत["संचालक"];
            संख्या क2 = 0;
            यावत् (क2 < लंबाई(ऑप2)) {
                यदि (ऑप2[क2] == पिड || ऑप2[क2] == रिड) { परत् असत्य; }   // परत्/शाखा-arg → escape
                क2 = क2 + 1;
            }
        }
        ख = ख + 1;
    }
    परत् सत्य;
}

कार्य पस_फाई_खोजो(शब्दकोश फलन, संख्या आईडी) {
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            यदि (फस[फ]["आईडी"] == आईडी) { परत् फस[फ]; }
            फ = फ + 1;
        }
        ख = ख + 1;
    }
    परत् शून्यम्;
}

कार्य पस_निर्देश_खोजो(शब्दकोश फलन, संख्या आईडी) {
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            यदि (निस[नि]["आईडी"] == आईडी) { परत् निस[नि]; }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    परत् शून्यम्;
}

कार्य पाठ_संचायक_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या इ = 0;
    यावत् (इ < लंबाई(कस)) {
        पस_फलन(एकक, कस[इ]);
        इ = इ + 1;
    }
    परत् एकक;
}
