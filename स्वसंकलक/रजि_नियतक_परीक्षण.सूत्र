// रजि_नियतक_परीक्षण.सूत्र — Phase 1d linear-scan regalloc test

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "रजि_नियतक.सूत्र";

मान विफल = ०;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + १; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= ०; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}
कार्य तैयार(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    रजि_नियतक_एकक(एकक);
    परत् एकक;
}

// क्या हर IR-मान को नियतन मिला?
कार्य सब_नियत(शब्दकोश फलन) {
    शब्दकोश नि = फलन["रजि_नियतन"];
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        संख्या इक = ०;
        यावत् (इक < लंबाई(खस[ख]["फाई"])) {
            यदि (नि[खस[ख]["फाई"][इक]["आईडी"]] == शून्यम्) { परत् असत्य; }
            इक = इक + १;
        }
        इक = ०;
        यावत् (इक < लंबाई(खस[ख]["निर्देश"])) {
            संख्या आ = खस[ख]["निर्देश"][इक]["आईडी"];
            यदि (आ >= १) {
                यदि (नि[आ] == शून्यम्) { परत् असत्य; }
            }
            इक = इक + १;
        }
        ख = ख + १;
    }
    परत् सत्य;
}

कार्य मुख्य() {
    // १. loop — कम मान, कोई spill नहीं
    शब्दकोश ए1 = तैयार("कार्य योग_तक(संख्या सीमा) { संख्या इ = 0; संख्या ज = 0; यावत् (इ < सीमा) { ज = ज + इ; इ = इ + 1; } परत् ज; }");
    शब्दकोश फ1 = ए1["कार्य_सूची"][०];
    लिखतु(रजि_छापो(फ1));
    जाँच("1 सब मान नियत", सब_नियत(फ1));
    जाँच("1 कोई spill नहीं", फ1["ढेर_आकार"] == ०);
    जाँच("1 param rbx में", है(रजि_छापो(फ1), "v1 -> %rbx"));
    जाँच("1 सुरक्षित रजि इस्तेमाल", लंबाई(फ1["प्रयुक्त_सुरक्षित"]) > ०);

    // २. कई एक-साथ-सजीव मान → spill
    शब्दकोश ए2 = तैयार("कार्य बहु(संख्या अ) { संख्या क = अ + 1; संख्या ख = अ + 2; संख्या ग = अ + 3; संख्या घ = अ + 4; संख्या ङ = अ + 5; संख्या च = अ + 6; संख्या छ = अ + 7; संख्या ज = अ + 8; संख्या झ = अ + 9; परत् क + ख + ग + घ + ङ + च + छ + ज + झ; }");
    शब्दकोश फ2 = ए2["कार्य_सूची"][०];
    लिखतु(रजि_छापो(फ2));
    जाँच("2 सब मान नियत", सब_नियत(फ2));
    जाँच("2 spill हुआ (>7 सजीव)", फ2["ढेर_आकार"] > ०);

    // ३. सीधा कार्य
    शब्दकोश ए3 = तैयार("कार्य द(संख्या अ, संख्या ब) { परत् अ * ब + 1; }");
    शब्दकोश फ3 = ए3["कार्य_सूची"][०];
    जाँच("3 सब मान नियत", सब_नियत(फ3));
    जाँच("3 कोई spill नहीं", फ3["ढेर_आकार"] == ०);

    लिखतु("");
    यदि (विफल == ०) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
