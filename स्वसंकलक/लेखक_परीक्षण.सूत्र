आयात "लेखक.सूत्र";

कार्य मुख्य() {
    मान मार्गः = "";
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) >= २) {
        मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - १];
    } अन्यथा {
        लिखतु("त्रुटिः — सञ्चिका मार्गः न निर्दिष्टः।");
        लिखतु("प्रयोगः: लेखक_परीक्षण.सूत्र <सञ्चिका_मार्गः>");
        परत्;
    }

    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        लिखतु("त्रुटिः — सञ्चिका न प्राप्ता: " + मार्गः);
        परत्;
    }

    मान स्रोत_पाठ = सञ्चिका_पठतु(मार्गः);
    लिखतु("सञ्चिका: " + मार्गः + " (लंबाई = " + लंबाई(स्रोत_पाठ) + " अक्षराणि)");
    
    प्रयत्न {
        सूची पद_सूची = पद_विच्छेदन(स्रोत_पाठ);
        लिखतु("पद-संख्या: " + लंबाई(पद_सूची));
        लिखतु("=== पद-सूची ===");
        मान सूचक = ०;
        यावत् (सूचक < लंबाई(पद_सूची)) {
            शब्दकोश पदम् = पद_सूची[सूचक];
            पाठ प्र = पदम्["प्रकारः"];
            पाठ व = पदम्["वर्णांशः"];
            लिखतु("पदम्: प्रकारः=" + प्र + ", वर्णांशः=\"" + व + "\", पङ्क्तिः=" + पदम्["पङ्क्तिः"] + ", स्तम्भः=" + पदम्["स्तम्भः"]);
            सूचक = सूचक + १;
        }
    } पकड़ो (त्रुटि) {
        लिखतु("त्रुटि गृहीता!");
        लिखतु(त्रुटि);
    }
}
