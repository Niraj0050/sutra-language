                ल_सूचक = ल_सूचक + 1;
            }

            परिणाम = परिणाम + कथन_सर्जक(कार्य_नोड["देह"]);

            मान देह_कथन्स = कार्य_नोड["देह"]["कठन_सूची"];
            यदि (लंबाई(देह_कथन्स) > 0) {
                शब्दकोश अंतिम_कथन = देह_कथन्स[लंबाई(देह_कथन्स) - 1];
                यदि (अंतिम_कथन["नोड_प्रकारः"] != "कठन_परत्") {
                    परिणाम = परिणाम + मूल_पॉप_कोड_प्राप्त();
                    परिणाम = परिणाम + अक्षर_सूची_से_पाठ([32, 32, 32, 32, 114, 101, 116, 117, 114, 110, 32, 40, 118, 111, 105, 100, 42, 41, 48, 59, 10]);
                }
            } अन्यथा {
                परिणाम = परिणाम + मूल_पॉप_कोड_प्राप्त();
                परिणाम = परिणाम + अक्षर_सूची_से_पाठ([32, 32, 32, 32, 114, 101, 116, 117, 114, 110, 32, 40, 118, 111, 105, 100, 42, 41, 48, 59, 10]);
            }

            परिणाम = परिणाम + अक्षर_सूची_से_पाठ([125, 10, 10]);
        }
        सूचक = सूचक + 1;
    }

    परिणाम = परिणाम + अंग्रेज़ी_मुख्य_प्रविष्टि();
    
    चालू_पैरामीटर्स = [];
    चालू_स्थानीय_चर = [];
    
    वैश्विक_कथन = प्रोग्राम_नोड["वैश्विक_कथन"];
    वै_सूचक = 0;
    यावत् (वै_सूचक < लंबाई(वैश्विक_कथन)) {
        चालू_स्थानीय_चर =  चर_संग्रह_आंतरिक(वैश्विक_कथन[वै_सूचक], चालू_स्थानीय_चर);
        वै_सूचक = वै_सूचक + 1;
    }

    संख्या ल_सूचक = 0;
    यावत् (ल_सूचक < लंबाई(चालू_स्थानीय_चर)) {
        परिणाम = परिणाम + अक्षर_सूची_से_पाठ([32, 32, 32, 32]) + चालू_स्थानीय_चर[ल_सूचक] + अक्षर_सूची_से_पाठ([32, 61, 32, 40, 118, 111, 105, 100, 42, 41, 48, 59, 10]);
        ल_सूचक = ल_सूचक + 1;
    }

    ल_सूचक = 0;
    यावत् (ल_सूचक < लंबाई(चालू_स्थानीय_चर)) {
        परिणाम = परिणाम + अक्षर_सूची_से_पाठ([32, 32, 32, 32, 115, 117, 116, 114, 97, 95, 103, 99, 95, 112, 117, 115, 104, 95, 114, 111, 111, 116, 40, 40, 118, 111, 105, 100, 42, 42, 41, 38]) + चालू_स्थानीय_चर[ल_सूचक] + अक्षर_सूची_से_पाठ([41, 59, 10]);
        ल_सूचक = ल_सूचक + 1;
    }

    वै_सूचक = 0;
    यावत् (वै_सूचक < लंबाई(वैश्विक_कथन)) {
        परिणाम = परिणाम + "    " + कथन_सर्जक(वैश्विक_कथन[वै_सूचक]);
        वै_सूचक = वै_सूचक + 1;
    }

    सूचक = 0;
    मान मुख्य_है = असत्य;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        यदि (कार्य_सूची[सूचक]["नाम"] == "मुख्य") {
            मुख्य_है = सत्य;
        }
        सूचक = सूचक + 1;
    }

    यदि (मुख्य_है) {
        परिणाम = परिणाम + अंग्रेज़ी_मुख्य_कार्य_कॉल();
    }

    परिणाम = परिणाम + मूल_पॉप_कोड_प्राप्त();
    परिणाम = परिणाम + अंग्रेज़ी_मुख्य_वापसी();

    परत् परिणाम;
}

कार्य पाठ_सत्यापन_कार्य() {
    परत् अंग्रेज़ी_प्रारंभ() + अंग्रेज़ी_घोषणाएँ() + अंग्रेज़ी_संत();
}

कार्य डायनेमिक_जोड़_सहायक_पाठ() {
    परत् अंग्रेज़ी_जोड़_सहायक();
}

कार्य दशमलव_सहायक_पाठ() {
    परत् अंग्रेज़ी_दशमलव_सहायक();
}
