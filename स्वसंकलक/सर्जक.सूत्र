कार्य खोजें_सूची_सर्जक(सूची ल, पाठ लक्ष्य) {
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(ल)) {
        यदि (ल[सूचक] == लक्ष्य) {
            परत् सूचक;
        }
