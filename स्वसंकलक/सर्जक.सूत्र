        } अन्यथा यदि (प्रतीक == "\"") {
            परिणाम = परिणाम + "\\\"";
        } अन्यथा यदि (प्रतीक == "\\") {
            परिणाम = परिणाम + "\\\\";
        } अन्यथा {
            परिणाम = परिणाम + प्रतीक;
        }
        सूचक = सूचक + १;
    }
    परत् परिणाम;
}

