                    परिणाम = परिणाम + अक्षर_सूची_से_पाठ([३२, ३२, ३२, ३२, ११४, १०१, ११६, ११७, ११४, ११०, ३२, ४०, ११८, १११, १०५, १००, ४२, ४१, ४८, ५९, १०]);
