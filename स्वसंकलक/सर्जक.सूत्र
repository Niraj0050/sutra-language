कार्य एस्केप_पाठ(पाठ मूल) {
    मान परिणाम = "";
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(मूल)) {
        पाठ प्रतीक = मूल[सूचक];
        यदि (प्रतीक == "\न") {
            परिणाम = परिणाम + अक्षर_सूची_से_पाठ([९२, ११०]);
        } अन्यथा यदि (प्रतीक == "\त") {
