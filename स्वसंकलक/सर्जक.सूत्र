    यदि (नोड == शून्यम्) {
        परत् असत्य;
    }
    पाठ प्रकार = नोड["नोड_प्रकारः"];
    यदि (प्रकार == "अभिव्यक्ति_स्थिरांक") {
        परत् नोड["स्थिरांक_प्रकारः"] == "दशमलव";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_पहचान") {
        मान नाम = नोड["नाम"];
        परत् चालू_चर_प्रकार[नाम] == "दशमलव";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_द्विआधारी") {
        पाठ सञ्चालक = नोड["सञ्चालक"];
        यदि (सञ्चालक == "समानता (==)" || सञ्चालक == "असमानता (!=)" ||
            सञ्चालक == "लघुतर (<)" || सञ्चालक == "गुरुतर (>)" ||
            सञ्चालक == "लघुतर-समान (<=)" || सञ्चालक == "गुरुतर-समान (>=)" ||
            सञ्चालक == "तथा-संयोजक (&&)" || सञ्चालक == "अथवा-संयोजक (||)" ||
            सञ्चालक == "मुख्यशब्द_तथा" || सञ्चालक == "मुख्यशब्द_अथवा") {
            परत् असत्य;
        }
        यदि (सञ्चालक == "धन (+)") {
            मान वाम_नोड = नोड["वाम"];
            मान दक्षिण_नोड = नोड["दक्षिण"];
            मान वाम_पाठ_है = (वाम_नोड["नोड_प्रकारः"] == "अभिव्यक्ति_स्थिरांक" && वाम_नोड["स्थिरांक_प्रकारः"] == "पाठ") || (वाम_नोड["नोड_प्रकारः"] == "अभिव्यक्ति_पहचान" && चालू_चर_प्रकार[वाम_नोड["नाम"]] == "पाठ");
            मान दक्षिण_पाठ_है = (दक्षिण_नोड["नोड_प्रकारः"] == "अभिव्यक्ति_स्थिरांक" && दक्षिण_नोड["स्थिरांक_प्रकारः"] == "पाठ") || (दक्षिण_नोड["नोड_प्रकारः"] == "अभिव्यक्ति_पहचान" && चालू_चर_प्रकार[दक्षिण_नोड["नाम"]] == "पाठ");
            यदि (वाम_पाठ_है || दक्षिण_पाठ_है) {
                परत् असत्य;
            }
        }
        परत् क्या_दशमलव_अभिव्यक्ति_है(नोड["वाम"]) || क्या_दशमलव_अभिव्यक्ति_है(नोड["दक्षिण"]);
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_एकल") {
        परत् क्या_दशमलव_अभिव्यक्ति_है(नोड["संख्या"]);
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_कॉल") {
        पाठ नाम = नोड["नाम"];
        परत् नाम == "वर्गमूल" || नाम == "घात" || नाम == "निरपेक्ष" || नाम == "न्यूनतम" || नाम == "अधिकतम";
    }
    परत् असत्य;
}

कार्य खोजें_सूची_सर्जक(सूची ल, पाठ लक्ष्य) {
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(ल)) {
        यदि (ल[सूचक] == लक्ष्य) {
            परत् सूचक;
        }
        सूचक = सूचक + 1;
    }
    परत् -1;
}

कार्य क्षेत्र_सूचकांक_प्राप्त_करो(शब्दकोश नोड, पाठ क्षेत्र_नाम) {
    यदि (क्षेत्र_नाम == "नाम") { परत् 0; }
    यदि (क्षेत्र_नाम == "आयु") { परत् 1; }
    यदि (क्षेत्र_नाम == "मान") { परत् 0; }
    यदि (क्षेत्र_नाम == "अगला") { परत् 1; }
    
    पाठ वर्ग_नाम = "";
    यदि (नोड["नोड_प्रकारः"] == "अभिव्यक्ति_स्व") {
        वर्ग_नाम = चालू_वर्ग_नाम;
    } अन्यथा यदि (नोड["नोड_प्रकारः"] == "अभिव्यक्ति_पहचान") {
        वर्ग_नाम = चालू_चर_प्रकार[नोड["नाम"]];
    }
    
    यदि (वर्ग_नाम != "" && वर्ग_नाम != शून्यम् && वर्ग_नक्शा[वर्ग_नाम] != शून्यम्) {
        परत् खोजें_सूची_सर्जक(वर्ग_नक्शा[वर्ग_नाम], क्षेत्र_नाम);
    }
    परत् 0;
}

कार्य दशमलव_मान_कोड_सर्जक(शब्दकोश नोड, पाठ कोड) {
    यदि (क्या_दशमलव_अभिव्यक्ति_है(नोड)) {
