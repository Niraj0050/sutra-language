// स्वसंकलक/फ्रीस्टैंडिंग.सूत्र — `--freestanding` सुरक्षा-द्वार
// ============================================================
// मुख्य से पहुँचनीय हर फलन को जाँचता है कि वह केवल संख्या-गणित,
// अंतर्_पढ़8/पढ़1/लिख8/लिख1, बिट्_* बिल्टिन, और अन्य पहुँचनीय (उसी नियम से
// जाँचे गए) फलनों को ही बुलाता है — कोई सूची/शब्दकोश/पाठ/वर्ग-वस्तु नहीं,
// क्योंकि इन सबको Sutra का GC/हीप चाहिए, जो freestanding (कोई OS नहीं)
// संदर्भ में उपलब्ध नहीं। rules.md §2c देखो।
//
// यह एक syntactic जाँच है — पूर्ण data-flow/type-flow प्रमाण नहीं (जैसे
// थ्रेड.सूत्र का GC-हैज़र्ड अनुशासन भी दस्तावेज़ी है, गणितीय-सिद्ध नहीं) —
// पर हर "सूची/शब्दकोश/पाठ अक्षरशः", हर चर/पैरामीटर का घोषित प्रकार, और हर
// कॉल का लक्ष्य नाम पकड़ लेता है, जो व्यवहार में लगभग हर वास्तविक गलती है।
//
// जान-बूझकर कई छोटे फलनों में तोड़ा है (एक बड़े फलन में नहीं) — एक बड़े
// worklist-फलन में बहुत सारे चर एक साथ जीवित रहने पर x86 register
// allocator के spill-slot आबंटन में एक असंबंधित, पहले से मौजूद बग सामने
// आया (देखो memory/project_sutra_language.md — "freestanding_जाँच बग")।

सूची फ्री_सुरक्षित_बिल्टिन = ["अंतर्_पढ़8", "अंतर्_पढ़1", "अंतर्_लिख8", "अंतर्_लिख1",
    "बिट_और", "बिट_या", "बिट_भेद", "बिट_उलट", "बाम_सरक", "दक्षिण_सरक"];

कार्य फ्री_सूची_में_है(सूची स, पाठ मूल्य) {
    संख्या इ = 0;
    यावत् (इ < लंबाई(स)) {
        यदि (स[इ] == मूल्य) { परत् सत्य; }
        इ = इ + 1;
    }
    परत् असत्य;
}

कार्य फ्री_प्रकार_असुरक्षित(पाठ प्र) {
    परत् प्र == "सूची" || प्र == "शब्दकोश" || प्र == "पाठ";
}

// नोड (या सूची, या scalar) को गहराई से जाँचो; हर अभिव्यक्ति_कॉल का नाम
// बुलाए_नक्शा (शब्दकोश, in-place mutate होता) में दर्ज करो।
कार्य फ्री_जाँच_नोड(मान नोड, पाठ फलन_नाम, शब्दकोश बुलाए_नक्शा) {
    यदि (नोड == शून्यम्) { परत्; }
    पाठ प्र = प्रकार(नोड);

    यदि (प्र == "सूची") {
        संख्या इ = 0;
        यावत् (इ < लंबाई(नोड)) {
            फ्री_जाँच_नोड(नोड[इ], फलन_नाम, बुलाए_नक्शा);
            इ = इ + 1;
        }
        परत्;
    }
    यदि (प्र != "शब्दकोश") { परत्; }

    पाठ नोप्र = नोड["नोड_प्रकारः"];

    यदि (नोप्र == "अभिव्यक्ति_सूची_स्थिरांक" || नोप्र == "अभिव्यक्ति_शब्दकोश_स्थिरांक"
        || नोप्र == "अभिव्यक्ति_नवीन" || नोप्र == "अभिव्यक्ति_विधि_कॉल"
        || नोप्र == "अभिव्यक्ति_सभ्य") {
        प्रक्षेपः "त्रुटिः — freestanding मोड: '" + फलन_नाम + "' में '" + नोप्र + "' अनुमत नहीं (GC/वस्तु आवश्यक)।";
    }
    यदि (नोप्र == "अभिव्यक्ति_स्थिरांक" && नोड["स्थिरांक_प्रकारः"] == "पाठ") {
        प्रक्षेपः "त्रुटिः — freestanding मोड: '" + फलन_नाम + "' में पाठ-अक्षरशः अनुमत नहीं (GC आवश्यक)।";
    }
    यदि (नोप्र == "कठन_चर_घोषणा" && फ्री_प्रकार_असुरक्षित(नोड["प्रकार_नाम"])) {
        प्रक्षेपः "त्रुटिः — freestanding मोड: '" + फलन_नाम + "' में चर '" + नोड["नाम"] + "' का प्रकार '" + नोड["प्रकार_नाम"] + "' अनुमत नहीं।";
    }
    यदि (नोप्र == "अभिव्यक्ति_कॉल") {
        बुलाए_नक्शा[नोड["नाम"]] = सत्य;
    }

    सूची कुं = कुंजियाँ(नोड);
    संख्या कइ = 0;
    यावत् (कइ < लंबाई(कुं)) {
        फ्री_जाँच_नोड(नोड[कुं[कइ]], फलन_नाम, बुलाए_नक्शा);
        कइ = कइ + 1;
    }
}

कार्य फ्री_कार्य_मानचित्र_बनाओ(शब्दकोश प्रोग्राम_नोड) {
    सूची कार्य_सूची = प्रोग्राम_नोड["कार्य_सूची"];
    शब्दकोश नक्शा = {};
    संख्या इ = 0;
    यावत् (इ < लंबाई(कार्य_सूची)) {
        नक्शा[कार्य_सूची[इ]["नाम"]] = कार्य_सूची[इ];
        इ = इ + 1;
    }
    परत् नक्शा;
}

कार्य फ्री_पैरामीटर_जाँचो(पाठ नाम, सूची तर्काः) {
    संख्या टइ = 0;
    यावत् (टइ < लंबाई(तर्काः)) {
        यदि (फ्री_प्रकार_असुरक्षित(तर्काः[टइ]["प्रकार_नाम"])) {
            प्रक्षेपः "त्रुटिः — freestanding मोड: '" + नाम + "' का पैरामीटर '" + तर्काः[टइ]["नाम"] + "' प्रकार '" + तर्काः[टइ]["प्रकार_नाम"] + "' अनुमत नहीं।";
        }
        टइ = टइ + 1;
    }
}

// एक फलन को जाँचो (पैरामीटर-प्रकार + देह); नए कॉल-नाम सभी_बुलाए में जुड़ते
कार्य फ्री_एक_कार्य_जाँचो(पाठ नाम, शब्दकोश कार्य_मानचित्र, शब्दकोश सभी_बुलाए) {
    शब्दकोश कार्य_नोड = कार्य_मानचित्र[नाम];
    यदि (कार्य_नोड == शून्यम्) {
        प्रक्षेपः "त्रुटिः — freestanding मोड: '" + नाम + "' को बुलाना अनुमत नहीं (रनटाइम/GC आवश्यक, या अपरिभाषित)।";
    }
    फ्री_पैरामीटर_जाँचो(नाम, कार्य_नोड["तर्काः"]);
    फ्री_जाँच_नोड(कार्य_नोड["देह"], नाम, सभी_बुलाए);
}

// सभी_बुलाए में जो नाम अभी तक न देखे गए हों उन्हें जाँचो; कोई नया मिला तो सत्य
कार्य फ्री_एक_चक्कर(शब्दकोश कार्य_मानचित्र, शब्दकोश देखा_गया, शब्दकोश सभी_बुलाए) {
    सूची कुं = कुंजियाँ(सभी_बुलाए);
    मान बदला = असत्य;
    संख्या कइ = 0;
    यावत् (कइ < लंबाई(कुं)) {
        पाठ नाम = कुं[कइ];
        यदि (देखा_गया[नाम] != सत्य && फ्री_सूची_में_है(फ्री_सुरक्षित_बिल्टिन, नाम) == असत्य) {
            देखा_गया[नाम] = सत्य;
            फ्री_एक_कार्य_जाँचो(नाम, कार्य_मानचित्र, सभी_बुलाए);
            बदला = सत्य;
        }
        कइ = कइ + 1;
    }
    परत् बदला;
}

// प्रोग्राम_नोड लेकर मुख्य से पहुँचनीय पूरे call-graph को जाँचता — असुरक्षित
// कुछ भी मिलते ही प्रक्षेपः (compile-time त्रुटि)। सब ठीक हो तो चुपचाप लौटता।
कार्य फ्रीस्टैंडिंग_जाँच_एकक(शब्दकोश प्रोग्राम_नोड) {
    शब्दकोश कार्य_मानचित्र = फ्री_कार्य_मानचित्र_बनाओ(प्रोग्राम_नोड);
    यदि (कार्य_मानचित्र["मुख्य"] == शून्यम्) {
        प्रक्षेपः "त्रुटिः — freestanding मोड: 'मुख्य' कार्य अनुपस्थित।";
    }

    शब्दकोश देखा_गया = {};
    शब्दकोश सभी_बुलाए = {};
    सभी_बुलाए["मुख्य"] = सत्य;

    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = फ्री_एक_चक्कर(कार्य_मानचित्र, देखा_गया, सभी_बुलाए);
    }
}
