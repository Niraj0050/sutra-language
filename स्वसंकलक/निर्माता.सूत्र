// निर्माता.सूत्र — सूत्र निर्माण-तन्त्रम् (Sutra Build System)

आयात "विश्लेषक.सूत्र";
आयात "मूल_सर्जक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";

// Helper to evaluate static manifest values
कार्य सार्थक_मूल्य_मूल्यांकन(शब्दकोश नोड) {
    मान प्रकार = नोड["नोड_प्रकारः"];
    यदि (प्रकार == "अभिव्यक्ति_स्थिरांक") {
        मान स्थिर_प्रकार = नोड["स्थिरांक_प्रकारः"];
        मान मानः = नोड["मानः"];
        यदि (स्थिर_प्रकार == "बूल") {
            यदि (मानः == "सत्य") { परत् सत्य; }
            परत् असत्य;
        }
        यदि (स्थिर_प्रकार == "पूर्णाङ्क" || स्थिर_प्रकार == "बड़ा_पूर्णांक") {
            परत् सूत्र_संख्या_परिवर्तन(मानः);
        }
        यदि (स्थिर_प्रकार == "दशमलव") {
            परत् सूत्र_संख्या_परिवर्तन(मानः);
        }
        यदि (स्थिर_प्रकार == "शून्यम्") {
            परत् शून्यम्;
        }
        परत् मानः;
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_सूची_स्थिरांक") {
        सूची तत्व = नोड["तत्व"];
        सूची परिणाम = [];
        मान सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            परिणाम = जोड़ें(परिणाम, सार्थक_मूल्य_मूल्यांकन(तत्व[सूचक]));
            सूचक = सूचक + 1;
        }
        परत् परिणाम;
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_शब्दकोश_स्थिरांक") {
        सूची तत्व = नोड["तत्व"];
        शब्दकोश परिणाम = {};
        मान सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            शब्दकोश युगल = तत्व[सूचक];
            परिणाम[युगल["कुंजी"]] = सार्थक_मूल्य_मूल्यांकन(युगल["मानः"]);
            सूचक = सूचक + 1;
        }
        परत् परिणाम;
    }
    परत् शून्यम्;
}

कार्य सूत्र_संख्या_परिवर्तन(पाठ्य) {
    मान सूचक = 0;
    मान परिणाम = 0;
    यावत् (सूचक < लंबाई(पाठ्य)) {
        मान वर्ण = अक्षर_मान(पाठ्य[सूचक]);
        यदि (वर्ण >= 48 && वर्ण <= 57) {
            परिणाम = परिणाम * 10 + (वर्ण - 48);
        } अन्यथा यदि (वर्ण >= 2406 && वर्ण <= 2415) {
            परिणाम = परिणाम * 10 + (वर्ण - 2406);
        }
        सूचक = सूचक + 1;
    }
    परत् परिणाम;
}

कार्य खोजो_ध्वज(सूची तर्काः_सूची, पाठ ध्वज) {
    मान सूचक = 0;
    यावत् (सूचक < लंबाई(तर्काः_सूची)) {
        यदि (तर्काः_सूची[सूचक] == ध्वज) {
            परत् सत्य;
        }
        सूचक = सूचक + 1;
    }
    परत् असत्य;
}

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    
    यदि (खोजो_ध्वज(तर्काः_सूची, "--help") || खोजो_ध्वज(तर्काः_सूची, "-h") || खोजो_ध्वज(तर्काः_सूची, "सहायता")) {
        लिखतु("सूत्र निर्माण-तन्त्रम् (Sutra Build System) v1.0.0");
        लिखतु("");
        लिखतु("उपयोगः (Usage):");
        लिखतु("  sutra_build <निर्देशः (command)> [options]");
        लिखतु("");
        लिखतु("निर्देशाः (Commands):");
        लिखतु("  build            परियोजनां संकलयति (Compile the project - default command)");
        लिखतु("  clean            निर्माण निर्देशिकां निष्कासयति (Clean generated build artifacts)");
        लिखतु("");
        लिखतु("विकल्पाः (Options):");
        लिखतु("  --no-format      स्वरूपणम् विना संकलनम् करोति (Do not format before build)");
        लिखतु("  --no-lint        निरीक्षणम् विना संकलनम् करोति (Do not lint before build)");
        लिखतु("  --debug          डिबग सूचनाः रक्षति (Build with debugging information)");
        लिखतु("  --release        निष्पादनं अनुकूलयति (Build in release mode - default)");
        लिखतु("  --verbose, -v    विस्तृत-विवरणम् (Print processing logs)");
        लिखतु("  --help, -h       सहायता (Display this help information)");
        परत्;
    }

    मान सूचक_आरंभ = 1;
    यदि (लंबाई(तर्काः_सूची) > 1) {
        मान तर्क_प्रथम = तर्काः_सूची[1];
        यदि (लंबाई(तर्क_प्रथम) >= 5) {
            यदि (अक्षर_मान(तर्क_प्रथम[लंबाई(तर्क_प्रथम) - 1]) == 2352 && अक्षर_मान(तर्क_प्रथम[लंबाई(तर्क_प्रथम) - 4]) == 2370) {
                सूचक_आरंभ = 2;
            }
        }
    }

    मान निर्देशः = "build";
    यदि (लंबाई(तर्काः_सूची) > सूचक_आरंभ) {
        निर्देशः = तर्काः_सूची[सूचक_आरंभ];
    }

    यदि (निर्देशः == "clean") {
        लिखतु("[build] निर्माण निर्देशिका प्रक्षालनम् आरब्धम्...");
        मान साफ_कमांड = "cmd /c \"if exist निर्माण rmdir /q /s निर्माण\"";
        कमांड_चलाओ(साफ_कमांड);
        लिखतु("[build] निर्माण निर्देशिका सफलेन प्रक्षालितम् (Build directory successfully cleaned)");
        परत्;
    } अन्यथा यदि (निर्देशः == "build") {
        मान प्रवेश_बिंदु = "मुख्य.सूत्र";
        मान निर्गम = "निर्माण/मुख्य.exe";
        मान स्वरूपण = असत्य;
        मान निरीक्षण = असत्य;
        मान डिबग = असत्य;
        मान वर्बोस = असत्य;

        // Apply CLI option overrides
        यदि (खोजो_ध्वज(तर्काः_सूची, "--no-format")) {
            स्वरूपण = असत्य;
        }
        यदि (खोजो_ध्वज(तर्काः_सूची, "--no-lint")) {
            निरीक्षण = असत्य;
        }
        यदि (खोजो_ध्वज(तर्काः_सूची, "--debug")) {
            डिबग = सत्य;
        }
        यदि (खोजो_ध्वज(तर्काः_सूची, "--verbose") || खोजो_ध्वज(तर्काः_सूची, "-v")) {
            वर्बोस = सत्य;
        }

        // Load manifest
        यदि (सञ्चिका_अस्ति("पैकेज.सूत्र")) {
            मान सामग्री = सञ्चिका_पठतु("पैकेज.सूत्र");
            यदि (वर्बोस) {
                लिखतु("[build] पैकेज.सूत्र लब्धम्, विश्लेषणम् क्रियते...");
            }
            
            प्रयत्न {
                सूची पद_सूची = पद_विच्छेदन(सामग्री);
                शब्दकोश अवस्था = {};
                अवस्था["पद_सूची"] = पद_सूची;
                अवस्था["अनुक्रमणिका"] = 0;
                अवस्था["कुल_पद"] = लंबाई(पद_सूची);
                शब्दकोश आयातित_सञ्चिकाः = {};
                शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित_सञ्चिकाः, "पैकेज.सूत्र");
                
                शब्दकोश पैकेज_डिक्ट = शून्यम्;
                सूची वैश्विक_कथन = प्रोग्राम_नोड["वैश्विक_कथन"];
                मान सूचक = 0;
                यावत् (सूचक < लंबाई(वैश्विक_कथन)) {
                    शब्दकोश कथन = वैश्विक_कथन[सूचक];
                    यदि (कथन["नोड_प्रकारः"] == "कठन_चर_घोषणा") {
                        यदि (कथन["नाम"] == "पैकेज") {
                            पैकेज_डिक्ट = कथन["प्रारंभिक"];
                        }
                    } अन्यथा यदि (कथन["नोड_प्रकारः"] == "कठन_असाइनमेंट") {
                        यदि (कथन["नाम"] == "पैकेज") {
                            पैकेज_डिक्ट = कथन["मानः"];
                        }
                    }
                    सूचक = सूचक + 1;
                }
                
                यदि (पैकेज_डिक्ट != शून्यम्) {
                    मान पैकेज_मूल्य = सार्थक_मूल्य_मूल्यांकन(पैकेज_डिक्ट);
                    यदि (प्रकार(पैकेज_मूल्य) == "शब्दकोश") {
                        यदि (पैकेज_मूल्य["निर्माण"] != शून्यम् && प्रकार(पैकेज_मूल्य["निर्माण"]) == "शब्दकोश") {
                            शब्दकोश निर्माण_डिक्ट = पैकेज_मूल्य["निर्माण"];
                            यदि (निर्माण_डिक्ट["प्रवेश_बिंदु"] != शून्यम्) {
                                प्रवेश_बिंदु = निर्माण_डिक्ट["प्रवेश_बिंदु"];
                            } अन्यथा यदि (निर्माण_डिक्ट["entry_point"] != शून्यम्) {
                                प्रवेश_बिंदु = निर्माण_डिक्ट["entry_point"];
                            }
                            यदि (निर्माण_डिक्ट["निर्गम"] != शून्यम्) {
                                निर्गम = निर्माण_डिक्ट["निर्गम"];
                            } अन्यथा यदि (निर्माण_डिक्ट["output"] != शून्यम्) {
                                निर्गम = निर्माण_डिक्ट["output"];
                            }
                            यदि (निर्माण_डिक्ट["स्वरूपण"] != शून्यम्) {
                                स्वरूपण = निर्माण_डिक्ट["स्वरूपण"];
                            } अन्यथा यदि (निर्माण_डिक्ट["format"] != शून्यम्) {
                                स्वरूपण = निर्माण_डिक्ट["format"];
                            }
                            यदि (निर्माण_डिक्ट["निरीक्षण"] != शून्यम्) {
                                निरीक्षण = निर्माण_डिक्ट["निरीक्षण"];
                            } अन्यथा यदि (निर्माण_डिक्ट["lint"] != शून्यम्) {
                                निरीक्षण = निर्माण_डिक्ट["lint"];
                            }
                        }
                        
                        // Parse and verify dependencies
                        शब्दकोश निर्भरताएँ = शून्यम्;
                        यदि (पैकेज_मूल्य["निर्भरताएँ"] != शून्यम् && प्रकार(पैकेज_मूल्य["निर्भरताएँ"]) == "शब्दकोश") {
                            निर्भरताएँ = पैकेज_मूल्य["निर्भरताएँ"];
                        } अन्यथा यदि (पैकेज_मूल्य["dependencies"] != शून्यम् && प्रकार(पैकेज_मूल्य["dependencies"]) == "शब्दकोश") {
                            निर्भरताएँ = पैकेज_मूल्य["dependencies"];
                        }
                        
                        यदि (निर्भरताएँ != शून्यम्) {
                            सूची कुंजी_सूची = कुंजियाँ(निर्भरताएँ);
                            मान क_सूचक = 0;
                            यावत् (क_सूचक < लंबाई(कुंजियाँ(निर्भरताएँ))) {
                                पाठ कुंजी = कुंजी_सूची[क_सूचक];
                                पाठ मार्ग_निर्देशिका = "संकुलानि/" + कुंजी;
                                पाठ मार्ग_सञ्चिका = "संकुलानि/" + कुंजी + ".सूत्र";
                                यदि (न सञ्चिका_अस्ति(मार्ग_निर्देशिका) && न सञ्चिका_अस्ति(मार्ग_सञ्चिका)) {
                                    लिखतु("त्रुटिः: निर्भरता '" + कुंजी + "' अनुपस्थिता अस्ति (Error: dependency '" + कुंजी + "' is missing)");
                                    परत्;
                                }
                                क_सूचक = क_सूचक + 1;
                            }
                        }
                    }
                }
            } पकड़ो (त्रुटि) {
                लिखतु("त्रुटिः — पैकेज.सूत्र विश्लेषणम् विफलम्: " + त्रुटि);
                परत्;
            }
        } अन्यथा {
            यदि (वर्बोस) {
                लिखतु("[build] पैकेज.सूत्र न लब्धम्, पूर्वनिर्धारित मान उपयुज्यते।");
            }
        }

        // Validate entry point existence
        यदि (न सञ्चिका_अस्ति(प्रवेश_बिंदु)) {
            // Fallback check
            यदि (प्रवेश_बिंदु == "मुख्य.सूत्र" && सञ्चिका_अस्ति("main.सूत्र")) {
                प्रवेश_बिंदु = "main.सूत्र";
            } अन्यथा {
                लिखतु("प्रवेश बिंदु सञ्चिका न लब्धा (Entry point file not found): " + प्रवेश_बिंदु);
                परत्;
            }
        }

        यदि (स्वरूपण) {
            यदि (वर्बोस) {
                लिखतु("[build] स्वरूपणम् क्रियते: " + प्रवेश_बिंदु);
            }
            मान फॉर्मेट_कमांड = "sutra_formatter.exe --write " + प्रवेश_बिंदु;
            कमांड_चलाओ(फॉर्मेट_कमांड);
        }

        यदि (निरीक्षण) {
            यदि (वर्बोस) {
                लिखतु("[build] निरीक्षणम् क्रियते: " + प्रवेश_बिंदु);
            }
            मान लिंट_कमांड = "sutra_linter.exe " + प्रवेश_बिंदु;
            कमांड_चलाओ(लिंट_कमांड);
        }

        लिखतु("[build] परियोजना संकलन प्रवाहः आरब्धः (Starting build pipeline...)");
        यदि (वर्बोस) {
            लिखतु("[build] Entry point: " + प्रवेश_बिंदु);
            लिखतु("[build] Output path: " + निर्गम);
        }

        मान स्रोत_पाठ = सञ्चिका_पठतु(प्रवेश_बिंदु);

        प्रयत्न {
            सूची पद_सूची = पद_विच्छेदन(स्रोत_पाठ);
            शब्दकोश अवस्था = {};
            अवस्था["पद_सूची"] = पद_सूची;
            अवस्था["अनुक्रमणिका"] = 0;
            अवस्था["कुल_पद"] = लंबाई(पद_सूची);
            शब्दकोश आयातित_सञ्चिकाः = {};
            शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित_सञ्चिकाः, प्रवेश_बिंदु);
            
            मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
            
            मान संयोजन_कोड = मूल_सर्जक_प्रोग्राम(प्रोग्राम_नोड);
            
            // Allocate temporary assembly file
            मान स_मार्ग = "sutra_native_temp.s";
            सञ्चिका_लिखतु(स_मार्ग, संयोजन_कोड);
            
            // Find sutra_runtime.c relative path
            मान मार्ग_अनुक्रम = [
                "sutra_runtime.c",
                "संकलक/src/compiler/sutra_runtime.c",
                "../sutra_runtime.c",
                "../संकलक/src/compiler/sutra_runtime.c",
                "../../sutra_runtime.c",
                "../../संकलक/src/compiler/sutra_runtime.c",
                "../../../sutra_runtime.c",
                "../../../संकलक/src/compiler/sutra_runtime.c"
            ];
            
            मान मूल_सञ्चिका = "";
            मान सूचक_मार्ग = 0;
            यावत् (सूचक_मार्ग < लंबाई(मार्ग_अनुक्रम)) {
                यदि (सञ्चिका_अस्ति(मार्ग_अनुक्रम[सूचक_मार्ग])) {
                    मूल_सञ्चिका = मार्ग_अनुक्रम[सूचक_मार्ग];
                    सूचक_मार्ग = लंबाई(मार्ग_अनुक्रम);
                }
                सूचक_मार्ग = सूचक_मार्ग + 1;
            }

            यदि (लंबाई(मूल_सञ्चिका) == 0) {
                प्रक्षेपः "sutra_runtime.c न लब्धम् (sutra_runtime.c not found)";
            }

            // Copy runtime to temp.c
            मान रनटाइम_सामग्री = सञ्चिका_पठतु(मूल_सञ्चिका);
            सञ्चिका_लिखतु("sutra_runtime_temp.c", रनटाइम_सामग्री);
            
            // Compile runtime
            मान रनटाइम_कमांड = "C:\\msys64\\ucrt64\\bin\\gcc.exe -m64 -O2 -finput-charset=UTF-8 -fexec-charset=UTF-8 -c sutra_runtime_temp.c -o sutra_runtime_temp.o";
            कमांड_चलाओ(रनटाइम_कमांड);
            
            यदि (न सञ्चिका_अस्ति("sutra_runtime_temp.o")) {
                कमांड_चलाओ("gcc -m64 -O2 -finput-charset=UTF-8 -fexec-charset=UTF-8 -c sutra_runtime_temp.c -o sutra_runtime_temp.o");
            }
            
            यदि (न सञ्चिका_अस्ति("sutra_runtime_temp.o")) {
                प्रक्षेपः "त्रुटिः — रनटाइम संकलन विफल।";
            }

            मान ओ_मार्ग = "sutra_native_temp.o";
            मान संयोजक_कमांड = "C:\\msys64\\ucrt64\\bin\\as.exe -o " + ओ_मार्ग + " " + स_मार्ग;
            कमांड_चलाओ(संयोजक_कमांड);
            
            यदि (न सञ्चिका_अस्ति(ओ_मार्ग)) {
                प्रक्षेपः "त्रुटिः — संयोजन विफल।";
            }
            
            मान ई_मार्ग = "sutra_native_temp.exe";
            मान लिंकर_कमांड = "C:\\msys64\\ucrt64\\bin\\gcc.exe -m64 " + ओ_मार्ग + " sutra_runtime_temp.o -lshell32 -o " + ई_मार्ग;
            कमांड_चलाओ(लिंकर_कमांड);
            
            यदि (न सञ्चिका_अस्ति(ई_मार्ग)) {
                कमांड_चलाओ("gcc -m64 " + ओ_मार्ग + " sutra_runtime_temp.o -lshell32 -o " + ई_मार्ग);
            }
            
            यदि (न सञ्चिका_अस्ति(ई_मार्ग)) {
                प्रक्षेपः "त्रुटिः — लिंक विफल।";
            }

            // Create target output directories if needed
            मान सूचक = लंबाई(निर्गम) - 1;
            मान पैरेंट_मार्ग = "";
            यावत् (सूचक >= 0) {
                मान वर्ण = अक्षर_मान(निर्गम[सूचक]);
                यदि (वर्ण == 47 || वर्ण == 92) {
                    मान स_सूचक = 0;
                    यावत् (स_सूचक < सूचक) {
                        पैरेंट_मार्ग = पैरेंट_मार्ग + अक्षर_निर्माण(अक्षर_मान(निर्गम[स_सूचक]));
                        स_सूचक = स_सूचक + 1;
                    }
                    सूचक = -1;
                } अन्यथा {
                    सूचक = सूचक - 1;
                }
            }

            यदि (लंबाई(पैरेंट_मार्ग) > 0) {
                मान डायरेक्टरी_कमांड = "cmd /c \"if not exist " + पैरेंट_मार्ग + " mkdir " + पैरेंट_मार्ग + "\"";
                कमांड_चलाओ(डायरेक्टरी_कमांड);
            }

            // Copy to final target path
            मान प्रतिलिपि_कमांड = "cmd /c copy /y " + ई_मार्ग + " \"" + निर्गम + "\"";
            कमांड_चलाओ(प्रतिलिपि_कमांड);

            // Cleanup temp files
            कमांड_चलाओ("cmd /c del /q sutra_native_temp.s sutra_native_temp.o sutra_native_temp.exe sutra_runtime_temp.c sutra_runtime_temp.o");

            लिखतु("[build] संकलनं सफलं जातम् (Build successful!)");
            लिखतु("[build] निर्गम: " + निर्गम);
        } पकड़ो (त्रुटि) {
            लिखतु("त्रुटिः: संकलनं विफलम् (Build failed): " + त्रुटि);
        }
    } अन्यथा {
        लिखतु("त्रुटिः: अज्ञात निर्देशः (Unknown command: " + निर्देशः + ")");
        लिखतु("Available commands: build, clean");
    }
}

