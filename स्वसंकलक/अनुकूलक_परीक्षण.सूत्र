// अनुकूलक_परीक्षण.सूत्र — Phase 1c passes का test
// असली parser → lower → optimize → IR डंप जाँचो।

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";

मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= 0; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}
कार्य अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

कार्य मुख्य() {
    // 1. mem2reg + const-fold + x+0
    पाठ द1 = अनुकूलित("कार्य जोड़(संख्या अ, संख्या ब) { संख्या स = अ + ब; परत् स + 0; }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 slot हटे", न है(द1, "स्लॉट"));
    जाँच("1 पढ़_स्लॉट हटे", न है(द1, "पढ़_स्लॉट"));
    जाँच("1 योग बचा", है(द1, "= योग v1, v2"));
    जाँच("1 +0 हटा", न है(द1, "स्थिर पूर्ण:0"));

    // 2. const-fold पूरी शृंखला
    पाठ द2 = अनुकूलित("कार्य क() { परत् 2 + 3 * 4; }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 सब fold", है(द2, "वापस v") && न है(द2, "योग") && न है(द2, "गुणा"));
    जाँच("2 मान 14", है(द2, "पूर्ण:14"));

    // 3. loop — phi बनना चाहिए
    पाठ द3 = अनुकूलित("कार्य योग_तक(संख्या सीमा) { संख्या इ = 0; संख्या ज = 0; यावत् (इ < सीमा) { ज = ज + इ; इ = इ + 1; } परत् ज; }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 slot हटे", न है(द3, "स्लॉट "));
    जाँच("3 फाई बना", है(द3, "= फाई ["));
    जाँच("3 loop-back जाओ", है(द3, "जाओ wh_शर्त"));

    // 4. DCE — अगम्य खंड
    पाठ द4 = अनुकूलित("कार्य म(संख्या क) { यदि (क > 0) { परत् 1; } अन्यथा { परत् 2; } }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 if_अंत हटा (अगम्य)", न है(द4, "if_अंत"));

    // 5. बिटवार const-fold (§4a) — बिट_या(बिट_और(240,60), बाम_सरक(1,8)) = 48|256 = 304
    पाठ द5 = अनुकूलित("कार्य ख() { परत् बिट_या(बिट_और(240, 60), बाम_सरक(1, 8)); }");
    लिखतु("--- 5 ---"); लिखतु(द5);
    जाँच("5 bitwise सब fold", है(द5, "पूर्ण:304") && न है(द5, "बिट_") && न है(द5, "सरक"));

    // 6. unary const-fold (§4a) — -(3*4) = -12
    पाठ द6 = अनुकूलित("कार्य ग() { परत् -(3 * 4); }");
    लिखतु("--- 6 ---"); लिखतु(द6);
    जाँच("6 unary fold", है(द6, "पूर्ण:-12") && न है(द6, "ऋणात्मक") && न है(द6, "गुणा"));

    // 7. बड़ा folded स्थिरांक (>2³¹) — बाम_सरक(1,40) = 1099511627776
    पाठ द7 = अनुकूलित("कार्य घ() { परत् बाम_सरक(1, 40); }");
    लिखतु("--- 7 ---"); लिखतु(द7);
    जाँच("7 बड़ा fold", है(द7, "पूर्ण:1099511627776"));

    // 8. जाओ_सरल (§4f) — हाथ से बना trivial pass-through खंड सीधे बायपास हो
    शब्दकोश फ8 = मध्यम_नव_कार्य("परी", "पूर्ण");
    शब्दकोश ब_प्रवेश = मध्यम_नव_खंड(फ8, "प्रवेश");
    शब्दकोश ब_तुच्छ = मध्यम_नव_खंड(फ8, "तुच्छ");
    शब्दकोश ब_अंत = मध्यम_नव_खंड(फ8, "अंत");
    मध्यम_जाओ(ब_प्रवेश, ब_तुच्छ["लेबल"]);
    मध्यम_जाओ(ब_तुच्छ, ब_अंत["लेबल"]);   // ब_तुच्छ = सिर्फ़ आगे जाओ — तुच्छ
    मध्यम_वापस(ब_अंत, मध्यम_स्थिर_पूर्ण(फ8, ब_अंत, 42));
    जाओ_सरल(फ8);
    मृत_कोड_हटाओ(फ8);
    पाठ द8 = मध्यम_छापो_कार्य(फ8);
    लिखतु("--- 8 ---"); लिखतु(द8);
    जाँच("8 तुच्छ खंड बायपास", है(द8, "जाओ " + ब_अंत["लेबल"]));
    जाँच("8 तुच्छ खंड हटा (अगम्य)", न है(द8, ब_तुच्छ["लेबल"] + ":"));

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
