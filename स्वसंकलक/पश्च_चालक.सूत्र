// पश्च_चालक.सूत्र — CLI: IR-पाठ → रजि_नियतक → उत्सर्जक → .s (stdout)
// ============================================================
// split-pipeline का दूसरा भाग। अग्र_चालक की IR-पाठ पढ़कर assembly देता है।
// यह विश्लेषक + मूल_निम्नक import नहीं करता → छोटा, आसानी से संकलित।
//
// प्रयोग:  <exe> path/to/out.ir  > out.s
// ============================================================

आयात "मूल_उत्सर्जक.सूत्र";   // मध्यम + अनुकूलक + रजि_नियतक साथ लाता है
आयात "मध्यम_क्रम.सूत्र";
आयात "प्रकार_प्रसार.सूत्र";   // deserialize के बाद प्रकार-टैग फिर से भरो —
                              // serialization कुछ upgraded टैग खो देता, तो
                              // बिना इसके split-पथ के roots unified से भिन्न

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) < २) {
        लिखतु("# प्रयोग: पश्च_चालक <out.ir>  > out.s");
        परत्;
    }
    पाठ मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - १];
    पाठ इनपुट = सञ्चिका_पठतु(मार्गः);

    शब्दकोश एकक = मध्यम_विक्रमबद्ध(इनपुट);
    प्रकार_प्रसार_एकक(एकक);
    लिखतु(उत्सर्जक_एकक(एकक));
}
