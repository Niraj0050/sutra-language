// अंतर्वेशन.सूत्र — फलन-inlining [§4 perf, M4-B के बाद की कड़ी]
// ============================================================
// लक्ष्य: छोटे, non-recursive callee को call-site पर सीधे splice करना ताकि
// हर call का overhead (stack frame, argument marshalling, call/ret) न लगे।
// fib(35) बनाम C++ benchmark में सबसे बड़ा नापा गया अंतर यही था।
//
// दायरा (v1 — जानबूझकर संकुचित):
//   - सिर्फ़ इसी एकक के भीतर की callee (library/runtime कॉल अछूते)।
//   - सिर्फ़ single-basic-block callee (फाई खाली, अंत = "वापस") — कोई नया
//     ब्लॉक, कोई CFG-बदलाव, कोई नया फाई नहीं चाहिए, बस निर्देश-splice।
//   - कोई self-recursion नहीं (लक्ष्य != कॉलर का अपना नाम)।
//   - आकार-सीमा (≤20 निर्देश) — code-growth/compile-time पर लगाम।
//   - फलन-प्रति बंधित raunds (≤5) — कोई अनबाउंडेड fixpoint नहीं (§4-b/M4-B
//     के सबक — cost हमेशा मापो, मान मत लो)।
// Multi-block callee (यदि/लूप के साथ) जानबूझकर v1 से बाहर — बाद का काम।
//
// अभी कहीं wire नहीं — केवल अंतर्वेशन_परीक्षण.सूत्र से जाँचा।
// ============================================================

आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";

कार्य अवे_सीमा() { परत् २०; }

// शब्दकोश की उथली प्रतिलिपि (अंश को क्लोन के बीच साझा होने से बचाने को)
कार्य अवे_अंश_प्रति(शब्दकोश अंश) {
    यदि (अंश == शून्यम्) { परत् {}; }
    शब्दकोश नया = {};
    सूची कुं = कुंजियाँ(अंश);
    संख्या इ = ०;
    यावत् (इ < लंबाई(कुं)) {
        नया[कुं[इ]] = अंश[कुं[इ]];
        इ = इ + १;
    }
    परत् नया;
}

// क्या callee संरचनात्मक रूप से v1-योग्य है? (कॉलर-निरपेक्ष जाँचें छोड़कर)
कार्य अवे_योग्य_फलन(शब्दकोश कॉलर, शब्दकोश कैली) {
    यदि (कैली["नाम"] == कॉलर["नाम"]) { परत् असत्य; }   // self-recursion guard
    यदि (लंबाई(कैली["खंड_सूची"]) != १) { परत् असत्य; }
    शब्दकोश खंड = कैली["खंड_सूची"][०];
    यदि (लंबाई(खंड["फाई"]) != ०) { परत् असत्य; }
    मान अंत = खंड["अंत"];
    यदि (अंत == शून्यम् || अंत["कोड"] != "वापस") { परत् असत्य; }
    यदि (लंबाई(खंड["निर्देश"]) > अवे_सीमा()) { परत् असत्य; }
    परत् सत्य;
}

// संचालक-सूची को rename-नक्शे से अनुवाद करो
कार्य अवे_संचालक_अनुवाद(सूची संचालक, शब्दकोश नक्शा) {
    सूची नयी = [];
    संख्या इ = ०;
    यावत् (इ < लंबाई(संचालक)) {
        संख्या मव = संचालक[इ];
        मान हित = शून्यम्;
        यदि (मव >= १) { हित = नक्शा[मव]; }
        यदि (हित != शून्यम्) { नयी = जोड़ें(नयी, हित); }
        अन्यथा { नयी = जोड़ें(नयी, मव); }
        इ = इ + १;
    }
    परत् नयी;
}

// एक callee को कॉलर के संदर्भ में क्लोन करो — फ्रेश ids, पैरामीटर argument-ids
// से replace, वापसी-मान translate करके लौटाओ (शून्यम् अगर void)।
कार्य अवे_क्लोन_करो(शब्दकोश कॉलर, शब्दकोश कैली, शब्दकोश बुलाओ_निर्देश) {
    शब्दकोश खंड = कैली["खंड_सूची"][०];
    सूची पैरा = कैली["पैरामीटर"];
    सूची तर्क = बुलाओ_निर्देश["संचालक"];

    // पास 1 — पूरा rename-नक्शा बनाओ (पैरामीटर + हर callee-आंतरिक id)
    शब्दकोश नक्शा = {};
    संख्या प = ०;
    यावत् (प < लंबाई(पैरा)) {
        नक्शा[पैरा[प]["आईडी"]] = तर्क[प];
        प = प + १;
    }
    सूची निस = खंड["निर्देश"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(निस)) {
        संख्या आईडी = निस[इ]["आईडी"];
        यदि (आईडी >= १) { नक्शा[आईडी] = मध्यम_ताजा_आईडी(कॉलर); }
        इ = इ + १;
    }

    // पास 2 — हर निर्देश क्लोन करो, संचालक अनुवाद करके
    सूची क्लोन = [];
    इ = ०;
    यावत् (इ < लंबाई(निस)) {
        शब्दकोश मूल = निस[इ];
        संख्या नया_आईडी = ० - १;
        यदि (मूल["आईडी"] >= १) { नया_आईडी = नक्शा[मूल["आईडी"]]; }
        सूची नये_संचालक = अवे_संचालक_अनुवाद(मूल["संचालक"], नक्शा);
        शब्दकोश नया = मध्यम_निर्देश_बनाओ(मूल["कोड"], नया_आईडी, मूल["प्रकार"],
                                          नये_संचालक, अवे_अंश_प्रति(मूल["अंश"]));
        क्लोन = जोड़ें(क्लोन, नया);
        इ = इ + १;
    }

    // वापसी-मान अनुवाद करो (-1 = कोई वापसी-मान नहीं, void)
    सूची वा_संच = खंड["अंत"]["संचालक"];
    संख्या वापसी_मान = ० - १;
    यदि (लंबाई(वा_संच) > ०) {
        संख्या मूल_वा = वा_संच[०];
        यदि (मूल_वा >= १ && नक्शा[मूल_वा] != शून्यम्) { वापसी_मान = नक्शा[मूल_वा]; }
        अन्यथा { वापसी_मान = मूल_वा; }
    }

    शब्दकोश परिणाम = {};
    परिणाम["निर्देश"] = क्लोन;
    परिणाम["वापसी_मान"] = वापसी_मान;
    परत् परिणाम;
}

// एक खंड की निर्देश-सूची में जितनी भी योग्य बुलाओ मिलें, splice करो।
// लौटाता है सत्य अगर कोई बदलाव हुआ।
कार्य अवे_खंड_प्रोसेस(शब्दकोश कॉलर, शब्दकोश खंड, शब्दकोश फलन_नक्शा) {
    सूची पुरानी = खंड["निर्देश"];
    सूची नयी = [];
    मान बदला = असत्य;
    संख्या इ = ०;
    यावत् (इ < लंबाई(पुरानी)) {
        शब्दकोश निर्देश = पुरानी[इ];
        मान किया = असत्य;
        यदि (निर्देश["कोड"] == "बुलाओ") {
            मान कैली = फलन_नक्शा[निर्देश["अंश"]["लक्ष्य"]];
            यदि (कैली != शून्यम् && अवे_योग्य_फलन(कॉलर, कैली)) {
                शब्दकोश प = अवे_क्लोन_करो(कॉलर, कैली, निर्देश);
                सूची क्लोन = प["निर्देश"];
                संख्या सि = ०;
                यावत् (सि < लंबाई(क्लोन)) {
                    नयी = जोड़ें(नयी, क्लोन[सि]);
                    सि = सि + १;
                }
                यदि (निर्देश["आईडी"] >= १ && प["वापसी_मान"] >= १) {
                    अनु_हर_उपयोग_बदलो(कॉलर, निर्देश["आईडी"], प["वापसी_मान"]);
                }
                किया = सत्य;
                बदला = सत्य;
            }
        }
        यदि (न किया) { नयी = जोड़ें(नयी, निर्देश); }
        इ = इ + १;
    }
    खंड["निर्देश"] = नयी;
    परत् बदला;
}

कार्य अंतर्वेशन_फलन(शब्दकोश फलन, शब्दकोश फलन_नक्शा) {
    संख्या दौर = ०;
    मान कोई_बदला = असत्य;
    मान बदला = सत्य;
    यावत् (बदला && दौर < ५) {
        बदला = असत्य;
        सूची खस = फलन["खंड_सूची"];
        संख्या ख = ०;
        यावत् (ख < लंबाई(खस)) {
            यदि (अवे_खंड_प्रोसेस(फलन, खस[ख], फलन_नक्शा)) { बदला = सत्य; }
            ख = ख + १;
        }
        यदि (बदला) { कोई_बदला = सत्य; }
        दौर = दौर + १;
    }
    परत् कोई_बदला;
}

// splice के बाद हल्की सफाई — पूरा अनुकूलक_कार्य नहीं (वो स्लॉट_उन्नयन/mem2reg
// भी दोबारा चलाता, जो पहले से SSA कोड पर बेकार, हर पूर्ण RPO+predecessor
// scan खर्च करके कुछ नहीं करता)। सिर्फ़ const-fold/jump-thread/DCE दोहराओ
// ताकि splice किए गए constant arguments आगे fold हो सकें।
कार्य अवे_हल्की_सफाई(शब्दकोश फलन) {
    संख्या दौर = ०;
    यावत् (दौर < ५) {
        स्थिर_तह(फलन);
        जाओ_सरल(फलन);
        मृत_कोड_हटाओ(फलन);
        दौर = दौर + १;
    }
    परत् ०;
}

कार्य अंतर्वेशन_एकक(शब्दकोश एकक) {
    शब्दकोश फलन_नक्शा = कग_फलन_नक्शा(एकक);
    सूची कस = एकक["कार्य_सूची"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कस)) {
        शब्दकोश फलन = कस[इ];
        यदि (अंतर्वेशन_फलन(फलन, फलन_नक्शा)) {
            अवे_हल्की_सफाई(फलन);
        }
        इ = इ + १;
    }
    परत् एकक;
}
