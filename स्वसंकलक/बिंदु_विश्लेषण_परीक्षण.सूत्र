// बिंदु_विश्लेषण_परीक्षण.सूत्र — points-to विश्लेषण (Milestone १) का test
// हाथ से बना IR (मध्यम_* builders) — असली parser पर निर्भर नहीं, ताकि
// alias-तर्क सीधे, नियंत्रित परिदृश्यों पर सटीक जाँचा जा सके।

आयात "मध्यम.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";

मान विफल = ०;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + १; }
}

कार्य मुख्य() {
    // १. दो स्वतंत्र आवंटन — कभी alias नहीं होने चाहिए
    शब्दकोश फ1 = मध्यम_नव_कार्य("अ1", "मान");
    शब्दकोश ब1 = मध्यम_नव_खंड(फ1, "प्रवेश");
    संख्या स1अ = मध्यम_जोड़(फ1, ब1, "नव_सूची", "सूची", [], {});
    संख्या स1ब = मध्यम_जोड़(फ1, ब1, "नव_सूची", "सूची", [], {});
    मध्यम_वापस(ब1, स1अ);
    शब्दकोश वि1 = बिं_फलन_विश्लेषण(फ1);
    जाँच("1 दो स्वतंत्र आवंटन कभी alias नहीं", न बिं_उपनाम_हो_सकता(वि1, स1अ, स1ब));
    जाँच("1 खुद से alias", बिं_उपनाम_हो_सकता(वि1, स1अ, स1अ));

    // २. phi दो आवंटन मिलाता — मिला मान दोनों से alias, पर वो दोनों आपस में नहीं
    शब्दकोश फ2 = मध्यम_नव_कार्य("अ2", "मान");
    शब्दकोश ब2शर्त = मध्यम_नव_खंड(फ2, "शर्त");
    शब्दकोश ब2अ = मध्यम_नव_खंड(फ2, "शाखा_अ");
    शब्दकोश ब2ब = मध्यम_नव_खंड(फ2, "शाखा_ब");
    शब्दकोश ब2अंत = मध्यम_नव_खंड(फ2, "अंत");
    संख्या पैरा2 = मध्यम_पैरामीटर(फ2, "श", "बूल");
    मध्यम_यदि_जाओ(ब2शर्त, पैरा2, ब2अ["लेबल"], ब2ब["लेबल"]);
    संख्या स2अ = मध्यम_जोड़(फ2, ब2अ, "नव_सूची", "सूची", [], {});
    मध्यम_जाओ(ब2अ, ब2अंत["लेबल"]);
    संख्या स2ब = मध्यम_जोड़(फ2, ब2ब, "नव_सूची", "सूची", [], {});
    मध्यम_जाओ(ब2ब, ब2अंत["लेबल"]);
    संख्या फी2 = मध्यम_फाई(फ2, ब2अंत, "सूची", [[ब2अ["लेबल"], स2अ], [ब2ब["लेबल"], स2ब]]);
    मध्यम_वापस(ब2अंत, फी2);
    शब्दकोश वि2 = बिं_फलन_विश्लेषण(फ2);
    जाँच("2 फाई दोनों स्रोतों से alias (अ)", बिं_उपनाम_हो_सकता(वि2, फी2, स2अ));
    जाँच("2 फाई दोनों स्रोतों से alias (ब)", बिं_उपनाम_हो_सकता(वि2, फी2, स2ब));
    जाँच("2 मूल दो आवंटन आपस में अभी भी अलग", न बिं_उपनाम_हो_सकता(वि2, स2अ, स2ब));

    // ३. store फिर read — पढ़ा मान वही होना चाहिए जो store हुआ
    शब्दकोश फ3 = मध्यम_नव_कार्य("अ3", "मान");
    शब्दकोश ब3 = मध्यम_नव_खंड(फ3, "प्रवेश");
    संख्या कंट3 = मध्यम_जोड़(फ3, ब3, "नव_सूची", "सूची", [], {});      // कंटेनर
    संख्या मान3 = मध्यम_जोड़(फ3, ब3, "नव_सूची", "सूची", [], {});      // भीतर रखा जाने वाला
    संख्या अन्य3 = मध्यम_जोड़(फ3, ब3, "नव_सूची", "सूची", [], {});     // असंबंधित तीसरा
    शब्दकोश सूचकांक0 = {};
    सूचकांक0["मान_प्रकार"] = "पूर्ण"; सूचकांक0["मान"] = ०;
    संख्या सू3 = मध्यम_जोड़(फ3, ब3, "स्थिर", "पूर्ण", [], सूचकांक0);
    मध्यम_जोड़_प्रभाव(ब3, "लिख_अनुक्रम", [कंट3, सू3, मान3], {});
    संख्या पढ़ा3 = मध्यम_जोड़(फ3, ब3, "पढ़_अनुक्रम", "मान", [कंट3, सू3], {});
    मध्यम_वापस(ब3, पढ़ा3);
    शब्दकोश वि3 = बिं_फलन_विश्लेषण(फ3);
    जाँच("3 store के बाद read उसी मान से alias", बिं_उपनाम_हो_सकता(वि3, पढ़ा3, मान3));
    जाँच("3 असंबंधित तीसरे से alias नहीं", न बिं_उपनाम_हो_सकता(वि3, पढ़ा3, अन्य3));
    जाँच("3 कंटेनर खुद उस मान से अलग", न बिं_उपनाम_हो_सकता(वि3, कंट3, मान3));

    // ४. पैरामीटर = ⊤ — हर चीज़ से alias मान लेना चाहिए (रूढ़िवादी)
    शब्दकोश फ4 = मध्यम_नव_कार्य("अ4", "मान");
    शब्दकोश ब4 = मध्यम_नव_खंड(फ4, "प्रवेश");
    संख्या पैरा4 = मध्यम_पैरामीटर(फ4, "प", "मान");
    संख्या स्थानीय4 = मध्यम_जोड़(फ4, ब4, "नव_सूची", "सूची", [], {});
    मध्यम_वापस(ब4, पैरा4);
    शब्दकोश वि4 = बिं_फलन_विश्लेषण(फ4);
    जाँच("4 पैरामीटर स्थानीय आवंटन से भी alias (रूढ़िवादी ⊤)",
        बिं_उपनाम_हो_सकता(वि4, पैरा4, स्थानीय4));

    // ५. कॉल-नतीजा = ⊤ (Milestone १ अभी interprocedural नहीं)
    शब्दकोश फ5 = मध्यम_नव_कार्य("अ5", "मान");
    शब्दकोश ब5 = मध्यम_नव_खंड(फ5, "प्रवेश");
    संख्या स्थानीय5 = मध्यम_जोड़(फ5, ब5, "नव_सूची", "सूची", [], {});
    संख्या कॉल5 = मध्यम_बुलाओ(फ5, ब5, "कोई_फलन", "मान", []);
    मध्यम_वापस(ब5, कॉल5);
    शब्दकोश वि5 = बिं_फलन_विश्लेषण(फ5);
    जाँच("5 कॉल-नतीजा ⊤ — स्थानीय आवंटन से alias मान लिया",
        बिं_उपनाम_हो_सकता(वि5, कॉल5, स्थानीय5));

    // ६. Milestone २ — interprocedural परिशुद्धता। पास(क) सिर्फ़ अपना
    // तर्क लौटाता — कॉल-नतीजे को उस तर्क से alias दिखना चाहिए, पर एक
    // असंबंधित आवंटन से नहीं (Milestone १ में ⊤ की वजह से दोनों "alias"
    // दिखते — यही असल फ़र्क है)।
    शब्दकोश एकक6 = मध्यम_नव_एकक();
    शब्दकोश पास_फलन = मध्यम_नव_कार्य("पास", "मान");
    शब्दकोश पास_ब = मध्यम_नव_खंड(पास_फलन, "प्रवेश");
    संख्या पास_पैरा = मध्यम_पैरामीटर(पास_फलन, "क", "मान");
    मध्यम_वापस(पास_ब, पास_पैरा);
    एकक6["कार्य_सूची"] = जोड़ें(एकक6["कार्य_सूची"], पास_फलन);

    शब्दकोश मुख्य3_फलन = मध्यम_नव_कार्य("मुख्य3", "मान");
    शब्दकोश मुख्य3_ब = मध्यम_नव_खंड(मुख्य3_फलन, "प्रवेश");
    संख्या व1 = मध्यम_जोड़(मुख्य3_फलन, मुख्य3_ब, "नव_सूची", "सूची", [], {});
    संख्या व2 = मध्यम_बुलाओ(मुख्य3_फलन, मुख्य3_ब, "पास", "मान", [व1]);
    संख्या व3 = मध्यम_जोड़(मुख्य3_फलन, मुख्य3_ब, "नव_सूची", "सूची", [], {});
    मध्यम_वापस(मुख्य3_ब, व2);
    एकक6["कार्य_सूची"] = जोड़ें(एकक6["कार्य_सूची"], मुख्य3_फलन);

    शब्दकोश विसब6 = कग_मॉड्यूल_विश्लेषण(एकक6);
    शब्दकोश वि6 = विसब6["मुख्य3"];
    जाँच("6 कॉल-नतीजा असली argument से alias (interprocedural)",
        बिं_उपनाम_हो_सकता(वि6, व2, व1));
    जाँच("6 कॉल-नतीजा असंबंधित आवंटन से alias नहीं (परिशुद्धता)",
        न बिं_उपनाम_हो_सकता(वि6, व2, व3));

    // ७. स्व-पुनरावर्ती फलन — fixpoint बिना क्रैश/अनंत-लूप के रुकना चाहिए
    शब्दकोश एकक7 = मध्यम_नव_एकक();
    शब्दकोश स्वयं_फलन = मध्यम_नव_कार्य("स्वयं", "मान");
    शब्दकोश स्वयं_ब = मध्यम_नव_खंड(स्वयं_फलन, "प्रवेश");
    संख्या स्वयं_पैरा = मध्यम_पैरामीटर(स्वयं_फलन, "क", "मान");
    संख्या स्वयं_कॉल = मध्यम_बुलाओ(स्वयं_फलन, स्वयं_ब, "स्वयं", "मान", [स्वयं_पैरा]);
    मध्यम_वापस(स्वयं_ब, स्वयं_कॉल);
    एकक7["कार्य_सूची"] = जोड़ें(एकक7["कार्य_सूची"], स्वयं_फलन);
    शब्दकोश वि7 = कग_मॉड्यूल_विश्लेषण(एकक7);
    जाँच("7 स्व-पुनरावर्ती फलन बिना क्रैश/अनंत-लूप के विश्लेषित", वि7["स्वयं"] != शून्यम्);

    // ८. कई कॉलर, एक ही फलन — context-insensitive (सब call-site मिलकर
    // एक साझा पैरामीटर-सेट बनाते)। यह सटीकता की एक जानी-मानी सीमा है:
    // r1 = पास2(v1) फिर भी v2 से भी "alias" दिखेगा (चूँकि पास2 का
    // पैरामीटर संदर्भ-असंवेदनशील रूप से {v1,v2} दोनों मान लिया) — सुरक्षित
    // (over-approximation) पर maximally सटीक नहीं। Milestone २ का जाना
    // हुआ trade-off, बग नहीं।
    शब्दकोश एकक8 = मध्यम_नव_एकक();
    शब्दकोश पास2_फलन = मध्यम_नव_कार्य("पास2", "मान");
    शब्दकोश पास2_ब = मध्यम_नव_खंड(पास2_फलन, "प्रवेश");
    संख्या पास2_पैरा = मध्यम_पैरामीटर(पास2_फलन, "क", "मान");
    मध्यम_वापस(पास2_ब, पास2_पैरा);
    एकक8["कार्य_सूची"] = जोड़ें(एकक8["कार्य_सूची"], पास2_फलन);

    शब्दकोश मुख्य4_फलन = मध्यम_नव_कार्य("मुख्य4", "मान");
    शब्दकोश मुख्य4_ब = मध्यम_नव_खंड(मुख्य4_फलन, "प्रवेश");
    संख्या व1_8 = मध्यम_जोड़(मुख्य4_फलन, मुख्य4_ब, "नव_सूची", "सूची", [], {});
    संख्या व2_8 = मध्यम_जोड़(मुख्य4_फलन, मुख्य4_ब, "नव_सूची", "सूची", [], {});
    संख्या र1 = मध्यम_बुलाओ(मुख्य4_फलन, मुख्य4_ब, "पास2", "मान", [व1_8]);
    संख्या र2 = मध्यम_बुलाओ(मुख्य4_फलन, मुख्य4_ब, "पास2", "मान", [व2_8]);
    मध्यम_वापस(मुख्य4_ब, र1);
    एकक8["कार्य_सूची"] = जोड़ें(एकक8["कार्य_सूची"], मुख्य4_फलन);

    शब्दकोश विसब8 = कग_मॉड्यूल_विश्लेषण(एकक8);
    शब्दकोश वि8 = विसब8["मुख्य4"];
    जाँच("8 कई कॉलर मिलकर — नतीजा पहले तर्क से alias",
        बिं_उपनाम_हो_सकता(वि8, र1, व1_8));
    जाँच("8 कई कॉलर मिलकर — context-insensitive तो दूसरे कॉलर के तर्क से भी",
        बिं_उपनाम_हो_सकता(वि8, र1, व2_8));
    जाँच("8 पर दो मूल आवंटन खुद अभी भी अलग",
        न बिं_उपनाम_हो_सकता(वि8, व1_8, व2_8));

    // ९. Milestone ३ — सूची_जोड़ (library, हाथ-वर्गीकृत): तर्क1 तर्क0 के
    // भंडार में जाता; नतीजा तर्क0 का उपनाम है। बिना किसी संदर्भ के भी काम
    // करना चाहिए (library-तालिका संदर्भ-स्वतंत्र है — Milestone १-शैली भी)।
    शब्दकोश फ9 = मध्यम_नव_कार्य("अ9", "मान");
    शब्दकोश ब9 = मध्यम_नव_खंड(फ9, "प्रवेश");
    संख्या सर9 = मध्यम_जोड़(फ9, ब9, "नव_सूची", "सूची", [], {});
    संख्या मूल्य9 = मध्यम_जोड़(फ9, ब9, "नव_सूची", "सूची", [], {});
    संख्या नतीजा9 = मध्यम_बुलाओ(फ9, ब9, "सूची_जोड़", "मान", [सर9, मूल्य9]);
    शब्दकोश सूचकांक0_9 = {}; सूचकांक0_9["मान_प्रकार"] = "पूर्ण"; सूचकांक0_9["मान"] = ०;
    संख्या सू9 = मध्यम_जोड़(फ9, ब9, "स्थिर", "पूर्ण", [], सूचकांक0_9);
    संख्या पढ़ा9 = मध्यम_बुलाओ(फ9, ब9, "सूची_सूचकांक", "मान", [नतीजा9, सू9]);
    मध्यम_वापस(ब9, नतीजा9);
    शब्दकोश वि9 = बिं_फलन_विश्लेषण(फ9);
    जाँच("9 सूची_जोड़ नतीजा तर्क0 का उपनाम", बिं_उपनाम_हो_सकता(वि9, नतीजा9, सर9));
    जाँच("9 सूची_जोड़ नतीजा स्वयं मूल्य नहीं", न बिं_उपनाम_हो_सकता(वि9, नतीजा9, मूल्य9));
    जाँच("9 बाद में पढ़ा मान वही जो जोड़ा गया", बिं_उपनाम_हो_सकता(वि9, पढ़ा9, मूल्य9));

    // १०. Milestone ३ — पाठ_जोड़: दोनों तर्कों से असंबद्ध, हमेशा ताज़ा
    शब्दकोश फ10 = मध्यम_नव_कार्य("अ10", "मान");
    शब्दकोश ब10 = मध्यम_नव_खंड(फ10, "प्रवेश");
    संख्या अ10 = मध्यम_जोड़(फ10, ब10, "नव_सूची", "सूची", [], {});
    संख्या ब10ब = मध्यम_जोड़(फ10, ब10, "नव_सूची", "सूची", [], {});
