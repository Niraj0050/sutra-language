// बिंदु_विश्लेषण_परीक्षण.सूत्र — points-to विश्लेषण (Milestone 1) का test
// हाथ से बना IR (मध्यम_* builders) — असली parser पर निर्भर नहीं, ताकि
// alias-तर्क सीधे, नियंत्रित परिदृश्यों पर सटीक जाँचा जा सके।

आयात "मध्यम.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";

मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}

कार्य मुख्य() {
    // 1. दो स्वतंत्र आवंटन — कभी alias नहीं होने चाहिए
    शब्दकोश फ1 = मध्यम_नव_कार्य("अ1", "मान");
    शब्दकोश ब1 = मध्यम_नव_खंड(फ1, "प्रवेश");
    संख्या स1अ = मध्यम_जोड़(फ1, ब1, "नव_सूची", "सूची", [], {});
    संख्या स1ब = मध्यम_जोड़(फ1, ब1, "नव_सूची", "सूची", [], {});
    मध्यम_वापस(ब1, स1अ);
    शब्दकोश वि1 = बिं_फलन_विश्लेषण(फ1);
    जाँच("1 दो स्वतंत्र आवंटन कभी alias नहीं", न बिं_उपनाम_हो_सकता(वि1, स1अ, स1ब));
    जाँच("1 खुद से alias", बिं_उपनाम_हो_सकता(वि1, स1अ, स1अ));

    // 2. phi दो आवंटन मिलाता — मिला मान दोनों से alias, पर वो दोनों आपस में नहीं
    शब्दकोश फ2 = मध्यम_नव_कार्य("अ2", "मान");
    शब्दकोश ब2शर्त = मध्यम_नव_खंड(फ2, "शर्त");
    शब्दकोश ब2अ = मध्यम_नव_खंड(फ2, "शाखा_अ");
    शब्दकोश ब2ब = मध्यम_नव_खंड(फ2, "शाखा_ब");
    शब्दकोश ब2अंत = मध्यम_नव_खंड(फ2, "अंत");
    संख्या पैरा2 = मध्यम_पैरामीटर(फ2, "श", "बूल");
    मध्यम_यदि_जाओ(ब2शर्त, पैरा2, ब2अ["लेबल"], ब2ब["लेबल"]);
    संख्या स2अ = मध्यम_जोड़(फ2, ब2अ, "नव_सूची", "सूची", [], {});
    मध्यम_जाओ(ब2अ, ब2अंत["लेबल"]);
    संख्या स2ब = मध्यम_जोड़(फ2, ब2ब, "नव_सूची", "सूची", [], {});
    मध्यम_जाओ(ब2ब, ब2अंत["लेबल"]);
    संख्या फी2 = मध्यम_फाई(फ2, ब2अंत, "सूची", [[ब2अ["लेबल"], स2अ], [ब2ब["लेबल"], स2ब]]);
    मध्यम_वापस(ब2अंत, फी2);
    शब्दकोश वि2 = बिं_फलन_विश्लेषण(फ2);
    जाँच("2 फाई दोनों स्रोतों से alias (अ)", बिं_उपनाम_हो_सकता(वि2, फी2, स2अ));
    जाँच("2 फाई दोनों स्रोतों से alias (ब)", बिं_उपनाम_हो_सकता(वि2, फी2, स2ब));
    जाँच("2 मूल दो आवंटन आपस में अभी भी अलग", न बिं_उपनाम_हो_सकता(वि2, स2अ, स2ब));

    // 3. store फिर read — पढ़ा मान वही होना चाहिए जो store हुआ
    शब्दकोश फ3 = मध्यम_नव_कार्य("अ3", "मान");
    शब्दकोश ब3 = मध्यम_नव_खंड(फ3, "प्रवेश");
    संख्या कंट3 = मध्यम_जोड़(फ3, ब3, "नव_सूची", "सूची", [], {});      // कंटेनर
    संख्या मान3 = मध्यम_जोड़(फ3, ब3, "नव_सूची", "सूची", [], {});      // भीतर रखा जाने वाला
    संख्या अन्य3 = मध्यम_जोड़(फ3, ब3, "नव_सूची", "सूची", [], {});     // असंबंधित तीसरा
    शब्दकोश सूचकांक0 = {};
    सूचकांक0["मान_प्रकार"] = "पूर्ण"; सूचकांक0["मान"] = 0;
    संख्या सू3 = मध्यम_जोड़(फ3, ब3, "स्थिर", "पूर्ण", [], सूचकांक0);
    मध्यम_जोड़_प्रभाव(ब3, "लिख_अनुक्रम", [कंट3, सू3, मान3], {});
    संख्या पढ़ा3 = मध्यम_जोड़(फ3, ब3, "पढ़_अनुक्रम", "मान", [कंट3, सू3], {});
    मध्यम_वापस(ब3, पढ़ा3);
    शब्दकोश वि3 = बिं_फलन_विश्लेषण(फ3);
    जाँच("3 store के बाद read उसी मान से alias", बिं_उपनाम_हो_सकता(वि3, पढ़ा3, मान3));
    जाँच("3 असंबंधित तीसरे से alias नहीं", न बिं_उपनाम_हो_सकता(वि3, पढ़ा3, अन्य3));
    जाँच("3 कंटेनर खुद उस मान से अलग", न बिं_उपनाम_हो_सकता(वि3, कंट3, मान3));

    // 4. पैरामीटर = ⊤ — हर चीज़ से alias मान लेना चाहिए (रूढ़िवादी)
    शब्दकोश फ4 = मध्यम_नव_कार्य("अ4", "मान");
    शब्दकोश ब4 = मध्यम_नव_खंड(फ4, "प्रवेश");
    संख्या पैरा4 = मध्यम_पैरामीटर(फ4, "प", "मान");
    संख्या स्थानीय4 = मध्यम_जोड़(फ4, ब4, "नव_सूची", "सूची", [], {});
    मध्यम_वापस(ब4, पैरा4);
    शब्दकोश वि4 = बिं_फलन_विश्लेषण(फ4);
    जाँच("4 पैरामीटर स्थानीय आवंटन से भी alias (रूढ़िवादी ⊤)",
        बिं_उपनाम_हो_सकता(वि4, पैरा4, स्थानीय4));

    // 5. कॉल-नतीजा = ⊤ (Milestone 1 अभी interprocedural नहीं)
    शब्दकोश फ5 = मध्यम_नव_कार्य("अ5", "मान");
    शब्दकोश ब5 = मध्यम_नव_खंड(फ5, "प्रवेश");
    संख्या स्थानीय5 = मध्यम_जोड़(फ5, ब5, "नव_सूची", "सूची", [], {});
    संख्या कॉल5 = मध्यम_बुलाओ(फ5, ब5, "कोई_फलन", "मान", []);
    मध्यम_वापस(ब5, कॉल5);
    शब्दकोश वि5 = बिं_फलन_विश्लेषण(फ5);
    जाँच("5 कॉल-नतीजा ⊤ — स्थानीय आवंटन से alias मान लिया",
        बिं_उपनाम_हो_सकता(वि5, कॉल5, स्थानीय5));

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
