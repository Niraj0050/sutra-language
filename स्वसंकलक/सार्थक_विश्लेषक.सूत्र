        } अन्यथा यदि (बुल्टिन[सूचक] == "सञ्चिका_लिखतु" || बुल्टिन[सूचक] == "घात" || बुल्टिन[सूचक] == "न्यूनतम" || बुल्टिन[सूचक] == "अधिकतम" || बुल्टिन[सूचक] == "जोड़ें" || बुल्टिन[सूचक] == "हटाएं" || बुल्टिन[सूचक] == "मिलाएं" || बुल्टिन[सूचक] == "कुंजी_है" || बुल्टिन[सूचक] == "खोजें" || बुल्टिन[सूचक] == "विभाजित" || बुल्टिन[सूचक] == "संयोजित" || बुल्टिन[सूचक] == "आरंभिक" || बुल्टिन[सूचक] == "अंतिम" || बुल्टिन[सूचक] == "अंतर्_पढ़8" || बुल्टिन[सूचक] == "अंतर्_पढ़1" || बुल्टिन[सूचक] == "सूत्र_आवंटन" || बुल्टिन[सूचक] == "सूत्र_पुनः_आवंटन" || बुल्टिन[सूचक] == "सूत्र_दीर्घकूद" || बुल्टिन[सूचक] == "सूत्र_तल_समादेश_विभाजन" || बुल्टिन[सूचक] == "सूत्र_तल_त्रुटि" || बुल्टिन[सूचक] == "बिट_और" || बुल्टिन[सूचक] == "बिट_या" || बुल्टिन[सूचक] == "बिट_भेद" || बुल्टिन[सूचक] == "बाम_सरक" || बुल्टिन[सूचक] == "दक्षिण_सरक" || बुल्टिन[सूचक] == "निर्माता_जोड़" || बुल्टिन[सूचक] == "निर्माता_अक्षर") {
            त_संख्या = 2;
        } अन्यथा यदि (बुल्टिन[सूचक] == "डालें" || बुल्टिन[सूचक] == "उपखंड" || बुल्टिन[सूचक] == "पाठ_उपखंड_बाइट" || बुल्टिन[सूचक] == "बदलें" || बुल्टिन[सूचक] == "अंतर्_लिख8" || बुल्टिन[सूचक] == "अंतर्_लिख1" || बुल्टिन[सूचक] == "अंतर्_मुद्रण" || बुल्टिन[सूचक] == "सूत्र_तल_यूटीएफ_चौड़ा" || बुल्टिन[सूचक] == "सूत्र_तल_चौड़ा_यूटीएफ" || बुल्टिन[सूचक] == "सूत्र_तल_पढ़ो" || बुल्टिन[सूचक] == "सूत्र_तल_लिखो") {
            त_संख्या = 3;
        }
        प्रतीक["नाम"] = बुल्टिन[सूचक];
        प्रतीक["पैरामीटर_संख्या"] =  त_संख्या;
        प्रतीक["परत्_प्रकार"] = "अजनक";
        प्रतीक["अंतर्निहित"] = सत्य;   // उपयोगकर्ता-कार्य इसे override कर सकता है
        संदर्भ["कार्य_तालिका"][बुल्टिन[सूचक]] = प्रतीक;
        सूचक = सूचक + 1;
    }
}

कार्य मूल_सार्थक_विश्लेषण(शब्दकोश प्रोग्राम) {
    यदि (प्रोग्राम == शून्यम् || प्रोग्राम["नोड_प्रकारः"] != "प्रोग्राम") {
        परत्;
    }
    
    शब्दकोश संदर्भ = {};
    संदर्भ["कार्य_तालिका"] = {};
    संदर्भ["वर्ग_तालिका"] = {};
    संदर्भ["कार्यक्षेत्र_ढेर"] = [{}]; // global scope
    संदर्भ["चक्र_गहनता"] = 0;
    
    सार्थक_पंजीकरण_बिल्टिन(संदर्भ);
    
    // 1. सभी वर्ग और कार्यों को वैश्विक तालिका में पंजीकृत करें
    सूची वर्ग_सूची = प्रोग्राम["वर्ग_सूची"];
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(वर्ग_सूची)) {
        शब्दकोश वर्ग_नोड = वर्ग_सूची[सूचक];
        पाठ वर्ग_नाम = वर्ग_नोड["नाम"];
        यदि (संदर्भ["वर्ग_तालिका"][वर्ग_नाम] != शून्यम्) {
            सार्थक_त्रुटि("'" + वर्ग_नाम + "' नामकः वर्गः पूर्वमेव परिभाषितः अस्ति।", वर्ग_नोड["पङ्क्ति"], वर्ग_नोड["स्तम्भ"]);
        }
        संदर्भ["वर्ग_तालिका"][वर्ग_नाम] = वर्ग_नोड;
        सूचक = सूचक + 1;
    }
    
    सूची कार्य_सूची = प्रोग्राम["कार्य_सूची"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        शब्दकोश कार्य_नोड = कार्य_सूची[सूचक];
        पाठ कार्य_नाम = कार्य_नोड["नाम"];
        मान मौजूदा = संदर्भ["कार्य_तालिका"][कार्य_नाम];
        यदि (मौजूदा != शून्यम्) {
            यदि (मौजूदा["अंतर्निहित"] != सत्य) {
                सार्थक_त्रुटि("'" + कार्य_नाम + "' नामकं कार्यं पूर्वमेव परिभाषितम् अस्ति।", कार्य_नोड["पङ्क्ति"], कार्य_नोड["स्तम्भ"]);
            }
        }
        शब्दकोश प्रतीक = {};
        प्रतीक["नाम"] = कार्य_नाम;
        प्रतीक["पैरामीटर_संख्या"] = लंबाई(कार्य_नोड["तर्काः"]);
        
        सूची तर्काः = कार्य_नोड["तर्काः"];
        सूची तर्क_प्रकारः = [];
        संख्या त_सूचक = 0;
        यावत् (त_सूचक < लंबाई(तर्काः)) {
            शब्दकोश तर्क = तर्काः[त_सूचक];
            तर्क_प्रकारः = जोड़ें(तर्क_प्रकारः, सार्थक_प्रकार_मैप(तर्क["प्रकार_नाम"]));
            त_सूचक = त_सूचक + 1;
        }
        प्रतीक["तर्क_प्रकारः"] = तर्क_प्रकारः;
        प्रतीक["परत्_प्रकार"] = "अजनक";
        संदर्भ["कार्य_तालिका"][कार्य_नाम] = प्रतीक;
        सूचक = सूचक + 1;
    }

    // 1b. विदेशी (FFI) घोषणाएँ — कार्य-तालिका में पंजीकृत करो
    सूची वि_कथन = प्रोग्राम["वैश्विक_कथन"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(वि_कथन)) {
        शब्दकोश वि_नोड = वि_कथन[सूचक];
        यदि (वि_नोड["नोड_प्रकारः"] == "कठन_विदेशी") {
            संख्या वि_गण = वि_नोड["तर्क_गण"];
            सूची वि_तप = [];
            संख्या वि_त = 0;
            यावत् (वि_त < वि_गण) { वि_तप = जोड़ें(वि_तप, "अजनक"); वि_त = वि_त + 1; }
            शब्दकोश वि_प्रतीक = {};
            वि_प्रतीक["नाम"] = वि_नोड["नाम"];
            वि_प्रतीक["पैरामीटर_संख्या"] = वि_गण;
            वि_प्रतीक["तर्क_प्रकारः"] = वि_तप;
            वि_प्रतीक["परत्_प्रकार"] = "संख्या";
            वि_प्रतीक["विदेशी"] = सत्य;
            संदर्भ["कार्य_तालिका"][वि_नोड["नाम"]] = वि_प्रतीक;
        }
        सूचक = सूचक + 1;
    }

    // 2. वैश्विक कथनों का विश्लेषण
    सूची वैश्विक_कथन = प्रोग्राम["वैश्विक_कथन"];
    सूचक = 0;
    यावत् (सूचक < लंबाई(वैश्विक_कथन)) {
        सार्थक_कथन_विश्लेषण(संदर्भ, वैश्विक_कथन[सूचक]);
        सूचक = सूचक + 1;
    }
    
    // 3. कार्यों का विश्लेषण
    सूचक = 0;
    यावत् (सूचक < लंबाई(कार्य_सूची)) {
        सार्थक_कार्य_विश्लेषण(संदर्भ, कार्य_सूची[सूचक]);
        सूचक = सूचक + 1;
    }
    
    // 4. वर्गों का विश्लेषण
    सूचक = 0;
    यावत् (सूचक < लंबाई(वर्ग_सूची)) {
        सार्थक_वर्ग_विश्लेषण(संदर्भ, वर्ग_सूची[सूचक]);
        सूचक = सूचक + 1;
    }
}
