// सार्थक_विश्लेषक.सूत्र — Standalone Semantic Analyzer for Sutra AST
// यह मॉड्यूल AST पर पूर्ण सार्थक विश्लेषण (Semantic Analysis) करता है।

कार्य सार्थक_त्रुटि(पाठ सन्देश, संख्या पङ्क्ति, संख्या स्तम्भ) {
    प्रक्षेपः "सार्थक_त्रुटि: " + सन्देश + " (पंक्ति: " + पङ्क्ति + ", स्तंभ: " + स्तम्भ + ")";
}

कार्य सार्थक_घोषणा_चर(शब्दकोश संदर्भ, पाठ नाम, पाठ प्रकार, संख्या पङ्क्ति, संख्या स्तम्भ) {
    यदि (संदर्भ["कार्यक्षेत्र_ढेर"] == शून्यम् || लंबाई(संदर्भ["कार्यक्षेत्र_ढेर"]) == 0) {
        मान नया_ढेर = [{}];
        संदर्भ["कार्यक्षेत्र_ढेर"] = नया_ढेर;
    }
    
    संख्या शीर्ष_सूचकांक = लंबाई(संदर्भ["कार्यक्षेत्र_ढेर"]) - 1;
    शब्दकोश वर्तमान_क्षेत्र = संदर्भ["कार्यक्षेत्र_ढेर"][शीर्ष_सूचकांक];
    
    यदि (वर्तमान_क्षेत्र[नाम] != शून्यम्) {
        सार्थक_त्रुटि("'" + नाम + "' नामकः चरः अस्मिन् कार्यक्षेत्रे पूर्वमेव परिभाषितः अस्ति।", पङ्क्ति, स्तम्भ);
    }
    
    वर्तमान_क्षेत्र[नाम] = प्रकार;
}

कार्य सार्थक_जाँच_चर_घोषित(शब्दकोश संदर्भ, पाठ नाम) {
    यदि (संदर्भ["कार्यक्षेत्र_ढेर"] == शून्यम्) {
        परत् असत्य;
    }
    
    संख्या सूचक = लंबाई(संदर्भ["कार्यक्षेत्र_ढेर"]) - 1;
    यावत् (सूचक >= 0) {
        शब्दकोश क्षेत्र = संदर्भ["कार्यक्षेत्र_ढेर"][सूचक];
        यदि (क्षेत्र[नाम] != शून्यम्) {
            परत् सत्य;
        }
        सूचक = सूचक - 1;
    }
    
    परत् असत्य;
}

कार्य सार्थक_प्राप्त_चर_प्रकार(शब्दकोश संदर्भ, पाठ नाम) {
    यदि (संदर्भ["कार्यक्षेत्र_ढेर"] == शून्यम्) {
        परत् "अज्ञात";
    }
    
    संख्या सूचक = लंबाई(संदर्भ["कार्यक्षेत्र_ढेर"]) - 1;
    यावत् (सूचक >= 0) {
        शब्दकोश क्षेत्र = संदर्भ["कार्यक्षेत्र_ढेर"][सूचक];
        यदि (क्षेत्र[नाम] != शून्यम्) {
            परत् क्षेत्र[नाम];
        }
        सूचक = सूचक - 1;
    }
    
    परत् "अज्ञात";
}

कार्य सार्थक_धकेलें_कार्यक्षेत्र(शब्दकोश संदर्भ) {
    यदि (संदर्भ["कार्यक्षेत्र_ढेर"] == शून्यम्) {
        संदर्भ["कार्यक्षेत्र_ढेर"] = [];
    }
    संदर्भ["कार्यक्षेत्र_ढेर"] = जोड़ें(संदर्भ["कार्यक्षेत्र_ढेर"], {});
}

कार्य सार्थक_हटाएं_कार्यक्षेत्र(शब्दकोश संदर्भ) {
    यदि (संदर्भ["कार्यक्षेत्र_ढेर"] != शून्यम् && लंबाई(संदर्भ["कार्यक्षेत्र_ढेर"]) > 0) {
        संदर्भ["कार्यक्षेत्र_ढेर"] = निकालें(संदर्भ["कार्यक्षेत्र_ढेर"]);
    }
}

कार्य सार्थक_प्रकार_मैप(पाठ प्रकार_नाम) {
    यदि (प्रकार_नाम == "मान" || प्रकार_नाम == "अजनक" || प्रकार_नाम == शून्यम् || प्रकार_नाम == "") {
        परत् "अजनक";
    }
    यदि (प्रकार_नाम == "पूर्णांक" || प्रकार_नाम == "संख्या") {
        परत् "संख्या";
    }
    यदि (प्रकार_नाम == "तर्क" || प्रकार_नाम == "बूल") {
        परत् "तर्क";
    }
    परत् प्रकार_नाम;
}

कार्य सार्थक_असाइन_करने_योग्य(पाठ लक्ष्य, पाठ स्रोत) {
    यदि (लक्ष्य == "अजनक" || स्रोत == "अजनक") {
        परत् सत्य;
    }
    यदि (लक्ष्य == स्रोत) {
        परत् सत्य;
    }
    यदि (स्रोत == "शून्यम्" || स्रोत == "रिक्त") {
        परत् सत्य;
    }
    यदि (लक्ष्य == "दशमलव" && (स्रोत == "संख्या")) {
        परत् सत्य;
    }
    परत् असत्य;
}

कार्य सार्थक_प्रकार_निर्धारण(शब्दकोश संदर्भ, शब्दकोश नोड) {
    यदि (नोड == शून्यम्) {
        परत् "रिक्त";
    }
    
    पाठ प्रकार = नोड["नोड_प्रकारः"];
    संख्या पङ्क्ति = नोड["पङ्क्ति"];
    संख्या स्तम्भ = नोड["स्तम्भ"];
    
    यदि (प्रकार == "अभिव्यक्ति_स्थिरांक") {
        पाठ स्थिर_प्रकार = नोड["स्थिरांक_प्रकारः"];
        यदि (स्थिर_प्रकार == "पूर्णाङ्क" || स्थिर_प्रकार == "बड़ा_पूर्णांक") {
            परत् "संख्या";
        } अन्यथा यदि (स्थिर_प्रकार == "दशमलव") {
            परत् "दशमलव";
        } अन्यथा यदि (स्थिर_प्रकार == "पाठ" || स्थिर_प्रकार == "वर्ण") {
            परत् "पाठ";
        } अन्यथा यदि (स्थिर_प्रकार == "बूल") {
            परत् "तर्क";
        } अन्यथा यदि (स्थिर_प्रकार == "शून्यम्") {
            परत् "शून्यम्";
        }
        परत् "अजनक";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_पहचान") {
        यदि (नोड["नाम"] == "स्व") {
            परत् "अजनक";
        }
        यदि (न सार्थक_जाँच_चर_घोषित(संदर्भ, नोड["नाम"])) {
            सार्थक_त्रुटि("'" + नोड["नाम"] + "' नामकः चरः अपरिभाषितः अस्ति।", पङ्क्ति, स्तम्भ);
        }
        परत् सार्थक_प्राप्त_चर_प्रकार(संदर्भ, नोड["नाम"]);
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_फलन_पता") {
        पाठ ल_नाम = नोड["लक्ष्य_नाम"];
        यदि (संदर्भ["कार्य_तालिका"][ल_नाम] == शून्यम्) {
            सार्थक_त्रुटि("'" + ल_नाम + "' नामकं कार्यं अपरिभाषितम् अस्ति। (फलन_पता)", पङ्क्ति, स्तम्भ);
        }
        परत् "संख्या";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_कॉल") {
        पाठ कार्य_नाम = नोड["नाम"];
        शब्दकोश कार्य_प्रतीक = संदर्भ["कार्य_तालिका"][कार्य_नाम];
        यदि (कार्य_प्रतीक == शून्यम्) {
            सार्थक_त्रुटि("'" + कार्य_नाम + "' नामकं कार्यं अपरिभाषितम् अस्ति।", पङ्क्ति, स्तम्भ);
        }
        
        सूची तर्काः = नोड["तर्काः"];
        यदि (लंबाई(तर्काः) != कार्य_प्रतीक["पैरामीटर_संख्या"]) {
            सार्थक_त्रुटि("'" + कार्य_नाम + "' कार्यस्य तर्क-सङ्ख्या अमान्या अस्ति।", पङ्क्ति, स्तम्भ);
        }
        
        यदि (कार्य_प्रतीक["तर्क_प्रकारः"] != शून्यम्) {
            सूची अपेक्षित_प्रकार_सूची = कार्य_प्रतीक["तर्क_प्रकारः"];
            संख्या सूचक = 0;
            यावत् (सूचक < लंबाई(तर्काः)) {
                पाठ अपेक्षित = अपेक्षित_प्रकार_सूची[सूचक];
                पाठ वास्तविक = सार्थक_प्रकार_निर्धारण(संदर्भ, तर्काः[सूचक]);
                यदि (अपेक्षित != "अजनक" && वास्तविक != "अजनक") {
                    यदि (न सार्थक_असाइन_करने_योग्य(अपेक्षित, वास्तविक)) {
                        सार्थक_त्रुटि("त्रुटि: '" + कार्य_नाम + "' कार्यस्य " + (सूचक + 1) + " तर्कस्य अपेक्षित प्रकार '" + अपेक्षित + "' है, लेकिन '" + वास्तविक + "' प्राप्त हुआ।", पङ्क्ति, स्तम्भ);
                    }
                }
                सूचक = सूचक + 1;
            }
        } अन्यथा {
            संख्या सूचक = 0;
            यावत् (सूचक < लंबाई(तर्काः)) {
                सार्थक_प्रकार_निर्धारण(संदर्भ, तर्काः[सूचक]);
                सूचक = सूचक + 1;
            }
        }
        
        यदि (कार्य_प्रतीक["परत्_प्रकार"] != शून्यम्) {
            परत् कार्य_प्रतीक["परत्_प्रकार"];
        }
        परत् "अजनक";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_द्विआधारी") {
        पाठ बायाँ = सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["वाम"]);
        पाठ दायाँ = सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["दक्षिण"]);
        पाठ ओप = नोड["सञ्चालक"];
        
        यदि (ओप == "धन (+)" && (बायाँ == "पाठ" || दायाँ == "पाठ")) {
            परत् "पाठ";
        }
        
        यदि (ओप == "तथा-संयोजक (&&)" || ओप == "मुख्यशब्द_तथा" || ओप == "अथवा-संयोजक (||)" || ओप == "मुख्यशब्द_अथवा") {
            यदि (बायाँ != "अजनक" && बायाँ != "तर्क") {
                सार्थक_त्रुटि("त्रुटि: तर्कसंक्रिया केवलं तार्किकमूल्येषु एव सम्भवति। (Logical operations only allowed for booleans)", पङ्क्ति, स्तम्भ);
            }
            यदि (दायाँ != "अजनक" && दायाँ != "तर्क") {
                सार्थक_त्रुटि("त्रुटि: तर्कसंक्रिया केवलं तार्किकमूल्येषु एव सम्भवति। (Logical operations only allowed for booleans)", पङ्क्ति, स्तम्भ);
            }
            परत् "तर्क";
        }
        
        यदि (ओप == "समानता (==)" || ओप == "असमानता (!=)" || ओप == "लघुतर (<)" || ओप == "गुरुतर (>)" || ओप == "लघुतर-समान (<=)" || ओप == "गुरुतर-समान (>=)") {
            परत् "तर्क";
        }
        
        यदि (ओप == "शेष (%)") {
            यदि (बायाँ == "दशमलव" || दायाँ == "दशमलव") {
                सार्थक_त्रुटि("त्रुटि: भागशेषसंक्रिया केवलं पूर्णांकयोः एव सम्भवति। (Modulo only allowed for integers)", पङ्क्ति, स्तम्भ);
            }
            परत् "संख्या";
        }
        
        यदि (ओप == "धन (+)" || ओप == "ऋण (-)" || ओप == "गुणा (*)" || ओप == "भाग (/)") {
            यदि (बायाँ != "अजनक" && दायाँ != "अजनक") {
                यदि (न (बायाँ == "संख्या" || बायाँ == "दशमलव") || न (दायाँ == "संख्या" || दायाँ == "दशमलव")) {
                    सार्थक_त्रुटि("त्रुटि: अङ्कगणितीयसंक्रिया केवलं सङ्ख्यासु एव सम्भवति। (Arithmetic operations only allowed for numbers)", पङ्क्ति, स्तम्भ);
                }
            }
            यदि (बायाँ == "दशमलव" || दायाँ == "दशमलव") {
                परत् "दशमलव";
            }
            परत् "संख्या";
        }
        
        परत् "संख्या";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_एकल") {
        पाठ ओप = नोड["सञ्चालक"];
        पाठ ओप_प्रकार = सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["संख्या"]);
        यदि (ओप == "निषेध (!)" || ओप == "मुख्यशब्द_न") {
            यदि (ओप_प्रकार != "अजनक" && ओप_प्रकार != "तर्क") {
                सार्थक_त्रुटि("त्रुटि: तर्कसंक्रिया केवलं तार्किकमूल्येषु एव सम्भवति। (Logical NOT only allowed for booleans)", पङ्क्ति, स्तम्भ);
            }
            परत् "तर्क";
        }
        यदि (ओप == "ऋण (-)") {
            यदि (ओप_प्रकार != "अजनक" && न (ओप_प्रकार == "संख्या" || ओप_प्रकार == "दशमलव")) {
                सार्थक_त्रुटि("त्रुटि: ऋणात्मकसंक्रिया केवलं सङ्ख्यासु एव सम्भवति। (Unary minus only allowed for numbers)", पङ्क्ति, स्तम्भ);
            }
            परत् ओप_प्रकार;
        }
        परत् ओप_प्रकार;
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_सूची_स्थिरांक") {
        सूची तत्व = नोड["तत्व"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तत्व)) {
            सार्थक_प्रकार_निर्धारण(संदर्भ, तत्व[सूचक]);
            सूचक = सूचक + 1;
        }
        परत् "सूची";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_अनुक्रमणिका") {
        सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["आधार"]);
        सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["अनुक्रमणिका"]);
        परत् "अजनक";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_सभ्य") {
        सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["वस्तु"]);
        परत् "अजनक";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_विधि_कॉल") {
        सार्थक_प्रकार_निर्धारण(संदर्भ, नोड["वस्तु"]);
        सूची तर्काः = नोड["तर्काः"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तर्काः)) {
            सार्थक_प्रकार_निर्धारण(संदर्भ, तर्काः[सूचक]);
            सूचक = सूचक + 1;
        }
        परत् "अजनक";
    } अन्यथा यदि (प्रकार == "अभिव्यक्ति_नवीन") {
        पाठ वर्ग_नाम = नोड["वर्ग_नाम"];
        यदि (संदर्भ["वर्ग_तालिका"][वर्ग_नाम] == शून्यम्) {
            सार्थक_त्रुटि("'" + वर्ग_नाम + "' नामकः वर्गः अपरिभाषितः अस्ति।", पङ्क्ति, स्तम्भ);
        }
        सूची तर्काः = नोड["तर्काः"];
        संख्या सूचक = 0;
        यावत् (सूचक < लंबाई(तर्काः)) {
            सार्थक_प्रकार_निर्धारण(संदर्भ, तर्काः[सूचक]);
            सूचक = सूचक + 1;
        }
        परत् वर्ग_नाम;
    }
    
    परत् "अजनक";
}

