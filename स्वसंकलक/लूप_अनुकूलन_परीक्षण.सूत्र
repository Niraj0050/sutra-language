// लूप_अनुकूलन_परीक्षण.सूत्र — LICM (Milestone 4 भाग B) का test
// असली parser → lower → अनुकूलक_एकक → लूप_अनुकूलक_एकक → IR डंप जाँचो।
// (बिंदु_विश्लेषण_परीक्षण.सूत्र की तरह hand-built IR नहीं — यहाँ असली
// parser इस्तेमाल किया ताकि phi/back-edge हाथ से सही बनाने का जोखिम न
// उठाना पड़े; अनुकूलक_परीक्षण.सूत्र का test 3/8 भी यही तरीका अपनाता है।)

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "लूप_अनुकूलन.सूत्र";

मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= 0; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}

// parse → lower → सामान्य अनुकूलक (mem2reg+const-fold+DCE) → LICM → छापो
कार्य पूर्ण_अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    लूप_अनुकूलक_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

// लूप-header ("  wh_शर्त...:" ब्लॉक-लेबल लाइन) से "  wh_देह...:" तक का
// पाठ-खंड निकालो — newline-prefixed पैटर्न से (सिर्फ़ block-लेबल लाइन,
// फाई/यदि_जाओ के अंदर inline mention से नहीं, जो लंबाई से पहले भी आ
// सकता — "इ < लंबाई(स)) {" वाले हैडर में phi का स्रोत खुद "wh_देह" नाम
// रखता, इसलिए naive खोजें बिना newline-prefix के गलत जगह कट जाता)
कार्य हैडर_खंड_पाठ(पाठ द) {
    पाठ नई_पंक्ति = अक्षर_निर्माण(10);
    संख्या श = खोजें(द, नई_पंक्ति + "  wh_शर्त");
    संख्या दे = खोजें(द, नई_पंक्ति + "  wh_देह");
    यदि (श < 0 || दे < 0 || दे <= श) { परत् ""; }
    परत् उपखंड(द, श, दे);
}

कार्य मुख्य() {
    // 1. मूल hoist — शर्त में लंबाई(पैरामीटर), लूप के अंदर कोई लेखन नहीं
    पाठ द1 = पूर्ण_अनुकूलित(
        "कार्य क1(सूची स) { संख्या इ = 0; यावत् (इ < लंबाई(स)) { इ = इ + 1; } परत् इ; }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 preheader बना", है(द1, "licm_ph"));
    जाँच("1 लंबाई अब भी मौजूद (हटा नहीं, खिसका)", है(द1, "= लंबाई"));
    जाँच("1 लंबाई हैडर से बाहर हो गया", न है(हैडर_खंड_पाठ(द1), "लंबाई"));

    // 2. नकारात्मक — लूप खुद उसी सूची में जोड़ता (लंबाई बदल सकती) → hoist नहीं
    पाठ द2 = पूर्ण_अनुकूलित(
        "कार्य क2(सूची स) { संख्या इ = 0; यावत् (इ < लंबाई(स)) { जोड़ें(स, इ); इ = इ + 1; } परत् इ; }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 वही सूची लिखी जाती — hoist नहीं", न है(द2, "licm_ph"));
    जाँच("2 लंबाई अब भी हैडर में", है(हैडर_खंड_पाठ(द2), "लंबाई"));

    // 3. परिशुद्धता — असंबद्ध दूसरी सूची (अलग call-site allocation) लिखी
    // जाती है; interprocedural points-to (M2) से असली caller के अलग-अलग
    // allocation-site पता चलते ही स्पष्ट होता कि दोनों अलग वस्तुएँ हैं —
    // §4g की "कोई भी कॉल = मत छुओ" वाली rule यहाँ ग़लत रूप से रोक देती।
    पाठ द3 = पूर्ण_अनुकूलित(
        "कार्य क3(सूची स, सूची अन्य) { संख्या इ = 0; यावत् (इ < लंबाई(स)) { जोड़ें(अन्य, इ); इ = इ + 1; } परत् इ; }" +
        " कार्य मुख्य3() { सूची अ = []; सूची ब = []; परत् क3(अ, ब); }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 असंबद्ध लेखन के बावजूद hoist हुआ (सटीकता)", है(द3, "licm_ph"));

    // 4. नकारात्मक — अपरिचित (library-तालिका में नहीं) कॉल → रूढ़िवादी ⊤,
    // hoist नहीं (§4g जैसा ही रूढ़िवादी परिणाम, पर अब सही कारण से — सिर्फ़
    // genuinely-अज्ञात कॉल पर, हर कॉल पर नहीं)
    पाठ द4 = पूर्ण_अनुकूलित(
        "कार्य क4(सूची स, सूची अन्य) { संख्या इ = 0; यावत् (इ < लंबाई(स)) { छाँटें(अन्य); इ = इ + 1; } परत् इ; }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 अपरिचित कॉल — hoist नहीं", न है(द4, "licm_ph"));

    // 5. नेस्टेड लूप — बाहरी लूप में hoist, भीतरी को न छेड़े
    पाठ द5 = पूर्ण_अनुकूलित(
        "कार्य क5(सूची स, सूची अन्य) { संख्या इ = 0; यावत् (इ < लंबाई(स)) { संख्या ज = 0; यावत् (ज < लंबाई(अन्य)) { ज = ज + 1; } इ = इ + 1; } परत् इ; }");
    लिखतु("--- 5 ---"); लिखतु(द5);
    जाँच("5 नेस्टेड लूप में भी hoist हुआ", है(द5, "licm_ph"));

    लिखतु("");
    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
