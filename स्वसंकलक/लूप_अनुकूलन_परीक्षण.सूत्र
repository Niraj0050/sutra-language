// लूप_अनुकूलन_परीक्षण.सूत्र — सीमा-उन्नयन (bounds-check hoisting) pass का test
// असली parser → lower → अनुकूलक_एकक → लूप_अनुकूलक_एकक → IR डंप जाँचो।
// (लंबाई-LICM लूइनी_हॉइस्ट_लंबाई जान-बूझकर बंद — असली compiler पर कभी
// validate नहीं हुई; यह test फ़ाइल अब सिर्फ़ सीमा-उन्नयन जाँचती है।)

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "लूप_अनुकूलन.सूत्र";

मान विफल = ०;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + १; }
}
कार्य है(पाठ ह, पाठ सुई) { परत् खोजें(ह, सुई) >= ०; }

कार्य पार्स_करो(पाठ स्रोत) {
    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    परत् प्रोग्राम_पार्स(अवस्था, {}, "प");
}

कार्य पूर्ण_अनुकूलित(पाठ स्रोत) {
    शब्दकोश एकक = निम्नक_एकक(पार्स_करो(स्रोत));
    अनुकूलक_एकक(एकक);
    लूप_अनुकूलक_एकक(एकक);
    परत् मध्यम_छापो_एकक(एकक);
}

कार्य मुख्य() {
    // १. मूल — counted लूप, आधार पैरामीटर, सूचकांक == IV, सिर्फ़ पढ़ना
    पाठ द1 = पूर्ण_अनुकूलित(
        "कार्य क1(सूची स, संख्या ग) { संख्या य = 0; संख्या इ = 0; यावत् (इ < ग) { य = य + स[इ]; इ = इ + 1; } परत् य; }");
    लिखतु("--- 1 ---"); लिखतु(द1);
    जाँच("1 preheader गार्ड लगा (retag का संकेत)", है(द1, "सीमा_दावा_ऊपर"));

    // २. नकारात्मक — लूप उसी सूची में जोड़ता (लंबाई बदल सकती) → गार्ड नहीं
    पाठ द2 = पूर्ण_अनुकूलित(
        "कार्य क2(संख्या ग) { सूची स = []; संख्या इ = 0; यावत् (इ < ग) { स = जोड़ें(स, इ); इ = इ + 1; } परत् इ; }");
    लिखतु("--- 2 ---"); लिखतु(द2);
    जाँच("2 length बदलती — गार्ड नहीं", न है(द2, "सीमा_दावा_ऊपर"));

    // ३. नकारात्मक — लूप में अज्ञात कॉल (छापो) → गार्ड नहीं
    पाठ द3 = पूर्ण_अनुकूलित(
        "कार्य क3(सूची स, संख्या ग) { संख्या इ = 0; यावत् (इ < ग) { लिखतु(स[इ]); इ = इ + 1; } परत् इ; }");
    लिखतु("--- 3 ---"); लिखतु(द3);
    जाँच("3 अज्ञात कॉल — गार्ड नहीं", न है(द3, "सीमा_दावा_ऊपर"));

    // ४. नकारात्मक — लूप में वापस (फलन-स्तर जल्दी-निकास) → गार्ड नहीं
    पाठ द4 = पूर्ण_अनुकूलित(
        "कार्य क4(सूची स, संख्या ग) { संख्या य = 0; संख्या इ = 0; यावत् (इ < ग) { यदि (इ == 3) { परत् 99; } य = य + स[इ]; इ = इ + 1; } परत् य; }");
    लिखतु("--- 4 ---"); लिखतु(द4);
    जाँच("4 लूप में वापस — गार्ड नहीं", न है(द4, "सीमा_दावा_ऊपर"));

    // ५. नकारात्मक — सूचकांक ठीक IV नहीं (इ + १) → Stage १ में गार्ड नहीं
    पाठ द5 = पूर्ण_अनुकूलित(
        "कार्य क5(सूची स, संख्या ग) { संख्या य = 0; संख्या इ = 0; यावत् (इ < ग) { य = य + स[इ + 1]; इ = इ + 1; } परत् य; }");
    लिखतु("--- 5 ---"); लिखतु(द5);
    जाँच("5 non-IV सूचकांक — Stage 1 गार्ड नहीं", न है(द5, "सीमा_दावा_ऊपर"));

    // ६. पढ़ + लिख दोनों (in-place) — दोनों retag, एक गार्ड
    पाठ द6 = पूर्ण_अनुकूलित(
        "कार्य क6(सूची स, संख्या ग) { संख्या इ = 0; यावत् (इ < ग) { स[इ] = स[इ] + 1; इ = इ + 1; } परत् इ; }");
    लिखतु("--- 6 ---"); लिखतु(द6);
    जाँच("6 in-place पढ़+लिख — गार्ड लगा", है(द6, "सीमा_दावा_ऊपर"));

    लिखतु("");
    यदि (विफल == ०) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
