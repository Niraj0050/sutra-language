// अग्र_चालक.सूत्र — CLI: .सूत्र → parse → निम्नक → अनुकूलक → IR-पाठ (stdout)
// ============================================================
// यह split-pipeline का पहला भाग। पश्च_चालक इसकी IR-पाठ पढ़कर .s बनाता है।
// कारण: पुराना O(n²)-स्मृति संकलक 6-module चालक (उत्सर्जक_चालक) संकलित
// करते समय OOM हो जाता है (~1.6 GB मुक्त)। दो छोटे चालक fit हो जाते हैं।
//
// प्रयोग:  <exe> path/to/program.सूत्र  > out.ir
// ============================================================

आयात "विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "मध्यम_क्रम.सूत्र";

कार्य मुख्य() {
    मान तर्काः_सूची = तर्काः();
    यदि (लंबाई(तर्काः_सूची) < 2) {
        लिखतु("# प्रयोग: अग्र_चालक <program.सूत्र>  > out.ir");
        परत्;
    }
    पाठ मार्गः = तर्काः_सूची[लंबाई(तर्काः_सूची) - 1];
    पाठ स्रोत = सञ्चिका_पठतु(मार्गः);

    सूची पद_सूची = पद_विच्छेदन(स्रोत);
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश प्रोग्राम = प्रोग्राम_पार्स(अवस्था, {}, मार्गः);

    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम);
    अनुकूलक_एकक(एकक);
    लिखतु(मध्यम_क्रमबद्ध(एकक));
}
