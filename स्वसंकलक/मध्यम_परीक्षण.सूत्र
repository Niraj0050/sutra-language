// मध्यम_परीक्षण.सूत्र — मध्यम.सूत्र (IR) का smoke test
// हाथ से एक छोटा IR कार्य बनाओ, छापो, अपेक्षित output से मिलाओ।
// चलाओ:  sutrac.exe स्वसंकलक\मध्यम_परीक्षण.सूत्र  &&  <exe>

आयात "मध्यम.सूत्र";

मान विफल = 0;
कार्य जाँच(पाठ नाम, मान शर्त) {
    यदि (शर्त) { लिखतु("  ठीक : " + नाम); }
    अन्यथा { लिखतु("  विफल: " + नाम); विफल = विफल + 1; }
}

कार्य मुख्य() {
    शब्दकोश एकक = मध्यम_नव_एकक();

    // कार्य निरपेक्ष(राशि) -> पूर्ण  {  यदि राशि<0 तो -राशि अन्यथा राशि  }
    शब्दकोश क = मध्यम_नव_कार्य("निरपेक्ष", "पूर्ण");
    संख्या राशि = मध्यम_पैरामीटर(क, "राशि", "पूर्ण");

    शब्दकोश प्रवेश = मध्यम_नव_खंड(क, "प्रवेश");
    शब्दकोश ऋण = मध्यम_नव_खंड(क, "ऋण");
    शब्दकोश धन = मध्यम_नव_खंड(क, "धन");
    शब्दकोश अंत = मध्यम_नव_खंड(क, "अंत");

    संख्या शून्य = मध्यम_स्थिर_पूर्ण(क, प्रवेश, 0);
    संख्या शर्त = मध्यम_तुलना(क, प्रवेश, "लघु", राशि, शून्य);
    मध्यम_यदि_जाओ(प्रवेश, शर्त, ऋण["लेबल"], धन["लेबल"]);

    संख्या नेग = मध्यम_जोड़(क, ऋण, "ऋणात्मक", "पूर्ण", [राशि], {});
    मध्यम_जाओ(ऋण, अंत["लेबल"]);

    मध्यम_जाओ(धन, अंत["लेबल"]);

    संख्या फल = मध्यम_फाई(क, अंत, "पूर्ण", [[ऋण["लेबल"], नेग], [धन["लेबल"], राशि]]);
    मध्यम_वापस(अंत, फल);

    एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], क);

    // दूसरा कार्य — पाठ-स्थिरांक + अंतर् + बुलाओ
    शब्दकोश ग = मध्यम_नव_कार्य("अभिवादन", "शून्य");
    शब्दकोश ग_प्र = मध्यम_नव_खंड(ग, "प्रवेश");
    संख्या नमस्ते = मध्यम_स्थिर_पाठ(एकक, ग, ग_प्र, "नमस्ते");
    मध्यम_बुलाओ(ग, ग_प्र, "छापो_पाठ", "शून्य", [नमस्ते]);
    मध्यम_वापस(ग_प्र, 0 - 1);
    एकक["कार्य_सूची"] = जोड़ें(एकक["कार्य_सूची"], ग);

    पाठ डंप = मध्यम_छापो_एकक(एकक);
    लिखतु("=== IR डंप ===");
    लिखतु(डंप);
    लिखतु("=== जाँच ===");

    // v0 आरक्षित — मान-id v1 से शुरू
    जाँच("पाठ_स्थिरांक दर्ज", खोजें(डंप, "पाठ_स्थिरांक[0] = \"नमस्ते\"") >= 0);
    जाँच("फलन शीर्षक", खोजें(डंप, "फलन निरपेक्ष(v1: पूर्ण) -> पूर्ण {") >= 0);
    जाँच("स्थिर निर्देश", खोजें(डंप, "v2 = स्थिर पूर्ण:0  : पूर्ण") >= 0);
    जाँच("तुलना निर्देश", खोजें(डंप, "v3 = लघु v1, v2  : बूल") >= 0);
    जाँच("यदि_जाओ terminator", खोजें(डंप, "यदि_जाओ v3 ? ऋण_1 : धन_2") >= 0);
    जाँच("जाओ terminator", खोजें(डंप, "जाओ अंत_3") >= 0);
    जाँच("ऋणात्मक निर्देश", खोजें(डंप, "v4 = ऋणात्मक v1  : पूर्ण") >= 0);
    जाँच("फाई नोड", खोजें(डंप, "v5 = फाई [ऋण_1: v4], [धन_2: v1]  : पूर्ण") >= 0);
    जाँच("वापस terminator", खोजें(डंप, "वापस v5") >= 0);
    जाँच("दूसरा फलन", खोजें(डंप, "फलन अभिवादन() -> शून्य") >= 0);
    जाँच("बुलाओ छपाई", खोजें(डंप, "बुलाओ v1 @छापो_पाठ") >= 0);
    जाँच("पाठ स्थिर छपाई", खोजें(डंप, "v1 = स्थिर पाठ:0  : पाठ") >= 0);
    जाँच("दूसरे फलन में वापस", खोजें(डंप, "प्रवेश_0:") >= 0);
    जाँच("ताजा-आईडी गिनती (निरपेक्ष = 6)", क["अगला_आईडी"] == 6);
    जाँच("ताजा-लेबल गिनती (निरपेक्ष = 4)", क["अगला_लेबल"] == 4);

    यदि (विफल == 0) { लिखतु("सर्वे उत्तीर्णाः"); }
    अन्यथा { लिखतु("विफलम् — " + विफल); }
}
