// प्रकार_प्रसार.सूत्र — आशावादी पूर्णांक-प्रकार प्रसार [§4/§7 perf]
// ============================================================
// समस्या: mem2reg हर phi को "मान" (dynamic) टैग देता। तो लूप-संचायक
// `कुल = कुल + x` का phi और उसका `योग` निर्देश "मान"-टैग रहते → (a)
// रजि_नियतक उन्हें GC-tapped मानकर हर लूप-चक्कर में shadow-stack में
// store/clear निर्देश डालता (मापा: यही clang की LICM/loop-collapse रोकता,
// list-sum को C++ से ~5x पीछे रखता), (b) योग dynamic `पाठ_योग_गतिक`
// कॉल बनता native `add` की जगह।
//
// यह pass: mem2reg के बाद (परत्_प्रकार_अनुमान के साथ) चलता। आशावादी
// monotone fixpoint — हर मान "पूर्ण/बूल-जैसा" जब तक सिद्ध न हो अन्यथा।
// सिद्ध-नहीं के स्रोत:
//   - GC-tapped ठोस टैग (पाठ/सूची/शब्दकोश/वर्ग-नाम/…) किसी भी मान पर
//   - अपारदर्शी उत्पादक (बुलाओ/पढ़_वैश्विक/पढ़_स्लॉट/नव_*/विधि_बुलाओ/
//     परिवर्तन) जिसका टैग "मान"/अज्ञात — pointer हो सकता
//   - GC-tapped-टैप पैरामीटर
//   - अ-स्थानीय या गैर-पूर्ण-तत्व सूची से पढ़_अनुक्रम; पाठ-सूचकांक
//   - ऐसे स्रोत से phi; ऐसे operand से अंकगणित
// बचे derived मान (phi / योग-अंतर-गुणा-भाग-शेष / पात्र पढ़_अनुक्रम) →
// सिद्ध पूर्ण → उनके "प्रकार" व अंकगणित के "अंश.विधि" को "पूर्ण" कर दो।
//
// सुदृढ़ता: monotone (केवल "पूर्ण नहीं" की ओर गिरता) = dynamic मानों का
// sound over-approximation। GC-tapped predicate वही जो रजि_नियतक उपयोग
// करता (मध्यम_जीसी_टैप्ड) — तो अ-टाइप param / वर्ग-typed मान / heap
// कॉल-परिणाम सब बीज में पकड़े जाते, कभी un-root नहीं होते।
// ============================================================

आयात "मध्यम.सूत्र";

कार्य प्रप_सूची_पठन_सुरक्षित(पाठ लक्ष्य) {
    परत् लक्ष्य == "सूची_तत्व_तेज़" || लक्ष्य == "सूची_सूचकांक" ||
         लक्ष्य == "सूची_लंबाई_तेज़" || लक्ष्य == "दैशिक_लंबाई" ||
         लक्ष्य == "सञ्चय_गणना" || लक्ष्य == "लंबाई";
}
कार्य प्रप_अपारदर्शी_उत्पादक(पाठ को) {
    परत् को == "बुलाओ" || को == "विधि_बुलाओ" || को == "परिवर्तन" ||
         को == "पढ़_वैश्विक" || को == "पढ़_स्लॉट" ||
         को == "नव_सूची" || को == "नव_शब्दकोश" || को == "नव_वस्तु" || को == "नव_पाठ";
}

// ज्ञात-सूची value-set — एउ_सूची_सेट का सम-तुल्य (मॉड्यूल-स्वतंत्र प्रति)।
// नव_सूची / सूची_रचना / पढ़-लिख_अनुक्रम(आधार=सूची) base / सूची_जोड़-परिणाम
// + phi जिसके सब स्रोत सेट में।
कार्य प्रप_सूची_सेट(शब्दकोश फलन) {
    शब्दकोश सेट = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            यदि (को == "नव_सूची" && इ["आईडी"] >= 1) { सेट[इ["आईडी"]] = सत्य; }
            यदि (को == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_रचना" && इ["आईडी"] >= 1) { सेट[इ["आईडी"]] = सत्य; }
            यदि ((को == "पढ़_अनुक्रम" || को == "लिख_अनुक्रम") && इ["अंश"]["आधार_प्रकार"] == "सूची") {
                यदि (इ["संचालक"][0] >= 1) { सेट[इ["संचालक"][0]] = सत्य; }
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = 0;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = 0;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                यदि (पिड >= 1 && सेट[पिड] != सत्य) {
                    सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                    मान सब = सत्य;
                    संख्या स = 0;
                    यावत् (स < लंबाई(स्रोत)) {
                        संख्या सिड = स्रोत[स][1];
                        यदि (सिड >= 1 && सिड != पिड && सेट[सिड] != सत्य) { सब = असत्य; }
                        स = स + 1;
                    }
                    यदि (लंबाई(स्रोत) > 0 && सब) { सेट[पिड] = सत्य; बदला = सत्य; }
                }
                फ = फ + 1;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = 0;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                यदि (इ["कोड"] == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़" && इ["आईडी"] >= 1 && सेट[इ["आईडी"]] != सत्य) {
                    यदि (लंबाई(इ["संचालक"]) > 0 && सेट[इ["संचालक"][0]] == सत्य) { सेट[इ["आईडी"]] = सत्य; बदला = सत्य; }
                }
                नि = नि + 1;
            }
            ख = ख + 1;
        }
    }
    परत् सेट;
}

// एक फलन पर आशावादी fixpoint — "नहीं" नक्शा लौटाता (id -> सत्य: सिद्ध पूर्ण नहीं)
कार्य प्रप_नहीं_नक्शा(शब्दकोश फलन, शब्दकोश सूचीसेट) {
    शब्दकोश नहीं = {};
    शब्दकोश स्थानीय = {};
    शब्दकोश सूचि_बुरी = {};
    सूची खस = फलन["खंड_सूची"];

    // बीज: GC-tapped पैरामीटर
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = 0;
    यावत् (प < लंबाई(पैरा)) {
        यदि (मध्यम_जीसी_टैप्ड(पैरा[प]["प्रकार"])) { नहीं[पैरा[प]["आईडी"]] = सत्य; }
        प = प + 1;
    }

    // बीज: GC-tapped ठोस टैग; अपारदर्शी-"मान" उत्पादक; स्थानीय-सूची चिह्न
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            मान फत = फस[फ]["प्रकार"];
            // phi का टैग सबूत नहीं (mem2reg हमेशा "मान" देता) — केवल ठोस
            // GC-tapped (पाठ/सूची/वर्ग) पर बीज; "मान"/nil phi fixpoint में जँचे
            यदि (फत != शून्यम् && फत != "मान" && मध्यम_जीसी_टैप्ड(फत)) { नहीं[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + 1;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            पाठ को = इ["कोड"];
            यदि (आ >= 1) {
                मान त = इ["प्रकार"];
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष" || को == "पढ़_अनुक्रम") {
                    // derived — बीज मत करो, fixpoint में हल
                } अन्यथा यदि (त != शून्यम् && त != "मान" && मध्यम_जीसी_टैप्ड(त)) {
                    नहीं[आ] = सत्य;
                } अन्यथा यदि ((त == "मान" || त == शून्यम्) && प्रप_अपारदर्शी_उत्पादक(को)) {
                    नहीं[आ] = सत्य;
                }
                यदि (को == "नव_सूची") { स्थानीय[आ] = सत्य; }
                यदि (को == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़") { स्थानीय[आ] = सत्य; }
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            यदि (सूचीसेट[फस[फ]["आईडी"]] == सत्य) { स्थानीय[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + 1;
        }
        ख = ख + 1;
    }

    // संयुक्त monotone fixpoint
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = 0;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = 0;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                संख्या स = 0;
                यावत् (स < लंबाई(स्रोत)) {
                    संख्या सिड = स्रोत[स][1];
                    यदि (सिड >= 1 && सिड != पिड) {
                        यदि (नहीं[सिड] == सत्य && नहीं[पिड] != सत्य) { नहीं[पिड] = सत्य; बदला = सत्य; }
                        यदि (स्थानीय[पिड] == सत्य && स्थानीय[सिड] != सत्य) { स्थानीय[पिड] = असत्य; बदला = सत्य; }
                        यदि (सूचि_बुरी[सिड] == सत्य && सूचि_बुरी[पिड] != सत्य) { सूचि_बुरी[पिड] = सत्य; बदला = सत्य; }
                        यदि (सूचि_बुरी[पिड] == सत्य && सूचि_बुरी[सिड] != सत्य) { सूचि_बुरी[सिड] = सत्य; बदला = सत्य; }
                    }
                    स = स + 1;
                }
                फ = फ + 1;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = 0;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                पाठ को = इ["कोड"];
                संख्या आ = इ["आईडी"];
                सूची ऑप = इ["संचालक"];
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष") {
                    यदि (आ >= 1 && नहीं[आ] != सत्य && लंबाई(ऑप) >= 2) {
                        यदि (नहीं[ऑप[0]] == सत्य || नहीं[ऑप[1]] == सत्य) { नहीं[आ] = सत्य; बदला = सत्य; }
                    }
                }
                अन्यथा यदि (को == "पढ़_अनुक्रम" && आ >= 1 && नहीं[आ] != सत्य) {
                    मान ठीक = असत्य;
                    यदि (लंबाई(ऑप) >= 1 && इ["अंश"]["आधार_प्रकार"] == "सूची"
                         && स्थानीय[ऑप[0]] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य) { ठीक = सत्य; }
                    यदि (न ठीक) { नहीं[आ] = सत्य; बदला = सत्य; }
                }
                अन्यथा यदि (को == "नव_सूची" && आ >= 1 && स्थानीय[आ] == सत्य && सूचि_बुरी[आ] != सत्य) {
                    संख्या क = 0;
                    यावत् (क < लंबाई(ऑप)) {
                        यदि (नहीं[ऑप[क]] == सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                        क = क + 1;
                    }
                }
                अन्यथा यदि (को == "लिख_अनुक्रम" && लंबाई(ऑप) >= 3) {
                    यदि (स्थानीय[ऑप[0]] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य && नहीं[ऑप[2]] == सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                }
                अन्यथा यदि (को == "बुलाओ") {
                    पाठ लक्ष्य = इ["अंश"]["लक्ष्य"];
                    यदि (लक्ष्य == "सूची_जोड़") {
                        यदि (लंबाई(ऑप) >= 2 && स्थानीय[ऑप[0]] == सत्य) {
                            यदि (नहीं[ऑप[1]] == सत्य) {
                                यदि (सूचि_बुरी[ऑप[0]] != सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                                यदि (आ >= 1 && सूचि_बुरी[आ] != सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                            }
                            यदि (आ >= 1) {
                                यदि (सूचि_बुरी[ऑप[0]] == सत्य && सूचि_बुरी[आ] != सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                                यदि (सूचि_बुरी[आ] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                                यदि (स्थानीय[ऑप[0]] != सत्य && स्थानीय[आ] == सत्य) { स्थानीय[आ] = असत्य; बदला = सत्य; }
                            }
                        }
                    }
                    अन्यथा यदि (लक्ष्य == "सूची_तत्व_सेट_तेज़" || लक्ष्य == "सूची_सूचकांक_सेट") {
                        यदि (लंबाई(ऑप) >= 3 && स्थानीय[ऑप[0]] == सत्य && सूचि_बुरी[ऑप[0]] != सत्य && नहीं[ऑप[2]] == सत्य) { सूचि_बुरी[ऑप[0]] = सत्य; बदला = सत्य; }
                    }
                    अन्यथा यदि (न प्रप_सूची_पठन_सुरक्षित(लक्ष्य)) {
                        संख्या क = 0;
                        यावत् (क < लंबाई(ऑप)) {
                            यदि (स्थानीय[ऑप[क]] == सत्य && सूचि_बुरी[ऑप[क]] != सत्य) { सूचि_बुरी[ऑप[क]] = सत्य; बदला = सत्य; }
                            क = क + 1;
                        }
                    }
                }
                नि = नि + 1;
            }
            ख = ख + 1;
        }
    }
    परत् नहीं;
}

// एक फलन के प्रकार-टैग प्रसारित करो
कार्य प्रप_फलन(शब्दकोश फलन) {
    शब्दकोश सूचीसेट = प्रप_सूची_सेट(फलन);
    शब्दकोश नहीं = प्रप_नहीं_नक्शा(फलन, सूचीसेट);
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = 0;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = 0;
        यावत् (फ < लंबाई(फस)) {
            संख्या पिड = फस[फ]["आईडी"];
            यदि (पिड >= 1 && नहीं[पिड] != सत्य) {
                मान वर्त = फस[फ]["प्रकार"];
                यदि (वर्त == शून्यम् || वर्त == "मान") { फस[फ]["प्रकार"] = "पूर्ण"; }
            }
            फ = फ + 1;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = 0;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            संख्या आ = इ["आईडी"];
            यदि (आ >= 1 && नहीं[आ] != सत्य) {
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष") {
                    मान वर्त = इ["प्रकार"];
                    यदि (वर्त == शून्यम् || वर्त == "मान") { इ["प्रकार"] = "पूर्ण"; }
                    मान वि = इ["अंश"]["विधि"];
                    यदि (वि == शून्यम् || वि == "मान") { इ["अंश"]["विधि"] = "पूर्ण"; }
                }
                अन्यथा यदि (को == "पढ़_अनुक्रम") {
                    मान वर्त = इ["प्रकार"];
                    यदि (वर्त == शून्यम् || वर्त == "मान") { इ["प्रकार"] = "पूर्ण"; }
                }
            }
            नि = नि + 1;
        }
        ख = ख + 1;
    }
    परत् 0;
}

// मॉड्यूल-व्यापी — हर फलन पर प्रसार (परत्_प्रकार_अनुमान के बाद, उत्सर्जक
// से पहले, ताकि रजि_नियतक की GC-root चयन इसे देखे)
कार्य प्रकार_प्रसार_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या इ = 0;
    यावत् (इ < लंबाई(कस)) {
        प्रप_फलन(कस[इ]);
        इ = इ + 1;
    }
    परत् एकक;
}
