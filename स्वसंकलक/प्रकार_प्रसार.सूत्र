// प्रकार_प्रसार.सूत्र — आशावादी पूर्णांक-प्रकार प्रसार [§4/§7 perf]
// ============================================================
// समस्या: mem2reg हर phi को "मान" (dynamic) टैग देता। तो लूप-संचायक
// `कुल = कुल + x` का phi और उसका `योग` निर्देश "मान"-टैग रहते → (a)
// रजि_नियतक उन्हें GC-tapped मानकर हर लूप-चक्कर में shadow-stack में
// store/clear निर्देश डालता (मापा: यही clang की LICM/loop-collapse रोकता,
// list-sum को C++ से ~5x पीछे रखता), (b) योग dynamic `पाठ_योग_गतिक`
// कॉल बनता native `add` की जगह।
//
// यह pass: mem2reg के बाद (परत्_प्रकार_अनुमान के साथ) चलता। आशावादी
// monotone fixpoint — हर मान "पूर्ण/बूल-जैसा" जब तक सिद्ध न हो अन्यथा।
// सिद्ध-नहीं के स्रोत:
//   - GC-tapped ठोस टैग (पाठ/सूची/शब्दकोश/वर्ग-नाम/…) किसी भी मान पर
//   - अपारदर्शी उत्पादक (बुलाओ/पढ़_वैश्विक/पढ़_स्लॉट/नव_*/विधि_बुलाओ/
//     परिवर्तन) जिसका टैग "मान"/अज्ञात — pointer हो सकता
//   - GC-tapped-टैप पैरामीटर
//   - अ-स्थानीय या गैर-पूर्ण-तत्व सूची से पढ़_अनुक्रम; पाठ-सूचकांक
//   - ऐसे स्रोत से phi; ऐसे operand से अंकगणित
// बचे derived मान (phi / योग-अंतर-गुणा-भाग-शेष / पात्र पढ़_अनुक्रम) →
// सिद्ध पूर्ण → उनके "प्रकार" व अंकगणित के "अंश.विधि" को "पूर्ण" कर दो।
//
// सुदृढ़ता: monotone (केवल "पूर्ण नहीं" की ओर गिरता) = dynamic मानों का
// sound over-approximation। GC-tapped predicate वही जो रजि_नियतक उपयोग
// करता (मध्यम_जीसी_टैप्ड) — तो अ-टाइप param / वर्ग-typed मान / heap
// कॉल-परिणाम सब बीज में पकड़े जाते, कभी un-root नहीं होते।
// ============================================================

आयात "मध्यम.सूत्र";

कार्य प्रप_सूची_पठन_सुरक्षित(पाठ लक्ष्य) {
    परत् लक्ष्य == "सूची_तत्व_तेज़" || लक्ष्य == "सूची_सूचकांक" ||
         लक्ष्य == "सूची_लंबाई_तेज़" || लक्ष्य == "दैशिक_लंबाई" ||
         लक्ष्य == "सञ्चय_गणना" || लक्ष्य == "लंबाई" ||
         लक्ष्य == "शब्दकोश_पाओ" || लक्ष्य == "शब्दकोश_कुंजी_है" ||
         लक्ष्य == "शब्दकोश_कुंजी_है_रन" || लक्ष्य == "शब्दकोश_कुंजियाँ_रन";
}
कार्य प्रप_अपारदर्शी_उत्पादक(पाठ को) {
    परत् को == "बुलाओ" || को == "विधि_बुलाओ" || को == "परिवर्तन" ||
         को == "पढ़_वैश्विक" || को == "पढ़_स्लॉट" ||
         को == "नव_सूची" || को == "नव_शब्दकोश" || को == "नव_वस्तु" || को == "नव_पाठ";
}

// ज्ञात-सूची value-set — एउ_सूची_सेट का सम-तुल्य (मॉड्यूल-स्वतंत्र प्रति)।
// नव_सूची / सूची_रचना / पढ़-लिख_अनुक्रम(आधार=सूची) base / सूची_जोड़-परिणाम
// + phi जिसके सब स्रोत सेट में।
कार्य प्रप_सूची_सेट(शब्दकोश फलन) {
    शब्दकोश सेट = {};
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            यदि ((को == "नव_सूची" || को == "नव_शब्दकोश") && इ["आईडी"] >= १) { सेट[इ["आईडी"]] = सत्य; }
            यदि (को == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "सूची_रचना" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_रचना") && इ["आईडी"] >= १) { सेट[इ["आईडी"]] = सत्य; }
            यदि ((को == "पढ़_अनुक्रम" || को == "लिख_अनुक्रम") && (इ["अंश"]["आधार_प्रकार"] == "सूची" || इ["अंश"]["आधार_प्रकार"] == "शब्दकोश")) {
                यदि (इ["संचालक"][०] >= १) { सेट[इ["संचालक"][०]] = सत्य; }
            }
            नि = नि + १;
        }
        ख = ख + १;
    }
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = ०;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = ०;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                यदि (पिड >= १ && सेट[पिड] != सत्य) {
                    सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                    मान सब = सत्य;
                    संख्या स = ०;
                    यावत् (स < लंबाई(स्रोत)) {
                        संख्या सिड = स्रोत[स][१];
                        यदि (सिड >= १ && सिड != पिड && सेट[सिड] != सत्य) { सब = असत्य; }
                        स = स + १;
                    }
                    यदि (लंबाई(स्रोत) > ० && सब) { सेट[पिड] = सत्य; बदला = सत्य; }
                }
                फ = फ + १;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                यदि (इ["कोड"] == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़" && इ["आईडी"] >= १ && सेट[इ["आईडी"]] != सत्य) {
                    यदि (लंबाई(इ["संचालक"]) > ० && सेट[इ["संचालक"][०]] == सत्य) { सेट[इ["आईडी"]] = सत्य; बदला = सत्य; }
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
    }
    परत् सेट;
}

// एक फलन पर आशावादी fixpoint — "नहीं" नक्शा लौटाता (id -> सत्य: सिद्ध पूर्ण नहीं)
कार्य प्रप_नहीं_नक्शा(शब्दकोश फलन, शब्दकोश सूचीसेट) {
    शब्दकोश नहीं = {};
    शब्दकोश स्थानीय = {};
    शब्दकोश सूचि_बुरी = {};
    सूची खस = फलन["खंड_सूची"];

    // बीज: GC-tapped पैरामीटर
    सूची पैरा = फलन["पैरामीटर"];
    संख्या प = ०;
    यावत् (प < लंबाई(पैरा)) {
        यदि (मध्यम_जीसी_टैप्ड(पैरा[प]["प्रकार"])) { नहीं[पैरा[प]["आईडी"]] = सत्य; }
        प = प + १;
    }

    // बीज: GC-tapped ठोस टैग; अपारदर्शी-"मान" उत्पादक; स्थानीय-सूची चिह्न
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) {
            मान फत = फस[फ]["प्रकार"];
            // phi का टैग सबूत नहीं (mem2reg हमेशा "मान" देता) — केवल ठोस
            // GC-tapped (पाठ/सूची/वर्ग) पर बीज; "मान"/nil phi fixpoint में जँचे
            यदि (फत != शून्यम् && फत != "मान" && मध्यम_जीसी_टैप्ड(फत)) { नहीं[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + १;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            पाठ को = इ["कोड"];
            यदि (आ >= १) {
                मान त = इ["प्रकार"];
                // दशमलव मान/स्थिरांक = "पूर्ण नहीं" — नहीं तो float सूची
                // पूर्णांक-सूची जैसी दिखती व float अंकगणित पूर्ण-typed हो जाता।
                // (प्रप_दशम_* pass इन्हें सकारात्मक "दशमलव" टैग देता।)
                यदि (त == "दशमलव" || (को == "स्थिर" && इ["अंश"]["मान_प्रकार"] == "दशमलव")) {
                    नहीं[आ] = सत्य;
                } अन्यथा यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष" || को == "पढ़_अनुक्रम") {
                    // derived — बीज मत करो, fixpoint में हल
                } अन्यथा यदि (त != शून्यम् && त != "मान" && मध्यम_जीसी_टैप्ड(त)) {
                    नहीं[आ] = सत्य;
                } अन्यथा यदि ((त == "मान" || त == शून्यम्) && प्रप_अपारदर्शी_उत्पादक(को)) {
                    नहीं[आ] = सत्य;
                }
                यदि (को == "नव_सूची" || को == "नव_शब्दकोश") { स्थानीय[आ] = सत्य; }
                यदि (को == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "सूची_जोड़" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_रचना" || इ["अंश"]["लक्ष्य"] == "सूची_रचना")) { स्थानीय[आ] = सत्य; }
            }
            नि = नि + १;
        }
        ख = ख + १;
    }
    ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) {
            यदि (सूचीसेट[फस[फ]["आईडी"]] == सत्य) { स्थानीय[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + १;
        }
        ख = ख + १;
    }

    // संयुक्त monotone fixpoint
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = ०;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = ०;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                संख्या स = ०;
                यावत् (स < लंबाई(स्रोत)) {
                    संख्या सिड = स्रोत[स][१];
                    यदि (सिड >= १ && सिड != पिड) {
                        यदि (नहीं[सिड] == सत्य && नहीं[पिड] != सत्य) { नहीं[पिड] = सत्य; बदला = सत्य; }
                        यदि (स्थानीय[पिड] == सत्य && स्थानीय[सिड] != सत्य) { स्थानीय[पिड] = असत्य; बदला = सत्य; }
                        यदि (सूचि_बुरी[सिड] == सत्य && सूचि_बुरी[पिड] != सत्य) { सूचि_बुरी[पिड] = सत्य; बदला = सत्य; }
                        यदि (सूचि_बुरी[पिड] == सत्य && सूचि_बुरी[सिड] != सत्य) { सूचि_बुरी[सिड] = सत्य; बदला = सत्य; }
                    }
                    स = स + १;
                }
                फ = फ + १;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                पाठ को = इ["कोड"];
                संख्या आ = इ["आईडी"];
                सूची ऑप = इ["संचालक"];
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष") {
                    यदि (आ >= १ && नहीं[आ] != सत्य && लंबाई(ऑप) >= २) {
                        यदि (नहीं[ऑप[०]] == सत्य || नहीं[ऑप[१]] == सत्य) { नहीं[आ] = सत्य; बदला = सत्य; }
                    }
                }
                अन्यथा यदि (को == "पढ़_अनुक्रम" && आ >= १ && नहीं[आ] != सत्य) {
                    मान ठीक = असत्य;
                    मान आप = इ["अंश"]["आधार_प्रकार"];
                    यदि (लंबाई(ऑप) >= १ && (आप == "सूची" || आप == "शब्दकोश")
                         && स्थानीय[ऑप[०]] == सत्य && सूचि_बुरी[ऑप[०]] != सत्य) { ठीक = सत्य; }
                    यदि (न ठीक) { नहीं[आ] = सत्य; बदला = सत्य; }
                }
                अन्यथा यदि (को == "नव_सूची" && आ >= १ && स्थानीय[आ] == सत्य && सूचि_बुरी[आ] != सत्य) {
                    संख्या क = ०;
                    यावत् (क < लंबाई(ऑप)) {
                        यदि (नहीं[ऑप[क]] == सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                        क = क + १;
                    }
                }
                अन्यथा यदि (को == "लिख_अनुक्रम" && लंबाई(ऑप) >= ३) {
                    यदि (स्थानीय[ऑप[०]] == सत्य && सूचि_बुरी[ऑप[०]] != सत्य && नहीं[ऑप[२]] == सत्य) { सूचि_बुरी[ऑप[०]] = सत्य; बदला = सत्य; }
                }
                अन्यथा यदि (को == "बुलाओ") {
                    पाठ लक्ष्य = इ["अंश"]["लक्ष्य"];
                    यदि (लक्ष्य == "सूची_जोड़") {
                        यदि (लंबाई(ऑप) >= २ && स्थानीय[ऑप[०]] == सत्य) {
                            यदि (नहीं[ऑप[१]] == सत्य) {
                                यदि (सूचि_बुरी[ऑप[०]] != सत्य) { सूचि_बुरी[ऑप[०]] = सत्य; बदला = सत्य; }
                                यदि (आ >= १ && सूचि_बुरी[आ] != सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                            }
                            यदि (आ >= १) {
                                यदि (सूचि_बुरी[ऑप[०]] == सत्य && सूचि_बुरी[आ] != सत्य) { सूचि_बुरी[आ] = सत्य; बदला = सत्य; }
                                यदि (सूचि_बुरी[आ] == सत्य && सूचि_बुरी[ऑप[०]] != सत्य) { सूचि_बुरी[ऑप[०]] = सत्य; बदला = सत्य; }
                                यदि (स्थानीय[ऑप[०]] != सत्य && स्थानीय[आ] == सत्य) { स्थानीय[आ] = असत्य; बदला = सत्य; }
                            }
                        }
                    }
                    अन्यथा यदि (लक्ष्य == "सूची_तत्व_सेट_तेज़" || लक्ष्य == "सूची_सूचकांक_सेट" || लक्ष्य == "शब्दकोश_सेट" || लक्ष्य == "शब्दकोश_डाल") {
                        यदि (लंबाई(ऑप) >= ३ && स्थानीय[ऑप[०]] == सत्य && सूचि_बुरी[ऑप[०]] != सत्य && नहीं[ऑप[२]] == सत्य) { सूचि_बुरी[ऑप[०]] = सत्य; बदला = सत्य; }
                    }
                    अन्यथा यदि (न प्रप_सूची_पठन_सुरक्षित(लक्ष्य)) {
                        संख्या क = ०;
                        यावत् (क < लंबाई(ऑप)) {
                            यदि (स्थानीय[ऑप[क]] == सत्य && सूचि_बुरी[ऑप[क]] != सत्य) { सूचि_बुरी[ऑप[क]] = सत्य; बदला = सत्य; }
                            क = क + १;
                        }
                    }
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
    }
    परत् नहीं;
}

// ============================================================
// दशमलव (float) संग्रह-तत्व प्रसार
// ------------------------------------------------------------
// समस्या: `सूची अ = [1.5, 2.5]` या `म["k"] = 9.5` → तत्व double-bits के रूप
// में slot में जाते, पर पढ़ने पर निम्नक "मान" (या पूर्णांक-प्रसार से "पूर्ण")
// टैग देता → अंकगणित पूर्णांक-add बनता, छापो कच्ची i64 दिखाता।
// यह pass: स्थानीय-जन्मी संग्रह जिनका हर लिखा मान सिद्ध-दशमलव → उनके
// पढ़_अनुक्रम/शब्दकोश_पाओ परिणाम "दशमलव"; व्युत्पन्न योग/अंतर/गुणा/भाग/phi भी
// (केवल जब सब अंक-operand दशमलव — मिश्रित float+int छोड़ो, सुदृढ़ता)।
// फिर: अंकगणित की विधि "दशमलव" (उत्सर्जक sutra_float_* बुलाता), गतिशील_छापो
// → दशमलव_छापो, str-concat float operand पर दशमलव_से_पाठ डालो।
// सुदृढ़ता: संग्रह "float" तभी जब born-local + कभी escape नहीं + हर लिख
// दशमलव — कोई अदृश्य लिख असंभव। किसी गैर-float को कभी float नहीं कहता।
// ============================================================

कार्य प्रप_दशम_सुरक्षित_कॉल(पाठ लक्ष्य) {
    // संग्रह को mutate/escape नहीं करने वाले runtime-पाठक
    परत् प्रप_सूची_पठन_सुरक्षित(लक्ष्य) || लक्ष्य == "सूची_लंबाई_तेज़" ||
         लक्ष्य == "सूची_तत्व_तेज़" || लक्ष्य == "पाठ_सूचकांक";
}

// किसी मान-आईडी का सिद्ध-दशमलव होना (दिए गए दशम-सेट के सापेक्ष)
कार्य प्रप_दशम_है(शब्दकोश निर्मक, शब्दकोश दशम, संख्या आ) {
    यदि (आ < १) { परत् असत्य; }
    यदि (दशम[आ] == सत्य) { परत् सत्य; }
    मान इ = निर्मक[आ];
    यदि (इ == शून्यम्) { परत् असत्य; }
    यदि (इ["कोड"] == "स्थिर" && इ["अंश"]["मान_प्रकार"] == "दशमलव") { परत् सत्य; }
    // देशी-float अनुमान द्वारा पहले से चिह्नित (इस pass से स्वतंत्र, विश्वसनीय):
    //  · अंकगणित जिसकी विधि = दशमलव (double-op — देशी अनुमान या यही pass; दोनों = float)
    //  · sutra_int_to_float व अन्य float-लौटाने वाले runtime कॉल
    यदि (इ["अंश"] != शून्यम् && इ["अंश"]["विधि"] == "दशमलव") { परत् सत्य; }
    यदि (इ["कोड"] == "बुलाओ" && इ["अंश"] != शून्यम्) {
        मान लक = इ["अंश"]["लक्ष्य"];
        यदि (लक == "sutra_int_to_float" || लक == "sutra_float_add" || लक == "sutra_float_sub"
            || लक == "sutra_float_mul" || लक == "sutra_float_div") { परत् सत्य; }
    }
    परत् असत्य;
}
// किसी मान-आईडी का सिद्ध-गैर-दशमलव (पूर्ण/पाठ/pointer स्थिर या ठोस टैग)
कार्य प्रप_दशम_नहीं_है(शब्दकोश निर्मक, संख्या आ) {
    यदि (आ < १) { परत् असत्य; }
    मान इ = निर्मक[आ];
    यदि (इ == शून्यम्) { परत् असत्य; }
    यदि (इ["कोड"] == "स्थिर") { परत् इ["अंश"]["मान_प्रकार"] != "दशमलव"; }
    मान त = इ["प्रकार"];
    यदि (त == "पूर्ण" || त == "पाठ" || त == "बूल" || त == "शून्य" ||
        त == "सूची" || त == "शब्दकोश") { परत् सत्य; }
    परत् असत्य;
}

// ============================================================
// नेस्टेड (सूची-of-सूची) दशमलव-लिटरल — बंद-संरचना प्रमाण
// ------------------------------------------------------------
// अ[०][१] जैसा चेन्ड पठन "दशमलव" तभी माना जाता जब दोनों सिद्ध हों:
//  (१) अ एकसमान-गहराई का नेस्टेड सूची-लिटरल है और उसके सारे पत्ते
//      दशमलव-लिटरल हैं (ऊँचाई-जाँच — पंक्ति-पठन कभी दशमलव नहीं गिना जाता);
//  (२) संरचना इस फलन में "बंद" है: कोई सदस्य-सूची, या उससे पढ़ी गई पंक्ति
//      (उपनाम), कहीं लिखी/जोड़ी/कॉल को दी/लौटाई/किसी और संग्रह में रखी/phi में
//      मिलाई नहीं जाती — सिर्फ़ सादा पठन और संरचना का अपना निर्माण। तब कोई
//      अदृश्य लिख असंभव है, और हर पत्ता-पठन निश्चित दशमलव है।
// यह ऊपर के जन्म/बुरा/दशमी नियमों से स्वतंत्र व उन्हें छुए बिना है; संदेह में
// (अज्ञात opcode, अज्ञात कॉल, असमान गहराई) अस्वीकार — कोई अनुमान नहीं।
// ============================================================

// ऊँचाई: दशमलव-स्थिर = ०; नव_सूची (≥१ तत्व, सब की ऊँचाई बराबर) = वह+१; बाकी = -१
कार्य प्रप_नेस्टेड_ऊँचाई(शब्दकोश निर्मक, संख्या आ, संख्या गहराई) {
    यदि (गहराई > ८ || आ < १) { परत् -१; }
    मान इ = निर्मक[आ];
    यदि (इ == शून्यम्) { परत् -१; }
    यदि (इ["कोड"] == "स्थिर") {
        यदि (इ["अंश"]["मान_प्रकार"] == "दशमलव") { परत् ०; }
        परत् -१;
    }
    यदि (इ["कोड"] != "नव_सूची") { परत् -१; }
    सूची ऑप = इ["संचालक"];
    यदि (लंबाई(ऑप) == ०) { परत् -१; }
    संख्या ऊ = प्रप_नेस्टेड_ऊँचाई(निर्मक, ऑप[०], गहराई + १);
    यदि (ऊ < ०) { परत् -१; }
    संख्या क = १;
    यावत् (क < लंबाई(ऑप)) {
        यदि (प्रप_नेस्टेड_ऊँचाई(निर्मक, ऑप[क], गहराई + १) != ऊ) { परत् -१; }
        क = क + १;
    }
    परत् ऊ + १;
}

// संरचना के सदस्य-सूची ids (नव_सूची operands पर पुनरावर्ती): सदस्य[id]=सत्य, सतह[id]=स्तर
कार्य प्रप_नेस्टेड_सदस्य(शब्दकोश निर्मक, संख्या आ, संख्या स्तर, शब्दकोश सदस्य, शब्दकोश सतह) {
    मान इ = निर्मक[आ];
    यदि (इ["कोड"] != "नव_सूची") { परत् ०; }
    सदस्य[आ] = सत्य;
    सतह[आ] = स्तर;
    सूची ऑप = इ["संचालक"];
    संख्या क = ०;
    यावत् (क < लंबाई(ऑप)) {
        प्रप_नेस्टेड_सदस्य(निर्मक, ऑप[क], स्तर + १, सदस्य, सतह);
        क = क + १;
    }
    परत् ०;
}

// मूल (नव_सूची id, ऊँचाई गह ≥ २) के लिए: संरचना बंद है? हाँ → पत्ता-पठन परिणाम ids की
// सूची; नहीं → खाली सूची। उपनाम-सेट = सदस्य + बिना-पत्ता स्तरों से पढ़ी पंक्तियाँ।
कार्य प्रप_नेस्टेड_बंद_पत्ते(शब्दकोश फलन, शब्दकोश निर्मक, संख्या मूल, संख्या गह) {
    शब्दकोश सदस्य = {};
    शब्दकोश सतह = {};
    प्रप_नेस्टेड_सदस्य(निर्मक, मूल, ०, सदस्य, सतह);
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    संख्या नि = ०;

    // उपनाम-सेट का fixpoint: पंक्ति-स्तर (स्तर < गह-१) की सूची से पढ़ा परिणाम भी सूची (उपनाम)
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = ०;
        यावत् (ख < लंबाई(खस)) {
            सूची निस = खस[ख]["निर्देश"];
            नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                संख्या आ = इ["आईडी"];
                सूची ऑप = इ["संचालक"];
                मान पठन = असत्य;
                यदि (इ["कोड"] == "पढ़_अनुक्रम") { पठन = सत्य; }
                यदि (इ["कोड"] == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "सूची_सूचकांक" || इ["अंश"]["लक्ष्य"] == "सूची_तत्व_तेज़")) { पठन = सत्य; }
                यदि (पठन && आ >= १ && लंबाई(ऑप) >= १ && ऑप[०] >= १ && सदस्य[ऑप[०]] == सत्य && सदस्य[आ] != सत्य) {
                    यदि (सतह[ऑप[०]] < गह - १) {
                        सदस्य[आ] = सत्य;
                        सतह[आ] = सतह[ऑप[०]] + १;
                        बदला = सत्य;
                    }
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
    }

    // बंद-जाँच: सदस्य/उपनाम का हर उपयोग सादा पठन, लंबाई-पठन, या संरचना का अपना निर्माण हो
    ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) {
            सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
            संख्या स = ०;
            यावत् (स < लंबाई(स्रोत)) {
                यदि (स्रोत[स][१] >= १ && सदस्य[स्रोत[स][१]] == सत्य) { परत् []; }
                स = स + १;
            }
            फ = फ + १;
        }
        सूची निस = खस[ख]["निर्देश"];
        नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            सूची ऑप = इ["संचालक"];
            संख्या गिनती = ०;
            संख्या शून्य_स्थान = ०;
            संख्या क = ०;
            यावत् (क < लंबाई(ऑप)) {
                यदि (ऑप[क] >= १ && सदस्य[ऑप[क]] == सत्य) {
                    गिनती = गिनती + १;
                    यदि (क == ०) { शून्य_स्थान = १; }
                }
                क = क + १;
            }
            यदि (गिनती > ०) {
                मान ठीक = असत्य;
                यदि (इ["कोड"] == "पढ़_अनुक्रम" && गिनती == १ && शून्य_स्थान == १) { ठीक = सत्य; }
                यदि (इ["कोड"] == "नव_सूची" && आ >= १ && सदस्य[आ] == सत्य) { ठीक = सत्य; }
                यदि (इ["कोड"] == "बुलाओ" && गिनती == १ && शून्य_स्थान == १) {
                    पाठ ल = इ["अंश"]["लक्ष्य"];
                    यदि (ल == "सूची_सूचकांक" || ल == "सूची_तत्व_तेज़" || ल == "सूची_लंबाई_तेज़"
                        || ल == "दैशिक_लंबाई" || ल == "सञ्चय_गणना" || ल == "लंबाई") { ठीक = सत्य; }
                }
                यदि (न ठीक) { परत् []; }
            }
            नि = नि + १;
        }
        सूची अंत_ऑप = [];
        यदि (खस[ख]["अंत"] != शून्यम्) { अंत_ऑप = खस[ख]["अंत"]["संचालक"]; }
        संख्या ट = ०;
        यावत् (ट < लंबाई(अंत_ऑप)) {
            यदि (अंत_ऑप[ट] >= १ && सदस्य[अंत_ऑप[ट]] == सत्य) { परत् []; }
            ट = ट + १;
        }
        ख = ख + १;
    }

    // बंद — पत्ता-स्तर (स्तर == गह-१) की सूची से हर पठन का परिणाम निश्चित दशमलव
    सूची पत्ते = [];
    ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            सूची ऑप = इ["संचालक"];
            मान पठन = असत्य;
            यदि (इ["कोड"] == "पढ़_अनुक्रम") { पठन = सत्य; }
            यदि (इ["कोड"] == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "सूची_सूचकांक" || इ["अंश"]["लक्ष्य"] == "सूची_तत्व_तेज़")) { पठन = सत्य; }
            यदि (पठन && आ >= १ && लंबाई(ऑप) >= १ && ऑप[०] >= १ && सदस्य[ऑप[०]] == सत्य) {
                यदि (सतह[ऑप[०]] == गह - १) { पत्ते = जोड़ें(पत्ते, आ); }
            }
            नि = नि + १;
        }
        ख = ख + १;
    }
    परत् पत्ते;
}

कार्य प्रप_दशम_नक्शा(शब्दकोश फलन, शब्दकोश सूचीसेट) {
    सूची खस = फलन["खंड_सूची"];
    शब्दकोश निर्मक = {};      // id -> निर्देश
    शब्दकोश जन्म = {};        // संग्रह-id born local (आशावादी must — घटता है)
    शब्दकोश बुरा = {};        // संग्रह-id escaped या गैर-float लिख मिला (बढ़ता है)
    शब्दकोश दशम = {};         // मान-id -> सिद्ध float
    शब्दकोश दशमी = {};        // संग्रह-id -> कम-से-कम एक सिद्ध-float लिख हुआ
                              // (सकारात्मक प्रमाण — केवल !बुरा काफी नहीं, वरना
                              //  हर मान-typed तत्व वाली स्थानीय सूची गलत-दशमलव)

    // बीज: निर्मक-नक्शा; born-local संग्रह (प्रप_नहीं_नक्शा के स्थानीय जैसा):
    // नव_सूची/नव_शब्दकोश/सूची_रचना/शब्दकोश_रचना/सूची_जोड़-परिणाम आशावादी जन्म;
    // phi तभी जब सूचीसेट में (यानी सब स्रोत ज्ञात-संग्रह) — नीचे fixpoint घटाता।
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) {
            निर्मक[फस[फ]["आईडी"]] = फस[फ];
            यदि (सूचीसेट[फस[फ]["आईडी"]] == सत्य) { जन्म[फस[फ]["आईडी"]] = सत्य; }
            फ = फ + १;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            यदि (आ >= १) { निर्मक[आ] = इ; }
            पाठ को = इ["कोड"];
            यदि ((को == "नव_सूची" || को == "नव_शब्दकोश") && आ >= १) { जन्म[आ] = सत्य; }
            यदि (को == "बुलाओ" && आ >= १ &&
                (इ["अंश"]["लक्ष्य"] == "सूची_रचना" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_रचना"
                 || इ["अंश"]["लक्ष्य"] == "सूची_जोड़")) { जन्म[आ] = सत्य; }
            नि = नि + १;
        }
        ख = ख + १;
    }

    // नेस्टेड सूची-लिटरल के पत्ता-पठन: बंद-संरचना प्रमाण से सीधे दशम-बीज (ऊपर देखो
    // प्रप_नेस्टेड_बंद_पत्ते) — जन्म/बुरा/दशमी से स्वतंत्र, उन्हें छूता नहीं
    ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            यदि (इ["कोड"] == "नव_सूची" && इ["आईडी"] >= १) {
                संख्या गह = प्रप_नेस्टेड_ऊँचाई(निर्मक, इ["आईडी"], ०);
                यदि (गह >= २) {
                    सूची पत्ते = प्रप_नेस्टेड_बंद_पत्ते(फलन, निर्मक, इ["आईडी"], गह);
                    संख्या प = ०;
                    यावत् (प < लंबाई(पत्ते)) { दशम[पत्ते[प]] = सत्य; प = प + १; }
                }
            }
            नि = नि + १;
        }
        ख = ख + १;
    }

    // escape बीज: संग्रह-id जो असुरक्षित जगह उपयोग → बुरा
    ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            सूची ऑप = इ["संचालक"];
            यदि (को == "बुलाओ") {
                पाठ लक्ष्य = इ["अंश"]["लक्ष्य"];
                यदि (लक्ष्य == "सूची_जोड़") {
                    // op[०] एक संग्रह — इसका परिणाम भी वही संग्रह (alias)
                } अन्यथा यदि (लक्ष्य == "सूची_सूचकांक_सेट" || लक्ष्य == "शब्दकोश_सेट" || लक्ष्य == "शब्दकोश_डाल") {
                    // op[०] संग्रह — mutate ठीक (लिख जाँच नीचे)
                } अन्यथा यदि (न प्रप_दशम_सुरक्षित_कॉल(लक्ष्य)) {
                    संख्या क = ०;
                    यावत् (क < लंबाई(ऑप)) { यदि (ऑप[क] >= १) { बुरा[ऑप[क]] = सत्य; } क = क + १; }
                }
            } अन्यथा यदि (को == "लिख_अनुक्रम") {
                // op[०] संग्रह mutate; op[२] मान — यदि op[२] खुद संग्रह हो (nested) तो वह escape
                यदि (लंबाई(ऑप) >= ३ && ऑप[२] >= १) { बुरा[ऑप[२]] = सत्य; }
            } अन्यथा यदि (को == "लिख_वैश्विक" || को == "लिख_क्षेत्र") {
                यदि (लंबाई(ऑप) >= १ && ऑप[०] >= १) { बुरा[ऑप[०]] = सत्य; }
                यदि (लंबाई(ऑप) >= २ && ऑप[१] >= १) { बुरा[ऑप[१]] = सत्य; }
            } अन्यथा यदि (को == "बुलाओ" || को == "विधि_बुलाओ" || को == "नव_वस्तु" || को == "नव_सूची" || को == "नव_शब्दकोश") {
                // (बुलाओ ऊपर संभाला) — नव_* में संग्रह-operand nested
                यदि (को != "बुलाओ") {
                    संख्या क = ०;
                    यावत् (क < लंबाई(ऑप)) { यदि (ऑप[क] >= १) { बुरा[ऑप[क]] = सत्य; } क = क + १; }
                }
            }
            नि = नि + १;
        }
        यदि (खस[ख]["अंत"] != शून्यम् && खस[ख]["अंत"]["कोड"] == "वापस") {
            सूची रऑप = खस[ख]["अंत"]["संचालक"];
            यदि (लंबाई(रऑप) >= १ && रऑप[०] >= १) { बुरा[रऑप[०]] = सत्य; }
        }
        ख = ख + १;
    }

    // चरण A: केवल जन्म + बुरा को fixpoint तक। दशम को यहाँ मत छुओ — बुरा जन्म से
    // धीमा फैलता (सूची_जोड़ alias-श्रृंखला के पार), तो एक ही संयुक्त पास में
    // "जन्म[c] सत्य, बुरा[c] अभी असत्य" दिख सकता व पूर्ण-सूची गलती से दशमलव-पढ़ी
    // जाती (दशम monotone — गलत टैग कभी नहीं मिटता)।
    मान बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = ०;
        यावत् (ख < लंबाई(खस)) {
            // phi: बुरा दोनों दिशा (बढ़ता); जन्म — कोई स्रोत गैर-जन्म तो हटाओ (घटता)
            सूची फस = खस[ख]["फाई"];
            संख्या फ = ०;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                संख्या स = ०;
                यावत् (स < लंबाई(स्रोत)) {
                    संख्या सिड = स्रोत[स][१];
                    यदि (सिड >= १ && सिड != पिड) {
                        यदि (बुरा[सिड] == सत्य && बुरा[पिड] != सत्य) { बुरा[पिड] = सत्य; बदला = सत्य; }
                        यदि (बुरा[पिड] == सत्य && बुरा[सिड] != सत्य) { बुरा[सिड] = सत्य; बदला = सत्य; }
                        यदि (जन्म[पिड] == सत्य && जन्म[सिड] != सत्य) { जन्म[पिड] = असत्य; बदला = सत्य; }
                    }
                    स = स + १;
                }
                फ = फ + १;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                संख्या आ = इ["आईडी"];
                पाठ को = इ["कोड"];
                सूची ऑप = इ["संचालक"];

                // नव_सूची: तत्व-operands लिख
                यदि (को == "नव_सूची" && आ >= १ && बुरा[आ] != सत्य) {
                    संख्या क = ०;
                    यावत् (क < लंबाई(ऑप)) {
                        यदि (प्रप_दशम_नहीं_है(निर्मक, ऑप[क])) { बुरा[आ] = सत्य; बदला = सत्य; }
                        क = क + १;
                    }
                }
                अन्यथा यदि (को == "नव_शब्दकोश" && आ >= १ && बुरा[आ] != सत्य) {
                    संख्या क = १;
                    यावत् (क < लंबाई(ऑप)) {   // विषम सूचकांक = मान
                        यदि (प्रप_दशम_नहीं_है(निर्मक, ऑप[क])) { बुरा[आ] = सत्य; बदला = सत्य; }
                        क = क + २;
                    }
                }
                अन्यथा यदि (को == "लिख_अनुक्रम" && लंबाई(ऑप) >= ३) {
                    संख्या स_क = ऑप[०];
                    यदि (स_क >= १ && जन्म[स_क] == सत्य && बुरा[स_क] != सत्य && प्रप_दशम_नहीं_है(निर्मक, ऑप[२])) {
                        बुरा[स_क] = सत्य; बदला = सत्य;
                    }
                }
                अन्यथा यदि (को == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "सूची_सूचकांक_सेट" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_सेट" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_डाल") && लंबाई(ऑप) >= ३) {
                    संख्या स_क = ऑप[०];
                    यदि (स_क >= १ && जन्म[स_क] == सत्य && बुरा[स_क] != सत्य && प्रप_दशम_नहीं_है(निर्मक, ऑप[२])) {
                        बुरा[स_क] = सत्य; बदला = सत्य;
                    }
                }
                अन्यथा यदि (को == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़" && लंबाई(ऑप) >= २) {
                    संख्या स_क = ऑप[०];
                    यदि (स_क >= १ && आ >= १) {
                        यदि (बुरा[स_क] == सत्य && बुरा[आ] != सत्य) { बुरा[आ] = सत्य; बदला = सत्य; }
                        यदि (बुरा[आ] == सत्य && बुरा[स_क] != सत्य) { बुरा[स_क] = सत्य; बदला = सत्य; }
                        // परिणाम = वही संग्रह; आधार गैर-जन्म तो परिणाम भी नहीं (घटता)
                        यदि (जन्म[स_क] != सत्य && जन्म[आ] == सत्य) { जन्म[आ] = असत्य; बदला = सत्य; }
                        यदि (प्रप_दशम_नहीं_है(निर्मक, ऑप[१]) && बुरा[स_क] != सत्य) { बुरा[स_क] = सत्य; बदला = सत्य; }
                    }
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
    }

    // चरण B: जन्म/बुरा स्थिर — अब दशम (मान-स्तर float) + दशमी (संग्रह में
    // सिद्ध-float लिख) एक साथ fixpoint तक। पढ़_अनुक्रम को दशमलव तभी जब आधार
    // संग्रह जन्म && !बुरा && दशमी — यानी सकारात्मक प्रमाण कि उसमें float गया।
    // (!बुरा अकेला काफ़ी नहीं: मान-typed तत्व वाली स्थानीय पाठ-सूची भी !बुरा
    //  होती व उसकी पढ़ गलती से float बन जाती → स्ट्रिंग को float माना जाता।)
    बदला = सत्य;
    यावत् (बदला) {
        बदला = असत्य;
        ख = ०;
        यावत् (ख < लंबाई(खस)) {
            सूची फस = खस[ख]["फाई"];
            संख्या फ = ०;
            यावत् (फ < लंबाई(फस)) {
                संख्या पिड = फस[फ]["आईडी"];
                सूची स्रोत = फस[फ]["अंश"]["स्रोत"];
                संख्या स = ०;
                यावत् (स < लंबाई(स्रोत)) {
                    संख्या सिड = स्रोत[स][१];
                    यदि (सिड >= १ && सिड != पिड) {
                        यदि (प्रप_दशम_है(निर्मक, दशम, सिड) && दशम[पिड] != सत्य) { दशम[पिड] = सत्य; बदला = सत्य; }
                        यदि (दशमी[सिड] == सत्य && दशमी[पिड] != सत्य) { दशमी[पिड] = सत्य; बदला = सत्य; }
                        यदि (दशमी[पिड] == सत्य && दशमी[सिड] != सत्य) { दशमी[सिड] = सत्य; बदला = सत्य; }
                    }
                    स = स + १;
                }
                फ = फ + १;
            }
            सूची निस = खस[ख]["निर्देश"];
            संख्या नि = ०;
            यावत् (नि < लंबाई(निस)) {
                शब्दकोश इ = निस[नि];
                संख्या आ = इ["आईडी"];
                पाठ को = इ["कोड"];
                सूची ऑप = इ["संचालक"];

                // दशमी बीज: संग्रह में सिद्ध-float तत्व लिखा गया
                यदि (को == "नव_सूची" && आ >= १ && दशमी[आ] != सत्य) {
                    संख्या क = ०;
                    यावत् (क < लंबाई(ऑप)) {
                        यदि (प्रप_दशम_है(निर्मक, दशम, ऑप[क])) { दशमी[आ] = सत्य; बदला = सत्य; }
                        क = क + १;
                    }
                }
                अन्यथा यदि (को == "नव_शब्दकोश" && आ >= १ && दशमी[आ] != सत्य) {
                    संख्या क = १;
                    यावत् (क < लंबाई(ऑप)) {
                        यदि (प्रप_दशम_है(निर्मक, दशम, ऑप[क])) { दशमी[आ] = सत्य; बदला = सत्य; }
                        क = क + २;
                    }
                }
                अन्यथा यदि (को == "लिख_अनुक्रम" && लंबाई(ऑप) >= ३ && ऑप[०] >= १
                          && दशमी[ऑप[०]] != सत्य && प्रप_दशम_है(निर्मक, दशम, ऑप[२])) {
                    दशमी[ऑप[०]] = सत्य; बदला = सत्य;
                }
                अन्यथा यदि (को == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "सूची_सूचकांक_सेट" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_सेट" || इ["अंश"]["लक्ष्य"] == "शब्दकोश_डाल")
                          && लंबाई(ऑप) >= ३ && ऑप[०] >= १ && दशमी[ऑप[०]] != सत्य && प्रप_दशम_है(निर्मक, दशम, ऑप[२])) {
                    दशमी[ऑप[०]] = सत्य; बदला = सत्य;
                }
                अन्यथा यदि (को == "बुलाओ" && इ["अंश"]["लक्ष्य"] == "सूची_जोड़" && लंबाई(ऑप) >= २ && ऑप[०] >= १ && आ >= १) {
                    संख्या स_क = ऑप[०];
                    यदि (प्रप_दशम_है(निर्मक, दशम, ऑप[१])) {
                        यदि (दशमी[स_क] != सत्य) { दशमी[स_क] = सत्य; बदला = सत्य; }
                    }
                    यदि (दशमी[स_क] == सत्य && दशमी[आ] != सत्य) { दशमी[आ] = सत्य; बदला = सत्य; }
                    यदि (दशमी[आ] == सत्य && दशमी[स_क] != सत्य) { दशमी[स_क] = सत्य; बदला = सत्य; }
                }
                // पढ़_अनुक्रम / शब्दकोश_पाओ from सिद्ध-float संग्रह → दशम
                अन्यथा यदि (को == "पढ़_अनुक्रम" && आ >= १ && लंबाई(ऑप) >= १ && दशम[आ] != सत्य) {
                    संख्या स_क = ऑप[०];
                    मान आप = इ["अंश"]["आधार_प्रकार"];
                    यदि ((आप == "सूची" || आप == "शब्दकोश") && जन्म[स_क] == सत्य && बुरा[स_क] != सत्य && दशमी[स_क] == सत्य) {
                        दशम[आ] = सत्य; बदला = सत्य;
                    }
                }
                अन्यथा यदि (को == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "शब्दकोश_पाओ" || इ["अंश"]["लक्ष्य"] == "सूची_सूचकांक") && आ >= १ && लंबाई(ऑप) >= १ && दशम[आ] != सत्य) {
                    संख्या स_क = ऑप[०];
                    यदि (जन्म[स_क] == सत्य && बुरा[स_क] != सत्य && दशमी[स_क] == सत्य) { दशम[आ] = सत्य; बदला = सत्य; }
                }
                // व्युत्पन्न अंकगणित: दोनों अंक-operand सिद्ध-float → परिणाम float
                अन्यथा यदि ((को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष")
                          && आ >= १ && दशम[आ] != सत्य && लंबाई(ऑप) >= २ && इ["प्रकार"] != "पाठ") {
                    यदि (प्रप_दशम_है(निर्मक, दशम, ऑप[०]) && प्रप_दशम_है(निर्मक, दशम, ऑप[१])) {
                        दशम[आ] = सत्य; बदला = सत्य;
                    }
                }
                नि = नि + १;
            }
            ख = ख + १;
        }
    }
    परत् दशम;
}

// लागू: retype + विधि + call-swap (कोई नया निर्देश नहीं — केवल टैग/लक्ष्य बदल)
कार्य प्रप_दशम_लागू(शब्दकोश फलन, शब्दकोश दशम) {
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) {
            यदि (दशम[फस[फ]["आईडी"]] == सत्य) {
                मान त = फस[फ]["प्रकार"];
                यदि (त == शून्यम् || त == "मान" || त == "पूर्ण") { फस[फ]["प्रकार"] = "दशमलव"; }
            }
            फ = फ + १;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            संख्या आ = इ["आईडी"];
            पाठ को = इ["कोड"];

            यदि (आ >= १ && दशम[आ] == सत्य) {
                यदि (को == "पढ़_अनुक्रम") {
                    मान त = इ["प्रकार"];
                    यदि (त == शून्यम् || त == "मान" || त == "पूर्ण") { इ["प्रकार"] = "दशमलव"; }
                }
                अन्यथा यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष") {
                    इ["प्रकार"] = "दशमलव";
                    इ["अंश"]["विधि"] = "दशमलव";
                }
                अन्यथा यदि (को == "बुलाओ" && (इ["अंश"]["लक्ष्य"] == "शब्दकोश_पाओ" || इ["अंश"]["लक्ष्य"] == "सूची_सूचकांक")) {
                    मान त = इ["प्रकार"];
                    यदि (त == शून्यम् || त == "मान" || त == "पूर्ण") { इ["प्रकार"] = "दशमलव"; }
                }
            }

            // गतिशील_छापो / गतिशील_से_पाठ पर float तर्क → दशमलव-रूप
            यदि (को == "बुलाओ" && लंबाई(इ["संचालक"]) >= १ && दशम[इ["संचालक"][०]] == सत्य) {
                यदि (इ["अंश"]["लक्ष्य"] == "गतिशील_छापो") { इ["अंश"]["लक्ष्य"] = "दशमलव_छापो"; }
                अन्यथा यदि (इ["अंश"]["लक्ष्य"] == "गतिशील_से_पाठ") { इ["अंश"]["लक्ष्य"] = "दशमलव_से_पाठ"; }
            }

            // str-concat: `योग` result=पाठ जिसका एक operand दशमलव → उत्सर्जक में
            // पाठ_दश_दायाँ/बायाँ बुलाता। नोड "योग" ही रहता (कोड/संचालक अपरिवर्तित),
            // केवल विधि-टैग बदलता — serialization-सुरक्षित व idempotent (योग→बुलाओ
            // rewrite malformed बुलाओ बनाता जो क्रमबद्धन से नहीं बचता)।
            यदि (को == "योग" && इ["प्रकार"] == "पाठ" && लंबाई(इ["संचालक"]) >= २) {
                संख्या ब0 = इ["संचालक"][०];
                संख्या ब1 = इ["संचालक"][१];
                यदि (ब1 >= १ && दशम[ब1] == सत्य) {
                    इ["अंश"]["विधि"] = "दश_दायाँ";
                } अन्यथा यदि (ब0 >= १ && दशम[ब0] == सत्य) {
                    इ["अंश"]["विधि"] = "दश_बायाँ";
                }
            }

            नि = नि + १;
        }
        ख = ख + १;
    }
    परत् ०;
}

// एक फलन के प्रकार-टैग प्रसारित करो
कार्य प्रप_फलन(शब्दकोश फलन) {
    शब्दकोश सूचीसेट = प्रप_सूची_सेट(फलन);
    शब्दकोश नहीं = प्रप_नहीं_नक्शा(फलन, सूचीसेट);
    सूची खस = फलन["खंड_सूची"];
    संख्या ख = ०;
    यावत् (ख < लंबाई(खस)) {
        सूची फस = खस[ख]["फाई"];
        संख्या फ = ०;
        यावत् (फ < लंबाई(फस)) {
            संख्या पिड = फस[फ]["आईडी"];
            यदि (पिड >= १ && नहीं[पिड] != सत्य) {
                मान वर्त = फस[फ]["प्रकार"];
                यदि (वर्त == शून्यम् || वर्त == "मान") { फस[फ]["प्रकार"] = "पूर्ण"; }
            }
            फ = फ + १;
        }
        सूची निस = खस[ख]["निर्देश"];
        संख्या नि = ०;
        यावत् (नि < लंबाई(निस)) {
            शब्दकोश इ = निस[नि];
            पाठ को = इ["कोड"];
            संख्या आ = इ["आईडी"];
            यदि (आ >= १ && नहीं[आ] != सत्य) {
                यदि (को == "योग" || को == "अंतर" || को == "गुणा" || को == "भाग" || को == "शेष") {
                    मान वर्त = इ["प्रकार"];
                    यदि (वर्त == शून्यम् || वर्त == "मान") { इ["प्रकार"] = "पूर्ण"; }
                    मान वि = इ["अंश"]["विधि"];
                    यदि (वि == शून्यम् || वि == "मान") { इ["अंश"]["विधि"] = "पूर्ण"; }
                }
                अन्यथा यदि (को == "पढ़_अनुक्रम") {
                    मान वर्त = इ["प्रकार"];
                    यदि (वर्त == शून्यम् || वर्त == "मान") { इ["प्रकार"] = "पूर्ण"; }
                }
            }
            नि = नि + १;
        }
        ख = ख + १;
    }

    // दशमलव संग्रह-तत्व प्रसार (पूर्णांक-प्रसार के बाद — पूर्ण→दशमलव override करता)
    शब्दकोश दशम = प्रप_दशम_नक्शा(फलन, सूचीसेट);
    प्रप_दशम_लागू(फलन, दशम);
    परत् ०;
}

// मॉड्यूल-व्यापी — हर फलन पर प्रसार (परत्_प्रकार_अनुमान के बाद, उत्सर्जक
// से पहले, ताकि रजि_नियतक की GC-root चयन इसे देखे)
कार्य प्रकार_प्रसार_एकक(शब्दकोश एकक) {
    सूची कस = एकक["कार्य_सूची"];
    संख्या इ = ०;
    यावत् (इ < लंबाई(कस)) {
        प्रप_फलन(कस[इ]);
        इ = इ + १;
    }
    परत् एकक;
}
