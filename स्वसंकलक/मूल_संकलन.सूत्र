// मूल_संकलन.सूत्र — मूल संकलन ड्राइवर (सूत्र native compiler)
// सूत्र स्रोत → पद_विच्छेदन → विश्लेषण → सार्थक → IR (निम्नक → अनुकूलक →
// रजि_नियतक → उत्सर्जक) → x86-64 GAS assembly → as → gcc(linker) → .exe
// C++ का कोई प्रयोग नहीं। gcc केवल linker।
//
// पुराना मूल_सर्जक (O(n²)-स्मृति stack-machine codegen) हटा दिया गया —
// अब यही IR-backend default है। fixed point: Gen2 .s == Gen3 .s।

आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "परत्_प्रकार_अनुमान.सूत्र";
आयात "पाठ_संचायक.सूत्र";
आयात "प्रकार_प्रसार.सूत्र";
आयात "लूप_अनुकूलन.सूत्र";
आयात "पुच्छ_अनुकूलन.सूत्र";
आयात "अंतर्वेशन.सूत्र";
आयात "रजि_नियतक.सूत्र";
आयात "मूल_उत्सर्जक.सूत्र";
आयात "एलएलवीएम_उत्सर्जक.सूत्र";   // --release path (LLVM backend)

// (पहले मूल_सर्जक में था) — ASCII-कोड सूची से पाठ
कार्य अक्षर_सूची_से_पाठ(सूची कोड्स) {
    मान परिणाम = "";
    संख्या सूचक = 0;
    यावत् (सूचक < लंबाई(कोड्स)) {
        परिणाम = परिणाम + अक्षर_निर्माण(कोड्स[सूचक]);
        सूचक = सूचक + 1;
    }
    परत् परिणाम;
}

// --release: एक .सूत्र स्रोत-फ़ाइल → LLVM IR पाठ (in-process, अग्र_चालक जैसा —
// सार्थक_विश्लेषण नहीं, runtime मॉड्यूल trusted + अंतर्_* whitelist नहीं चाहिए)
कार्य रिलीज़_स्रोत_एलएल(पाठ प) {
    सूची पद = पद_विच्छेदन(सञ्चिका_पठतु(प));
    शब्दकोश अव = {};
    अव["पद_सूची"] = पद;
    अव["अनुक्रमणिका"] = 0;
    अव["कुल_पद"] = लंबाई(पद);
    शब्दकोश प्रो = प्रोग्राम_पार्स(अव, {}, प);
    शब्दकोश ए = निम्नक_एकक(प्रो);
    अनुकूलक_एकक(ए);
    परत्_प्रकार_अनुमान_एकक(ए);
    पुच्छ_अनुकूलन_एकक(ए);
    अंतर्वेशन_एकक(ए);
    पाठ_संचायक_एकक(ए);
    प्रकार_प्रसार_एकक(ए);
    परत् एलएलवीएम_उत्सर्जक_एकक(ए);
}
कार्य रिलीज़_निर्माण_पथ(पाठ नाम) {
    पाठ अ = "स्वसंकलक/निर्माण/" + नाम;
    यदि (सञ्चिका_अस्ति(अ)) { परत् अ; }
    परत् "निर्माण/" + नाम;
}

// "C:\msys64\ucrt64\bin\" (बैकस्लैश → अक्षर-कोड, lexer escape से बचाव)
कार्य मस_बिन() {
    परत् अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92]);
}

// --pgo: दो-चरण profile-guided build। (1) instrumented .o + throwaway exe
// (clang driver → CRT+libc+libclang_rt.profile; तल.s का mainCRTStartup/mem*
// CRT से टकराता → --allow-multiple-definition), (2) प्रशिक्षण चलाओ → .profraw,
// (3) llvm-profdata merge, (4) -fprofile-use से अंतिम .o। अंतिम .o सामान्य
// -nostdlib लिंक से जुड़ता — profile runtime सिर्फ़ throwaway exe में, अंतिम
// binary अब भी सिर्फ़ KERNEL32+SHELL32 import करता।
कार्य पीजीओ_संकलन(पाठ बीसी_मार्ग, पाठ ओ_मार्ग, पाठ प्रशिक्षण_तर्क) {
    मान क्लैंग = मस_बिन() + "clang.exe ";
    कमांड_चलाओ("del /q pgo_inst.o pgo_inst.exe pgo_floor.s pgo_floor.o pgo.profdata 2>nul");
    कमांड_चलाओ("if exist pgo_prof rd /s /q pgo_prof");

    // -fprofile-generate=pgo_prof बेक करता है path pgo_prof/default_<hash>.profraw
    // → प्रशिक्षण रन को कोई env-var नहीं चाहिए
    लिखतु("   PGO 1/4: instrumented संकलन + लिंक...");
    यदि (कमांड_चलाओ(क्लैंग + "-O3 -fprofile-generate=pgo_prof -c " + बीसी_मार्ग + " -o pgo_inst.o") != 0) {
        प्रक्षेपः "त्रुटिः — PGO instrument संकलन विफल।";
    }
    मान तल_प = "स्वसंकलक/निर्माण/तल.s";
    यदि (न सञ्चिका_अस्ति(तल_प)) { तल_प = "निर्माण/तल.s"; }
    सञ्चिका_लिखतु("pgo_floor.s", सञ्चिका_पठतु(तल_प));
    यदि (कमांड_चलाओ(मस_बिन() + "as.exe -o pgo_floor.o pgo_floor.s") != 0) {
        प्रक्षेपः "त्रुटिः — PGO तल.s संयोजन विफल।";
    }
    यदि (कमांड_चलाओ(क्लैंग + "-fprofile-generate=pgo_prof pgo_inst.o pgo_floor.o -lkernel32 -lshell32 -Wl,--allow-multiple-definition -o pgo_inst.exe") != 0) {
        प्रक्षेपः "त्रुटिः — PGO instrumented लिंक विफल।";
    }

    // .\ उपसर्ग — bare नाम cwd-in-PATH पर निर्भर करता (कुछ setups में बंद)
    मान रन = अक्षर_सूची_से_पाठ([46,92]) + "pgo_inst.exe";
    यदि (प्रशिक्षण_तर्क != "") { रन = रन + " " + प्रशिक्षण_तर्क; }
    लिखतु("   PGO 2/4: प्रशिक्षण रन — " + रन);
    कमांड_चलाओ(रन);

    लिखतु("   PGO 3/4: llvm-profdata merge...");
    यदि (कमांड_चलाओ(मस_बिन() + "llvm-profdata.exe merge -output=pgo.profdata pgo_prof") != 0
        || न सञ्चिका_अस्ति("pgo.profdata")) {
        प्रक्षेपः "त्रुटिः — PGO merge विफल (कोई .profraw नहीं? --pgo-run प्रशिक्षण कमांड जाँचो)।";
    }

    लिखतु("   PGO 4/4: -fprofile-use पुनः-संकलन...");
    यदि (कमांड_चलाओ(क्लैंग + "-O3 -fprofile-use=pgo.profdata -Wno-profile-instr-unprofiled -c " + बीसी_मार्ग + " -o " + ओ_मार्ग) != 0
        || न सञ्चिका_अस्ति(ओ_मार्ग)) {
        प्रक्षेपः "त्रुटिः — PGO अंतिम संकलन विफल।";
    }
    कमांड_चलाओ("del /q pgo_inst.o pgo_inst.exe pgo_floor.s pgo_floor.o 2>nul");
    कमांड_चलाओ("if exist pgo_prof rd /s /q pgo_prof");
    परत् 0;
}

कार्य मुख्य() {
    मान मार्गः = "";
    मान तर्काः_सूची = तर्काः();
    // ध्वज-स्कैन: --release → LLVM backend; --pgo [--pgo-run "<cmd>"] → दो-चरण
    // profile-guided build (केवल --release के साथ); मार्ग = अंतिम non-ध्वज तर्क
    मान रिलीज़ = असत्य;
    मान पीजीओ = असत्य;
    मान पीजीओ_कमांड = "";
    संख्या तइ = 1;
    यावत् (तइ < लंबाई(तर्काः_सूची)) {
        पाठ त = तर्काः_सूची[तइ];
        यदि (त == "--release") { रिलीज़ = सत्य; }
        अन्यथा यदि (त == "--pgo") { पीजीओ = सत्य; }
        अन्यथा यदि (त == "--pgo-run") {
            तइ = तइ + 1;
            यदि (तइ < लंबाई(तर्काः_सूची)) { पीजीओ_कमांड = तर्काः_सूची[तइ]; }
        }
        अन्यथा यदि (लंबाई(त) > 0) { मार्गः = त; }
        तइ = तइ + 1;
    }
    यदि (पीजीओ && न रिलीज़) {
        लिखतु("चेतावनी: --pgo को --release चाहिए — अनदेखा किया।");
        पीजीओ = असत्य;
    }
    यदि (मार्गः == "") {
        लिखतु("त्रुटिः — सञ्चिका मार्गः न निर्दिष्टः।");
        परत्;
    }

    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        लिखतु("त्रुटिः — सञ्चिका न प्राप्ता: " + मार्गः);
        परत्;
    }

    मान स्रोत_पाठ = सञ्चिका_पठतु(मार्गः);
    लिखतु("=== मूल संकलन ===");
    लिखतु("सञ्चिका: " + मार्गः);

    // NOTE: प्रयत्न/पकड़ो अभी IR path में lower नहीं होता — त्रुटि सीधे
    // प्रक्षेपित होती है (runtime उसे छापकर निकास करता)।

    // चरण 1: पद विच्छेदन
    लिखतु("1. पद_विच्छेदन...");
    सूची पद_सूची = पद_विच्छेदन(स्रोत_पाठ);
    लिखतु("   पदों की संख्या: " + लंबाई(पद_सूची));

    // चरण 2: विश्लेषण
    लिखतु("2. विश्लेषण...");
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = 0;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश आयातित_सञ्चिकाः = {};
    शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित_सञ्चिकाः, मार्गः);
    लिखतु("   विश्लेषण संपन्नम्।");

    // चरण 2.5: सार्थक विश्लेषण
    लिखतु("2.5 सार्थक_विश्लेषण...");
    मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
    लिखतु("    सार्थक_विश्लेषण संपन्नम्।");

    // चरण 3: IR pipeline — निम्नक → अनुकूलक → परत्_प्रकार → पुच्छ → अंतर्वेशन
    यदि (रिलीज़) { लिखतु("3. IR उत्पन्न (--release → LLVM backend)..."); }
    अन्यथा { लिखतु("3. IR उत्पन्न (निम्नक → अनुकूलक → रजि_नियतक → उत्सर्जक)..."); }
    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम_नोड);
    अनुकूलक_एकक(एकक);
    परत्_प्रकार_अनुमान_एकक(एकक);
    पुच्छ_अनुकूलन_एकक(एकक);
    अंतर्वेशन_एकक(एकक);
    पाठ_संचायक_एकक(एकक);
    प्रकार_प्रसार_एकक(एकक);

    मान ओ_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,111]);
    // बासी .o हटाओ (दोनों path)
    कमांड_चलाओ(अक्षर_सूची_से_पाठ([100,101,108,32,47,113,32,115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,111,32,50,62,110,117,108]));

    यदि (रिलीज़) {
        // --release: user IR + runtime मॉड्यूल दोनों → LLVM IR पाठ →
        // llvm-link (whole-module) → clang -O2 -c (cross-module inline) → .o
        मान एल_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,108,108]);
        मान रट_एल = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,114,116,46,108,108]);
        मान आव_एल = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,97,108,46,108,108]);
        मान बीसी_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,98,99]);
        सञ्चिका_लिखतु(एल_मार्ग, एलएलवीएम_उत्सर्जक_एकक(एकक));
        लिखतु("4. runtime मॉड्यूल → LLVM IR...");
        सञ्चिका_लिखतु(रट_एल, रिलीज़_स्रोत_एलएल(रिलीज़_निर्माण_पथ("मूल_रनटाइम.सूत्र")));
        सञ्चिका_लिखतु(आव_एल, रिलीज़_स्रोत_एलएल(रिलीज़_निर्माण_पथ("मूल_आवंटक.सूत्र")));
        लिखतु("5. llvm-link + clang -O2...");
        // "C:\msys64\ucrt64\bin\llvm-link.exe " + inputs + " -o " + बीसी_मार्ग
        मान लिंक_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,108,108,118,109,45,108,105,110,107,46,101,120,101,32]) + एल_मार्ग + " " + रट_एल + " " + आव_एल + अक्षर_सूची_से_पाठ([32,45,111,32]) + बीसी_मार्ग;
        यदि (कमांड_चलाओ(लिंक_कमांड) != 0 || न सञ्चिका_अस्ति(बीसी_मार्ग)) {
            प्रक्षेपः "त्रुटिः — llvm-link विफल।";
        }
        // "C:\msys64\ucrt64\bin\clang.exe -O3 -c " + बीसी_मार्ग + " -o " + ओ_मार्ग
        // (whole merged bitcode → -O3 IPO: internal-linkage फलनों पर DCE +
        //  विशेषीकरण + aggressive inline; #4 whole-program front)
        यदि (पीजीओ) {
            लिखतु("5b. PGO दो-चरण build...");
            पीजीओ_संकलन(बीसी_मार्ग, ओ_मार्ग, पीजीओ_कमांड);
        } अन्यथा {
            मान क्लैंग_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,99,108,97,110,103,46,101,120,101,32,45,79,51,32,45,99,32]) + बीसी_मार्ग + अक्षर_सूची_से_पाठ([32,45,111,32]) + ओ_मार्ग;
            मान क्लैंग_कोड = कमांड_चलाओ(क्लैंग_कमांड);
            यदि (क्लैंग_कोड != 0 || न सञ्चिका_अस्ति(ओ_मार्ग)) {
                प्रक्षेपः "त्रुटिः — clang संयोजन विफल।";
            }
        }
    } अन्यथा {
        // default: सूत्र IR → x86-64 GAS पाठ → as → .o
        मान संयोजन_कोड = उत्सर्जक_एकक(एकक);
        मान स_मार्ग = अक्षर_सूची_से_पाठ([115,117,116,114,97,95,110,97,116,105,118,101,95,116,101,109,112,46,115]);
        सञ्चिका_लिखतु(स_मार्ग, संयोजन_कोड);
        लिखतु("4. सञ्चिका: " + स_मार्ग);
        लिखतु("5. संयोजन...");
        मान संयोजक_कमांड = अक्षर_सूची_से_पाठ([67,58,92,109,115,121,115,54,52,92,117,99,114,116,54,52,92,98,105,110,92,97,115,46,101,120,101,32,45,111,32]) + ओ_मार्ग + " " + स_मार्ग;
        मान असेम_कोड = कमांड_चलाओ(संयोजक_कमांड);
        यदि (असेम_कोड != 0 || न सञ्चिका_अस्ति(ओ_मार्ग)) {
            प्रक्षेपः "त्रुटिः — संयोजन विफल।";
        }
    }
    लिखतु("   संयोजन संपन्नम्।");

    // चरण 5.5: OS-तल (तल.s) → sutra_floor.o
    मान तल_स्रोत = "स्वसंकलक/निर्माण/तल.s";
    यदि (न सञ्चिका_अस्ति(तल_स्रोत)) { तल_स्रोत = "निर्माण/तल.s"; }
    यदि (सञ्चिका_अस्ति(तल_स्रोत)) {
        मान तल_पाठ = सञ्चिका_पठतु(तल_स्रोत);
        मान तल_अस्थायी = अक्षर_सूची_से_पाठ([115,102,108,111,111,114,95,116,101,109,112,46,115]);
