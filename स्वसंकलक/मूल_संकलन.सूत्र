// मूल_संकलन.सूत्र — मूल संकलन ड्राइवर (सूत्र native compiler)
// सूत्र स्रोत → पद_विच्छेदन → विश्लेषण → सार्थक → IR (निम्नक → अनुकूलक →
// रजि_नियतक → उत्सर्जक) → x86-64 GAS assembly → as → gcc(linker) → .exe
// C++ का कोई प्रयोग नहीं। gcc केवल linker।
//
// पुराना मूल_सर्जक (O(n²)-स्मृति stack-machine codegen) हटा दिया गया —
// अब यही IR-backend default है। fixed point: Gen2 .s == Gen3 .s।

आयात "विश्लेषक.सूत्र";
आयात "सार्थक_विश्लेषक.सूत्र";
आयात "मध्यम.सूत्र";
आयात "मूल_निम्नक.सूत्र";
आयात "अनुकूलक.सूत्र";
आयात "बिंदु_विश्लेषण.सूत्र";
आयात "परत्_प्रकार_अनुमान.सूत्र";
आयात "पाठ_संचायक.सूत्र";
आयात "प्रकार_प्रसार.सूत्र";
आयात "लूप_अनुकूलन.सूत्र";
आयात "पुच्छ_अनुकूलन.सूत्र";
आयात "अंतर्वेशन.सूत्र";
आयात "रजि_नियतक.सूत्र";
आयात "मूल_उत्सर्जक.सूत्र";
आयात "एलएलवीएम_उत्सर्जक.सूत्र";   // --release path (LLVM backend)
आयात "फ्रीस्टैंडिंग.सूत्र";        // --freestanding सुरक्षा-द्वार + निष्कर्षण

// (पहले मूल_सर्जक में था) — ASCII-कोड सूची से पाठ

कार्य संख्या_देवनागरी(संख्या संख्या_मान) {
    यदि (संख्या_मान == ०) { परत् "०"; }
    पाठ फल = "";
    संख्या मान_न = संख्या_मान;
    यदि (मान_न < ०) { मान_न = ० - मान_न; }
    यावत् (मान_न > ०) {
        संख्या शेष = मान_न % १०;
        यदि (शेष == ०) { फल = "०" + फल; }
        अन्यथा यदि (शेष == १) { फल = "१" + फल; }
        अन्यथा यदि (शेष == २) { फल = "२" + फल; }
        अन्यथा यदि (शेष == ३) { फल = "३" + फल; }
        अन्यथा यदि (शेष == ४) { फल = "४" + फल; }
        अन्यथा यदि (शेष == ५) { फल = "५" + फल; }
        अन्यथा यदि (शेष == ६) { फल = "६" + फल; }
        अन्यथा यदि (शेष == ७) { फल = "७" + फल; }
        अन्यथा यदि (शेष == ८) { फल = "८" + फल; }
        अन्यथा यदि (शेष == ९) { फल = "९" + फल; }
        मान_न = मान_न / १०;
    }
    यदि (संख्या_मान < ०) { फल = "-" + फल; }
    परत् फल;
}

कार्य अक्षर_सूची_से_पाठ(सूची कोड्स) {
    मान परिणाम = "";
    संख्या सूचक = ०;
    यावत् (सूचक < लंबाई(कोड्स)) {
        परिणाम = परिणाम + अक्षर_निर्माण(कोड्स[सूचक]);
        सूचक = सूचक + १;
    }
    परत् परिणाम;
}

कार्य फ्री_हेक्स_पद(पाठ ह) {
    संख्या परिणामः = ०;
    संख्या इ = ०;
    यावत् (इ < लंबाई(ह)) {
        संख्या अ = अक्षर_मान(उपखंड(ह, इ, इ + १));
        संख्या अंक = ०;
        यदि (अ >= ४८ && अ <= ५७) { अंक = अ - ४८; }
        अन्यथा यदि (अ >= ९७ && अ <= १०२) { अंक = अ - ९७ + १०; }
        अन्यथा यदि (अ >= ६५ && अ <= ७०) { अंक = अ - ६५ + १०; }
        परिणामः = परिणामः * १६ + अंक;
        इ = इ + १;
    }
    परत् परिणामः;
}

// पंक्ति को श्वेतांतराल (space) से टोकनों में तोड़ो — objdump की तालिका
// स्तंभ-चौड़ाई बदलती रहती है, इसलिए विभाजित() के बजाय मैन्युअल स्कैन
कार्य फ्री_श्वेत_टोकन(पाठ पंक्ति) {
    सूची टोकन = [];
    संख्या इ = ०;
    संख्या ल = लंबाई(पंक्ति);
    यावत् (इ < ल) {
        यावत् (इ < ल && अक्षर_मान(उपखंड(पंक्ति, इ, इ + १)) == ३२) { इ = इ + १; }
        संख्या शुरू = इ;
        यावत् (इ < ल && अक्षर_मान(उपखंड(पंक्ति, इ, इ + १)) != ३२) { इ = इ + १; }
        यदि (इ > शुरू) { टोकन = जोड़ें(टोकन, उपखंड(पंक्ति, शुरू, इ)); }
    }
    परत् टोकन;
}

// freestanding लिंक: कोई kernel32/shell32/GC-रनटाइम नहीं — केवल sutra_main
// (+ जो अन्य फलन उसने बुलाए, फ्रीस्टैंडिंग_जाँच_एकक द्वारा पहले ही सुरक्षित
// सिद्ध) — फिर linked .exe से .text खंड निकाल कर raw flat binary बनाओ।
कार्य फ्रीस्टैंडिंग_लिंक(पाठ ओ_मार्ग, पाठ आधार_नाम) {
    लिखतु("६. freestanding लिंक (कोई OS/kernel32 नहीं)...");
    पाठ अ_एक्सई = "sutra_fs_temp.exe";
    कमांड_चलाओ("del /q " + अ_एक्सई + " 2>nul");
    पाठ लिंक_कमांड = "C:/msys64/ucrt64/bin/gcc.exe -m64 -nostdlib -Wl,--entry=sutra_main -o " + अ_एक्सई + " " + ओ_मार्ग;
    यदि (कमांड_चलाओ(लिंक_कमांड) != ० || न सञ्चिका_अस्ति(अ_एक्सई)) {
        प्रक्षेपः "त्रुटिः — freestanding लिंक विफल (कोई अनुमत-सूची-से-बाहर प्रतीक प्रयुक्त हुआ होगा)।";
    }

    लिखतु("७. .text खंड निकालो...");
    पाठ खंड_सञ्चिका = "sutra_fs_sections.txt";
    कमांड_चलाओ("del /q " + खंड_सञ्चिका + " 2>nul");
    कमांड_चलाओ("C:/msys64/ucrt64/bin/objdump.exe -h " + अ_एक्सई + " > " + खंड_सञ्चिका);
    यदि (न सञ्चिका_अस्ति(खंड_सञ्चिका)) {
        प्रक्षेपः "त्रुटिः — objdump विफल (सञ्चिका नहीं बनी)।";
    }

    पाठ सामग्री = सञ्चिका_पठतु(खंड_सञ्चिका);
    सूची पंक्तियाँ = विभाजित(सामग्री, "\n");
    संख्या साइज़_हेक्स_इ = -१;
    पाठ साइज़_हेक्स = "";
    पाठ ऑफसेट_हेक्स = "";
    संख्या पइ = ०;
    यावत् (पइ < लंबाई(पंक्तियाँ) && साइज़_हेक्स_इ < ०) {
        सूची टो = फ्री_श्वेत_टोकन(पंक्तियाँ[पइ]);
        यदि (लंबाई(टो) >= ६ && टो[१] == ".text") {
            साइज़_हेक्स = टो[२];
            ऑफसेट_हेक्स = टो[५];
            साइज़_हेक्स_इ = पइ;
        }
        पइ = पइ + १;
    }
    यदि (साइज़_हेक्स_इ < ०) {
        प्रक्षेपः "त्रुटिः — objdump आउटपुट में .text खंड नहीं मिला।";
    }

    संख्या साइज़ = फ्री_हेक्स_पद(साइज़_हेक्स);
    संख्या ऑफसेट = फ्री_हेक्स_पद(ऑफसेट_हेक्स);
    पाठ अंतिम_बिन = आधार_नाम + "_freestanding.bin";
    कमांड_चलाओ("del /q " + अंतिम_बिन + " 2>nul");
    पाठ निष्कर्षण_कमांड = "C:/msys64/usr/bin/dd.exe if=" + अ_एक्सई + " of=" + अंतिम_बिन + " bs=1 skip=" + ("" + ऑफसेट) + " count=" + ("" + साइज़) + " 2>nul";
    कमांड_चलाओ(निष्कर्षण_कमांड);
    यदि (न सञ्चिका_अस्ति(अंतिम_बिन)) {
        प्रक्षेपः "त्रुटिः — dd निष्कर्षण विफल।";
    }

    // विवेक-जाँच: हर सूत्र-फलन का पहला byte 0x55 (push %rbp) होता है — गलत
    // offset पकड़ में आ जाए, चुपचाप टूटी हुई binary न बने
    पाठ प्रथम_बाइट_पाठ = सञ्चिका_पठतु(अंतिम_बिन);
    संख्या प्रथम_बाइट = अक्षर_मान(उपखंड(प्रथम_बाइट_पाठ, ०, १));
    यदि (प्रथम_बाइट != ८५) {
        प्रक्षेपः "त्रुटिः — निकाली गई binary का पहला byte 0x55 (push rbp) नहीं है (मिला: " + प्रथम_बाइट + ") — offset/size गणना गलत हो सकती है।";
    }

    लिखतु("   निकाला गया: " + साइज़ + " बाइट्स (offset " + ऑफसेट + ")।");
    लिखतु("=== freestanding संकलन सफल! ===");
    लिखतु("   " + अंतिम_बिन + " — sutra_main से शुरू, कहीं से भी (call) किया जा सकता — कोई OS निर्भरता नहीं।");
}

// --release: एक .सूत्र स्रोत-फ़ाइल → LLVM IR पाठ (in-process, अग्र_चालक जैसा —
// सार्थक_विश्लेषण नहीं, runtime मॉड्यूल trusted + अंतर्_* whitelist नहीं चाहिए)
कार्य रिलीज़_स्रोत_एलएल(पाठ प) {
    सूची पद = पद_विच्छेदन(सञ्चिका_पठतु(प));
    शब्दकोश अव = {};
    अव["पद_सूची"] = पद;
    अव["अनुक्रमणिका"] = ०;
    अव["कुल_पद"] = लंबाई(पद);
    शब्दकोश प्रो = प्रोग्राम_पार्स(अव, {}, प);
    शब्दकोश ए = निम्नक_एकक(प्रो);
    अनुकूलक_एकक(ए);
    परत्_प्रकार_अनुमान_एकक(ए);
    पुच्छ_अनुकूलन_एकक(ए);
    अंतर्वेशन_एकक(ए);
    पाठ_संचायक_एकक(ए);
    प्रकार_प्रसार_एकक(ए);
    परत् एलएलवीएम_उत्सर्जक_एकक(ए);
}
कार्य रिलीज़_निर्माण_पथ(पाठ नाम) {
    पाठ अ = "स्वसंकलक/निर्माण/" + नाम;
    यदि (सञ्चिका_अस्ति(अ)) { परत् अ; }
    परत् "निर्माण/" + नाम;
}

// "C:\msys64\ucrt64\bin\" (बैकस्लैश → अक्षर-कोड, lexer escape से बचाव)
कार्य मस_बिन() {
    परत् अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२]);
}

// --pgo: दो-चरण profile-guided build। (१) instrumented .o + throwaway exe
// (clang driver → CRT+libc+libclang_rt.profile; तल.s का mainCRTStartup/mem*
// CRT से टकराता → --allow-multiple-definition), (२) प्रशिक्षण चलाओ → .profraw,
// (३) llvm-profdata merge, (४) -fprofile-use से अंतिम .o। अंतिम .o सामान्य
// -nostdlib लिंक से जुड़ता — profile runtime सिर्फ़ throwaway exe में, अंतिम
// binary अब भी सिर्फ़ KERNEL32+SHELL32 import करता।
कार्य पीजीओ_संकलन(पाठ बीसी_मार्ग, पाठ ओ_मार्ग, पाठ प्रशिक्षण_तर्क, पाठ मार्च_ध्वज) {
    मान क्लैंग = मस_बिन() + "clang.exe ";
    कमांड_चलाओ("del /q pgo_inst.o pgo_inst.exe pgo_floor.s pgo_floor.o pgo.profdata 2>nul");
    कमांड_चलाओ("if exist pgo_prof rd /s /q pgo_prof");

    // -fprofile-generate=pgo_prof बेक करता है path pgo_prof/default_<hash>.profraw
    // → प्रशिक्षण रन को कोई env-var नहीं चाहिए
    लिखतु("   PGO 1/4: instrumented संकलन + लिंक...");
    यदि (कमांड_चलाओ(क्लैंग + "-O3" + मार्च_ध्वज + " -fprofile-generate=pgo_prof -c " + बीसी_मार्ग + " -o pgo_inst.o") != ०) {
        प्रक्षेपः "त्रुटिः — PGO instrument संकलन विफल।";
    }
    मान तल_प = "स्वसंकलक/निर्माण/तल.s";
    यदि (न सञ्चिका_अस्ति(तल_प)) { तल_प = "निर्माण/तल.s"; }
    सञ्चिका_लिखतु("pgo_floor.s", सञ्चिका_पठतु(तल_प));
    यदि (कमांड_चलाओ(मस_बिन() + "as.exe -o pgo_floor.o pgo_floor.s") != ०) {
        प्रक्षेपः "त्रुटिः — PGO तल.s संयोजन विफल।";
    }
    यदि (कमांड_चलाओ(क्लैंग + "-fprofile-generate=pgo_prof pgo_inst.o pgo_floor.o -lkernel32 -lshell32 -Wl,--allow-multiple-definition -o pgo_inst.exe") != ०) {
        प्रक्षेपः "त्रुटिः — PGO instrumented लिंक विफल।";
    }

    // .\ उपसर्ग — bare नाम cwd-in-PATH पर निर्भर करता (कुछ setups में बंद)
    मान रन = अक्षर_सूची_से_पाठ([४६,९२]) + "pgo_inst.exe";
    यदि (प्रशिक्षण_तर्क != "") { रन = रन + " " + प्रशिक्षण_तर्क; }
    लिखतु("   PGO 2/4: प्रशिक्षण रन — " + रन);
    कमांड_चलाओ(रन);

    लिखतु("   PGO 3/4: llvm-profdata merge...");
    यदि (कमांड_चलाओ(मस_बिन() + "llvm-profdata.exe merge -output=pgo.profdata pgo_prof") != ०
        || न सञ्चिका_अस्ति("pgo.profdata")) {
        प्रक्षेपः "त्रुटिः — PGO merge विफल (कोई .profraw नहीं? --pgo-run प्रशिक्षण कमांड जाँचो)।";
    }

    लिखतु("   PGO 4/4: -fprofile-use पुनः-संकलन...");
    यदि (कमांड_चलाओ(क्लैंग + "-O3" + मार्च_ध्वज + " -fprofile-use=pgo.profdata -Wno-profile-instr-unprofiled -c " + बीसी_मार्ग + " -o " + ओ_मार्ग) != ०
        || न सञ्चिका_अस्ति(ओ_मार्ग)) {
        प्रक्षेपः "त्रुटिः — PGO अंतिम संकलन विफल।";
    }
    कमांड_चलाओ("del /q pgo_inst.o pgo_inst.exe pgo_floor.s pgo_floor.o 2>nul");
    कमांड_चलाओ("if exist pgo_prof rd /s /q pgo_prof");
    परत् ०;
}

कार्य मुख्य() {
    मान मार्गः = "";
    मान तर्काः_सूची = तर्काः();
    // ध्वज-स्कैन: --release → LLVM backend; --pgo [--pgo-run "<cmd>"] → दो-चरण
    // profile-guided build (केवल --release के साथ); मार्ग = अंतिम non-ध्वज तर्क
    मान रिलीज़ = असत्य;
    मान पीजीओ = असत्य;
    मान नेटिव = असत्य;
    मान फ्रीस्टैंडिंग = असत्य;
    मान पीजीओ_कमांड = "";
    संख्या तइ = १;
    यावत् (तइ < लंबाई(तर्काः_सूची)) {
        पाठ त = तर्काः_सूची[तइ];
        यदि (त == "--release") { रिलीज़ = सत्य; }
        अन्यथा यदि (त == "--pgo") { पीजीओ = सत्य; }
        अन्यथा यदि (त == "--native") { नेटिव = सत्य; }
        अन्यथा यदि (त == "--freestanding") { फ्रीस्टैंडिंग = सत्य; }
        अन्यथा यदि (त == "--pgo-run") {
            तइ = तइ + १;
            यदि (तइ < लंबाई(तर्काः_सूची)) { पीजीओ_कमांड = तर्काः_सूची[तइ]; }
        }
        अन्यथा यदि (लंबाई(त) > ०) { मार्गः = त; }
        तइ = तइ + १;
    }
    यदि (पीजीओ && न रिलीज़) {
        लिखतु("चेतावनी: --pgo को --release चाहिए — अनदेखा किया।");
        पीजीओ = असत्य;
    }
    यदि (नेटिव && न रिलीज़) {
        लिखतु("चेतावनी: --native को --release चाहिए — अनदेखा किया।");
        नेटिव = असत्य;
    }
    यदि (फ्रीस्टैंडिंग && रिलीज़) {
        लिखतु("चेतावनी: --freestanding सिर्फ़ default (x86) backend के साथ — --release अनदेखा किया।");
        रिलीज़ = असत्य;
    }
    यदि (मार्गः == "") {
        लिखतु("त्रुटिः — सञ्चिका मार्गः न निर्दिष्टः।");
        परत्;
    }

    यदि (न सञ्चिका_अस्ति(मार्गः)) {
        लिखतु("त्रुटिः — सञ्चिका न प्राप्ता: " + मार्गः);
        परत्;
    }

    मान स्रोत_पाठ = सञ्चिका_पठतु(मार्गः);
    लिखतु("=== मूल संकलन ===");
    लिखतु("सञ्चिका: " + मार्गः);

    // NOTE: प्रयत्न/पकड़ो अभी IR path में lower नहीं होता — त्रुटि सीधे
    // प्रक्षेपित होती है (runtime उसे छापकर निकास करता)।

    // चरण १: पद विच्छेदन
    लिखतु("१. पद_विच्छेदन...");
    सूची पद_सूची = पद_विच्छेदन(स्रोत_पाठ);
    लिखतु("   पदों की संख्या: " + संख्या_देवनागरी(लंबाई(पद_सूची)));

    // चरण २: विश्लेषण
    लिखतु("२. विश्लेषण...");
    शब्दकोश अवस्था = {};
    अवस्था["पद_सूची"] = पद_सूची;
    अवस्था["अनुक्रमणिका"] = ०;
    अवस्था["कुल_पद"] = लंबाई(पद_सूची);
    शब्दकोश आयातित_सञ्चिकाः = {};
    शब्दकोश प्रोग्राम_नोड = प्रोग्राम_पार्स(अवस्था, आयातित_सञ्चिकाः, मार्गः);
    लिखतु("   विश्लेषण संपन्नम्।");

    // चरण २.५: सार्थक विश्लेषण
    लिखतु("२.५ सार्थक_विश्लेषण...");
    मूल_सार्थक_विश्लेषण(प्रोग्राम_नोड);
    लिखतु("    सार्थक_विश्लेषण संपन्नम्।");

    यदि (फ्रीस्टैंडिंग) {
        लिखतु("२.६ freestanding सुरक्षा-जाँच...");
        फ्रीस्टैंडिंग_जाँच_एकक(प्रोग्राम_नोड);
        लिखतु("    freestanding जाँच संपन्नम् — कोई GC/रनटाइम-निर्भरता नहीं मिली।");
    }

    // चरण ३: IR pipeline — निम्नक → अनुकूलक → परत्_प्रकार → पुच्छ → अंतर्वेशन
    यदि (रिलीज़) { लिखतु("३. IR उत्पन्न (--release → LLVM backend)..."); }
    अन्यथा { लिखतु("३. IR उत्पन्न (निम्नक → अनुकूलक → रजि_नियतक → उत्सर्जक)..."); }
    शब्दकोश एकक = निम्नक_एकक(प्रोग्राम_नोड);
    यदि (फ्रीस्टैंडिंग) { एकक["फ्रीस्टैंडिंग"] = सत्य; }
    अनुकूलक_एकक(एकक);
    परत्_प्रकार_अनुमान_एकक(एकक);
    पुच्छ_अनुकूलन_एकक(एकक);
    अंतर्वेशन_एकक(एकक);
    लूप_अनुकूलक_एकक(एकक);   // सीमा-उन्नयन (bounds-check hoist) — inline के बाद, प्रकार_प्रसार से पहले
    पाठ_संचायक_एकक(एकक);
    प्रकार_प्रसार_एकक(एकक);

    मान ओ_मार्ग = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,१११]);
    // बासी .o हटाओ (दोनों path)
    कमांड_चलाओ(अक्षर_सूची_से_पाठ([१००,१०१,१०८,३२,४७,११३,३२,११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,१११,३२,५०,६२,११०,११७,१०८]));

    यदि (रिलीज़) {
        // --release: user IR + runtime मॉड्यूल दोनों → LLVM IR पाठ →
        // llvm-link (whole-module) → clang -O2 -c (cross-module inline) → .o
        मान एल_मार्ग = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,१०८,१०८]);
        मान रट_एल = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११४,११६,४६,१०८,१०८]);
        मान आव_एल = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,९७,१०८,४६,१०८,१०८]);
        मान बीसी_मार्ग = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,९८,९९]);
        सञ्चिका_लिखतु(एल_मार्ग, एलएलवीएम_उत्सर्जक_एकक(एकक));
        लिखतु("४. runtime मॉड्यूल → LLVM IR...");
        सञ्चिका_लिखतु(रट_एल, रिलीज़_स्रोत_एलएल(रिलीज़_निर्माण_पथ("मूल_रनटाइम.सूत्र")));
        सञ्चिका_लिखतु(आव_एल, रिलीज़_स्रोत_एलएल(रिलीज़_निर्माण_पथ("मूल_आवंटक.सूत्र")));
        लिखतु("५. llvm-link + clang -O2...");
        // "C:\msys64\ucrt64\bin\llvm-link.exe " + inputs + " -o " + बीसी_मार्ग
        मान लिंक_कमांड = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,१०८,१०८,११८,१०९,४५,१०८,१०५,११०,१०७,४६,१०१,१२०,१०१,३२]) + एल_मार्ग + " " + रट_एल + " " + आव_एल + अक्षर_सूची_से_पाठ([३२,४५,१११,३२]) + बीसी_मार्ग;
        यदि (कमांड_चलाओ(लिंक_कमांड) != ० || न सञ्चिका_अस्ति(बीसी_मार्ग)) {
            प्रक्षेपः "त्रुटिः — llvm-link विफल।";
        }
        // "C:\msys64\ucrt64\bin\clang.exe -O3 -c " + बीसी_मार्ग + " -o " + ओ_मार्ग
        // (whole merged bitcode → -O3 IPO: internal-linkage फलनों पर DCE +
        //  विशेषीकरण + aggressive inline; #४ whole-program front)
        // --native → machine-locked build (host ISA बेक होती — "any x86-64"
        // वादा टूटता); default omit, portable रहता।
        मान मार्च_ध्वज = "";
        यदि (नेटिव) { मार्च_ध्वज = " -march=native"; }
        यदि (पीजीओ) {
            लिखतु("५ख. PGO दो-चरण build...");
            पीजीओ_संकलन(बीसी_मार्ग, ओ_मार्ग, पीजीओ_कमांड, मार्च_ध्वज);
        } अन्यथा {
            मान क्लैंग_कमांड = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,९९,१०८,९७,११०,१०३,४६,१०१,१२०,१०१,३२,४५,७९,५१]) + मार्च_ध्वज + अक्षर_सूची_से_पाठ([३२,४५,९९,३२]) + बीसी_मार्ग + अक्षर_सूची_से_पाठ([३२,४५,१११,३२]) + ओ_मार्ग;
            मान क्लैंग_कोड = कमांड_चलाओ(क्लैंग_कमांड);
            यदि (क्लैंग_कोड != ० || न सञ्चिका_अस्ति(ओ_मार्ग)) {
                प्रक्षेपः "त्रुटिः — clang संयोजन विफल।";
            }
        }
    } अन्यथा {
        // default: सूत्र IR → x86-64 GAS पाठ → as → .o
        मान संयोजन_कोड = उत्सर्जक_एकक(एकक);
        मान स_मार्ग = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,११५]);
        सञ्चिका_लिखतु(स_मार्ग, संयोजन_कोड);
        लिखतु("४. सञ्चिका: " + स_मार्ग);
        लिखतु("५. संयोजन...");
        मान संयोजक_कमांड = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,९७,११५,४६,१०१,१२०,१०१,३२,४५,१११,३२]) + ओ_मार्ग + " " + स_मार्ग;
        मान असेम_कोड = कमांड_चलाओ(संयोजक_कमांड);
        यदि (असेम_कोड != ० || न सञ्चिका_अस्ति(ओ_मार्ग)) {
            प्रक्षेपः "त्रुटिः — संयोजन विफल।";
        }
    }
    लिखतु("   संयोजन संपन्नम्।");

    यदि (फ्रीस्टैंडिंग) {
        फ्रीस्टैंडिंग_लिंक(ओ_मार्ग, मार्गः);
        परत्;
    }

    // चरण ५.५: OS-तल (तल.s) → sutra_floor.o
    मान तल_स्रोत = "स्वसंकलक/निर्माण/तल.s";
    यदि (न सञ्चिका_अस्ति(तल_स्रोत)) { तल_स्रोत = "निर्माण/तल.s"; }
    यदि (सञ्चिका_अस्ति(तल_स्रोत)) {
        मान तल_पाठ = सञ्चिका_पठतु(तल_स्रोत);
        मान तल_अस्थायी = अक्षर_सूची_से_पाठ([११५,१०२,१०८,१११,१११,११४,९५,११६,१०१,१०९,११२,४६,११५]);
        सञ्चिका_लिखतु(तल_अस्थायी, तल_पाठ);
        मान तल_कमांड = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,९७,११५,४६,१०१,१२०,१०१,३२,४५,१११,३२,११५,११७,११६,११४,९७,९५,१०२,१०८,१११,१११,११४,४६,१११,३२]) + तल_अस्थायी;
        यदि (कमांड_चलाओ(तल_कमांड) != ०) { प्रक्षेपः "त्रुटिः — तल.s संयोजन विफल।"; }
    }

    // चरण ५.६/५.७: --release में runtime .bc में है — बासी .o हटाओ, skip करो
    यदि (रिलीज़) {
        कमांड_चलाओ(अक्षर_सूची_से_पाठ([१००,१०१,१०८,३२,४७,११३,३२,११५,११७,११६,११४,९७,९५,११५,११४,११६,४६,१११,३२,११५,११७,११६,११४,९७,९५,९७,१०८,१०८,१११,९९,४६,१११,३२,५०,६२,११०,११७,१०८]));
    }

    // चरण ५.६: सूत्र-रनटाइम मॉड्यूल (मूल_रनटाइम.s) → sutra_srt.o
    मान रट_स्रोत = "स्वसंकलक/निर्माण/मूल_रनटाइम.s";
    यदि (न सञ्चिका_अस्ति(रट_स्रोत)) { रट_स्रोत = "निर्माण/मूल_रनटाइम.s"; }
    यदि (न रिलीज़ && सञ्चिका_अस्ति(रट_स्रोत)) {
        मान रट_पाठ = सञ्चिका_पठतु(रट_स्रोत);
        मान रट_अस्थायी = अक्षर_सूची_से_पाठ([११५,११४,११६,९५,११६,१०१,१०९,११२,४६,११५]);
        सञ्चिका_लिखतु(रट_अस्थायी, रट_पाठ);
        मान रट_कमांड = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,९७,११५,४६,१०१,१२०,१०१,३२,४५,१११,३२,११५,११७,११६,११४,९७,९५,११५,११४,११६,४६,१११,३२]) + रट_अस्थायी;
        यदि (कमांड_चलाओ(रट_कमांड) != ०) { प्रक्षेपः "त्रुटिः — मूल_रनटाइम.s संयोजन विफल।"; }
    }

    // चरण ५.७: आवंटक मॉड्यूल (मूल_आवंटक.s) → sutra_alloc.o
    मान आव_स्रोत = "स्वसंकलक/निर्माण/मूल_आवंटक.s";
    यदि (न सञ्चिका_अस्ति(आव_स्रोत)) { आव_स्रोत = "निर्माण/मूल_आवंटक.s"; }
    यदि (न रिलीज़ && सञ्चिका_अस्ति(आव_स्रोत)) {
        मान आव_पाठ = सञ्चिका_पठतु(आव_स्रोत);
        मान आव_अस्थायी = अक्षर_सूची_से_पाठ([९७,१०८,१०८,१११,९९,९५,११६,१०१,१०९,११२,४६,११५]);
        सञ्चिका_लिखतु(आव_अस्थायी, आव_पाठ);
        मान आव_कमांड = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,९७,११५,४६,१०१,१२०,१०१,३२,४५,१११,३२,११५,११७,११६,११४,९७,९५,९७,१०८,१०८,१११,९९,४६,१११,३२]) + आव_अस्थायी;
        यदि (कमांड_चलाओ(आव_कमांड) != ०) { प्रक्षेपः "त्रुटिः — मूल_आवंटक.s संयोजन विफल।"; }
    }

    // चरण ६: लिंक
    लिखतु("६. लिंक...");
    मान ई_मार्ग = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,१०१,१२०,१०१]);
    मान तल_कड़ी = "";
    यदि (सञ्चिका_अस्ति("sutra_floor.o")) { तल_कड़ी = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,१०२,१०८,१११,१११,११४,४६,१११,३२]); }
    मान रट_कड़ी = "";
    यदि (सञ्चिका_अस्ति("sutra_srt.o")) { रट_कड़ी = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,११५,११४,११६,४६,१११,३२]); }
    मान आव_कड़ी = "";
    यदि (सञ्चिका_अस्ति("sutra_alloc.o")) { आव_कड़ी = अक्षर_सूची_से_पाठ([११५,११७,११६,११४,९७,९५,९७,१०८,१०८,१११,९९,४६,१११,३२]); }
    // §2r: sutra_runtime.c हट गई। §2s (Level २): -nostdlib + अपना mainCRTStartup
    // (तल.s) → gcc की crt2.o नहीं; binary सिर्फ़ kernel32 + shell32 import करता।
    // §3c: -Wl,--no-undefined — कोई अनसुलझा प्रतीक = लिंक-त्रुटि (चुपचाप-टूटा
    // binary नहीं)। साथ ही नीचे linker exit-कोड जाँच (बासी .exe रक्षा)।
    // "C:\msys64\ucrt64\bin\gcc.exe -m64 -nostdlib -Wl,--no-undefined "
    मान गसीसी_उपसर्ग = अक्षर_सूची_से_पाठ([६७,५८,९२,१०९,११५,१२१,११५,५४,५२,९२,११७,९९,११४,११६,५४,५२,९२,९८,१०५,११०,९२,१०३,९९,९९,४६,१०१,१२०,१०१,३२,४५,१०९,५४,५२,३२,४५,११०,१११,११५,११६,१००,१०८,१०५,९८,३२,४५,८७,१०८,४४,४५,४५,११०,१११,४५,११७,११०,१००,१०१,१०२,१०५,११०,१०१,१००,३२]);
    // "-lkernel32 -lshell32 -o "
    मान कड़ी_प्रत्यय = अक्षर_सूची_से_पाठ([४५,१०८,१०७,१०१,११४,११०,१०१,१०८,५१,५०,३२,४५,१०८,११५,१०४,१०१,१०८,१०८,५१,५०,३२,४५,१११,३२]);
    // विदेशी (FFI) पुस्तकालय — सब objects के बाद, system libs से पहले
    मान विदेशी_कड़ी = "";
    मान वि_पुस्त = एकक["विदेशी_पुस्तकालय"];
    यदि (वि_पुस्त != शून्यम्) {
        संख्या वप = ०;
        यावत् (वप < लंबाई(वि_पुस्त)) {
            विदेशी_कड़ी = विदेशी_कड़ी + अक्षर_सूची_से_पाठ([४५,१०८]) + वि_पुस्त[वप] + " ";
            वप = वप + १;
        }
    }
    मान लिंकर_कमांड = गसीसी_उपसर्ग + ओ_मार्ग + " " + आव_कड़ी + रट_कड़ी + तल_कड़ी + विदेशी_कड़ी + कड़ी_प्रत्यय + ई_मार्ग;
    // बासी .exe पहले हटाओ — विफल लिंक उसे "सफल" न दिखा सके
    कमांड_चलाओ(अक्षर_सूची_से_पाठ([१००,१०१,१०८,३२,४७,११३,३२,११५,११७,११६,११४,९७,९५,११०,९७,११६,१०५,११८,१०१,९५,११६,१०१,१०९,११२,४६,१०१,१२०,१०१,३२,५०,६२,११०,११७,१०८]));
    मान लिंक_कोड = कमांड_चलाओ(लिंकर_कमांड);

    यदि (लिंक_कोड != ०) {
        प्रक्षेपः "त्रुटिः — लिंक विफल (linker exit != 0)।";
    }
    यदि (न सञ्चिका_अस्ति(ई_मार्ग)) {
        प्रक्षेपः "त्रुटिः — लिंक विफल (कोई .exe नहीं)।";
    }
    लिखतु("   लिंक संपन्नम्।");

    // चरण ७: अंतिम नाम पर प्रतिलिपि
    मान अंतिम_नाम = मार्गः + अक्षर_सूची_से_पाठ([९५,११०,९७,११६,१०५,११८,१०१,४६,१०१,१२०,१०१]);
    मान प्रतिलिपि_कमांड = अक्षर_सूची_से_पाठ([९९,१०९,१००,३२,४७,९९,३२,९९,१११,११२,१२१,३२,४७,१२१,३२]) + ई_मार्ग + " " + अक्षर_निर्माण(३४) + अंतिम_नाम + अक्षर_निर्माण(३४);
    कमांड_चलाओ(प्रतिलिपि_कमांड);
    लिखतु("७. अंतिम: " + अंतिम_नाम);

    लिखतु("=== मूल संकलन सफल! ===");
}
