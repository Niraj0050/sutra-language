// उदाहरणानि/शब्द_गणना.सूत्र — मानक-पुस्तकालय से बना एक असली CLI उपकरण
// ============================================================
// चलाओ (native संकलन के बाद):
//   ./cli_शब्द_गणना.सूत्र_native.exe -l -w कोई_फ़ाइल.txt
//   ./cli_शब्द_गणना.सूत्र_native.exe फ़ाइल.txt          (सब गिनतियाँ)
//
// दिखाता है: तर्क (argparse) + पथ + पाठ + प्रारूप एक साथ।
// ============================================================

आयात "पुस्तकालय/मानक.सूत्र";

कार्य विन्यास(तर्क_विश्लेषक प) {
    प.ध्वज("lines", "l");       // -l  → केवल पंक्तियाँ
    प.ध्वज("words", "w");       // -w  → केवल शब्द
    प.ध्वज("chars", "c");       // -c  → केवल अक्षर
    प.स्थानिक("फ़ाइल");
    परत् 0;
}

कार्य शब्द_गिनो(पाठ पाठ्य) {
    // श्वेत-स्थान पर टूटे गैर-रिक्त टुकड़ों की संख्या
    संख्या गिनती = 0;
    संख्या शब्द_में = 0;
    संख्या इ = 0;
    यावत् (इ < लंबाई(पाठ्य)) {
        पाठ च = उपखंड(पाठ्य, इ, इ + 1);
        संख्या क = अक्षर_मान(च);
        यदि (क == 32 || क == 9 || क == 10 || क == 13) {
            शब्द_में = 0;
        } अन्यथा {
            यदि (शब्द_में == 0) { गिनती = गिनती + 1; }
            शब्द_में = 1;
        }
        इ = इ + 1;
    }
    परत् गिनती;
}

कार्य मुख्य() {
    मान प = नवीन तर्क_विश्लेषक("शब्द_गणना — पंक्ति/शब्द/अक्षर गिनो");
    विन्यास(प);
    मान तर्क_परिणाम = प.विश्लेषण(कार्यक्रम_तर्क());

    मान मार्ग = तर्क_परिणाम["फ़ाइल"];
    यदि (मार्ग == शून्यम्) {
        लिखतु("उपयोग: शब्द_गणना [-l] [-w] [-c] <फ़ाइल>");
        लिखतु(प.सहायता());
        परत्;
    }
    यदि (न सञ्चिका_अस्ति(मार्ग)) {
        लिखतु("त्रुटि: फ़ाइल न मिली — " + मार्ग);
        परत्;
    }

    पाठ सामग्री = सञ्चिका_पठतु(मार्ग);
    संख्या पंक्ति_गिनती = लंबाई(पंक्तियाँ(सामग्री));
    संख्या शब्द_गिनती = शब्द_गिनो(सामग्री);
    संख्या अक्षर_गिनती = लंबाई(सामग्री);

    // कोई ध्वज नहीं → सब दिखाओ
    मान कोई_ध्वज = तर्क_परिणाम["lines"] || तर्क_परिणाम["words"] || तर्क_परिणाम["chars"];

    यदि (न कोई_ध्वज || तर्क_परिणाम["lines"]) {
        लिखतु(प्रारूप("{}  पंक्तियाँ", [दाएँ_संरेखित(हज़ार_विभाजक(पंक्ति_गिनती), 8, " ")]));
    }
    यदि (न कोई_ध्वज || तर्क_परिणाम["words"]) {
        लिखतु(प्रारूप("{}  शब्द", [दाएँ_संरेखित(हज़ार_विभाजक(शब्द_गिनती), 8, " ")]));
    }
    यदि (न कोई_ध्वज || तर्क_परिणाम["chars"]) {
        लिखतु(प्रारूप("{}  अक्षर", [दाएँ_संरेखित(हज़ार_विभाजक(अक्षर_गिनती), 8, " ")]));
    }
    लिखतु(प्रारूप("फ़ाइल: {}  ({})", [आधार_नाम(मार्ग), विस्तार(मार्ग)]));
}
