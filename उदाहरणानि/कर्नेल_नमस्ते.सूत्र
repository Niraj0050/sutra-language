// उदाहरणानि/कर्नेल_नमस्ते.सूत्र — पहला Sutra "कर्नेल": VGA टेक्स्ट-बफर पर सीधे
// लिखता, कोई OS नहीं। `sutrac.exe --freestanding` से compile करो, फिर
// कर्नेल/निर्माण.ps1 से असली (emulated) bare-metal hardware पर बूट करो:
//
//   sutrac.exe --freestanding उदाहरणानि\कर्नेल_नमस्ते.सूत्र
//   .\कर्नेल\निर्माण.ps1 -KernelBin उदाहरणानि\कर्नेल_नमस्ते.सूत्र_freestanding.bin -Run
//
// ⚠️ freestanding अनुशासन (rules.md §2c): सिर्फ़ संख्या-गणित + अंतर्_पढ़*/
// लिख* + अन्य freestanding-सुरक्षित फलन — कोई सूची/शब्दकोश/पाठ/वर्ग नहीं
// (compiler खुद यह जाँचता, चुपचाप गलत कोड नहीं बनने देता)।

कार्य अक्षर_लिखो(संख्या तल, संख्या स्थिति, संख्या वर्ण, संख्या रंग) {
    अंतर्_लिख1(तल, स्थिति * 2, वर्ण);
    अंतर्_लिख1(तल, स्थिति * 2 + 1, रंग);
    परत् 0;
}

कार्य मुख्य() {
    संख्या तल = 753664;   // 0xB8000 — VGA टेक्स्ट-बफर, boot stub द्वारा
                           // पहले से identity-mapped (rules.md §2c)
    संख्या रंग = 10;        // हल्का हरा, काले पर (VGA attribute byte)

    अक्षर_लिखो(तल, 0, 83, रंग);    // S
    अक्षर_लिखो(तल, 1, 85, रंग);    // U
    अक्षर_लिखो(तल, 2, 84, रंग);    // T
    अक्षर_लिखो(तल, 3, 82, रंग);    // R
    अक्षर_लिखो(तल, 4, 65, रंग);    // A
    अक्षर_लिखो(तल, 5, 32, रंग);    // (स्पेस)
    अक्षर_लिखो(तल, 6, 75, रंग);    // K
    अक्षर_लिखो(तल, 7, 69, रंग);    // E
    अक्षर_लिखो(तल, 8, 82, रंग);    // R
    अक्षर_लिखो(तल, 9, 78, रंग);    // N
    अक्षर_लिखो(तल, 10, 69, रंग);   // E
    अक्षर_लिखो(तल, 11, 76, रंग);   // L

    परत् 0;
}
