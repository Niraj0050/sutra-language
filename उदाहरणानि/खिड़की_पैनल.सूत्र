// उदाहरणानि/खिड़की_पैनल.सूत्र — पहली असली Sutra GUI: यूआई.सूत्र का
// settings-panel एक असली Win32 खिड़की में खींचता है।
//
// चलाओ:
//   ./sutrac.exe उदाहरणानि/खिड़की_पैनल.सूत्र
//   ./उदाहरणानि/खिड़की_पैनल.सूत्र_native.exe
// (खिड़की खुलेगी, panel दिखेगा; बंद-बटन (X) दबाने तक खुली रहती)

आयात "पुस्तकालय/यूआई.सूत्र";
आयात "पुस्तकालय/विन32.सूत्र";

कार्य पंक्ति_क्षेत्र(पाठ नाम, पाठ मूल्य) {
    परत् डिब्बा({"दिशा": "पंक्ति", "अंतर": 8, "ऊँचाई": 32, "संरेखण": "मध्य"}, [
        लेख(नाम,   {"चौड़ाई": 120, "पाठ_संरेखण": "आरंभ", "पाठ_रंग": "#94a3b8"}),
        लेख(मूल्य, {"बढ़त": 1, "पाठ_संरेखण": "आरंभ", "पाठ_रंग": "#e2e8f0"})
    ]);
}

कार्य पैनल() {
    परत् डिब्बा({"दिशा": "स्तंभ", "पैडिंग": 16, "अंतर": 12,
                "पृष्ठ_रंग": "#0f172a"}, [
        लेख("सूत्र — पहली खिड़की", {"पाठ_आकार": 20, "पाठ_रंग": "#f1f5f9", "पाठ_संरेखण": "आरंभ"}),
        डिब्बा({"दिशा": "स्तंभ", "अंतर": 4, "पैडिंग": 12, "कोना": 8,
                "पृष्ठ_रंग": "#1e293b"}, [
            पंक्ति_क्षेत्र("भाषा", "सूत्र"),
            पंक्ति_क्षेत्र("रेंडरर", "Win32 GDI"),
            पंक्ति_क्षेत्र("जोड़ने वाला (FFI)", "विदेशी")
        ]),
        रिक्ति(1),
        डिब्बा({"दिशा": "पंक्ति", "अंतर": 8}, [
            रिक्ति(1),
            बटन("बंद करें", "क्रिया_बंद", {"चौड़ाई": 110, "कोना": 6})
        ])
    ]);
}

कार्य मुख्य() {
    संख्या इंस्ट = विं_मॉड्यूल_पता(0);
    पाठ वर्ग_नाम = "SutraKhidkiPanel";
    शब्दकोश वग = विं_वर्ग_बनाओ(वर्ग_नाम, विं_डिफ़ॉल्ट_प्रक्रिया_पता(), इंस्ट);
    संख्या पंजी_फल = विं_वर्ग_पंजी(वग["पता"]);
    यदि (पंजी_फल == 0) { लिखतु("त्रुटिः — वर्ग पंजीकरण विफल"); परत्; }

    संख्या ख = विं_खिड़की_बनाओ_सरल(वर्ग_नाम, "सूत्र — Sutra GUI", 480, 340, इंस्ट);
    यदि (ख == 0) { लिखतु("त्रुटिः — खिड़की नहीं बनी"); परत्; }

    विं_दिखाओ(ख, विं_दिखा_सामान्य());
    विं_अद्यतन(ख);

    // एक बार layout + render + GDI-draw (WM_PAINT पर दुबारा नहीं — v1 सरल रखा)
    शब्दकोश जड़ = पैनल();
    शब्दकोश अवस्था = यूआई_अवस्था_नई();
    सूची आदेश = यूआई_चौखटा(जड़, अवस्था, 480, 340);
    संख्या डीसी = विं_डीसी_लो(ख);
    विं_चित्र_खींचो(डीसी, आदेश);
    विं_डीसी_छोड़ो(ख, डीसी);

    लिखतु("खिड़की खुल गई — बंद (X) दबाने तक प्रतीक्षा...");
    विं_लूप_चलाओ(ख);
    लिखतु("खिड़की बंद हुई।");
}
