// छात्र प्रबंधन (Student Management) Application
आयात "प्रबंधन_सहायक.सूत्र";

कार्य मुख्य() {
    लिखतु("================================================");
    लिखतु("     छात्र प्रबंधन प्रणाली (Sutra Version 1.0)");
    लिखतु("================================================");

    सूची छात्र_सूची = [];
    मान जारी_रखें = सत्य;
    मान रोल_काउंटर = 101;

    // Interactive Loop to add students
    यावत् (जारी_रखें) {
        लिखतु("क्या आप नया छात्र जोड़ना चाहते हैं? (सत्य/असत्य):");
        मान उत्तर = पठतु();
        
        अगर (उत्तर == "असत्य" अथवा उत्तर == असत्य अथवा उत्तर == "" अथवा उत्तर == शून्यम् अथवा उत्तर == "n" अथवा उत्तर == "no") {
            जारी_रखें = असत्य;
        } अन्यथा अगर (उत्तर == "सत्य" अथवा उत्तर == सत्य अथवा उत्तर == "y" अथवा उत्तर == "yes") {
            लिखतु("छात्र का नाम दर्ज करें:");
            मान नाम = पठतु();
            
            लिखतु("छात्र के अंक दर्ज करें (0 से 100):");
            मान अंक = पठतु();

            // Create Student Object
            मान नया_छात्र = नवीन छात्र(नाम, रोल_काउंटर, अंक);
            छात्र_सूची = जोड़ें(छात्र_सूची, नया_छात्र);
            
            लिखतु("छात्र " + नाम + " (रोल: " + रोल_काउंटर + ") को सफलतापूर्वक पंजीकृत किया गया।");
            रोल_काउंटर = रोल_काउंटर + 1;
        } अन्यथा {
            लिखतु("अमान्य उत्तर! कृपया केवल 'सत्य' या 'असत्य' लिखें।");
        }
        लिखतु(""); // empty line
    }

    मान कुल_संख्या = लंबाई(छात्र_सूची);
    लिखतु("================================================");
    लिखतु("पंजीकृत छात्रों की सूची (कुल संख्या: " + कुल_संख्या + ")");
    लिखतु("================================================");

    अगर (कुल_संख्या == 0) {
        लिखतु("कोई छात्र पंजीकृत नहीं है।");
    } अन्यथा {
        पुनरावृत्तिः (मान i = 0; i < कुल_संख्या; i = i + 1) {
            मान स = छात्र_सूची[i];
            मान जी = स.प्राप्त_ग्रेड();
            लिखतु("रोल: " + स.रोल + " | नाम: " + स.नाम + " | अंक: " + स.अंक + " | ग्रेड: " + जी);
        }

        // Calculate Class Average
        मान औसत = औसत_निकालें(छात्र_सूची);
        लिखतु("------------------------------------------------");
        लिखतु("कक्षा का कुल औसत अंक: " + औसत);
        लिखतु("================================================");
    }
}
