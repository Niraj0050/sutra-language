// प्रबंधन सहायक (Management Helper) Module

वर्ग छात्र {
    पाठ नाम;
    संख्या रोल;
    संख्या अंक;

    कार्य रचना(पाठ n, संख्या r, संख्या s) {
        स्व.नाम = n;
        स्व.रोल = r;
        स्व.अंक = s;
    }

    कार्य प्राप्त_ग्रेड() {
        संख्या s = स्व.अंक;
        अगर (s >= 90) {
            परत् "अ+";
        } अन्यथा अगर (s >= 80) {
            परत् "अ";
        } अन्यथा अगर (s >= 70) {
            परत् "ब";
        } अन्यथा अगर (s >= 60) {
            परत् "स";
        } अन्यथा अगर (s >= 50) {
            परत् "द";
        } अन्यथा {
            परत् "अनुत्तीर्ण";
        }
    }
}

कार्य औसत_निकालें(सूची छात्र_सूची) {
    मान कुल = 0;
    मान संख्या_छात्र = लंबाई(छात्र_सूची);
    अगर (संख्या_छात्र == 0) {
        परत् 0;
    }
    पुनरावृत्तिः (मान i = 0; i < संख्या_छात्र; i = i + 1) {
        मान c = छात्र_सूची[i];
        कुल = कुल + c.अंक;
    }
    परत् कुल / संख्या_छात्र;
}
