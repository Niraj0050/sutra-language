कार्य मुख्य() {
    सूची अंक = [5, 10, 15, 20];
    संख्या सीमा = लंबाई(अंक);
    लिखतु(सीमा);
    
    संख्या सूचक = 0;
    यावत् (सूचक < सीमा) {
        लिखतु(अंक[सूचक]);
        सूचक = सूचक + 1;
    }
   

मान परिणाम = योग(वर्ग_गणना(4), वर्ग_गणना(3));
लिखतु("4^2 + 3^2 = " + परिणाम);

}
 // Sutra Functions Example

कार्य वर्ग_गणना(संख्या व) {
    परत् व * व;
}

कार्य योग(संख्या क, संख्या ख) {
    परत् क + ख;
}