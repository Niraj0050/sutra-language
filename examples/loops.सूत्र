// Sutra Loops Example (यावत्, जबतक, पुनरावृत्तिः, विरामः, जारीरह)

लिखतु("=== जबकि (While) लूप ===");
संख्या गिनती = 1;
जबतक (गिनती <= 3) {
    लिखतु(गिनती);
    गिनती = गिनती + 1;
}

लिखतु("=== पुनरावृत्तिः (For) लूप + जारीरह ===");
पुनरावृत्तिः (मान i = 1; i <= 5; i = i + 1) {
    यदि (i == 3) {
        जारीरह;
    }
    लिखतु(i);
}
