// Sutra Complete Application Example (Student Grade Calculator & Report Generator)

लिखतु("==========================================");
लिखतु("     सूत्र 1.0 छात्र अंक तालिका प्रणाली    ");
लिखतु("==========================================");

वर्ग छात्र_अंक {
    पाठ नाम = "";
    संख्या अंक_गणित = 0;
    संख्या अंक_विज्ञान = 0;

    कार्य रचना(पाठ n, संख्या m, संख्या s) {
        स्व.नाम = n;
        स्व.अंक_गणित = m;
        स्व.अंक_विज्ञान = s;
    }

    कार्य कुल_अंक() {
        परत् स्व.अंक_गणित + स्व.अंक_विज्ञान;
    }

    कार्य औसत() {
        परत् स्व.कुल_अंक() / 2;
    }

    कार्य श्रेणी() {
        मान ओ = स्व.औसत();
        अगर (ओ >= 90) {
            परत् "उत्कृष्ट (A+)";
        } अन्यथा {
            अगर (ओ >= 75) {
                परत् "उत्तम (A)";
            } अन्यथा {
                परत् "संतोषजनक (B)";
            }
        }
    }

    कार्य रिपोर्ट_दर्शयतु() {
        लिखतु("छात्र: " + स्व.नाम);
        लिखतु("कुल अंक: " + स्व.कुल_अंक() + " / 200");
        लिखतु("औसत अंक: " + स्व.औसत());
        लिखतु("अंतिम श्रेणी: " + स्व.श्रेणी());
    }
}

मान सूची_छात्र = [
    नवीन छात्र_अंक("अमित", 95, 91),
    नवीन छात्र_अंक("प्रिया", 82, 78),
    नवीन छात्र_अंक("रोहन", 65, 70)
];

पुनरावृत्तिः (मान i = 0; i < लंबाई(सूची_छात्र); i = i + 1) {
    लिखतु("");
    लिखतु("--- छात्र क्रमांक " + (i + 1) + " ---");
    मान स = सूची_छात्र[i];
    स.रिपोर्ट_दर्शयतु();
}

लिखतु("");
लिखतु("==========================================");
लिखतु("   रिपोर्ट निर्माण सफलतापूर्वक सम्पन्न!    ");
लिखतु("==========================================");
