// examples/ui_झलक.सूत्र — यूआई मॉडल की एक झलक
// ------------------------------------------------------------
// एक छोटा "सेटिंग्स पैनल" बनाता, 480×320 चौखटे में बिठाता, और
// चित्रण-आदेश-सूची छापता — यही सूची कोई भी renderer (Win32 GDI,
// HTML canvas, framebuffer, SVG) सीधे खींच सकता।
//
// चलाओ:  ./sutrac.exe examples/ui_झलक.सूत्र  &&  ./examples/ui_झलक.सूत्र_native.exe

आयात "पुस्तकालय/यूआई.सूत्र";

कार्य पंक्ति_क्षेत्र(पाठ नाम, पाठ मूल्य) {
    परत् डिब्बा({"दिशा": "पंक्ति", "अंतर": 8, "ऊँचाई": 32, "संरेखण": "मध्य"}, [
        लेख(नाम,   {"चौड़ाई": 120, "पाठ_संरेखण": "आरंभ", "पाठ_रंग": "#94a3b8"}),
        लेख(मूल्य, {"बढ़त": 1, "पाठ_संरेखण": "आरंभ", "पाठ_रंग": "#e2e8f0"})
    ]);
}

कार्य पैनल() {
    परत् डिब्बा({"दिशा": "स्तंभ", "पैडिंग": 16, "अंतर": 12,
                "पृष्ठ_रंग": "#0f172a", "क्रिया": "पृष्ठभूमि"}, [
        लेख("सेटिंग्स", {"पाठ_आकार": 20, "पाठ_रंग": "#f1f5f9", "पाठ_संरेखण": "आरंभ"}),
        डिब्बा({"दिशा": "स्तंभ", "अंतर": 4, "पैडिंग": 12, "कोना": 8,
                "पृष्ठ_रंग": "#1e293b"}, [
            पंक्ति_क्षेत्र("भाषा", "सूत्र"),
            पंक्ति_क्षेत्र("थीम", "गहरा"),
            पंक्ति_क्षेत्र("फ़ॉन्ट आकार", "14")
        ]),
        रिक्ति(1),
        डिब्बा({"दिशा": "पंक्ति", "अंतर": 8}, [
            रिक्ति(1),
            बटन("रद्द", "क्रिया_रद्द", {"चौड़ाई": 90, "कोना": 6}),
            बटन("सहेजो", "क्रिया_सहेजो", {"चौड़ाई": 90, "कोना": 6,
                "पृष्ठ_रंग": "#2563eb", "होवर_रंग": "#3b82f6"})
        ])
    ]);
}

कार्य आदेश_दिखाओ(शब्दकोश आ) {
    पाठ क = आ["आदेश"];
    यदि (क == "पाठ") {
        लिखतु("  पाठ    (" + ("" + आ["क्ष"]) + "," + ("" + आ["य"]) + ")  \""
            + आ["सामग्री"] + "\"  " + आ["रंग"] + "  " + ("" + आ["आकार"]) + "px");
    } अन्यथा यदि (क == "आयत") {
        लिखतु("  आयत   (" + ("" + आ["क्ष"]) + "," + ("" + आ["य"]) + ")  "
            + ("" + आ["चौड़ाई"]) + "×" + ("" + आ["ऊँचाई"]) + "  " + आ["रंग"]
            + "  कोना=" + ("" + आ["कोना"]));
    } अन्यथा यदि (क == "किनारा") {
        लिखतु("  किनारा (" + ("" + आ["क्ष"]) + "," + ("" + आ["य"]) + ")  "
            + ("" + आ["चौड़ाई"]) + "×" + ("" + आ["ऊँचाई"]) + "  " + आ["रंग"]);
    }
    परत् 0;
}

कार्य मुख्य() {
    शब्दकोश अवस्था = यूआई_अवस्था_नई();
    शब्दकोश जड़ = पैनल();

    // "सहेजो" बटन के ऊपर माउस — hover-अवस्था दिखाने को
    लेआउट_करो(जड़, 480, 320);
    मान सहेजो = यूआई_खोजो_क्रिया(जड़, "क्रिया_सहेजो");
    शब्दकोश सस = सहेजो["स्थान"];
    घटना_भेजो(जड़, अवस्था, माउस_घटना("गति",
        सस["बाएँ"] + 10, सस["ऊपर"] + 5));

    सूची आदेश = यूआई_चौखटा(जड़, अवस्था, 480, 320);

    लिखतु("=== चित्रण-आदेश (" + ("" + लंबाई(आदेश)) + ") — renderer को यही जाता ===");
    संख्या इ = 0;
    यावत् (इ < लंबाई(आदेश)) {
        आदेश_दिखाओ(आदेश[इ]);
        इ = इ + 1;
    }

    लिखतु("");
    लिखतु("hover = " + अवस्था["होवर"] + "   (सहेजो बटन hover-रंग #3b82f6 में)");

    // एक click अनुकरण
    शब्दकोश फल = घटना_भेजो(जड़, अवस्था, माउस_घटना("दबाव",
        सस["बाएँ"] + 10, सस["ऊपर"] + 5));
    फल = घटना_भेजो(जड़, अवस्था, माउस_घटना("छोड़",
        सस["बाएँ"] + 10, सस["ऊपर"] + 5));
    सूची संदेश = फल["संदेश"];
    पाठ संदेश_पाठ = "";
    संख्या ज = 0;
    यावत् (ज < लंबाई(संदेश)) {
        यदि (ज > 0) { संदेश_पाठ = संदेश_पाठ + ", "; }
        संदेश_पाठ = संदेश_पाठ + संदेश[ज];
        ज = ज + 1;
    }
    लिखतु("click → संदेश: [" + संदेश_पाठ + "]");
}
