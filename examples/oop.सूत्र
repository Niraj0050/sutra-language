// Sutra Object Oriented Programming Example

वर्ग वाहन {
    पाठ नाम = "अज्ञात";
    संख्या गति = 0;

    कार्य रचना(पाठ n, संख्या g) {
        स्व.नाम = n;
        स्व.गति = g;
    }

    कार्य दर्शयतु_गति() {
        लिखतु(स्व.नाम + " गतिः: " + स्व.गति + " किमी/घं");
    }
}

मान कार = नवीन वाहन("फॉर्च्यूनर", 120);
कार.दर्शयतु_गति();
