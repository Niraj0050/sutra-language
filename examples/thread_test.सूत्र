// examples/thread_test.सूत्र — असली OS threads: 4 थ्रेड, हर एक 100000 बार
// एक साझा counter Mutex से सुरक्षित बढ़ाता — race-रहित तो अंतिम गिनती ठीक
// 400000 आएगी। फलन_पता(थ्रेड_कार्य) → CreateThread को असली Sutra-फलन का
// पता देता (पुस्तकालय/थ्रेड.सूत्र इस्तेमाल करते — असली उपयोग का उदाहरण)।

आयात "पुस्तकालय/थ्रेड.सूत्र";

// ⚠️ GC-असुरक्षित नहीं: सिर्फ़ संख्या-गणित + अंतर्_पढ़8/लिख8 + विदेशी कॉल।
// कोई सूची/पाठ/शब्दकोश आवंटन यहाँ नहीं — rules.md §2b देखो।
कार्य थ्रेड_कार्य(संख्या ब्लॉक_पता) {
    संख्या म्यू = अंतर्_पढ़8(ब्लॉक_पता, 8);
    संख्या इ = 0;
    यावत् (इ < 100000) {
        म्यूटेक्स_लो(म्यू);
        अंतर्_लिख8(ब्लॉक_पता, 0, अंतर्_पढ़8(ब्लॉक_पता, 0) + 1);   // गैर-atomic +1, पर mutex-सुरक्षित
        म्यूटेक्स_छोड़ो(म्यू);
        इ = इ + 1;
    }
    परत् 0;
}

कार्य मुख्य() {
    पाठ बफ = "                ";       // 16-बाइट scratch: [गणक@0][म्यूटेक्स@8]
    संख्या ब्लॉक_पता = विदेशी_पता(बफ);
    अंतर्_लिख8(ब्लॉक_पता, 0, 0);       // गणक = 0
    संख्या म्यू = म्यूटेक्स_नया();
    अंतर्_लिख8(ब्लॉक_पता, 8, म्यू);

    संख्या न_थ्रेड = 4;
    सूची हैंडल = [];
    संख्या प्रा = फलन_पता(थ्रेड_कार्य);
    संख्या ट = 0;
    यावत् (ट < न_थ्रेड) {
        संख्या ह = थ्रेड_बनाओ(प्रा, ब्लॉक_पता);
        यदि (ह == 0) { लिखतु("त्रुटिः — थ्रेड नहीं बना"); परत्; }
        हैंडल = जोड़ें(हैंडल, ह);
        ट = ट + 1;
    }

    ट = 0;
    यावत् (ट < न_थ्रेड) {
        थ्रेड_प्रतीक्षा_बंद(हैंडल[ट]);
        ट = ट + 1;
    }

    संख्या अंतिम = अंतर्_पढ़8(ब्लॉक_पता, 0);
    म्यूटेक्स_बंद(म्यू);
    लिखतु("अंतिम गणना: " + ("" + अंतिम));
    यदि (अंतिम == 400000) {
        लिखतु("सही! 4 थ्रेड × 100000 = 400000, कोई race नहीं — असली समानांतर सूत्र-निष्पादन।");
    } अन्यथा {
        लिखतु("गलत — race condition! (अपेक्षित 400000)");
    }
}
